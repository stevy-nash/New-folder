"ITPSACTHT3";"S";"0016";"*"
"ITPSACTHT3";"S";"0017";"* Rôle :"
"ITPSACTHT3";"S";"0018";"*"
"ITPSACTHT3";"S";"0019";"* Calcul du temps de présence activité avec les heures totales"
"ITPSACTHT3";"S";"0020";"* pour population = section et mode jour"
"ITPSACTHT3";"S";"0021";"* (gestion activité avec indicateur dans SEH)"
"ITPSACTHT3";"S";"0022";"*"
"ITPSACTHT3";"S";"0023";"*"
"ITPSACTHTA";"S";"0098";"        FINSI"
"ITPSACTHT3";"S";"0024";"*----------------------------------------------------------------------"
"ITPSACTHT3";"S";"0025";"*"
"ITPSACTHT3";"S";"0026";"* Modifiée par :"
"ITPSACTHT3";"S";"0027";"* Date         : JJ/MM/AAAA"
"ITPSACTHT3";"S";"0028";"* Objet        :"
"ITPSACTHT3";"S";"0029";"*"
"ITPSACTHT3";"S";"0030";"***********************************************************************"
"ITPSACTHT3";"S";"0031";"*"
"ITPSACTHT3";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTHT3";"S";"0033";"*"
"ITPSACTHT3";"S";"0034";"DEBDICO"
"ITPSACTHT3";"S";"0035";"SECH_ISIACTI;O;A1;X;;;123456789;L;;C3;""Section géré en activité"";"
"ITPSACTHT3";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTHT3";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTHT3";"S";"0038";"FINDICO"
"ITPSACTHT3";"S";"0039";"*"
"ITPSACTHT3";"S";"0040";"*"
"ITPSACTHT3";"S";"0041";"* DEBANO"
"ITPSACTHT3";"S";"0042";"*"
"ITPSACTHT3";"S";"0043";"* FINANO"
"ITPSACTHT3";"S";"0044";"*"
"ITPSACTHT3";"S";"0045";"* Définition des variables locales"
"ITPSACTHT3";"S";"0046";"DEF LOCA_DURABS T6.2"
"ITPSACTHT3";"S";"0047";"LOCA_DURABS = 0"
"ITPSACTHT3";"S";"0048";"*"
"ITPSACTHT3";"S";"0049";"* Gestion de l'indicateur activité"
"ITPSACTHT3";"S";"0050";"SI HJOU_IJIACTI = "" """
"ITPSACTHT3";"S";"0051";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHT3";"S";"0052";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTHT3";"S";"0053";"    FINSI"
"ITPSACTHT3";"S";"0054";"FINSI"
"ITPSACTHT3";"S";"0055";"* Employé géré en activité"
"ITPSACTHT3";"S";"0056";"SI HJOU_IJIACTI <> "" """
"ITPSACTHT3";"S";"0057";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHT3";"S";"0058";"        * Calcul de la présence activité"
"ITPSACTHT3";"S";"0059";"        SI PRES_VALID <> ""O"""
"ITPSACTHT3";"S";"0060";"            PRES_VALID = ""N"""
"ITPSACTHT3";"S";"0061";"            PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTHT3";"S";"0062";"            SI HJOU_SECTAFF <> "" """
"ITPSACTHT3";"S";"0063";"                PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTHT3";"S";"0064";"            SINON"
"ITPSACTHT3";"S";"0065";"                PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTHT3";"S";"0066";"            FINSI"
"ITPSACTHT3";"S";"0067";"            *"
"ITPSACTHT3";"S";"0068";"            SI PRES_MODE_TRV = "" """
"ITPSACTHT3";"S";"0069";"               PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT3";"S";"0070";"            FINSI"
"ITPSACTHT3";"S";"0071";"            *"
"ITPSACTHT3";"S";"0072";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT3";"S";"0073";"            *"
"ITPSACTHT3";"S";"0074";"            * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT3";"S";"0075";"            *                              (A décommenter si besoin)"
"ITPSACTHT3";"S";"0076";"            *"
"ITPSACTHT3";"S";"0077";"            * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT3";"S";"0078";"            * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT3";"S";"0079";"            * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT3";"S";"0080";"            * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT3";"S";"0081";"            *"
"ITPSACTHT3";"S";"0082";"            * SI HJOU_IJQBHORVAJ <> 0"
"ITPSACTHT3";"S";"0083";"                PRES_TPS_PRES = HJOU_IJQBHORVAJ"
"ITPSACTHT3";"S";"0084";"            * SINON"
"ITPSACTHT3";"S";"0085";"                * PRES_TPS_PRES = 0.01"
"ITPSACTHT3";"S";"0086";"            * FINSI"
"ITPSACTHT3";"S";"0087";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT3";"S";"0088";"            *"
"ITPSACTHT3";"S";"0089";"            *"
"ITPSACTHT3";"S";"0090";"            *"
"ITPSACTHT3";"S";"0091";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT3";"S";"0092";"            *"
"ITPSACTHT3";"S";"0093";"            * !!!                Pour gestion des temps de présence par consigne                !!!"
"ITPSACTHT3";"S";"0094";"            *                              (A décommenter si besoin)"
"ITPSACTHT3";"S";"0095";"            *"
"ITPSACTHT3";"S";"0096";"            * Si besoin de gérer les temps de présence par consigne, décommenter le"
"ITPSACTHT3";"S";"0097";"            * POUR ACTIVITES ci-dessous ainsi le test LOCA_DURABS <> 0"
"ITPSACTHT3";"S";"0098";"            *"
"ITPSACTHT3";"S";"0099";"            * récupération des temps de présence declaré par consigne"
"ITPSACTHT3";"S";"0100";"            * POUR ACTIVITES"
"ITPSACTHT3";"S";"0101";"                * SI HABS_MOTYPE = ""C"""
"ITPSACTHT3";"S";"0102";"                    * Motif participant au temps d'activité à justifier"
"ITPSACTHT3";"S";"0103";"                    * SI MOTI_MOTIF = ""XPRES"""
"ITPSACTHT3";"S";"0104";"                        * LOCA_DURABS = LOCA_DURABS + HABS_MOTIDUR"
"ITPSACTHT3";"S";"0105";"                    * FINSI"
"ITPSACTHT3";"S";"0106";"                * FINSI"
"ITPSACTHT3";"S";"0107";"            * FINPOUR"
"ITPSACTHT3";"S";"0108";"            *"
"ITPSACTHT3";"S";"0109";"            * SI LOCA_DURABS <> 0"
"ITPSACTHT3";"S";"0110";"                * PRES_TPS_PRES = LOCA_DURABS"
"ITPSACTHT3";"S";"0111";"            * FINSI"
"ITPSACTHT3";"S";"0112";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT3";"S";"0113";"            *"
"ITPSACTHT3";"S";"0114";"            PRES_TPS_IMPUTE = 0"
"ITPSACTHT3";"S";"0115";"            SI HJOU_IJIACTI = ""1"""
"ITPSACTHT3";"S";"0116";"            OU HJOU_IJIACTI = ""2"""
"ITPSACTHT3";"S";"0117";"            OU HJOU_IJIACTI = ""3"""
"ITPSACTHT3";"S";"0118";"                POUR EVENEMENTS"
"ITPSACTPT2";"S";"0040";"*"
"ITPSACTHT3";"S";"0119";"                    PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT3";"S";"0120";"                FINPOUR"
"ITPSACTHT3";"S";"0121";"            FINSI"
"ITPSACTHT3";"S";"0122";"            * Calcul de l'écart"
"ITPSACTHT3";"S";"0123";"            PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT3";"S";"0124";"        FINSI"
"ITPSACTHT3";"S";"0125";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT3";"S";"0126";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT3";"S";"0127";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT3";"S";"0128";"        FINSI"
"ITPSACTHT3";"S";"0129";"    FINSI"
"ITPSACTHT3";"S";"0130";"FINSI"
"ITPSACTHT3";"S";"0131";"*"
"ITPSACTHT3";"S";"0132";"FIN"
