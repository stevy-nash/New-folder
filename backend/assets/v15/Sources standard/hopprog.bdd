"ITPSACTPTB";"S";"0066";"                SINON"
"ITPSACTPTB";"S";"0067";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTPTB";"S";"0068";"                FINSI"
"ITPSACTPTB";"S";"0069";"                *"
"ITPSACTPTB";"S";"0070";"                SI PRES_MODE_TRV = "" """
"ITPSACTPTB";"S";"0071";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPTB";"S";"0072";"                FINSI"
"ITPSACTPTB";"S";"0073";"                *"
"ITPSACTPTB";"S";"0074";"                * ----------------------------------------------------------------------------------"
"ITPSACTPTB";"S";"0075";"                *"
"ITPSACTPTB";"S";"0076";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTPTB";"S";"0077";"                *                              (A décommenter si besoin)"
"ITPSACTPTB";"S";"0078";"                *"
"ITPSACTPTB";"S";"0079";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITRAVPAU";"S";"0068";"    LOCA_PASS = 0"
"ITRAVPAU";"S";"0069";"    LOCA_ENTREE = 0"
"ITPSACTPTB";"S";"0080";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test de la"
"ITPSACTPTB";"S";"0081";"                * présence théorique différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTPTB";"S";"0082";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTPTB";"S";"0083";"                *"
"ITPSACTPTB";"S";"0084";"                * SI HJOU_IJRPRETHEM <> 0"
"ITPSACTPTB";"S";"0085";"                    PRES_TPS_PRES = HJOU_IJRPRETHEM"
"ITPSACTPTB";"S";"0086";"                * SINON"
"ITPSACTPTB";"S";"0087";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTPTB";"S";"0088";"                * FINSI"
"ITPSACTPTB";"S";"0089";"                * ----------------------------------------------------------------------------------"
"ITPSACTPTB";"S";"0090";"                *"
"ITPSACTPTB";"S";"0091";"                PRES_TPS_IMPUTE = 0"
"ITPSACTPTB";"S";"0092";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTPTB";"S";"0093";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTPTB";"S";"0094";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTPTB";"S";"0095";"                    POUR EVENEMENTS"
"ITPSACTPTB";"S";"0096";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTPTB";"S";"0097";"                    FINPOUR"
"ITPSACTPTB";"S";"0098";"                FINSI"
"ITPSACTPTB";"S";"0099";"                * Calcul de l'écart"
"ITPSACTPTB";"S";"0100";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTPTB";"S";"0101";"            FINSI"
"ITPSACTPTB";"S";"0102";"        FINSI"
"ITPSACTPTB";"S";"0103";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTPTB";"S";"0104";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTPTB";"S";"0105";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTPTB";"S";"0106";"        FINSI"
"ITPSACTPTB";"S";"0107";"    FINSI"
"ITPSACTPTB";"S";"0108";"FINSI"
"ITPSACTPTB";"S";"0109";"*"
"ITPSACTPTB";"S";"0110";"FIN"
"ITPSACTPTC";"S";"0001";"**********************************************************************"
"ITPSACTPTC";"S";"0002";"*"
"ITPSACTPTC";"S";"0003";"* Règle : ITPSACTPTC"
"ITPSACTPTC";"S";"0004";"* Ordre : 3460"
"ITPSACTPTC";"S";"0005";"* Titre : #HQ ACTIVITY# Tps de présence Activité avec présence théorique,"
"ITPSACTPTC";"S";"0006";"*          population <> section et mode mois (indicateur dans SEH)"
"ITPSACTPTC";"S";"0007";"*"
"ITPSACTPTC";"S";"0008";"*---------------------------------------------------------------------"
"ITPSACTPTC";"S";"0009";"*"
"ITPSACTPTC";"S";"0010";"* Créé par : Méthodes et outils"
"ITPSACTPTC";"S";"0011";"* Date     : 17/08/2020"
"ITPSACTPTC";"S";"0012";"* Version  : 1"
"ITPSACTPTC";"S";"0013";"*"
"ITPSACTPTC";"S";"0014";"*---------------------------------------------------------------------"
"ITPSACTPTC";"S";"0015";"*"
"ITPSACTPTC";"S";"0016";"*"
"ITPSACTPTC";"S";"0017";"* Rôle :"
"ITPSACTPTC";"S";"0018";"*"
"ITPSACTPTC";"S";"0019";"* Calcul du temps de présence activité avec la présence théorique"
"ITPSACTPTC";"S";"0020";"* pour population <> section et mode mois"
"ITPSACTPTC";"S";"0021";"* (gestion activité avec indicateur dans SEH)"
"ITPSACTPTC";"S";"0022";"*"
"ITPSACTPTC";"S";"0023";"*"
"ITPSACTPTC";"S";"0024";"*----------------------------------------------------------------------"
"ITPSACTPTC";"S";"0025";"*"
"ITPSACTPTC";"S";"0026";"* Modifiée par :"
"ITPSACTPTC";"S";"0027";"* Date         : JJ/MM/AAAA"
"ITPSACTPTC";"S";"0028";"* Objet        :"
"ITPSACTPTC";"S";"0029";"*"
"ITPSACTPTC";"S";"0030";"***********************************************************************"
"ITPSACTPTC";"S";"0031";"*"
"ITPSACTPTC";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTPTC";"S";"0033";"*"
"ITPSACTPTC";"S";"0034";"DEBDICO"
"ITPSACTPTC";"S";"0035";"SECH_ISIACTI;O;A1;X;;;123456789;L;;C3;""Section géré en activité"";"
"ITPSACTPTC";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTPTC";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTPTC";"S";"0038";"FINDICO"
"ITPSACTPTC";"S";"0039";"*"
"ITPSACTPTC";"S";"0040";"*"
"ITPSACTPTC";"S";"0041";"* DEBANO"
"ITPSACTPTC";"S";"0042";"*"
"ITPSACTPTC";"S";"0043";"* FINANO"
"ITPSACTPTC";"S";"0044";"*"
"ITPSACTPTC";"S";"0045";"* Définition des variables locales"
"ITPSACTPTC";"S";"0046";"*"
"ITPSACTPTC";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTPTC";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTPTC";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTPTC";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTPTC";"S";"0051";"    FINSI"
"ITPSACTPTC";"S";"0052";"FINSI"
"ITPSACTPTC";"S";"0053";"* Employé géré en activité"
"ITPSACTPTC";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTPTC";"S";"0055";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTPTC";"S";"0056";"        * Calcul de la présence activité le dernier jour du mois"
"ITPSACTPTC";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTPTC";"S";"0058";"        SI TEMP_DATSUI(7:2) = ""01"""
"ITPSACTPTC";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTPTC";"S";"0060";"            * Calcul de la présence activité"
"ITPSACTPTC";"S";"0061";"            SI PRES_VALID <> ""O"""
"ITPSACTPTC";"S";"0062";"                PRES_VALID = ""N"""
"ITPSACTPTC";"S";"0063";"                * d'activité à justifier"
"ITPSACTPTC";"S";"0064";"                PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTPTC";"S";"0065";"                PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTPTC";"S";"0066";"                *"
"ITPSACTPTC";"S";"0067";"                SI PRES_MODE_TRV = "" """
"ITPSACTPTC";"S";"0068";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPTC";"S";"0069";"                FINSI"
"ITPSACTPTC";"S";"0070";"                *"
"ITPSACTPTC";"S";"0071";"                * ----------------------------------------------------------------------------------"
"ITPSACTPTC";"S";"0072";"                *"
"ITPSACTPTC";"S";"0073";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTPTC";"S";"0074";"                *                              (A décommenter si besoin)"
"ITPSACTPTC";"S";"0075";"                *"
"ITPSACTPTC";"S";"0076";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTPTC";"S";"0077";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test de la"
"ITPSACTPTC";"S";"0078";"                * présence théorique différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTPTC";"S";"0079";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTPTC";"S";"0080";"                *"
"ITPSACTPTC";"S";"0081";"                * SI HJOU_IJRPRETHEM <> 0"
"ITPSACTPTC";"S";"0082";"                    PRES_TPS_PRES = HJOU_IJRPRETHEM"
"ITPSACTPTC";"S";"0083";"                * SINON"
"ITPSACTPTC";"S";"0084";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTPTC";"S";"0085";"                * FINSI"
"ITPSACTPTC";"S";"0086";"                * ----------------------------------------------------------------------------------"
"ITPSACTPTC";"S";"0087";"                *"
"ITPSACTPTC";"S";"0088";"                PRES_TPS_IMPUTE = 0"
"ITPSACTPTC";"S";"0089";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTPTC";"S";"0090";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTPTC";"S";"0091";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTPTC";"S";"0092";"                    POUR EVENEMENTS"
"ITPSACTPTC";"S";"0093";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTPTC";"S";"0094";"                    FINPOUR"
"ITPSACTPTC";"S";"0095";"                FINSI"
"ITPSACTPTC";"S";"0096";"                * Calcul de l'écart"
"ITPSACTPTC";"S";"0097";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTPTC";"S";"0098";"            FINSI"
"ITPSACTPTC";"S";"0099";"        FINSI"
"ITPSACTPTC";"S";"0100";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTPTC";"S";"0101";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTPTC";"S";"0102";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTPTC";"S";"0103";"        FINSI"
"ITPSACTPTC";"S";"0104";"    FINSI"
"ITPSACTPTC";"S";"0105";"FINSI"
"ITPSACTPTC";"S";"0106";"*"
"ITPSACTPTC";"S";"0107";"FIN"
"ITRAVPAU";"S";"0001";"***********************************************************************"
"ITRAVPAU";"S";"0002";"*"
"ITRAVPAU";"S";"0003";"* Règle : ITRAVPAU"
"ITRAVPAU";"S";"0004";"* Ordre : 2180"
"ITRAVPAU";"S";"0005";"* Titre : Analyse des temps de travail et de pause"
"ITRAVPAU";"S";"0006";"*"
"ITRAVPAU";"S";"0007";"*----------------------------------------------------------------------"
"ITRAVPAU";"S";"0008";"*"
"ITRAVPAU";"S";"0009";"* Créé par : Méthodes et outils"
"ITRAVPAU";"S";"0010";"* Date     : 04/11/2019"
"ITRAVPAU";"S";"0011";"* Version  : 1"
"ITRAVPAU";"S";"0012";"*"
"ITRAVPAU";"S";"0013";"*----------------------------------------------------------------------"
"ITRAVPAU";"S";"0014";"*"
"ITRAVPAU";"S";"0015";"* Rôle :"
"ITRAVPAU";"S";"0016";"*"
"ITRAVPAU";"S";"0017";"* Tester les temps de travail supérieurs à 6 heures. Erreur si c'est la cas"
"ITRAVPAU";"S";"0018";"* S'assurer de la présence d'une pause d'au moins 20 mn consécutives"
"ITRAVPAU";"S";"0019";"*"
"ITRAVPAU";"S";"0020";"*----------------------------------------------------------------------"
"ITRAVPAU";"S";"0021";"*"
"ITRAVPAU";"S";"0022";"* Modifiée par :"
"ITRAVPAU";"S";"0023";"* Date         :"
"ITRAVPAU";"S";"0024";"* Objet        :"
"ITRAVPAU";"S";"0025";"*"
"ITRAVPAU";"S";"0026";"*----------------------------------------------------------------------"
"ITRAVPAU";"S";"0027";"*"
"ITRAVPAU";"S";"0028";"* Implémentation des données industrielles"
"ITRAVPAU";"S";"0029";"*"
"ITRAVPAU";"S";"0030";"DEBDICO"
"ITRAVPAU";"S";"0031";"FINDICO"
"ITRAVPAU";"S";"0032";"*"
"ITRAVPAU";"S";"0033";"DEBANO"
"ITRAVPAU";"S";"0034";"   161;5;""Au-delà de 6 heures de travail minimum, une pause est obligatoire"";"
"ITRAVPAU";"S";"0035";"   162;5;""Une pause de 20 minutes consécutives est obligatoire"";"
"ITRAVPAU";"S";"0036";"FINANO"
"ITRAVPAU";"S";"0037";"*"
"ITRAVPAU";"S";"0038";"***********************************************************************"
"ITRAVPAU";"S";"0039";"*"
"ITRAVPAU";"S";"0040";"* Déclaration des donnees locales"
"ITRAVPAU";"S";"0041";"*"
"ITRAVPAU";"S";"0042";"***************************"
"ITRAVPAU";"S";"0043";"DEF LOCA_PASS N1"
"ITRAVPAU";"S";"0044";"LOCA_PASS = 0"
"ITRAVPAU";"S";"0045";"DEF LOCA_SORTIE T6.2"
"ITRAVPAU";"S";"0046";"LOCA_SORTIE = 0"
"ITRAVPAU";"S";"0047";"DEF LOCA_ENTREE T6.2"
"ITRAVPAU";"S";"0048";"LOCA_ENTREE = 0"
"ITRAVPAU";"S";"0049";"DEF LOCA_DUR T6.2"
"ITRAVPAU";"S";"0050";"LOCA_DUR = 0"
"ITRAVPAU";"S";"0051";"DEF LOCA_PAUSE T6.2"
"ITRAVPAU";"S";"0052";"LOCA_PAUSE = 0"
"ITRAVPAU";"S";"0053";"DEF LOCA_ANO N1"
"ITRAVPAU";"S";"0054";"LOCA_ANO = 0"
"ITRAVPAU";"S";"0055";"DEF LOCA_AGE N2"
"ITRAVPAU";"S";"0056";"LOCA_AGE = 0"
"ITRAVPAU";"S";"0057";"*"
"ITRAVPAU";"S";"0058";"*"
"ITRAVPAU";"S";"0059";"SI EMPS_E2DATENAI <> "" """
"ITRAVPAU";"S";"0060";"    DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"ITRAVPAU";"S";"0061";"    LOCA_AGE = TEMP_NXANNEE"
"ITRAVPAU";"S";"0062";"FINSI"
"ITRAVPAU";"S";"0063";"* Pour les personnes d'au moins 18 ans"
"ITRAVPAU";"S";"0064";"SI EMPS_E2DATENAI = "" """
"ITRAVPAU";"S";"0065";"OU LOCA_AGE >= 18"
"ITRAVPAU";"S";"0066";"    * Test si la durée de travail sans pause > 6 heures"
"ITRAVPAU";"S";"0067";"    *"
"ITRAVPAU";"S";"0070";"    LOCA_SORTIE = 0"
"ITRAVPAU";"S";"0071";"    LOCA_DUR = 0"
"ITRAVPAU";"S";"0072";"    LOCA_ANO = 0"
"ITRAVPAU";"S";"0073";"    *"
"ITRAVPAU";"S";"0074";"    POUR POINTAGES"
"ITRAVPAU";"S";"0075";"       SI POIN_SENS = ""0"""
"ITRAVPAU";"S";"0076";"          SI LOCA_PASS = 0"
"ITRAVPAU";"S";"0077";"             LOCA_ENTREE = POIN_HRETRAI"
"ITRAVPAU";"S";"0078";"             LOCA_PASS = 1"
"ITRAVPAU";"S";"0079";"          FINSI"
"ITRAVPAU";"S";"0080";"       FINSI"
"ITRAVPAU";"S";"0081";"       SI POIN_SENS = ""1"""
"ITRAVPAU";"S";"0082";"          SI LOCA_PASS = 1"
"ITRAVPAU";"S";"0083";"             LOCA_SORTIE = POIN_HRETRAI"
"ITRAVPAU";"S";"0084";"             LOCA_PASS = 0"
"ITRAVPAU";"S";"0085";"             LOCA_DUR = LOCA_SORTIE - LOCA_ENTREE"
"ITRAVPAU";"S";"0086";"             SI LOCA_DUR > 6"
"ITRAVPAU";"S";"0087";"                LOCA_ANO = 1"
"ITRAVPAU";"S";"0088";"             FINSI"
"ITRAVPAU";"S";"0089";"          FINSI"
"ITRAVPAU";"S";"0090";"       FINSI"
"ITRAVPAU";"S";"0091";"    FINPOUR"
"ITRAVPAU";"S";"0092";"    *"
"ITRAVPAU";"S";"0093";"    SI LOCA_ANO = 1"
"ITRAVPAU";"S";"0094";"       ANOMALIE 161"
"ITRAVPAU";"S";"0095";"    FINSI"
"ITRAVPAU";"S";"0096";"    *"
"ITRAVPAU";"S";"0097";"    *"
"ITRAVPAU";"S";"0098";"    * Test si une pause est bien de 20 minutes successives"
"ITRAVPAU";"S";"0099";"    *"
"ITRAVPAU";"S";"0100";"    LOCA_PASS = 0"
"ITRAVPAU";"S";"0101";"    LOCA_ENTREE = 0"
"ITRAVPAU";"S";"0102";"    LOCA_SORTIE = 0"
"ITRAVPAU";"S";"0103";"    LOCA_DUR = 0"
"ITRAVPAU";"S";"0104";"    LOCA_ANO = 0"
"ITRAVPAU";"S";"0105";"    *"
"ITRAVPAU";"S";"0106";"    POUR POINTAGES"
"ITRAVPAU";"S";"0107";"       SI POIN_SENS = ""1"""
"ITRAVPAU";"S";"0108";"          SI LOCA_PASS = 0"
"ITRAVPAU";"S";"0109";"             LOCA_SORTIE = POIN_HRETRAI"
"ITRAVPAU";"S";"0110";"             LOCA_PASS = 1"
"ITRAVPAU";"S";"0111";"          FINSI"
"ITRAVPAU";"S";"0112";"       FINSI"
"ITRAVPAU";"S";"0113";"       SI POIN_SENS = ""0"""
"ITRAVPAU";"S";"0114";"          SI LOCA_PASS = 1"
"ITRAVPAU";"S";"0115";"             LOCA_ENTREE = POIN_HRETRAI"
"ITRAVPAU";"S";"0116";"             LOCA_PASS = 0"
"ITRAVPAU";"S";"0117";"             LOCA_DUR = LOCA_ENTREE - LOCA_SORTIE"
"ITRAVPAU";"S";"0118";"             SI LOCA_DUR >= 0.20"
"ITRAVPAU";"S";"0119";"                LOCA_ANO = 1"
"ITRAVPAU";"S";"0120";"             FINSI"
"ITRAVPAU";"S";"0121";"             LOCA_PAUSE = LOCA_PAUSE + LOCA_DUR"
"ITRAVPAU";"S";"0122";"          FINSI"
"ITRAVPAU";"S";"0123";"       FINSI"
"ITRAVPAU";"S";"0124";"    FINPOUR"
"ITRAVPAU";"S";"0125";"    *"
"ITRAVPAU";"S";"0126";"    SI TEMP_NXPOIN <> 0"
"ITRAVPAU";"S";"0127";"        SI LOCA_PAUSE <> 0"
"ITRAVPAU";"S";"0128";"            SI LOCA_ANO = 0"
"ITRAVPAU";"S";"0129";"                ANOMALIE 162"
"ITRAVPAU";"S";"0130";"            FINSI"
"ITRAVPAU";"S";"0131";"        FINSI"
"ITRAVPAU";"S";"0132";"    FINSI"
"ITRAVPAU";"S";"0133";"FINSI"
"ITRAVPAU";"S";"0134";"*"
"ITRAVPAU";"S";"0135";"FIN"
"IVALAC";"S";"0001";"***********************************************************************"
"IVALAC";"S";"0002";"*"
"IVALAC";"S";"0003";"* Règle : IVALAC"
"IVALAC";"S";"0004";"* Ordre : 3160"
"IVALAC";"S";"0005";"* Titre : Gestion des jours de validite"
"IVALAC";"S";"0006";"*"
"IVALAC";"S";"0007";"*----------------------------------------------------------------------"
"IVALAC";"S";"0008";"*"
"IVALAC";"S";"0009";"* Créé par : Cellule Industrialisation"
"IVALAC";"S";"0010";"* Date     : 03/09/2009"
"IVALAC";"S";"0011";"* Version  : 1"
"IVALAC";"S";"0012";"*"
"IVALAC";"S";"0013";"*----------------------------------------------------------------------"
"IVALAC";"S";"0014";"*"
"IVALAC";"S";"0015";"*"
"IVALAC";"S";"0016";"* Rôle : Gestion des jours de validite"
"IVALAC";"S";"0017";"*"
"IVALAC";"S";"0018";"*"
"IVALAC";"S";"0019";"*"
"IVALAC";"S";"0020";"*"
"IVALAC";"S";"0021";"*----------------------------------------------------------------------"
"IVALAC";"S";"0022";"*"
"IVALAC";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"IVALAC";"S";"0024";"* Date         : JJ/MM/AAAA"
"IVALAC";"S";"0025";"* Objet        :"
"IVALAC";"S";"0026";"*"
"IVALAC";"S";"0027";"***********************************************************************"
"IVALAC";"S";"0028";"*"
"IVALAC";"S";"0029";"* Implémentation des données industrielles"
"IVALAC";"S";"0030";"*"
"IVALAC";"S";"0031";"DEBDICO"
"IVALAC";"S";"0032";"FINDICO"
"IVALAC";"S";"0033";"*"
"IVALAC";"S";"0034";"* Déclaration des donnees locales"
"IVALAC";"S";"0035";"*"
"IVALAC";"S";"0036";"DEF LOCA_ENLEVER N1"
"IVALAC";"S";"0037";"DEF LOCA_MOTIF A10"
"IVALAC";"S";"0038";"LOCA_MOTIF = "" """
"IVALAC";"S";"0039";"DEF LOCA_VALID A4"
"IVALAC";"S";"0040";"LOCA_VALID = "" """
"IVALAC";"S";"0041";"*"
"IVALAC";"S";"0042";"SI HJOU_DATE <= TEMP_DATJOU"
"IVALAC";"S";"0043";"   POUR ACTIVITES"
"IVALAC";"S";"0044";"      SI HABS_MOTYPE <> ""C"""
"IVALAC";"S";"0045";"         LOCA_ENLEVER = 0"
"IVALAC";"S";"0046";"         LOCA_MOTIF = HABS_MOTIF"
"IVALAC";"S";"0047";"         LOCA_VALID = MOTI_VALID"
"IVALAC";"S";"0048";"         SI LOCA_VALID(1:1) = ""O"""
"IVALAC";"S";"0049";"            SI PARD_IDIJOUROUV = ""1"""
"IVALAC";"S";"0050";"               SI HJOU_IJQPRETHEJ = 0"
"IVALAC";"S";"0051";"                  LOCA_ENLEVER = 1"
"IVALAC";"S";"0052";"               FINSI"
"IVALAC";"S";"0053";"            SINON"
"IVALAC";"S";"0054";"               SI HJOU_JOUR = ""6"""
"IVALAC";"S";"0055";"                  SI HJOU_IJQPRETHEJ = 0"
"IVALAC";"S";"0056";"                     LOCA_ENLEVER = 1"
"IVALAC";"S";"0057";"                  FINSI"
"IVALAC";"S";"0058";"               FINSI"
"IVALAC";"S";"0059";"            FINSI"
"IVALAC";"S";"0060";"         FINSI"
"IVALAC";"S";"0061";"         SI LOCA_VALID(2:1) = ""S"""
"IVALAC";"S";"0062";"            LOCA_ENLEVER = 0"
"IVALAC";"S";"0063";"         FINSI"
"IVALAC";"S";"0064";"         SI LOCA_VALID(3:1) = "" """
"IVALAC";"S";"0065";"            SI HJOU_JOUR = ""7"""
"IVALAC";"S";"0066";"               SI HJOU_IJQPRETHEJ = 0"
"IVALAC";"S";"0067";"                  LOCA_ENLEVER = 1"
"IVALAC";"S";"0068";"               FINSI"
"IVALAC";"S";"0069";"            FINSI"
"IVALAC";"S";"0070";"         FINSI"
"IVALAC";"S";"0071";"      FINSI"
"IVALAC";"S";"0072";"   FINPOUR"
"IVALAC";"S";"0073";"   SI LOCA_ENLEVER = 1"
"IVALAC";"S";"0074";"      ENLEVER LOCA_MOTIF"
"IVALAC";"S";"0075";"   FINSI"
"IVALAC";"S";"0076";"FINSI"
"IVALAC";"S";"0077";"FIN"
"IVALPA";"S";"0001";"***********************************************************************"
"IVALPA";"S";"0002";"*"
"IVALPA";"S";"0003";"* Règle : IVALPA"
"IVALPA";"S";"0004";"* Ordre : 3200"
"IVALPA";"S";"0005";"* Titre : Valorisation des pauses"
"IVALPA";"S";"0006";"*"
"IVALPA";"S";"0007";"*----------------------------------------------------------------------"
"IVALPA";"S";"0008";"*"
"IVALPA";"S";"0009";"* Créé par : Cellule Industrialisation"
"IVALPA";"S";"0010";"* Date     : 03/09/2009"
"IVALPA";"S";"0011";"* Version  : 1"
"IVALPA";"S";"0012";"*"
"IVALPA";"S";"0013";"*----------------------------------------------------------------------"
"IVALPA";"S";"0014";"*"
"IVALPA";"S";"0015";"*"
"IVALPA";"S";"0016";"* Rôle : Valorisation des pauses"
"IVALPA";"S";"0017";"*"
"IVALPA";"S";"0018";"*"
"IVALPA";"S";"0019";"*"
"IVALPA";"S";"0020";"*"
"IVALPA";"S";"0021";"* Implémentation des données industrielles"
"IVALPA";"S";"0022";"*"
"IVALPA";"S";"0023";"*----------------------------------------------------------------------"
"IVALPA";"S";"0024";"*"
"IVALPA";"S";"0025";"* Modifiée par : Cellule Industrialisation"
"IVALPA";"S";"0026";"* Date         : JJ/MM/AAAA"
"IVALPA";"S";"0027";"* Objet        :"
"IVALPA";"S";"0028";"*"
"IVALPA";"S";"0029";"***********************************************************************"
"IVALPA";"S";"0030";"*"
"IVALPA";"S";"0031";"DEBDICO"
"IVALPA";"S";"0032";"   PROF_IPIFPAUSBA;O;Z1;X;0;1;123456789;C;;C2;""Pause badgée"";"
"IVALPA";"S";"0033";"   HJOU_IJQECPAUMA;N;T6,2;I;;;     6789;;;V3;""Ecart pause première plage"";"
"IVALPA";"S";"0034";"   HJOU_IJQECPAUSO;N;T6,2;I;;;     6789;;;V3;""Ecart pause seconde plage"";"
"IVALPA";"S";"0035";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"IVALPA";"S";"0036";"   HJOU_IJQPRESEFF;N;T6,2;I;;;    56789;;;V3;""Base calcul des pauses pour h effectives"";"
"IVALPA";"S";"0037";"   HJOU_IJQPRESBAV;N;T6,2;I;;;    56789;;;V3;""Présence badgée validée"";"
"IVALPA";"S";"0038";"   HJOU_IJQPAUPPLA;N;T6,2;I;;;    56789;;;V3;""Pause premiere plage"";"
"IVALPA";"S";"0039";"   HJOU_IJQPAUSPLA;N;T6,2;I;;;    56789;;;V3;""Pause seconde plage"";"
"IVALPA";"S";"0040";"FINDICO"
"IVALPA";"S";"0041";"*"
"IVALPA";"S";"0042";"DEBANO"
"IVALPA";"S";"0043";"   138;5;""Retrait du temps de pause forfaitaire première plage"";"
"IVALPA";"S";"0044";"   139;5;""Crédit du temps de pause forfaitaire première plage"";"
"IVALPA";"S";"0045";"   142;5;""Absence de badgeage en pause première plage"";"
"IVALPA";"S";"0046";"   140;5;""Retrait du complément de temps de pause première plage"";"
"IVALPA";"S";"0047";"   141;5;""Crédit du temps de pause première plage"";"
"IVALPA";"S";"0048";"   150;5;""Retrait du temps de pause forfaitaire seconde plage"";"
"IVALPA";"S";"0049";"   151;5;""Crédit du temps de pause forfaitaire seconde plage"";"
"IVALPA";"S";"0050";"   152;5;""Absence de badgeage en pause seconde seconde plage"";"
"IVALPA";"S";"0051";"   153;5;""Retrait du complément de temps de pause seconde plage"";"
"IVALPA";"S";"0052";"   154;5;""Crédit du temps de pause seconde plage"";"
"IVALPA";"S";"0053";"FINANO"
"IVALPA";"S";"0054";"* Déclaration des donnees locales"
"IVALPA";"S";"0055";"*"
"IVALPA";"S";"0056";"SI HJOU_DATE <= TEMP_DATJOU"
"IVALPA";"S";"0057";"* alimentation du compteur de base de calcul des heures effectives"
"IVALPA";"S";"0058";"   HJOU_IJQPRESEFF = HJOU_IJQPRESBAV"
"IVALPA";"S";"0059";"*************************************"
"IVALPA";"S";"0060";"*"
"IVALPA";"S";"0061";"* Calcul de l'ecart sur pause si elle est badgee"
"IVALPA";"S";"0062";"****************************************************************"
"IVALPA";"S";"0063";"   SI PROF_IPIFPAUSBA = ""1"""
"IVALPA";"S";"0064";"      SI HJOU_IJQNBADGEA > 0"
"IVALPA";"S";"0065";"* test si pas d'absence de type M"
"IVALPA";"S";"0066";"         SI HJOU_IJQNABSEN1 = 0"
"IVALPA";"S";"0067";"** Pause matin"
"IVALPA";"S";"0068";"            SI PROF_IPIVFPAUMA > 0"
"IVALPA";"S";"0069";"               HJOU_IJQECPAUMA = HJOU_IJQPAUSMAT - PROF_IPIVFPAUMA"
"IVALPA";"S";"0070";"* si le temps de pause badgé > tps pause minimum"
"IVALPA";"S";"0071";"* l'ecart est remis à 0"
"IVALPA";"S";"0072";"               SI HJOU_IJQECPAUMA > 0"
"IVALPA";"S";"0073";"                  HJOU_IJQECPAUMA = 0"
"IVALPA";"S";"0074";"               FINSI"
"IVALPA";"S";"0075";"            FINSI"
"IVALPA";"S";"0076";"         FINSI"
"IVALPA";"S";"0077";"** pause soir"
"IVALPA";"S";"0078";"* test si pas absence de type A"
"IVALPA";"S";"0079";"         SI HJOU_IJQNABSEN2 = 0"
"IVALPA";"S";"0080";"            SI PROF_IPIVFPAUSO > 0"
"IVALPA";"S";"0081";"               HJOU_IJQECPAUSO = HJOU_IJQPAUSSOI - PROF_IPIVFPAUSO"
"IVANAL";"S";"0004";"* Ordre : 3330"
"IVALPA";"S";"0082";"* si le temps de pause badgé > tps pause minimum"
"IVALPA";"S";"0083";"* l'ecart est remis à 0"
"IVALPA";"S";"0084";"               SI HJOU_IJQECPAUSO > 0"
"IVALPA";"S";"0085";"                  HJOU_IJQECPAUSO = 0"
"IVALPA";"S";"0086";"               FINSI"
"IVALPA";"S";"0087";"            FINSI"
"IVALPA";"S";"0088";"         FINSI"
"IVALPA";"S";"0089";"      FINSI"
"IVALPA";"S";"0090";"   FINSI"
"IVALPA";"S";"0091";"****************************************************************"
"IVALPA";"S";"0092";"* Valorisation de la pause"
"IVALPA";"S";"0093";"****************************************************************"
"IVALPA";"S";"0094";"   SI HJOU_IJQNBADGEA >= 2"
"IVALPA";"S";"0095";"*************************************************************"
"IVALPA";"S";"0096";"* Pause matin"
"IVALPA";"S";"0097";"*************************************************************"
"IVALPA";"S";"0098";"* Pause non badgée"
"IVALPA";"S";"0099";"*"
"IVALPA";"S";"0100";"      SI PROF_IPIVFPAUMA > 0"
"IVALPA";"S";"0101";"* pas d'absence de type M"
"IVALPA";"S";"0102";"         SI HJOU_IJQNABSEN1 = 0"
"IVALPA";"S";"0103";"* cas ou la pause n'est pas badgee et pas creditee"
"IVALPA";"S";"0104";"            SI PROF_IPIFPAUSBA <> ""1"""
"IVALPA";"S";"0105";"               SI PROF_IPIGPAUSME = ""0"""
"IVALPA";"S";"0106";"** Pause premiere plage"
"IVALPA";"S";"0107";"                  HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQPAUSMAT"
"IVALPA";"S";"0108";"                  HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQPAUSMAT"
"IVALPA";"S";"0109";"                  HJOU_IJQPRESEFF = HJOU_IJQPRESEFF - HJOU_IJQPAUSMAT"
"IVALPA";"S";"0110";"                  HJOU_IJQPAUPPLA = HJOU_IJQPAUSMAT * -1"
"IVALPA";"S";"0111";"                  ANOMALIE 138"
"IVALPA";"S";"0112";"               FINSI"
"IVALPA";"S";"0113";"            FINSI"
"IVALPA";"S";"0114";"* cas ou la pause n'est pas badgee et pas creditee uniquement dans les"
"IVALPA";"S";"0115";"* heures totales jour (on ne touche pas aux heures effectives"
"IVALPA";"S";"0116";"            SI PROF_IPIFPAUSBA <> ""1"""
"IVALPA";"S";"0117";"               SI PROF_IPIGPAUSME = ""2"""
"IVALPA";"S";"0118";"** Pause premiere plage"
"IVALPA";"S";"0119";"                  HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQPAUSMAT"
"IVALPA";"S";"0120";"                  HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQPAUSMAT"
"IVALPA";"S";"0121";"                  HJOU_IJQPAUPPLA = HJOU_IJQPAUSMAT * -1"
"IVALPA";"S";"0122";"                  ANOMALIE 138"
"IVALPA";"S";"0123";"               FINSI"
"IVALPA";"S";"0124";"            FINSI"
"IVALPA";"S";"0125";"* cas ou la pause n'est pas badgée et est creditee"
"IVALPA";"S";"0126";"            SI PROF_IPIFPAUSBA <> ""1"""
"IVALPA";"S";"0127";"               SI PROF_IPIGPAUSME = ""1"""
"IVALPA";"S";"0128";"                  HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0129";"                  HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0130";"                  HJOU_IJQPRESEFF = HJOU_IJQPRESEFF + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0131";"                  HJOU_IJQPAUPPLA = HJOU_IJQPAUSMAT"
"IVALPA";"S";"0132";"                  ANOMALIE 139"
"IVALPA";"S";"0133";"               FINSI"
"IVALPA";"S";"0134";"            FINSI"
"IVALPA";"S";"0135";"* cas ou la pause n'est pas badgée et est creditee uniquement dans les"
"IVALPA";"S";"0136";"* heures totales jour on ne touche pas aux heures effectives"
"IVALPA";"S";"0137";"            SI PROF_IPIFPAUSBA <> ""1"""
"IVALPA";"S";"0138";"               SI PROF_IPIGPAUSME = ""3"""
"IVALPA";"S";"0139";"                  HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0140";"                  HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0141";"                  HJOU_IJQPAUPPLA = HJOU_IJQPAUSMAT"
"IVALPA";"S";"0142";"                  ANOMALIE 139"
"IVALPA";"S";"0143";"               FINSI"
"IVALPA";"S";"0144";"            FINSI"
"IVALPA";"S";"0145";"* cas ou la pause est badgee"
"IVALPA";"S";"0146";"            SI PROF_IPIFPAUSBA = ""1"""
"IVALPA";"S";"0147";"* Anomalie si la pause n'a aps ete badgee"
"IVALPA";"S";"0148";"               SI HJOU_IJQPAUSMAT = 0"
"IVALPA";"S";"0149";"                  ANOMALIE 142"
"IVALPA";"S";"0150";"               FINSI"
"IVALPA";"S";"0151";"* Cas ou elle n'est pas credite on deduit l'ecart"
"IVALPA";"S";"0152";"* si elle est < à la pause minimum"
"IVALPA";"S";"0153";"               SI PROF_IPIGPAUSME = ""0"""
"IVALPA";"S";"0154";"                  SI HJOU_IJQECPAUMA < 0"
"IVALPA";"S";"0155";"                     HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQECPAUMA"
"IVALPA";"S";"0156";"                     HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQECPAUMA"
"IVALPA";"S";"0157";"                     HJOU_IJQPRESEFF = HJOU_IJQPRESEFF + HJOU_IJQECPAUMA"
"IVALPA";"S";"0158";"                     HJOU_IJQPAUPPLA = HJOU_IJQECPAUMA"
"IVALPA";"S";"0159";"                     ANOMALIE 140"
"IVALPA";"S";"0160";"                  FINSI"
"IVALPA";"S";"0161";"               FINSI"
"IVALPA";"S";"0162";"* Cas ou elle n'est pas credite on deduit l'ecart"
"IVALPA";"S";"0163";"* uniquement su les heures totales jour"
"IVALPA";"S";"0164";"* on ne touche pas aux heures effectives"
"IVALPA";"S";"0165";"* si elle est < à la pause minimum"
"IVALPA";"S";"0166";"               SI PROF_IPIGPAUSME = ""2"""
"IVALPA";"S";"0167";"                  SI HJOU_IJQECPAUMA < 0"
"IVALPA";"S";"0168";"                     HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQECPAUMA"
"IVALPA";"S";"0169";"                     HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQECPAUMA"
"IVALPA";"S";"0170";"                     HJOU_IJQPAUPPLA = HJOU_IJQECPAUMA"
"IVALPA";"S";"0171";"                     ANOMALIE 140"
"IVALPA";"S";"0172";"                  FINSI"
"IVALPA";"S";"0173";"               FINSI"
"IVALPA";"S";"0174";"* Cas ou elle est creditee"
"IVALPA";"S";"0175";"               SI PROF_IPIGPAUSME = ""1"""
"IVALPA";"S";"0176";"* Si elle est > à la pause minimum"
"IVALPA";"S";"0177";"* on redonne le temps de pause du profil"
"IVALPA";"S";"0178";"                  SI HJOU_IJQPAUSMAT >= PROF_IPIVFPAUMA"
"IVALPA";"S";"0179";"                     HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + PROF_IPIVFPAUMA"
"IVALPA";"S";"0180";"                     HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + PROF_IPIVFPAUMA"
"IVALPA";"S";"0181";"                     HJOU_IJQPRESEFF = HJOU_IJQPRESEFF + PROF_IPIVFPAUMA"
"IVALPA";"S";"0182";"                     HJOU_IJQPAUPPLA = PROF_IPIVFPAUMA"
"IVALPA";"S";"0183";"                     ANOMALIE 139"
"IVALPA";"S";"0184";"                  FINSI"
"IVALPA";"S";"0185";"* Si elle est < à la pause minimum"
"IVALPA";"S";"0186";"* on redonne le temps de pause badgee"
"IVALPA";"S";"0187";"                  SI HJOU_IJQPAUSMAT < PROF_IPIVFPAUMA"
"IVALPA";"S";"0188";"* Cas ou le temps de pause est egal à 0"
"IVALPA";"S";"0189";"                     SI HJOU_IJQPAUSMAT > 0"
"IVALPA";"S";"0190";"                        HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0191";"                        HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0192";"                        HJOU_IJQPRESEFF = HJOU_IJQPRESEFF + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0193";"                        HJOU_IJQPAUPPLA = HJOU_IJQPAUSMAT"
"IVALPA";"S";"0194";"                        ANOMALIE 141"
"IVALPA";"S";"0195";"                     FINSI"
"IVALPA";"S";"0196";"                  FINSI"
"IVALPA";"S";"0197";"               FINSI"
"IVALPA";"S";"0198";"* Cas ou elle est creditee uniquement dans les heures toales jour"
"IVALPA";"S";"0199";"* on ne touche pas aux heures effectives"
"IVALPA";"S";"0200";"               SI PROF_IPIGPAUSME = ""3"""
"IVALPA";"S";"0201";"* Si elle est > à la pause minimum"
"IVALPA";"S";"0202";"* on redonne le temps de pause du profil"
"IVALPA";"S";"0203";"                  SI HJOU_IJQPAUSMAT >= PROF_IPIVFPAUMA"
"IVALPA";"S";"0204";"                     HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + PROF_IPIVFPAUMA"
"IVALPA";"S";"0205";"                     HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + PROF_IPIVFPAUMA"
"IVALPA";"S";"0206";"                     HJOU_IJQPAUPPLA = PROF_IPIVFPAUMA"
"IVALPA";"S";"0207";"                     ANOMALIE 139"
"IVALPA";"S";"0208";"                  FINSI"
"IVALPA";"S";"0209";"* Si elle est < à la pause minimum"
"IVALPA";"S";"0210";"* on redonne le temps de pause badgee"
"IVALPA";"S";"0211";"                  SI HJOU_IJQPAUSMAT < PROF_IPIVFPAUMA"
"IVALPA";"S";"0212";"* Cas ou le temps de pause est egal à 0"
"IVALPA";"S";"0213";"                     SI HJOU_IJQPAUSMAT > 0"
"IVALPA";"S";"0214";"                        HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0215";"                        HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQPAUSMAT"
"IVALPA";"S";"0216";"                        HJOU_IJQPAUPPLA = HJOU_IJQPAUSMAT"
"IVALPA";"S";"0217";"                        ANOMALIE 141"
"IVALPA";"S";"0218";"                     FINSI"
"IVALPA";"S";"0219";"                  FINSI"
"IVALPA";"S";"0220";"               FINSI"
"IVALPA";"S";"0221";"            FINSI"
"IVALPA";"S";"0222";"         FINSI"
"IVALPA";"S";"0223";"      FINSI"
"IVALPA";"S";"0224";"*************************************************************"
"IVALPA";"S";"0225";"* Pause soir"
"IVALPA";"S";"0226";"*************************************************************"
"IVALPA";"S";"0227";"* Pause non badgée"
"IVALPA";"S";"0228";"*"
"IVALPA";"S";"0229";"      SI PROF_IPIVFPAUSO > 0"
"IVALPA";"S";"0230";"* test si pas d'absence de type A"
"IVALPA";"S";"0231";"         SI HJOU_IJQNABSEN2 = 0"
"IVALPA";"S";"0232";"* cas ou la pause n'est pas badgee et pas creditee"
"IVALPA";"S";"0233";"            SI PROF_IPIFPAUSBA <> ""1"""
"IVALPA";"S";"0234";"               SI PROF_IPIGPAUSME = ""0"""
"IVALPA";"S";"0235";"** Pause seconde plage"
"IVALPA";"S";"0236";"                  HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQPAUSSOI"
"IVALPA";"S";"0237";"                  HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQPAUSSOI"
"IVALPA";"S";"0238";"                  HJOU_IJQPRESEFF = HJOU_IJQPRESEFF - HJOU_IJQPAUSSOI"
"IVALPA";"S";"0239";"                  HJOU_IJQPAUSPLA = HJOU_IJQPAUSSOI * -1"
"IVALPA";"S";"0240";"                  ANOMALIE 150"
"IVALPA";"S";"0241";"               FINSI"
"IVALPA";"S";"0242";"            FINSI"
"IVALPA";"S";"0243";"* cas ou la pause n'est pas badgee et pas creditee unquement dans les heures total jour"
"IVALPA";"S";"0244";"* on ne touche pas aux heures effectives"
"IVALPA";"S";"0245";"            SI PROF_IPIFPAUSBA <> ""1"""
"IVALPA";"S";"0246";"               SI PROF_IPIGPAUSME = ""2"""
"IVALPA";"S";"0247";"** Pause seconde plage"
"IVALPA";"S";"0248";"                  HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQPAUSSOI"
"IVALPA";"S";"0249";"                  HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQPAUSSOI"
"IVALPA";"S";"0250";"                  HJOU_IJQPAUSPLA = HJOU_IJQPAUSSOI * -1"
"IVALPA";"S";"0251";"                  ANOMALIE 150"
"IVALPA";"S";"0252";"               FINSI"
"IVALPA";"S";"0253";"            FINSI"
"IVALPA";"S";"0254";"* cas ou la pause n'est pas badgée et est creditee"
"IVALPA";"S";"0255";"            SI PROF_IPIFPAUSBA <> ""1"""
"IVALPA";"S";"0256";"               SI PROF_IPIGPAUSME = ""1"""
"IVALPA";"S";"0257";"                  HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0258";"                  HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0259";"                  HJOU_IJQPRESEFF = HJOU_IJQPRESEFF + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0260";"                  HJOU_IJQPAUSPLA = HJOU_IJQPAUSSOI"
"IVALPA";"S";"0261";"                  ANOMALIE 151"
"IVALPA";"S";"0262";"               FINSI"
"IVALPA";"S";"0263";"            FINSI"
"IVALPA";"S";"0264";"* cas ou la pause n'est pas badgée et est creditee"
"IVALPA";"S";"0265";"* uniquement dans les heures totales jour"
"IVALPA";"S";"0266";"* on ne touche pas aux heures effectives"
"IVALPA";"S";"0267";"            SI PROF_IPIFPAUSBA <> ""1"""
"IVALPA";"S";"0268";"               SI PROF_IPIGPAUSME = ""3"""
"IVALPA";"S";"0269";"                  HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0270";"                  HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0271";"                  HJOU_IJQPAUSPLA = HJOU_IJQPAUSSOI"
"IVALPA";"S";"0272";"                  ANOMALIE 151"
"IVALPA";"S";"0273";"               FINSI"
"IVALPA";"S";"0274";"            FINSI"
"IVALPA";"S";"0275";"* cas ou la pause est badgee"
"IVALPA";"S";"0276";"            SI PROF_IPIFPAUSBA = ""1"""
"IVALPA";"S";"0277";"* Anomalie si la pause n'a aps ete badgee"
"IVALPA";"S";"0278";"               SI HJOU_IJQPAUSSOI = 0"
"IVALPA";"S";"0279";"                  ANOMALIE 152"
"IVALPA";"S";"0280";"               FINSI"
"IVALPA";"S";"0281";"* Cas ou elle n'est pas credite on deduit l'ecart"
"IVALPA";"S";"0282";"* si elle est < à la pause minimum"
"IVALPA";"S";"0283";"               SI PROF_IPIGPAUSME = ""0"""
"IVALPA";"S";"0284";"                  SI HJOU_IJQECPAUSO < 0"
"IVALPA";"S";"0285";"                     HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQECPAUSO"
"IVALPA";"S";"0286";"                     HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQECPAUSO"
"IVALPA";"S";"0287";"                     HJOU_IJQPRESEFF = HJOU_IJQPRESEFF + HJOU_IJQECPAUSO"
"IVALPA";"S";"0288";"                     HJOU_IJQPAUSPLA = HJOU_IJQECPAUSO"
"IVALPA";"S";"0289";"                     ANOMALIE 153"
"IVALPA";"S";"0290";"                  FINSI"
"IVALPA";"S";"0291";"               FINSI"
"IVALPA";"S";"0292";"* Cas ou elle n'est pas credite"
"IVALPA";"S";"0293";"* uniquement dans les heures totales jour on deduit l'ecart"
"IVALPA";"S";"0294";"* on ne touche pas aux heures effectives"
"IVALPA";"S";"0295";"* si elle est < à la pause minimum"
"IVALPA";"S";"0296";"               SI PROF_IPIGPAUSME = ""2"""
"IVALPA";"S";"0297";"                  SI HJOU_IJQECPAUSO < 0"
"IVALPA";"S";"0298";"                     HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQECPAUSO"
"IVALPA";"S";"0299";"                     HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQECPAUSO"
"IVALPA";"S";"0300";"                     HJOU_IJQPAUSPLA = HJOU_IJQECPAUSO"
"IVALPA";"S";"0301";"                     ANOMALIE 153"
"IVALPA";"S";"0302";"                  FINSI"
"IVALPA";"S";"0303";"               FINSI"
"IVALPA";"S";"0304";"* Cas ou elle est creditee"
"IVALPA";"S";"0305";"               SI PROF_IPIGPAUSME = ""1"""
"IVALPA";"S";"0306";"* Si elle est > à la pause minimum"
"IVALPA";"S";"0307";"* on redonne le temps de pause du profil"
"IVALPA";"S";"0308";"                  SI HJOU_IJQPAUSSOI >= PROF_IPIVFPAUSO"
"IVALPA";"S";"0309";"                     HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + PROF_IPIVFPAUSO"
"IVALPA";"S";"0310";"                     HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + PROF_IPIVFPAUSO"
"IVALPA";"S";"0311";"                     HJOU_IJQPRESEFF = HJOU_IJQPRESEFF + PROF_IPIVFPAUSO"
"IVALPA";"S";"0312";"                     HJOU_IJQPAUSPLA = PROF_IPIVFPAUSO"
"IVALPA";"S";"0313";"                     ANOMALIE 151"
"IVALPA";"S";"0314";"                  FINSI"
"IVALPA";"S";"0315";"* Si elle est < à la pause minimum"
"IVALPA";"S";"0316";"* on redonne le temps de pause badgee"
"IVALPA";"S";"0317";"                  SI HJOU_IJQPAUSSOI < PROF_IPIVFPAUSO"
"IVALPA";"S";"0318";"* Cas ou le temps de pause est egal à 0"
"IVALPA";"S";"0319";"                     SI HJOU_IJQPAUSSOI > 0"
"IVALPA";"S";"0320";"                        HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0321";"                        HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0322";"                        HJOU_IJQPRESEFF = HJOU_IJQPRESEFF + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0323";"                        HJOU_IJQPAUSPLA = HJOU_IJQPAUSSOI"
"IVALPA";"S";"0324";"                        ANOMALIE 154"
"IVALPA";"S";"0325";"                     FINSI"
"IVALPA";"S";"0326";"                  FINSI"
"IVALPA";"S";"0327";"               FINSI"
"IVALPA";"S";"0328";"* cas ou elle est créditée uniquement dans les heures totales jour"
"IVALPA";"S";"0329";"* on ne touche pas aux heures effectives"
"IVALPA";"S";"0330";"               SI PROF_IPIGPAUSME = ""3"""
"IVALPA";"S";"0331";"* Si elle est > à la pause minimum"
"IVALPA";"S";"0332";"* on redonne le temps de pause du profil"
"IVALPA";"S";"0333";"                  SI HJOU_IJQPAUSSOI >= PROF_IPIVFPAUSO"
"IVALPA";"S";"0334";"                     HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + PROF_IPIVFPAUSO"
"IVALPA";"S";"0335";"                     HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + PROF_IPIVFPAUSO"
"IVALPA";"S";"0336";"                     HJOU_IJQPAUSPLA = PROF_IPIVFPAUSO"
"IVALPA";"S";"0337";"                     ANOMALIE 151"
"IVALPA";"S";"0338";"                  FINSI"
"IVALPA";"S";"0339";"* Si elle est < à la pause minimum"
"IVALPA";"S";"0340";"* on redonne le temps de pause badgee"
"IVALPA";"S";"0341";"                  SI HJOU_IJQPAUSSOI < PROF_IPIVFPAUSO"
"IVALPA";"S";"0342";"* Cas ou le temps de pause est egal à 0"
"IVALPA";"S";"0343";"                     SI HJOU_IJQPAUSSOI > 0"
"IVALPA";"S";"0344";"                        HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0345";"                        HJOU_IJQPRESBAV = HJOU_IJQPRESBAV + HJOU_IJQPAUSSOI"
"IVALPA";"S";"0346";"                        HJOU_IJQPAUSPLA = HJOU_IJQPAUSSOI"
"IVALPA";"S";"0347";"                        ANOMALIE 154"
"IVALPA";"S";"0348";"                     FINSI"
"IVALPA";"S";"0349";"                  FINSI"
"IVALPA";"S";"0350";"               FINSI"
"IVALPA";"S";"0351";"            FINSI"
"IVALPA";"S";"0352";"         FINSI"
"IVALPA";"S";"0353";"      FINSI"
"IVALPA";"S";"0354";"   FINSI"
"IVALPA";"S";"0355";"FINSI"
"IVALPA";"S";"0356";"FIN"
"IVANAL";"S";"0001";"***********************************************************************"
"IVANAL";"S";"0002";"*"
"IVANAL";"S";"0003";"* Règle : IVANAL"
"IVANAL";"S";"0005";"* Titre : Ventilation analytique"
"IVANAL";"S";"0006";"*"
"IVANAL";"S";"0007";"*----------------------------------------------------------------------"
"IVANAL";"S";"0008";"*"
"IVANAL";"S";"0009";"* Créé par : Cellule Industrialisation"
"IVANAL";"S";"0010";"* Date     : 03/09/2009"
"IVANAL";"S";"0011";"* Version  : 1"
"IVANAL";"S";"0012";"*"
"IVANAL";"S";"0013";"*----------------------------------------------------------------------"
"IVANAL";"S";"0014";"*"
"IVANAL";"S";"0015";"*"
"IVANAL";"S";"0016";"* Rôle : Ventilation analytique"
"IVANAL";"S";"0017";"*"
"IVANAL";"S";"0018";"*"
"IVANAL";"S";"0019";"*"
"IVANAL";"S";"0020";"*"
"IVANAL";"S";"0021";"*"
"IVANAL";"S";"0022";"*----------------------------------------------------------------------"
"IVANAL";"S";"0023";"*"
"IVANAL";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IVANAL";"S";"0025";"* Date         : JJ/MM/AAAA"
"IVANAL";"S";"0026";"* Objet        :"
"IVANAL";"S";"0027";"*"
"IVANAL";"S";"0028";"***********************************************************************"
"IVANAL";"S";"0029";"*"
"IVANAL";"S";"0030";"* Implémentation des données industrielles"
"IVANAL";"S";"0031";"*"
"IVANAL";"S";"0032";"DEBDICO"
"IVANAL";"S";"0033";"   HJOU_IJQHANAVEN;O;T6,2;I;;;    56789;;;V3;""Temps analytique à ventiler"";"
"IVANAL";"S";"0034";"FINDICO"
"IVANAL";"S";"0035";"*"
"IVANAL";"S";"0036";"*"
"IVANAL";"S";"0037";"DEBANO"
"IVANAL";"S";"0038";"   174;5;""Temps analytique imputé inférieur au temps à ventiler"";"
"IVANAL";"S";"0039";"   175;5;""Temps analytique imputé supérieur au temps à ventiler"";"
"IVANAL";"S";"0040";"FINANO"
"IVANAL";"S";"0041";"* Déclaration des donnees locales"
"IVANAL";"S";"0042";"*"
"IVANAL";"S";"0043";"SI HJOU_DATE <= TEMP_DATJOU"
"IVANAL";"S";"0044";"   SI HJOU_INMOD > ""0"""
"IVANAL";"S";"0045";"* Temps a ventiler"
"IVANAL";"S";"0046";"      HJOU_IJQHANAVEN = HJOU_IJQPRESBAV"
"IVANAL";"S";"0047";"* mise en place anomalies"
"IVANAL";"S";"0048";"      SI HJOU_IJQHANAIMP < HJOU_IJQHANAVEN"
"IVANAL";"S";"0049";"         ANOMALIE 174"
"IVANAL";"S";"0050";"      FINSI"
"IVANAL";"S";"0051";"      SI HJOU_IJQHANAIMP > HJOU_IJQHANAVEN"
"IVANAL";"S";"0052";"         ANOMALIE 175"
"IVANAL";"S";"0053";"      FINSI"
"IVANAL";"S";"0054";"   FINSI"
"IVANAL";"S";"0055";"FINSI"
"IVANAL";"S";"0056";"FIN"
"IVISITM";"S";"0001";"***********************************************************************"
"IVISITM";"S";"0002";"*"
"IVISITM";"S";"0003";"* Règle : IVISITM"
"IVISITM";"S";"0004";"* Ordre : 7100"
"IVISITM";"S";"0005";"* Titre : Visite médicale"
"IVISITM";"S";"0006";"*----------------------------------------------------------------------"
"IVISITM";"S";"0007";"*"
"IVISITM";"S";"0008";"* Créé par : Cellule Industrialisation"
"IVISITM";"S";"0009";"* Date     : 03/09/2009"
"IVISITM";"S";"0010";"* Version  : 1"
"IVISITM";"S";"0011";"*"
"IVISITM";"S";"0012";"*----------------------------------------------------------------------"
"IVISITM";"S";"0013";"*"
"IVISITM";"S";"0014";"*"
"IVISITM";"S";"0015";"* Rôle : Gestion visite médicale, visite médicale renforcée et visite de reprise"
"IVISITM";"S";"0016";"*"
"IVISITM";"S";"0017";"*"
"IVISITM";"S";"0018";"*----------------------------------------------------------------------"
"IVISITM";"S";"0019";"*"
"IVISITM";"S";"0020";"* Modifiée par : Méthodes et outils"
"IVISITM";"S";"0021";"* Date         : 06/08/2020"
"IVISITM";"S";"0022";"* Objet        : Ajout de l'alimentation de la date de la dernière visite"
"IVISITM";"S";"0023";"*                 médicale (EMPL_IEIDVISITE) lors de la pose du motif VMED"
"IVISITM";"S";"0024";"*                 + ajout indicateur visite médicale renforcée"
"IVISITM";"S";"0025";"*"
"IVISITM";"S";"0026";"***********************************************************************"
"IVISITM";"S";"0027";"*"
"IVISITM";"S";"0028";"* Implémentation des données industrielles"
"IVISITM";"S";"0029";"*"
"IVISITM";"S";"0030";"DEBDICO"
"IVISITM";"S";"0031";"   HJOU_IJRNBJRARR;N;N2;I;;;    56789;;IJRNBJRARR;V3;""Nombre de jours d'arrêt"";"
"IVISITM";"S";"0032";"   HJOU_IJRVISITER;N;N2;I;;;    56789;;IJRVISITER;V3;""Flag Visite médicale de reprise"";"
"IVISITM";"S";"0033";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"IVISITM";"S";"0034";"   PARD_IDIECHVISI;O;N2;I;;;123456789;;;C3;""Echéance visite médicale"";"
"IVISITM";"S";"0035";"   EMPL_IEIDVISITE;O;D10;X;;;123456789;;;C0;""Date de la dernière visite médicale"";"
"IVISITM";"S";"0036";"FINDICO"
"IVISITM";"S";"0037";"*"
"IVISITM";"S";"0038";"DEBANO"
"IVISITM";"S";"0039";"   176;8;""Visite médicale de reprise à planifier dans les 8 jours"";"
"IVISITM";"S";"0040";"   170;5;""Visite médicale à prévoir"";"
"IVISITM";"S";"0041";"FINANO"
"IVISITM";"S";"0042";"*"
"IVISITM";"S";"0043";"*"
"IVISITM";"S";"0044";"* Déclaration des donnees locales"
"IVISITM";"S";"0045";"*"
"IVISITM";"S";"0046";"DEF LOCA_ECH N2"
"IVISITM";"S";"0047";"LOCA_ECH = 0"
"IVISITM";"S";"0048";"DEF LOCA_DATEVISITE D"
"IVISITM";"S";"0049";"LOCA_DATEVISITE = "" """
"IVISITM";"S";"0050";"DEF LOCA_ARRET N1"
"IVISITM";"S";"0051";"LOCA_ARRET = 0"
"IVISITM";"S";"0052";"*"
"IVISITM";"S";"0053";"*---------------------------------------------------------------"
"IVISITM";"S";"0054";"*               VISITE MEDICALE A PREVOIR                      *"
"IVISITM";"S";"0055";"*---------------------------------------------------------------"
"IVISITM";"S";"0056";"* Le motif VMED alimente la date de la dernière visite médicale"
"IVISITM";"S";"0057";"* L'anomalie 170 se déclenche quelques jours avant la date de visite médicale"
"IVISITM";"S";"0058";"SI PARD_IDIECHVISI > 0"
"IVISITM";"S";"0059";"*"
"IVISITM";"S";"0060";"   SI HJOU_DATE > TEMP_DATJOU"
"IVISITM";"S";"0061";"      POUR ACTIVITES"
"IVISITM";"S";"0062";"         SI HABS_MOTIF = ""VMED"""
"IVISITM";"S";"0063";"            EMPL_IEIDVISITE = HJOU_DATE"
"IVISITM";"S";"0064";"         FINSI"
"IVISITM";"S";"0065";"      FINPOUR"
"IVISITM";"S";"0066";"   FINSI"
"IVISITM";"S";"0067";"*"
"IVISITM";"S";"0068";"   SI EMPL_IEIDVISITE <> "" """
"IVISITM";"S";"0069";"* Visite médicale renforcée"
"IVISITM";"S";"0070";"      SI EMPL_IEIFREQVMR > 0"
"IVISITM";"S";"0071";"** calcul de la date de la prochaine visite"
"IVISITM";"S";"0072";"         DATAJT EMPL_IEIDVISITE 12 ""M"" EMPL_IEIFREQVMR"
"IVISITM";"S";"0073";"         LOCA_DATEVISITE = TEMP_DXFINPER"
"IVISITM";"S";"0074";"      SINON"
"IVISITM";"S";"0075";"** calcul de la date de la prochaine visite"
"IVISITM";"S";"0076";"         DATAJT EMPL_IEIDVISITE 12 ""A"" 5"
"IVISITM";"S";"0077";"         LOCA_DATEVISITE = TEMP_DXFINPER"
"IVISITM";"S";"0078";"      FINSI"
"IVISITM";"S";"0079";"*"
"IVISITM";"S";"0080";"** calcul de la date d' échéance"
"IVISITM";"S";"0081";"      LOCA_ECH = PARD_IDIECHVISI * -1"
"IVISITM";"S";"0082";"      DATAJT LOCA_DATEVISITE 12 ""J"" LOCA_ECH"
"IVISITM";"S";"0083";"* mise en place de l'anomalie"
"IVISITM";"S";"0084";"      SI HJOU_DATE >= TEMP_DXFINPER"
"IVISITM";"S";"0085";"         SI HJOU_DATE < LOCA_DATEVISITE"
"IVISITM";"S";"0086";"            ANOMALIE 170"
"IVISITM";"S";"0087";"         FINSI"
"IVISITM";"S";"0088";"      FINSI"
"IVISITM";"S";"0089";"   FINSI"
"IVISITM";"S";"0090";"FINSI"
"IVISITM";"S";"0091";"*--------------------------------------------------------------"
"IVISITM";"S";"0092";"*      VISITE MÉDICALE DE REPRISE À PLANIFIER                 *"
"IVISITM";"S";"0093";"*--------------------------------------------------------------"
"IVISITM";"S";"0094";"* Le type d'arrêt dans ACT permet de déclencher une alerte de visite médicale"
"IVISITM";"S";"0095";"* à partir d'un seuil d'absence (en jour)"
"IVISITM";"S";"0096";"POUR ACTIVITES"
"IVISITM";"S";"0097";"    SI HABS_MOTYPE <> ""C"""
"IVISITM";"S";"0098";"        SI MOTI_VISITEREP = ""1"""
"IVISITM";"S";"0099";"            *"
"IVISITM";"S";"0100";"            * comptabilisation du nombre d'arrêt pour accident/maladie non professionnelle"
"IVISITM";"S";"0101";"            SI MOTI_TYPMAT = ""MA"""
"IVISITM";"S";"0102";"            OU MOTI_TYPMAT = ""01"""
"IVISITM";"S";"0103";"                SI MOTI_DUREEARRET > 0"
"IVISITM";"S";"0104";"                    HJOU_IJRNBJRARR = HJOU_IJRNBJRARR + 1"
"IVISITM";"S";"0105";"                    SI HJOU_IJRNBJRARR >= MOTI_DUREEARRET"
"IVISITM";"S";"0106";"                        HJOU_IJRVISITER = 1"
"IVISITM";"S";"0107";"                    FINSI"
"IVISITM";"S";"0108";"                    LOCA_ARRET = 1"
"IVISITM";"S";"0109";"                FINSI"
"IVISITM";"S";"0110";"            FINSI"
"IVISITM";"S";"0111";"            *"
"IVISITM";"S";"0112";"            * comptabilisation du nombre d'arrêt pour accident de travail"
"IVISITM";"S";"0113";"            SI MOTI_TYPMAT = ""AT"""
"IVISITM";"S";"0114";"            OU MOTI_TYPMAT = ""06"""
"IVISITM";"S";"0115";"                SI MOTI_DUREEARRET > 0"
"IVISITM";"S";"0116";"                    HJOU_IJRNBJRARR = HJOU_IJRNBJRARR + 1"
"IVISITM";"S";"0117";"                    SI HJOU_IJRNBJRARR >= MOTI_DUREEARRET"
"IVISITM";"S";"0118";"                        HJOU_IJRVISITER = 1"
"IVISITM";"S";"0119";"                    FINSI"
"IVISITM";"S";"0120";"                    LOCA_ARRET = 1"
"IVISITM";"S";"0121";"                FINSI"
"IVISITM";"S";"0122";"            FINSI"
"IVISITM";"S";"0123";"            * mise ne place du flag des le premier jour d'arrêt pour maladie professionnelle"
"IVISITM";"S";"0124";"            SI MOTI_TYPMAT = ""05"""
"IVISITM";"S";"0125";"                SI MOTI_DUREEARRET > 0"
"IVISITM";"S";"0126";"                    HJOU_IJRVISITER = 1"
"IVISITM";"S";"0127";"                    LOCA_ARRET = 1"
"IVISITM";"S";"0128";"                    HJOU_IJRNBJRARR = 1"
"IVISITM";"S";"0129";"                FINSI"
"IVISITM";"S";"0130";"            FINSI"
"IVISITM";"S";"0131";"        FINSI"
"IVISITM";"S";"0132";"    FINSI"
"IVISITM";"S";"0133";"FINPOUR"
"IVISITM";"S";"0134";"SI LOCA_ARRET = 0"
"IVISITM";"S";"0135";"   HJOU_IJRNBJRARR = 0"
"IVISITM";"S";"0136";"FINSI"
"IVISITM";"S";"0137";"*"
"IVISITM";"S";"0138";"* Mise en place de l'anomalie"
"IVISITM";"S";"0139";"SI HJOU_IJRVISITER = 1"
"IVISITM";"S";"0140";"* on teste la théorie considerant que le jour de la reprise est un jour où la theorie > 0"
"IVISITM";"S";"0141";"   SI HJOU_IJQPRETHEJ > 0"
"IVISITM";"S";"0142";"*  SI HJOU_IJRVISITER  = 1 et HJOU_IJRNBJRARR  = 0 cela signifie"
"IVISITM";"S";"0143";"* qu'on a atteint le plafond d'absence et qu'on a pas de motifs dont l'indicateur"
"IVISITM";"S";"0144";"* IMIVISITER > 0"
"IVISITM";"S";"0145";"      SI HJOU_IJRNBJRARR = 0"
"IVISITM";"S";"0146";"         ANOMALIE 176"
"IVISITM";"S";"0147";"         HJOU_IJRVISITER = 0"
"IVISITM";"S";"0148";"      FINSI"
