"IABSPL";"S";"0022";"*"
"IABSPL";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"IABSPL";"S";"0024";"* Date         : JJ/MM/AAAA"
"IABSPL";"S";"0025";"* Objet        :"
"IABSPL";"S";"0026";"*"
"IABSPL";"S";"0027";"***********************************************************************"
"IABSPL";"S";"0028";"*"
"IABSPL";"S";"0029";"* Implémentation des données industrielles"
"IABSPL";"S";"0030";"*"
"IABSPL";"S";"0031";"DEBDICO"
"IABSPL";"S";"0032";"   HJOU_IJQABSPLF1;N;T6,2;I;;;    56789;;;V2;""Absence 1ère plage"";"
"IABSPL";"S";"0033";"   HJOU_IJQNABSPFI;N;N2;I;;;     6789;;;V2;""Nombre de retards jour"";"
"IABSPL";"S";"0034";"   HJOU_IJQABSPLF2;N;T6,2;I;;;    56789;;;V2;""Absence 2ème plage"";"
"IABSPL";"S";"0035";"   HJOU_IJQABSPLFT;N;T6,2;I;;;    56789;;;V2;""Absence plages fixes jour"";"
"IABSPL";"S";"0036";"FINDICO"
"IABSPL";"S";"0037";"*"
"IABSPL";"S";"0038";"*"
"IABSPL";"S";"0039";"* Déclaration des donnees locales"
"IABSPL";"S";"0040";"*"
"IABSPL";"S";"0041";"DEF LOCA_RET T6.2"
"IABSPL";"S";"0042";"LOCA_RET = 0"
"IABSPL";"S";"0043";"*"
"IABSPL";"S";"0044";"* Absences premiere plage"
"IABSPL";"S";"0045";"*"
"IABSPL";"S";"0046";"SI HJOU_DATE <= TEMP_DATJOU"
"IABSPL";"S";"0047";"   SI PROF_IPIGABSPLF <> ""0"""
"IABSPL";"S";"0048";"      SI PROF_PTTHEO1 > 0"
"IABSPL";"S";"0049";"         ANALYSE PROF_PTTHEO1 PROF_PTTHEO2"
"IABSPL";"S";"0050";"         SI TEMP_HIPOIN > 0"
"IABSPL";"S";"0051";"            SI PROF_IPIGABSPLF = ""1"""
"IABSPL";"S";"0052";"               SI TEMP_HIABS > PROF_IPISABSPLF"
"IABSPL";"S";"0053";"                  HJOU_IJQABSPLF1 = TEMP_HIABS"
"IABSPL";"S";"0054";"               FINSI"
"IABSPL";"S";"0055";"            FINSI"
"IABSPL";"S";"0056";"            SI PROF_IPIGABSPLF = ""2"""
"IABSPL";"S";"0057";"               SI TEMP_HIPOIN > 0"
"IABSPL";"S";"0058";"                  SI TEMP_HISENS = 0"
"IABSPL";"S";"0059";"                     LOCA_RET = TEMP_HIPTPR - PROF_PTTHEO1"
"IABSPL";"S";"0060";"                     SI LOCA_RET > PROF_IPISABSPLF"
"IABSPL";"S";"0061";"                        HJOU_IJQABSPLF1 = LOCA_RET"
"IABSPL";"S";"0062";"                        HJOU_IJQNABSPFI = HJOU_IJQNABSPFI + 1"
"IABSPL";"S";"0063";"                     FINSI"
"IABSPL";"S";"0064";"                  FINSI"
"IABSPL";"S";"0065";"               FINSI"
"IABSPL";"S";"0066";"            FINSI"
"IABSPL";"S";"0067";"         FINSI"
"IABSPL";"S";"0068";"      FINSI"
"IABSPL";"S";"0069";"*"
"IABSPL";"S";"0070";"* Absence seconde plage"
"IABSPL";"S";"0071";"*"
"IABSPL";"S";"0072";"      SI PROF_PTTHEO3 > 0"
"IABSPL";"S";"0073";"         ANALYSE PROF_PTTHEO3 PROF_PTTHEO4"
"IABSPL";"S";"0074";"         SI TEMP_HIPOIN > 0"
"IABSPL";"S";"0075";"            SI PROF_IPIGABSPLF = ""1"""
"IABSPL";"S";"0076";"               SI TEMP_HIABS > PROF_IPISABSPLF"
"IABSPL";"S";"0077";"                  HJOU_IJQABSPLF2 = HJOU_IJQABSPLF2 + TEMP_HIABS"
"IABSPL";"S";"0078";"               FINSI"
"IABSPL";"S";"0079";"            FINSI"
"IABSPL";"S";"0080";"            SI PROF_IPIGABSPLF = ""2"""
"IABSPL";"S";"0081";"               SI TEMP_HIPOIN > 0"
"IABSPL";"S";"0082";"                  SI TEMP_HISENS = 0"
"IABSPL";"S";"0083";"                     LOCA_RET = TEMP_HIPTPR - PROF_PTTHEO3"
"IABSPL";"S";"0084";"                     SI LOCA_RET > PROF_IPISABSPLF"
"IABSPL";"S";"0085";"                        HJOU_IJQABSPLF2 = HJOU_IJQABSPLF2 + LOCA_RET"
"IABSPL";"S";"0086";"                        HJOU_IJQNABSPFI = HJOU_IJQNABSPFI + 1"
"IABSPL";"S";"0087";"                     FINSI"
"IABSPL";"S";"0088";"                  FINSI"
"IABSPL";"S";"0089";"               FINSI"
"IABSPL";"S";"0090";"            FINSI"
"IABSPL";"S";"0091";"         FINSI"
"IABSPL";"S";"0092";"      FINSI"
"IABSPL";"S";"0093";"   FINSI"
"IABSPL";"S";"0094";"** totalisation"
"IABSPL";"S";"0095";"   HJOU_IJQABSPLFT = HJOU_IJQABSPLF1 + HJOU_IJQABSPLF2"
"IABSPL";"S";"0096";"FINSI"
"IABSPL";"S";"0097";"FIN"
"IACPANMETA";"S";"0001";"***********************************************************************"
"IACPANMETA";"S";"0002";"*"
"IACPANMETA";"S";"0003";"* Règle : IACPANMETA"
"IACPANMETA";"S";"0004";"* Ordre : 3585"
"IACPANMETA";"S";"0005";"* Titre : CCN Métallurgie : Gestion de l'acquisition des congés payés"
"IACPANMETA";"S";"0006";"*         d'ancienneté à date de réf des CP"
"IACPANMETA";"S";"0007";"* DATE     : 29/03/2023"
"IACPANMETA";"S";"0008";"* Version  : 1"
"IACPANMETA";"S";"0009";"*"
"IACPANMETA";"S";"0010";"*----------------------------------------------------------------------"
"IACPANMETA";"S";"0011";"*"
"IACPANMETA";"S";"0012";"*"
"IACPANMETA";"S";"0013";"* Rôle : CCN métallurgie Gestion acquisition des CP d'ancienneté SITE UNIQUE"
"IACPANMETA";"S";"0014";"*                   et même date de référence que les CP"
"IACPANMETA";"S";"0015";"*"
"IACPANMETA";"S";"0016";"*        Gestion des deux régimes d'acquisition pendant la période transitoire"
"IACPANMETA";"S";"0017";"*       (calcul du droit plus favorable chaque année)"
"IACPANMETA";"S";"0018";"*        Proratisation de l'acquisition des droits d'ancienneté au jour du départ"
"IACPANMETA";"S";"0019";"*"
"IACPANMETA";"S";"0020";"*"
"IACPANMETA";"S";"0021";"*"
"IACPANMETA";"S";"0022";"*----------------------------------------------------------------------"
"IACPANMETA";"S";"0023";"*"
"IACPANMETA";"S";"0024";"* Modifiée par :"
"IACPANMETA";"S";"0025";"* Date         : JJ/MM/AAAA"
"IACPANMETA";"S";"0026";"* Objet        :"
"IACPANMETA";"S";"0027";"*"
"IACPANMETA";"S";"0028";"*"
"IACPANMETA";"S";"0029";"***********************************************************************"
"IACPANMETA";"S";"0030";"** Implémentation des données industrielles"
"IACPANMETA";"S";"0031";"DEBDICO"
"IACPANMETA";"S";"0032";"   HJOU_IJRDCOANCI;N;N5,1;I;;;    56789;;IJRDCOANCI;V3;""Droit congé ancienneté"";"
"IACPANMETA";"S";"0033";"   HJOU_IJRCCOANCI;N;N5,1;I;;;    56789;;IJRCCOANCI;V3;""Congé ancienneté pris"";"
"IACPANMETA";"S";"0034";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"IACPANMETA";"S";"0035";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"IACPANMETA";"S";"0036";"   EMPL_IEIDCPAN;O;N2;I;;;123456789;;;C0;""Droit CPAN acquis"";"
"IACPANMETA";"S";"0037";"   *********"
"IACPANMETA";"S";"0038";"   HJOU_IJIREGCPAN;O;Z1;X;;;123456789;L;;C2;""Régime des congés d'ancienneté"";"
"IACPANMETA";"S";"0039";"   PARD_IDIDDEBCCN;O;D10;X;;;123456789;;;C3;""Début nouvelle CCN métallurgie"";"
"IACPANMETA";"S";"0040";"   PARD_IDISANNC1;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 1 ""RÉGIME 2"""";"
"IACPANMETA";"S";"0041";"   PARD_IDISANNC2;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 2 ""RÉGIME 2"""";"
"IACPANMETA";"S";"0042";"   PARD_IDISANNC3;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 3 ""RÉGIME 2"""";"
"IACPANMETA";"S";"0043";"   PARD_IDIDCANNC1;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 1 ""RÉGIME 2"""";"
"IACPANMETA";"S";"0044";"   PARD_IDIDCANNC2;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 2 ""RÉGIME 2"""";"
"IACPANMETA";"S";"0045";"   PARD_IDIDCANNC3;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 3 ""RÉGIME 2"""";"
"IACPANMETA";"S";"0046";"FINDICO"
"IACPANMETA";"S";"0047";"*"
"IACPANMETA";"S";"0048";"DEBANO"
"IACPANMETA";"S";"0049";"   168;8;""Solde congés ancienneté insuffisant"";"
"IACPANMETA";"S";"0050";"FINANO"
"IACPANMETA";"S";"0051";"*"
"IACPANMETA";"S";"0052";"* Déclaration des donnees locales"
"IACPANMETA";"S";"0053";"* Variables utilisées pour calculer la date de reference"
"IACPANMETA";"S";"0054";"DEF LOCA_DATE D"
"IACPANMETA";"S";"0055";"DEF LOCA_REF N2"
"IACPANMETA";"S";"0056";"* Variables utilisées pour le calcul de l'ancienneté"
"IACPANMETA";"S";"0057";"DEF LOCA_ANCIEN N6.1"
"IACPANMETA";"S";"0058";"LOCA_ANCIEN = 0"
"IACPANMETA";"S";"0059";"DEF LOCA_TRANS N6.1"
"IACPANMETA";"S";"0060";"LOCA_TRANS = 0"
"IACPANMETA";"S";"0061";"DEF LOCA_DROIT N6.1"
"IACPANMETA";"S";"0062";"LOCA_DROIT = 0"
"IACPANMETA";"S";"0063";"DEF LOCA_CA N1"
"IACPANMETA";"S";"0064";"LOCA_CA = 0"
"IACPANMETA";"S";"0065";"DEF LOCA_CPAN N5.1"
"IACPANMETA";"S";"0066";"LOCA_CPAN = 0"
"IACPANMETA";"S";"0067";"*Variable pour calcul de l'âge"
"IACPANMETA";"S";"0068";"DEF LOCA_AGE N2"
"IACPANMETA";"S";"0069";"LOCA_AGE = 0"
"IACPANMETA";"S";"0070";"*** Variables pour la fin de contrat"
"IACPANMETA";"S";"0071";"DEF LOCA_FINPERI D"
"IACPANMETA";"S";"0072";"DEF LOCA_NBMOIS N2"
"IACPANMETA";"S";"0073";"LOCA_NBMOIS = 0"
"IACPANMETA";"S";"0074";"DEF LOCA_NCPAN N5.1"
"IACPANMETA";"S";"0075";"LOCA_NCPAN = 0"
"IACPANMETA";"S";"0076";"DEF LOCA_ENTIER N2"
"IACPANMETA";"S";"0077";"LOCA_ENTIER = 0"
"IACPANMETA";"S";"0078";"DEF LOCA_RESTE N7.4"
"IACPANMETA";"S";"0079";"LOCA_RESTE = 0"
"IACPANMETA";"S";"0080";"*"
"IACPANMETA";"S";"0081";"* Pour les salariés ayant des droits à CPAN"
"IACPANMETA";"S";"0082";"* On stocke les droits congés d'ancienneté le 31/05/2023, veille"
"IACPANMETA";"S";"0083";"* de l'attribution des CPAN de la nouvelle CCN Métallurgie"
"IACPANMETA";"S";"0084";"SI HJOU_DATE = ""31/05/2024"""
"IACPANMETA";"S";"0085";"*************"
"IACPANMETA";"S";"0086";"   SI HJOU_IJRDCOANCI > 0"
"IACPANMETA";"S";"0087";"      EMPL_IEIDCPAN = HJOU_IJRDCOANCI"
"IACPANMETA";"S";"0088";"   FINSI"
"IACPANMETA";"S";"0089";"FINSI"
"IACPANMETA";"S";"0090";"* la règle s'applique à partir de la date de début paramétrée dans CFG"
"IACPANMETA";"S";"0091";"SI HJOU_DATE >= PARD_IDIDDEBCCN"
"IACPANMETA";"S";"0092";"*"
"IACPANMETA";"S";"0093";"   SI CONF_ITIVMREFCP <> "" """
"IACPANMETA";"S";"0094";"* Calcul de la date de référence CP"
"IACPANMETA";"S";"0095";"* stockage de l'année du jour de l'historique"
"IACPANMETA";"S";"0096";"      LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IACPANMETA";"S";"0097";"* stockage du mois de reference"
"IACPANMETA";"S";"0098";"      LOCA_REF << CONF_ITIVMREFCP(3:2)"
"IACPANMETA";"S";"0099";"* stokage du mois de reference"
"IACPANMETA";"S";"0100";"      LOCA_DATE(5:2) << LOCA_REF"
"IACPANMETA";"S";"0101";"* stockage du jour de reference"
"IACPANMETA";"S";"0102";"      LOCA_REF << CONF_ITIVMREFCP(1:2)"
"IACPANMETA";"S";"0103";"* loca_date contient maintenant l'année du jour de l'historique"
"IACPANMETA";"S";"0104";"* et le mois et le jour de reference"
"IACPANMETA";"S";"0105";"      LOCA_DATE(7:2) << LOCA_REF"
"IACPANMETA";"S";"0106";"   SINON"
"IACPANMETA";"S";"0107";"      LOCA_DATE = "" """
"IACPANMETA";"S";"0108";"   FINSI"
"IACPANMETA";"S";"0109";"*"
"IACPANMETA";"S";"0110";"*"
"IACPANMETA";"S";"0111";"* GESTION DE L'ACQUISITION DES CONGES D'ANCIENNETE"
"IACPANMETA";"S";"0112";"*"
"IACPANMETA";"S";"0113";"* Date de référence des congés d'ancienneté"
"IACPANMETA";"S";"0114";"   SI HJOU_DATE = LOCA_DATE"
"IACPANMETA";"S";"0115";"*"
"IACPANMETA";"S";"0116";"* Calcul de l'ancienneté"
"IACPANMETA";"S";"0117";"      DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"IACPANMETA";"S";"0118";"      LOCA_ANCIEN = TEMP_NXANNEE"
"IACPANMETA";"S";"0119";"* Si la date de naissance est renseignée"
"IACPANMETA";"S";"0120";"      SI EMPS_E2DATENAI <> "" """
"IACPANMETA";"S";"0121";"         DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"IACPANMETA";"S";"0122";"         LOCA_AGE = TEMP_NXANNEE"
"IACPANMETA";"S";"0123";"      FINSI"
"IACPANMETA";"S";"0124";"*******************************************"
"IACPANMETA";"S";"0125";"*"
"IACPANMETA";"S";"0126";"* Si ""régime 3"": CCN Métallurgie"
"IACPANMETA";"S";"0127";"      SI HJOU_IJIREGCPAN = ""3"""
"IACPANMETA";"S";"0128";"*"
"IACPANMETA";"S";"0129";"* Les droits CPAN acquis sont alimentés directement"
"IACPANMETA";"S";"0130";"* pour les salariés de plus de 10 ans d'ancienneté"
"IACPANMETA";"S";"0131";"* et pour les cadres ayant des droits CPAN"
"IACPANMETA";"S";"0132";"         SI EMPL_IEIDCPAN > 1"
"IACPANMETA";"S";"0133";"            HJOU_IJRDCOANCI = EMPL_IEIDCPAN"
"IACPANMETA";"S";"0134";"* sinon"
"IACPANMETA";"S";"0135";"         SINON"
"IACPANMETA";"S";"0136";"            FAIRE ACQUIS"
"IACPANMETA";"S";"0137";"         FINSI"
"IACPANMETA";"S";"0138";"* sinon"
"IACPANMETA";"S";"0139";"* si le salarié  a plus de 55 ans et 20 ans d'ancienneté"
"IACPANMETA";"S";"0140";"* et que EMPL_IEIDCPAN < PARD_IDIDCANNC3"
"IACPANMETA";"S";"0141";"*"
"IACPANMETA";"S";"0142";"         SI LOCA_ANCIEN >= PARD_IDISANNC3"
"IACPANMETA";"S";"0143";"            SI LOCA_AGE >= 55"
"IACPANMETA";"S";"0144";"               SI EMPL_IEIDCPAN < PARD_IDIDCANNC3"
"IACPANMETA";"S";"0145";"                  HJOU_IJRDCOANCI = PARD_IDIDCANNC3"
"IACPANMETA";"S";"0146";"               FINSI"
"IACPANMETA";"S";"0147";"* si le salarié est cadre :"
"IACPANMETA";"S";"0148";"               SI HJOU_IJICATEGOR <> ""04"""
"IACPANMETA";"S";"0149";"               OU HJOU_IJICATEGOR = "" """
"IACPANMETA";"S";"0150";"                  HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + PARD_IDIDCANNC1"
"IACPANMETA";"S";"0151";"               FINSI"
"IACPANMETA";"S";"0152";"            FINSI"
"IACPANMETA";"S";"0153";"         FINSI"
"IACPANMETA";"S";"0154";"* Remise à zéro du pris"
"IACPANMETA";"S";"0155";"         HJOU_IJRCCOANCI = 0"
"IACPANMETA";"S";"0156";"         HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"IACPANMETA";"S";"0157";"      FINSI"
"IACPANMETA";"S";"0158";"   FINSI"
"IACPANMETA";"S";"0159";"FINSI"
"IACPANMETA";"S";"0160";"**********"
"IACPANMETA";"S";"0161";"****Si le contrat prend fin avant l'acquisition de nouveaux CPAN, on proratise l'acquis"
"IACPANMETA";"S";"0162";"* Si ""régime 3"": CCN Métallurgie"
"IACPANMETA";"S";"0163";"SI HJOU_IJIREGCPAN = ""3"""
"IACPANMETA";"S";"0164";"   SI HJOU_DATE = CTRA_DATFIN"
"IACPANMETA";"S";"0165";"      SI CTRA_DATFIN > LOCA_DATE"
"IACPANMETA";"S";"0166";"         LOCA_FINPERI = CTRA_DATFIN"
"IACPANMETA";"S";"0167";"***1° on calcule la durée entre la date de réf et la date de fin de contrat"
"IACPANMETA";"S";"0168";"* en nombre de mois"
"IACPANMETA";"S";"0169";"         DATAJT LOCA_FINPERI 12.00 ""M"" 1"
"IACPANMETA";"S";"0275";"   SINON"
"IACPANMETA";"S";"0170";"         LOCA_FINPERI(1:6) = TEMP_DXFINPER(1:6)"
"IACPANMETA";"S";"0171";"* on se positionne au 1er du mois suivant"
"IACPANMETA";"S";"0172";"         LOCA_FINPERI(7:2) = ""01"""
"IACPANMETA";"S";"0173";"         DATDIFF LOCA_DATE 12 LOCA_FINPERI 12"
"IACPANMETA";"S";"0174";"         LOCA_NBMOIS = TEMP_NXMOIS"
"IACPANMETA";"S";"0175";"***2° on proratise le droit"
"IACPANMETA";"S";"0176";"* On se réfère à EMPL"
"IACPANMETA";"S";"0177";"         SI EMPL_IEIDCPAN <> 0"
"IACPANMETA";"S";"0178";"            LOCA_NCPAN = EMPL_IEIDCPAN * LOCA_NBMOIS"
"IACPANMETA";"S";"0179";"            LOCA_NCPAN = LOCA_NCPAN / 12"
"IACPANMETA";"S";"0180";"*"
"IACPANMETA";"S";"0181";"*** mise en commentaire de l'arrondi : la nouvelle CCN métallurgie"
"IACPANMETA";"S";"0182";"* arrondi le congé après le calcul du CP au moment du départ du salarié"
"IACPANMETA";"S";"0183";"* (l'arrondi est reporté dans une règle de solde CP au moment du départ)"
"IACPANMETA";"S";"0184";"*** on arrondit au 0,5 supérieur"
"IACPANMETA";"S";"0185";"*            FAIRE ARRONDI"
"IACPANMETA";"S";"0186";"*"
"IACPANMETA";"S";"0187";"         SINON"
"IACPANMETA";"S";"0188";"* si le droit est alimenté dans JOU"
"IACPANMETA";"S";"0189";"            SI HJOU_IJRDCOANCI <> 0"
"IACPANMETA";"S";"0190";"               LOCA_NCPAN = HJOU_IJRDCOANCI * LOCA_NBMOIS"
"IACPANMETA";"S";"0191";"               LOCA_NCPAN = LOCA_NCPAN / 12"
"IACPANMETA";"S";"0192";"*** on arrondit au 0,5 supérieur"
"IACPANMETA";"S";"0193";"*               FAIRE ARRONDI"
"IACPANMETA";"S";"0194";"** on alimente le droit"
"IACPANMETA";"S";"0195";"               HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + LOCA_NCPAN"
"IACPANMETA";"S";"0196";"*            FINSI"
"IACPANMETA";"S";"0197";"*****"
"IACPANMETA";"S";"0198";"* Recalcul du solde"
"IACPANMETA";"S";"0199";"               HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"IACPANMETA";"S";"0200";"            FINSI"
"IACPANMETA";"S";"0201";"         FINSI"
"IACPANMETA";"S";"0202";"      FINSI"
"IACPANMETA";"S";"0203";"   FINSI"
"IACPANMETA";"S";"0204";"FINSI"
"IACPANMETA";"S";"0205";"*FINSI"
"IACPANMETA";"S";"0206";"**********"
"IACPANMETA";"S";"0207";"* GESTION CONSIGNES D'INIT. ET MAJ"
"IACPANMETA";"S";"0208";"POUR ACTIVITES"
"IACPANMETA";"S";"0209";"* consignes de MAJ du droit congés d'ancienneté"
"IACPANMETA";"S";"0210";"   SI HABS_MOTIF = ""XDCA"""
"IACPANMETA";"S";"0211";"      LOCA_CA = 1"
"IACPANMETA";"S";"0212";"      LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCOANCI"
"IACPANMETA";"S";"0213";"      LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCOANCI"
"IACPANMETA";"S";"0214";"*"
"IACPANMETA";"S";"0215";"      HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + HABS_MOTINBR"
"IACPANMETA";"S";"0216";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACPANMETA";"S";"0217";"   FINSI"
"IACPANMETA";"S";"0218";"* Droit congé d'ancienneté"
"IACPANMETA";"S";"0219";"   SI HABS_MOTIF = ""ZDCA"""
"IACPANMETA";"S";"0220";"      LOCA_CA = 1"
"IACPANMETA";"S";"0221";"      LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCOANCI"
"IACPANMETA";"S";"0222";"*"
"IACPANMETA";"S";"0223";"      HJOU_IJRDCOANCI = HABS_MOTINBR"
"IACPANMETA";"S";"0224";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACPANMETA";"S";"0225";"   FINSI"
"IACPANMETA";"S";"0226";"FINPOUR"
"IACPANMETA";"S";"0227";"*"
"IACPANMETA";"S";"0228";"SI LOCA_CA = 1"
"IACPANMETA";"S";"0229";"   SI HJOU_IJRSCOANCI < 0"
"IACPANMETA";"S";"0230";"      ANOMALIE 168"
"IACPANMETA";"S";"0231";"   FINSI"
"IACPANMETA";"S";"0232";"FINSI"
"IACPANMETA";"S";"0233";"*"
"IACPANMETA";"S";"0234";"FIN"
"IACPANMETA";"S";"0235";"*"
"IACPANMETA";"S";"0236";"PROC ACQUIS"
"IACPANMETA";"S";"0237";"* Acquisition selon les seuils"
"IACPANMETA";"S";"0238";"* si le salarié a moins de 45 ans"
"IACPANMETA";"S";"0239";"* on commence au seuil 2"
"IACPANMETA";"S";"0240";"   SI LOCA_ANCIEN >= PARD_IDISANNC2"
"IACPANMETA";"S";"0241";"      SI LOCA_ANCIEN < PARD_IDISANNC3"
"IACPANMETA";"S";"0242";"      OU PARD_IDISANNC3 = 0"
"IACPANMETA";"S";"0243";"         SI LOCA_AGE <= 45"
"IACPANMETA";"S";"0244";"            HJOU_IJRDCOANCI = PARD_IDIDCANNC2"
"IACPANMETA";"S";"0245";"         SINON"
"IACPANMETA";"S";"0246";"* s'il a plus de 45 ans"
"IACPANMETA";"S";"0247";"            HJOU_IJRDCOANCI = PARD_IDIDCANNC2 + 1"
"IACPANMETA";"S";"0248";"         FINSI"
"IACPANMETA";"S";"0249";"      FINSI"
"IACPANMETA";"S";"0250";"   SINON"
"IACPANMETA";"S";"0251";"* sinon"
"IACPANMETA";"S";"0252";"* s'il a plus de 55 ans et 20 ans d'ancienneté"
"IACPANMETA";"S";"0253";"      SI LOCA_ANCIEN >= PARD_IDISANNC3"
"IACPANMETA";"S";"0254";"         SI LOCA_AGE >= 55"
"IACPANMETA";"S";"0255";"            HJOU_IJRDCOANCI = PARD_IDIDCANNC3 + 1"
"IACPANMETA";"S";"0256";"         FINSI"
"IACPANMETA";"S";"0257";"      FINSI"
"IACPANMETA";"S";"0258";"   FINSI"
"IACPANMETA";"S";"0259";"* Si le salarié est cadre, on ajoute le seuil 1 à chaque droit acquis"
"IACPANMETA";"S";"0260";"   SI HJOU_IJICATEGOR <> ""04"""
"IACPANMETA";"S";"0261";"   OU HJOU_IJICATEGOR = "" """
"IACPANMETA";"S";"0262";"      SI LOCA_ANCIEN >= PARD_IDISANNC1"
"IACPANMETA";"S";"0263";"         HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + PARD_IDIDCANNC1"
"IACPANMETA";"S";"0264";"      FINSI"
"IACPANMETA";"S";"0265";"   FINSI"
"IACPANMETA";"S";"0266";"FINPROC"
"IACPANMETA";"S";"0267";"*"
"IACPANMETA";"S";"0268";"*"
"IACPANMETA";"S";"0269";"PROC ARRONDI"
"IACPANMETA";"S";"0270";"* on arrondit au 0,5 le prorata de CPAN calculé"
"IACPANMETA";"S";"0271";"   LOCA_ENTIER = LOCA_NCPAN"
"IACPANMETA";"S";"0272";"   LOCA_RESTE = LOCA_NCPAN - LOCA_ENTIER"
"IACPANMETA";"S";"0273";"   SI LOCA_RESTE > 0.5"
"IACPANMETA";"S";"0274";"      LOCA_NCPAN = LOCA_ENTIER + 1"
"IACPANMETA";"S";"0276";"      SI LOCA_RESTE = 0,5"
"IACPANMETA";"S";"0277";"         LOCA_NCPAN = LOCA_ENTIER + 0,5"
"IACPANMETA";"S";"0278";"      SINON"
"IACPANMETA";"S";"0279";"         SI LOCA_RESTE > 0"
"IACPANMETA";"S";"0280";"            LOCA_NCPAN = LOCA_ENTIER + 0,5"
"IACPANMETA";"S";"0281";"         FINSI"
"IACPANMETA";"S";"0282";"      FINSI"
"IACPANMETA";"S";"0283";"   FINSI"
"IACPANMETA";"S";"0284";"   LOCA_ENTIER = 0"
"IACPANMETA";"S";"0285";"   LOCA_RESTE = 0"
"IACPANMETA";"S";"0286";"FINPROC"
"IACQCP";"S";"0001";"***********************************************************************"
"IACQCP";"S";"0002";"*"
"IACQCP";"S";"0003";"* Règle : IACQCP"
"IACQCP";"S";"0004";"* Ordre : 3570"
"IACQCP";"S";"0005";"* Titre : Gestion de l'acquisition des congés payés"
"IACQCP";"S";"0006";"*"
