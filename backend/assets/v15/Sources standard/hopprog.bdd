"IMISSD";"S";"0030";"* Modifiée par : Méthodes et outils"
"IMISSD";"S";"0031";"* Date         : 28/08/2018"
"IMISSD";"S";"0032";"* Objet        : passage à 10 caractères des champs contenant des motifs BT43982"
"IMISSD";"S";"0033";"***********************************************************************"
"IMISSD";"S";"0034";"*"
"IMISSD";"S";"0035";"* Implémentation des données industrielles"
"IMISSD";"S";"0036";"*"
"IMISSD";"S";"0037";"DEBDICO"
"IMISSD";"S";"0038";"   HJOU_IJRF3PBHSL;N;Z1;X;0;9;    56789;;IJRF3PBHSL;V3;""Flag prés. b.h.s. du lendemain (N3)"";"
"IMISSD";"S";"0039";"   HJOU_IJQPAUMERI;N;T6,2;I;;;     6789;;;V3;""Pause déjeuner"";"
"IMISSD";"S";"0040";"   HJOU_IJQECPAUSM;N;T6,2;I;;;     6789;;;V3;""Ecart pause déjeuner"";"
"IMISSD";"S";"0041";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"IMISSD";"S";"0042";"   HJOU_IJQPRESBAV;N;T6,2;I;;;    56789;;;V3;""Présence badgée validée"";"
"IMISSD";"S";"0043";"   HJOU_IJQHMISSLE;N;T6,2;I;;;    56789;;;V3;""Durée mission du lendemain"";"
"IMISSD";"S";"0044";"   HJOU_IJQNABSENT;N;N2;I;;;    56789;;;V3;""Nombre d absences totales"";"
"IMISSD";"S";"0045";"   HJOU_IJQNACTIVJ;N;N2;I;;;    56789;;;V3;""Nombre d activités"";"
"IMISSD";"S";"0046";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"IMISSD";"S";"0047";"FINDICO"
"IMISSD";"S";"0048";"* Déclaration des donnees locales"
"IMISSD";"S";"0049";"*"
"IMISSD";"S";"0050";"DEF LOCA_MOTJOUR N1"
"IMISSD";"S";"0051";"LOCA_MOTJOUR = 0"
"IMISSD";"S";"0052";"DEF LOCA_TOTMISS T6.2"
"IMISSD";"S";"0053";"LOCA_TOTMISS = 0"
"IMISSD";"S";"0054";"DEF LOCA_ABS N1"
"IMISSD";"S";"0055";"LOCA_ABS = 0"
"IMISSD";"S";"0056";"DEF LOCA_MISSBAD A10"
"IMISSD";"S";"0057";"LOCA_MISSBAD = "" """
"IMISSD";"S";"0058";"DEF LOCA_MISSBADL A10"
"IMISSD";"S";"0059";"LOCA_MISSBADL = "" """
"IMISSD";"S";"0060";"DEF LOCA_ACTM N1"
"IMISSD";"S";"0061";"LOCA_ACTM = 0"
"IMISSD";"S";"0062";"*"
"IMISSD";"S";"0063";"* Suppression des motifs missions"
"IMISSD";"S";"0064";"*"
"IMISSD";"S";"0065";"SI PARD_IDIVMOMIBL = "" """
"IMISSD";"S";"0066";"   LOCA_MISSBADL = ""MISS"""
"IMISSD";"S";"0067";"SINON"
"IMISSD";"S";"0068";"   LOCA_MISSBADL = PARD_IDIVMOMIBL"
"IMISSD";"S";"0069";"FINSI"
"IMISSD";"S";"0070";"SI PARD_IDIVMOMISB = "" """
"IMISSD";"S";"0071";"   LOCA_MISSBAD = ""MISS"""
"IMISSD";"S";"0072";"SINON"
"IMISSD";"S";"0073";"   LOCA_MISSBAD = PARD_IDIVMOMISB"
"IMISSD";"S";"0074";"FINSI"
"IMISSD";"S";"0075";"ENLEVER LOCA_MISSBAD"
"IMISSD";"S";"0076";"ENLEVER LOCA_MISSBADL"
"IMISSD";"S";"0077";"*"
"IMISSD";"S";"0078";"* recuperation du temps mission entre le"
"IMISSD";"S";"0079";"* mouvement d'entree et la borne debut mission sur depart la veille"
"IMISSD";"S";"0080";"*"
"IMISSD";"S";"0081";"SI HJOU_IJRF3PBHSL = ""1"""
"IMISSD";"S";"0082";"   LOCA_TOTMISS = HJOU_IJQMISBADV"
"IMISSD";"S";"0083";"FINSI"
"IMISSD";"S";"0084";"SI HJOU_DATE <= TEMP_DATJOU"
"IMISSD";"S";"0085";"* si le compteur HJECREPL > 0 cela indique"
"IMISSD";"S";"0086";"* que le premier mouvement de la journée"
"IMISSD";"S";"0087";"* est une entree dans la plage DJ"
"IMISSD";"S";"0088";"* et qu'il n'y a pas d'autres mvts dans la plage DJ"
"IMISSD";"S";"0089";"* si HJMISSR = 1 cela veut dire que c'est un retour"
"IMISSD";"S";"0090";"* mission sur un depart fait la veille et dans ce cas"
"IMISSD";"S";"0091";"* l'ecart pause repas doit être alimenté avaec la valeur de"
"IMISSD";"S";"0092";"* la coupure minimum"
"IMISSD";"S";"0093";"   SI HJOU_IJRF3PBHSL = ""1"""
"IMISSD";"S";"0094";"      SI HJOU_IJQECPAUML > 0"
"IMISSD";"S";"0095";"* test si pas d'absence matin"
"IMISSD";"S";"0096";"         POUR ACTIVITES"
"IMISSD";"S";"0097";"            SI HABS_VALORIS = ""M"""
"IMISSD";"S";"0098";"               LOCA_ACTM = 1"
"IMISSD";"S";"0099";"            FINSI"
"IMISSD";"S";"0100";"         FINPOUR"
"IMISSD";"S";"0101";"         SI LOCA_ACTM = 0"
"IMISSD";"S";"0102";"            HJOU_IJQPAUMERI = 0"
"IMISSD";"S";"0103";"            HJOU_IJQECPAUSM = HJOU_IJQECPAUML"
"IMISSD";"S";"0104";"            HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQECPAUSM"
"IMISSD";"S";"0105";"            HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQECPAUSM"
"IMISSD";"S";"0106";"            ANOMALIE 114"
"IMISSD";"S";"0107";"         FINSI"
"IMISSD";"S";"0108";"      FINSI"
"IMISSD";"S";"0109";"   FINSI"
"IMISSD";"S";"0110";"** alimentation de la donnée reportable HJMISSR"
"IMISSD";"S";"0111";"** avec la valeur de la donnée HJMISS"
"IMISSD";"S";"0112";"** on test avant si hjnpoin > 0 pour recuperer la"
"IMISSD";"S";"0113";"** valeur de HJMISS car il ne faut pas stocker la"
"IMISSD";"S";"0114";"** valeur de HJMISS sur le jour ou on a pas de badgeage"
"IMISSD";"S";"0115";"** car même si la veille elle etait initialisée à 1"
"IMISSD";"S";"0116";"** le lendemain, comme la valeur du report n'est pas alimentée, on"
"IMISSD";"S";"0117";"** stockerai 0 dans HJMISSR"
"IMISSD";"S";"0118";"   SI HJOU_IJQNBADGEA > 0"
"IMISSD";"S";"0119";"      HJOU_IJRF3PBHSL = HJOU_IJRF2PBHSL"
"IMISSD";"S";"0120";"   FINSI"
"IMISSD";"S";"0121";"** calcul de la durée mission avec la duree théorique"
"IMISSD";"S";"0122";"** si pas de badgeages"
"IMISSD";"S";"0123";"   SI HJOU_INMISS = ""3"""
"IMISSD";"S";"0124";"      SI HJOU_IJRF3PBHSL = ""1"""
"IMISSD";"S";"0125";"         SI HJOU_IJQNBADGEA = 0"
"IMISSD";"S";"0126";"            LOCA_TOTMISS = HJOU_IJQPRETHEJ"
"IMISSD";"S";"0127";"            LOCA_ABS = 1"
"IMISSD";"S";"0128";"         FINSI"
"IMISSD";"S";"0129";"      FINSI"
"IMISSD";"S";"0130";"   FINSI"
"IMISSD";"S";"0131";"*  test si un motif est present"
"IMISSD";"S";"0132";"   POUR ACTIVITES"
"IMISSD";"S";"0133";"      SI HABS_MOTYPE <> ""C"""
"IMISSD";"S";"0134";"         SI HJOU_IJQNBADGEA = 0"
"IMISSD";"S";"0135";"            HJOU_IJRF3PBHSL = ""0"""
"IMISSD";"S";"0136";"            LOCA_MOTJOUR = 1"
"IMISSD";"S";"0137";"         FINSI"
"IMISSD";"S";"0138";"      FINSI"
"IMISSD";"S";"0139";"   FINPOUR"
"IMISSD";"S";"0140";"*  mise en place du motif"
"IMISSD";"S";"0141";"   SI LOCA_TOTMISS <> 0"
"IMISSD";"S";"0142";"*  La durée mission est calculée s'il n'y a"
"IMISSD";"S";"0143";"*  pas de motifs en place"
"IMISSD";"S";"0144";"      SI LOCA_MOTJOUR = 0"
"IMISSD";"S";"0145";"         HJOU_IJQHMISSLE = LOCA_TOTMISS"
"IMISSD";"S";"0146";"* Alimentation des compteurs pour ne pas declencher"
"IMISSD";"S";"0147";"* les anomalies 103/106"
"IMISSD";"S";"0148";"         SI LOCA_ABS = 1"
"IMISSD";"S";"0149";"            HJOU_IJQNABSENT = 1"
"IMISSD";"S";"0150";"            HJOU_IJQNACTIVJ = 1"
"IMISSD";"S";"0151";"         FINSI"
"IMISSD";"S";"0152";"      FINSI"
"IMISSD";"S";"0153";"   FINSI"
"IMISSD";"S";"0154";"FINSI"
"IMISSD";"S";"0155";"FIN"
"IMISSJ";"S";"0001";"***********************************************************************"
"IMISSJ";"S";"0002";"*"
"IMISSJ";"S";"0003";"* Règle : IMISSJ"
"IMISSJ";"S";"0004";"* Ordre : 2030"
"IMISSJ";"S";"0005";"* Titre : Mission jour en cours et suivants"
"IMISSJ";"S";"0006";"*"
"IMISSJ";"S";"0007";"*----------------------------------------------------------------------"
"IMISSJ";"S";"0008";"*"
"IMISSJ";"S";"0009";"* Créé par : Cellule Industrialisation"
"IMISSJ";"S";"0010";"* Date     : 03/09/2009"
"IMISSJ";"S";"0011";"*"
"IMISSJ";"S";"0012";"*----------------------------------------------------------------------"
"IMISSJ";"S";"0013";"*"
"IMISSJ";"S";"0014";"*"
"IMISSJ";"S";"0015";"* Rôle :"
"IMISSJ";"S";"0016";"*"
"IMISSL";"S";"0123";"   FINSI"
"IMISSJ";"S";"0017";"* Mission jour en cours et suivants"
"IMISSJ";"S";"0018";"*"
"IMISSJ";"S";"0019";"*----------------------------------------------------------------------"
"IMISSJ";"S";"0020";"*"
"IMISSJ";"S";"0021";"*"
"IMISSJ";"S";"0022";"* Modifiée par : Cellule Industrialisation"
"IMISSJ";"S";"0023";"* Date         : JJ/MM/AAAA"
"IMISSJ";"S";"0024";"* Objet        :"
"IMISSJ";"S";"0025";"*"
"IMISSJ";"S";"0026";"***********************************************************************"
"IMISSJ";"S";"0027";"*"
"IMISSJ";"S";"0028";"* Implémentation des données industrielles"
"IMISSJ";"S";"0029";"*"
"IMISSJ";"S";"0030";"DEBDICO"
"IMISSJ";"S";"0031";"   HJOU_INMISS;O;Z1;X;;;123456789;L;;C2;""Mission autorisée"";"
"IMISSJ";"S";"0032";"   HJOU_IJRF2PRBHS;N;Z1;X;0;9;    56789;;IJRF2PRBHS;V2;""Flag prés. b. h.s. sur x jours (N2)"";"
"IMISSJ";"S";"0033";"   HJOU_IJQPRESBA1;N;T6,2;I;;;    56789;;;V2;""Présence badgée matin"";"
"IMISSJ";"S";"0034";"   HJOU_IJQPRESBA2;N;T6,2;I;;;    56789;;;V2;""Présence badgée après-midi"";"
"IMISSJ";"S";"0035";"   HJOU_IJQFMISPDJ;N;N2;I;;;     6789;;;V2;""Flag pause médienne mission"";"
"IMISSJ";"S";"0036";"   HJOU_IJQFMISBAD;O;N2;I;;;    56789;;;V2;""Flag présence hors site badgée"";"
"IMISSJ";"S";"0037";"   HJOU_IJQMISBADG;N;T6,2;I;;;    56789;;;V2;""Présence hors site badgée"";"
"IMISSJ";"S";"0038";"   HJOU_IJQMISSRET;N;T6,2;I;;;    56789;;;V2;""Présence h. s.borne déb. et 1er pointage"";"
"IMISSJ";"S";"0039";"   TEMP_RETOUR;N;T6,2;I;;;    56789;;;V2;""Retour mission"";"
"IMISSJ";"S";"0040";"   TEMP_TEMISS;O;Z1;X;0;1;    56789;;;V2;""Indicateur pour repas mission"";"
"IMISSJ";"S";"0041";"FINDICO"
"IMISSJ";"S";"0042";"*"
"IMISSJ";"S";"0043";"* Déclaration des donnees locales"
"IMISSJ";"S";"0044";"*"
"IMISSJ";"S";"0045";"DEF LOCA_PRESM N1"
"IMISSJ";"S";"0046";"LOCA_PRESM = 0"
"IMISSJ";"S";"0047";"DEF LOCA_PRESA N1"
"IMISSJ";"S";"0048";"LOCA_PRESA = 0"
"IMISSJ";"S";"0049";"DEF LOCA_TEST N1"
"IMISSJ";"S";"0050";"LOCA_TEST = 0"
"IMISSJ";"S";"0051";"DEF LOCA_DEJDEB T6.2"
"IMISSJ";"S";"0052";"LOCA_DEJDEB = 0"
"IMISSJ";"S";"0053";"DEF LOCA_DEJFIN T6.2"
"IMISSJ";"S";"0054";"LOCA_DEJFIN = 0"
"IMISSJ";"S";"0055";"DEF LOCA_DEJLIM T6.2"
"IMISSJ";"S";"0056";"LOCA_DEJLIM = 0"
"IMISSJ";"S";"0057";"DEF LOCA_SUP T6.2"
"IMISSJ";"S";"0058";"LOCA_SUP = 0"
"IMISSJ";"S";"0059";"DEF LOCA_INF T6.2"
"IMISSJ";"S";"0060";"LOCA_INF = 0"
"IMISSJ";"S";"0061";"DEF LOCA_DIF T6.2"
"IMISSJ";"S";"0062";"LOCA_DIF = 0"
"IMISSJ";"S";"0063";"DEF LOCA_IMPUT A6"
"IMISSJ";"S";"0064";"LOCA_IMPUT = "" """
"IMISSJ";"S";"0065";"DEF LOCA_MISS T6.2"
"IMISSJ";"S";"0066";"LOCA_MISS = 0"
"IMISSJ";"S";"0067";"DEF LOCA_DUREE T6.2"
"IMISSJ";"S";"0068";"LOCA_DUREE = 0"
"IMISSJ";"S";"0069";"DEF LOCA_PTMISS N1"
"IMISSJ";"S";"0070";"LOCA_PTMISS = 0"
"IMISSJ";"S";"0071";"DEF LOCA_DURDEJ T6.2"
"IMISSJ";"S";"0072";"LOCA_DURDEJ = 0"
"IMISSJ";"S";"0073";"DEF LOCA_DURDEJL T6.2"
"IMISSJ";"S";"0074";"LOCA_DURDEJL = 0"
"IMISSJ";"S";"0075";"DEF LOCA_SORTIE T6.2"
"IMISSJ";"S";"0076";"LOCA_SORTIE = 0"
"IMISSJ";"S";"0077";"DEF LOCA_RETMIS T6.2"
"IMISSJ";"S";"0078";"LOCA_RETMIS = 0"
"IMISSJ";"S";"0079";"DEF LOCA_MISSL T6.2"
"IMISSJ";"S";"0080";"LOCA_MISSL = 0"
"IMISSJ";"S";"0081";"SI HJOU_DATE <= TEMP_DATJOU"
"IMISSJ";"S";"0082";"   SI HJOU_INMISS <> ""0"""
"IMISSJ";"S";"0083";"      PLAGE ""DJ"""
"IMISSJ";"S";"0084";"      SI TEMP_TYPPLA <> "" """
"IMISSJ";"S";"0085";"         LOCA_DEJDEB = TEMP_VALTRT1"
"IMISSJ";"S";"0086";"         LOCA_DEJFIN = TEMP_VALTRT2"
"IMISSJ";"S";"0087";"      FINSI"
"IMISSJ";"S";"0088";"      POUR POINTAGES"
"IMISSJ";"S";"0089";"* Recuperation de l'heure de badgeage"
"IMISSJ";"S";"0090";"* si c'est un mouvement de sortie mission"
"IMISSJ";"S";"0091";"         SI POIN_SENS = ""1"""
"IMISSJ";"S";"0092";"            SI POIN_IMPUT = ""MISS"""
"IMISSJ";"S";"0093";"               LOCA_PTMISS = 1"
"IMISSJ";"S";"0094";"               LOCA_IMPUT = POIN_IMPUT"
"IMISSJ";"S";"0095";"               LOCA_SORTIE = POIN_HRETRAI"
"IMISSJ";"S";"0096";"               HJOU_IJRF2PRBHS = ""1"""
"IMISSJ";"S";"0097";"               LOCA_TEST = 0"
"IMISSJ";"S";"0098";"** test si on a un depart mission"
"IMISSJ";"S";"0099";"**  < badgeage theorique sortie 1"
"IMISSJ";"S";"0100";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0101";"** absent matin"
"IMISSJ";"S";"0102";"               SI PROF_PTTHEO1 > 0"
"IMISSJ";"S";"0103";"                  SI PROF_PTTHEO1 <= 36.00"
"IMISSJ";"S";"0104";"                     SI LOCA_SORTIE < PROF_PTTHEO2"
"IMISSJ";"S";"0105";"                        LOCA_PRESM = 1"
"IMISSJ";"S";"0106";"                     FINSI"
"IMISSJ";"S";"0107";"                  FINSI"
"IMISSJ";"S";"0108";"               FINSI"
"IMISSJ";"S";"0109";"** test si on a un depart mission"
"IMISSJ";"S";"0110";"**  < badgeage theorique sortie 1"
"IMISSJ";"S";"0111";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0112";"** absent matin"
"IMISSJ";"S";"0113";"               SI PROF_PTTHEO3 > 0"
"IMISSJ";"S";"0114";"                  SI PROF_PTTHEO3 <= 36.00"
"IMISSJ";"S";"0115";"                     SI LOCA_SORTIE < PROF_PTTHEO4"
"IMISSJ";"S";"0116";"                        LOCA_PRESA = 1"
"IMISSJ";"S";"0117";"                     FINSI"
"IMISSJ";"S";"0118";"                  FINSI"
"IMISSJ";"S";"0119";"               FINSI"
"IMISSJ";"S";"0120";"            FINSI"
"IMISSJ";"S";"0121";"         FINSI"
"IMISSJ";"S";"0122";"         SI POIN_SENS = ""0"""
"IMISSJ";"S";"0123";"            LOCA_PTMISS = 0"
"IMISSJ";"S";"0124";"* si le badgeage en entree est un retour mission"
"IMISSJ";"S";"0125";"            SI LOCA_IMPUT = ""MISS"""
"IMISSJ";"S";"0126";"               LOCA_RETMIS = POIN_HRETRAI"
"IMISSJ";"S";"0127";"               LOCA_IMPUT = "" """
"IMISSJ";"S";"0128";"               HJOU_IJRF2PRBHS = ""0"""
"IMISSJ";"S";"0129";"               LOCA_TEST = 0"
"IMISSJ";"S";"0130";"** test si on a un retour mission"
"IMISSJ";"S";"0131";"**  > badgeage theorique entree 1"
"IMISSJ";"S";"0132";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0133";"** absent matin"
"IMISSJ";"S";"0134";"               SI LOCA_PRESM = 1"
"IMISSJ";"S";"0135";"                  SI LOCA_RETMIS > PROF_PTTHEO1"
"IMISSJ";"S";"0136";"                     HJOU_IJQPRESBA1 = 2"
"IMISSJ";"S";"0137";"                  FINSI"
"IMISSJ";"S";"0138";"               FINSI"
"IMISSJ";"S";"0139";"** test si on a un retour mission"
"IMISSJ";"S";"0140";"**  > badgeage theorique entree 2"
"IMISSJ";"S";"0141";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0142";"** absent apres-midi"
"IMISSJ";"S";"0143";"               SI LOCA_PRESA = 1"
"IMISSJ";"S";"0144";"                  SI LOCA_RETMIS > PROF_PTTHEO3"
"IMISSJ";"S";"0145";"                     HJOU_IJQPRESBA2 = 2"
"IMISSJ";"S";"0146";"                  FINSI"
"IMISSJ";"S";"0147";"               FINSI"
"IMISSJ";"S";"0148";"               FAIRE CALMISS"
"IMISSJ";"S";"0149";"            FINSI"
"IMISSJ";"S";"0150";"* si retour mission sans depart dans la m?me journe"
"IMISSJ";"S";"0151";"            SI LOCA_IMPUT = "" """
"IMISSJ";"S";"0152";"* calcul de la duree par rapport ? la borne de"
"IMISSJ";"S";"0153";"* debut du profil"
"IMISSJ";"S";"0154";"* Attention calcul systematique du temps mission"
"IMISSJ";"S";"0155";"* entre le premier mouv. et l'heure de debut missio"
"IMISSJ";"S";"0156";"* du profil, ce temps est stocké dans HJMISSBL"
"IMISSJ";"S";"0157";"* Ce compteur est utilisé pour calculé la mission sur"
"IMISSJ";"S";"0158";"* un depart fait la veille"
"IMISSJ";"S";"0159";"               SI LOCA_RETMIS = 0"
"IMISSJ";"S";"0160";"                  SI HJOU_INMISS = ""2"""
"IMISSJ";"S";"0161";"                  OU HJOU_INMISS = ""3"""
"IMISSJ";"S";"0162";"                     SI PROF_IPIVMISSDV > 0"
"IMISSJ";"S";"0163";"                        LOCA_RETMIS = POIN_HRETRAI"
"IMISSJ";"S";"0164";"                        SI HJOU_IJRF2PRBHS = ""1"""
"IMISSJ";"S";"0165";"                           SI PROF_PTTHEO1 > 0"
"IMISSJ";"S";"0166";"                              SI PROF_PTTHEO1 <= 36.00"
"IMISSJ";"S";"0167";"                                 SI LOCA_RETMIS > PROF_PTTHEO1"
"IMISSJ";"S";"0168";"                                    HJOU_IJQPRESBA1 = 2"
"IMISSJ";"S";"0169";"                                 FINSI"
"IMISSJ";"S";"0170";"                              FINSI"
"IMISSJ";"S";"0171";"                           FINSI"
"IMISSJ";"S";"0172";"** test si on a un retour mission"
"IMISSJ";"S";"0173";"**  > badgeage theorique entree 2"
"IMISSJ";"S";"0174";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0175";"** absent apres-midi"
"IMISSJ";"S";"0176";"                           SI PROF_PTTHEO3 > 0"
"IMISSJ";"S";"0177";"                              SI PROF_PTTHEO3 <= 36.00"
"IMISSJ";"S";"0178";"                                 SI LOCA_RETMIS > PROF_PTTHEO3"
"IMISSJ";"S";"0179";"                                    HJOU_IJQPRESBA2 = 2"
"IMISSJ";"S";"0180";"                                 FINSI"
"IMISSJ";"S";"0181";"                              FINSI"
"IMISSJ";"S";"0182";"                           FINSI"
"IMISSJ";"S";"0183";"                        FINSI"
"IMISSJ";"S";"0184";"                        HJOU_IJRF2PRBHS = ""0"""
"IMISSJ";"S";"0185";"                        LOCA_SORTIE = PROF_IPIVMISSDV"
"IMISSJ";"S";"0186";"                        LOCA_TEST = 1"
"IMISSJ";"S";"0187";"                        FAIRE CALMISS"
"IMISSJ";"S";"0188";"                     SINON"
"IMISSJ";"S";"0189";"                        HJOU_IJRF2PRBHS = ""0"""
"IMISSJ";"S";"0190";"                     FINSI"
"IMISSJ";"S";"0191";"                  FINSI"
"IMISSJ";"S";"0192";"               FINSI"
"IMISSJ";"S";"0193";"            FINSI"
"IMISSJ";"S";"0194";"         FINSI"
"IMISSJ";"S";"0195";"      FINPOUR"
"IMISSJ";"S";"0196";"* depart mission sans retour dans la meme journne"
"IMISSJ";"S";"0197";"      SI LOCA_IMPUT = ""MISS"""
"IMISSJ";"S";"0198";"         SI LOCA_PTMISS = 1"
"IMISSJ";"S";"0199";"            SI LOCA_SORTIE <= LOCA_DEJDEB"
"IMISSJ";"S";"0200";"               LOCA_DURDEJ = PROF_IPIGPAMMIS"
"IMISSJ";"S";"0201";"               HJOU_IJQFMISPDJ = 1"
"IMISSJ";"S";"0202";"* ce compteur est utilis? dans la regle REPAS"
"IMISSJ";"S";"0203";"* pour ne pas decompter de pause d?jeuner sur"
"IMISSJ";"S";"0204";"* un depart mission fait avant la borne de debut"
"IMISSJ";"S";"0205";"* dejeuner et sans retour dans la journee"
"IMISSJ";"S";"0206";"            FINSI"
"IMISSJ";"S";"0207";"* complement par rapport ? la borne de fin mission du"
"IMISSJ";"S";"0208";"* profil"
"IMISSJ";"S";"0209";"            SI PROF_IPIGMISSTH <> ""1"""
"IMISSJ";"S";"0210";"               SI PROF_IPIVHFISRM > 0"
"IMISSJ";"S";"0211";"                  SI LOCA_SORTIE < PROF_IPIVHFISRM"
"IMISSJ";"S";"0212";"*ecretage si depart mission < borne debut mission"
"IMISSJ";"S";"0213";"* autorisee"
"IMISSJ";"S";"0214";"                     SI LOCA_SORTIE < PROF_IPIHDPRBHS"
"IMISSJ";"S";"0215";"                        LOCA_INF = LOCA_SORTIE"
"IMISSJ";"S";"0216";"                        LOCA_SUP = PROF_IPIHDPRBHS"
"IMISSJ";"S";"0217";"* calcul de la valeur ecretee"
"IMISSJ";"S";"0218";"                        SI LOCA_SUP > LOCA_INF"
"IMISSJ";"S";"0219";"                           LOCA_DIF = LOCA_SUP - LOCA_INF"
"IMISSJ";"S";"0220";"                        FINSI"
"IMISSJ";"S";"0221";"                        LOCA_SORTIE = PROF_IPIHDPRBHS"
"IMISSJ";"S";"0222";"                     FINSI"
"IMISSJ";"S";"0223";"* calcul de la duree mission"
"IMISSJ";"S";"0224";"                     LOCA_DUREE = PROF_IPIVHFISRM - LOCA_SORTIE"
"IMISSJ";"S";"0225";"                     LOCA_MISS = LOCA_MISS + LOCA_DUREE"
"IMISSJ";"S";"0226";"                  FINSI"
"IMISSJ";"S";"0227";"               FINSI"
"IMISSJ";"S";"0228";"            FINSI"
"IMISSJ";"S";"0229";"* complement par rapport ? la theorie"
"IMISSJ";"S";"0230";"            SI PROF_IPIGMISSTH = ""1"""
"IMISSJ";"S";"0231";"               LOCA_MISS = 0"
"IMISSJ";"S";"0232";"               LOCA_DURDEJ = 0"
"IMISSJ";"S";"0233";"* initialisation du compteur INMISSBA"
"IMISSJ";"S";"0234";"* pour calculer le complement dans la regle"
"IMISSJ";"S";"0235";"* MOTMISS par rapport aux autres motifs"
"IMISSJ";"S";"0236";"               HJOU_IJQFMISBAD = 1"
"IMISSJ";"S";"0237";"            FINSI"
"IMISSJ";"S";"0238";"         FINSI"
"IMISSJ";"S";"0239";"         SI HJOU_INMISS = ""1"""
"IMISSJ";"S";"0240";"            HJOU_IJRF2PRBHS = ""0"""
"IMISSJ";"S";"0241";"         FINSI"
"IMISSJ";"S";"0242";"      FINSI"
"IMISSJ";"S";"0243";"      LOCA_MISS = LOCA_MISS - LOCA_DURDEJ"
"IMISSJ";"S";"0244";"      SI LOCA_MISS > 0"
"IMISSJ";"S";"0245";"         SI LOCA_TEST = 0"
"IMISSJ";"S";"0246";"            HJOU_IJQMISBADG = LOCA_MISS"
"IMISSJ";"S";"0247";"         FINSI"
"IMISSJ";"S";"0248";"      FINSI"
"IMISSJ";"S";"0249";"      SI LOCA_MISSL > 0"
"IMISSJ";"S";"0250";"         HJOU_IJQMISSRET = LOCA_MISSL"
"IMISSJ";"S";"0251";"      FINSI"
"IMISSJ";"S";"0252";"   FINSI"
"IMISSJ";"S";"0253";"FINSI"
"IMISSJ";"S";"0254";"FIN"
"IMISSJ";"S";"0255";"***********************************************************"
"IMISSJ";"S";"0256";"*** Procedure CALMISS"
"IMISSJ";"S";"0257";"***********************************************************"
"IMISSJ";"S";"0258";"PROC CALMISS"
"IMISSJ";"S";"0259";"* retour mission apres l'heure autorisee"
"IMISSJ";"S";"0260";"   SI LOCA_RETMIS > PROF_IPIHFPRBHS"
"IMISSJ";"S";"0261";"      LOCA_INF = PROF_IPIHFPRBHS"
"IMISSJ";"S";"0262";"      SI LOCA_SORTIE > PROF_IPIHFPRBHS"
"IMISSJ";"S";"0263";"         LOCA_INF = LOCA_SORTIE"
"IMISSJ";"S";"0264";"      FINSI"
"IMISSJ";"S";"0265";"      LOCA_SUP = LOCA_RETMIS"
"IMISSJ";"S";"0266";"      LOCA_DIF = 0"
"IMISSJ";"S";"0267";"      SI LOCA_SUP > LOCA_INF"
"IMISSJ";"S";"0268";"         LOCA_DIF = LOCA_SUP - LOCA_INF"
"IMISSJ";"S";"0269";"      FINSI"
"IMISSJ";"S";"0270";"      LOCA_RETMIS = PROF_IPIHFPRBHS"
"IMISSJ";"S";"0271";"   FINSI"
"IMISSJ";"S";"0272";"* depart mission avant l'heure autorisee"
"IMISSJ";"S";"0273";"   SI LOCA_SORTIE < PROF_IPIHDPRBHS"
"IMISSJ";"S";"0274";"      LOCA_INF = LOCA_SORTIE"
"IMISSJ";"S";"0275";"      LOCA_SUP = PROF_IPIHDPRBHS"
"IMISSJ";"S";"0276";"      SI LOCA_RETMIS < PROF_IPIHDPRBHS"
"IMISSJ";"S";"0277";"         LOCA_SUP = LOCA_RETMIS"
"IMISSJ";"S";"0278";"      FINSI"
"IMISSJ";"S";"0279";"      SI LOCA_SUP > LOCA_INF"
"IMISSJ";"S";"0280";"         LOCA_DIF = LOCA_SUP - LOCA_INF"
"IMISSJ";"S";"0281";"      FINSI"
"IMISSJ";"S";"0282";"      LOCA_SORTIE = PROF_IPIHDPRBHS"
"IMISSJ";"S";"0283";"   FINSI"
"IMISSJ";"S";"0284";"** 02/07/2013 anomalie dans le cas ou le depart et le retour"
"IMISSJ";"S";"0285";"** sont faits apres l'heure de fin mission autorisée"
"IMISSJ";"S";"0286";"   SI LOCA_SORTIE > PROF_IPIHFPRBHS"
"IMISSJ";"S";"0287";"      ANOMALIE 181"
"IMISSJ";"S";"0288";"   FINSI"
"IMISSJ";"S";"0289";"*"
"IMISSJ";"S";"0290";"*"
"IMISSJ";"S";"0291";"   LOCA_DUREE = 0"
"IMISSJ";"S";"0292";"   SI LOCA_RETMIS > LOCA_SORTIE"
"IMISSJ";"S";"0293";"      LOCA_DUREE = LOCA_RETMIS - LOCA_SORTIE"
"IMISSJ";"S";"0294";"   FINSI"
"IMISSJ";"S";"0295";"   SI LOCA_RETMIS < LOCA_DEJFIN"
"IMISSJ";"S";"0296";"      SI LOCA_RETMIS > LOCA_DEJDEB"
"IMISSJ";"S";"0297";"         TEMP_RETOUR = LOCA_RETMIS"
"IMISSJ";"S";"0298";"         SI LOCA_TEST = 0"
"IMISSJ";"S";"0299";"            TEMP_TEMISS = ""2"""
"IMISSJ";"S";"0300";"         FINSI"
"IMISSJ";"S";"0301";"      FINSI"
"IMISSJ";"S";"0302";"   FINSI"
"IMISSJ";"S";"0303";"* le repas est decompte de la mission dans le cas"
"IMISSJ";"S";"0304";"* ou le depart est fait avant la borne debut dejeuner"
"IMISSJ";"S";"0305";"* et le retour apres la borne fin dejeuner"
"IMISSJ";"S";"0306";"   SI LOCA_RETMIS >= LOCA_DEJFIN"
"IMISSJ";"S";"0307";"      SI LOCA_SORTIE <= LOCA_DEJDEB"
"IMISSJ";"S";"0308";"         SI LOCA_TEST = 0"
"IMISSJ";"S";"0309";"            LOCA_DURDEJ = PROF_IPIGPAMMIS"
"IMISSJ";"S";"0310";"         SINON"
"IMISSJ";"S";"0311";"            LOCA_DURDEJL = PROF_IPIGPAMMIS"
"IMISSJ";"S";"0312";"         FINSI"
"IMISSJ";"S";"0313";"         HJOU_IJQFMISPDJ = 1"
"IMISSJ";"S";"0314";"* ce compteur est utilisé dans la regle REPAS"
"IMISSJ";"S";"0315";"* pour ne pas decompter de pause déjeuner sur"
"IMISSJ";"S";"0316";"* La presence badgee puisqu'elle est decomptee de la mission"
"IMISSJ";"S";"0317";"      FINSI"
"IMISSJ";"S";"0318";"   FINSI"
"IMISSJ";"S";"0319";"   SI LOCA_TEST = 0"
"IMISSJ";"S";"0320";"      LOCA_MISS = LOCA_MISS + LOCA_DUREE"
"IMISSJ";"S";"0321";"   SINON"
"IMISSJ";"S";"0322";"      LOCA_MISSL = LOCA_DUREE"
"IMISSJ";"S";"0323";"      LOCA_MISSL = LOCA_MISSL - LOCA_DURDEJL"
"IMISSJ";"S";"0324";"   FINSI"
"IMISSJ";"S";"0325";"FINPROC"
"IMISSL";"S";"0001";"***********************************************************************"
"IMISSL";"S";"0002";"*"
"IMISSL";"S";"0003";"* Règle : IMISSL"
"IMISSL";"S";"0004";"* Ordre : 2040"
"IMISSL";"S";"0005";"* Titre : Mission départ la veille"
"IMISSL";"S";"0006";"*"
"IMISSL";"S";"0007";"*----------------------------------------------------------------------"
"IMISSL";"S";"0008";"*"
"IMISSL";"S";"0009";"* Créé par : Cellule Industrialisation"
"IMISSL";"S";"0010";"* Date     : 03/09/2009"
"IMISSL";"S";"0011";"* Version  : 1"
"IMISSL";"S";"0012";"*"
"IMISSL";"S";"0013";"*----------------------------------------------------------------------"
"IMISSL";"S";"0014";"*"
"IMISSL";"S";"0015";"*"
"IMISSL";"S";"0016";"* Rôle :"
"IMISSL";"S";"0017";"*"
"IMISSL";"S";"0018";"* <A préciser>"
"IMISSL";"S";"0019";"*"
"IMISSL";"S";"0020";"*----------------------------------------------------------------------"
"IMISSL";"S";"0021";"*"
"IMISSL";"S";"0022";"* Modifiée par : Cellule Industrialisation"
"IMISSL";"S";"0023";"* Date         : JJ/MM/AAAA"
"IMISSL";"S";"0024";"* Objet        :"
"IMISSL";"S";"0025";"*"
"IMISSL";"S";"0026";"***********************************************************************"
"IMISSL";"S";"0027";"*"
"IMISSL";"S";"0028";"*"
"IMISSL";"S";"0029";"* Implémentation des données industrielles"
"IMISSL";"S";"0030";"*"
"IMISSL";"S";"0031";"DEBDICO"
"IMISSL";"S";"0032";"   HJOU_IJRF2PBHSL;N;Z1;X;0;9;    56789;;IJRF2PBHSL;V2;""Flag prés. b.h.s. du lendemain (N2)"";"
"IMISSL";"S";"0033";"   HJOU_IJQMISBADV;N;T6,2;I;;;    56789;;;V2;""Présence hors site badgée la veille"";"
"IMISSL";"S";"0034";"   HJOU_IJQFMILPDJ;N;N2;I;;;    56789;;;V2;""Flag pause mérid. prés. h.s.bad. lend."";"
"IMISSL";"S";"0035";"FINDICO"
"IMISSL";"S";"0036";"*"
"IMISSL";"S";"0037";"DEBANO"
"IMISSL";"S";"0038";"   143;5;""Mission du lendemain annulée"";"
"IMISSL";"S";"0039";"FINANO"
"IMISSL";"S";"0040";"* Déclaration des donnees locales"
"IMISSL";"S";"0041";"*"
"IMISSL";"S";"0042";"DEF LOCA_DEJDEB T6.2"
"IMISSL";"S";"0043";"LOCA_DEJDEB = 0"
"IMISSL";"S";"0044";"DEF LOCA_DEJFIN T6.2"
"IMISSL";"S";"0045";"LOCA_DEJFIN = 0"
"IMISSL";"S";"0046";"DEF LOCA_DEJLIM T6.2"
"IMISSL";"S";"0047";"LOCA_DEJLIM = 0"
"IMISSL";"S";"0048";"DEF LOCA_SUP T6.2"
"IMISSL";"S";"0049";"LOCA_SUP = 0"
"IMISSL";"S";"0050";"DEF LOCA_INF T6.2"
"IMISSL";"S";"0051";"LOCA_INF = 0"
"IMISSL";"S";"0052";"DEF LOCA_DIF T6.2"
"IMISSL";"S";"0053";"LOCA_DIF = 0"
"IMISSL";"S";"0054";"DEF LOCA_IMPUT A6"
"IMISSL";"S";"0055";"LOCA_IMPUT = "" """
"IMISSL";"S";"0056";"DEF LOCA_MISSL T6.2"
"IMISSL";"S";"0057";"LOCA_MISSL = 0"
"IMISSL";"S";"0058";"DEF LOCA_DUREE T6.2"
"IMISSL";"S";"0059";"LOCA_DUREE = 0"
"IMISSL";"S";"0060";"DEF LOCA_PTMISS N1"
"IMISSL";"S";"0061";"LOCA_PTMISS = 0"
"IMISSL";"S";"0062";"DEF LOCA_DURDEJ T6.2"
"IMISSL";"S";"0063";"LOCA_DURDEJ = 0"
"IMISSL";"S";"0064";"DEF LOCA_SORTIE T6.2"
"IMISSL";"S";"0065";"LOCA_SORTIE = 0"
"IMISSL";"S";"0066";"DEF LOCA_RETMIS T6.2"
"IMISSL";"S";"0067";"LOCA_RETMIS = 0"
"IMISSL";"S";"0068";"SI HJOU_DATE <= TEMP_DATJOU"
"IMISSL";"S";"0069";"   SI HJOU_INMISS = ""3"""
"IMISSL";"S";"0070";"      PLAGE ""DJ"""
"IMISSL";"S";"0071";"      SI TEMP_TYPPLA <> "" """
"IMISSL";"S";"0072";"         LOCA_DEJDEB = TEMP_VALTRT1"
"IMISSL";"S";"0073";"         LOCA_DEJFIN = TEMP_VALTRT2"
"IMISSL";"S";"0074";"      FINSI"
"IMISSL";"S";"0075";"      POUR POINTAGES"
"IMISSL";"S";"0076";"* Récuperation de l'heure de badgeage"
"IMISSL";"S";"0077";"* si c'est un mouvement de sortie mission"
"IMISSL";"S";"0078";"         SI POIN_SENS = ""1"""
"IMISSL";"S";"0079";"            SI POIN_IMPUT = ""MISSL"""
"IMISSL";"S";"0080";"               LOCA_PTMISS = 1"
"IMISSL";"S";"0081";"               LOCA_IMPUT = POIN_IMPUT"
"IMISSL";"S";"0082";"               LOCA_SORTIE = POIN_HRETRAI"
"IMISSL";"S";"0083";"               HJOU_IJRF2PBHSL = ""1"""
"IMISSL";"S";"0084";"            FINSI"
"IMISSL";"S";"0085";"         FINSI"
"IMISSL";"S";"0086";"         SI POIN_SENS = ""0"""
"IMISSL";"S";"0087";"            LOCA_PTMISS = 0"
"IMISSL";"S";"0088";"* si retour mission sans depart dans la m?me journe"
"IMISSL";"S";"0089";"            SI LOCA_IMPUT = "" """
"IMISSL";"S";"0090";"               SI LOCA_RETMIS = 0"
"IMISSL";"S";"0091";"* on ne calcul du temps mission sur le retour"
"IMISSL";"S";"0092";"* uniquement dans le cas ou PROF_IPIVMISSDV > 0"
"IMISSL";"S";"0093";"                  SI PROF_IPIVMISSDV > 0"
"IMISSL";"S";"0094";"                     LOCA_RETMIS = POIN_HRETRAI"
"IMISSL";"S";"0095";"                     HJOU_IJRF2PBHSL = ""0"""
"IMISSL";"S";"0096";"                     LOCA_SORTIE = PROF_IPIVMISSDV"
"IMISSL";"S";"0097";"                     FAIRE CALMISS"
"IMISSL";"S";"0098";"                  SINON"
"IMISSL";"S";"0099";"                     HJOU_IJRF2PBHSL = ""0"""
"IMISSL";"S";"0100";"                  FINSI"
"IMISSL";"S";"0101";"               FINSI"
"IMISSL";"S";"0102";"            SINON"
"IMISSL";"S";"0103";"* il y a un retour dans la journee"
"IMISSL";"S";"0104";"               ANOMALIE 143"
"IMISSL";"S";"0105";"               HJOU_IJRF2PBHSL = ""0"""
"IMISSL";"S";"0106";"            FINSI"
"IMISSL";"S";"0107";"         FINSI"
"IMISSL";"S";"0108";"      FINPOUR"
"IMISSL";"S";"0109";"      LOCA_MISSL = LOCA_MISSL - LOCA_DURDEJ"
"IMISSL";"S";"0110";"      SI LOCA_MISSL > 0"
"IMISSL";"S";"0111";"         HJOU_IJQMISBADV = LOCA_MISSL"
"IMISSL";"S";"0112";"      FINSI"
"IMISSL";"S";"0113";"   FINSI"
"IMISSL";"S";"0114";"FINSI"
"IMISSL";"S";"0115";"FIN"
"IMISSL";"S";"0116";"***********************************************************"
"IMISSL";"S";"0117";"*** Procedure CALMISS"
"IMISSL";"S";"0118";"***********************************************************"
"IMISSL";"S";"0119";"PROC CALMISS"
"IMISSL";"S";"0120";"* retour mission apres l'heure autorisee"
"IMISSL";"S";"0121";"   SI LOCA_RETMIS > PROF_IPIHFPRBHS"
"IMISSL";"S";"0122";"      LOCA_RETMIS = PROF_IPIHFPRBHS"
"IMISSL";"S";"0124";"   LOCA_DUREE = LOCA_RETMIS - LOCA_SORTIE"
"IMISSL";"S";"0125";"* le repas est decompte de la mission dans le cas"
"IMISSL";"S";"0126";"* ou le depart est fait avant la borne debut dejeuner"
"IMISSL";"S";"0127";"* et le retour apres la borne fin dejeuner"
"IMISSL";"S";"0128";"   SI LOCA_RETMIS >= LOCA_DEJFIN"
"IMISSL";"S";"0129";"      SI LOCA_SORTIE <= LOCA_DEJDEB"
"IMISSL";"S";"0130";"         LOCA_DURDEJ = PROF_IPIGPAMMIS"
"IMISSL";"S";"0131";"         HJOU_IJQFMILPDJ = 1"
"IMISSL";"S";"0132";"* ce compteur est utilis? dans la regle REPAS"
"IMISSL";"S";"0133";"* pour ne pas decompter de pause d?jeuner sur"
"IMISSL";"S";"0134";"* La presence badgee puisqu'elle est decomptee de la mission"
"IMISSL";"S";"0135";"      FINSI"
"IMISSL";"S";"0136";"   FINSI"
"IMISSL";"S";"0137";"   LOCA_MISSL = LOCA_MISSL + LOCA_DUREE"
"IMISSL";"S";"0138";"FINPROC"
"IPAMOINS18";"S";"0001";"***********************************************************************"
"IPAMOINS18";"S";"0002";"*"
"IPAMOINS18";"S";"0003";"* Règle : ITRPAMINE"
"IPAMOINS18";"S";"0004";"* Ordre : 2190"
"IPAMOINS18";"S";"0005";"* Titre : Vérif temps de pause travail des mineurs"
"IPAMOINS18";"S";"0006";"*"
"IPAMOINS18";"S";"0007";"*----------------------------------------------------------------------"
"IPAMOINS18";"S";"0008";"*"
"IPAMOINS18";"S";"0009";"* Créé par : Méthodes et outils"
"IPAMOINS18";"S";"0010";"* Date     : 04/11/2019"
"IPAMOINS18";"S";"0011";"* Version  : 1"
"IPAMOINS18";"S";"0012";"*"
"IPAMOINS18";"S";"0013";"*----------------------------------------------------------------------"
"IPAMOINS18";"S";"0014";"*"
"IPAMOINS18";"S";"0015";"* Rôle :"
"IPAMOINS18";"S";"0016";"*"
"IPAMOINS18";"S";"0017";"* S'assurer de la présence d'une pause d'au moins 30 mn consécutives"
"IPAMOINS18";"S";"0018";"* au-delà de 4h30 travaillées pour les moins de 18 ans"
"IPAMOINS18";"S";"0019";"*"
"IPAMOINS18";"S";"0020";"*----------------------------------------------------------------------"
"IPAMOINS18";"S";"0021";"*"
"IPAMOINS18";"S";"0022";"* Modifiée par :"
"IPAMOINS18";"S";"0023";"* Date         :"
"IPAMOINS18";"S";"0024";"* Objet        :"
"IPAMOINS18";"S";"0025";"*"
"IPAMOINS18";"S";"0026";"*----------------------------------------------------------------------"
"IPAMOINS18";"S";"0027";"*"
"IPAMOINS18";"S";"0028";"* Implémentation des données industrielles"
"IPAMOINS18";"S";"0029";"*"
"IPAMOINS18";"S";"0030";"DEBDICO"
"IPAMOINS18";"S";"0031";"FINDICO"
"IPAMOINS18";"S";"0032";"*"
"IPAMOINS18";"S";"0033";"DEBANO"
"IPAMOINS18";"S";"0034";"   163;8;""Moins de 18 ans : une pause de 30 min est obligatoire au-delà de 4h30 de travail"";"
"IPAMOINS18";"S";"0035";"FINANO"
"IPAMOINS18";"S";"0036";"*"
"IPAMOINS18";"S";"0037";"***********************************************************************"
"IPAMOINS18";"S";"0038";"*"
"IPAMOINS18";"S";"0039";"* Déclaration des donnees locales"
"IPAMOINS18";"S";"0040";"*"
"IPAMOINS18";"S";"0041";"***************************"
"IPAMOINS18";"S";"0042";"DEF LOCA_PASS N1"
"IPAMOINS18";"S";"0043";"LOCA_PASS = 0"
"IPAMOINS18";"S";"0044";"DEF LOCA_SORTIE T6.2"
"IPAMOINS18";"S";"0045";"LOCA_SORTIE = 0"
"IPAMOINS18";"S";"0046";"DEF LOCA_ENTREE T6.2"
"IPAMOINS18";"S";"0047";"LOCA_ENTREE = 0"
"IPAMOINS18";"S";"0048";"DEF LOCA_DUR T6.2"
"IPAMOINS18";"S";"0049";"LOCA_DUR = 0"
"IPAMOINS18";"S";"0050";"DEF LOCA_ANO N1"
"IPAMOINS18";"S";"0051";"LOCA_ANO = 0"
"IPAMOINS18";"S";"0052";"DEF LOCA_AGE N2"
"IPAMOINS18";"S";"0053";"LOCA_AGE = 0"
"IPAMOINS18";"S";"0054";"*"
"IPAMOINS18";"S";"0055";"*"
"IPAMOINS18";"S";"0056";"SI EMPS_E2DATENAI <> "" """
"IPAMOINS18";"S";"0057";"    DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"IPAMOINS18";"S";"0058";"    LOCA_AGE = TEMP_NXANNEE"
"IPAMOINS18";"S";"0059";"    * Pour les personnes de moins de 18 ans"
"IPAMOINS18";"S";"0060";"    SI LOCA_AGE < 18"
"IPAMOINS18";"S";"0061";"        * Test si la durée de travail sans pause > 4.30 heures"
"IPAMOINS18";"S";"0062";"        POUR POINTAGES"
"IPAMOINS18";"S";"0063";"           SI POIN_SENS = ""0"""
"IPAMOINS18";"S";"0064";"              SI LOCA_PASS = 0"
"IPAMOINS18";"S";"0065";"                 LOCA_ENTREE = POIN_HRETRAI"
"IPAMOINS18";"S";"0066";"                 LOCA_PASS = 1"
"IPAMOINS18";"S";"0067";"              FINSI"
"IPAMOINS18";"S";"0068";"           FINSI"
"IPAMOINS18";"S";"0069";"           SI POIN_SENS = ""1"""
"IPAMOINS18";"S";"0070";"              SI LOCA_PASS = 1"
"IPAMOINS18";"S";"0071";"                 LOCA_SORTIE = POIN_HRETRAI"
"IPAMOINS18";"S";"0072";"                 LOCA_PASS = 0"
"IPAMOINS18";"S";"0073";"                 LOCA_DUR = LOCA_SORTIE - LOCA_ENTREE"
"IPAMOINS18";"S";"0074";"                 SI LOCA_DUR > 4.30"
"IPAMOINS18";"S";"0075";"                    LOCA_ANO = 1"
"IPAMOINS18";"S";"0076";"                 FINSI"
"IPAMOINS18";"S";"0077";"              FINSI"
"IPAMOINS18";"S";"0078";"           FINSI"
"IPAMOINS18";"S";"0079";"        FINPOUR"
"IPAMOINS18";"S";"0080";"        *"
"IPAMOINS18";"S";"0081";"        SI LOCA_ANO = 1"
"IPAMOINS18";"S";"0082";"           ANOMALIE 163"
"IPAMOINS18";"S";"0083";"        FINSI"
"IPAMOINS18";"S";"0084";"    FINSI"
"IPAMOINS18";"S";"0085";"FINSI"
"IPAMOINS18";"S";"0086";"*"
"IPAMOINS18";"S";"0087";"FIN"
"IPAUS5BADG";"S";"0001";"***********************************************************************"
"IPAUS5BADG";"S";"0002";"*"
"IPAUS5BADG";"S";"0003";"* Règle : IPAUS5BADG"
"IPAUS5BADG";"S";"0004";"* Ordre : 2170"
"IPAUS5BADG";"S";"0005";"* Titre : Pause 5% badgée"
"IPAUS5BADG";"S";"0006";"*"
"IPAUS5BADG";"S";"0007";"*----------------------------------------------------------------------"
"IPAUS5BADG";"S";"0008";"*"
"IPAUS5BADG";"S";"0009";"* Créé par : Méthodes et outils"
"IPAUS5BADG";"S";"0010";"* Date     : 16/08/2018"
"IPAUS5BADG";"S";"0011";"* Version  : 1"
"IPAUS5BADG";"S";"0012";"*"
"IPAUS5BADG";"S";"0013";"*----------------------------------------------------------------------"
"IPAUS5BADG";"S";"0014";"*"
"IPAUS5BADG";"S";"0015";"*"
"IPAUS5BADG";"S";"0016";"* Rôle :"
"IPAUS5BADG";"S";"0017";"*"
"IPAUS5BADG";"S";"0018";"* Calcul de la pause badgée (5% du temps travaillé)"
"IPAUS5BADG";"S";"0019";"*"
"IPAUS5BADG";"S";"0020";"*"
"IPAUS5BADG";"S";"0021";"***********************************************************************"
"IPAUS5BADG";"S";"0022";"*"
"IPAUS5BADG";"S";"0023";"* Implémentation des données industrielles"
"IPAUS5BADG";"S";"0024";"*"
"IPAUS5BADG";"S";"0025";"DEBDICO"
"IPAUS5BADG";"S";"0026";"   HJOU_IJQPAUSE5J;N;T6,2;I;;;    56789;;;C0;""Pause 5%"";"
"IPAUS5BADG";"S";"0027";"FINDICO"
"IPAUS5BADG";"S";"0028";"*"
"IPAUS5BADG";"S";"0029";"*"
"IPAUS5BADG";"S";"0030";"DEBANO"
"IPAUS5BADG";"S";"0031";"   223;5;""Pas de retour sur une sortie pause"";"
"IPAUS5BADG";"S";"0032";"FINANO"
"IPAUS5BADG";"S";"0033";"* Déclaration des donnees locales"
"IPAUS5BADG";"S";"0034";"*"
"IPAUS5BADG";"S";"0035";"DEF LOCA_IMPUT A6"
"IPAUS5BADG";"S";"0036";"LOCA_IMPUT = "" """
"IPAUS5BADG";"S";"0037";"DEF LOCA_DUREE T6.2"
"IPAUS5BADG";"S";"0038";"LOCA_DUREE = 0"
"IPAUS5BADG";"S";"0039";"DEF LOCA_PTPA N1"
"IPAUS5BADG";"S";"0040";"LOCA_PTPA = 0"
"IPAUS5BADG";"S";"0041";"DEF LOCA_SORTIE T6.2"
"IPAUS5BADG";"S";"0042";"LOCA_SORTIE = 0"
"IPAUS5BADG";"S";"0043";"DEF LOCA_RETPA T6.2"
"IPAUS5BADG";"S";"0044";"LOCA_RETPA = 0"
"IPAUS5BADG";"S";"0045";"DEF LOCA_DUREET T6.2"
"IPAUS5BADG";"S";"0046";"LOCA_DUREET = 0"
"IPAUS5BADG";"S";"0047";"*"
"IPAUS5BADG";"S";"0048";"SI HJOU_DATE <= TEMP_DATJOU"
"IPAUS5BADG";"S";"0049";"* profil badgeant"
"IPAUS5BADG";"S";"0050";"   SI PROF_IPIVMINBAD > 0"
"IPAUS5BADG";"S";"0051";"* gestion pause 5%"
"IPAUS5BADG";"S";"0052";"      SI PROF_IPIGPAUSME = ""4"""
"IPAUS5BADG";"S";"0053";"* pause badgée"
"IPAUS5BADG";"S";"0054";"         SI PROF_IPIFPAUSBA = ""1"""
"IPAUS5BADG";"S";"0055";"* calcul du temps de pause avec touche PA"
"IPAUS5BADG";"S";"0056";"            POUR POINTAGES"
"IPAUS5BADG";"S";"0057";"* Recuperation de l'heure de badgeage"
"IPAUS5BADG";"S";"0058";"* si c'est un mouvement de sortie avec motif ""PA"""
"IPAUS5BADG";"S";"0059";"               SI POIN_SENS = ""1"""
"IPAUS5BADG";"S";"0060";"                  SI POIN_IMPUT = ""PA"""
"IPAUS5BADG";"S";"0061";"                     LOCA_PTPA = 1"
"IPAUS5BADG";"S";"0062";"                     LOCA_IMPUT = POIN_IMPUT"
"IPAUS5BADG";"S";"0063";"                     LOCA_SORTIE = POIN_HRETRAI"
"IPAUS5BADG";"S";"0064";"                  FINSI"
"IPAUS5BADG";"S";"0065";"               FINSI"
"IPAUS5BADG";"S";"0066";"               SI POIN_SENS = ""0"""
"IPAUS5BADG";"S";"0067";"                  LOCA_PTPA = 0"
"IPAUS5BADG";"S";"0068";"* si le badgeage en entree est un retour motif"
"IPAUS5BADG";"S";"0069";"                  SI LOCA_IMPUT = ""PA"""
"IPAUS5BADG";"S";"0070";"                     LOCA_RETPA = POIN_HRETRAI"
"IPAUS5BADG";"S";"0071";"                     LOCA_IMPUT = "" """
"IPAUS5BADG";"S";"0072";"** Calcul de la durée"
"IPAUS5BADG";"S";"0073";"                     LOCA_DUREE = LOCA_RETPA - LOCA_SORTIE"
"IPAUS5BADG";"S";"0074";"                     LOCA_DUREET = LOCA_DUREET + LOCA_DUREE"
"IPAUS5BADG";"S";"0075";"                  FINSI"
"IPAUS5BADG";"S";"0076";"               FINSI"
"IPAUS5BADG";"S";"0077";"            FINPOUR"
"IPAUS5BADG";"S";"0078";"* depart sans retour dans la meme journne"
"IPAUS5BADG";"S";"0079";"            SI LOCA_IMPUT = ""PA"""
"IPAUS5BADG";"S";"0080";"               SI LOCA_PTPA = 1"
"IPAUS5BADG";"S";"0081";"                  ANOMALIE 223"
"IPAUS5BADG";"S";"0082";"               FINSI"
"IPAUS5BADG";"S";"0083";"            FINSI"
"IPAUS5BADG";"S";"0084";"            HJOU_IJQPAUSE5J = 0"
"IPAUS5BADG";"S";"0085";"            SI LOCA_DUREET > 0"
"IPAUS5BADG";"S";"0086";"               HJOU_IJQPAUSE5J = HJOU_IJQPAUSE5J + LOCA_DUREET"
"IPAUS5BADG";"S";"0087";"            FINSI"
"IPAUS5BADG";"S";"0088";"         FINSI"
"IPAUS5BADG";"S";"0089";"      FINSI"
"IPAUS5BADG";"S";"0090";"   FINSI"
"IPAUS5BADG";"S";"0091";"FINSI"
"IPAUS5BADG";"S";"0092";"FIN"
"IPAUSB";"S";"0001";"***********************************************************************"
"IPAUSB";"S";"0002";"*"
"IPAUSB";"S";"0003";"* Règle : IPAUSB"
"IPAUSB";"S";"0004";"* Ordre : 2130"
"IPAUSB";"S";"0005";"* Titre : Gestion des pauses badgées au lecteur"
"IPAUSB";"S";"0006";"*"
"IPAUSB";"S";"0007";"*----------------------------------------------------------------------"
"IPAUSB";"S";"0008";"*"
"IPAUSB";"S";"0009";"* Créé par : Cellule Industrialisation"
"IPAUSB";"S";"0010";"* Date     : 03/09/2009"
"IPAUSB";"S";"0011";"* Version  : 1"
"IPAUSB";"S";"0012";"*"
"IPAUSB";"S";"0013";"*---------------------------------------------------------------------"
"IPAUSB";"S";"0014";"*"
"IPAUSB";"S";"0015";"*"
"IPAUSB";"S";"0016";"* Rôle :"
"IPAUSB";"S";"0017";"*"
"IPAUSB";"S";"0018";"*  Calcul du temps de pause entre la premiere sortie et la première"
"IPAUSB";"S";"0019";"*  entrée et la troisième sortie et la troisième entrée"
"IPAUSB";"S";"0020";"*  les sorties ont le code imputation PAUSE"
"IPAUSB";"S";"0021";"*"
"IPAUSB";"S";"0022";"*----------------------------------------------------------------------"
"IPAUSB";"S";"0023";"*"
"IPAUSB";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IPAUSB";"S";"0025";"* Date         : JJ/MM/AAAA"
"IPAUSB";"S";"0026";"* Objet        :"
"IPAUSB";"S";"0027";"*"
"IPAUSB";"S";"0028";"***********************************************************************"
"IPAUSB";"S";"0029";"*"
"IPAUSB";"S";"0030";"* Implémentation des données industrielles"
"IPAUSB";"S";"0031";"*"
"IPAUSB";"S";"0032";"*"
"IPAUSB";"S";"0033";"DEBDICO"
"IPAUSB";"S";"0034";"   HJOU_IJQPAUSMAT;N;T6,2;I;;;     6789;;;V2;""Pause première plage"";"
"IPAUSB";"S";"0035";"   HJOU_IJQPAUSSOI;N;T6,2;I;;;     6789;;;V2;""Pause seconde plage"";"
"IPAUSB";"S";"0036";"FINDICO"
"IPAUSB";"S";"0037";"*"
"IPAUSB";"S";"0038";"* Déclaration des donnees locales"
"IPAUSB";"S";"0039";"*"
"IPAUSB";"S";"0040";"DEF LOCA_NOB N2"
"IPAUSB";"S";"0041";"LOCA_NOB = 0"
"IPAUSB";"S";"0042";"DEF LOCA_SORTIE1 T6.2"
"IPAUSB";"S";"0043";"LOCA_SORTIE1 = 0"
"IPAUSB";"S";"0044";"DEF LOCA_ENTREE1 T6.2"
"IPAUSB";"S";"0045";"LOCA_ENTREE1 = 0"
"IPAUSB";"S";"0046";"DEF LOCA_SORTIE2 T6.2"
"IPAUSB";"S";"0047";"LOCA_SORTIE2 = 0"
"IPAUSB";"S";"0048";"DEF LOCA_ENTREE2 T6.2"
"IPAUSB";"S";"0049";"LOCA_ENTREE2 = 0"
"IPAUSB";"S";"0050";"DEF LOCA_PAUSEMA N1"
"IPAUSB";"S";"0051";"LOCA_PAUSEMA = 0"
"IPAUSB";"S";"0052";"*"
"IPAUSB";"S";"0053";"*"
"IPAUSB";"S";"0054";"SI HJOU_DATE <= TEMP_DATJOU"
"IPAUSB";"S";"0055";"** Contrôle si plus de 2 badgeages dans la première plage pour"
"IPAUSB";"S";"0056";"** dans le cas ou la pause est badgée et qu'il n'y a pas"
"IPAUSB";"S";"0057";"** de mouvement de pause la sortie du matin et l'entree de"
"IPAUSB";"S";"0058";"** l'apres-midi ne soit pas considérée comme une pause"
"IPAUSB";"S";"0059";"   SI PROF_PTTHEO1 > 0"
"IPAUSB";"S";"0060";"      SI PROF_PTTHEO1 < 100"
"IPAUSB";"S";"0061";"         ANALYSE 0.00 PROF_PTTHEO2"
"IPAUSB";"S";"0062";"         SI TEMP_HIPOIN > 2"
"IPAUSB";"S";"0063";"* on considere qu'il y a une pause badgée"
"IPAUSB";"S";"0064";"            LOCA_PAUSEMA = 1"
"IPAUSB";"S";"0065";"         SINON"
"IPAUSB";"S";"0066";"* il n'y a pas de pause badgée et dans ce cas"
"IPAUSB";"S";"0067";"* le deuxieme et troisieme mvts ne sont pas une pause"
"IPAUSB";"S";"0068";"* exemple 8.00 12.00 14.00 18.00 il ne faut pas"
"IPAUSB";"S";"0069";"* comptabiliser un temps de pause entre 12h00 et 14h00"
"IPAUSB";"S";"0070";"            LOCA_PAUSEMA = 2"
"IPAUSB";"S";"0071";"         FINSI"
"IPAUSB";"S";"0072";"      FINSI"
"IPAUSB";"S";"0073";"   FINSI"
"IPAUSB";"S";"0074";"   SI PROF_IPIFPAUSBA = ""1"""
"IPAUSB";"S";"0075";"** pause baddgée"
"IPAUSB";"S";"0076";"      POUR POINTAGES"
"IPAUSB";"S";"0077";"         LOCA_NOB = LOCA_NOB + 1"
"IPAUSB";"S";"0078";"* gestion de la prmier pause"
"IPAUSB";"S";"0079";"         SI LOCA_PAUSEMA = 1"
"IPAUSB";"S";"0080";"            SI LOCA_NOB = 2"
"IPAUSB";"S";"0081";"               SI POIN_IMPUT = "" """
"IPAUSB";"S";"0082";"               OU POIN_IMPUT = ""PAUSE"""
"IPAUSB";"S";"0083";"                  LOCA_SORTIE1 = POIN_HRETRAI"
"IPAUSB";"S";"0084";"               FINSI"
"IPAUSB";"S";"0085";"            FINSI"
"IPAUSB";"S";"0086";"            SI LOCA_NOB = 3"
"IPAUSB";"S";"0087";"               SI LOCA_SORTIE1 > 0"
"IPAUSB";"S";"0088";"                  LOCA_ENTREE1 = POIN_HRETRAI"
"IPAUSB";"S";"0089";"               FINSI"
"IPAUSB";"S";"0090";"            FINSI"
"IPAUSB";"S";"0091";"         FINSI"
"IPAUSB";"S";"0092";"** gestion de la seconde pause"
"IPAUSB";"S";"0093";"** dans le cas ou la premiere pause n'a pas été badgée"
"IPAUSB";"S";"0094";"** le test doit être fait sur le 4ème et 5ème mouvement"
"IPAUSB";"S";"0095";"         SI LOCA_PAUSEMA = 1"
"IPAUSB";"S";"0096";"            SI LOCA_NOB = 6"
"IPAUSB";"S";"0097";"               SI POIN_IMPUT = "" """
"IPAUSB";"S";"0098";"               OU POIN_IMPUT = ""PAUSE"""
"IPAUSB";"S";"0099";"                  LOCA_SORTIE2 = POIN_HRETRAI"
"IPAUSB";"S";"0100";"               FINSI"
"IPAUSB";"S";"0101";"            FINSI"
"IPAUSB";"S";"0102";"            SI LOCA_NOB = 7"
"IPAUSB";"S";"0103";"               SI LOCA_SORTIE2 > 0"
"IPAUSB";"S";"0104";"                  LOCA_ENTREE2 = POIN_HRETRAI"
"IPAUSB";"S";"0105";"               FINSI"
"IPAUSB";"S";"0106";"            FINSI"
"IPAUSB";"S";"0107";"         FINSI"
"IPAUSB";"S";"0108";"         SI LOCA_PAUSEMA = 2"
"IPAUSB";"S";"0109";"            SI LOCA_NOB = 4"
"IPAUSB";"S";"0110";"               SI POIN_IMPUT = "" """
"IPAUSB";"S";"0111";"               OU POIN_IMPUT = ""PAUSE"""
"IPAUSB";"S";"0112";"                  LOCA_SORTIE2 = POIN_HRETRAI"
"IPAUSB";"S";"0113";"               FINSI"
"IPAUSB";"S";"0114";"            FINSI"
"IPAUSB";"S";"0115";"            SI LOCA_NOB = 5"
"IPAUSB";"S";"0116";"               SI LOCA_SORTIE2 > 0"
"IPAUSB";"S";"0117";"                  LOCA_ENTREE2 = POIN_HRETRAI"
"IPAUSB";"S";"0118";"               FINSI"
"IPAUSB";"S";"0119";"            FINSI"
"IPAUSB";"S";"0120";"         FINSI"
"IPAUSB";"S";"0121";"      FINPOUR"
"IPAUSB";"S";"0122";"** Premiere pause"
"IPAUSB";"S";"0123";"      SI LOCA_ENTREE1 > LOCA_SORTIE1"
"IPAUSB";"S";"0124";"         HJOU_IJQPAUSMAT = LOCA_ENTREE1 - LOCA_SORTIE1"
"IPAUSB";"S";"0125";"      FINSI"
"IPAUSB";"S";"0126";"*** seconde pause"
"IPAUSB";"S";"0127";"      SI LOCA_ENTREE2 > LOCA_SORTIE2"
"IPAUSB";"S";"0128";"         HJOU_IJQPAUSSOI = LOCA_ENTREE2 - LOCA_SORTIE2"
"IPAUSB";"S";"0129";"      FINSI"
"IPAUSB";"S";"0130";"   SINON"
"IPAUSB";"S";"0131";"**"
"IPAUSB";"S";"0132";"** pause fofaitaire non badgée"
"IPAUSB";"S";"0133";"*"
"IPAUSB";"S";"0134";"* pause forfaitaire non badgee si presence matin"
"IPAUSB";"S";"0135";"      SI HJOU_IJQPRESBA1 > 0"
"IPAUSB";"S";"0136";"         HJOU_IJQPAUSMAT = PROF_IPIVFPAUMA"
"IPAUSB";"S";"0137";"      FINSI"
"IPAUSB";"S";"0138";"* pause forfaitaire non badgee si presence matin"
"IPAUSB";"S";"0139";"      SI HJOU_IJQPRESBA2 > 0"
"IPAUSB";"S";"0140";"         HJOU_IJQPAUSSOI = PROF_IPIVFPAUSO"
"IPAUSB";"S";"0141";"      FINSI"
"IPAUSB";"S";"0142";"   FINSI"
"IPAUSB";"S";"0143";"FINSI"
"IPAUSB";"S";"0144";"FIN"
"IPAUSE";"S";"0001";"***********************************************************************"
"IPAUSE";"S";"0002";"*"
"IPAUSE";"S";"0003";"* Règle : IPAUSE"
"IPAUSE";"S";"0004";"* Ordre : 2120"
"IPAUSE";"S";"0005";"* Titre : Gestion des pauses"
"IPAUSE";"S";"0006";"*"
"IPAUSE";"S";"0007";"*----------------------------------------------------------------------"
"IPAUSE";"S";"0008";"*"
"IPAUSE";"S";"0009";"* Créé par : Cellule Industrialisation"
"IPAUSE";"S";"0010";"* Date     : 03/09/2009"
"IPAUSE";"S";"0011";"* Version  : 1"
"IPAUSE";"S";"0012";"*"
"IPAUSE";"S";"0013";"*---------------------------------------------------------------------"
"IPAUSE";"S";"0014";"*"
"IPAUSE";"S";"0015";"*"
"IPAUSE";"S";"0016";"* Rôle :"
"IPAUSE";"S";"0017";"*"
"IPAUSE";"S";"0018";"*  Calcul du temps de pause entre la première sortie et la première"
"IPAUSE";"S";"0019";"*  entrée et la troisième sortie et la troisième entrée"
"IPAUSE";"S";"0020";"*"
"IPAUSE";"S";"0021";"*"
"IPAUSE";"S";"0022";"*----------------------------------------------------------------------"
"IPAUSE";"S";"0023";"*"
"IPAUSE";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IPAUSE";"S";"0025";"* Date         : JJ/MM/AAAA"
"IPAUSE";"S";"0026";"* Objet        :"
"IPAUSE";"S";"0027";"*"
"IPAUSE";"S";"0028";"***********************************************************************"
"IPAUSE";"S";"0029";"*"
"IPAUSE";"S";"0030";"* Implémentation des données industrielles"
"IPAUSE";"S";"0031";"*"
"IPAUSE";"S";"0032";"DEBDICO"
"IPAUSE";"S";"0033";"   PROF_IPIFPAUSBA;O;Z1;X;0;1;123456789;C;;C2;""Pause badgée"";"
"IPAUSE";"S";"0034";"   HJOU_IJQPAUSMAT;N;T6,2;I;;;     6789;;;V2;""Pause première plage"";"
"IPAUSE";"S";"0035";"   HJOU_IJQPAUSSOI;N;T6,2;I;;;     6789;;;V2;""Pause seconde plage"";"
"IPAUSE";"S";"0036";"FINDICO"
"IPAUSE";"S";"0037";"*"
"IPAUSE";"S";"0038";"* Déclaration des donnees locales"
"IPAUSE";"S";"0039";"*"
"IPAUSE";"S";"0040";"DEF LOCA_NOB N2"
"IPAUSE";"S";"0041";"LOCA_NOB = 0"
"IPAUSE";"S";"0042";"DEF LOCA_SORTIE1 T6.2"
"IPAUSE";"S";"0043";"LOCA_SORTIE1 = 0"
"IPAUSE";"S";"0044";"DEF LOCA_ENTREE1 T6.2"
"IPAUSE";"S";"0045";"LOCA_ENTREE1 = 0"
"IPAUSE";"S";"0046";"DEF LOCA_SORTIE2 T6.2"
"IPAUSE";"S";"0047";"LOCA_SORTIE2 = 0"
"IPAUSE";"S";"0048";"DEF LOCA_ENTREE2 T6.2"
"IPAUSE";"S";"0049";"LOCA_ENTREE2 = 0"
"IPAUSE";"S";"0050";"DEF LOCA_PAUSEMA N1"
"IPAUSE";"S";"0051";"LOCA_PAUSEMA = 0"
"IPAUSE";"S";"0052";"*"
"IPAUSE";"S";"0053";"*"
"IPAUSE";"S";"0054";"SI HJOU_DATE <= TEMP_DATJOU"
"IPAUSE";"S";"0055";"** Contrôle si plus de 2 badgeages dans la première plage pour"
"IPAUSE";"S";"0056";"** dans le cas ou la pause est badgée et qu'il n'y a pas"
"IPAUSE";"S";"0057";"** de mouvement de pause la sortie du matin et l'entree de"
"IPAUSE";"S";"0058";"** l'apres-midi ne soit pas considérée comme une pause"
"IPAUSE";"S";"0059";"   SI PROF_PTTHEO1 > 0"
"IPAUSE";"S";"0060";"      SI PROF_PTTHEO1 < 100"
"IPAUSE";"S";"0061";"         ANALYSE 0.00 PROF_PTTHEO2"
"IPAUSE";"S";"0062";"         SI TEMP_HIPOIN > 2"
"IPAUSE";"S";"0063";"* on considere qu'il y a une pause badgée"
"IPAUSE";"S";"0064";"            LOCA_PAUSEMA = 1"
"IPAUSE";"S";"0065";"         SINON"
"IPAUSE";"S";"0066";"* il n'y a pas de pause badgée et dans ce cas"
"IPAUSE";"S";"0067";"* le deuxieme et troisieme mvts ne sont pas une pause"
"IPAUSE";"S";"0068";"* exemple 8.00 12.00 14.00 18.00 il ne faut pas"
"IPAUSE";"S";"0069";"* comptabiliser un temps de pause entre 12h00 et 14h00"
"IPAUSE";"S";"0070";"            LOCA_PAUSEMA = 2"
"IPAUSE";"S";"0071";"         FINSI"
"IPAUSE";"S";"0072";"      FINSI"
"IPAUSE";"S";"0073";"   FINSI"
"IPAUSE";"S";"0074";"   SI PROF_IPIFPAUSBA = ""1"""
"IPAUSE";"S";"0075";"** pause baddgée"
"IPAUSE";"S";"0076";"      POUR POINTAGES"
"IPAUSE";"S";"0077";"         LOCA_NOB = LOCA_NOB + 1"
"IPAUSE";"S";"0078";"* gestion de la prmier pause"
"IPAUSE";"S";"0079";"         SI LOCA_PAUSEMA = 1"
"IPAUSE";"S";"0080";"            SI LOCA_NOB = 2"
"IPAUSE";"S";"0081";"               SI POIN_IMPUT = "" """
"IPAUSE";"S";"0082";"                  LOCA_SORTIE1 = POIN_HRETRAI"
"IPAUSE";"S";"0083";"               FINSI"
"IPAUSE";"S";"0084";"            FINSI"
"IPAUSE";"S";"0085";"            SI LOCA_NOB = 3"
"IPAUSE";"S";"0086";"               SI LOCA_SORTIE1 > 0"
"IPAUSE";"S";"0087";"                  LOCA_ENTREE1 = POIN_HRETRAI"
"IPAUSE";"S";"0088";"               FINSI"
"IPAUSE";"S";"0089";"            FINSI"
"IPAUSE";"S";"0090";"         FINSI"
"IPAUSE";"S";"0091";"** gestion de la seconde pause"
"IPAUSE";"S";"0092";"** dans le cas ou la premiere pause n'a pas été badgée"
"IPAUSE";"S";"0093";"** le test doit être fait sur le 4ème et 5ème mouvement"
"IPAUSE";"S";"0094";"         SI LOCA_PAUSEMA = 1"
"IPAUSE";"S";"0095";"            SI LOCA_NOB = 6"
"IPAUSE";"S";"0096";"               SI POIN_IMPUT = "" """
"IPAUSE";"S";"0097";"                  LOCA_SORTIE2 = POIN_HRETRAI"
"IPAUSE";"S";"0098";"               FINSI"
"IPAUSE";"S";"0099";"            FINSI"
"IPAUSE";"S";"0100";"            SI LOCA_NOB = 7"
"IPAUSE";"S";"0101";"               SI LOCA_SORTIE2 > 0"
"IPENIB";"S";"0002";"*"
"IPAUSE";"S";"0102";"                  LOCA_ENTREE2 = POIN_HRETRAI"
"IPAUSE";"S";"0103";"               FINSI"
"IPAUSE";"S";"0104";"            FINSI"
"IPAUSE";"S";"0105";"         FINSI"
"IPAUSE";"S";"0106";"         SI LOCA_PAUSEMA = 2"
"IPAUSE";"S";"0107";"            SI LOCA_NOB = 4"
"IPAUSE";"S";"0108";"               SI POIN_IMPUT = "" """
"IPAUSE";"S";"0109";"                  LOCA_SORTIE2 = POIN_HRETRAI"
"IPAUSE";"S";"0110";"               FINSI"
"IPAUSE";"S";"0111";"            FINSI"
"IPAUSE";"S";"0112";"            SI LOCA_NOB = 5"
"IPAUSE";"S";"0113";"               SI LOCA_SORTIE2 > 0"
"IPAUSE";"S";"0114";"                  LOCA_ENTREE2 = POIN_HRETRAI"
"IPAUSE";"S";"0115";"               FINSI"
"IPAUSE";"S";"0116";"            FINSI"
"IPAUSE";"S";"0117";"         FINSI"
"IPAUSE";"S";"0118";"      FINPOUR"
"IPAUSE";"S";"0119";"** Premiere pause"
"IPAUSE";"S";"0120";"      SI LOCA_ENTREE1 > LOCA_SORTIE1"
"IPAUSE";"S";"0121";"         HJOU_IJQPAUSMAT = LOCA_ENTREE1 - LOCA_SORTIE1"
"IPAUSE";"S";"0122";"      FINSI"
"IPAUSE";"S";"0123";"*** seconde pause"
"IPAUSE";"S";"0124";"      SI LOCA_ENTREE2 > LOCA_SORTIE2"
"IPAUSE";"S";"0125";"         HJOU_IJQPAUSSOI = LOCA_ENTREE2 - LOCA_SORTIE2"
"IPAUSE";"S";"0126";"      FINSI"
"IPAUSE";"S";"0127";"   SINON"
"IPAUSE";"S";"0128";"**"
"IPAUSE";"S";"0129";"** pause fofaitaire non badgée"
"IPAUSE";"S";"0130";"*"
"IPAUSE";"S";"0131";"* pause forfaitaire non badgee si presence matin"
"IPAUSE";"S";"0132";"      SI HJOU_IJQPRESBA1 > 0"
"IPAUSE";"S";"0133";"         HJOU_IJQPAUSMAT = PROF_IPIVFPAUMA"
"IPAUSE";"S";"0134";"      FINSI"
"IPAUSE";"S";"0135";"* pause forfaitaire non badgee si presence matin"
"IPAUSE";"S";"0136";"      SI HJOU_IJQPRESBA2 > 0"
"IPAUSE";"S";"0137";"         HJOU_IJQPAUSSOI = PROF_IPIVFPAUSO"
"IPAUSE";"S";"0138";"      FINSI"
"IPAUSE";"S";"0139";"   FINSI"
"IPAUSE";"S";"0140";"FINSI"
"IPAUSE";"S";"0141";"FIN"
"IPAUSE5PC";"S";"0001";"***********************************************************************"
"IPAUSE5PC";"S";"0002";"*"
"IPAUSE5PC";"S";"0003";"* Règle : IPAUSE5PC"
"IPAUSE5PC";"S";"0004";"* Ordre : 3210"
"IPAUSE5PC";"S";"0005";"* Titre : Pause 5%"
"IPAUSE5PC";"S";"0006";"*"
"IPAUSE5PC";"S";"0007";"*----------------------------------------------------------------------"
"IPAUSE5PC";"S";"0008";"*"
"IPAUSE5PC";"S";"0009";"* Créé par : Méthodes et outils"
