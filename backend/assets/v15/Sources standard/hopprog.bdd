"IDISPJD";"S";"0058";"* Déclaration des donnees locales"
"IDISPJD";"S";"0059";"*"
"IDISPJD";"S";"0060";"DEF LOCA_VAL N2.1"
"IDISPJD";"S";"0061";"DEF LOCA_DATE D"
"IDISPJD";"S";"0062";"LOCA_DATE = "" """
"IDISPJD";"S";"0063";"DEF LOCA_ACOURS N4"
"IDISPJD";"S";"0064";"LOCA_ACOURS = 0"
"IDISPJD";"S";"0065";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPJD";"S";"0066";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISP4,"
"IDISPJD";"S";"0067";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJD";"S";"0068";"* par la date souhaitée"
"IDISPJD";"S";"0069";"*"
"IDISPJD";"S";"0070";"** alimentation du droit à la date de référence"
"IDISPJD";"S";"0071";"** raz du consommé à la date de référence"
"IDISPJD";"S";"0072";"SI HJOU_DATE = PARD_IDIDRDISP4"
"IDISPJD";"S";"0073";"   *********************** !!! IMPORTANT !!! ***********************"
