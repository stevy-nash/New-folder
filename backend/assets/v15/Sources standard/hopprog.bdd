"ITPSACTPT7";"S";"0033";"*"
"ITPSACTPT7";"S";"0034";"DEBDICO"
"ITPSACTPT7";"S";"0035";"EMPL_IEIACTI;O;A1;X;;;123456789;L;;C3;""Employé géré en activité"";"
"ITPSACTPT7";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTPT7";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTPT7";"S";"0038";"FINDICO"
"ITPSACTPT7";"S";"0039";"*"
"ITPSACTPT7";"S";"0040";"*"
"ITPSACTPT7";"S";"0041";"* DEBANO"
"ITPSACTPT7";"S";"0042";"*"
"ITPSACTPT7";"S";"0043";"* FINANO"
"ITPSACTPT7";"S";"0044";"*"
"ITPSACTPT7";"S";"0045";"* Définition des variables locales"
"ITPSACTPT7";"S";"0046";"*"
"ITPSACTPT7";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTPT7";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTPT7";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTPT7";"S";"0050";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTPT7";"S";"0051";"    FINSI"
"ITPSACTPT7";"S";"0052";"FINSI"
"ITPSACTPT7";"S";"0053";"* Employé géré en activité"
"ITPSACTPT7";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTPT7";"S";"0055";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTPT7";"S";"0056";"        * Calcul de la présence activité le dernier jour du mois"
"ITPSACTPT7";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTPT7";"S";"0058";"        SI TEMP_DATSUI(7:2) = ""01"""
"ITPSACTPT7";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTPT7";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTPT7";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTPT7";"S";"0062";"                * d'activité à justifier"
"ITPSACTPT7";"S";"0063";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTPT7";"S";"0064";"                SI HJOU_SECTAFF <> "" """
"ITPSACTPT7";"S";"0065";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTPT7";"S";"0066";"                SINON"
"ITPSACTPT7";"S";"0067";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTPT7";"S";"0068";"                FINSI"
"ITPSACTPT7";"S";"0069";"                *"
"ITPSACTPT7";"S";"0070";"                SI PRES_MODE_TRV = "" """
"ITPSACTPT7";"S";"0071";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPT7";"S";"0072";"                FINSI"
"ITPSACTPT7";"S";"0073";"                *"
"ITPSACTPT7";"S";"0074";"                * ----------------------------------------------------------------------------------"
"ITPSACTPT7";"S";"0075";"                *"
"ITPSACTPT7";"S";"0076";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTPT7";"S";"0077";"                *                              (A décommenter si besoin)"
"ITPSACTPT7";"S";"0078";"                *"
"ITPSACTPT7";"S";"0079";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTPT7";"S";"0080";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test de la"
"ITPSACTPT7";"S";"0081";"                * présence théorique différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTPT7";"S";"0082";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTPT7";"S";"0083";"                *"
"ITPSACTPT7";"S";"0084";"                * SI HJOU_IJRPRETHEM <> 0"
"ITPSACTPT7";"S";"0085";"                    PRES_TPS_PRES = HJOU_IJRPRETHEM"
"ITPSACTPT7";"S";"0086";"                * SINON"
"ITPSACTPT7";"S";"0087";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTPT7";"S";"0088";"                * FINSI"
"ITPSACTPT7";"S";"0089";"                * ----------------------------------------------------------------------------------"
"ITPSACTPT7";"S";"0090";"                *"
"ITPSACTPT7";"S";"0091";"                PRES_TPS_IMPUTE = 0"
"ITPSACTPT7";"S";"0092";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTPT7";"S";"0093";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTPT7";"S";"0094";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTPT7";"S";"0095";"                    POUR EVENEMENTS"
"ITPSACTPT7";"S";"0096";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTPT7";"S";"0097";"                    FINPOUR"
"ITPSACTPT7";"S";"0098";"                FINSI"
"ITPSACTPT7";"S";"0099";"                * Calcul de l'écart"
"ITPSACTPT7";"S";"0100";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTPT7";"S";"0101";"            FINSI"
"ITPSACTPT7";"S";"0102";"        FINSI"
"ITPSACTPT7";"S";"0103";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTPT7";"S";"0104";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTPT7";"S";"0105";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTPT7";"S";"0106";"        FINSI"
"ITPSACTPT7";"S";"0107";"    FINSI"
"ITPSACTPT7";"S";"0108";"FINSI"
"ITPSACTPT7";"S";"0109";"*"
"ITPSACTPT7";"S";"0110";"FIN"
