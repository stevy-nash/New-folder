"ISUPAC";"S";"0167";"               SI HABS_VALORIS = ""A"""
"ISUPAC";"S";"0168";"                  LOCA_MOTIFA = HABS_MOTIF"
"ISUPAC";"S";"0169";"                  SI MOTI_TYPMAT = "" """
"ISUPAC";"S";"0170";"                     ANOMALIE 123"
