"ICONSCPCH";"S";"1128";"*"
"ICONSCPCH";"S";"1129";"** le 16/05/2011***************************************"
"ICONSCPCH";"S";"1130";"* si la date <= date du jour"
"ICONSCPCH";"S";"1131";"* dans le cas ou le chainage est fait avec le même motif"
"ICONSCPCH";"S";"1132";"* le motif reliquat est égal au motif CP"
"ICONSCPCH";"S";"1133";"* Dans le cas ou on a 2 motifs"
"ICONSCPCH";"S";"1134";"* de type conges 1/2 journée, ils sont transformés en"
"ICONSCPCH";"S";"1135";"* un motif de type  PARD_IDIVMCOPRI journée entiere"
"ICONSCPCH";"S";"1136";"*"
"ICONSCPCH";"S";"1137";"* SI LOCA_FUTUR = 0"
"ICONSCPCH";"S";"1138";"      LOCA_NBDEMI = 0"
"ICONSCPCH";"S";"1139";"      POUR ACTIVITES"
"ICONSCPCH";"S";"1140";"         SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPCH";"S";"1141";"            SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"1142";"               SI HABS_VALORIS <> ""J"""
"ICONSCPCH";"S";"1143";"                  LOCA_NBDEMI = LOCA_NBDEMI + 1"
"ICONSCPCH";"S";"1144";"               FINSI"
"ICONSCPCH";"S";"1145";"            FINSI"
"ICONSCPCH";"S";"1146";"         FINSI"
"ICONSCPCH";"S";"1147";"      FINPOUR"
"ICONSCPCH";"S";"1148";"      SI LOCA_NBDEMI = 2"
"ICONSCPCH";"S";"1149";"* cela veut dire qu'on se trouve avec 2 motifs"
"ICONSCPCH";"S";"1150";"* de type congés 1/2 journée"
"ICONSCPCH";"S";"1151";"* c'est normal que l'on fasse 2 fois un enlever"
"ICONSCPCH";"S";"1152";"* sur PACPANNU , c'est dans le cas ou on se retouve avec un"
"ICONSCPCH";"S";"1153";"* CP de type M et un CP de type A sur la même journée"
"ICONSCPCH";"S";"1154";"         ENLEVER PARD_IDIVMCOREL"
"ICONSCPCH";"S";"1155";"         ENLEVER PARD_IDIVMCOANC"
"ICONSCPCH";"S";"1156";"         ENLEVER PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"1157";"         ENLEVER PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"1158";"         ENLEVER PARD_IDIVMCOANT"
"ICONSCPCH";"S";"1159";"* AJOUTER PARD_IDIVMCOPRI ""J"" PROF_ABSENJ"
"ICONSCPCH";"S";"1160";"         AJOUTER PARD_IDIVMCOPRI ""J"" LOCA_DUREEJ"
"ICONSCPCH";"S";"1161";"         LOCA_NBDEMI = 0"
"ICONSCPCH";"S";"1162";"      FINSI"
"ICONSCPCH";"S";"1163";"* FINSI"
"ICONSCPCH";"S";"1164";"*Pour ajouter les cp sur jour non travaillé"
"ICONSCPCH";"S";"1165";"* Maintenir le CP lorqu'il y a un CP"
"ICONSCPCH";"S";"1166";"* suivi d'un motif maintenant les congés"
"ICONSCPCH";"S";"1167";"* suivi d'un jour de repos"
"ICONSCPCH";"S";"1168";"      SI HJOU_IJRJRCONG <> 0"
"ICONSCPCH";"S";"1169";"*RAZ"
"ICONSCPCH";"S";"1170";"         HJOU_IJRJRCONG = 0"
"ICONSCPCH";"S";"1171";"      FINSI"
"ICONSCPCH";"S";"1172";"* Ouvrés"
"ICONSCPCH";"S";"1173";"      LOCA_ACQUIS = HORC_IHIDRJTRAV + HORC_IHIDRNTRAV"
"ICONSCPCH";"S";"1174";"      SI LOCA_ACQUIS = 2.08"
"ICONSCPCH";"S";"1175";"         LOCA_JOUR = ""5"""
"ICONSCPCH";"S";"1176";"      FINSI"
"ICONSCPCH";"S";"1177";"* Ouvrables"
"ICONSCPCH";"S";"1178";"      SI LOCA_ACQUIS = 2.50"
"ICONSCPCH";"S";"1179";"         LOCA_JOUR = ""6"""
"ICONSCPCH";"S";"1180";"      FINSI"
"ICONSCPCH";"S";"1181";"*Récupération si il y a un CP sur la journée"
"ICONSCPCH";"S";"1182";"* Uniquement jusqu'au dernier jour de la semaine"
"ICONSCPCH";"S";"1183";"      SI HJOU_JOUR < LOCA_JOUR"
"ICONSCPCH";"S";"1184";"         POUR ACTIVITES"
"ICONSCPCH";"S";"1185";"* Maintien motif CP"
"ICONSCPCH";"S";"1186";"            SI MOTI_IMICONTCPS = ""3"""
"ICONSCPCH";"S";"1187";"               SI HABS_VALORIS = ""J"""
"ICONSCPCH";"S";"1188";"                  SI PROF_ABSENS <> 0"
"ICONSCPCH";"S";"1189";"                     HJOU_IJRJRCONG = 1"
"ICONSCPCH";"S";"1190";"                  SINON"
"ICONSCPCH";"S";"1191";"* Cas où une personne ne travaille que le matin"
"ICONSCPCH";"S";"1192";"                     SI PROF_ABSENJ = PROF_ABSENM"
"ICONSCPCH";"S";"1193";"                        HJOU_IJRJRCONG = 1"
"ICONSCPCH";"S";"1194";"                     SINON"
"ICONSCPCH";"S";"1195";"                        SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPCH";"S";"1196";"                           HJOU_IJRJRCONG = 0"
"ICONSCPCH";"S";"1197";"                        SINON"
"ICONSCPCH";"S";"1198";"                           HJOU_IJRJRCONG = 1"
"ICONSCPCH";"S";"1199";"                        FINSI"
"ICONSCPCH";"S";"1200";"                     FINSI"
"ICONSCPCH";"S";"1201";"                  FINSI"
"ICONSCPCH";"S";"1202";"               SINON"
"ICONSCPCH";"S";"1203";"                  SI HABS_VALORIS = ""A"""
"ICONSCPCH";"S";"1204";"                     HJOU_IJRJRCONG = 1"
"ICONSCPCH";"S";"1205";"                  SINON"
"ICONSCPCH";"S";"1206";"                     SI HABS_VALORIS = ""M"""
"ICONSCPCH";"S";"1207";"                        HJOU_IJRJRCONG = 0"
"ICONSCPCH";"S";"1208";"                     FINSI"
"ICONSCPCH";"S";"1209";"                  FINSI"
"ICONSCPCH";"S";"1210";"               FINSI"
"ICONSCPCH";"S";"1211";"            FINSI"
"ICONSCPCH";"S";"1212";"         FINPOUR"
"ICONSCPCH";"S";"1213";"      FINSI"
"ICONSCPCH";"S";"1214";"* FINSI"
"ICONSCPCH";"S";"1215";"   FINSI"
"ICONSCPCH";"S";"1216";"   FIN"
"ICONSCPSCH";"S";"0001";"***********************************************************************"
"ICONSCPSCH";"S";"0002";"*"
"ICONSCPSCH";"S";"0003";"* Règle : ICONSCPSCH"
"ICONSCPSCH";"S";"0004";"* Ordre : 3630"
"ICONSCPSCH";"S";"0005";"* Titre : Gestion de la consommation des congés payés sans chainage"
"ICONSCPSCH";"S";"0006";"*"
"ICONSCPSCH";"S";"0007";"*----------------------------------------------------------------------"
"ICONSCPSCH";"S";"0008";"*"
"ICONSCPSCH";"S";"0009";"* Créé par : Méthodes et outils"
"ICONSCPSCH";"S";"0010";"* Date     : 06/05/2019"
"ICONSCPSCH";"S";"0011";"* Version  : 1"
"ICONSCPSCH";"S";"0012";"*"
"ICONSCPSCH";"S";"0013";"*----------------------------------------------------------------------"
"ICONSCPSCH";"S";"0014";"*"
"ICONSCPSCH";"S";"0015";"*"
"ICONSCPSCH";"S";"0016";"* Rôle : Gestion de la consommation des congés payés sans chainage"
"ICONSCPSCH";"S";"0017";"*"
"ICONSCPSCH";"S";"0018";"*        Récupération de la partie consommation des congés payés"
"ICONSCPSCH";"S";"0019";"*        de la règle ICONGES du package indus V11"
"ICONSCPSCH";"S";"0020";"*"
"ICONSCPSCH";"S";"0021";"*"
"ICONSCPSCH";"S";"0022";"* Implémentation des données industrielles"
"ICONSCPSCH";"S";"0023";"*"
"ICONSCPSCH";"S";"0024";"*"
"ICONSCPSCH";"S";"0025";"*----------------------------------------------------------------------"
"ICONSCPSCH";"S";"0026";"*"
"ICONSCPSCH";"S";"0027";"* Modifiée par : Methodes et outils"
"ICONSCPSCH";"S";"0028";"* Date         : 04/08/2020"
"ICONSCPSCH";"S";"0029";"* Objet        : Remplacement de la gestion de l'ajout du motif le samedi"
"ICONSCPSCH";"S";"0030";"*                 par la gestion de l'ajout du motif sur jour non travaillé"
"ICONSCPSCH";"S";"0031";"*                 lorsqu'il y a un CP la veille (ajout de CP jusqu'au retour"
"ICONSCPSCH";"S";"0032";"*                 de la personne)"
"ICONSCPSCH";"S";"0033";"*                 Ajout également de CP sur jour non travaillé lorsqu'il y a"
"ICONSCPSCH";"S";"0034";"*                 un CP suivi d'un motif qui maintien les CP suivi"
"ICONSCPSCH";"S";"0035";"*                 d'un jour de repos"
"ICONSCPSCH";"S";"0036";"*"
"ICONSCPSCH";"S";"0037";"***********************************************************************"
"ICONSCPSCH";"S";"0038";"*"
"ICONSCPSCH";"S";"0039";"DEBDICO"
"ICONSCPSCH";"S";"0040";"   HJOU_IJRSCORELI;N;N6,1;I;;;    56789;;IJRSCORELI;V3;""Reliquat congé payé"";"
"ICONSCPSCH";"S";"0041";"   HJOU_IJRSCOPRIN;N;N6,1;I;;;    56789;;IJRSCOPRIN;V3;""Solde congé payé"";"
"ICONSCPSCH";"S";"0042";"   HJOU_IJRDCOPRIN;N;N6,1;I;;;    56789;;IJRDCOPRIN;V3;""Droit congé payé"";"
"ICONSCPSCH";"S";"0043";"   HJOU_IJRCCOPRIN;N;N6,1;I;;;    56789;;IJRCCOPRIN;V3;""Congé payé pris"";"
"ICONSCPSCH";"S";"0044";"   HJOU_IJRCCOANTI;N;N6,1;I;;;     6789;;IJRCCOANTI;V3;""Congé anticipé"";"
"ICONSCPSCH";"S";"0045";"   HJOU_IJRDCOANCI;N;N5,1;I;;;    56789;;IJRDCOANCI;V3;""Droit congé ancienneté"";"
"ICONSCPSCH";"S";"0046";"   HJOU_IJRCCOANCI;N;N5,1;I;;;    56789;;IJRCCOANCI;V3;""Congé ancienneté pris"";"
"ICONSCPSCH";"S";"0047";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"ICONSCPSCH";"S";"0048";"MOTI_IMICONTCPS;O;Z1;X;;;123456789;L9;;C3;""Maintien congé"";"
"ICONSCPSCH";"S";"0049";"   HJOU_IJRNBCPSAM;N;N2;I;;;    56789;;IJRNBCPSAM;V3;""Nombre de congés samedi"";"
"ICONSCPSCH";"S";"0050";"   HJOU_IJRSAMEAPR;N;N2;I;;;    56789;;IJRSAMEAPR;V3;""Calcul interm nbr. samedi a prendre."";"
"ICONSCPSCH";"S";"0051";"   PARD_IDINBRSAMD;O;N2;I;0;;123456789;;;C3;""Nombre de congés samedi à prendre"";"
"ICONSCPSCH";"S";"0052";"   * Acquisition des CP"
"ICONSCPSCH";"S";"0053";"   HJOU_IJRPACQCP;N;N5,2;I;;;    56789;;IJRPACQCP;V3;""Acquisition congé pris"";"
"ICONSCPSCH";"S";"0054";"   HJOU_IJRSACQCP;N;N6,2;I;;;    56789;;IJRSACQCP;V3;""Solde acquisition congé"";"
"ICONSCPSCH";"S";"0055";"   * Jours travaillés"
"ICONSCPSCH";"S";"0056";"   HJOU_IJRCPTJTRA;N;N2;I;;;    56789;;IJRCPTJTRA;V3;""Compteur de suivi des jours travaillés"";"
"ICONSCPSCH";"S";"0057";"   HORC_IHIMOACQCP;O;A1;X;;;123456789;L;;C3;""Mode d'acquisition des congés"";"
"ICONSCPSCH";"S";"0058";"   * CP pris hebdo"
"ICONSCPSCH";"S";"0059";"   HJOU_IJRCPCOH;N;N5,1;I;;;    56789;;IJRCPCOH;V3;""Congés pris hebdo"";"
"ICONSCPSCH";"S";"0060";"   *****"
"ICONSCPSCH";"S";"0061";"   HJOU_IJRCPJEUDI;N;N2;I;;;    56789;;IJRCPJEUDI;V3;""Calcul intermediaire congé payé jeudi"";"
"ICONSCPSCH";"S";"0062";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"ICONSCPSCH";"S";"0063";"   * Motifs"
"ICONSCPSCH";"S";"0064";"   PARD_IDIVMCOREL;O;A10;X;;;123456789;II;;C2;""Reliquat congé payé"";"
"ICONSCPSCH";"S";"0065";"   PARD_IDIVMCOANC;O;A10;X;;;123456789;II;;C2;""Congé ancienneté"";"
"ICONSCPSCH";"S";"0066";"   PARD_IDIVMCOPRI;O;A10;X;;;123456789;II;;C2;""Congé payé"";"
"ICONSCPSCH";"S";"0067";"   PARD_IDIVMCOANT;O;A10;X;;;123456789;II;;C2;""Congé anticipé"";"
"ICONSCPSCH";"S";"0068";"   * Congé la veille"
"ICONSCPSCH";"S";"0069";"   HJOU_IJRJRCONG;N;N2;I;;;    56789;;IJRJRCONG;V3;""Congé sur la journée"";"
"ICONSCPSCH";"S";"0070";"   HORC_IHIDRJTRAV;O;N5,2;I;;;123456789;;;C3;""Acquis congé payé"";"
"ICONSCPSCH";"S";"0071";"   * CP sur jours travaillés"
"ICONSCPSCH";"S";"0072";"   HJOU_IJRDCPTRA;N;N5,1;I;;;    56789;;IJRDCPTRA;V3;""Droit CP travaillés"";"
"ICONSCPSCH";"S";"0073";"   HJOU_IJRCCPTRA;N;N5,1;I;;;    56789;;IJRCCPTRA;V3;""Pris CP travaillés"";"
"ICONSCPSCH";"S";"0074";"   HJOU_IJRSCPTRA;N;N5,1;I;;;    56789;;IJRSCPTRA;V3;""Solde CP travaillés"";"
"ICONSCPSCH";"S";"0075";"   * CP sur jours non travaillés"
"ICONSCPSCH";"S";"0076";"   HJOU_IJRDCPNTRA;N;N5,1;I;;;    56789;;IJRDCPNTRA;V3;""Droit CP non travaillés"";"
"ICONSCPSCH";"S";"0077";"   HJOU_IJRCCPNTRA;N;N5,1;I;;;    56789;;IJRCCPNTRA;V3;""Pris CP non travaillés"";"
"ICONSCPSCH";"S";"0078";"   HJOU_IJRSCPNTRA;N;N5,1;I;;;    56789;;IJRSCPNTRA;V3;""Solde CP non travaillés"";"
"ICONSCPSCH";"S";"0079";"FINDICO"
"ICONSCPSCH";"S";"0080";"*"
"ICONSCPSCH";"S";"0081";"DEBANO"
"ICONSCPSCH";"S";"0082";"   134;5;""Prise de congés anticipés"";"
"ICONSCPSCH";"S";"0083";"   224;7;""Consigne de corrections des CP interdite"";"
"ICONSCPSCH";"S";"0084";"   168;8;""Solde congés ancienneté insuffisant"";"
"ICONSCPSCH";"S";"0085";"   197;8;""Solde acquisition congé insuffisant"";"
"ICONSCPSCH";"S";"0086";"   198;8;""Solde congé payé insuffisant"";"
"ICONSCPSCH";"S";"0087";"FINANO"
"ICONSCPSCH";"S";"0088";"*"
"ICONSCPSCH";"S";"0089";"* Déclaration des donnees locales"
"ICONSCPSCH";"S";"0090";"*"
"ICONSCPSCH";"S";"0091";"DEF LOCA_VAL N5.2"
"ICONSCPSCH";"S";"0092";"LOCA_VAL = 0"
