"ICONSCPCH";"S";"0115";"*** variables utilisées pour le calcul dans le futur"
"ICONSCPCH";"S";"0116";"***"
"ICONSCPCH";"S";"0117";"DEF LOCA_PACPRELI A10"
"ICONSCPCH";"S";"0118";"LOCA_PACPRELI = "" """
"ICONSCPCH";"S";"0119";"DEF LOCA_PACPANNU A10"
"ICONSCPCH";"S";"0120";"LOCA_PACPANNU = "" """
"ICONSCPCH";"S";"0121";"DEF LOCA_PACPANCI A10"
"ICONSCPCH";"S";"0122";"LOCA_PACPANCI = "" """
"ICONSCPCH";"S";"0123";"DEF LOCA_PACPANTI A10"
"ICONSCPCH";"S";"0124";"LOCA_PACPANTI = "" """
"ICONSCPCH";"S";"0125";"* DEF LOCA_FUTUR N1"
"ICONSCPCH";"S";"0126";"* LOCA_FUTUR = 0"
"ICONSCPCH";"S";"0127";"DEF LOCA_NBDEMI N2"
"ICONSCPCH";"S";"0128";"LOCA_NBDEMI = 0"
"ICONSCPCH";"S";"0129";"DEF LOCA_NOANNUL N1"
"ICONSCPCH";"S";"0130";"LOCA_NOANNUL = 0"
"ICONSCPCH";"S";"0131";"DEF LOCA_ANNULCP N1"
"ICONSCPCH";"S";"0132";"LOCA_ANNULCP = 0"
"ICONSCPCH";"S";"0133";"DEF LOCA_TPSP N1"
"ICONSCPCH";"S";"0134";"LOCA_TPSP = 0"
"ICONSCPCH";"S";"0135";"DEF LOCA_DATEVEIL D"
"ICONSCPCH";"S";"0136";"LOCA_DATEVEIL = "" """
"ICONSCPCH";"S";"0137";"DEF LOCA_DATEVEIL2 D"
"ICONSCPCH";"S";"0138";"LOCA_DATEVEIL2 = "" """
"ICONSCPCH";"S";"0139";"DEF LOCA_VALPRE N2"
"ICONSCPCH";"S";"0140";"LOCA_VALPRE = 0"
"ICONSCPCH";"S";"0141";"DEF LOCA_LIMITEHEB N5.1"
"ICONSCPCH";"S";"0142";"LOCA_LIMITEHEB = 0"
"ICONSCPCH";"S";"0143";"DEF LOCA_VALJT N2.1"
"ICONSCPCH";"S";"0144";"LOCA_VALJT = 0"
"ICONSCPCH";"S";"0145";"DEF LOCA_VALJNT N2.1"
"ICONSCPCH";"S";"0146";"LOCA_VALJNT = 0"
"ICONSCPCH";"S";"0147";"DEF LOCA_DRCP N2"
"ICONSCPCH";"S";"0148";"LOCA_DRCP = 0"
"ICONSCPCH";"S";"0149";"DEF LOCA_JOUR A1"
"ICONSCPCH";"S";"0150";"LOCA_JOUR = "" """
"ICONSCPCH";"S";"0151";"DEF LOCA_ACQUIS N4.2"
"ICONSCPCH";"S";"0152";"LOCA_ACQUIS = 0"
"ICONSCPCH";"S";"0153";"*"
"ICONSCPCH";"S";"0154";"DEF LOCA_DUREEJ T6.2"
"ICONSCPCH";"S";"0155";"LOCA_DUREEJ = 0"
"ICONSCPCH";"S";"0156";"DEF LOCA_DURMAT T6.2"
"ICONSCPCH";"S";"0157";"LOCA_DURMAT = 0"
"ICONSCPCH";"S";"0158";"DEF LOCA_DURSOIR T6.2"
"ICONSCPCH";"S";"0159";"LOCA_DURSOIR = 0"
"ICONSCPCH";"S";"0160";"DEF LOCA_CAL N1"
"ICONSCPCH";"S";"0161";"LOCA_CAL = 0"
"ICONSCPCH";"S";"0162";"*"
"ICONSCPCH";"S";"0163";"DEF LOCA_VALORIS A1"
"ICONSCPCH";"S";"0164";"LOCA_VALORIS = "" """
"ICONSCPCH";"S";"0165";"DEF LOCA_CPNT N1"
"ICONSCPCH";"S";"0166";"LOCA_CPNT = 0"
"ICONSCPCH";"S";"0167";"DEF LOCA_NBCPSAM N2.1"
"ICONSCPCH";"S";"0168";"LOCA_NBCPSAM = 0"
"ICONSCPCH";"S";"0169";"DEF LOCA_UTILMOD N1"
"ICONSCPCH";"S";"0170";"LOCA_UTILMOD = 0"
"ICONSCPCH";"S";"0171";"DEF LOCA_XPRES N1"
"ICONSCPCH";"S";"0172";"LOCA_XPRES = 0"
"ICONSCPCH";"S";"0173";"DEF LOCA_TRANS N6.1"
"ICONSCPCH";"S";"0174";"LOCA_TRANS = 0"
"ICONSCPCH";"S";"0175";"DEF LOCA_PRIS N6.1"
"ICONSCPCH";"S";"0176";"LOCA_PRIS = 0"
"ICONSCPCH";"S";"0177";"DEF LOCA_ACP N1"
"ICONSCPCH";"S";"0178";"LOCA_ACP = 0"
"ICONSCPCH";"S";"0179";"DEF LOCA_CPMOT N1"
"ICONSCPCH";"S";"0180";"LOCA_CPMOT = 0"
"ICONSCPCH";"S";"0181";"DEF LOCA_ANCI N1"
"ICONSCPCH";"S";"0182";"LOCA_ANCI = 0"
"ICONSCPCH";"S";"0183";"*"
"ICONSCPCH";"S";"0184";"* SI HJOU_DATE > TEMP_DATJOU"
"ICONSCPCH";"S";"0185";"* LOCA_FUTUR = 1"
"ICONSCPCH";"S";"0186";"* FINSI"
"ICONSCPCH";"S";"0187";"*"
"ICONSCPCH";"S";"0188";"* test si gestion des cp"
"ICONSCPCH";"S";"0189";"SI HJOU_IJIACOPRIN = ""1"""
"ICONSCPCH";"S";"0190";"* Dans le cas ou on a 2 motifs"
"ICONSCPCH";"S";"0191";"* de type conges 1/2 journée, ils sont transformés en"
"ICONSCPCH";"S";"0192";"* un motif de type  PARD_IDIVMCOPRI journée entiere"
"ICONSCPCH";"S";"0193";"   POUR ACTIVITES"
"ICONSCPCH";"S";"0194";"      SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPCH";"S";"0195";"      OU HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCPCH";"S";"0196";"      OU HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"0197";"      OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCPCH";"S";"0198";"         SI HABS_VALORIS <> ""J"""
"ICONSCPCH";"S";"0199";"            LOCA_NBDEMI = LOCA_NBDEMI + 1"
"ICONSCPCH";"S";"0200";"*si valorisation du motif modifiée"
"ICONSCPCH";"S";"0201";"            SI HABS_VALORIS = ""M"""
"ICONSCPCH";"S";"0202";"               LOCA_DURMAT = HABS_MOTIDUR"
"ICONSCPCH";"S";"0203";"            FINSI"
"ICONSCPCH";"S";"0204";"            SI HABS_VALORIS = ""A"""
"ICONSCPCH";"S";"0205";"               LOCA_DURSOIR = HABS_MOTIDUR"
"ICONSCPCH";"S";"0206";"            FINSI"
"ICONSCPCH";"S";"0207";"            LOCA_DUREEJ = LOCA_DURMAT + LOCA_DURSOIR"
"ICONSCPCH";"S";"0208";"         SINON"
"ICONSCPCH";"S";"0209";"            LOCA_DUREEJ = HABS_MOTIDUR"
"ICONSCPCH";"S";"0210";"            SI MOTI_IMIGDURABS = ""FIX"""
"ICONSCPCH";"S";"0211";"               LOCA_DURMAT = MOTI_VALDFT / 2"
"ICONSCPCH";"S";"0212";"               LOCA_DURSOIR = LOCA_DURMAT"
"ICONSCPCH";"S";"0213";"            FINSI"
"ICONSCPCH";"S";"0214";"            SI MOTI_IMIGDURABS = ""C5"""
"ICONSCPCH";"S";"0215";"            OU MOTI_IMIGDURABS = ""C6"""
"ICONSCPCH";"S";"0216";"            OU MOTI_IMIGDURABS = ""C7"""
"ICONSCPCH";"S";"0217";"               LOCA_DURMAT = LOCA_DUREEJ / 2"
"ICONSCPCH";"S";"0218";"               LOCA_DURSOIR = LOCA_DURMAT"
"ICONSCPCH";"S";"0219";"            FINSI"
"ICONSCPCH";"S";"0220";"            SI MOTI_IMIGDURABS = ""PLG"""
"ICONSCPCH";"S";"0221";"               LOCA_DURMAT = HJOU_IJQPLGMAT"
"ICONSCPCH";"S";"0222";"               LOCA_DURSOIR = HJOU_IJQPLGAPM"
"ICONSCPCH";"S";"0223";"            FINSI"
"ICONSCPCH";"S";"0224";"            SI MOTI_IMIGDURABS = "" """
"ICONSCPCH";"S";"0225";"               LOCA_DURMAT = PROF_ABSENM"
"ICONSCPCH";"S";"0226";"               LOCA_DURSOIR = PROF_ABSENS"
"ICONSCPCH";"S";"0227";"            FINSI"
"ICONSCPCH";"S";"0228";"*"
"ICONSCPCH";"S";"0229";"         FINSI"
"ICONSCPCH";"S";"0230";"      FINSI"
"ICONSCPCH";"S";"0231";"   FINPOUR"
"ICONSCPCH";"S";"0232";"   SI LOCA_NBDEMI = 2"
"ICONSCPCH";"S";"0233";"* cela veut dire qu'on se trouve avec 2 motifs"
"ICONSCPCH";"S";"0234";"* de type congés 1/2 journée"
"ICONSCPCH";"S";"0235";"* c'est normal que l'on fasse 2 fois un enlever"
"ICONSCPCH";"S";"0236";"* sur IDIVMCOPRI, c'est dans le cas ou on se retouve avec un"
"ICONSCPCH";"S";"0237";"* CP de type M et un CP de type A sur la même journée"
"ICONSCPCH";"S";"0238";"      ENLEVER PARD_IDIVMCOREL"
"ICONSCPCH";"S";"0239";"      ENLEVER PARD_IDIVMCOANC"
"ICONSCPCH";"S";"0240";"      ENLEVER PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"0241";"      ENLEVER PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"0242";"      ENLEVER PARD_IDIVMCOANT"
"ICONSCPCH";"S";"0243";"* AJOUTER PARD_IDIVMCOPRI ""J"" PROF_ABSENJ"
"ICONSCPCH";"S";"0244";"      AJOUTER PARD_IDIVMCOPRI ""J"" LOCA_DUREEJ"
"ICONSCPCH";"S";"0245";"      LOCA_NBDEMI = 0"
"ICONSCPCH";"S";"0246";"   FINSI"
"ICONSCPCH";"S";"0247";"* Jour de repos"
"ICONSCPCH";"S";"0248";"* Ajout des CP sur les jours non travaillés"
"ICONSCPCH";"S";"0249";"* (jours ouvrables : ajouter CP sur jour de repos du lundi au samedi)"
"ICONSCPCH";"S";"0250";"* (jours ouvrés : ajouter CP sur jour de repos du lundi au vendredi)"
"ICONSCPCH";"S";"0251";"   SI HJOU_IJQPRETHEJ = 0"
"ICONSCPCH";"S";"0252";"*Pour la gestion si pas reprise direct après fin du premier contrat"
"ICONSCPCH";"S";"0253";"*Date - 1"
"ICONSCPCH";"S";"0254";"      DATAJT HJOU_DATE 12 ""J"" -1"
"ICONSCPCH";"S";"0255";"      LOCA_DATEVEIL2 = TEMP_DXFINPER"
"ICONSCPCH";"S";"0256";"*"
"ICONSCPCH";"S";"0257";"      LIREVALPRE LOCA_DATEVEIL HJOU_DATE"
"ICONSCPCH";"S";"0258";"      SI LOCA_DATEVEIL = LOCA_DATEVEIL2"
"ICONSCPCH";"S";"0259";"         LIREVALPRE LOCA_VALPRE HJOU_IJRJRCONG"
"ICONSCPCH";"S";"0260";"         SI LOCA_VALPRE = 1"
"ICONSCPCH";"S";"0261";"* Si férié sur jour de repos + CP la veille"
"ICONSCPCH";"S";"0262";"            POUR ACTIVITES"
"ICONSCPCH";"S";"0263";"               SI HABS_MOTIF = ""FERI"""
"ICONSCPCH";"S";"0264";"                  LOCA_ANNULCP = 1"
"ICONSCPCH";"S";"0265";"               FINSI"
"ICONSCPCH";"S";"0266";"            FINPOUR"
"ICONSCPCH";"S";"0267";"* Si gestion du maintien des CP le samedi"
"ICONSCPCH";"S";"0268";"* ne pas ajouter le motif car sinon"
"ICONSCPCH";"S";"0269";"* CP ajouter 2 fois"
"ICONSCPCH";"S";"0270";"* SI PARD_IDINBRSAMD > 0"
"ICONSCPCH";"S";"0271";"            SI HJOU_JOUR = ""6"""
"ICONSCPCH";"S";"0272";"* LOCA_ANNULCP = 1"
"ICONSCPCH";"S";"0273";"               LOCA_CPNT = 1"
"ICONSCPCH";"S";"0274";"            FINSI"
"ICONSCPCH";"S";"0275";"* FINSI"
"ICONSCPCH";"S";"0276";"*"
"ICONSCPCH";"S";"0277";"            SI LOCA_ANNULCP <> 1"
"ICONSCPCH";"S";"0278";"               ENLEVER PARD_IDIVMCOREL"
"ICONSCPCH";"S";"0279";"               ENLEVER PARD_IDIVMCOANC"
"ICONSCPCH";"S";"0280";"               ENLEVER PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"0281";"               ENLEVER PARD_IDIVMCOANT"
"ICONSCPCH";"S";"0282";"               AJOUTER PARD_IDIVMCOPRI ""J"" 0"
"ICONSCPCH";"S";"0283";"            FINSI"
"ICONSCPCH";"S";"0284";"         SINON"
"ICONSCPCH";"S";"0285";"            POUR ACTIVITES"
"ICONSCPCH";"S";"0286";"* S'il y a une consigne XPRES"
"ICONSCPCH";"S";"0287";"* et un motif de type congé sur"
"ICONSCPCH";"S";"0288";"* la même journée"
"ICONSCPCH";"S";"0289";"               SI HABS_MOTIF = ""XPRES"""
"ICONSCPCH";"S";"0290";"                  LOCA_XPRES = 1"
"ICONSCPCH";"S";"0291";"               FINSI"
"ICONSCPCH";"S";"0292";"               SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPCH";"S";"0293";"               OU HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCPCH";"S";"0294";"               OU HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"0295";"               OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCPCH";"S";"0296";"* LOCA_MOTCP = 1"
"ICONSCPCH";"S";"0297";"* Si motif de type CP ajouté par"
"ICONSCPCH";"S";"0298";"* régle on enlève le motif CP"
"ICONSCPCH";"S";"0299";"                  SI HABS_UTILMOD <> ""*REG"""
"ICONSCPCH";"S";"0300";"                     LOCA_UTILMOD = 1"
"ICONSCPCH";"S";"0301";"                  FINSI"
"ICONSCPCH";"S";"0302";"               FINSI"
"ICONSCPCH";"S";"0303";"            FINPOUR"
"ICONSCPCH";"S";"0304";"*"
"ICONSCPCH";"S";"0305";"            SI LOCA_UTILMOD = 0"
"ICONSCPCH";"S";"0306";"               SI LOCA_XPRES = 0"
"ICONSCPCH";"S";"0307";"                  ENLEVER PARD_IDIVMCOREL"
"ICONSCPCH";"S";"0308";"                  ENLEVER PARD_IDIVMCOANC"
"ICONSCPCH";"S";"0309";"                  ENLEVER PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"0310";"                  ENLEVER PARD_IDIVMCOANT"
"ICONSCPCH";"S";"0311";"               FINSI"
"ICONSCPCH";"S";"0312";"            FINSI"
"ICONSCPCH";"S";"0313";"         FINSI"
"ICONSCPCH";"S";"0314";"      FINSI"
"ICONSCPCH";"S";"0315";"   FINSI"
"ICONSCPCH";"S";"0316";"*"
"ICONSCPCH";"S";"0317";"* gestion du motif CP"
"ICONSCPCH";"S";"0318";"   POUR ACTIVITES"
"ICONSCPCH";"S";"0319";"      SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPCH";"S";"0320";"      OU HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCPCH";"S";"0321";"      OU HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"0322";"      OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCPCH";"S";"0323";"* La regle VALACT qui permet de supprimer un motif"
"ICONSCPCH";"S";"0324";"* par rapport au type de jour O/S/D/F n'étant pas"
"ICONSCPCH";"S";"0325";"* déroulée dans le futur on va tester la validité du motif"
"ICONSCPCH";"S";"0326";"* avant d'effectuer le chainage et le calcul des soldes"
"ICONSCPCH";"S";"0327";"* pour que le solde prévisionnel soit juste pour la gestion"
"ICONSCPCH";"S";"0328";"* d'acquisition des CP au mois civil"
"ICONSCPCH";"S";"0329";"                     LOCA_ENLEVER = 0"
"ICONSCPCH";"S";"0330";"            LOCA_VALID = MOTI_VALID"
"ICONSCPCH";"S";"0331";"            SI LOCA_VALID(1:1) = ""O"""
"ICONSCPCH";"S";"0332";"               SI PARD_IDIJOUROUV = ""1"""
"ICONSCPCH";"S";"0333";"                  SI HJOU_IJQPRETHEJ = 0"
"ICONSCPCH";"S";"0334";"                     LOCA_ENLEVER = 1"
"ICONSCPCH";"S";"0335";"                  FINSI"
"ICONSCPCH";"S";"0336";"               SINON"
"ICONSCPCH";"S";"0337";"                  SI HJOU_JOUR = ""6"""
"ICONSCPCH";"S";"0338";"                     SI HJOU_IJQPRETHEJ = 0"
"ICONSCPCH";"S";"0339";"                        LOCA_ENLEVER = 1"
"ICONSCPCH";"S";"0340";"                     FINSI"
"ICONSCPCH";"S";"0341";"                  FINSI"
"ICONSCPCH";"S";"0342";"               FINSI"
"ICONSCPCH";"S";"0343";"            FINSI"
"ICONSCPCH";"S";"0344";"            SI LOCA_VALID(2:1) = ""S"""
"ICONSCPCH";"S";"0345";"               LOCA_ENLEVER = 0"
"ICONSCPCH";"S";"0346";"            FINSI"
"ICONSCPCH";"S";"0347";"            SI LOCA_VALID(3:1) = "" """
"ICONSCPCH";"S";"0348";"               SI HJOU_JOUR = ""7"""
"ICONSCPCH";"S";"0349";"                  SI HJOU_IJQPRETHEJ = 0"
"ICONSCPCH";"S";"0350";"                     LOCA_ENLEVER = 1"
"ICONSCPCH";"S";"0351";"                  FINSI"
"ICONSCPCH";"S";"0352";"               FINSI"
"ICONSCPCH";"S";"0353";"            FINSI"
"ICONSCPCH";"S";"0354";"**"
"ICONSCPCH";"S";"0355";"            SI LOCA_ENLEVER = 0"
"ICONSCPCH";"S";"0356";"               LOCA_VAL = 0"
"ICONSCPCH";"S";"0357";"               LOCA_VALORIS = HABS_VALORIS"
"ICONSCPCH";"S";"0358";"* la règle n'est déroulée que s'il existe un motif congé"
"ICONSCPCH";"S";"0359";"               SI HABS_VALORIS = ""J"""
"ICONSCPCH";"S";"0360";"*Optimum"
"ICONSCPCH";"S";"0361";"                  SI CTRA_TYPEPLAN = ""1"""
"ICONSCPCH";"S";"0362";"                  OU CTRA_TYPEPLAN = ""6"""
"ICONSCPCH";"S";"0363";"                     SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPCH";"S";"0364";"                        HJOU_IJRCPCOH = HJOU_IJRCPCOH + 1"
"ICONSCPCH";"S";"0365";"*Limite hebdo de 1/5"
"ICONSCPCH";"S";"0366";"                        SI HORC_IHIMOACQCP = ""1"""
"ICONSCPCH";"S";"0367";"                           LOCA_DRCP = 30"
"ICONSCPCH";"S";"0368";"                        FINSI"
"ICONSCPCH";"S";"0369";"                        SI HORC_IHIMOACQCP = ""2"""
"ICONSCPCH";"S";"0370";"                           LOCA_DRCP = 25"
"ICONSCPCH";"S";"0371";"                        FINSI"
"ICONSCPCH";"S";"0372";"*"
"ICONSCPCH";"S";"0373";"                        SI LOCA_DRCP > 0"
"ICONSCPCH";"S";"0374";"* LOCA_LIMITEHEB = HORC_IHIDRJTRAV / 5"
"ICONSCPCH";"S";"0375";"                           LOCA_LIMITEHEB = LOCA_DRCP / 5"
"ICONSCPCH";"S";"0376";"*Si congés pris hebdo <= limite hebdo 1/5 des droits CP travaillés"
"ICONSCPCH";"S";"0377";"                           SI HJOU_IJRCPCOH <= LOCA_LIMITEHEB"
"ICONSCPCH";"S";"0378";"                              LOCA_VAL = 1"
"ICONSCPCH";"S";"0379";"                           SINON"
"ICONSCPCH";"S";"0380";"                              LOCA_VAL = 0"
"ICONSCPCH";"S";"0381";"                           FINSI"
"ICONSCPCH";"S";"0382";"                        FINSI"
"ICONSCPCH";"S";"0383";"                     FINSI"
"ICONSCPCH";"S";"0384";"                  SINON"
"ICONSCPCH";"S";"0385";"                     LOCA_VAL = 1"
"ICONSCPCH";"S";"0386";"                  FINSI"
"ICONSCPCH";"S";"0387";"               SINON"
"ICONSCPCH";"S";"0388";"*Optimum"
"ICONSCPCH";"S";"0389";"                  SI CTRA_TYPEPLAN = ""1"""
"ICONSCPCH";"S";"0390";"                  OU CTRA_TYPEPLAN = ""6"""
"ICONSCPCH";"S";"0391";"                     SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPCH";"S";"0392";"                        HJOU_IJRCPCOH = HJOU_IJRCPCOH + 0.5"
"ICONSCPCH";"S";"0393";"*Limite hebdo de 1/5"
"ICONSCPCH";"S";"0394";"                        SI HORC_IHIMOACQCP = ""1"""
"ICONSCPCH";"S";"0395";"                           LOCA_DRCP = 30"
"ICONSCPCH";"S";"0396";"                        FINSI"
"ICONSCPCH";"S";"0397";"                        SI HORC_IHIMOACQCP = ""2"""
"ICONSCPCH";"S";"0398";"                           LOCA_DRCP = 25"
"ICONSCPCH";"S";"0399";"                        FINSI"
"ICONSCPCH";"S";"0400";"*"
"ICONSCPCH";"S";"0401";"                        SI LOCA_DRCP > 0"
"ICONSCPCH";"S";"0402";"* LOCA_LIMITEHEB = HORC_IHIDRJTRAV / 5"
"ICONSCPCH";"S";"0403";"                           LOCA_LIMITEHEB = LOCA_DRCP / 5"
"ICONSCPCH";"S";"0404";"*Si congés pris hebdo <= limite hebdo 1/5 des droits CP travaillés"
"ICONSCPCH";"S";"0405";"                           SI HJOU_IJRCPCOH <= LOCA_LIMITEHEB"
"ICONSCPCH";"S";"0406";"                              LOCA_VAL = 0.5"
"ICONSCPCH";"S";"0407";"                           SINON"
"ICONSCPCH";"S";"0408";"                              LOCA_VAL = 0"
"ICONSCPCH";"S";"0409";"                           FINSI"
"ICONSCPCH";"S";"0410";"                        FINSI"
"ICONSCPCH";"S";"0411";"                     SINON"
"ICONSCPCH";"S";"0412";"                        LOCA_VAL = 0"
"ICONSCPCH";"S";"0413";"                     FINSI"
"ICONSCPCH";"S";"0414";"                  SINON"
"ICONSCPCH";"S";"0415";"                     LOCA_VAL = 0.5"
"ICONSCPCH";"S";"0416";"                  FINSI"
"ICONSCPCH";"S";"0417";"               FINSI"
"ICONSCPCH";"S";"0418";"* RELIQUAT"
"ICONSCPCH";"S";"0419";"               SI HJOU_IJRSCORELI >= LOCA_VAL"
"ICONSCPCH";"S";"0420";"                  LOCA_CPR = LOCA_VAL"
"ICONSCPCH";"S";"0421";"                  LOCA_VALCPR = HABS_VALORIS"
"ICONSCPCH";"S";"0422";"                  HJOU_IJRSCORELI = HJOU_IJRSCORELI - LOCA_VAL"
"ICONSCPCH";"S";"0423";"                  LOCA_VAL = 0"
"ICONSCPCH";"S";"0424";"                  LOCA_NOANNUL = 1"
"ICONSCPCH";"S";"0425";"               SINON"
"ICONSCPCH";"S";"0426";"                  SI HJOU_IJRSCORELI > 0"
"ICONSCPCH";"S";"0427";"                     LOCA_VAL = 0.5"
"ICONSCPCH";"S";"0428";"                     LOCA_CPR = 0.5"
"ICONSCPCH";"S";"0429";"                     LOCA_VALCPR = ""M"""
"ICONSCPCH";"S";"0430";"                     HJOU_IJRSCORELI = HJOU_IJRSCORELI - 0.5"
"ICONSCPCH";"S";"0431";"                  FINSI"
"ICONSCPCH";"S";"0432";"               FINSI"
"ICONSCPCH";"S";"0433";"* Ne pas prendre en compte les congés ancienneté"
"ICONSCPCH";"S";"0434";"* sur samedi non travaillé"
"ICONSCPCH";"S";"0435";"               SI LOCA_CPNT <> 1"
"ICONSCPCH";"S";"0436";"                  SI LOCA_VAL = 1"
"ICONSCPCH";"S";"0437";"* test solde cp anciennet?"
"ICONSCPCH";"S";"0438";"                     SI HJOU_IJRSCOANCI >= LOCA_VAL"
"ICONSCPCH";"S";"0439";"                        LOCA_CPAN = 1"
"ICONSCPCH";"S";"0440";"                        LOCA_VAL = 0"
"ICONSCPCH";"S";"0441";"                        LOCA_VALCPAN = ""J"""
"ICONSCPCH";"S";"0442";"                        HJOU_IJRCCOANCI = HJOU_IJRCCOANCI + 1"
"ICONSCPCH";"S";"0443";"                        HJOU_IJRSCOANCI = HJOU_IJRSCOANCI - 1"
"ICONSCPCH";"S";"0444";"                        LOCA_NOANNUL = 1"
"ICONSCPCH";"S";"0445";"                     SINON"
"ICONSCPCH";"S";"0446";"                        SI HJOU_IJRSCOANCI > 0"
