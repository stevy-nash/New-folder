"IDISPJD";"S";"0086";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPJD";"S";"0087";"   * pas il devra être créé)"
"IDISPJD";"S";"0088";"   SI HABS_MOTIF = PARD_IDIVMDISP4"
"IDISPJD";"S";"0089";"      SI HABS_MOTIDUR > 0"
"IDISPJD";"S";"0090";"         SI HABS_VALORIS = ""J"""
"IDISPJD";"S";"0091";"            LOCA_VAL = 1"
"IDISPJD";"S";"0092";"         SINON"
"IDISPJD";"S";"0093";"            LOCA_VAL = 0.5"
"IDISPJD";"S";"0094";"         FINSI"
"IDISPJD";"S";"0095";"      FINSI"
"IDISPJD";"S";"0096";"      HJOU_IJRCJDISP4 = HJOU_IJRCJDISP4 + LOCA_VAL"
"IDISPJD";"S";"0097";"      LOCA_VAL = 0"
