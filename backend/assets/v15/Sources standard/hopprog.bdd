"ITPSACTPT8";"S";"0077";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test de la"
"ITPSACTPT8";"S";"0078";"                * présence théorique différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTPT8";"S";"0079";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTPT8";"S";"0080";"                *"
"ITPSACTPT8";"S";"0081";"                * SI HJOU_IJRPRETHEM <> 0"
"ITPSACTPT8";"S";"0082";"                    PRES_TPS_PRES = HJOU_IJRPRETHEM"
"ITPSACTPT8";"S";"0083";"                * SINON"
"ITPSACTPT8";"S";"0084";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTPT8";"S";"0085";"                * FINSI"
"ITPSACTPT8";"S";"0086";"                * ----------------------------------------------------------------------------------"
"ITPSACTPT8";"S";"0087";"                *"
"ITPSACTPT8";"S";"0088";"                PRES_TPS_IMPUTE = 0"
"ITPSACTPT8";"S";"0089";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTPT8";"S";"0090";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTPT8";"S";"0091";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTPT8";"S";"0092";"                    POUR EVENEMENTS"
"ITPSACTPT8";"S";"0093";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTPT8";"S";"0094";"                    FINPOUR"
"ITPSACTPT8";"S";"0095";"                FINSI"
"ITPSACTPT8";"S";"0096";"                * Calcul de l'écart"
"ITPSACTPT8";"S";"0097";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTPT8";"S";"0098";"            FINSI"
"ITPSACTPT8";"S";"0099";"        FINSI"
"ITPSACTPT8";"S";"0100";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTPT8";"S";"0101";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTPT8";"S";"0102";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTPT8";"S";"0103";"        FINSI"
"ITPSACTPT8";"S";"0104";"    FINSI"
"ITPSACTPT8";"S";"0105";"FINSI"
