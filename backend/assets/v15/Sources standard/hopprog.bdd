"IDISPJB";"S";"0111";"   FINSI"
"IDISPJB";"S";"0112";"   SI HABS_MOTIF = ""ZCDIS2"""
"IDISPJB";"S";"0113";"      HJOU_IJRCJDISP2 = HABS_MOTINBR"
"IDISPJB";"S";"0114";"   FINSI"
"IDISPJB";"S";"0115";"   SI HABS_MOTIF = ""XCDIS2"""
"IDISPJB";"S";"0116";"      HJOU_IJRCJDISP2 = HJOU_IJRCJDISP2 + HABS_MOTINBR"
"IDISPJB";"S";"0117";"   FINSI"
"IDISPJB";"S";"0118";"FINPOUR"
"IDISPJB";"S";"0119";"** calcul du solde"
"IDISPJB";"S";"0120";"HJOU_IJRSJDISP2 = HJOU_IJRDJDISP2 - HJOU_IJRCJDISP2"
"IDISPJB";"S";"0121";"LOCA_ACOURS << PARD_IDIDRDISP2(1:4)"
"IDISPJB";"S";"0122";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPJB";"S";"0123";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPJB";"S";"0124";"LOCA_DATE(5:4) = PARD_IDIDRDISP2(5:4)"
"IDISPJB";"S";"0125";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPJB";"S";"0126";"   EMPL_IEQSPDISP2 = HJOU_IJRSJDISP2"
"IDISPJB";"S";"0127";"FINSI"
"IDISPJB";"S";"0128";"FIN"
"IDISPJC";"S";"0001";"***********************************************************************"
"IDISPJC";"S";"0002";"*"
"IDISPJC";"S";"0003";"* Règle : IDISPJC"
"IDISPJC";"S";"0004";"* Ordre : 7020"
"IDISPJC";"S";"0005";"* Titre : Compteurs disponible 3 en jour"
"IDISPJC";"S";"0006";"*"
"IDISPJC";"S";"0007";"*----------------------------------------------------------------------"
"IDISPJC";"S";"0008";"*"
"IDISPJC";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDISPJC";"S";"0010";"* Date     : 03/09/2009"
"IDISPJC";"S";"0011";"* Version  : 1"
"IDISPJC";"S";"0012";"*"
"IDISPJC";"S";"0013";"*---------------------------------------------------------------------"
"IDISPJC";"S";"0014";"*"
"IDISPJC";"S";"0015";"*"
"IDISPJC";"S";"0016";"* Rôle : Mettre à disposition une règle gérant des compteurs droit/pris/solde"
"IDISPJC";"S";"0017";"*         Mais également des compteurs afin de ne pas avoir à en"
"IDISPJC";"S";"0018";"*         créer de nouveaux et lancer une perso (ex: client en prod,...)"
"IDISPJC";"S";"0019";"*"
"IDISPJC";"S";"0020";"*         Par défaut les différents compteurs ne sont pas affichés"
"IDISPJC";"S";"0021";"*         s'il y a besoin cela devra être fait via la fonction PER"
"IDISPJC";"S";"0022";"*         Les consignes ainsi que le motif de consommation sont à"
"IDISPJC";"S";"0023";"*         créer via la fonction ACT"
"IDISPJC";"S";"0024";"*"
"IDISPJC";"S";"0025";"*"
"IDISPJC";"S";"0026";"* Gestion du Droit/Pris/solde d'un compteur en jour"
"IDISPJC";"S";"0027";"* Le droit est alimenté en début de période de référence définie"
"IDISPJC";"S";"0028";"* dans les données globales datées par une valeur définie dans les"
"IDISPJC";"S";"0029";"* données globales datées"
"IDISPJC";"S";"0030";"* le pris est alimenté par un motif alimenté dans les données globales"
"IDISPJC";"S";"0031";"* datées"
"IDISPJC";"S";"0032";"* Pas de gestion d'anomalie en cas de solde négatif (à créer si besoin)"
"IDISPJC";"S";"0033";"*"
"IDISPJC";"S";"0034";"*----------------------------------------------------------------------"
"IDISPJC";"S";"0035";"*"
"IDISPJC";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPJC";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPJC";"S";"0038";"* Objet        :"
"IDISPJC";"S";"0039";"*"
"IDISPJC";"S";"0040";"***********************************************************************"
"IDISPJC";"S";"0041";"*"
"IDISPJC";"S";"0042";"* Implémentation des données industrielles"
"IDISPJC";"S";"0043";"*"
"IDISPJC";"S";"0044";"DEBDICO"
"IDISPJC";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPJC";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPJC";"S";"0048";"   * en passant par la fonction PER"
"IDISPJC";"S";"0049";"   HJOU_IJRDJDISP3;N;N6,2;L;;;    56789;;IJRDJDISP3;V3;""Droit en jour disponible 3"";"
"IDISPJC";"S";"0050";"   HJOU_IJRCJDISP3;N;N6,2;L;;;    56789;;IJRCJDISP3;V3;""Pris en jour disponible 3"";"
"IDISPJC";"S";"0051";"   HJOU_IJRSJDISP3;N;N6,2;L;;;    56789;;IJRSJDISP3;V3;""Solde en jour disponible 3"";"
"IDISPJC";"S";"0052";"   EMPL_IEQSPDISP3;N;N6,2;L;;;     6789;;;V3;""Solde prévisionnel en jour disponible 3"";"
"IDISPJC";"S";"0053";"PARD_IDIDRDISP3;O;D10;X;;;123456789;;;C3;""Date RAZ compteur jour disponible 3"";"
"IDISPJC";"S";"0054";"PARD_IDIVDDISP3;O;N6,2;I;;;123456789;;;C3;""Valeur droit jour compteur disponible  3"";"
"IDISPJC";"S";"0055";"PARD_IDIVMDISP3;O;A10;X;;;123456789;II;;C2;""Motif compteur en jour disponible 3"";"
"IDISPJC";"S";"0056";"FINDICO"
"IDISPJC";"S";"0057";"*"
"IDISPJC";"S";"0058";"* Déclaration des donnees locales"
"IDISPJC";"S";"0059";"*"
"IDISPJC";"S";"0060";"DEF LOCA_VAL N2.1"
"IDISPJC";"S";"0061";"DEF LOCA_DATE D"
"IDISPJC";"S";"0062";"LOCA_DATE = "" """
"IDISPJC";"S";"0063";"DEF LOCA_ACOURS N4"
"IDISPJC";"S";"0064";"LOCA_ACOURS = 0"
"IDISPJC";"S";"0065";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0066";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISP3,"
"IDISPJC";"S";"0067";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJC";"S";"0068";"* par la date souhaitée"
"IDISPJC";"S";"0069";"*"
"IDISPJC";"S";"0070";"** alimentation du droit à la date de référence"
"IDISPJC";"S";"0071";"** raz du consommé à la date de référence"
"IDISPJC";"S";"0072";"SI HJOU_DATE = PARD_IDIDRDISP3"
"IDISPJC";"S";"0073";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0074";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPJC";"S";"0075";"   * par le nombre paramétré dans PARD_IDIVDDISP3,"
"IDISPJC";"S";"0076";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJC";"S";"0077";"   * par le nombre souhaité"
"IDISPJC";"S";"0078";"   HJOU_IJRDJDISP3 = PARD_IDIVDDISP3"
"IDISPJC";"S";"0079";"   HJOU_IJRCJDISP3 = 0"
"IDISPJC";"S";"0080";"FINSI"
"IDISPJC";"S";"0081";"** alimentation du pris"
"IDISPJC";"S";"0082";"POUR ACTIVITES"
"IDISPJC";"S";"0083";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0084";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISP3,"
"IDISPJC";"S";"0085";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPJC";"S";"0086";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPJC";"S";"0087";"   * pas il devra être créé)"
"IDISPJC";"S";"0088";"   SI HABS_MOTIF = PARD_IDIVMDISP3"
"IDISPJC";"S";"0089";"      SI HABS_MOTIDUR > 0"
"IDISPJC";"S";"0090";"         SI HABS_VALORIS = ""J"""
"IDISPJC";"S";"0091";"            LOCA_VAL = 1"
"IDISPJC";"S";"0092";"         SINON"
"IDISPJC";"S";"0093";"            LOCA_VAL = 0.5"
"IDISPJC";"S";"0094";"         FINSI"
"IDISPJC";"S";"0095";"      FINSI"
"IDISPJC";"S";"0096";"      HJOU_IJRCJDISP3 = HJOU_IJRCJDISP3 + LOCA_VAL"
"IDISPJC";"S";"0097";"      LOCA_VAL = 0"
"IDISPJC";"S";"0098";"   FINSI"
"IDISPJC";"S";"0099";"FINPOUR"
"IDISPJC";"S";"0100";"** alimentation du droit/pris par consignes"
"IDISPJC";"S";"0101";"POUR ACTIVITES"
"IDISPJC";"S";"0102";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0103";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPJC";"S";"0104";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPJC";"S";"0105";"   * en conséquence)"
"IDISPJC";"S";"0106";"   SI HABS_MOTIF = ""ZDDIS3"""
"IDISPJC";"S";"0107";"      HJOU_IJRDJDISP3 = HABS_MOTINBR"
"IDISPJC";"S";"0108";"   FINSI"
"IDISPJC";"S";"0109";"   SI HABS_MOTIF = ""XDDIS3"""
"IDISPJC";"S";"0110";"      HJOU_IJRDJDISP3 = HJOU_IJRDJDISP3 + HABS_MOTINBR"
"IDISPJC";"S";"0111";"   FINSI"
"IDISPJC";"S";"0112";"   SI HABS_MOTIF = ""ZCDIS3"""
"IDISPJC";"S";"0113";"      HJOU_IJRCJDISP3 = HABS_MOTINBR"
"IDISPJC";"S";"0114";"   FINSI"
"IDISPJC";"S";"0115";"   SI HABS_MOTIF = ""XCDIS3"""
"IDISPJC";"S";"0116";"      HJOU_IJRCJDISP3 = HJOU_IJRCJDISP3 + HABS_MOTINBR"
"IDISPJC";"S";"0117";"   FINSI"
"IDISPJC";"S";"0118";"FINPOUR"
"IDISPJC";"S";"0119";"** calcul du solde"
"IDISPJC";"S";"0120";"HJOU_IJRSJDISP3 = HJOU_IJRDJDISP3 - HJOU_IJRCJDISP3"
"IDISPJC";"S";"0121";"LOCA_ACOURS << PARD_IDIDRDISP3(1:4)"
"IDISPJC";"S";"0122";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPJC";"S";"0123";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPJC";"S";"0124";"LOCA_DATE(5:4) = PARD_IDIDRDISP3(5:4)"
"IDISPJC";"S";"0125";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPJC";"S";"0126";"   EMPL_IEQSPDISP3 = HJOU_IJRSJDISP3"
"IDISPJC";"S";"0127";"FINSI"
"IDISPJC";"S";"0128";"FIN"
