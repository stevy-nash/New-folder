"IDEBOR";"S";"0028";"*"
"IDEBOR";"S";"0029";"* Implémentation des données industrielles"
"IDEBOR";"S";"0030";"*"
"IDEBOR";"S";"0031";"DEBDICO"
"IDEBOR";"S";"0032";"   HJOU_IJQHEXCEDJ;N;T6,2;I;;;    56789;;;V3;""Heures totales excédentaires"";"
"IDEBOR";"S";"0033";"FINDICO"
"IDEBOR";"S";"0034";"*"
"IDEBOR";"S";"0035";"* Déclaration des donnees locales"
"IDEBOR";"S";"0036";"*"
"IDEBOR";"S";"0037";"SI HJOU_DATE <= TEMP_DATJOU"
"IDEBOR";"S";"0038";"   HJOU_IJQHEXCEDJ = HJOU_IJQDEBORDT"
"IDEBOR";"S";"0039";"   POUR ACTIVITES"
"IDEBOR";"S";"0040";"      SI HABS_MOTIF = ""ZEXC"""
"IDEBOR";"S";"0041";"         HJOU_IJQHEXCEDJ = HABS_MOTIDUR"
"IDEBOR";"S";"0042";"      FINSI"
"IDEBOR";"S";"0043";"   FINPOUR"
"IDEBOR";"S";"0044";"FINSI"
"IDEBOR";"S";"0045";"FIN"
"IDELEG";"S";"0001";"***********************************************************************"
"IDELEG";"S";"0002";"*"
"IDELEG";"S";"0003";"* Règle : IDELEG"
"IDELEG";"S";"0005";"* Titre : Délégations"
"IDELEG";"S";"0006";"*"
"IDELEG";"S";"0007";"*----------------------------------------------------------------------"
"IDELEG";"S";"0008";"*"
"IDELEG";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDELEG";"S";"0010";"* Date     : 03/09/2009"
"IDELEG";"S";"0011";"* Version  : 1"
"IDELEG";"S";"0012";"*"
"IDELEG";"S";"0013";"*----------------------------------------------------------------------"
"IDELEG";"S";"0014";"*"
"IDELEG";"S";"0015";"*"
"IDELEG";"S";"0016";"* Rôle : Gestion des délégations DS/DFS"
"IDELEG";"S";"0017";"*"
"IDELEG";"S";"0018";"*"
"IDELEG";"S";"0019";"*"
"IDELEG";"S";"0020";"*----------------------------------------------------------------------"
"IDELEG";"S";"0021";"*"
"IDELEG";"S";"0022";"* Modifiée par : Méthodes et outils"
"IDELEG";"S";"0023";"* Date         : 18/10/2019"
"IDELEG";"S";"0024";"* Objet        : Suppression des délégations CE, DP, CHSCT et DUP"
"IDELEG";"S";"0025";"*"
"IDELEG";"S";"0026";"***********************************************************************"
"IDELEG";"S";"0027";"*"
"IDELEG";"S";"0028";"* Implémentation des données industrielles"
"IDELEG";"S";"0029";"*"
"IDELEG";"S";"0030";"DEBDICO"
"IDELEG";"S";"0031";"   HJOU_IJIDDELEDS;O;T6,2;I;;;123456789;;;C3;""Droit délégation DS"";"
"IDELEG";"S";"0032";"   HJOU_IJIDATDEDS;O;D10;X;;;123456789;;;C3;""Date début de mandat délégation DS"";"
"IDELEG";"S";"0033";"   HJOU_IJIDATFDDS;O;D10;X;;;123456789;;;C3;""Fin de mandat délégation DS"";"
"IDELEG";"S";"0034";"   HJOU_IJRDDELEDS;N;T6,2;I;;;     6789;;IJRDDELEDS;V3;""Droit délégation DS"";"
"IDELEG";"S";"0035";"   HJOU_IJRCDELEDS;N;T6,2;I;;;     6789;;IJRCDELEDS;V3;""Pris délégation DS"";"
"IDELEG";"S";"0036";"   HJOU_IJRSDELEDS;N;T6,2;I;;;     6789;;;V3;""Solde délégation DS"";"
"IDELEG";"S";"0037";"   HJOU_IJIDDELDFS;O;T6,2;I;;;123456789;;;C3;""Droit délégation DFS"";"
"IDELEG";"S";"0038";"   HJOU_IJIDATDDFS;O;D10;X;;;123456789;;;C3;""Date début de mandat délégation DFS"";"
"IDELEG";"S";"0039";"   HJOU_IJIDATFDFS;O;D10;X;;;123456789;;;C3;""Fin de mandat délégation DFS"";"
"IDELEG";"S";"0040";"   HJOU_IJRDDELDFS;N;T6,2;I;;;     6789;;IJRDDELDFS;V3;""Droit délégation DFS"";"
"IDELEG";"S";"0041";"   HJOU_IJRCDELDFS;N;T6,2;I;;;     6789;;IJRCDELDFS;V3;""Pris délégation DFS"";"
"IDELEG";"S";"0042";"   HJOU_IJRSDELDFS;N;T6,2;I;;;     6789;;;V3;""Solde délégation DFS"";"
"IDELEG";"S";"0043";"   HJOU_IJRNBHDELE;N;T6,2;I;;;     6789;;IJRNBHDELE;V3;""Nbre h. délég. pour jours trav. annuels"";"
"IDELEG";"S";"0044";"FINDICO"
"IDELEG";"S";"0045";"*"
"IDELEG";"S";"0046";"DEBANO"
"IDELEG";"S";"0047";"   205;8;""La date de fin de mandat DS inférieure à la date de début"";"
"IDELEG";"S";"0048";"   206;8;""Date de fin de mandat DS non renseignée"";"
"IDELEG";"S";"0049";"   207;8;""Date de début de mandat DS non renseignée"";"
"IDELEG";"S";"0050";"   208;8;""Pas de mandat délégation DS"";"
"IDELEG";"S";"0051";"   209;8;""Solde délégation DS insuffisant"";"
"IDELEG";"S";"0052";"   210;8;""La date de fin de mandat DFS est inférieure à la date de début"";"
"IDELEG";"S";"0053";"   211;8;""Date de fin de mandat DFS non renseignée"";"
"IDELEG";"S";"0054";"   212;8;""Date de début de mandat DFS non renseignée"";"
"IDELEG";"S";"0055";"   213;8;""Pas de mandat délégation DFS"";"
"IDELEG";"S";"0056";"   214;8;""Solde délégation DFS insuffisant"";"
"IDELEG";"S";"0057";"FINANO"
"IDELEG";"S";"0058";"* Déclaration des donnees locales"
"IDELEG";"S";"0059";"*"
"IDELEG";"S";"0060";"DEF LOCA_MOTDS N1"
"IDELEG";"S";"0061";"LOCA_MOTDS = 0"
"IDELEG";"S";"0062";"DEF LOCA_MOTDFS N1"
"IDELEG";"S";"0063";"LOCA_MOTDFS = 0"
"IDELEG";"S";"0064";"DEF LOCA_ADEDUIRE T6.2"
"IDELEG";"S";"0065";"LOCA_ADEDUIRE = 0"
"IDELEG";"S";"0066";"DEF LOCA_ENTIER N6.2"
"IDELEG";"S";"0067";"LOCA_ENTIER = 0"
"IDELEG";"S";"0068";"DEF LOCA_RESTE N6.2"
"IDELEG";"S";"0069";"LOCA_RESTE = 01"
"IDELEG";"S";"0070";"DEF LOCA_DIV T6.2"
"IDELEG";"S";"0071";"LOCA_DIV = 4"
"IDELEG";"S";"0072";"DEF LOCA_NB N6.2"
"IDELEG";"S";"0073";"LOCA_NB = 0"
"IDELEG";"S";"0074";"**"
"IDELEG";"S";"0075";"** RAZ du nombre annuel de délégation pris"
"IDELEG";"S";"0076";"**"
"IDELEG";"S";"0077";"SI PARD_IDIDDEBANN <> "" """
"IDELEG";"S";"0078";"   SI HJOU_DATE = PARD_IDIDDEBANN"
"IDELEG";"S";"0079";"      HJOU_IJRNBHDELE = 0"
"IDELEG";"S";"0080";"   FINSI"
"IDELEG";"S";"0081";"SINON"
"IDELEG";"S";"0082";"   SI HJOU_DATE(5:4) = ""0101"""
"IDELEG";"S";"0083";"      HJOU_IJRNBHDELE = 0"
"IDELEG";"S";"0084";"   FINSI"
"IDELEG";"S";"0085";"FINSI"
"IDELEG";"S";"0086";"**"
"IDELEG";"S";"0087";"**"
"IDELEG";"S";"0088";"** Raz des compteurs droit/pris si la date de début de délégation est à blanc"
"IDELEG";"S";"0089";"**"
"IDELEG";"S";"0090";"SI HJOU_IJIDATDEDS = "" """
"IDELEG";"S";"0091";"   HJOU_IJRDDELEDS = 0"
"IDELEG";"S";"0092";"   HJOU_IJRCDELEDS = 0"
"IDELEG";"S";"0093";"FINSI"
"IDELEG";"S";"0094";"*"
"IDELEG";"S";"0095";"SI HJOU_IJIDATDDFS = "" """
"IDELEG";"S";"0096";"   HJOU_IJRDDELDFS = 0"
"IDELEG";"S";"0097";"   HJOU_IJRCDELDFS = 0"
"IDELEG";"S";"0098";"FINSI"
"IDELEG";"S";"0099";"*"
"IDELEG";"S";"0100";"** alimentation du droit DS"
"IDELEG";"S";"0101";"** test si le droit est renseigné"
"IDELEG";"S";"0102";"** remise à 0 des compteurs de pris"
"IDELEG";"S";"0103";"SI HJOU_DATE(7:2) = ""01"""
"IDELEG";"S";"0104";"   HJOU_IJRCDELEDS = 0"
"IDELEG";"S";"0105";"   HJOU_IJRCDELDFS = 0"
"IDELEG";"S";"0106";"FINSI"
"IDELEG";"S";"0107";"*********************************************************************************"
"IDELEG";"S";"0108";"** Délégation DS"
"IDELEG";"S";"0109";"*********************************************************************************"
"IDELEG";"S";"0110";"SI HJOU_IJIDDELEDS > 0"
"IDELEG";"S";"0111";"* test si la date de début de mandat est renseignée"
"IDELEG";"S";"0112";"   SI HJOU_IJIDATDEDS <> "" """
"IDELEG";"S";"0113";"      SI HJOU_IJIDATFDDS > HJOU_IJIDATDEDS"
"IDELEG";"S";"0114";"         SI HJOU_DATE(7:2) = ""01"""
"IDELEG";"S";"0115";"         OU HJOU_DATE = HJOU_IJIDATDEDS"
"IDELEG";"S";"0116";"            SI HJOU_DATE >= HJOU_IJIDATDEDS"
"IDELEG";"S";"0117";"               SI HJOU_DATE <= HJOU_IJIDATFDDS"
"IDELEG";"S";"0118";"                  HJOU_IJRDDELEDS = HJOU_IJIDDELEDS"
"IDELEG";"S";"0119";"               SINON"
"IDELEG";"S";"0120";"* la date de fin de mandat est dépassée"
"IDELEG";"S";"0121";"* le compteur est remis à 0"
"IDELEG";"S";"0122";"                  HJOU_IJRDDELEDS = 0"
"IDELEG";"S";"0123";"               FINSI"
"IDELEG";"S";"0124";"            FINSI"
"IDELEG";"S";"0125";"         FINSI"
"IDELEG";"S";"0126";"      SINON"
"IDELEG";"S";"0127";"         SI HJOU_IJIDATFDDS <> "" """
"IDELEG";"S";"0128";"* la date de fin de mandat DS est inférieure à la date de début"
"IDELEG";"S";"0129";"            ANOMALIE 205"
"IDELEG";"S";"0130";"         SINON"
"IDELEG";"S";"0131";"* la date de fin de mandat DS n'est pas renseignée"
"IDELEG";"S";"0132";"            ANOMALIE 206"
"IDELEG";"S";"0133";"         FINSI"
"IDELEG";"S";"0134";"      FINSI"
"IDELEG";"S";"0135";"   SINON"
"IDELEG";"S";"0136";"* la date de début de mandat DS n'est pas renseignée"
"IDELEG";"S";"0137";"      ANOMALIE 207"
"IDELEG";"S";"0138";"   FINSI"
"IDELEG";"S";"0139";"FINSI"
"IDELEG";"S";"0140";"*********************************************************************************"
"IDELEG";"S";"0141";"** Délégation DFS"
"IDELEG";"S";"0142";"*********************************************************************************"
"IDELEG";"S";"0143";"SI HJOU_IJIDDELDFS > 0"
"IDELEG";"S";"0144";"* test si la date de début de mandat est renseignée"
"IDELEG";"S";"0145";"   SI HJOU_IJIDATDDFS <> "" """
"IDELEG";"S";"0146";"      SI HJOU_IJIDATFDFS > HJOU_IJIDATDDFS"
"IDELEG";"S";"0147";"         SI HJOU_DATE(7:2) = ""01"""
"IDELEG";"S";"0148";"         OU HJOU_DATE = HJOU_IJIDATDDFS"
"IDELEG";"S";"0149";"            SI HJOU_DATE >= HJOU_IJIDATDDFS"
"IDELEG";"S";"0150";"               SI HJOU_DATE <= HJOU_IJIDATFDFS"
"IDELEG";"S";"0151";"                  HJOU_IJRDDELDFS = HJOU_IJIDDELDFS"
"IDELEG";"S";"0152";"               SINON"
"IDELEG";"S";"0153";"* la date de fin de mandat est dépassée"
"IDELEG";"S";"0154";"* le compteur est remis à 0"
"IDELEG";"S";"0155";"                  HJOU_IJRDDELDFS = 0"
"IDELEG";"S";"0156";"               FINSI"
"IDELEG";"S";"0157";"            FINSI"
"IDELEG";"S";"0158";"         FINSI"
"IDELEG";"S";"0159";"      SINON"
"IDELEG";"S";"0160";"         SI HJOU_IJIDATFDFS <> "" """
"IDELEG";"S";"0161";"* la date de fin de mandat DFS est inférieure à la date de début"
"IDELEG";"S";"0162";"            ANOMALIE 210"
"IDELEG";"S";"0163";"         SINON"
"IDELEG";"S";"0164";"            ANOMALIE 211"
"IDELEG";"S";"0165";"         FINSI"
"IDELEG";"S";"0166";"      FINSI"
"IDELEG";"S";"0167";"   SINON"
"IDELEG";"S";"0168";"* la date de début de mandat DFS n'est pas renseignée"
"IDELEG";"S";"0169";"      ANOMALIE 212"
"IDELEG";"S";"0170";"   FINSI"
"IDELEG";"S";"0171";"FINSI"
"IDELEG";"S";"0172";"*********************************************************************************"
"IDELEG";"S";"0173";"** alimentation du pris"
"IDELEG";"S";"0174";"*********************************************************************************"
"IDELEG";"S";"0175";"POUR ACTIVITES"
"IDELEG";"S";"0176";"* délégation DS"
"IDELEG";"S";"0177";"   SI HABS_MOTIF = ""DEDS"""
"IDELEG";"S";"0178";"* contrôle si le droit est alimenté"
"IDELEG";"S";"0179";"      SI HJOU_IJRDDELEDS > 0"
"IDELEG";"S";"0180";"         HJOU_IJRCDELEDS = HJOU_IJRCDELEDS + HABS_MOTIDUR"
"IDELEG";"S";"0181";"         LOCA_MOTDS = 1"
"IDELEG";"S";"0182";"      SINON"
"IDELEG";"S";"0183";"* pas de droit"
"IDELEG";"S";"0184";"         ANOMALIE 208"
"IDELEG";"S";"0185";"      FINSI"
"IDELEG";"S";"0186";"   FINSI"
"IDELEG";"S";"0187";"* délégation DFS"
"IDELEG";"S";"0188";"   SI HABS_MOTIF = ""DEDFS"""
"IDELEG";"S";"0189";"* contrôle si le droit est alimenté"
"IDELEG";"S";"0190";"      SI HJOU_IJRDDELDFS > 0"
"IDELEG";"S";"0191";"         HJOU_IJRCDELDFS = HJOU_IJRCDELDFS + HABS_MOTIDUR"
"IDELEG";"S";"0192";"         LOCA_MOTDFS = 1"
"IDELEG";"S";"0193";"      SINON"
"IDELEG";"S";"0194";"* pas de droit"
"IDELEG";"S";"0195";"         ANOMALIE 213"
"IDELEG";"S";"0196";"      FINSI"
"IDELEG";"S";"0197";"   FINSI"
"IDELEG";"S";"0198";"FINPOUR"
"IDELEG";"S";"0199";"**************************************************************************************"
"IDELEG";"S";"0200";"** comptabilisation du nomnbre d'heures motifs délégation"
"IDELEG";"S";"0201";"** pour minoration du nombre de jour travaillés"
"IDELEG";"S";"0202";"** pour les cadre forfait jours"
"IDELEG";"S";"0203";"**************************************************************************************"
"IDELEG";"S";"0204";"SI HJOU_IJICATEGOR = ""03"""
"IDELEG";"S";"0205";"   POUR ACTIVITES"
"IDELEG";"S";"0206";"      SI HABS_MOTIF = ""DEDS"""
"IDELEG";"S";"0207";"      OU HABS_MOTIF = ""DEDFS"""
"IDELEG";"S";"0208";"         HJOU_IJRNBHDELE = HJOU_IJRNBHDELE + HABS_MOTIDUR"
"IDELEG";"S";"0209";"      FINSI"
"IDELEG";"S";"0210";"   FINPOUR"
"IDELEG";"S";"0211";"   SI HJOU_IJRNBHDELE >= 4"
"IDELEG";"S";"0212";"      LOCA_NB = HJOU_IJRNBHDELE / LOCA_DIV"
"IDELEG";"S";"0213";"      LOCA_RESTE = LOCA_NB % 1"
"IDELEG";"S";"0214";"      LOCA_ENTIER = LOCA_NB - LOCA_RESTE"
"IDELEG";"S";"0215";"      LOCA_ADEDUIRE = LOCA_ENTIER * 4"
"IDELEG";"S";"0216";"      HJOU_IJRNBHDELE = HJOU_IJRNBHDELE - LOCA_ADEDUIRE"
"IDELEGCSE";"S";"0547";"* ---------"
"IDELEG";"S";"0217";"** alimentation du compteur de 1/2 journée à deduire dans les jours travaillés"
"IDELEG";"S";"0218";"      TEMP_ITQNBJTRAV = LOCA_ENTIER * 0.5"
"IDELEG";"S";"0219";"   FINSI"
"IDELEG";"S";"0220";"FINSI"
"IDELEG";"S";"0221";"*************************************************************************"
"IDELEG";"S";"0222";"**"
"IDELEG";"S";"0223";"** initialisation du pris par consigne"
"IDELEG";"S";"0224";"*************************************************************************"
"IDELEG";"S";"0225";"POUR ACTIVITES"
"IDELEG";"S";"0226";"   SI HABS_MOTIF = ""XCDEDS"""
"IDELEG";"S";"0227";"      HJOU_IJRCDELEDS = HJOU_IJRCDELEDS + HABS_MOTIDUR"
"IDELEG";"S";"0228";"   FINSI"
"IDELEG";"S";"0229";"   SI HABS_MOTIF = ""ZCDEDS"""
"IDELEG";"S";"0230";"      HJOU_IJRCDELEDS = HABS_MOTIDUR"
"IDELEG";"S";"0231";"   FINSI"
"IDELEG";"S";"0232";"   SI HABS_MOTIF = ""XCDDFS"""
"IDELEG";"S";"0233";"      HJOU_IJRCDELDFS = HJOU_IJRCDELDFS + HABS_MOTIDUR"
"IDELEG";"S";"0234";"   FINSI"
"IDELEG";"S";"0235";"   SI HABS_MOTIF = ""ZCDDFS"""
"IDELEG";"S";"0236";"      HJOU_IJRCDELDFS = HABS_MOTIDUR"
"IDELEG";"S";"0237";"   FINSI"
"IDELEG";"S";"0238";"FINPOUR"
"IDELEG";"S";"0239";"*************************************************************************"
"IDELEG";"S";"0240";"** gestion des soldes"
"IDELEG";"S";"0241";"*************************************************************************"
"IDELEG";"S";"0242";"* DFS"
"IDELEG";"S";"0243";"HJOU_IJRSDELDFS = HJOU_IJRDDELDFS - HJOU_IJRCDELDFS"
"IDELEG";"S";"0244";"SI HJOU_IJRSDELDFS < 0"
"IDELEG";"S";"0245";"   SI LOCA_MOTDFS = 1"
"IDELEG";"S";"0246";"      ANOMALIE 214"
"IDELEG";"S";"0247";"   FINSI"
"IDELEG";"S";"0248";"FINSI"
"IDELEG";"S";"0249";"*"
"IDELEG";"S";"0250";"* DS"
"IDELEG";"S";"0251";"HJOU_IJRSDELEDS = HJOU_IJRDDELEDS - HJOU_IJRCDELEDS"
"IDELEG";"S";"0252";"SI HJOU_IJRSDELEDS < 0"
"IDELEG";"S";"0253";"   SI LOCA_MOTDS = 1"
"IDELEG";"S";"0254";"      ANOMALIE 209"
"IDELEG";"S";"0255";"   FINSI"
"IDELEG";"S";"0256";"FINSI"
"IDELEG";"S";"0257";"FIN"
"IDELEGCSE";"S";"0001";"***********************************************************************"
"IDELEGCSE";"S";"0002";"*"
"IDELEGCSE";"S";"0003";"* Règle : IDELEGCSE"
"IDELEGCSE";"S";"0004";"* Ordre : 3350"
"IDELEGCSE";"S";"0005";"* Titre : Délégations CSE"
"IDELEGCSE";"S";"0006";"*"
"IDELEGCSE";"S";"0007";"*----------------------------------------------------------------------"
"IDELEGCSE";"S";"0008";"*"
"IDELEGCSE";"S";"0009";"* Créé par : Méthodes et outils"
"IDELEGCSE";"S";"0010";"* Date     : 17/07/2018"
"IDELEGCSE";"S";"0011";"* Version  : 1"
"IDELEGCSE";"S";"0012";"*"
"IDELEGCSE";"S";"0013";"*----------------------------------------------------------------------"
"IDELEGCSE";"S";"0014";"*"
"IDELEGCSE";"S";"0015";"*"
"IDELEGCSE";"S";"0016";"* Rôle : Gestion des délégations CSE de date à date sur 12 mois"
"IDELEGCSE";"S";"0017";"*"
"IDELEGCSE";"S";"0018";"*"
"IDELEGCSE";"S";"0019";"*"
"IDELEGCSE";"S";"0020";"*----------------------------------------------------------------------"
"IDELEGCSE";"S";"0021";"*"
"IDELEGCSE";"S";"0022";"* Modifiée par : Méthodes et outils"
"IDELEGCSE";"S";"0023";"* Date         : 27/05/2019"
"IDELEGCSE";"S";"0024";"* Objet        : Ajout du taux de majoration maxi dans PARD afin"
"IDELEGCSE";"S";"0025";"*                 qu'il soit paramétrable"
"IDELEGCSE";"S";"0026";"*"
"IDELEGCSE";"S";"0027";"***********************************************************************"
"IDELEGCSE";"S";"0028";"*"
"IDELEGCSE";"S";"0029";"* Implémentation des données industrielles"
"IDELEGCSE";"S";"0030";"*"
"IDELEGCSE";"S";"0031";"DEBDICO"
"IDELEGCSE";"S";"0032";"   HJOU_IJIDFIN;O;D10;X;;;   456789;;;C2;""Fin de mandat délégation"";"
"IDELEGCSE";"S";"0033";"   HJOU_IJRADCSE;N;T6,2;L;;;   456789;;IJRADCSE;V3;""Droit annuel réel (H)"";"
"IDELEGCSE";"S";"0034";"   HJOU_IJIDACSET;O;T6,2;L;;;   456789;;;C3;""Droit annuel théorique (H)"";"
"IDELEGCSE";"S";"0035";"   HJOU_IJIDACSEM;O;T6,2;L;;;   456789;;;C3;""Droit annuel mandat theo (H)"";"
"IDELEGCSE";"S";"0036";"   HJOU_IJRAPCSE;N;T6,2;L;;;   456789;;IJRAPCSE;V3;""Pris annuel (H)"";"
"IDELEGCSE";"S";"0037";"   HJOU_IJRATCSE;N;T6,2;L;;;   456789;;IJRATCSE;V3;""Transfert annuel (H)"";"
"IDELEGCSE";"S";"0038";"   HJOU_IJRASCSE;N;T6,2;L;;;   456789;;IJRASCSE;V3;""Solde annuel (H)"";"
"IDELEGCSE";"S";"0039";"   HJOU_IJRMDCSE;N;T6,2;I;;;   456789;;IJRMDCSE;V3;""Droit mensuel (H)"";"
"IDELEGCSE";"S";"0040";"   HJOU_IJRMPCSE;N;T6,2;I;;;   456789;;IJRMPCSE;V3;""Pris mensuel (H)"";"
"IDELEGCSE";"S";"0041";"   HJOU_IJRMTCSE;N;T6,2;I;;;   456789;;IJRMTCSE;V3;""Transfert mensuel (H)"";"
"IDELEGCSE";"S";"0042";"   HJOU_IJRMSCSE;N;T6,2;I;;;   456789;;IJRMSCSE;V3;""Solde mensuel (H)"";"
"IDELEGCSE";"S";"0043";"   HJOU_IJRADCSEF;N;N6,2;I;;;   456789;;IJRADCSEF;V3;""Droit CSE (forfait jour)"";"
"IDELEGCSE";"S";"0044";"   HJOU_IJRAPCSEF;N;N6,2;I;;;   456789;;IJRAPCSEF;V3;""Pris CSE (forfait jour)"";"
"IDELEGCSE";"S";"0045";"   HJOU_IJRATCSEF;N;N6,2;I;;;   456789;;IJRATCSEF;V3;""Transfert CSE (forfait jour)"";"
"IDELEGCSE";"S";"0046";"   HJOU_IJRASCSEF;N;N6,2;I;;;   456789;;IJRASCSEF;V3;""Solde CSE (forfait jour)"";"
"IDELEGCSE";"S";"0047";"   MOTI_IMIMATRICS;O;A10;X;;;   456789;IH;;C2;""Matricule à créditer CSE"";"
"IDELEGCSE";"S";"0048";"   EMPL_IEQSDELCSE;N;T6,2;L;;;     6789;;;V3;""Solde délégation CSE"";"
"IDELEGCSE";"S";"0049";"   HORC_IHINFORFJ;O;Z1;X;0;1;123456789;C;;C2;""Forfait jour CSE"";"
"IDELEGCSE";"S";"0050";"   PARD_IDIMAJOCSE;O;N3,1;I;0;;123456789;;;C3;""Taux de majoration maxi droit CSE"";"
"IDELEGCSE";"S";"0051";"   EMPL_IEIMEMBCSE;O;A1;X;;;123456789;L8;;C3;""Membre CSE"";"
"IDELEGCSE";"S";"0052";"FINDICO"
"IDELEGCSE";"S";"0053";"*"
"IDELEGCSE";"S";"0054";"DEBANO"
"IDELEGCSE";"S";"0055";"   215;7;""Solde mensuel délégation CSE négatif"";"
"IDELEGCSE";"S";"0056";"   216;7;""Dépassement du droit maximum CSE mensuel"";"
"IDELEGCSE";"S";"0057";"   217;7;""Solde annuel délégation CSE négatif"";"
"IDELEGCSE";"S";"0058";"   218;7;""Dépassement du droit maximum CSE annuel"";"
"IDELEGCSE";"S";"0059";"   219;7;""La valeur du CSE transféré doit être un multiple de 4"";"
"IDELEGCSE";"S";"0060";"   220;7;""Le transfert doit se faire vers un matricule différent de celui du donateur"";"
"IDELEGCSE";"S";"0061";"   221;7;""Valorisation en heures interdite aux forfaits jour"";"
"IDELEGCSE";"S";"0062";"   401;7;""Dépassement des droits maxi mensuel"";"
"IDELEGCSE";"S";"0063";"FINANO"
"IDELEGCSE";"S";"0064";"* --------------------------"
"IDELEGCSE";"S";"0065";"* Principe de fonctionnement"
"IDELEGCSE";"S";"0066";"* --------------------------"
"IDELEGCSE";"S";"0067";"* Le droit annuel théorique et la date de fin de mandat sont saisis via une affectation"
"IDELEGCSE";"S";"0068";"* Un modèle d'affectation est créé à cette fin"
"IDELEGCSE";"S";"0069";"* Il n'y a pas d'indicateur de début de mandat : Le  fait que la date de fin de mandat"
"IDELEGCSE";"S";"0070";"* soit renseignée en fait office, et déclenche les calculs."
"IDELEGCSE";"S";"0071";"* Le droit mensuel est calculé au 01 de chaque mois, à raison de 1/12ème du droit annuel théorique"
"IDELEGCSE";"S";"0072";"* et dans la limite de 1,5 fois ce droit pour les forfaits heure. * En cas de mandat débutant"
"IDELEGCSE";"S";"0073";"* en cours de mois, le droit de ce mois est à renseigner manuellement par consigne."
"IDELEGCSE";"S";"0074";"* Pour les forfaits jours, le droit est annuel et ne peut être majoré (à gérer par consigne)."
"IDELEGCSE";"S";"0075";"* Un délégué peut dépasser le 1/12ème en en faisant la demande via le self, et dans la limite de 1,5"
"IDELEGCSE";"S";"0076";"* fois le montant de ce 1/12ème. Cette demande n'est pas soumise à validation, et n'est pas"
"IDELEGCSE";"S";"0077";"* supprimable une fois passée."
"IDELEGCSE";"S";"0078";"* Des transferts de droits sont possibles d'un délégué à un autre et sont traités manuellement"
"IDELEGCSE";"S";"0079";"* par les gestionnaires, l'état CMITRFCSE permettant de ressortir les consignes de transfert,"
"IDELEGCSE";"S";"0080";"* et leur correspondance chez le destinataire du don."
"IDELEGCSE";"S";"0081";"* le benéficiare d'un transfert d'heure ne peut depassé 1,5 fois le 12ième du theorique annuel"
"IDELEGCSE";"S";"0082";"*--------------------"
"IDELEGCSE";"S";"0083";"* Consignes et motifs"
"IDELEGCSE";"S";"0084";"* -------------------"
"IDELEGCSE";"S";"0085";"* Le motif DECSE est utilisé pour la pose de délégation"
"IDELEGCSE";"S";"0086";"* Les consignes ZDCSE et XDCSE impactent HJOU_IJRMDCSE (Droit mensuel) pour les forfaits heures"
"IDELEGCSE";"S";"0087";"*                                        HJOU_IJRADCSEF pour les forfaits jour"
"IDELEGCSE";"S";"0088";"* Les consignes ZPCSE et XPCSE impactent HJOU_IJRMPCSE (Pris mensuel) pour les forfaits heures"
"IDELEGCSE";"S";"0089";"*                                        HJOU_IJRAPCSEF pour les forfaits jour"
"IDELEGCSE";"S";"0090";"* Les consignes ZTCSE et XTCSE impactent HJOU_IJRMTCSE (Transfert mensuel) pour les forfaits heures"
"IDELEGCSE";"S";"0091";"*                                        HJOU_IJRATCSEF pour les forfaits jour"
"IDELEGCSE";"S";"0092";"* Les consignes ayant un matricule renseigné dans le MOTI_IMIMATRICS impactent le matricule émetteur"
"IDELEGCSE";"S";"0093";"* sur les compteurs                      HJOU_IJRMTCSE (Transfert mensuel) pour les forfaits heures"
"IDELEGCSE";"S";"0094";"*                                        HJOU_IJRATCSEF pour les forfaits jour"
"IDELEGCSE";"S";"0095";"* -------------------------------"
"IDELEGCSE";"S";"0096";"* Déclaration des donnees locales"
"IDELEGCSE";"S";"0097";"* -------------------------------"
"IDELEGCSE";"S";"0098";"DEF LOCA_DTMAX T6.2"
"IDELEGCSE";"S";"0099";"LOCA_DTMAX = 0"
"IDELEGCSE";"S";"0100";"* maximum mensuel (par défaut 1,5 fois le 12ième ANNUEL)"
"IDELEGCSE";"S";"0101";"DEF LOCA_MAXM T8.2"
"IDELEGCSE";"S";"0102";"LOCA_MAXM = HJOU_IJIDACSEM / 12"
"IDELEGCSE";"S";"0103";"LOCA_MAXM = LOCA_MAXM * PARD_IDIMAJOCSE"
"IDELEGCSE";"S";"0104";"* droit et transfert"
"IDELEGCSE";"S";"0105";"DEF LOCA_DRTR T8.2"
"IDELEGCSE";"S";"0106";"LOCA_DRTR = 0"
"IDELEGCSE";"S";"0107";"* droit et pris"
"IDELEGCSE";"S";"0108";"DEF LOCA_DRPR T8.2"
"IDELEGCSE";"S";"0109";"LOCA_DRPR = 0"
"IDELEGCSE";"S";"0110";"* --------------------------------------------------------------------------------"
"IDELEGCSE";"S";"0111";"* Locale permettant de déterminer s'il y a une consigne impactant le droit mensuel"
"IDELEGCSE";"S";"0112";"* --------------------------------------------------------------------------------"
"IDELEGCSE";"S";"0113";"DEF LOCA_MENS N1"
"IDELEGCSE";"S";"0114";"LOCA_MENS = 0"
"IDELEGCSE";"S";"0115";"DEF LOCA_MENS2 N1"
"IDELEGCSE";"S";"0116";"LOCA_MENS2 = 0"
"IDELEGCSE";"S";"0117";"DEF LOCA_MAJO N1"
"IDELEGCSE";"S";"0118";"LOCA_MAJO = 0"
"IDELEGCSE";"S";"0119";"* -------------------------------------------------------------"
"IDELEGCSE";"S";"0120";"* Locale permettant de calculer le droit pour les forfaits jour"
"IDELEGCSE";"S";"0121";"* -------------------------------------------------------------"
"IDELEGCSE";"S";"0122";"DEF LOCA_MAJD T6.2"
"IDELEGCSE";"S";"0123";"LOCA_MAJD = 0"
"IDELEGCSE";"S";"0124";"* --------------------------------------------------------------------------------"
"IDELEGCSE";"S";"0125";"* Locale permettant de calculer le nbre de jours transférés pour les forfaits jour"
"IDELEGCSE";"S";"0126";"* --------------------------------------------------------------------------------"
"IDELEGCSE";"S";"0127";"DEF LOCA_MAJT T6.2"
"IDELEGCSE";"S";"0128";"LOCA_MAJT = 0"
"IDELEGCSE";"S";"0129";"DEF LOCA_DATE D"
"IDELEGCSE";"S";"0130";"LOCA_DATE = "" """
"IDELEGCSE";"S";"0131";"DEF LOCA_ACOURS N4"
"IDELEGCSE";"S";"0132";"LOCA_ACOURS = 0"
"IDELEGCSE";"S";"0133";"DEF LOCA_DATEFIN D"
"IDELEGCSE";"S";"0134";"LOCA_DATEFIN = "" """
"IDELEGCSE";"S";"0135";"DEF LOCA_DROIT N7.3"
"IDELEGCSE";"S";"0136";"LOCA_DROIT = 0"
"IDELEGCSE";"S";"0137";"DEF LOCA_MAT A10"
"IDELEGCSE";"S";"0138";"LOCA_MAT = "" """
"IDELEGCSE";"S";"0139";"DEF LOCA_VALO A1"
"IDELEGCSE";"S";"0140";"LOCA_VALO = "" """
"IDELEGCSE";"S";"0141";"* ----------------------------------------------------"
"IDELEGCSE";"S";"0142";"* Coefficient appliqué pour le calcul de la majoration"
"IDELEGCSE";"S";"0143";"* ----------------------------------------------------"
"IDELEGCSE";"S";"0144";"DEF LOCA_TAUX N4.1"
"IDELEGCSE";"S";"0145";"LOCA_TAUX = PARD_IDIMAJOCSE"
"IDELEGCSE";"S";"0146";"DEF LOCA_DIV T6.2"
"IDELEGCSE";"S";"0147";"LOCA_DIV = 1.00"
"IDELEGCSE";"S";"0148";"DEF LOCA_RESTE N7.3"
"IDELEGCSE";"S";"0149";"LOCA_RESTE = 0"
"IDELEGCSE";"S";"0150";"DEF LOCA_MOINS1 N2"
"IDELEGCSE";"S";"0151";"LOCA_MOINS1 = -1"
"IDELEGCSE";"S";"0152";"*CSE en jour"
"IDELEGCSE";"S";"0153";"DEF LOCA_MENSJ N1"
"IDELEGCSE";"S";"0154";"LOCA_MENSJ = 0"
"IDELEGCSE";"S";"0155";"* --------------------------------"
"IDELEGCSE";"S";"0156";"* Calcul de la date prévisionnelle"
"IDELEGCSE";"S";"0157";"* --------------------------------"
"IDELEGCSE";"S";"0158";"LOCA_DATE(5:4) = HJOU_IJIDFIN(5:4)"
"IDELEGCSE";"S";"0159";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IDELEGCSE";"S";"0160";"SI TEMP_DATJOU(5:4) > HJOU_IJIDFIN(5:4)"
"IDELEGCSE";"S";"0161";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"IDELEGCSE";"S";"0162";"FINSI"
"IDELEGCSE";"S";"0163";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDELEGCSE";"S";"0164";"*"
"IDELEGCSE";"S";"0165";"SI HJOU_DATE <= HJOU_IJIDFIN"
"IDELEGCSE";"S";"0166";"* ---------------------------------------"
"IDELEGCSE";"S";"0167";"* Remise à 0 des compteurs de CSE Annuels"
"IDELEGCSE";"S";"0168";"* ---------------------------------------"
"IDELEGCSE";"S";"0169";"* --------------------------------------------------"
"IDELEGCSE";"S";"0170";"* En fonction du mode de gestion : date anniversaire"
"IDELEGCSE";"S";"0171";"* --------------------------------------------------"
"IDELEGCSE";"S";"0172";"   LIREVALPRE LOCA_DATEFIN HJOU_DATE"
"IDELEGCSE";"S";"0173";"   *************************************************"
"IDELEGCSE";"S";"0174";"   *************************************************"
"IDELEGCSE";"S";"0175";"   * En cas d'ancienne version où le LIREVALPRE ne"
"IDELEGCSE";"S";"0176";"   * fonctionne pas (Nouveautés 5.2.0)"
"IDELEGCSE";"S";"0177";"   * Utiliser le réglementaire suivant :"
"IDELEGCSE";"S";"0178";"   *"
"IDELEGCSE";"S";"0179";"   * DATAJT HJOU_DATE 12 ""J"" -1"
"IDELEGCSE";"S";"0180";"   * LOCA_DATEFIN = TEMP_DXFINPER"
"IDELEGCSE";"S";"0181";"   *************************************************"
"IDELEGCSE";"S";"0182";"   *************************************************"
"IDELEGCSE";"S";"0183";"   SI LOCA_DATEFIN(5:4) = HJOU_IJIDFIN(5:4)"
"IDELEGCSE";"S";"0184";"      FAIRE RAZCSE"
"IDELEGCSE";"S";"0185";"   FINSI"
"IDELEGCSE";"S";"0186";"* --------------"
"IDELEGCSE";"S";"0187";"* Forfait heures"
"IDELEGCSE";"S";"0188";"* --------------"
"IDELEGCSE";"S";"0189";"   SI HORC_IHINFORFJ <> ""1"""
"IDELEGCSE";"S";"0190";"* -------------------------------------------------------------------------------"
"IDELEGCSE";"S";"0191";"* Initialisation du droit et remise à 0 des compteurs pris et transférés mensuels"
"IDELEGCSE";"S";"0192";"* -------------------------------------------------------------------------------"
"IDELEGCSE";"S";"0193";"      SI HJOU_DATE(7:2) = ""01"""
"IDELEGCSE";"S";"0194";"         HJOU_IJRMDCSE = HJOU_IJIDACSET / 12"
"IDELEGCSE";"S";"0195";"* -------------------------------------------"
"IDELEGCSE";"S";"0196";"* Consigne de majoration mensuelle des droits"
"IDELEGCSE";"S";"0197";"* -------------------------------------------"
"IDELEGCSE";"S";"0198";"         POUR ACTIVITES"
"IDELEGCSE";"S";"0199";"            SI HABS_MOTIF = ""ZMACSE"""
"IDELEGCSE";"S";"0200";"               LOCA_MAJO = 1"
"IDELEGCSE";"S";"0201";"            FINSI"
"IDELEGCSE";"S";"0202";"         FINPOUR"
"IDELEGCSE";"S";"0203";"         SI LOCA_MAJO = 1"
"IDELEGCSE";"S";"0204";"            HJOU_IJRMDCSE = HJOU_IJRMDCSE * LOCA_TAUX"
"IDELEGCSE";"S";"0205";"         FINSI"
"IDELEGCSE";"S";"0206";"         HJOU_IJRADCSE = HJOU_IJRADCSE + HJOU_IJRMDCSE"
"IDELEGCSE";"S";"0207";"         HJOU_IJRMPCSE = 0"
"IDELEGCSE";"S";"0208";"         HJOU_IJRMTCSE = 0"
"IDELEGCSE";"S";"0209";"      FINSI"
"IDELEGCSE";"S";"0210";"* ------------------"
"IDELEGCSE";"S";"0211";"* Analyse des motifs"
"IDELEGCSE";"S";"0212";"* ------------------"
"IDELEGCSE";"S";"0213";"      POUR ACTIVITES"
"IDELEGCSE";"S";"0214";"         SI HABS_MOTIF = ""DECSE"""
"IDELEGCSE";"S";"0215";"         OU HABS_MOTIF = ""DECSEB"""
"IDELEGCSE";"S";"0216";"            HJOU_IJRMPCSE = HJOU_IJRMPCSE + HABS_MOTIDUR"
"IDELEGCSE";"S";"0217";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + HABS_MOTIDUR"
"IDELEGCSE";"S";"0218";"         FINSI"
"IDELEGCSE";"S";"0219";"* -----------------"
"IDELEGCSE";"S";"0220";"* Droit CSE mensuel"
"IDELEGCSE";"S";"0221";"* -----------------"
"IDELEGCSE";"S";"0222";"         SI HABS_MOTIF = ""ZDCSE"""
"IDELEGCSE";"S";"0223";"            LOCA_MENS = 1"
"IDELEGCSE";"S";"0224";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMDCSE"
"IDELEGCSE";"S";"0225";"            HJOU_IJRMDCSE = HABS_MOTIDUR"
"IDELEGCSE";"S";"0226";"            HJOU_IJRADCSE = HJOU_IJRADCSE + LOCA_MAJD"
"IDELEGCSE";"S";"0227";"         FINSI"
"IDELEGCSE";"S";"0228";"         SI HABS_MOTIF = ""XDCSE"""
"IDELEGCSE";"S";"0229";"            LOCA_MENS = 1"
"IDELEGCSE";"S";"0230";"            HJOU_IJRMDCSE = HJOU_IJRMDCSE + HABS_MOTIDUR"
"IDELEGCSE";"S";"0231";"            HJOU_IJRADCSE = HJOU_IJRADCSE + HABS_MOTIDUR"
"IDELEGCSE";"S";"0232";"         FINSI"
"IDELEGCSE";"S";"0233";"* ----------------"
"IDELEGCSE";"S";"0234";"* Pris CSE mensuel"
"IDELEGCSE";"S";"0235";"* ----------------"
"IDELEGCSE";"S";"0236";"         SI HABS_MOTIF = ""ZPCSE"""
"IDELEGCSE";"S";"0237";"            LOCA_MENS = 1"
"IDELEGCSE";"S";"0238";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMPCSE"
"IDELEGCSE";"S";"0239";"            HJOU_IJRMPCSE = HABS_MOTIDUR"
"IDELEGCSE";"S";"0240";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + LOCA_MAJD"
"IDELEGCSE";"S";"0241";"         FINSI"
"IDELEGCSE";"S";"0242";"         SI HABS_MOTIF = ""XPCSE"""
"IDELEGCSE";"S";"0243";"            LOCA_MENS = 1"
"IDELEGCSE";"S";"0244";"            HJOU_IJRMPCSE = HJOU_IJRMPCSE + HABS_MOTIDUR"
"IDELEGCSE";"S";"0245";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + HABS_MOTIDUR"
"IDELEGCSE";"S";"0246";"         FINSI"
"IDELEGCSE";"S";"0247";"* ----------------"
"IDELEGCSE";"S";"0248";"* Transfert CSE mensuel"
"IDELEGCSE";"S";"0249";"* ----------------"
"IDELEGCSE";"S";"0250";"         SI HABS_MOTIF = ""ZTCSE"""
"IDELEGCSE";"S";"0251";"            LOCA_MENS2 = 1"
"IDELEGCSE";"S";"0252";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMTCSE"
"IDELEGCSE";"S";"0253";"            HJOU_IJRMTCSE = HABS_MOTIDUR"
"IDELEGCSE";"S";"0254";"            HJOU_IJRATCSE = HJOU_IJRATCSE + LOCA_MAJD"
"IDELEGCSE";"S";"0255";"         FINSI"
"IDELEGCSE";"S";"0256";"         SI HABS_MOTIF = ""XTCSE"""
"IDELEGCSE";"S";"0257";"            LOCA_MENS2 = 1"
"IDELEGCSE";"S";"0258";"            HJOU_IJRMTCSE = HJOU_IJRMTCSE + HABS_MOTIDUR"
"IDELEGCSE";"S";"0259";"            HJOU_IJRATCSE = HJOU_IJRATCSE + HABS_MOTIDUR"
"IDELEGCSE";"S";"0260";"         FINSI"
"IDELEGCSE";"S";"0261";"* -----------------------------"
"IDELEGCSE";"S";"0262";"* Motif de demande de transfert"
"IDELEGCSE";"S";"0263";"* -----------------------------"
"IDELEGCSE";"S";"0264";"         SI HABS_MOTYPE = ""C"""
"IDELEGCSE";"S";"0265";"            SI MOTI_IMIMATRICS <> "" """
"IDELEGCSE";"S";"0266";"               HJOU_IJRMTCSE = HJOU_IJRMTCSE - HABS_MOTIDUR"
"IDELEGCSE";"S";"0267";"               HJOU_IJRATCSE = HJOU_IJRATCSE - HABS_MOTIDUR"
"IDELEGCSE";"S";"0268";"               SI MOTI_IMIMATRICS = HJOU_MATRI"
"IDELEGCSE";"S";"0269";"                  ANOMALIE 220"
"IDELEGCSE";"S";"0270";"               FINSI"
"IDELEGCSE";"S";"0271";"            FINSI"
"IDELEGCSE";"S";"0272";"         FINSI"
"IDELEGCSE";"S";"0273";"      FINPOUR"
"IDELEGCSE";"S";"0274";"* ----------------------"
"IDELEGCSE";"S";"0275";"* Mise à jour des soldes"
"IDELEGCSE";"S";"0276";"* ----------------------"
"IDELEGCSE";"S";"0277";"      HJOU_IJRMSCSE = HJOU_IJRMDCSE - HJOU_IJRMPCSE"
"IDELEGCSE";"S";"0278";"      HJOU_IJRMSCSE = HJOU_IJRMSCSE + HJOU_IJRMTCSE"
"IDELEGCSE";"S";"0279";"      HJOU_IJRASCSE = HJOU_IJRADCSE - HJOU_IJRAPCSE"
"IDELEGCSE";"S";"0280";"      HJOU_IJRASCSE = HJOU_IJRASCSE + HJOU_IJRATCSE"
"IDELEGCSE";"S";"0281";"* ----------------------------------------"
"IDELEGCSE";"S";"0282";"* Gestion des anomalies"
"IDELEGCSE";"S";"0283";"* ----------------------------------------"
"IDELEGCSE";"S";"0284";"* Solde négatif"
"IDELEGCSE";"S";"0285";"      SI HJOU_IJRMSCSE < 0"
"IDELEGCSE";"S";"0286";"         ANOMALIE 215"
"IDELEGCSE";"S";"0287";"      FINSI"
"IDELEGCSE";"S";"0288";"*"
"IDELEGCSE";"S";"0289";"      DEF CPTG_SOLDECSEM T6.2"
"IDELEGCSE";"S";"0290";"      PERGLISS CPTG_SOLDECSEM ""031J01"""
"IDELEGCSE";"S";"0291";"      SI HJOU_IJRMSCSE < 0"
"IDELEGCSE";"S";"0292";"         TEMP_CNRETOUR = 2"
"IDELEGCSE";"S";"0293";"         TEMP_CNMESS = 215"
"IDELEGCSE";"S";"0294";"      FINSI"
"IDELEGCSE";"S";"0295";"* depassement du CSE annuel"
"IDELEGCSE";"S";"0296";"      LOCA_DTMAX = HJOU_IJIDACSEM * LOCA_TAUX"
"IDELEGCSE";"S";"0297";"      SI HJOU_DATE(7:2) = ""01"""
"IDELEGCSE";"S";"0298";"         SI HJOU_IJRADCSE > LOCA_DTMAX"
"IDELEGCSE";"S";"0299";"            ANOMALIE 218"
"IDELEGCSE";"S";"0300";"         FINSI"
"IDELEGCSE";"S";"0301";"      FINSI"
"IDELEGCSE";"S";"0302";"      LOCA_DTMAX = LOCA_DTMAX / 12"
"IDELEGCSE";"S";"0303";"* --------------------------------------------------------------------------"
"IDELEGCSE";"S";"0304";"* LOCA_MENS : on affiche l'anomalie que s'il y a une consigne sur la journée"
"IDELEGCSE";"S";"0305";"* --------------------------------------------------------------------------"
"IDELEGCSE";"S";"0306";"      SI LOCA_MENS = 1"
"IDELEGCSE";"S";"0307";"         LOCA_DRPR = HJOU_IJRMDCSE - HJOU_IJRMPCSE"
"IDELEGCSE";"S";"0308";"         SI HJOU_IJRMDCSE > LOCA_DTMAX"
"IDELEGCSE";"S";"0309";"         OU LOCA_DRPR > LOCA_DTMAX"
"IDELEGCSE";"S";"0310";"            ANOMALIE 216"
"IDELEGCSE";"S";"0311";"         FINSI"
"IDELEGCSE";"S";"0312";"      FINSI"
"IDELEGCSE";"S";"0313";"   SINON"
"IDELEGCSE";"S";"0314";"* ------------"
"IDELEGCSE";"S";"0315";"* Forfait jour"
"IDELEGCSE";"S";"0316";"* ------------"
"IDELEGCSE";"S";"0317";"* -----------------------"
"IDELEGCSE";"S";"0318";"* Initialisation du droit : calcul du nombre de jours pour les forfaits jour."
"IDELEGCSE";"S";"0319";"* -----------------------"
"IDELEGCSE";"S";"0320";"      SI HJOU_IJRADCSEF = 0"
"IDELEGCSE";"S";"0321";"         SI HJOU_IJIDACSET > 0"
"IDELEGCSE";"S";"0322";"* ---------------------------------"
"IDELEGCSE";"S";"0323";"* Arrondi du droit au 0.5 supérieur"
"IDELEGCSE";"S";"0324";"* ---------------------------------"
"IDELEGCSE";"S";"0325";"            LOCA_DROIT = HJOU_IJIDACSET / LOCA_DIV"
"IDELEGCSE";"S";"0326";"            FAIRE CALCFJ"
"IDELEGCSE";"S";"0327";"            HJOU_IJRADCSEF = LOCA_DROIT"
"IDELEGCSE";"S";"0328";"            LOCA_DROIT = 0"
"IDELEGCSE";"S";"0329";"         FINSI"
"IDELEGCSE";"S";"0330";"      FINSI"
"IDELEGCSE";"S";"0331";"* -------------------"
"IDELEGCSE";"S";"0332";"* Motifs et activités"
"IDELEGCSE";"S";"0333";"* -------------------"
"IDELEGCSE";"S";"0334";"      POUR ACTIVITES"
"IDELEGCSE";"S";"0335";"         SI HABS_MOTIF = ""DECSE"""
"IDELEGCSE";"S";"0336";"         OU HABS_MOTIF = ""DECSEB"""
"IDELEGCSE";"S";"0337";"            SI HABS_VALORIS = ""J"""
"IDELEGCSE";"S";"0338";"               HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 1"
"IDELEGCSE";"S";"0339";"            SINON"
"IDELEGCSE";"S";"0340";"               SI HABS_VALORIS = ""A"""
"IDELEGCSE";"S";"0341";"               OU HABS_VALORIS = ""M"""
"IDELEGCSE";"S";"0342";"                  HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 0.5"
"IDELEGCSE";"S";"0343";"               SINON"
"IDELEGCSE";"S";"0344";"                  ANOMALIE 221"
"IDELEGCSE";"S";"0345";"                  SI HABS_MOTIDUR > 4"
"IDELEGCSE";"S";"0346";"                     HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 1"
"IDELEGCSE";"S";"0347";"                  SINON"
"IDELEGCSE";"S";"0348";"                     HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 0.5"
"IDELEGCSE";"S";"0349";"                  FINSI"
"IDELEGCSE";"S";"0350";"               FINSI"
"IDELEGCSE";"S";"0351";"            FINSI"
"IDELEGCSE";"S";"0352";"         FINSI"
"IDELEGCSE";"S";"0353";"* -----------------"
"IDELEGCSE";"S";"0354";"* Droit CSE mensuel"
"IDELEGCSE";"S";"0355";"* -----------------"
"IDELEGCSE";"S";"0356";"         SI HABS_MOTIF = ""ZDCSE"""
"IDELEGCSE";"S";"0357";"            LOCA_MENSJ = 1"
"IDELEGCSE";"S";"0358";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSE";"S";"0359";"            FAIRE CALCFJ"
"IDELEGCSE";"S";"0360";"            HJOU_IJRADCSEF = LOCA_DROIT"
"IDELEGCSE";"S";"0361";"            LOCA_DROIT = 0"
"IDELEGCSE";"S";"0362";"         FINSI"
"IDELEGCSE";"S";"0363";"         SI HABS_MOTIF = ""XDCSE"""
"IDELEGCSE";"S";"0364";"            LOCA_MENSJ = 1"
"IDELEGCSE";"S";"0365";"            LOCA_MAJD = LOCA_MAJD + HABS_MOTIDUR"
"IDELEGCSE";"S";"0366";"         FINSI"
"IDELEGCSE";"S";"0367";"* ----------------"
"IDELEGCSE";"S";"0368";"* Pris CSE mensuel"
"IDELEGCSE";"S";"0369";"* ----------------"
"IDELEGCSE";"S";"0370";"         SI HABS_MOTIF = ""ZPCSE"""
"IDELEGCSE";"S";"0371";"            LOCA_MENSJ = 1"
"IDELEGCSE";"S";"0372";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSE";"S";"0373";"            FAIRE CALCFJ"
"IDELEGCSE";"S";"0374";"            HJOU_IJRAPCSEF = LOCA_DROIT"
"IDELEGCSE";"S";"0375";"         FINSI"
"IDELEGCSE";"S";"0376";"         SI HABS_MOTIF = ""XPCSE"""
"IDELEGCSE";"S";"0377";"            LOCA_MENSJ = 1"
"IDELEGCSE";"S";"0378";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSE";"S";"0379";"            FAIRE CALCFJ"
"IDELEGCSE";"S";"0380";"            HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + LOCA_DROIT"
"IDELEGCSE";"S";"0381";"         FINSI"
"IDELEGCSE";"S";"0382";"* ----------------"
"IDELEGCSE";"S";"0383";"* Transfert CSE mensuel"
"IDELEGCSE";"S";"0384";"* ----------------"
"IDELEGCSE";"S";"0385";"         SI HABS_MOTIF = ""ZTCSE"""
"IDELEGCSE";"S";"0386";"            LOCA_MENSJ = 1"
"IDELEGCSE";"S";"0387";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSE";"S";"0388";"            FAIRE CALCFJ"
"IDELEGCSE";"S";"0389";"            HJOU_IJRATCSEF = LOCA_DROIT"
"IDELEGCSE";"S";"0390";"         FINSI"
"IDELEGCSE";"S";"0391";"         SI HABS_MOTIF = ""XTCSE"""
"IDELEGCSE";"S";"0392";"            LOCA_MENSJ = 1"
"IDELEGCSE";"S";"0393";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSE";"S";"0394";"            FAIRE CALCFJ"
"IDELEGCSE";"S";"0395";"            HJOU_IJRATCSEF = HJOU_IJRATCSEF + LOCA_DROIT"
"IDELEGCSE";"S";"0396";"         FINSI"
"IDELEGCSE";"S";"0397";"* -----------------------------"
"IDELEGCSE";"S";"0398";"* Motif de demande de transfert"
"IDELEGCSE";"S";"0399";"* -----------------------------"
"IDELEGCSE";"S";"0400";"         SI HABS_MOTYPE = ""C"""
"IDELEGCSE";"S";"0401";"            SI MOTI_IMIMATRICS <> "" """
"IDELEGCSE";"S";"0402";"               LOCA_MAJT = LOCA_MAJT - HABS_MOTIDUR"
"IDELEGCSE";"S";"0403";"               SI MOTI_IMIMATRICS = HJOU_MATRI"
"IDELEGCSE";"S";"0404";"                  ANOMALIE 220"
"IDELEGCSE";"S";"0405";"               FINSI"
"IDELEGCSE";"S";"0406";"            FINSI"
"IDELEGCSE";"S";"0407";"         FINSI"
"IDELEGCSE";"S";"0408";"      FINPOUR"
"IDELEGCSE";"S";"0409";"* ----------------------------"
"IDELEGCSE";"S";"0410";"* Cumul des XDCSE sur le droit"
"IDELEGCSE";"S";"0411";"* ----------------------------"
"IDELEGCSE";"S";"0412";"      LOCA_DROIT = LOCA_MAJD / LOCA_DIV"
"IDELEGCSE";"S";"0413";"      SI LOCA_DROIT <> 0"
"IDELEGCSE";"S";"0414";"         FAIRE CALCFJ"
"IDELEGCSE";"S";"0415";"         HJOU_IJRADCSEF = HJOU_IJRADCSEF + LOCA_DROIT"
"IDELEGCSE";"S";"0416";"      FINSI"
"IDELEGCSE";"S";"0417";"      LOCA_MAJD = 0"
"IDELEGCSE";"S";"0418";"* --------------------"
"IDELEGCSE";"S";"0419";"* Cumul des transferts"
"IDELEGCSE";"S";"0420";"* --------------------"
"IDELEGCSE";"S";"0421";"      LOCA_DROIT = LOCA_MAJT / LOCA_DIV"
"IDELEGCSE";"S";"0422";"* En cas de droit négatif"
"IDELEGCSE";"S";"0423";"      SI LOCA_DROIT < 0"
"IDELEGCSE";"S";"0424";"         LOCA_DROIT = LOCA_DROIT * LOCA_MOINS1"
"IDELEGCSE";"S";"0425";"      FINSI"
"IDELEGCSE";"S";"0426";"*"
"IDELEGCSE";"S";"0427";"      SI LOCA_DROIT > 0"
"IDELEGCSE";"S";"0428";"         FAIRE CALCFJ"
"IDELEGCSE";"S";"0429";"         HJOU_IJRATCSEF = HJOU_IJRATCSEF - LOCA_DROIT"
"IDELEGCSE";"S";"0430";"      FINSI"
"IDELEGCSE";"S";"0431";"      LOCA_MAJT = 0"
"IDELEGCSE";"S";"0432";"* ----------------------"
"IDELEGCSE";"S";"0433";"* Mise à jour des soldes"
"IDELEGCSE";"S";"0434";"* ----------------------"
"IDELEGCSE";"S";"0435";"      HJOU_IJRASCSEF = HJOU_IJRADCSEF - HJOU_IJRAPCSEF"
"IDELEGCSE";"S";"0436";"      HJOU_IJRASCSEF = HJOU_IJRASCSEF + HJOU_IJRATCSEF"
"IDELEGCSE";"S";"0437";"* ----------------------------------------"
"IDELEGCSE";"S";"0438";"* Gestion des anomalies"
"IDELEGCSE";"S";"0439";"* ----------------------------------------"
"IDELEGCSE";"S";"0440";"      LOCA_DTMAX = HJOU_IJIDACSEM * LOCA_TAUX"
"IDELEGCSE";"S";"0441";"      LOCA_DROIT = LOCA_DTMAX / LOCA_DIV"
"IDELEGCSE";"S";"0442";"      LOCA_DROIT = LOCA_DROIT / 8"
"IDELEGCSE";"S";"0443";"      SI HJOU_DATE(7:2) = ""01"""
"IDELEGCSE";"S";"0444";"         SI HJOU_IJRADCSEF > LOCA_DROIT"
"IDELEGCSE";"S";"0445";"            ANOMALIE 218"
"IDELEGCSE";"S";"0446";"         FINSI"
"IDELEGCSE";"S";"0447";"      FINSI"
"IDELEGCSE";"S";"0448";"**************************************"
"IDELEGCSE";"S";"0449";"* En cas de dépassement des droits max par la pose d'une consigne"
"IDELEGCSE";"S";"0450";"      SI LOCA_MENSJ = 1"
"IDELEGCSE";"S";"0451";"         SI HJOU_IJRADCSEF > LOCA_DROIT"
"IDELEGCSE";"S";"0452";"         OU HJOU_IJRASCSEF > LOCA_DROIT"
"IDELEGCSE";"S";"0453";"            ANOMALIE 218"
"IDELEGCSE";"S";"0454";"         FINSI"
"IDELEGCSE";"S";"0455";"      FINSI"
"IDELEGCSE";"S";"0456";"**************************************"
"IDELEGCSE";"S";"0457";"      SI HJOU_IJRASCSE < 0"
"IDELEGCSE";"S";"0458";"      OU HJOU_IJRASCSEF < 0"
"IDELEGCSE";"S";"0459";"         ANOMALIE 217"
"IDELEGCSE";"S";"0460";"      FINSI"
"IDELEGCSE";"S";"0461";"   FINSI"
"IDELEGCSE";"S";"0462";"SINON"
"IDELEGCSE";"S";"0463";"* -------------------------------------------------------"
"IDELEGCSE";"S";"0464";"* RAZ des droits au lendemain de la date de fin de mandat"
"IDELEGCSE";"S";"0465";"* -------------------------------------------------------"
"IDELEGCSE";"S";"0466";"   LIREVALPRE LOCA_DATEFIN HJOU_DATE"
"IDELEGCSE";"S";"0467";"   *************************************************"
"IDELEGCSE";"S";"0468";"   *************************************************"
"IDELEGCSE";"S";"0469";"   * En cas d'ancienne version où le LIREVALPRE ne"
"IDELEGCSE";"S";"0470";"   * fonctionne pas (Nouveautés 5.2.0)"
"IDELEGCSE";"S";"0471";"   * Utiliser le réglementaire suivant :"
"IDELEGCSE";"S";"0472";"   *"
"IDELEGCSE";"S";"0473";"   * DATAJT HJOU_DATE 12 ""J"" -1"
"IDELEGCSE";"S";"0474";"   * LOCA_DATEFIN = TEMP_DXFINPER"
"IDELEGCSE";"S";"0475";"   *************************************************"
"IDELEGCSE";"S";"0476";"   *************************************************"
"IDELEGCSE";"S";"0477";"   SI LOCA_DATEFIN = HJOU_IJIDFIN"
"IDELEGCSE";"S";"0478";"      FAIRE RAZCSE"
"IDELEGCSE";"S";"0479";"   FINSI"
"IDELEGCSE";"S";"0480";"FINSI"
"IDELEGCSE";"S";"0481";"* -------------------------------------------------------"
"IDELEGCSE";"S";"0482";"* anomalie si le droit + transfert dépasse le maximum mensuel"
"IDELEGCSE";"S";"0483";"* -------------------------------------------------------"
"IDELEGCSE";"S";"0484";"* Déclenchement en cas d'un trop grand nombre d'heures reçues"
"IDELEGCSE";"S";"0485";"* via une consigne de transfert"
"IDELEGCSE";"S";"0486";"SI LOCA_MENS2 = 1"
"IDELEGCSE";"S";"0487";"   LOCA_DRTR = HJOU_IJRMDCSE + HJOU_IJRMTCSE"
"IDELEGCSE";"S";"0488";"   SI LOCA_DRTR > LOCA_MAXM"
"IDELEGCSE";"S";"0489";"      ANOMALIE 401"
"IDELEGCSE";"S";"0490";"   FINSI"
"IDELEGCSE";"S";"0491";"FINSI"
"IDELEGCSE";"S";"0492";"* ----------------------"
"IDELEGCSE";"S";"0493";"* Calcul du prévisionnel"
"IDELEGCSE";"S";"0494";"* ----------------------"
"IDELEGCSE";"S";"0495";"SI TEMP_DATSUI = LOCA_DATE"
"IDELEGCSE";"S";"0496";"* Forfait heure"
"IDELEGCSE";"S";"0497";"   SI HORC_IHINFORFJ <> ""1"""
"IDELEGCSE";"S";"0498";"      EMPL_IEQSDELCSE = HJOU_IJRASCSE"
"IDELEGCSE";"S";"0499";"   SINON"
"IDELEGCSE";"S";"0500";"* Forfait jour"
"IDELEGCSE";"S";"0501";"      EMPL_IEQSDELCSE = HJOU_IJRASCSEF * 8"
"IDELEGCSE";"S";"0502";"   FINSI"
"IDELEGCSE";"S";"0503";"FINSI"
"IDELEGCSE";"S";"0504";"* ----------"
"IDELEGCSE";"S";"0505";"* Simulation"
"IDELEGCSE";"S";"0506";"* ----------"
"IDELEGCSE";"S";"0507";"DEF CPTG_SOLDECSE T6.2"
"IDELEGCSE";"S";"0508";"PERGLISS CPTG_SOLDECSE ""060J01"""
"IDELEGCSE";"S";"0509";"POUR ACTIVITES"
"IDELEGCSE";"S";"0510";"   SI MOTI_IMIMATRICS <> "" """
"IDELEGCSE";"S";"0511";"      LOCA_MAT = MOTI_IMIMATRICS"
"IDELEGCSE";"S";"0512";"      LOCA_MAJD = HABS_MOTIDUR"
"IDELEGCSE";"S";"0513";"      LOCA_VALO = HABS_VALORIS"
"IDELEGCSE";"S";"0514";"   FINSI"
"IDELEGCSE";"S";"0515";"FINPOUR"
"IDELEGCSE";"S";"0516";"* --------------------------------------------------"
"IDELEGCSE";"S";"0517";"* Blocage si l'on se transmets des droits à soi-même"
"IDELEGCSE";"S";"0518";"* --------------------------------------------------"
"IDELEGCSE";"S";"0519";"SI LOCA_MAT = HJOU_MATRI"
"IDELEGCSE";"S";"0520";"   TEMP_CNRETOUR = 2"
"IDELEGCSE";"S";"0521";"   TEMP_CNMESS = 220"
"IDELEGCSE";"S";"0522";"FINSI"
"IDELEGCSE";"S";"0523";"* ---------------------------------------"
"IDELEGCSE";"S";"0524";"* Contrôles spécifiques aux forfaits jour"
"IDELEGCSE";"S";"0525";"* ---------------------------------------"
"IDELEGCSE";"S";"0526";"SI HORC_IHINFORFJ = ""1"""
"IDELEGCSE";"S";"0527";"*"
"IDELEGCSE";"S";"0528";"* Ils ne peuvent transférer que l'équivalent de jours / demi-journées (multiples de 4)"
"IDELEGCSE";"S";"0529";"   SI LOCA_MAJD > 0"
"IDELEGCSE";"S";"0530";"      LOCA_DROIT = LOCA_MAJD / LOCA_DIV"
"IDELEGCSE";"S";"0531";"      LOCA_RESTE = LOCA_DROIT % 4"
"IDELEGCSE";"S";"0532";"      SI LOCA_RESTE > 0"
"IDELEGCSE";"S";"0533";"         TEMP_CNRETOUR = 2"
"IDELEGCSE";"S";"0534";"         TEMP_CNMESS = 219"
"IDELEGCSE";"S";"0535";"      FINSI"
"IDELEGCSE";"S";"0536";"   FINSI"
"IDELEGCSE";"S";"0537";"* ----------------------------------------------------------------------------"
"IDELEGCSE";"S";"0538";"* Les forfaits jours ne posent que des délégations en journées ou 1/2 journées"
"IDELEGCSE";"S";"0539";"* ----------------------------------------------------------------------------"
"IDELEGCSE";"S";"0540";"   SI LOCA_VALO = ""H"""
"IDELEGCSE";"S";"0541";"      SI LOCA_MAT = "" """
"IDELEGCSE";"S";"0542";"         TEMP_CNRETOUR = 2"
"IDELEGCSE";"S";"0543";"         TEMP_CNMESS = 221"
"IDELEGCSE";"S";"0544";"      FINSI"
"IDELEGCSE";"S";"0545";"   FINSI"
"IDELEGCSE";"S";"0546";"FINSI"
"IDELEGCSE";"S";"0548";"FIN"
"IDELEGCSE";"S";"0549";"PROC RAZCSE"
"IDELEGCSE";"S";"0550";"   HJOU_IJRADCSE = 0"
"IDELEGCSE";"S";"0551";"   HJOU_IJRAPCSE = 0"
"IDELEGCSE";"S";"0552";"   HJOU_IJRATCSE = 0"
"IDELEGCSE";"S";"0553";"   HJOU_IJRASCSE = 0"
"IDELEGCSE";"S";"0554";"   HJOU_IJRMDCSE = 0"
"IDELEGCSE";"S";"0555";"   HJOU_IJRMPCSE = 0"
"IDELEGCSE";"S";"0556";"   HJOU_IJRMTCSE = 0"
"IDELEGCSE";"S";"0557";"   HJOU_IJRMSCSE = 0"
"IDELEGCSE";"S";"0558";"   HJOU_IJRADCSEF = 0"
"IDELEGCSE";"S";"0559";"   HJOU_IJRAPCSEF = 0"
"IDELEGCSE";"S";"0560";"   HJOU_IJRATCSEF = 0"
"IDELEGCSE";"S";"0561";"   HJOU_IJRASCSEF = 0"
"IDELEGCSE";"S";"0562";"FINPROC"
"IDELEGCSE";"S";"0563";"* -------------------------------------------"
"IDELEGCSE";"S";"0564";"* Procédure de calcul des droits forfait jour"
"IDELEGCSE";"S";"0565";"* -------------------------------------------"
"IDELEGCSE";"S";"0566";"PROC CALCFJ"
"IDELEGCSE";"S";"0567";"* --------------------------------------"
"IDELEGCSE";"S";"0568";"* Durée fixe pour les forfaits jour : 8h"
"IDELEGCSE";"S";"0569";"* --------------------------------------"
"IDELEGCSE";"S";"0570";"   LOCA_DROIT = LOCA_DROIT / 8"
"IDELEGCSE";"S";"0571";"   LOCA_RESTE = LOCA_DROIT % 1"
"IDELEGCSE";"S";"0572";"   LOCA_DROIT = LOCA_DROIT - LOCA_RESTE"
"IDELEGCSE";"S";"0573";"   SI LOCA_RESTE > 0"
"IDELEGCSE";"S";"0574";"      SI LOCA_RESTE < 0.5"
"IDELEGCSE";"S";"0575";"* -------------------------------------------------------------------------------------"
"IDELEGCSE";"S";"0576";"* Gestion des arrondis :"
"IDELEGCSE";"S";"0577";"* si l'on est dans le cas d'un transfert, on majore à la 1/2 journée supérieure"
"IDELEGCSE";"S";"0578";"* si l'on est dans le cas d'une consigne de MAJ de droit, on minore à la 1/2 inférieure"
"IDELEGCSE";"S";"0579";"* -------------------------------------------------------------------------------------"
"IDELEGCSE";"S";"0580";"         SI LOCA_MAJD = 0"
"IDELEGCSE";"S";"0581";"            LOCA_DROIT = LOCA_DROIT + 0.5"
"IDELEGCSE";"S";"0582";"         FINSI"
"IDELEGCSE";"S";"0583";"         ANOMALIE 219"
"IDELEGCSE";"S";"0584";"      SINON"
"IDELEGCSE";"S";"0585";"         SI LOCA_RESTE = 0.5"
"IDELEGCSE";"S";"0586";"            LOCA_DROIT = LOCA_DROIT + 0.5"
"IDELEGCSE";"S";"0587";"         SINON"
"IDELEGCSE";"S";"0588";"            SI LOCA_MAJD = 0"
"IDELEGCSE";"S";"0589";"               LOCA_DROIT = LOCA_DROIT + 1"
"IDELEGCSE";"S";"0590";"            FINSI"
"IDELEGCSE";"S";"0591";"            ANOMALIE 219"
"IDELEGCSE";"S";"0592";"         FINSI"
"IDELEGCSE";"S";"0593";"      FINSI"
"IDELEGCSE";"S";"0594";"   FINSI"
"IDELEGCSE";"S";"0595";"FINPROC"
"IDELEGCSEA";"S";"0001";"***********************************************************************"
"IDELEGCSEA";"S";"0002";"*"
"IDELEGCSEA";"S";"0003";"* Règle : IDELEGCSEA"
"IDELEGCSEA";"S";"0004";"* Ordre : 3360"
"IDELEGCSEA";"S";"0005";"* Titre : Délégations CSE année civile"
"IDELEGCSEA";"S";"0006";"*"
"IDELEGCSEA";"S";"0007";"*----------------------------------------------------------------------"
"IDELEGCSEA";"S";"0008";"*"
"IDELEGCSEA";"S";"0009";"* Créé par : Méthodes et outils"
"IDELEGCSEA";"S";"0010";"* Date     : 17/07/2018"
"IDELEGCSEA";"S";"0011";"* Version  : 1"
"IDELEGCSEA";"S";"0012";"*"
"IDELEGCSEA";"S";"0013";"*----------------------------------------------------------------------"
"IDELEGCSEA";"S";"0014";"*"
"IDELEGCSEA";"S";"0015";"*"
"IDELEGCSEA";"S";"0016";"* Rôle : Gestion des délégations CSE en année civile"
"IDELEGCSEA";"S";"0017";"*"
"IDELEGCSEA";"S";"0018";"*"
"IDELEGCSEA";"S";"0019";"*"
"IDELEGCSEA";"S";"0020";"*----------------------------------------------------------------------"
"IDELEGCSEA";"S";"0021";"*"
"IDELEGCSEA";"S";"0022";"* Modifiée par : Méthodes et outils"
"IDELEGCSEA";"S";"0023";"* Date         : 27/05/2019"
"IDELEGCSEA";"S";"0024";"* Objet        : Ajout du taux de majoration maxi dans PARD afin"
"IDELEGCSEA";"S";"0025";"*                 qu'il soit paramétrable"
"IDELEGCSEA";"S";"0026";"*"
"IDELEGCSEA";"S";"0027";"***********************************************************************"
"IDELEGCSEA";"S";"0028";"*"
"IDELEGCSEA";"S";"0029";"* Implémentation des données industrielles"
"IDELEGCSEA";"S";"0030";"*"
"IDELEGCSEA";"S";"0031";"DEBDICO"
"IDELEGCSEA";"S";"0032";"   HJOU_IJIDFIN;O;D10;X;;;   456789;;;C2;""Fin de mandat délégation"";"
"IDELEGCSEA";"S";"0033";"   HJOU_IJRADCSE;N;T6,2;L;;;   456789;;IJRADCSE;V3;""Droit annuel réel (H)"";"
"IDELEGCSEA";"S";"0034";"   HJOU_IJIDACSET;O;T6,2;L;;;   456789;;;C3;""Droit annuel théorique (H)"";"
"IDELEGCSEA";"S";"0035";"   HJOU_IJIDACSEM;O;T6,2;L;;;   456789;;;C3;""Droit annuel mandat theo (H)"";"
"IDELEGCSEA";"S";"0036";"   HJOU_IJRAPCSE;N;T6,2;L;;;   456789;;IJRAPCSE;V3;""Pris annuel (H)"";"
"IDELEGCSEA";"S";"0037";"   HJOU_IJRATCSE;N;T6,2;L;;;   456789;;IJRATCSE;V3;""Transfert annuel (H)"";"
"IDELEGCSEA";"S";"0038";"   HJOU_IJRASCSE;N;T6,2;L;;;   456789;;IJRASCSE;V3;""Solde annuel (H)"";"
"IDELEGCSEA";"S";"0039";"   HJOU_IJRMDCSE;N;T6,2;I;;;   456789;;IJRMDCSE;V3;""Droit mensuel (H)"";"
"IDELEGCSEA";"S";"0040";"   HJOU_IJRMPCSE;N;T6,2;I;;;   456789;;IJRMPCSE;V3;""Pris mensuel (H)"";"
"IDELEGCSEA";"S";"0041";"   HJOU_IJRMTCSE;N;T6,2;I;;;   456789;;IJRMTCSE;V3;""Transfert mensuel (H)"";"
"IDELEGCSEA";"S";"0042";"   HJOU_IJRMSCSE;N;T6,2;I;;;   456789;;IJRMSCSE;V3;""Solde mensuel (H)"";"
"IDELEGCSEA";"S";"0043";"   HJOU_IJRADCSEF;N;N6,2;I;;;   456789;;IJRADCSEF;V3;""Droit CSE (forfait jour)"";"
"IDELEGCSEA";"S";"0044";"   HJOU_IJRAPCSEF;N;N6,2;I;;;   456789;;IJRAPCSEF;V3;""Pris CSE (forfait jour)"";"
"IDELEGCSEA";"S";"0045";"   HJOU_IJRATCSEF;N;N6,2;I;;;   456789;;IJRATCSEF;V3;""Transfert CSE (forfait jour)"";"
"IDELEGCSEA";"S";"0046";"   HJOU_IJRASCSEF;N;N6,2;I;;;   456789;;IJRASCSEF;V3;""Solde CSE (forfait jour)"";"
"IDELEGCSEA";"S";"0047";"   MOTI_IMIMATRICS;O;A10;X;;;   456789;IH;;C2;""Matricule à créditer CSE"";"
"IDELEGCSEA";"S";"0048";"   EMPL_IEQSDELCSE;N;T6,2;L;;;     6789;;;V3;""Solde délégation CSE"";"
"IDELEGCSEA";"S";"0049";"   HORC_IHINFORFJ;O;Z1;X;0;1;123456789;C;;C2;""Forfait jour CSE"";"
"IDELEGCSEA";"S";"0050";"   PARD_IDIMAJOCSE;O;N3,1;I;0;;123456789;;;C3;""Taux de majoration maxi droit CSE"";"
"IDELEGCSEA";"S";"0051";"   EMPL_IEIMEMBCSE;O;A1;X;;;123456789;L8;;C3;""Membre CSE"";"
"IDELEGCSEA";"S";"0052";"FINDICO"
"IDELEGCSEA";"S";"0053";"*"
"IDELEGCSEA";"S";"0054";"DEBANO"
"IDELEGCSEA";"S";"0055";"   215;7;""Solde mensuel délégation CSE négatif"";"
"IDELEGCSEA";"S";"0056";"   216;7;""Dépassement du droit maximum CSE mensuel"";"
"IDELEGCSEA";"S";"0057";"   217;7;""Solde annuel délégation CSE négatif"";"
"IDELEGCSEA";"S";"0058";"   218;7;""Dépassement du droit maximum CSE annuel"";"
"IDELEGCSEA";"S";"0059";"   219;7;""La valeur du CSE transféré doit être un multiple de 4"";"
"IDELEGCSEA";"S";"0060";"   220;7;""Le transfert doit se faire vers un matricule différent de celui du donateur"";"
"IDELEGCSEA";"S";"0061";"   221;7;""Valorisation en heures interdite aux forfaits jour"";"
"IDELEGCSEA";"S";"0062";"   401;7;""Dépassement des droits maxi mensuel"";"
"IDELEGCSEA";"S";"0063";"FINANO"
"IDELEGCSEA";"S";"0064";"* --------------------------"
"IDELEGCSEA";"S";"0065";"* Principe de fonctionnement"
"IDELEGCSEA";"S";"0066";"* --------------------------"
"IDELEGCSEA";"S";"0067";"* Le droit annuel théorique et la date de fin de mandat sont saisis via une affectation"
"IDELEGCSEA";"S";"0068";"* Un modèle d'affectation est créé à cette fin"
"IDELEGCSEA";"S";"0069";"* Il n'y a pas d'indicateur de début de mandat : Le  fait que la date de fin de mandat"
"IDELEGCSEA";"S";"0070";"* soit renseignée en fait office, et déclenche les calculs."
"IDELEGCSEA";"S";"0071";"* Le droit mensuel est calculé au 01 de chaque mois, à raison de 1/12ème du droit annuel théorique"
"IDELEGCSEA";"S";"0072";"* et dans la limite de 1,5 fois ce droit pour les forfaits heure. * En cas de mandat débutant"
"IDELEGCSEA";"S";"0073";"* en cours de mois, le droit de ce mois est à renseigner manuellement par consigne."
"IDELEGCSEA";"S";"0074";"* Pour les forfaits jours, le droit est annuel et ne peut être majoré (à gérer par consigne)."
"IDELEGCSEA";"S";"0075";"* Un délégué peut dépasser le 1/12ème en en faisant la demande via le self, et dans la limite de 1,5"
"IDELEGCSEA";"S";"0076";"* fois le montant de ce 1/12ème. Cette demande n'est pas soumise à validation, et n'est pas"
"IDELEGCSEA";"S";"0077";"* supprimable une fois passée."
"IDELEGCSEA";"S";"0078";"* Des transferts de droits sont possibles d'un délégué à un autre et sont traités manuellement"
"IDELEGCSEA";"S";"0079";"* par les gestionnaires, l'état CMITRFCSE permettant de ressortir les consignes de transfert,"
"IDELEGCSEA";"S";"0080";"* et leur correspondance chez le destinataire du don."
"IDELEGCSEA";"S";"0081";"* le benéficiare d'un transfert d'heure ne peut depassé 1,5 fois le 12ième du theorique annuel"
"IDELEGCSEA";"S";"0082";"*--------------------"
"IDELEGCSEA";"S";"0083";"* Consignes et motifs"
"IDELEGCSEA";"S";"0084";"* -------------------"
"IDELEGCSEA";"S";"0085";"* Le motif DECSE est utilisé pour la pose de délégation"
"IDELEGCSEA";"S";"0086";"* Les consignes ZDCSE et XDCSE impactent HJOU_IJRMDCSE (Droit mensuel) pour les forfaits heures"
"IDELEGCSEA";"S";"0087";"*                                        HJOU_IJRADCSEF pour les forfaits jour"
"IDELEGCSEA";"S";"0088";"* Les consignes ZPCSE et XPCSE impactent HJOU_IJRMPCSE (Pris mensuel) pour les forfaits heures"
"IDELEGCSEA";"S";"0089";"*                                        HJOU_IJRAPCSEF pour les forfaits jour"
"IDELEGCSEA";"S";"0090";"* Les consignes ZTCSE et XTCSE impactent HJOU_IJRMTCSE (Transfert mensuel) pour les forfaits heures"
"IDELEGCSEA";"S";"0091";"*                                        HJOU_IJRATCSEF pour les forfaits jour"
"IDELEGCSEA";"S";"0092";"* Les consignes ayant un matricule renseigné dans le MOTI_IMIMATRICS impactent le matricule émetteur"
"IDELEGCSEA";"S";"0093";"* sur les compteurs                      HJOU_IJRMTCSE (Transfert mensuel) pour les forfaits heures"
"IDELEGCSEA";"S";"0094";"*                                        HJOU_IJRATCSEF pour les forfaits jour"
"IDELEGCSEA";"S";"0095";"* -------------------------------"
"IDELEGCSEA";"S";"0096";"* Déclaration des donnees locales"
"IDELEGCSEA";"S";"0097";"* -------------------------------"
"IDELEGCSEA";"S";"0098";"DEF LOCA_DTMAX T6.2"
"IDELEGCSEA";"S";"0099";"LOCA_DTMAX = 0"
"IDELEGCSEA";"S";"0100";"* maximum mensuel (par défaut 1,5 fois le 12ième ANNUEL)"
"IDELEGCSEA";"S";"0101";"DEF LOCA_MAXM T8.2"
"IDELEGCSEA";"S";"0102";"LOCA_MAXM = HJOU_IJIDACSEM / 12"
"IDELEGCSEA";"S";"0103";"LOCA_MAXM = LOCA_MAXM * PARD_IDIMAJOCSE"
"IDELEGCSEA";"S";"0104";"* droit et transfert"
"IDELEGCSEA";"S";"0105";"DEF LOCA_DRTR T8.2"
"IDELEGCSEA";"S";"0106";"LOCA_DRTR = 0"
"IDELEGCSEA";"S";"0107";"* droit et pris"
"IDELEGCSEA";"S";"0108";"DEF LOCA_DRPR T8.2"
"IDELEGCSEA";"S";"0109";"LOCA_DRPR = 0"
"IDELEGCSEA";"S";"0110";"* --------------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0111";"* Locale permettant de déterminer s'il y a une consigne impactant le droit mensuel"
"IDELEGCSEA";"S";"0112";"* --------------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0113";"DEF LOCA_MENS N1"
"IDELEGCSEA";"S";"0114";"LOCA_MENS = 0"
"IDELEGCSEA";"S";"0115";"DEF LOCA_MENS2 N1"
"IDELEGCSEA";"S";"0116";"LOCA_MENS2 = 0"
"IDELEGCSEA";"S";"0117";"DEF LOCA_MAJO N1"
"IDELEGCSEA";"S";"0118";"LOCA_MAJO = 0"
"IDELEGCSEA";"S";"0119";"* -------------------------------------------------------------"
"IDELEGCSEA";"S";"0120";"* Locale permettant de calculer le droit pour les forfaits jour"
"IDELEGCSEA";"S";"0121";"* -------------------------------------------------------------"
"IDELEGCSEA";"S";"0122";"DEF LOCA_MAJD T6.2"
"IDELEGCSEA";"S";"0123";"LOCA_MAJD = 0"
"IDELEGCSEA";"S";"0124";"* --------------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0125";"* Locale permettant de calculer le nbre de jours transférés pour les forfaits jour"
"IDELEGCSEA";"S";"0126";"* --------------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0127";"DEF LOCA_MAJT T6.2"
"IDELEGCSEA";"S";"0128";"LOCA_MAJT = 0"
"IDELEGCSEA";"S";"0129";"DEF LOCA_DATE D"
"IDELEGCSEA";"S";"0130";"LOCA_DATE = "" """
"IDELEGCSEA";"S";"0131";"DEF LOCA_ACOURS N4"
"IDELEGCSEA";"S";"0132";"LOCA_ACOURS = 0"
"IDELEGCSEA";"S";"0133";"DEF LOCA_DATEFIN D"
"IDELEGCSEA";"S";"0134";"LOCA_DATEFIN = "" """
"IDELEGCSEA";"S";"0135";"DEF LOCA_DROIT N7.3"
"IDELEGCSEA";"S";"0136";"LOCA_DROIT = 0"
"IDELEGCSEA";"S";"0137";"DEF LOCA_MAT A10"
"IDELEGCSEA";"S";"0138";"LOCA_MAT = "" """
"IDELEGCSEA";"S";"0139";"DEF LOCA_VALO A1"
"IDELEGCSEA";"S";"0140";"LOCA_VALO = "" """
"IDELEGCSEA";"S";"0141";"* ----------------------------------------------------"
"IDELEGCSEA";"S";"0142";"* Coefficient appliqué pour le calcul de la majoration"
"IDELEGCSEA";"S";"0143";"* ----------------------------------------------------"
"IDELEGCSEA";"S";"0144";"DEF LOCA_TAUX N4.1"
"IDELEGCSEA";"S";"0145";"LOCA_TAUX = PARD_IDIMAJOCSE"
"IDELEGCSEA";"S";"0146";"DEF LOCA_DIV T6.2"
"IDELEGCSEA";"S";"0147";"LOCA_DIV = 1.00"
"IDELEGCSEA";"S";"0148";"DEF LOCA_RESTE N7.3"
"IDELEGCSEA";"S";"0149";"LOCA_RESTE = 0"
"IDELEGCSEA";"S";"0150";"DEF LOCA_MOINS1 N2"
"IDELEGCSEA";"S";"0151";"LOCA_MOINS1 = -1"
"IDELEGCSEA";"S";"0152";"*CSE en jour"
"IDELEGCSEA";"S";"0153";"DEF LOCA_MENSJ N1"
"IDELEGCSEA";"S";"0154";"LOCA_MENSJ = 0"
"IDELEGCSEA";"S";"0155";"* --------------------------------"
"IDELEGCSEA";"S";"0156";"* Calcul de la date prévisionnelle"
"IDELEGCSEA";"S";"0157";"* --------------------------------"
"IDELEGCSEA";"S";"0158";"LOCA_DATE(5:4) = HJOU_IJIDFIN(5:4)"
"IDELEGCSEA";"S";"0159";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IDELEGCSEA";"S";"0160";"SI TEMP_DATJOU(5:4) > HJOU_IJIDFIN(5:4)"
"IDELEGCSEA";"S";"0161";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"IDELEGCSEA";"S";"0162";"FINSI"
"IDELEGCSEA";"S";"0163";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDELEGCSEA";"S";"0164";"*"
"IDELEGCSEA";"S";"0165";"SI HJOU_DATE <= HJOU_IJIDFIN"
"IDELEGCSEA";"S";"0166";"* ---------------------------------------"
"IDELEGCSEA";"S";"0167";"* Remise à 0 des compteurs de CSE Annuels"
"IDELEGCSEA";"S";"0168";"* --------------------------------------------------------------------"
"IDELEGCSEA";"S";"0169";"* En fonction du mode de gestion : année civile, voir regle spécifique"
"IDELEGCSEA";"S";"0170";"* --------------------------------------------------------------------"
"IDELEGCSEA";"S";"0171";"   SI HJOU_DATE(5:4) = ""0101"""
"IDELEGCSEA";"S";"0172";"      FAIRE RAZCSE"
"IDELEGCSEA";"S";"0173";"   FINSI"
"IDELEGCSEA";"S";"0174";"* --------------"
"IDELEGCSEA";"S";"0175";"* Forfait heures"
"IDELEGCSEA";"S";"0176";"* --------------"
"IDELEGCSEA";"S";"0177";"   SI HORC_IHINFORFJ <> ""1"""
"IDELEGCSEA";"S";"0178";"* -------------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0179";"* Initialisation du droit et remise à 0 des compteurs pris et transférés mensuels"
"IDELEGCSEA";"S";"0180";"* -------------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0181";"      SI HJOU_DATE(7:2) = ""01"""
"IDELEGCSEA";"S";"0182";"         HJOU_IJRMDCSE = HJOU_IJIDACSET / 12"
"IDELEGCSEA";"S";"0183";"* -------------------------------------------"
"IDELEGCSEA";"S";"0184";"* Consigne de majoration mensuelle des droits"
"IDELEGCSEA";"S";"0185";"* -------------------------------------------"
"IDELEGCSEA";"S";"0186";"         POUR ACTIVITES"
"IDELEGCSEA";"S";"0187";"            SI HABS_MOTIF = ""ZMACSE"""
"IDELEGCSEA";"S";"0188";"               LOCA_MAJO = 1"
"IDELEGCSEA";"S";"0189";"            FINSI"
"IDELEGCSEA";"S";"0190";"         FINPOUR"
"IDELEGCSEA";"S";"0191";"         SI LOCA_MAJO = 1"
"IDELEGCSEA";"S";"0192";"            HJOU_IJRMDCSE = HJOU_IJRMDCSE * LOCA_TAUX"
"IDELEGCSEA";"S";"0193";"         FINSI"
"IDELEGCSEA";"S";"0194";"         HJOU_IJRADCSE = HJOU_IJRADCSE + HJOU_IJRMDCSE"
"IDELEGCSEA";"S";"0195";"         HJOU_IJRMPCSE = 0"
"IDELEGCSEA";"S";"0196";"         HJOU_IJRMTCSE = 0"
"IDELEGCSEA";"S";"0197";"      FINSI"
"IDELEGCSEA";"S";"0198";"* ------------------"
"IDELEGCSEA";"S";"0199";"* Analyse des motifs"
"IDELEGCSEA";"S";"0200";"* ------------------"
"IDELEGCSEA";"S";"0201";"      POUR ACTIVITES"
"IDELEGCSEA";"S";"0202";"         SI HABS_MOTIF = ""DECSE"""
"IDELEGCSEA";"S";"0203";"         OU HABS_MOTIF = ""DECSEB"""
"IDELEGCSEA";"S";"0204";"            HJOU_IJRMPCSE = HJOU_IJRMPCSE + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0205";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0206";"         FINSI"
"IDELEGCSEA";"S";"0207";"* -----------------"
"IDELEGCSEA";"S";"0208";"* Droit CSE mensuel"
"IDELEGCSEA";"S";"0209";"* -----------------"
"IDELEGCSEA";"S";"0210";"         SI HABS_MOTIF = ""ZDCSE"""
"IDELEGCSEA";"S";"0211";"            LOCA_MENS = 1"
"IDELEGCSEA";"S";"0212";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMDCSE"
"IDELEGCSEA";"S";"0213";"            HJOU_IJRMDCSE = HABS_MOTIDUR"
"IDELEGCSEA";"S";"0214";"            HJOU_IJRADCSE = HJOU_IJRADCSE + LOCA_MAJD"
"IDELEGCSEA";"S";"0215";"         FINSI"
"IDELEGCSEA";"S";"0216";"         SI HABS_MOTIF = ""XDCSE"""
"IDELEGCSEA";"S";"0217";"            LOCA_MENS = 1"
"IDELEGCSEA";"S";"0218";"            HJOU_IJRMDCSE = HJOU_IJRMDCSE + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0219";"            HJOU_IJRADCSE = HJOU_IJRADCSE + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0220";"         FINSI"
"IDELEGCSEA";"S";"0221";"* ----------------"
"IDELEGCSEA";"S";"0222";"* Pris CSE mensuel"
"IDELEGCSEA";"S";"0223";"* ----------------"
"IDELEGCSEA";"S";"0224";"         SI HABS_MOTIF = ""ZPCSE"""
"IDELEGCSEA";"S";"0225";"            LOCA_MENS = 1"
"IDELEGCSEA";"S";"0226";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMPCSE"
"IDELEGCSEA";"S";"0227";"            HJOU_IJRMPCSE = HABS_MOTIDUR"
"IDELEGCSEA";"S";"0228";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + LOCA_MAJD"
"IDELEGCSEA";"S";"0229";"         FINSI"
"IDELEGCSEA";"S";"0230";"         SI HABS_MOTIF = ""XPCSE"""
"IDELEGCSEA";"S";"0231";"            LOCA_MENS = 1"
"IDELEGCSEA";"S";"0232";"            HJOU_IJRMPCSE = HJOU_IJRMPCSE + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0233";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0234";"         FINSI"
"IDELEGCSEA";"S";"0235";"* ----------------"
"IDELEGCSEA";"S";"0236";"* Transfert CSE mensuel"
"IDELEGCSEA";"S";"0237";"* ----------------"
"IDELEGCSEA";"S";"0238";"         SI HABS_MOTIF = ""ZTCSE"""
"IDELEGCSEA";"S";"0239";"            LOCA_MENS2 = 1"
"IDELEGCSEA";"S";"0240";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMTCSE"
"IDELEGCSEA";"S";"0241";"            HJOU_IJRMTCSE = HABS_MOTIDUR"
"IDELEGCSEA";"S";"0242";"            HJOU_IJRATCSE = HJOU_IJRATCSE + LOCA_MAJD"
"IDELEGCSEA";"S";"0243";"         FINSI"
"IDELEGCSEA";"S";"0244";"         SI HABS_MOTIF = ""XTCSE"""
"IDELEGCSEA";"S";"0245";"            LOCA_MENS2 = 1"
"IDELEGCSEA";"S";"0246";"            HJOU_IJRMTCSE = HJOU_IJRMTCSE + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0247";"            HJOU_IJRATCSE = HJOU_IJRATCSE + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0248";"         FINSI"
"IDELEGCSEA";"S";"0249";"* -----------------------------"
"IDELEGCSEA";"S";"0250";"* Motif de demande de transfert"
"IDELEGCSEA";"S";"0251";"* -----------------------------"
"IDELEGCSEA";"S";"0252";"         SI HABS_MOTYPE = ""C"""
"IDELEGCSEA";"S";"0253";"            SI MOTI_IMIMATRICS <> "" """
"IDELEGCSEA";"S";"0254";"               HJOU_IJRMTCSE = HJOU_IJRMTCSE - HABS_MOTIDUR"
"IDELEGCSEA";"S";"0255";"               HJOU_IJRATCSE = HJOU_IJRATCSE - HABS_MOTIDUR"
"IDELEGCSEA";"S";"0256";"               SI MOTI_IMIMATRICS = HJOU_MATRI"
"IDELEGCSEA";"S";"0257";"                  ANOMALIE 220"
"IDELEGCSEA";"S";"0258";"               FINSI"
"IDELEGCSEA";"S";"0259";"            FINSI"
"IDELEGCSEA";"S";"0260";"         FINSI"
"IDELEGCSEA";"S";"0261";"      FINPOUR"
"IDELEGCSEA";"S";"0262";"* ----------------------"
"IDELEGCSEA";"S";"0263";"* Mise à jour des soldes"
"IDELEGCSEA";"S";"0264";"* ----------------------"
"IDELEGCSEA";"S";"0265";"      HJOU_IJRMSCSE = HJOU_IJRMDCSE - HJOU_IJRMPCSE"
"IDELEGCSEA";"S";"0266";"      HJOU_IJRMSCSE = HJOU_IJRMSCSE + HJOU_IJRMTCSE"
"IDELEGCSEA";"S";"0267";"      HJOU_IJRASCSE = HJOU_IJRADCSE - HJOU_IJRAPCSE"
"IDELEGCSEA";"S";"0268";"      HJOU_IJRASCSE = HJOU_IJRASCSE + HJOU_IJRATCSE"
"IDELEGCSEA";"S";"0269";"* ----------------------------------------"
"IDELEGCSEA";"S";"0270";"* Gestion des anomalies"
"IDELEGCSEA";"S";"0271";"* ----------------------------------------"
"IDELEGCSEA";"S";"0272";"* Solde négatif"
"IDELEGCSEA";"S";"0273";"      SI HJOU_IJRMSCSE < 0"
"IDELEGCSEA";"S";"0274";"         ANOMALIE 215"
"IDELEGCSEA";"S";"0275";"      FINSI"
"IDELEGCSEA";"S";"0276";"*"
"IDELEGCSEA";"S";"0277";"      DEF CPTG_SOLDECSEM T6.2"
"IDELEGCSEA";"S";"0278";"      PERGLISS CPTG_SOLDECSEM ""031J01"""
"IDELEGCSEA";"S";"0279";"      SI HJOU_IJRMSCSE < 0"
"IDELEGCSEA";"S";"0280";"         TEMP_CNRETOUR = 2"
"IDELEGCSEA";"S";"0281";"         TEMP_CNMESS = 215"
"IDELEGCSEA";"S";"0282";"      FINSI"
"IDELEGCSEA";"S";"0283";"* depassement du CSE annuel"
"IDELEGCSEA";"S";"0284";"      LOCA_DTMAX = HJOU_IJIDACSEM * LOCA_TAUX"
"IDELEGCSEA";"S";"0285";"      SI HJOU_DATE(7:2) = ""01"""
"IDELEGCSEA";"S";"0286";"         SI HJOU_IJRADCSE > LOCA_DTMAX"
"IDELEGCSEA";"S";"0287";"            ANOMALIE 218"
"IDELEGCSEA";"S";"0288";"         FINSI"
"IDELEGCSEA";"S";"0289";"      FINSI"
"IDELEGCSEA";"S";"0290";"      LOCA_DTMAX = LOCA_DTMAX / 12"
"IDELEGCSEA";"S";"0291";"* --------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0292";"* LOCA_MENS : on affiche l'anomalie que s'il y a une consigne sur la journée"
"IDELEGCSEA";"S";"0293";"* --------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0294";"      SI LOCA_MENS = 1"
"IDELEGCSEA";"S";"0295";"         LOCA_DRPR = HJOU_IJRMDCSE - HJOU_IJRMPCSE"
"IDELEGCSEA";"S";"0296";"         SI HJOU_IJRMDCSE > LOCA_DTMAX"
"IDELEGCSEA";"S";"0297";"         OU LOCA_DRPR > LOCA_DTMAX"
"IDELEGCSEA";"S";"0298";"            ANOMALIE 216"
"IDELEGCSEA";"S";"0299";"         FINSI"
"IDELEGCSEA";"S";"0300";"      FINSI"
"IDELEGCSEA";"S";"0301";"   SINON"
"IDELEGCSEA";"S";"0302";"* ------------"
"IDELEGCSEA";"S";"0303";"* Forfait jour"
"IDELEGCSEA";"S";"0304";"* ------------"
"IDELEGCSEA";"S";"0305";"* -----------------------"
"IDELEGCSEA";"S";"0306";"* Initialisation du droit : calcul du nombre de jours pour les forfaits jour."
"IDELEGCSEA";"S";"0307";"* -----------------------"
"IDELEGCSEA";"S";"0308";"      SI HJOU_IJRADCSEF = 0"
"IDELEGCSEA";"S";"0309";"         SI HJOU_IJIDACSET > 0"
"IDELEGCSEA";"S";"0310";"* ---------------------------------"
"IDELEGCSEA";"S";"0311";"* Arrondi du droit au 0.5 supérieur"
"IDELEGCSEA";"S";"0312";"* ---------------------------------"
"IDELEGCSEA";"S";"0313";"            LOCA_DROIT = HJOU_IJIDACSET / LOCA_DIV"
"IDELEGCSEA";"S";"0314";"            FAIRE CALCFJ"
"IDELEGCSEA";"S";"0315";"            HJOU_IJRADCSEF = LOCA_DROIT"
"IDELEGCSEA";"S";"0316";"            LOCA_DROIT = 0"
"IDELEGCSEA";"S";"0317";"         FINSI"
"IDELEGCSEA";"S";"0318";"      FINSI"
"IDELEGCSEA";"S";"0319";"* -------------------"
"IDELEGCSEA";"S";"0320";"* Motifs et activités"
"IDELEGCSEA";"S";"0321";"* -------------------"
"IDELEGCSEA";"S";"0322";"      POUR ACTIVITES"
"IDELEGCSEA";"S";"0323";"         SI HABS_MOTIF = ""DECSE"""
"IDELEGCSEA";"S";"0324";"         OU HABS_MOTIF = ""DECSEB"""
"IDELEGCSEA";"S";"0325";"            SI HABS_VALORIS = ""J"""
"IDELEGCSEA";"S";"0326";"               HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 1"
"IDELEGCSEA";"S";"0327";"            SINON"
"IDELEGCSEA";"S";"0328";"               SI HABS_VALORIS = ""A"""
"IDELEGCSEA";"S";"0329";"               OU HABS_VALORIS = ""M"""
"IDELEGCSEA";"S";"0330";"                  HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 0.5"
"IDELEGCSEA";"S";"0331";"               SINON"
"IDELEGCSEA";"S";"0332";"                  ANOMALIE 221"
"IDELEGCSEA";"S";"0333";"                  SI HABS_MOTIDUR > 4"
"IDELEGCSEA";"S";"0334";"                     HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 1"
"IDELEGCSEA";"S";"0335";"                  SINON"
"IDELEGCSEA";"S";"0336";"                     HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 0.5"
"IDELEGCSEA";"S";"0337";"                  FINSI"
"IDELEGCSEA";"S";"0338";"               FINSI"
"IDELEGCSEA";"S";"0339";"            FINSI"
"IDELEGCSEA";"S";"0340";"         FINSI"
"IDELEGCSEA";"S";"0341";"* -----------------"
"IDELEGCSEA";"S";"0342";"* Droit CSE mensuel"
"IDELEGCSEA";"S";"0343";"* -----------------"
"IDELEGCSEA";"S";"0344";"         SI HABS_MOTIF = ""ZDCSE"""
"IDELEGCSEA";"S";"0345";"            LOCA_MENSJ = 1"
"IDELEGCSEA";"S";"0346";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSEA";"S";"0347";"            FAIRE CALCFJ"
"IDELEGCSEA";"S";"0348";"            HJOU_IJRADCSEF = LOCA_DROIT"
"IDELEGCSEA";"S";"0349";"            LOCA_DROIT = 0"
"IDELEGCSEA";"S";"0350";"         FINSI"
"IDELEGCSEA";"S";"0351";"         SI HABS_MOTIF = ""XDCSE"""
"IDELEGCSEA";"S";"0352";"            LOCA_MENSJ = 1"
"IDELEGCSEA";"S";"0353";"            LOCA_MAJD = LOCA_MAJD + HABS_MOTIDUR"
"IDELEGCSEA";"S";"0354";"         FINSI"
"IDELEGCSEA";"S";"0355";"* ----------------"
"IDELEGCSEA";"S";"0356";"* Pris CSE mensuel"
"IDELEGCSEA";"S";"0357";"* ----------------"
"IDELEGCSEA";"S";"0358";"         SI HABS_MOTIF = ""ZPCSE"""
"IDELEGCSEA";"S";"0359";"            LOCA_MENSJ = 1"
"IDELEGCSEA";"S";"0360";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSEA";"S";"0361";"            FAIRE CALCFJ"
"IDELEGCSEA";"S";"0362";"            HJOU_IJRAPCSEF = LOCA_DROIT"
"IDELEGCSEA";"S";"0363";"         FINSI"
"IDELEGCSEA";"S";"0364";"         SI HABS_MOTIF = ""XPCSE"""
"IDELEGCSEA";"S";"0365";"            LOCA_MENSJ = 1"
"IDELEGCSEA";"S";"0366";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSEA";"S";"0367";"            FAIRE CALCFJ"
"IDELEGCSEA";"S";"0368";"            HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + LOCA_DROIT"
"IDELEGCSEA";"S";"0369";"         FINSI"
"IDELEGCSEA";"S";"0370";"* ----------------"
"IDELEGCSEA";"S";"0371";"* Transfert CSE mensuel"
"IDELEGCSEA";"S";"0372";"* ----------------"
"IDELEGCSEA";"S";"0373";"         SI HABS_MOTIF = ""ZTCSE"""
"IDELEGCSEA";"S";"0374";"            LOCA_MENSJ = 1"
"IDELEGCSEA";"S";"0375";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSEA";"S";"0376";"            FAIRE CALCFJ"
"IDELEGCSEA";"S";"0377";"            HJOU_IJRATCSEF = LOCA_DROIT"
"IDELEGCSEA";"S";"0378";"         FINSI"
"IDELEGCSEA";"S";"0379";"         SI HABS_MOTIF = ""XTCSE"""
"IDELEGCSEA";"S";"0380";"            LOCA_MENSJ = 1"
"IDELEGCSEA";"S";"0381";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IDELEGCSEA";"S";"0382";"            FAIRE CALCFJ"
"IDELEGCSEA";"S";"0383";"            HJOU_IJRATCSEF = HJOU_IJRATCSEF + LOCA_DROIT"
"IDELEGCSEA";"S";"0384";"         FINSI"
"IDELEGCSEA";"S";"0385";"* -----------------------------"
"IDELEGCSEA";"S";"0386";"* Motif de demande de transfert"
"IDELEGCSEA";"S";"0387";"* -----------------------------"
"IDELEGCSEA";"S";"0388";"         SI HABS_MOTYPE = ""C"""
"IDELEGCSEA";"S";"0389";"            SI MOTI_IMIMATRICS <> "" """
"IDELEGCSEA";"S";"0390";"               LOCA_MAJT = LOCA_MAJT - HABS_MOTIDUR"
"IDELEGCSEA";"S";"0391";"               SI MOTI_IMIMATRICS = HJOU_MATRI"
"IDELEGCSEA";"S";"0392";"                  ANOMALIE 220"
"IDELEGCSEA";"S";"0393";"               FINSI"
"IDELEGCSEA";"S";"0394";"            FINSI"
"IDELEGCSEA";"S";"0395";"         FINSI"
"IDELEGCSEA";"S";"0396";"      FINPOUR"
"IDELEGCSEA";"S";"0397";"* ----------------------------"
"IDELEGCSEA";"S";"0398";"* Cumul des XDCSE sur le droit"
"IDELEGCSEA";"S";"0399";"* ----------------------------"
"IDELEGCSEA";"S";"0400";"      LOCA_DROIT = LOCA_MAJD / LOCA_DIV"
"IDELEGCSEA";"S";"0401";"      SI LOCA_DROIT <> 0"
"IDELEGCSEA";"S";"0402";"         FAIRE CALCFJ"
"IDELEGCSEA";"S";"0403";"         HJOU_IJRADCSEF = HJOU_IJRADCSEF + LOCA_DROIT"
"IDELEGCSEA";"S";"0404";"      FINSI"
"IDELEGCSEA";"S";"0405";"      LOCA_MAJD = 0"
"IDELEGCSEA";"S";"0406";"* --------------------"
"IDELEGCSEA";"S";"0407";"* Cumul des transferts"
"IDELEGCSEA";"S";"0408";"* --------------------"
"IDELEGCSEA";"S";"0409";"      LOCA_DROIT = LOCA_MAJT / LOCA_DIV"
"IDELEGCSEA";"S";"0410";"* En cas de droit négatif"
"IDELEGCSEA";"S";"0411";"      SI LOCA_DROIT < 0"
"IDELEGCSEA";"S";"0412";"         LOCA_DROIT = LOCA_DROIT * LOCA_MOINS1"
"IDELEGCSEA";"S";"0413";"      FINSI"
"IDELEGCSEA";"S";"0414";"      SI LOCA_DROIT > 0"
"IDELEGCSEA";"S";"0415";"         FAIRE CALCFJ"
"IDELEGCSEA";"S";"0416";"         HJOU_IJRATCSEF = HJOU_IJRATCSEF - LOCA_DROIT"
"IDELEGCSEA";"S";"0417";"      FINSI"
"IDELEGCSEA";"S";"0418";"      LOCA_MAJT = 0"
"IDELEGCSEA";"S";"0419";"* ----------------------"
"IDELEGCSEA";"S";"0420";"* Mise à jour des soldes"
"IDELEGCSEA";"S";"0421";"* ----------------------"
"IDELEGCSEA";"S";"0422";"      HJOU_IJRASCSEF = HJOU_IJRADCSEF - HJOU_IJRAPCSEF"
"IDELEGCSEA";"S";"0423";"      HJOU_IJRASCSEF = HJOU_IJRASCSEF + HJOU_IJRATCSEF"
"IDELEGCSEA";"S";"0424";"* ----------------------------------------"
"IDELEGCSEA";"S";"0425";"* Gestion des anomalies"
"IDELEGCSEA";"S";"0426";"* ----------------------------------------"
"IDELEGCSEA";"S";"0427";"      LOCA_DTMAX = HJOU_IJIDACSEM * LOCA_TAUX"
"IDELEGCSEA";"S";"0428";"      LOCA_DROIT = LOCA_DTMAX / LOCA_DIV"
"IDELEGCSEA";"S";"0429";"      LOCA_DROIT = LOCA_DROIT / 8"
"IDELEGCSEA";"S";"0430";"      SI HJOU_DATE(7:2) = ""01"""
"IDELEGCSEA";"S";"0431";"         SI HJOU_IJRADCSEF > LOCA_DROIT"
"IDELEGCSEA";"S";"0432";"            ANOMALIE 218"
"IDELEGCSEA";"S";"0433";"         FINSI"
"IDELEGCSEA";"S";"0434";"      FINSI"
"IDELEGCSEA";"S";"0435";"**************************************"
"IDELEGCSEA";"S";"0436";"* En cas de dépassement des droits max par la pose d'une consigne"
"IDELEGCSEA";"S";"0437";"      SI LOCA_MENSJ = 1"
"IDELEGCSEA";"S";"0438";"         SI HJOU_IJRADCSEF > LOCA_DROIT"
"IDELEGCSEA";"S";"0439";"         OU HJOU_IJRASCSEF > LOCA_DROIT"
"IDELEGCSEA";"S";"0440";"            ANOMALIE 218"
"IDELEGCSEA";"S";"0441";"         FINSI"
"IDELEGCSEA";"S";"0442";"      FINSI"
"IDELEGCSEA";"S";"0443";"**************************************"
"IDELEGCSEA";"S";"0444";"      SI HJOU_IJRASCSE < 0"
"IDELEGCSEA";"S";"0445";"      OU HJOU_IJRASCSEF < 0"
"IDELEGCSEA";"S";"0446";"         ANOMALIE 217"
"IDELEGCSEA";"S";"0447";"      FINSI"
"IDELEGCSEA";"S";"0448";"   FINSI"
"IDELEGCSEA";"S";"0449";"SINON"
"IDELEGCSEA";"S";"0450";"* -------------------------------------------------------"
"IDELEGCSEA";"S";"0451";"* RAZ des droits au lendemain de la date de fin de mandat"
"IDELEGCSEA";"S";"0452";"* -------------------------------------------------------"
"IDELEGCSEA";"S";"0453";"   LIREVALPRE LOCA_DATEFIN HJOU_DATE"
"IDELEGCSEA";"S";"0454";"   *************************************************"
"IDELEGCSEA";"S";"0455";"   *************************************************"
"IDELEGCSEA";"S";"0456";"   * En cas d'ancienne version où le LIREVALPRE ne"
"IDELEGCSEA";"S";"0457";"   * fonctionne pas (Nouveautés 5.2.0)"
"IDELEGCSEA";"S";"0458";"   * Utiliser le réglementaire suivant :"
"IDELEGCSEA";"S";"0459";"   *"
"IDELEGCSEA";"S";"0460";"   * DATAJT HJOU_DATE 12 ""J"" -1"
"IDELEGCSEA";"S";"0461";"   * LOCA_DATEFIN = TEMP_DXFINPER"
"IDELEGCSEA";"S";"0462";"   *************************************************"
"IDELEGCSEA";"S";"0463";"   *************************************************"
"IDELEGCSEA";"S";"0464";"   SI LOCA_DATEFIN = HJOU_IJIDFIN"
"IDELEGCSEA";"S";"0465";"      FAIRE RAZCSE"
"IDELEGCSEA";"S";"0466";"   FINSI"
"IDELEGCSEA";"S";"0467";"FINSI"
"IDELEGCSEA";"S";"0468";"* -------------------------------------------------------"
"IDELEGCSEA";"S";"0469";"* anomalie si le droit + transfert dépasse le maximum mensuel"
"IDELEGCSEA";"S";"0470";"* -------------------------------------------------------"
"IDELEGCSEA";"S";"0471";"* Déclenchement en cas d'un trop grand nombre d'heures reçues"
"IDELEGCSEA";"S";"0472";"* via une consigne de transfert"
"IDELEGCSEA";"S";"0473";"SI LOCA_MENS2 = 1"
"IDELEGCSEA";"S";"0474";"   LOCA_DRTR = HJOU_IJRMDCSE + HJOU_IJRMTCSE"
"IDELEGCSEA";"S";"0475";"   SI LOCA_DRTR > LOCA_MAXM"
"IDELEGCSEA";"S";"0476";"      ANOMALIE 401"
"IDELEGCSEA";"S";"0477";"   FINSI"
"IDELEGCSEA";"S";"0478";"FINSI"
"IDELEGCSEA";"S";"0479";"* ----------------------"
"IDELEGCSEA";"S";"0480";"* Calcul du prévisionnel"
"IDELEGCSEA";"S";"0481";"* ----------------------"
"IDELEGCSEA";"S";"0482";"SI TEMP_DATSUI = LOCA_DATE"
"IDELEGCSEA";"S";"0483";"* Forfait heure"
"IDELEGCSEA";"S";"0484";"   SI HORC_IHINFORFJ <> ""1"""
"IDELEGCSEA";"S";"0485";"      EMPL_IEQSDELCSE = HJOU_IJRASCSE"
"IDELEGCSEA";"S";"0486";"   SINON"
"IDELEGCSEA";"S";"0487";"* Forfait jour"
"IDELEGCSEA";"S";"0488";"      EMPL_IEQSDELCSE = HJOU_IJRASCSEF * 8"
"IDELEGCSEA";"S";"0489";"   FINSI"
"IDELEGCSEA";"S";"0490";"FINSI"
"IDELEGCSEA";"S";"0491";"* ----------"
"IDELEGCSEA";"S";"0492";"* Simulation"
"IDELEGCSEA";"S";"0493";"* ----------"
"IDELEGCSEA";"S";"0494";"DEF CPTG_SOLDECSE T6.2"
"IDELEGCSEA";"S";"0495";"PERGLISS CPTG_SOLDECSE ""060J01"""
"IDELEGCSEA";"S";"0496";"POUR ACTIVITES"
"IDELEGCSEA";"S";"0497";"   SI MOTI_IMIMATRICS <> "" """
"IDELEGCSEA";"S";"0498";"      LOCA_MAT = MOTI_IMIMATRICS"
"IDELEGCSEA";"S";"0499";"      LOCA_MAJD = HABS_MOTIDUR"
"IDELEGCSEA";"S";"0500";"      LOCA_VALO = HABS_VALORIS"
"IDELEGCSEA";"S";"0501";"   FINSI"
"IDELEGCSEA";"S";"0502";"FINPOUR"
"IDELEGCSEA";"S";"0503";"* --------------------------------------------------"
"IDELEGCSEA";"S";"0504";"* Blocage si l'on se transmets des droits à soi-même"
"IDELEGCSEA";"S";"0505";"* --------------------------------------------------"
"IDELEGCSEA";"S";"0506";"SI LOCA_MAT = HJOU_MATRI"
"IDELEGCSEA";"S";"0507";"   TEMP_CNRETOUR = 2"
"IDELEGCSEA";"S";"0508";"   TEMP_CNMESS = 220"
"IDELEGCSEA";"S";"0509";"FINSI"
"IDELEGCSEA";"S";"0510";"* ---------------------------------------"
"IDELEGCSEA";"S";"0511";"* Contrôles spécifiques aux forfaits jour"
"IDELEGCSEA";"S";"0512";"* ---------------------------------------"
"IDELEGCSEA";"S";"0513";"SI HORC_IHINFORFJ = ""1"""
"IDELEGCSEA";"S";"0514";"*"
"IDELEGCSEA";"S";"0515";"* Ils ne peuvent transférer que l'équivalent de jours / demi-journées (multiples de 4)"
"IDELEGCSEA";"S";"0516";"   SI LOCA_MAJD > 0"
"IDELEGCSEA";"S";"0517";"      LOCA_DROIT = LOCA_MAJD / LOCA_DIV"
"IDELEGCSEA";"S";"0518";"      LOCA_RESTE = LOCA_DROIT % 4"
"IDELEGCSEA";"S";"0519";"      SI LOCA_RESTE > 0"
"IDELEGCSEA";"S";"0520";"         TEMP_CNRETOUR = 2"
"IDELEGCSEA";"S";"0521";"         TEMP_CNMESS = 219"
"IDELEGCSEA";"S";"0522";"      FINSI"
"IDELEGCSEA";"S";"0523";"   FINSI"
"IDELEGCSEA";"S";"0524";"* ----------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0525";"* Les forfaits jours ne posent que des délégations en journées ou 1/2 journées"
"IDELEGCSEA";"S";"0526";"* ----------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0527";"   SI LOCA_VALO = ""H"""
"IDELEGCSEA";"S";"0528";"      SI LOCA_MAT = "" """
"IDELEGCSEA";"S";"0529";"         TEMP_CNRETOUR = 2"
"IDELEGCSEA";"S";"0530";"         TEMP_CNMESS = 221"
"IDELEGCSEA";"S";"0531";"      FINSI"
"IDELEGCSEA";"S";"0532";"   FINSI"
"IDELEGCSEA";"S";"0533";"FINSI"
"IDELEGCSEA";"S";"0534";"* ---------"
"IDELEGCSEA";"S";"0535";"FIN"
"IDELEGCSEA";"S";"0536";"PROC RAZCSE"
"IDELEGCSEA";"S";"0537";"   HJOU_IJRADCSE = 0"
"IDELEGCSEA";"S";"0538";"   HJOU_IJRAPCSE = 0"
"IDELEGCSEA";"S";"0539";"   HJOU_IJRATCSE = 0"
"IDELEGCSEA";"S";"0540";"   HJOU_IJRASCSE = 0"
"IDELEGCSEA";"S";"0541";"   HJOU_IJRMDCSE = 0"
"IDELEGCSEA";"S";"0542";"   HJOU_IJRMPCSE = 0"
"IDELEGCSEA";"S";"0543";"   HJOU_IJRMTCSE = 0"
"IDELEGCSEA";"S";"0544";"   HJOU_IJRMSCSE = 0"
"IDELEGCSEA";"S";"0545";"   HJOU_IJRADCSEF = 0"
"IDELEGCSEA";"S";"0546";"   HJOU_IJRAPCSEF = 0"
"IDELEGCSEA";"S";"0547";"   HJOU_IJRATCSEF = 0"
"IDELEGCSEA";"S";"0548";"   HJOU_IJRASCSEF = 0"
"IDELEGCSEA";"S";"0549";"FINPROC"
"IDELEGCSEA";"S";"0550";"* -------------------------------------------"
"IDELEGCSEA";"S";"0551";"* Procédure de calcul des droits forfait jour"
"IDELEGCSEA";"S";"0552";"* -------------------------------------------"
"IDELEGCSEA";"S";"0553";"PROC CALCFJ"
"IDELEGCSEA";"S";"0554";"* --------------------------------------"
"IDELEGCSEA";"S";"0555";"* Durée fixe pour les forfaits jour : 8h"
"IDELEGCSEA";"S";"0556";"* --------------------------------------"
"IDELEGCSEA";"S";"0557";"   LOCA_DROIT = LOCA_DROIT / 8"
"IDELEGCSEA";"S";"0558";"   LOCA_RESTE = LOCA_DROIT % 1"
"IDELEGCSEA";"S";"0559";"   LOCA_DROIT = LOCA_DROIT - LOCA_RESTE"
"IDELEGCSEA";"S";"0560";"   SI LOCA_RESTE > 0"
"IDELEGCSEA";"S";"0561";"      SI LOCA_RESTE < 0.5"
"IDELEGCSEA";"S";"0562";"* -------------------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0563";"* Gestion des arrondis :"
"IDELEGCSEA";"S";"0564";"* si l'on est dans le cas d'un transfert, on majore à la 1/2 journée supérieure"
"IDELEGCSEA";"S";"0565";"* si l'on est dans le cas d'une consigne de MAJ de droit, on minore à la 1/2 inférieure"
"IDELEGCSEA";"S";"0566";"* -------------------------------------------------------------------------------------"
"IDELEGCSEA";"S";"0567";"         SI LOCA_MAJD = 0"
"IDELEGCSEA";"S";"0568";"            LOCA_DROIT = LOCA_DROIT + 0.5"
"IDELEGCSEA";"S";"0569";"         FINSI"
"IDELEGCSEA";"S";"0570";"         ANOMALIE 219"
"IDELEGCSEA";"S";"0571";"      SINON"
"IDELEGCSEA";"S";"0572";"         SI LOCA_RESTE = 0.5"
"IDELEGCSEA";"S";"0573";"            LOCA_DROIT = LOCA_DROIT + 0.5"
"IDELEGCSEA";"S";"0574";"         SINON"
"IDELEGCSEA";"S";"0575";"            SI LOCA_MAJD = 0"
"IDELEGCSEA";"S";"0576";"               LOCA_DROIT = LOCA_DROIT + 1"
"IDELEGCSEA";"S";"0577";"            FINSI"
"IDELEGCSEA";"S";"0578";"            ANOMALIE 219"
"IDELEGCSEA";"S";"0579";"         FINSI"
"IDELEGCSEA";"S";"0580";"      FINSI"
"IDELEGCSEA";"S";"0581";"   FINSI"
"IDELEGCSEA";"S";"0582";"FINPROC"
"IDIMAN";"S";"0001";"***********************************************************************"
"IDIMAN";"S";"0002";"*"
"IDIMAN";"S";"0003";"* Règle : IDIMAN"
"IDIMAN";"S";"0004";"* Ordre : 6020"
"IDIMAN";"S";"0005";"* Titre : Calcul des heures de dimanche"
"IDIMAN";"S";"0006";"*"
"IDIMAN";"S";"0007";"*----------------------------------------------------------------------"
"IDIMAN";"S";"0008";"*"
"IDIMAN";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDIMAN";"S";"0010";"* Date     : 03/09/2009"
"IDIMAN";"S";"0011";"* Version  : 1"
"IDIMAN";"S";"0012";"*"
"IDIMAN";"S";"0013";"*----------------------------------------------------------------------"
"IDIMAN";"S";"0014";"*"
"IDIMAN";"S";"0015";"*"
"IDIMAN";"S";"0016";"* Rôle : Calcul des heures de dimanche"
"IDIMAN";"S";"0017";"*"
"IDIMAN";"S";"0018";"*"
"IDIMAN";"S";"0019";"*"
"IDIMAN";"S";"0020";"*"
"IDIMAN";"S";"0021";"*"
"IDIMAN";"S";"0022";"*----------------------------------------------------------------------"
"IDIMAN";"S";"0023";"*"
"IDIMAN";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IDIMAN";"S";"0025";"* Date         : JJ/MM/AAAA"
"IDIMAN";"S";"0026";"* Objet        :"
"IDIMAN";"S";"0027";"*"
"IDIMAN";"S";"0028";"***********************************************************************"
"IDIMAN";"S";"0029";"*"
"IDIMAN";"S";"0030";"* Implémentation des données industrielles"
"IDIMAN";"S";"0031";"*"
"IDIMAN";"S";"0032";"DEBDICO"
"IDIMAN";"S";"0033";"   HJOU_IJQHDIMTRA;N;T6,2;I;;;    56789;;;V3;""Heures de dimanche"";"
"IDIMAN";"S";"0034";"FINDICO"
"IDIMAN";"S";"0035";"* Déclaration des donnees locales"
"IDIMAN";"S";"0036";"*"
"IDIMAN";"S";"0037";"* Stockage du total des heures dimanches pour"
"IDIMAN";"S";"0038";"* contrôle par rapport à l'écrêtage de la presence"
"IDIMAN";"S";"0039";"DEF LOCA_DIM T6.2"
"IDIMAN";"S";"0040";"LOCA_DIM = 0"
"IDIMAN";"S";"0041";"*"
"IDIMAN";"S";"0042";"SI HJOU_DATE <= TEMP_DATJOU"
"IDIMAN";"S";"0043";"   SI HJOU_JOUR = ""7"""
"IDIMAN";"S";"0044";"      SI HJOU_IJIGBADGEA = ""1"""
"IDIMAN";"S";"0045";"         LOCA_DIM = HJOU_IJQPREJENC"
"IDIMAN";"S";"0046";"         LOCA_DIM = LOCA_DIM + HJOU_IJRPREVEIL"
"IDIMAN";"S";"0047";"         LOCA_DIM = LOCA_DIM - HJOU_IJQECPAUMI"
"IDIMAN";"S";"0048";"* le 23/03 pas de gestion de temps de pause"
"IDIMAN";"S";"0049";"* LOCA_DIM = LOCA_DIM + HJOU_IJQPAUPPLA"
"IDIMAN";"S";"0050";"* LOCA_DIM = LOCA_DIM + HJOU_IJQPAUSPLA"
"IDIMAN";"S";"0051";"* Contrôle de l'écrêtage du profil horaire"
"IDIMAN";"S";"0052";"         SI LOCA_DIM > PROF_ECRJOU"
"IDIMAN";"S";"0053";"            LOCA_DIM = PROF_ECRJOU"
"IDIMAN";"S";"0054";"         FINSI"
"IDIMAN";"S";"0055";"         HJOU_IJQHDIMTRA = LOCA_DIM"
"IDIMAN";"S";"0056";"      SINON"
"IDIMAN";"S";"0057";"         HJOU_IJQHDIMTRA = HJOU_IJQPRESBAV"
"IDIMAN";"S";"0058";"      FINSI"
"IDIMAN";"S";"0059";"   FINSI"
"IDIMAN";"S";"0060";"*"
"IDIMAN";"S";"0061";"*  analyse des consignes"
"IDIMAN";"S";"0062";"*"
"IDIMAN";"S";"0063";"   POUR ACTIVITES"
"IDIMAN";"S";"0064";"      SI HABS_MOTIF = ""XDIM"""
"IDIMAN";"S";"0065";"         HJOU_IJQHDIMTRA = HJOU_IJQHDIMTRA + HABS_MOTIDUR"
"IDIMAN";"S";"0066";"      FINSI"
"IDIMAN";"S";"0067";"      SI HABS_MOTIF = ""ZDIM"""
"IDIMAN";"S";"0068";"         HJOU_IJQHDIMTRA = HABS_MOTIDUR"
"IDIMAN";"S";"0069";"      FINSI"
"IDIMAN";"S";"0070";"   FINPOUR"
"IDIMAN";"S";"0071";"FINSI"
"IDIMAN";"S";"0072";"FIN"
"IDISPHA";"S";"0001";"************************************************************************"
"IDISPHA";"S";"0002";"*"
"IDISPHA";"S";"0003";"* Règle : IDISPHA"
"IDISPHA";"S";"0004";"* Ordre : 7060"
"IDISPHA";"S";"0005";"* Titre : Compteurs disponible en heure"
"IDISPHA";"S";"0006";"*"
"IDISPHA";"S";"0007";"*----------------------------------------------------------------------"
"IDISPHA";"S";"0008";"*"
"IDISPHA";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDISPHA";"S";"0010";"* Date     : 03/09/2009"
"IDISPHA";"S";"0011";"* Version  : 1"
"IDISPHA";"S";"0012";"*"
"IDISPHA";"S";"0013";"*---------------------------------------------------------------------"
"IDISPHA";"S";"0014";"*"
"IDISPHA";"S";"0015";"*"
"IDISPHA";"S";"0016";"* Rôle : Mettre à disposition une règle gérant des compteurs droit/pris/solde"
"IDISPHA";"S";"0017";"*         Mais également des compteurs afin de ne pas avoir à en"
"IDISPHA";"S";"0018";"*         créer de nouveaux et lancer une perso (ex: client en prod,...)"
"IDISPHA";"S";"0019";"*"
"IDISPHA";"S";"0020";"*         Par défaut les différents compteurs ne sont pas affichés"
"IDISPHA";"S";"0021";"*         s'il y a besoin cela devra être fait via la fonction PER"
"IDISPHA";"S";"0022";"*         Les consignes ainsi que le motif de consommation sont à"
"IDISPHA";"S";"0023";"*         créer via la fonction ACT"
"IDISPHA";"S";"0024";"*"
"IDISPHA";"S";"0025";"*"
"IDISPHA";"S";"0026";"* Gestion du Droit/Pris/solde d'un compteur en heure"
"IDISPHA";"S";"0027";"* Le droit est alimenté en début de période de référence définie"
"IDISPHA";"S";"0028";"* dans les données globales datées par une valeur définie dans les"
"IDISPHA";"S";"0029";"* données globales datées"
"IDISPHA";"S";"0030";"* le pris est alimenté par un motif alimenté dans les données globales"
"IDISPHA";"S";"0031";"* datées"
"IDISPHA";"S";"0032";"* Pas de gestion d'anomalie en cas de solde négatif (à créer si besoin)"
"IDISPHA";"S";"0033";"*"
"IDISPHA";"S";"0034";"*----------------------------------------------------------------------"
"IDISPHA";"S";"0035";"*"
"IDISPHA";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPHA";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPHA";"S";"0038";"* Objet        :"
"IDISPHA";"S";"0039";"*"
"IDISPHA";"S";"0040";"***********************************************************************"
"IDISPHA";"S";"0041";"*"
"IDISPHA";"S";"0042";"* Implémentation des données industrielles"
"IDISPHA";"S";"0043";"*"
"IDISPHA";"S";"0044";"DEBDICO"
"IDISPHA";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHA";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPHA";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPHA";"S";"0048";"   * en passant par la fonction PER"
"IDISPHA";"S";"0049";"   HJOU_IJRDHDISPH;N;T8,2;L;;;    56789;;IJRDHDISPH;V3;""Droit en heure disponible 1"";"
"IDISPHA";"S";"0050";"   HJOU_IJRCHDISPH;N;T8,2;L;;;    56789;;IJRCHDISPH;V3;""Pris en heure disponible 1"";"
"IDISPHA";"S";"0051";"   HJOU_IJRSHDISPH;N;T8,2;L;;;    56789;;IJRSHDISPH;V3;""Solde en heure disponible 1"";"
"IDISPHA";"S";"0052";"   EMPL_IEQSPDISH1;N;T8,2;L;;;     6789;;;V3;""Solde prévisionnel en heure disponible 1"";"
"IDISPHA";"S";"0053";"   PARD_IDIDRDISPH;O;D10;X;;;123456789;;;C3;""Date RAZ compteur en heure disponible 1"";"
"IDISPHA";"S";"0054";"   PARD_IDIVDDISPH;O;T8,2;L;;;123456789;;;C3;""Valeur droit heure compteur disponible 1"";"
"IDISPHA";"S";"0055";"   PARD_IDIVMDISPH;O;A10;X;;;123456789;II;;C2;""Motif compteur en heure disponible 1"";"
"IDISPHA";"S";"0056";"FINDICO"
"IDISPHA";"S";"0057";"*"
"IDISPHA";"S";"0058";"* Déclaration des donnees locales"
"IDISPHA";"S";"0059";"*"
"IDISPHA";"S";"0060";"DEF LOCA_DATE D"
"IDISPHA";"S";"0061";"LOCA_DATE = "" """
"IDISPHA";"S";"0062";"DEF LOCA_ACOURS N4"
"IDISPHA";"S";"0063";"LOCA_ACOURS = 0"
"IDISPHA";"S";"0064";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPHA";"S";"0065";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISPH,"
"IDISPHA";"S";"0066";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPHA";"S";"0067";"* par la date souhaitée"
"IDISPHA";"S";"0068";"*"
"IDISPHA";"S";"0069";"** alimentation du droit à la date de référence"
"IDISPHA";"S";"0070";"** raz du consommé à la date de référence"
"IDISPHA";"S";"0071";"SI HJOU_DATE = PARD_IDIDRDISPH"
"IDISPHA";"S";"0072";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHA";"S";"0073";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPHA";"S";"0074";"   * par la durée paramétrée dans PARD_IDIVDDISPH,"
"IDISPHA";"S";"0075";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPHA";"S";"0076";"   * par la durée souhaitée"
"IDISPHA";"S";"0077";"   HJOU_IJRDHDISPH = PARD_IDIVDDISPH"
"IDISPHA";"S";"0078";"   HJOU_IJRCHDISPH = 0"
"IDISPHA";"S";"0079";"FINSI"
"IDISPHA";"S";"0080";"** alimentation du pris"
"IDISPHA";"S";"0081";"POUR ACTIVITES"
"IDISPHA";"S";"0082";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHA";"S";"0083";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISPH,"
"IDISPHA";"S";"0084";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPHA";"S";"0085";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPHA";"S";"0086";"   * pas il devra être créé)"
"IDISPHA";"S";"0087";"   SI HABS_MOTIF = PARD_IDIVMDISPH"
"IDISPHA";"S";"0088";"      HJOU_IJRCHDISPH = HJOU_IJRCHDISPH + HABS_MOTIDUR"
"IDISPHA";"S";"0089";"   FINSI"
"IDISPHA";"S";"0090";"FINPOUR"
"IDISPHA";"S";"0091";"** alimentation du droit/pris par consignes"
"IDISPHA";"S";"0092";"POUR ACTIVITES"
"IDISPHA";"S";"0093";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHA";"S";"0094";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPHA";"S";"0095";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPHA";"S";"0096";"   * en conséquence)"
"IDISPHA";"S";"0097";"   SI HABS_MOTIF = ""ZDDISH"""
"IDISPHA";"S";"0098";"      HJOU_IJRDHDISPH = HABS_MOTIDUR"
"IDISPHA";"S";"0099";"   FINSI"
"IDISPHA";"S";"0100";"   SI HABS_MOTIF = ""XDDISH"""
"IDISPHA";"S";"0101";"      HJOU_IJRDHDISPH = HJOU_IJRDHDISPH + HABS_MOTIDUR"
"IDISPHA";"S";"0102";"   FINSI"
"IDISPHA";"S";"0103";"   SI HABS_MOTIF = ""ZCDISH"""
"IDISPHA";"S";"0104";"      HJOU_IJRCHDISPH = HABS_MOTIDUR"
"IDISPHA";"S";"0105";"   FINSI"
"IDISPHA";"S";"0106";"   SI HABS_MOTIF = ""XCDISH"""
"IDISPHA";"S";"0107";"      HJOU_IJRCHDISPH = HJOU_IJRCHDISPH + HABS_MOTIDUR"
"IDISPHA";"S";"0108";"   FINSI"
"IDISPHA";"S";"0109";"FINPOUR"
"IDISPHA";"S";"0110";"** calcul du solde"
"IDISPHA";"S";"0111";"HJOU_IJRSHDISPH = HJOU_IJRDHDISPH - HJOU_IJRCHDISPH"
"IDISPHA";"S";"0112";"LOCA_ACOURS << PARD_IDIDRDISPH(1:4)"
"IDISPHA";"S";"0113";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPHA";"S";"0114";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPHA";"S";"0115";"LOCA_DATE(5:4) = PARD_IDIDRDISPH(5:4)"
"IDISPHA";"S";"0116";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPHA";"S";"0117";"   EMPL_IEQSPDISH1 = HJOU_IJRSHDISPH"
"IDISPHA";"S";"0118";"FINSI"
"IDISPHA";"S";"0119";"FIN"
"IDISPHB";"S";"0001";"************************************************************************"
"IDISPHB";"S";"0002";"*"
"IDISPHB";"S";"0003";"* Règle : IDISPHB"
"IDISPHB";"S";"0004";"* Ordre : 7070"
"IDISPHB";"S";"0005";"* Titre : Compteurs disponible en heure 2"
"IDISPHB";"S";"0006";"*"
"IDISPHB";"S";"0007";"*----------------------------------------------------------------------"
"IDISPHB";"S";"0008";"*"
"IDISPHB";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDISPHB";"S";"0010";"* Date     : 03/09/2009"
"IDISPHB";"S";"0011";"* Version  : 1"
"IDISPHB";"S";"0012";"*"
"IDISPHB";"S";"0013";"*---------------------------------------------------------------------"
"IDISPHB";"S";"0014";"*"
"IDISPHB";"S";"0015";"*"
"IDISPHB";"S";"0016";"* Rôle : Mettre à disposition une règle gérant des compteurs droit/pris/solde"
"IDISPHB";"S";"0017";"*         Mais également des compteurs afin de ne pas avoir à en"
"IDISPHB";"S";"0018";"*         créer de nouveaux et lancer une perso (ex: client en prod,...)"
"IDISPHB";"S";"0019";"*"
"IDISPHB";"S";"0020";"*         Par défaut les différents compteurs ne sont pas affichés"
"IDISPHB";"S";"0021";"*         s'il y a besoin cela devra être fait via la fonction PER"
"IDISPHB";"S";"0022";"*         Les consignes ainsi que le motif de consommation sont à"
"IDISPHB";"S";"0023";"*         créer via la fonction ACT"
"IDISPHB";"S";"0024";"*"
"IDISPHB";"S";"0025";"*"
"IDISPHB";"S";"0026";"* Gestion du Droit/Pris/solde d'un compteur en heure"
"IDISPHB";"S";"0027";"* Le droit est alimenté en début de période de référence définie"
"IDISPHB";"S";"0028";"* dans les données globales datées par une valeur définie dans les"
"IDISPHB";"S";"0029";"* données globales datées"
"IDISPHB";"S";"0030";"* le pris est alimenté par un motif alimenté dans les données globales"
"IDISPHB";"S";"0031";"* datées"
"IDISPHB";"S";"0032";"* Pas de gestion d'anomalie en cas de solde négatif (à créer si besoin)"
"IDISPHB";"S";"0033";"*"
"IDISPHB";"S";"0034";"*----------------------------------------------------------------------"
"IDISPHB";"S";"0035";"*"
"IDISPHB";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPHB";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPHB";"S";"0038";"* Objet        :"
"IDISPHB";"S";"0039";"*"
"IDISPHB";"S";"0040";"***********************************************************************"
"IDISPHB";"S";"0041";"*"
"IDISPHB";"S";"0042";"* Implémentation des données industrielles"
"IDISPHB";"S";"0043";"*"
"IDISPHB";"S";"0044";"DEBDICO"
"IDISPHB";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHB";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPHB";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPHB";"S";"0048";"   * en passant par la fonction PER"
"IDISPHB";"S";"0049";"   HJOU_IJRDHDISP2;N;T8,2;L;;;    56789;;IJRDHDISP2;V3;""Droit en heure disponible 2"";"
"IDISPHB";"S";"0050";"   HJOU_IJRCHDISP2;N;T8,2;L;;;    56789;;IJRCHDISP2;V3;""Pris en heure disponible 2"";"
"IDISPHB";"S";"0051";"   HJOU_IJRSHDISP2;N;T8,2;L;;;    56789;;IJRSHDISP2;V3;""Solde en heure disponible 2"";"
"IDISPHB";"S";"0052";"   EMPL_IEQSPDISH2;N;T8,2;L;;;     6789;;;V3;""Solde prévisionnel en heure disponible 2"";"
"IDISPHB";"S";"0053";"PARD_IDIDRDISH2;O;D10;X;;;123456789;;;C3;""Date RAZ compteur en heure disponible 2"";"
"IDISPHB";"S";"0054";"PARD_IDIVDDISH2;O;T8,2;L;;;123456789;;;C3;""Valeur droit heure compteur disponible 2"";"
"IDISPHB";"S";"0055";"PARD_IDIVMDISH2;O;A10;X;;;123456789;II;;C2;""Motif compteur en heure disponible 2"";"
"IDISPHB";"S";"0056";"FINDICO"
"IDISPHB";"S";"0057";"*"
"IDISPHC";"S";"0038";"* Objet        :"
"IDISPHB";"S";"0058";"* Déclaration des donnees locales"
"IDISPHB";"S";"0059";"*"
"IDISPHB";"S";"0060";"DEF LOCA_DATE D"
"IDISPHB";"S";"0061";"LOCA_DATE = "" """
"IDISPHB";"S";"0062";"DEF LOCA_ACOURS N4"
"IDISPHB";"S";"0063";"LOCA_ACOURS = 0"
"IDISPHB";"S";"0064";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPHB";"S";"0065";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISH2,"
"IDISPHB";"S";"0066";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPHB";"S";"0067";"* par la date souhaitée"
"IDISPHB";"S";"0068";"*"
"IDISPHB";"S";"0069";"** alimentation du droit à la date de référence"
"IDISPHB";"S";"0070";"** raz du consommé à la date de référence"
"IDISPHB";"S";"0071";"SI HJOU_DATE = PARD_IDIDRDISH2"
"IDISPHB";"S";"0072";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHB";"S";"0073";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPHB";"S";"0074";"   * par la durée paramétrée dans PARD_IDIVDDISH2,"
"IDISPHB";"S";"0075";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPHB";"S";"0076";"   * par la durée souhaitée"
"IDISPHB";"S";"0077";"   HJOU_IJRDHDISP2 = PARD_IDIVDDISH2"
"IDISPHB";"S";"0078";"   HJOU_IJRCHDISP2 = 0"
"IDISPHB";"S";"0079";"FINSI"
"IDISPHB";"S";"0080";"** alimentation du pris"
"IDISPHB";"S";"0081";"POUR ACTIVITES"
"IDISPHB";"S";"0082";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHB";"S";"0083";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISH2,"
"IDISPHB";"S";"0084";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPHB";"S";"0085";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPHB";"S";"0086";"   * pas il devra être créé)"
"IDISPHB";"S";"0087";"   SI HABS_MOTIF = PARD_IDIVMDISH2"
"IDISPHB";"S";"0088";"      HJOU_IJRCHDISP2 = HJOU_IJRCHDISP2 + HABS_MOTIDUR"
"IDISPHB";"S";"0089";"   FINSI"
"IDISPHB";"S";"0090";"FINPOUR"
"IDISPHB";"S";"0091";"** alimentation du droit/pris par consignes"
"IDISPHB";"S";"0092";"POUR ACTIVITES"
"IDISPHB";"S";"0093";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHB";"S";"0094";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPHB";"S";"0095";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPHB";"S";"0096";"   * en conséquence)"
"IDISPHB";"S";"0097";"   SI HABS_MOTIF = ""ZDDIH2"""
"IDISPHB";"S";"0098";"      HJOU_IJRDHDISP2 = HABS_MOTIDUR"
"IDISPHB";"S";"0099";"   FINSI"
"IDISPHB";"S";"0100";"   SI HABS_MOTIF = ""XDDIH2"""
"IDISPHB";"S";"0101";"      HJOU_IJRDHDISP2 = HJOU_IJRDHDISP2 + HABS_MOTIDUR"
"IDISPHB";"S";"0102";"   FINSI"
"IDISPHB";"S";"0103";"   SI HABS_MOTIF = ""ZCDIH2"""
"IDISPHB";"S";"0104";"      HJOU_IJRCHDISP2 = HABS_MOTIDUR"
"IDISPHB";"S";"0105";"   FINSI"
"IDISPHB";"S";"0106";"   SI HABS_MOTIF = ""XCDIH2"""
"IDISPHB";"S";"0107";"      HJOU_IJRCHDISP2 = HJOU_IJRCHDISP2 + HABS_MOTIDUR"
"IDISPHB";"S";"0108";"   FINSI"
"IDISPHB";"S";"0109";"FINPOUR"
"IDISPHB";"S";"0110";"** calcul du solde"
"IDISPHB";"S";"0111";"HJOU_IJRSHDISP2 = HJOU_IJRDHDISP2 - HJOU_IJRCHDISP2"
"IDISPHB";"S";"0112";"LOCA_ACOURS << PARD_IDIDRDISH2(1:4)"
"IDISPHB";"S";"0113";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPHB";"S";"0114";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPHB";"S";"0115";"LOCA_DATE(5:4) = PARD_IDIDRDISH2(5:4)"
"IDISPHB";"S";"0116";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPHB";"S";"0117";"   EMPL_IEQSPDISH2 = HJOU_IJRSHDISP2"
"IDISPHB";"S";"0118";"FINSI"
"IDISPHB";"S";"0119";"FIN"
"IDISPHC";"S";"0001";"************************************************************************"
"IDISPHC";"S";"0002";"*"
"IDISPHC";"S";"0003";"* Règle : IDISPHC"
"IDISPHC";"S";"0004";"* Ordre : 7080"
"IDISPHC";"S";"0005";"* Titre : Compteurs disponible en heure 3"
"IDISPHC";"S";"0006";"*"
"IDISPHC";"S";"0007";"*----------------------------------------------------------------------"
"IDISPHC";"S";"0008";"*"
"IDISPHC";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDISPHC";"S";"0010";"* Date     : 03/09/2009"
"IDISPHC";"S";"0011";"* Version  : 1"
"IDISPHC";"S";"0012";"*"
"IDISPHC";"S";"0013";"*---------------------------------------------------------------------"
"IDISPHC";"S";"0014";"*"
"IDISPHC";"S";"0015";"*"
"IDISPHC";"S";"0016";"* Rôle : Mettre à disposition une règle gérant des compteurs droit/pris/solde"
"IDISPHC";"S";"0017";"*         Mais également des compteurs afin de ne pas avoir à en"
"IDISPHC";"S";"0018";"*         créer de nouveaux et lancer une perso (ex: client en prod,...)"
"IDISPHC";"S";"0019";"*"
"IDISPHC";"S";"0020";"*         Par défaut les différents compteurs ne sont pas affichés"
"IDISPHC";"S";"0021";"*         s'il y a besoin cela devra être fait via la fonction PER"
"IDISPHC";"S";"0022";"*         Les consignes ainsi que le motif de consommation sont à"
"IDISPHC";"S";"0023";"*         créer via la fonction ACT"
"IDISPHC";"S";"0024";"*"
"IDISPHC";"S";"0025";"*"
"IDISPHC";"S";"0026";"* Gestion du Droit/Pris/solde d'un compteur en heure"
"IDISPHC";"S";"0027";"* Le droit est alimenté en début de période de référence définie"
"IDISPHC";"S";"0028";"* dans les données globales datées par une valeur définie dans les"
"IDISPHC";"S";"0029";"* données globales datées"
"IDISPHC";"S";"0030";"* le pris est alimenté par un motif alimenté dans les données globales"
"IDISPHC";"S";"0031";"* datées"
"IDISPHC";"S";"0032";"* Pas de gestion d'anomalie en cas de solde négatif (à créer si besoin)"
"IDISPHC";"S";"0033";"*"
"IDISPHC";"S";"0034";"*----------------------------------------------------------------------"
"IDISPHC";"S";"0035";"*"
"IDISPHC";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPHC";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPHC";"S";"0039";"*"
"IDISPHC";"S";"0040";"***********************************************************************"
"IDISPHC";"S";"0041";"*"
"IDISPHC";"S";"0042";"* Implémentation des données industrielles"
"IDISPHC";"S";"0043";"*"
"IDISPHC";"S";"0044";"DEBDICO"
"IDISPHC";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHC";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPHC";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPHC";"S";"0048";"   * en passant par la fonction PER"
"IDISPHC";"S";"0049";"   HJOU_IJRDHDISP3;N;T8,2;L;;;    56789;;IJRDHDISP3;V3;""Droit en heure disponible 3"";"
"IDISPHC";"S";"0050";"   HJOU_IJRCHDISP3;N;T8,2;L;;;    56789;;IJRCHDISP3;V3;""Pris en heure disponible3"";"
"IDISPHC";"S";"0051";"   HJOU_IJRSHDISP3;N;T8,2;L;;;    56789;;IJRSHDISP3;V3;""Solde en heure disponible 3"";"
"IDISPHC";"S";"0052";"   EMPL_IEQSPDISH3;N;T8,2;L;;;     6789;;;V3;""Solde prévisionnel en heure disponible 3"";"
"IDISPHC";"S";"0053";"PARD_IDIDRDISH3;O;D10;X;;;123456789;;;C3;""Date RAZ compteur en heure disponible3"";"
"IDISPHC";"S";"0054";"PARD_IDIVDDISH3;O;T8,2;L;;;123456789;;;C3;""Valeur droit heure compteur disponible 3"";"
"IDISPHC";"S";"0055";"PARD_IDIVMDISH3;O;A10;X;;;123456789;II;;C2;""Motif compteur en heure disponible 3"";"
"IDISPHC";"S";"0056";"FINDICO"
"IDISPHC";"S";"0057";"*"
"IDISPHC";"S";"0058";"* Déclaration des donnees locales"
"IDISPHC";"S";"0059";"*"
"IDISPHC";"S";"0060";"DEF LOCA_DATE D"
"IDISPHC";"S";"0061";"LOCA_DATE = "" """
"IDISPHC";"S";"0062";"DEF LOCA_ACOURS N4"
"IDISPHC";"S";"0063";"LOCA_ACOURS = 0"
"IDISPHC";"S";"0064";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPHC";"S";"0065";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISH3,"
"IDISPHC";"S";"0066";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPHC";"S";"0067";"* par la date souhaitée"
"IDISPHC";"S";"0068";"*"
"IDISPHC";"S";"0069";"** alimentation du droit à la date de référence"
"IDISPHC";"S";"0070";"** raz du consommé à la date de référence"
"IDISPHC";"S";"0071";"SI HJOU_DATE = PARD_IDIDRDISH3"
"IDISPHC";"S";"0072";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHC";"S";"0073";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPHC";"S";"0074";"   * par la durée paramétrée dans PARD_IDIVDDISH3,"
"IDISPHC";"S";"0075";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPHC";"S";"0076";"   * par la durée souhaitée"
"IDISPHC";"S";"0077";"   HJOU_IJRDHDISP3 = PARD_IDIVDDISH3"
"IDISPHC";"S";"0078";"   HJOU_IJRCHDISP3 = 0"
"IDISPHC";"S";"0079";"FINSI"
"IDISPHC";"S";"0080";"** alimentation du pris"
"IDISPHC";"S";"0081";"POUR ACTIVITES"
"IDISPHC";"S";"0082";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHC";"S";"0083";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISH3,"
"IDISPHC";"S";"0084";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPHC";"S";"0085";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPHC";"S";"0086";"   * pas il devra être créé)"
"IDISPHC";"S";"0087";"   SI HABS_MOTIF = PARD_IDIVMDISH3"
"IDISPHC";"S";"0088";"      HJOU_IJRCHDISP3 = HJOU_IJRCHDISP3 + HABS_MOTIDUR"
"IDISPHC";"S";"0089";"   FINSI"
"IDISPHC";"S";"0090";"FINPOUR"
"IDISPHC";"S";"0091";"** alimentation du droit/pris par consignes"
"IDISPHC";"S";"0092";"POUR ACTIVITES"
"IDISPHC";"S";"0093";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHC";"S";"0094";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPHC";"S";"0095";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPHC";"S";"0096";"   * en conséquence)"
"IDISPHC";"S";"0097";"   SI HABS_MOTIF = ""ZDDIH3"""
"IDISPHC";"S";"0098";"      HJOU_IJRDHDISP3 = HABS_MOTIDUR"
"IDISPHC";"S";"0099";"   FINSI"
"IDISPHC";"S";"0100";"   SI HABS_MOTIF = ""XDDIH3"""
"IDISPHC";"S";"0101";"      HJOU_IJRDHDISP3 = HJOU_IJRDHDISP3 + HABS_MOTIDUR"
"IDISPHC";"S";"0102";"   FINSI"
"IDISPHC";"S";"0103";"   SI HABS_MOTIF = ""ZCDIH3"""
"IDISPHC";"S";"0104";"      HJOU_IJRCHDISP3 = HABS_MOTIDUR"
"IDISPHC";"S";"0105";"   FINSI"
"IDISPHC";"S";"0106";"   SI HABS_MOTIF = ""XCDIH3"""
"IDISPHC";"S";"0107";"      HJOU_IJRCHDISP3 = HJOU_IJRCHDISP3 + HABS_MOTIDUR"
"IDISPHC";"S";"0108";"   FINSI"
"IDISPHC";"S";"0109";"FINPOUR"
"IDISPHC";"S";"0110";"** calcul du solde"
"IDISPHC";"S";"0111";"HJOU_IJRSHDISP3 = HJOU_IJRDHDISP3 - HJOU_IJRCHDISP3"
"IDISPHC";"S";"0112";"LOCA_ACOURS << PARD_IDIDRDISH3(1:4)"
"IDISPHC";"S";"0113";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPHC";"S";"0114";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPHC";"S";"0115";"LOCA_DATE(5:4) = PARD_IDIDRDISH3(5:4)"
"IDISPHC";"S";"0116";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPHC";"S";"0117";"   EMPL_IEQSPDISH3 = HJOU_IJRSHDISP3"
"IDISPHC";"S";"0118";"FINSI"
"IDISPHC";"S";"0119";"FIN"
