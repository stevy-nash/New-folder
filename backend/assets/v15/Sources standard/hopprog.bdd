"ICONSCPCH";"S";"0501";"                     FINSI"
"ICONSCPCH";"S";"0502";"                  SINON"
"ICONSCPCH";"S";"0503";"* Avec jour travaillé/non travaillé"
"ICONSCPCH";"S";"0504";"* Journée non travaillé"
"ICONSCPCH";"S";"0505";"                     SI HJOU_IJQPRETHEJ = 0"
"ICONSCPCH";"S";"0506";"* Pris dans non travaillé"
"ICONSCPCH";"S";"0507";"                        SI HJOU_IJRSCPNTRA >= LOCA_VAL"
"ICONSCPCH";"S";"0508";"                           HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + LOCA_VAL"
"ICONSCPCH";"S";"0509";"                           HJOU_IJRSCPNTRA = HJOU_IJRSCPNTRA - LOCA_VAL"
"ICONSCPCH";"S";"0510";"*"
"ICONSCPCH";"S";"0511";"                           HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + LOCA_VAL"
"ICONSCPCH";"S";"0512";"                           HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_VAL"
"ICONSCPCH";"S";"0513";"*"
