"IABSGAEV";"S";"0160";"        *"
"IABSGAEV";"S";"0161";"        SI LOCA_MOT1 <> "" """
"IABSGAEV";"S";"0162";"            ENLEVER LOCA_MOT1 LOCA_VALO1"
"IABSGAEV";"S";"0163";"        FINSI"
"IABSGAEV";"S";"0164";"        SI LOCA_MOT2 <> "" """
