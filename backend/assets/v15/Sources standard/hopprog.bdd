"ICHEVM";"S";"0044";"*"
"ICHEVM";"S";"0045";"* Déclaration des donnees locales"
"ICHEVM";"S";"0046";"*"
"ICHEVM";"S";"0047";"DEF LOCA_MVT0 N1"
"ICHEVM";"S";"0048";"LOCA_MVT0 = 0"
"ICHEVM";"S";"0049";"SI HJOU_DATE <= TEMP_DATJOU"
"ICHEVM";"S";"0050";"   POUR POINTAGES"
"ICHEVM";"S";"0051";"      SI LOCA_MVT0 = 0"
"ICHEVM";"S";"0052";"         HJOU_IJQMVTENT1 = POIN_HRETRAI"
"ICHEVM";"S";"0053";"         LOCA_MVT0 = 1"
"ICHEVM";"S";"0054";"*"
"ICHEVM";"S";"0055";"* cas ou le premier pointage de la journée est à 0.00"
"ICHEVM";"S";"0056";"*"
"ICHEVM";"S";"0057";"         SI HJOU_IJQMVTENT1 = 0"
"ICHEVM";"S";"0058";"            HJOU_IJQMVTENT1 = 100"
"ICHEVM";"S";"0059";"         FINSI"
"ICHEVM";"S";"0060";"*"
"ICHEVM";"S";"0061";"      SINON"
"ICHEVM";"S";"0062";"         SI HJOU_IJQMVTSOR1 = 0"
"ICHEVM";"S";"0063";"            HJOU_IJQMVTSOR1 = POIN_HRETRAI"
"ICHEVM";"S";"0064";"         SINON"
"ICHEVM";"S";"0065";"            SI HJOU_IJQMVTENT2 = 0"
"ICHEVM";"S";"0066";"               HJOU_IJQMVTENT2 = POIN_HRETRAI"
"ICHEVM";"S";"0067";"            SINON"
"ICHEVM";"S";"0068";"               SI HJOU_IJQMVTSOR2 = 0"
"ICHEVM";"S";"0069";"                  HJOU_IJQMVTSOR2 = POIN_HRETRAI"
"ICHEVM";"S";"0070";"               SINON"
"ICHEVM";"S";"0071";"                  SI HJOU_IJQMVTENT3 = 0"
"ICHEVM";"S";"0072";"                     HJOU_IJQMVTENT3 = POIN_HRETRAI"
"ICHEVM";"S";"0073";"                  SINON"
"ICHEVM";"S";"0074";"                     SI HJOU_IJQMVTSOR3 = 0"
"ICHEVM";"S";"0075";"                        HJOU_IJQMVTSOR3 = POIN_HRETRAI"
"ICHEVM";"S";"0076";"                     SINON"
"ICHEVM";"S";"0077";"                        SI HJOU_IJQMVTENT4 = 0"
