"IACQCPAN1M";"S";"0038";"*"
"IACQCPAN1M";"S";"0039";"DEBDICO"
"IACQCPAN1M";"S";"0040";"   HJOU_IJRDCOANCI;N;N5,1;I;;;    56789;;IJRDCOANCI;V3;""Droit congé ancienneté"";"
"IACQCPAN1M";"S";"0041";"   HJOU_IJRCCOANCI;N;N5,1;I;;;    56789;;IJRCCOANCI;V3;""Congé ancienneté pris"";"
"IACQCPAN1M";"S";"0042";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"IACQCPAN1M";"S";"0043";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"IACQCPAN1M";"S";"0044";"   *********"
"IACQCPAN1M";"S";"0045";"   HJOU_IJIREGCPAN;O;Z1;X;;;123456789;L;;C2;""Régime des congés d'ancienneté"";"
"IACQCPAN1M";"S";"0046";"   SECH_ISISANC1;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 1 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0047";"   SECH_ISISANC2;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 2 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0048";"   SECH_ISISANC3;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 3 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0049";"   SECH_ISISANC4;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 4 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0050";"   SECH_ISISANC5;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 5 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0051";"   SECH_ISISANC6;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 6 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0052";"   SECH_ISIDCANC1;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 1 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0053";"   SECH_ISIDCANC2;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 2 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0054";"   SECH_ISIDCANC3;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 3 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0055";"   SECH_ISIDCANC4;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 4 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0056";"   SECH_ISIDCANC5;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 5 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0057";"   SECH_ISIDCANC6;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 6 ""RÉGIME 1"""";"
"IACQCPAN1M";"S";"0058";"   SECH_ISISANNC1;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 1 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0059";"   SECH_ISISANNC2;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 2 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0060";"   SECH_ISISANNC3;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 3 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0061";"   SECH_ISISANNC4;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 4 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0062";"   SECH_ISISANNC5;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 5 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0063";"   SECH_ISISANNC6;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 6 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0064";"   SECH_ISIDCANNC1;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 1 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0065";"   SECH_ISIDCANNC2;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 2 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0066";"   SECH_ISIDCANNC3;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 3 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0067";"   SECH_ISIDCANNC4;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 4 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0068";"   SECH_ISIDCANNC5;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 5 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0069";"   SECH_ISIDCANNC6;O;N4,1;I;;;123456789;;;C3;""Droit congés ancienneté 6 ""RÉGIME 2"""";"
"IACQCPAN1M";"S";"0070";"FINDICO"
"IACQCPAN1M";"S";"0071";"*"
"IACQCPAN1M";"S";"0072";"DEBANO"
"IACQCPAN1M";"S";"0073";"   168;8;""Solde congés ancienneté insuffisant"";"
