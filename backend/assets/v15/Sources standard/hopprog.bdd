"IACQCPAN1";"S";"0038";"*"
"IACQCPAN1";"S";"0039";"DEBDICO"
"IACQCPAN1";"S";"0040";"   HJOU_IJRDCOANCI;N;N5,1;I;;;    56789;;IJRDCOANCI;V3;""Droit congé ancienneté"";"
"IACQCPAN1";"S";"0041";"   HJOU_IJRCCOANCI;N;N5,1;I;;;    56789;;IJRCCOANCI;V3;""Congé ancienneté pris"";"
"IACQCPAN1";"S";"0042";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"IACQCPAN1";"S";"0043";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"IACQCPAN1";"S";"0044";"   *********"
"IACQCPAN1";"S";"0045";"   HJOU_IJIREGCPAN;O;Z1;X;;;123456789;L;;C2;""Régime des congés d'ancienneté"";"
"IACQCPAN1";"S";"0046";"   PARD_IDISANC1;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 1 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0047";"   PARD_IDISANC2;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 2 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0048";"   PARD_IDISANC3;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 3 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0049";"   PARD_IDISANC4;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 4 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0050";"   PARD_IDISANC5;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 5 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0051";"   PARD_IDISANC6;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 6 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0052";"   PARD_IDIDCANC1;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 1 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0053";"   PARD_IDIDCANC2;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 2 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0054";"   PARD_IDIDCANC3;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 3 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0055";"   PARD_IDIDCANC4;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 4 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0056";"   PARD_IDIDCANC5;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 5 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0057";"   PARD_IDIDCANC6;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 6 ""RÉGIME 1"""";"
"IACQCPAN1";"S";"0058";"   PARD_IDISANNC1;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 1 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0059";"   PARD_IDISANNC2;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 2 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0060";"   PARD_IDISANNC3;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 3 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0061";"   PARD_IDISANNC4;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 4 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0062";"   PARD_IDISANNC5;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 5 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0063";"   PARD_IDISANNC6;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 6 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0064";"   PARD_IDIDCANNC1;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 1 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0065";"   PARD_IDIDCANNC2;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 2 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0066";"   PARD_IDIDCANNC3;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 3 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0067";"   PARD_IDIDCANNC4;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 4 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0068";"   PARD_IDIDCANNC5;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 5 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0069";"   PARD_IDIDCANNC6;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 6 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0070";"FINDICO"
"IACQCPAN1";"S";"0071";"*"
