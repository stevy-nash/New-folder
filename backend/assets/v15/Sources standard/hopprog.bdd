"IGCSEGLISS";"S";"0006";"*"
"IGCSEGLISS";"S";"0007";"*----------------------------------------------------------------------"
"IGCSEGLISS";"S";"0008";"*"
"IGCSEGLISS";"S";"0009";"* Créé par : Méthodes et outils"
"IGCSEGLISS";"S";"0010";"* Date     : 19/12/2018"
"IGCSEGLISS";"S";"0011";"* Version  : 1"
"IGCSEGLISS";"S";"0012";"*"
"IGCSEGLISS";"S";"0013";"*----------------------------------------------------------------------"
"IGCSEGLISS";"S";"0014";"*"
"IGCSEGLISS";"S";"0015";"*"
"IGCSEGLISS";"S";"0016";"* Rôle : Gestion des délégations CS avec report des compteurs sur 12"
"IGCSEGLISS";"S";"0017";"*        mois glissants."
"IGCSEGLISS";"S";"0018";"*"
"IGCSEGLISS";"S";"0019";"*"
"IGCSEGLISS";"S";"0020";"*"
"IGCSEGLISS";"S";"0021";"*----------------------------------------------------------------------"
"IGCSEGLISS";"S";"0022";"*"
"IGCSEGLISS";"S";"0023";"* Modifiée par : Méthodes et outils"
"IGCSEGLISS";"S";"0024";"* Date         : 27/05/2019"
"IGCSEGLISS";"S";"0025";"* Objet        : Ajout du taux de majoration maxi dans PARD afin"
"IGCSEGLISS";"S";"0105";"DEF LOCA_ACOURS N4"
"IGCSEGLISS";"S";"0026";"*                 qu'il soit paramétrable"
"IGCSEGLISS";"S";"0027";"*"
"IGCSEGLISS";"S";"0028";"***********************************************************************"
"IGCSEGLISS";"S";"0029";"*"
"IGCSEGLISS";"S";"0030";"* Implémentation des données industrielles"
"IGCSEGLISS";"S";"0031";"*"
"IGCSEGLISS";"S";"0032";"DEBDICO"
"IGCSEGLISS";"S";"0033";"   HJOU_IJIDFIN;O;D10;X;;;   456789;;;C2;""Fin de mandat délégation"";"
"IGCSEGLISS";"S";"0034";"   HJOU_IJRADCSE;N;T6,2;L;;;   456789;;IJRADCSE;V3;""Droit annuel réel (H)"";"
"IGCSEGLISS";"S";"0035";"   HJOU_IJIDACSET;O;T6,2;L;;;   456789;;;C3;""Droit annuel théorique (H)"";"
"IGCSEGLISS";"S";"0036";"   HJOU_IJIDACSEM;O;T6,2;L;;;   456789;;;C3;""Droit annuel mandat theo (H)"";"
"IGCSEGLISS";"S";"0037";"   HJOU_IJRAPCSE;N;T6,2;L;;;   456789;;IJRAPCSE;V3;""Pris annuel (H)"";"
"IGCSEGLISS";"S";"0038";"   HJOU_IJRATCSE;N;T6,2;L;;;   456789;;IJRATCSE;V3;""Transfert annuel (H)"";"
"IGCSEGLISS";"S";"0039";"   HJOU_IJRASCSE;N;T6,2;L;;;   456789;;IJRASCSE;V3;""Solde annuel (H)"";"
"IGCSEGLISS";"S";"0040";"   HJOU_IJRMDCSE;N;T6,2;I;;;   456789;;IJRMDCSE;V3;""Droit mensuel (H)"";"
"IGCSEGLISS";"S";"0041";"   HJOU_IJRMPCSE;N;T6,2;I;;;   456789;;IJRMPCSE;V3;""Pris mensuel (H)"";"
"IGCSEGLISS";"S";"0042";"   HJOU_IJRMTCSE;N;T6,2;I;;;   456789;;IJRMTCSE;V3;""Transfert mensuel (H)"";"
"IGCSEGLISS";"S";"0043";"   HJOU_IJRMSCSE;N;T6,2;I;;;   456789;;IJRMSCSE;V3;""Solde mensuel (H)"";"
"IGCSEGLISS";"S";"0044";"   HJOU_IJRADCSEF;N;N6,2;I;;;   456789;;IJRADCSEF;V3;""Droit CSE (forfait jour)"";"
"IGCSEGLISS";"S";"0045";"   HJOU_IJRAPCSEF;N;N6,2;I;;;   456789;;IJRAPCSEF;V3;""Pris CSE (forfait jour)"";"
"IGCSEGLISS";"S";"0046";"   HJOU_IJRATCSEF;N;N6,2;I;;;   456789;;IJRATCSEF;V3;""Transfert CSE (forfait jour)"";"
"IGCSEGLISS";"S";"0047";"   HJOU_IJRASCSEF;N;N6,2;I;;;   456789;;IJRASCSEF;V3;""Solde CSE (forfait jour)"";"
"IGCSEGLISS";"S";"0048";"   *Compteurs glissants"
"IGCSEGLISS";"S";"0049";"   HJOU_IJRMDCSE1;N;T6,2;I;;;   456789;;IJRMDCSE1;V3;""Droit mensuel M-1 (H)"";"
"IGCSEGLISS";"S";"0050";"   HJOU_IJRMDCSE10;N;T6,2;I;;;   456789;;IJRMDCSE10;V3;""Droit mensuel M-10 (H)"";"
"IGCSEGLISS";"S";"0051";"   HJOU_IJRMDCSE11;N;T6,2;I;;;   456789;;IJRMDCSE11;V3;""Droit mensuel M-11 (H)"";"
"IGCSEGLISS";"S";"0052";"   HJOU_IJRMDCSE2;N;T6,2;I;;;   456789;;IJRMDCSE2;V3;""Droit mensuel M-2 (H)"";"
"IGCSEGLISS";"S";"0053";"   HJOU_IJRMDCSE3;N;T6,2;I;;;   456789;;IJRMDCSE3;V3;""Droit mensuel M-3 (H)"";"
"IGCSEGLISS";"S";"0054";"   HJOU_IJRMDCSE4;N;T6,2;I;;;   456789;;IJRMDCSE4;V3;""Droit mensuel M-4 (H)"";"
"IGCSEGLISS";"S";"0055";"   HJOU_IJRMDCSE5;N;T6,2;I;;;   456789;;IJRMDCSE5;V3;""Droit mensuel M-5 (H)"";"
"IGCSEGLISS";"S";"0056";"   HJOU_IJRMDCSE6;N;T6,2;I;;;   456789;;IJRMDCSE6;V3;""Droit mensuel M-6 (H)"";"
"IGCSEGLISS";"S";"0057";"   HJOU_IJRMDCSE7;N;T6,2;I;;;   456789;;IJRMDCSE7;V3;""Droit mensuel M-7 (H)"";"
"IGCSEGLISS";"S";"0058";"   HJOU_IJRMDCSE8;N;T6,2;I;;;   456789;;IJRMDCSE8;V3;""Droit mensuel M-8 (H)"";"
"IGCSEGLISS";"S";"0059";"   HJOU_IJRMDCSE9;N;T6,2;I;;;   456789;;IJRMDCSE9;V3;""Droit mensuel M-9 (H)"";"
"IGCSEGLISS";"S";"0060";"   *Pour déclencher l'anomalie en cas de dépassement du max mensuel"
"IGCSEGLISS";"S";"0061";"   HJOU_IJRCUPMCSE;N;T6,2;I;;;   456789;;IJRCUPMCSE;V3;""Cumul pris mensuel (H)"";"
"IGCSEGLISS";"S";"0062";"   MOTI_IMIMATRICS;O;A10;X;;;   456789;IH;;C2;""Matricule à créditer CSE"";"
"IGCSEGLISS";"S";"0063";"   EMPL_IEQSDELCSE;N;T6,2;L;;;     6789;;;V3;""Solde délégation CSE"";"
"IGCSEGLISS";"S";"0064";"   HORC_IHINFORFJ;O;Z1;X;0;1;123456789;C;;C2;""Forfait jour CSE"";"
"IGCSEGLISS";"S";"0065";"   PARD_IDIMAJOCSE;O;N3,1;I;0;;123456789;;;C3;""Taux de majoration maxi droit CSE"";"
"IGCSEGLISS";"S";"0066";"   EMPL_IEIMEMBCSE;O;A1;X;;;123456789;L8;;C3;""Membre CSE"";"
"IGCSEGLISS";"S";"0067";"FINDICO"
"IGCSEGLISS";"S";"0068";"*"
"IGCSEGLISS";"S";"0069";"DEBANO"
"IGCSEGLISS";"S";"0070";"   215;7;""Solde mensuel délégation CSE négatif"";"
"IGCSEGLISS";"S";"0071";"   216;7;""Dépassement du droit maximum CSE mensuel"";"
"IGCSEGLISS";"S";"0072";"   217;7;""Solde annuel délégation CSE négatif"";"
"IGCSEGLISS";"S";"0073";"   218;7;""Dépassement du droit maximum CSE annuel"";"
"IGCSEGLISS";"S";"0074";"   219;7;""La valeur du CSE transféré doit être un multiple de 4"";"
"IGCSEGLISS";"S";"0075";"   220;7;""Le transfert doit se faire vers un matricule différent de celui du donateur"";"
"IGCSEGLISS";"S";"0076";"   221;7;""Valorisation en heures interdite aux forfaits jour"";"
"IGCSEGLISS";"S";"0077";"   401;7;""Dépassement des droits maxi mensuel"";"
"IGCSEGLISS";"S";"0078";"FINANO"
"IGCSEGLISS";"S";"0079";"* -------------------------------"
"IGCSEGLISS";"S";"0080";"* Déclaration des donnees locales"
"IGCSEGLISS";"S";"0081";"* -------------------------------"
"IGCSEGLISS";"S";"0082";"DEF LOCA_DTMAX T6.2"
"IGCSEGLISS";"S";"0083";"LOCA_DTMAX = 0"
"IGCSEGLISS";"S";"0084";"* --------------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0085";"* Locale permettant de déterminer s'il y a une consigne impactant le droit mensuel"
"IGCSEGLISS";"S";"0086";"* --------------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0087";"DEF LOCA_MENS N1"
"IGCSEGLISS";"S";"0088";"LOCA_MENS = 0"
"IGCSEGLISS";"S";"0089";"DEF LOCA_MENS2 N1"
"IGCSEGLISS";"S";"0090";"LOCA_MENS2 = 0"
"IGCSEGLISS";"S";"0091";"DEF LOCA_MAJO N1"
"IGCSEGLISS";"S";"0092";"LOCA_MAJO = 0"
"IGCSEGLISS";"S";"0093";"* -------------------------------------------------------------"
"IGCSEGLISS";"S";"0094";"* Locale permettant de calculer le droit pour les forfaits jour"
"IGCSEGLISS";"S";"0095";"* -------------------------------------------------------------"
"IGCSEGLISS";"S";"0096";"DEF LOCA_MAJD T6.2"
"IGCSEGLISS";"S";"0097";"LOCA_MAJD = 0"
"IGCSEGLISS";"S";"0098";"* --------------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0099";"* Locale permettant de calculer le nbre de jours transférés pour les forfaits jour"
"IGCSEGLISS";"S";"0100";"* --------------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0101";"DEF LOCA_MAJT T6.2"
"IGCSEGLISS";"S";"0102";"LOCA_MAJT = 0"
"IGCSEGLISS";"S";"0103";"DEF LOCA_DATE D"
"IGCSEGLISS";"S";"0104";"LOCA_DATE = "" """
"IGCSEGLISS";"S";"0106";"LOCA_ACOURS = 0"
"IGCSEGLISS";"S";"0107";"DEF LOCA_DATEFIN D"
"IGCSEGLISS";"S";"0108";"LOCA_DATEFIN = "" """
"IGCSEGLISS";"S";"0109";"DEF LOCA_DROIT N7.3"
"IGCSEGLISS";"S";"0110";"LOCA_DROIT = 0"
"IGCSEGLISS";"S";"0111";"DEF LOCA_MAT A10"
"IGCSEGLISS";"S";"0112";"LOCA_MAT = "" """
"IGCSEGLISS";"S";"0113";"DEF LOCA_VALO A1"
"IGCSEGLISS";"S";"0114";"LOCA_VALO = "" """
"IGCSEGLISS";"S";"0115";"* ----------------------------------------------------"
"IGCSEGLISS";"S";"0116";"* Coefficient appliqué pour le calcul de la majoration"
"IGCSEGLISS";"S";"0117";"* ----------------------------------------------------"
"IGCSEGLISS";"S";"0118";"DEF LOCA_TAUX N4.1"
"IGCSEGLISS";"S";"0119";"LOCA_TAUX = PARD_IDIMAJOCSE"
"IGCSEGLISS";"S";"0120";"DEF LOCA_DIV T6.2"
"IGCSEGLISS";"S";"0121";"LOCA_DIV = 1.00"
"IGCSEGLISS";"S";"0122";"DEF LOCA_RESTE N7.3"
"IGCSEGLISS";"S";"0123";"LOCA_RESTE = 0"
"IGCSEGLISS";"S";"0124";"DEF LOCA_RESTET T8.2"
"IGCSEGLISS";"S";"0125";"LOCA_RESTET = 0"
"IGCSEGLISS";"S";"0126";"DEF LOCA_MOINS1 N2"
"IGCSEGLISS";"S";"0127";"LOCA_MOINS1 = -1"
"IGCSEGLISS";"S";"0128";"DEF LOCA_CONSORELI N1"
"IGCSEGLISS";"S";"0129";"LOCA_CONSORELI = 0"
"IGCSEGLISS";"S";"0130";"DEF LOCA_CONSO N1"
"IGCSEGLISS";"S";"0131";"LOCA_CONSO = 0"
"IGCSEGLISS";"S";"0132";"****************************"
"IGCSEGLISS";"S";"0133";"* maximum mensuel (par défaut 1,5 fois le 12ième ANNUEL)"
"IGCSEGLISS";"S";"0134";"DEF LOCA_MAXM T8.2"
"IGCSEGLISS";"S";"0135";"LOCA_MAXM = HJOU_IJIDACSEM / 12"
"IGCSEGLISS";"S";"0136";"LOCA_MAXM = LOCA_MAXM * PARD_IDIMAJOCSE"
"IGCSEGLISS";"S";"0137";"* droit et transfert"
"IGCSEGLISS";"S";"0138";"DEF LOCA_DRTR T8.2"
"IGCSEGLISS";"S";"0139";"LOCA_DRTR = 0"
"IGCSEGLISS";"S";"0140";"* droit et pris"
"IGCSEGLISS";"S";"0141";"DEF LOCA_DRPR T8.2"
"IGCSEGLISS";"S";"0142";"LOCA_DRPR = 0"
"IGCSEGLISS";"S";"0143";"*CSE en jour"
"IGCSEGLISS";"S";"0144";"DEF LOCA_MENSJ N1"
"IGCSEGLISS";"S";"0145";"LOCA_MENSJ = 0"
"IGCSEGLISS";"S";"0146";"* --------------------------------"
"IGCSEGLISS";"S";"0147";"* Calcul de la date prévisionnelle"
"IGCSEGLISS";"S";"0148";"* --------------------------------"
"IGCSEGLISS";"S";"0149";"LOCA_DATE(5:4) = HJOU_IJIDFIN(5:4)"
"IGCSEGLISS";"S";"0150";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IGCSEGLISS";"S";"0151";"SI TEMP_DATJOU(5:4) > HJOU_IJIDFIN(5:4)"
"IGCSEGLISS";"S";"0152";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"IGCSEGLISS";"S";"0153";"FINSI"
"IGCSEGLISS";"S";"0154";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IGCSEGLISS";"S";"0155";"*"
"IGCSEGLISS";"S";"0156";"SI HJOU_DATE <= HJOU_IJIDFIN"
"IGCSEGLISS";"S";"0157";"* --------------"
"IGCSEGLISS";"S";"0158";"* Forfait heures"
"IGCSEGLISS";"S";"0159";"* --------------"
"IGCSEGLISS";"S";"0160";"   SI HORC_IHINFORFJ <> ""1"""
"IGCSEGLISS";"S";"0161";"* la période retenue est la période d'annualisation"
"IGCSEGLISS";"S";"0162";"      SI HJOU_DATE = PARD_IDIDDEBANN"
"IGCSEGLISS";"S";"0163";"         HJOU_IJRADCSE = 0"
"IGCSEGLISS";"S";"0164";"         HJOU_IJRAPCSE = 0"
"IGCSEGLISS";"S";"0165";"         HJOU_IJRATCSE = 0"
"IGCSEGLISS";"S";"0166";"         HJOU_IJRASCSE = 0"
"IGCSEGLISS";"S";"0167";"      FINSI"
"IGCSEGLISS";"S";"0168";"* -------------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0169";"* Initialisation du droit et remise à 0 des compteurs pris et transférés mensuels"
"IGCSEGLISS";"S";"0170";"* -------------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0171";"      SI HJOU_DATE(7:2) = ""01"""
"IGCSEGLISS";"S";"0172";"*RAZ du cumul pris mensuel"
"IGCSEGLISS";"S";"0173";"         HJOU_IJRCUPMCSE = 0"
"IGCSEGLISS";"S";"0174";"*"
"IGCSEGLISS";"S";"0175";"         HJOU_IJRMDCSE11 = HJOU_IJRMDCSE10"
"IGCSEGLISS";"S";"0176";"         HJOU_IJRMDCSE10 = HJOU_IJRMDCSE9"
"IGCSEGLISS";"S";"0177";"         HJOU_IJRMDCSE9 = HJOU_IJRMDCSE8"
"IGCSEGLISS";"S";"0178";"         HJOU_IJRMDCSE8 = HJOU_IJRMDCSE7"
"IGCSEGLISS";"S";"0179";"         HJOU_IJRMDCSE7 = HJOU_IJRMDCSE6"
"IGCSEGLISS";"S";"0180";"         HJOU_IJRMDCSE6 = HJOU_IJRMDCSE5"
"IGCSEGLISS";"S";"0181";"         HJOU_IJRMDCSE5 = HJOU_IJRMDCSE4"
"IGCSEGLISS";"S";"0182";"         HJOU_IJRMDCSE4 = HJOU_IJRMDCSE3"
"IGCSEGLISS";"S";"0183";"         HJOU_IJRMDCSE3 = HJOU_IJRMDCSE2"
"IGCSEGLISS";"S";"0184";"         HJOU_IJRMDCSE2 = HJOU_IJRMDCSE1"
"IGCSEGLISS";"S";"0185";"         HJOU_IJRMDCSE1 = HJOU_IJRMSCSE"
"IGCSEGLISS";"S";"0186";"*"
"IGCSEGLISS";"S";"0187";"         HJOU_IJRMDCSE = HJOU_IJIDACSET / 12"
"IGCSEGLISS";"S";"0188";"* -------------------------------------------"
"IGCSEGLISS";"S";"0189";"* Consigne de majoration mensuelle des droits"
"IGCSEGLISS";"S";"0190";"* -------------------------------------------"
"IGCSEGLISS";"S";"0191";"         POUR ACTIVITES"
"IGCSEGLISS";"S";"0192";"            SI HABS_MOTIF = ""ZMACSE"""
"IGCSEGLISS";"S";"0193";"               LOCA_MAJO = 1"
"IGCSEGLISS";"S";"0194";"            FINSI"
"IGCSEGLISS";"S";"0195";"         FINPOUR"
"IGCSEGLISS";"S";"0196";"         SI LOCA_MAJO = 1"
"IGCSEGLISS";"S";"0197";"            HJOU_IJRMDCSE = HJOU_IJRMDCSE * LOCA_TAUX"
