"IPRIOR";"S";"0024";"* Date         : JJ/MM/AAAA"
"IPRIOR";"S";"0025";"* Objet        :"
"IPRIOR";"S";"0026";"*"
"IPRIOR";"S";"0027";"*----------------------------------------------------------------------"
"IPRIOR";"S";"0028";"*"
"IPRIOR";"S";"0029";"* Implémentation des données industrielles"
"IPRIOR";"S";"0030";"*"
"IPRIOR";"S";"0031";"DEBDICO"
"IPRIOR";"S";"0032";"FINDICO"
"IPRIOR";"S";"0033";"*"
"IPRIOR";"S";"0034";"* Déclaration des donnees locales"
"IPRIOR";"S";"0035";"*"
"IPRIOR";"S";"0036";"DEF LOCA_MOT1 A10"
"IPRIOR";"S";"0037";"LOCA_MOT1 = "" """
"IPRIOR";"S";"0038";"DEF LOCA_MOT2 A10"
"IPRIOR";"S";"0039";"LOCA_MOT2 = "" """
"IPRIOR";"S";"0040";"DEF LOCA_PRIO1 Z1"
"IPRIOR";"S";"0041";"LOCA_PRIO1 = ""0"""
"IPRIOR";"S";"0042";"DEF LOCA_PRIO2 Z1"
"IPRIOR";"S";"0043";"LOCA_PRIO2 = ""0"""
"IPRIOR";"S";"0044";"DEF LOCA_VAL1 A1"
"IPRIOR";"S";"0045";"LOCA_VAL1 = "" """
"IPRIOR";"S";"0046";"DEF LOCA_VAL2 A1"
"IPRIOR";"S";"0047";"LOCA_VAL2 = "" """
"IPRIOR";"S";"0048";"*"
"IPRIOR";"S";"0049";"*"
"IPRIOR";"S";"0050";"POUR ACTIVITES"
"IPRIOR";"S";"0051";"   SI HABS_MOTYPE <> ""C"""
"IPRIOR";"S";"0052";"      SI HABS_MOTIF <> ""FINP"""
"IPRIOR";"S";"0053";"         SI HABS_VALORIS <> ""H"""
"IPRIOR";"S";"0054";"            SI LOCA_MOT1 = "" """
"IPRIOR";"S";"0055";"               SI MOTI_PRIORITE > ""0"""
"IPRIOR";"S";"0056";"                  LOCA_PRIO1 = MOTI_PRIORITE"
"IPRIOR";"S";"0057";"                  LOCA_MOT1 = HABS_MOTIF"
"IPRIOR";"S";"0058";"                  LOCA_VAL1 = HABS_VALORIS"
"IPRIOR";"S";"0059";"               FINSI"
"IPRIOR";"S";"0060";"            SINON"
"IPRIOR";"S";"0061";"               SI LOCA_MOT2 = "" """
"IPRIOR";"S";"0062";"                  SI MOTI_PRIORITE > ""0"""
"IPRIOR";"S";"0063";"                     LOCA_PRIO2 = MOTI_PRIORITE"
"IPRIOR";"S";"0064";"                     LOCA_MOT2 = HABS_MOTIF"
"IPRIOR";"S";"0065";"                     LOCA_VAL2 = HABS_VALORIS"
"IPRIOR";"S";"0066";"                  FINSI"
"IPRIOR";"S";"0067";"               FINSI"
"IPRIOR";"S";"0068";"            FINSI"
"IPRIOR";"S";"0069";"         FINSI"
"IPRIOR";"S";"0070";"      FINSI"
"IPRIOR";"S";"0071";"   FINSI"
"IPRIOR";"S";"0072";"FINPOUR"
"IPRIOR";"S";"0073";"SI LOCA_VAL1 = LOCA_VAL2"
"IPRIOR";"S";"0074";"   SI LOCA_PRIO2 > LOCA_PRIO1"
"IPRIOR";"S";"0075";"      LOCA_MOT2 = "" """
"IPRIOR";"S";"0076";"   FINSI"
"IPRIOR";"S";"0077";"   SI LOCA_PRIO2 < LOCA_PRIO1"
"IPRIOR";"S";"0078";"      LOCA_MOT1 = "" """
"IPRIOR";"S";"0079";"   FINSI"
"IPRIOR";"S";"0080";"   SI LOCA_PRIO2 = LOCA_PRIO1"
"IPRIOR";"S";"0081";"      SI LOCA_MOT1 = LOCA_MOT2"
"IPRIOR";"S";"0082";"         LOCA_MOT1 = "" """
"IPRIOR";"S";"0083";"      SINON"
"IPRIOR";"S";"0084";"         LOCA_MOT1 = "" """
"IPRIOR";"S";"0085";"         LOCA_MOT2 = "" """
"IPRIOR";"S";"0086";"      FINSI"
"IPRIOR";"S";"0087";"   FINSI"
"IPRIOR";"S";"0088";"   SI LOCA_MOT1 <> "" """
"IPRIOR";"S";"0089";"      ENLEVER LOCA_MOT1"
"IPRIOR";"S";"0090";"   FINSI"
"IPRIOR";"S";"0091";"   SI LOCA_MOT2 <> "" """
"IPRIOR";"S";"0092";"      ENLEVER LOCA_MOT2"
"IPRIOR";"S";"0093";"   FINSI"
"IPRIOR";"S";"0094";"FINSI"
"IPRIOR";"S";"0095";"FIN"
