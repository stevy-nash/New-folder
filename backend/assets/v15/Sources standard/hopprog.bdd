"ICONSCPCH";"S";"0448";"                           LOCA_CPAN = 0.5"
"ICONSCPCH";"S";"0449";"                           HJOU_IJRCCOANCI = HJOU_IJRCCOANCI + 0.5"
"ICONSCPCH";"S";"0450";"                           HJOU_IJRSCOANCI = HJOU_IJRSCOANCI - 0.5"
"ICONSCPCH";"S";"0451";"                           SI LOCA_CPR > 0"
"ICONSCPCH";"S";"0452";"                              LOCA_VALCPAN = ""A"""
"ICONSCPCH";"S";"0453";"                           SINON"
"ICONSCPCH";"S";"0454";"                              LOCA_VALCPAN = ""M"""
"ICONSCPCH";"S";"0455";"                           FINSI"
"ICONSCPCH";"S";"0456";"                        FINSI"
"ICONSCPCH";"S";"0457";"                     FINSI"
"ICONSCPCH";"S";"0458";"                  SINON"
"ICONSCPCH";"S";"0459";"                     SI LOCA_VAL > 0"
"ICONSCPCH";"S";"0460";"                        SI HJOU_IJRSCOANCI >= LOCA_VAL"
"ICONSCPCH";"S";"0461";"                           LOCA_CPAN = 0.5"
"ICONSCPCH";"S";"0462";"                           LOCA_VAL = 0"
"ICONSCPCH";"S";"0463";"                           HJOU_IJRCCOANCI = HJOU_IJRCCOANCI + 0.5"
"ICONSCPCH";"S";"0464";"                           HJOU_IJRSCOANCI = HJOU_IJRSCOANCI - 0.5"
"ICONSCPCH";"S";"0465";"                           SI LOCA_CPR > 0"
"ICONSCPCH";"S";"0466";"                              LOCA_VALCPAN = ""A"""
"ICONSCPCH";"S";"0467";"                           SINON"
"ICONSCPCH";"S";"0468";"                              LOCA_VALCPAN = HABS_VALORIS"
"ICONSCPCH";"S";"0469";"                              LOCA_NOANNUL = 1"
"ICONSCPCH";"S";"0470";"                           FINSI"
"ICONSCPCH";"S";"0471";"                        FINSI"
"ICONSCPCH";"S";"0472";"                     FINSI"
"ICONSCPCH";"S";"0473";"                  FINSI"
"ICONSCPCH";"S";"0474";"               FINSI"
"ICONSCPCH";"S";"0475";"* test solde cp"
"ICONSCPCH";"S";"0920";"               FINSI"
"ICONSCPCH";"S";"0476";"               SI LOCA_VAL = 1"
"ICONSCPCH";"S";"0477";"* Sans jour travaillé/non travaillé"
"ICONSCPCH";"S";"0478";"                  SI HORC_IHIDRNTRAV = 0"
"ICONSCPCH";"S";"0479";"                     SI HJOU_IJRSCOPRIN >= LOCA_VAL"
"ICONSCPCH";"S";"0480";"                        HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + 1"
"ICONSCPCH";"S";"0481";"                        HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - 1"
"ICONSCPCH";"S";"0482";"*"
"ICONSCPCH";"S";"0483";"                        LOCA_CP = 1"
"ICONSCPCH";"S";"0484";"                        LOCA_VAL = 0"
"ICONSCPCH";"S";"0485";"                        LOCA_VALCP = ""J"""
"ICONSCPCH";"S";"0486";"                        LOCA_NOANNUL = 1"
