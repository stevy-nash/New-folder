"ICREDB";"S";"0035";"*"
"ICREDB";"S";"0036";"* Implémentation des données industrielles"
"ICREDB";"S";"0037";"*"
"ICREDB";"S";"0038";"DEBDICO"
"ICREDB";"S";"0039";"   HJOU_IJIGCDTYPP;O;Z1;X;;;123456789;L;;C2;""Période de traitement"";"
"ICREDB";"S";"0040";"   HJOU_IJRFFINPER;N;N2;I;;;    56789;;IJRFFINPER;V3;""Flag fin de période horaire variable"";"
"ICREDB";"S";"0041";"   HJOU_IJRCDPERMA;N;T8,2;L;;;    56789;;IJRCDPERMA;V3;""Crédit/Débit"";"
"ICTRBA";"S";"0133";"            FINSI"
"ICREDB";"S";"0042";"   HJOU_IJRVICRD01;N;T8,2;L;;;    56789;;IJRVICRD01;V3;""VI - C/D cumulé"";"
"ICREDB";"S";"0043";"   HJOU_IJRCREDEBC;N;T8,2;L;;;    56789;;IJRCREDEBC;V3;""Crédit/Débit cumulé"";"
"ICREDB";"S";"0044";"   HJOU_IJQCREDEBJ;N;T6,2;I;;;    56789;;;V3;""Crédit/Débit du jour"";"
"ICREDB";"S";"0045";"   HJOU_IJQHECRETP;N;T8,2;L;;;    56789;;;V3;""Heures écrêtées Crédit/Débit"";"
"ICREDB";"S";"0046";"   HJOU_IJRBHORVPR;N;T8,2;L;;;    56789;;IJRBHORVAP;V3;""Report base HV période de la veille"";"
"ICREDB";"S";"0047";"   HJOU_IJRCDCUMAF;N;T8,2;L;;;123456789;;IJRCREDEBC;V3;""C/D cumulé affichage lecteur"";"
"ICREDB";"S";"0048";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"ICREDB";"S";"0049";"FINDICO"
"ICREDB";"S";"0050";"*"
"ICREDB";"S";"0051";"DEBANO"
"ICREDB";"S";"0052";"   104;4;""Ecrétage du crédit/débit journalier"";"
"ICREDB";"S";"0053";"   108;5;""Débit de la période inférieur au seuil minimum"";"
"ICREDB";"S";"0054";"   109;5;""Crédit de la période supérieur au seuil maximum"";"
"ICREDB";"S";"0055";"   112;5;""Limitation du crédit/débit à sa valeur maximum"";"
"ICREDB";"S";"0056";"   113;6;""Limitation du crédit/débit à sa valeur minimum"";"
"ICREDB";"S";"0057";"FINANO"
"ICREDB";"S";"0058";"*"
"ICREDB";"S";"0059";"* Déclaration des donnees locales"
"ICREDB";"S";"0060";"*"
"ICREDB";"S";"0061";"* Initialisation des compteurs en fonction du type de traitement"
"ICREDB";"S";"0062";"*"
"ICREDB";"S";"0063";"* Raz compteurs pour traitement semaine type 1 ou 5"
"ICREDB";"S";"0064";"*"
"ICREDB";"S";"0065";"SI HJOU_JOUR = ""1"""
"ICREDB";"S";"0066";"   SI HJOU_IJIGCDTYPP = ""1"""
"ICREDB";"S";"0067";"   OU HJOU_IJIGCDTYPP = ""5"""
"ICREDB";"S";"0068";"      FAIRE RAZPER"
"ICREDB";"S";"0069";"   FINSI"
"ICREDB";"S";"0070";"FINSI"
"ICREDB";"S";"0071";"*"
"ICREDB";"S";"0072";"* Raz compteurs pour traitement mensuel type 2 ou 5"
"ICREDB";"S";"0073";"*"
"ICREDB";"S";"0074";"SI HJOU_IJIGCDTYPP = ""2"""
"ICREDB";"S";"0075";"OU HJOU_IJIGCDTYPP = ""5"""
"ICREDB";"S";"0076";"   SI HJOU_DATE(7:2) = ""01"""
"ICREDB";"S";"0077";"      FAIRE RAZPER"
"ICREDB";"S";"0078";"   FINSI"
"ICREDB";"S";"0079";"FINSI"
"ICREDB";"S";"0080";"*"
"ICREDB";"S";"0081";"* Raz compteurs pour traitement avec calendrier type 3"
"ICREDB";"S";"0082";"*"
"ICREDB";"S";"0083";"SI HJOU_IJIGCDTYPP = ""3"""
"ICREDB";"S";"0084";"   SI HJOU_IJRFFINPER = 1"
"ICREDB";"S";"0085";"      FAIRE RAZPER"
"ICREDB";"S";"0086";"      HJOU_IJRFFINPER = 2"
"ICREDB";"S";"0087";"   FINSI"
"ICREDB";"S";"0088";"FINSI"
"ICREDB";"S";"0089";"*"
"ICREDB";"S";"0090";"* traitement du motif d'absence"
"ICREDB";"S";"0091";"*"
"ICREDB";"S";"0092";"POUR ACTIVITES"
"ICREDB";"S";"0093";"   SI MOTI_MOTYPE <> ""C"""
"ICREDB";"S";"0094";"      SI MOTI_IMIGDEBCRE = ""2"""
"ICREDB";"S";"0095";"         HJOU_IJRCDPERMA = HJOU_IJRCDPERMA - HABS_MOTIDUR"
"ICREDB";"S";"0096";"         SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0097";"            HJOU_IJRVICRD01 = HJOU_IJRCREDEBC"
"ICREDB";"S";"0098";"            HJOU_IJRCREDEBC = HJOU_IJRCREDEBC - HABS_MOTIDUR"
"ICREDB";"S";"0099";"         FINSI"
"ICREDB";"S";"0100";"      FINSI"
"ICREDB";"S";"0101";"   FINSI"
"ICREDB";"S";"0102";"FINPOUR"
"ICREDB";"S";"0103";"*"
"ICREDB";"S";"0104";"* calcul crédit du jour et controle"
"ICREDB";"S";"0105";"*"
"ICREDB";"S";"0106";"SI HJOU_IJIGCREDEB = ""1"""
"ICREDB";"S";"0107";"*"
"ICREDB";"S";"0108";"   HJOU_IJQCREDEBJ = HJOU_IJQBHORVAJ - HJOU_IJQPRETHEJ"
"ICREDB";"S";"0109";"*"
"ICREDB";"S";"0110";"* Ecrétage du crédit du jour"
"ICREDB";"S";"0111";"*"
"ICREDB";"S";"0112";"   SI PROF_ECRCRE > 0"
"ICREDB";"S";"0113";"      SI HJOU_IJQCREDEBJ > PROF_ECRCRE"
"ICREDB";"S";"0114";"         HJOU_IJQCREDEBJ = PROF_ECRCRE"
"ICREDB";"S";"0115";"         ANOMALIE 104"
"ICREDB";"S";"0116";"      FINSI"
"ICREDB";"S";"0117";"   FINSI"
"ICREDB";"S";"0118";"*"
"ICREDB";"S";"0119";"* Calcul du credit/debit cumulé et permanent"
"ICREDB";"S";"0120";"*"
"ICREDB";"S";"0121";"* Cumul du crédit du jour"
"ICREDB";"S";"0122";"* Le crédit cumulé de la période tient compte du crédit permanent"
"ICREDB";"S";"0123";"* Traitement à la semaine type 1 ou 5"
"ICREDB";"S";"0124";"*"
"ICREDB";"S";"0125";"   SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0126";"      SI HJOU_IJIGCDTYPP = ""1"""
"ICREDB";"S";"0127";"      OU HJOU_IJIGCDTYPP = ""5"""
"ICREDB";"S";"0128";"         SI HJOU_JOUR = ""1"""
"ICREDB";"S";"0129";"            HJOU_IJRCREDEBC = HJOU_IJRCDPERMA"
"ICREDB";"S";"0130";"         FINSI"
"ICREDB";"S";"0131";"      FINSI"
"ICREDB";"S";"0132";"* Traitement au mois type 2 ou 5"
"ICREDB";"S";"0133";"*"
"ICREDB";"S";"0134";"      SI HJOU_IJIGCDTYPP = ""2"""
"ICREDB";"S";"0135";"      OU HJOU_IJIGCDTYPP = ""5"""
"ICREDB";"S";"0136";"         SI HJOU_DATE(7:2) = ""01"""
"ICREDB";"S";"0137";"            HJOU_IJRCREDEBC = HJOU_IJRCDPERMA"
"ICREDB";"S";"0138";"         FINSI"
"ICREDB";"S";"0139";"      FINSI"
"ICREDB";"S";"0140";"* Traitement sur calendrier type 3"
"ICREDB";"S";"0141";"*"
"ICREDB";"S";"0142";"      SI HJOU_IJIGCDTYPP = ""3"""
"ICREDB";"S";"0143";"         SI HJOU_IJRFFINPER = 2"
"ICREDB";"S";"0144";"            HJOU_IJRCREDEBC = HJOU_IJRCDPERMA"
"ICREDB";"S";"0145";"            HJOU_IJRFFINPER = 0"
"ICREDB";"S";"0146";"         FINSI"
"ICREDB";"S";"0147";"      FINSI"
"ICREDB";"S";"0148";"   FINSI"
"ICREDB";"S";"0149";"*"
"ICREDB";"S";"0150";"* Le credit est uniquement cumulé sur la période"
"ICREDB";"S";"0151";"*"
"ICREDB";"S";"0152";"   HJOU_IJRCREDEBC = HJOU_IJRCREDEBC + HJOU_IJQCREDEBJ"
"ICREDB";"S";"0153";"   HJOU_IJRVICRD01 = HJOU_IJRCREDEBC"
"ICREDB";"S";"0154";"FINSI"
"ICREDB";"S";"0155";"*"
"ICREDB";"S";"0156";"* Calcul du credit/debit permanent selon le type de traitement"
"ICREDB";"S";"0157";"* en fin de periode"
"ICREDB";"S";"0158";"*"
"ICREDB";"S";"0159";"* Traitement fin de semaine Type 1"
"ICREDB";"S";"0160";"*"
"ICREDB";"S";"0161";"SI HJOU_IJIGCDTYPP = ""1"""
"ICREDB";"S";"0162";"   SI HJOU_JOUR = ""7"""
"ICREDB";"S";"0163";"      FAIRE FINPER"
"ICREDB";"S";"0164";"   FINSI"
"ICREDB";"S";"0165";"FINSI"
"ICREDB";"S";"0166";"*"
"ICREDB";"S";"0167";"* Traitement fin de mois Type 2"
"ICREDB";"S";"0168";"*"
"ICREDB";"S";"0169";"SI HJOU_IJIGCDTYPP = ""2"""
"ICREDB";"S";"0170";"   SI TEMP_DATSUI(7:2) = ""01"""
"ICREDB";"S";"0171";"      FAIRE FINPER"
"ICREDB";"S";"0172";"   FINSI"
"ICREDB";"S";"0173";"FINSI"
"ICREDB";"S";"0174";"*"
"ICREDB";"S";"0175";"* Traitement sur calendrier type 3"
"ICREDB";"S";"0176";"*"
"ICREDB";"S";"0177";"SI HJOU_IJIGCDTYPP = ""3"""
"ICREDB";"S";"0178";"   POUR ACTIVITES"
"ICREDB";"S";"0179";"      SI HABS_MOTIF = ""FINP"""
"ICREDB";"S";"0180";"         FAIRE FINPER"
"ICREDB";"S";"0181";"         HJOU_IJRFFINPER = 1"
"ICREDB";"S";"0182";"      FINSI"
"ICREDB";"S";"0183";"   FINPOUR"
"ICREDB";"S";"0184";"FINSI"
"ICREDB";"S";"0185";"*"
"ICREDB";"S";"0186";"* Traitement Crédit permanent calculé à la journée Type 4"
"ICREDB";"S";"0187";"* Pas d'affichage à la badgeuse (HJOU_IJRCDCUMAF)"
"ICREDB";"S";"0188";"* pour le traitement journalier car sinon affichage"
"ICREDB";"S";"0189";"* des heures du crédit débit de la veille"
"ICREDB";"S";"0190";"*"
"ICREDB";"S";"0191";"*"
"ICREDB";"S";"0192";"SI HJOU_IJIGCDTYPP = ""4"""
"ICREDB";"S";"0193";"   FAIRE FINPER"
"ICREDB";"S";"0194";"* Remise a zéro des compteurs"
"ICREDB";"S";"0195";"   HJOU_IJRCREDEBC = 0"
"ICREDB";"S";"0196";"   HJOU_IJRVICRD01 = 0"
"ICREDB";"S";"0197";"   HJOU_IJQHECRETP = 0"
"ICREDB";"S";"0198";"   SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0199";"      HJOU_IJRCREDEBC = HJOU_IJRCREDEBC + HJOU_IJRCDPERMA"
"ICREDB";"S";"0200";"   FINSI"
"ICREDB";"S";"0201";"FINSI"
"ICREDB";"S";"0202";"*"
"ICREDB";"S";"0203";"* Traitement mixte type MGPTT"
"ICREDB";"S";"0204";"*"
"ICREDB";"S";"0205";"SI HJOU_IJIGCDTYPP = ""5"""
"ICREDB";"S";"0206";"   SI HJOU_JOUR = ""7"""
"ICREDB";"S";"0207";"      SI TEMP_DATSUI(7:2) <> ""01"""
"ICREDB";"S";"0208";"         FAIRE FINPER2"
"ICREDB";"S";"0209";"      FINSI"
"ICREDB";"S";"0210";"   FINSI"
"ICREDB";"S";"0211";"   SI TEMP_DATSUI(7:2) = ""01"""
"ICREDB";"S";"0212";"      FAIRE FINPER"
"ICREDB";"S";"0213";"   FINSI"
"ICREDB";"S";"0214";"FINSI"
"ICREDB";"S";"0215";"*"
"ICREDB";"S";"0216";"* Analyse des consignes liées au crédit"
"ICREDB";"S";"0217";"* Les consignes sont des motifs de type C saisies pour mettre à jour"
"ICREDB";"S";"0218";"* des compteurs"
"ICREDB";"S";"0219";"*"
"ICREDB";"S";"0220";"POUR ACTIVITES"
"ICREDB";"S";"0221";"   SI HABS_MOTYPE = ""C"""
"ICREDB";"S";"0222";"* Consigne de mise a jour du credit permanent"
"ICREDB";"S";"0223";"      SI HABS_MOTIF = ""XCRE"""
"ICREDB";"S";"0224";"         HJOU_IJRCDPERMA = HJOU_IJRCDPERMA + HABS_MOTIDUR"
"ICREDB";"S";"0225";"         SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0226";"            HJOU_IJRCREDEBC = HJOU_IJRCREDEBC + HABS_MOTIDUR"
"ICREDB";"S";"0227";"         FINSI"
"ICREDB";"S";"0228";"      FINSI"
"ICREDB";"S";"0229";"* consigne d'initialisation du crédit permanent"
"ICREDB";"S";"0230";"      SI HABS_MOTIF = ""ZCRE"""
"ICREDB";"S";"0231";"         SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0232";"            HJOU_IJRCREDEBC = HJOU_IJRCREDEBC - HJOU_IJRCDPERMA"
"ICREDB";"S";"0233";"         FINSI"
"ICREDB";"S";"0234";"         HJOU_IJRCDPERMA = HABS_MOTIDUR"
"ICREDB";"S";"0235";"         SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0236";"            HJOU_IJRCREDEBC = HJOU_IJRCREDEBC + HJOU_IJRCDPERMA"
"ICREDB";"S";"0237";"         FINSI"
"ICREDB";"S";"0238";"      FINSI"
"ICREDB";"S";"0239";"   FINSI"
"ICREDB";"S";"0240";"FINPOUR"
"ICREDB";"S";"0241";"FIN"
"ICREDB";"S";"0242";"*"
"ICREDB";"S";"0243";"* Procedure de raz des compteurs en début de période"
"ICREDB";"S";"0244";"*"
"ICREDB";"S";"0245";"PROC RAZPER"
"ICREDB";"S";"0246";"   HJOU_IJRCREDEBC = 0"
"ICREDB";"S";"0247";"   HJOU_IJRVICRD01 = 0"
"ICREDB";"S";"0248";"   HJOU_IJQHECRETP = 0"
"ICREDB";"S";"0249";"   HJOU_IJRBHORVPR = 0"
"ICREDB";"S";"0250";"   SI PARD_IDIGDEBCRE <> ""1"""
"ICREDB";"S";"0251";"      HJOU_IJRCDCUMAF = 0"
"ICREDB";"S";"0252";"   FINSI"
"ICREDB";"S";"0253";"   SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0254";"      HJOU_IJRCDCUMAF = HJOU_IJRCDPERMA"
"ICREDB";"S";"0255";"   FINSI"
"ICREDB";"S";"0256";"FINPROC"
"ICREDB";"S";"0257";"*"
"ICREDB";"S";"0258";"* procedure de fin de periode"
"ICREDB";"S";"0259";"*"
"ICREDB";"S";"0260";"* Calcul du credit/debit permanent en fonction des reports periode et"
"ICREDB";"S";"0261";"* mini/maxi du credit permanent"
"ICREDB";"S";"0262";"*"
"ICREDB";"S";"0263";"PROC FINPER"
"ICREDB";"S";"0264";"* Retrait du credit permanent si indicateur = 1"
"ICREDB";"S";"0265";"   SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0266";"      HJOU_IJRVICRD01 = HJOU_IJRVICRD01 - HJOU_IJRCDPERMA"
"ICREDB";"S";"0267";"   FINSI"
"ICREDB";"S";"0268";"* Ecretage du report maximum"
"ICREDB";"S";"0269";"   SI HJOU_IJRVICRD01 > HJOU_IJICDRPLAF"
"ICREDB";"S";"0270";"      HJOU_IJQHECRETP = HJOU_IJRVICRD01 - HJOU_IJICDRPLAF"
"ICREDB";"S";"0271";"      HJOU_IJRVICRD01 = HJOU_IJICDRPLAF"
"ICREDB";"S";"0272";"      ANOMALIE 109"
"ICREDB";"S";"0273";"   FINSI"
"ICREDB";"S";"0274";"* Ecretage du report minimum"
"ICREDB";"S";"0275";"   SI HJOU_IJRVICRD01 < HJOU_IJICDRPLAN"
"ICREDB";"S";"0276";"      HJOU_IJQHECRETP = HJOU_IJRVICRD01 - HJOU_IJICDRPLAN"
"ICREDB";"S";"0277";"      HJOU_IJRVICRD01 = HJOU_IJICDRPLAN"
"ICREDB";"S";"0278";"      ANOMALIE 108"
"ICREDB";"S";"0279";"   FINSI"
"ICREDB";"S";"0280";"* Alimentation du crédit/débit permanent"
"ICREDB";"S";"0281";"   HJOU_IJRCDPERMA = HJOU_IJRCDPERMA + HJOU_IJRVICRD01"
"ICREDB";"S";"0282";"* Ecretage maximum du credit/debit permanent"
"ICREDB";"S";"0283";"   SI HJOU_IJRCDPERMA > HJOU_IJICDPLAFO"
"ICREDB";"S";"0284";"      HJOU_IJQHECRETP = HJOU_IJQHECRETP + HJOU_IJRCDPERMA"
"ICREDB";"S";"0285";"      HJOU_IJQHECRETP = HJOU_IJQHECRETP - HJOU_IJICDPLAFO"
"ICREDB";"S";"0286";"      HJOU_IJRCDPERMA = HJOU_IJICDPLAFO"
"ICREDB";"S";"0287";"      ANOMALIE 112"
"ICREDB";"S";"0288";"   FINSI"
"ICREDB";"S";"0289";"* Ecretage mimimum du credit/debit permament"
"ICREDB";"S";"0290";"   SI HJOU_IJRCDPERMA < HJOU_IJICDPLANC"
"ICREDB";"S";"0291";"      HJOU_IJQHECRETP = HJOU_IJQHECRETP + HJOU_IJRCDPERMA"
"ICREDB";"S";"0292";"      HJOU_IJQHECRETP = HJOU_IJQHECRETP - HJOU_IJICDPLANC"
"ICREDB";"S";"0293";"      HJOU_IJRCDPERMA = HJOU_IJICDPLANC"
"ICREDB";"S";"0294";"      ANOMALIE 113"
"ICREDB";"S";"0295";"   FINSI"
"ICREDB";"S";"0296";"FINPROC"
"ICREDB";"S";"0297";"*"
"ICREDB";"S";"0298";"* procedure de fin de periode 2"
"ICREDB";"S";"0299";"*"
"ICREDB";"S";"0300";"* Calcul du credit/debit permanent en fonction des reports periode et"
"ICREDB";"S";"0301";"* mini/maxi du credit permanent"
"ICREDB";"S";"0302";"*"
"ICREDB";"S";"0303";"PROC FINPER2"
"ICREDB";"S";"0304";"* Retrait du credit permanent si indicateur = 1"
"ICREDB";"S";"0305";"   SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0306";"      HJOU_IJRVICRD01 = HJOU_IJRVICRD01 - HJOU_IJRCDPERMA"
"ICREDB";"S";"0307";"   FINSI"
"ICREDB";"S";"0308";"* Ecretage du report maximum"
"ICREDB";"S";"0309";"   SI HJOU_IJRVICRD01 > HJOU_IJICDRPLAF"
"ICREDB";"S";"0310";"      HJOU_IJQHECRETP = HJOU_IJRVICRD01 - HJOU_IJICDRPLAF"
"ICREDB";"S";"0311";"      HJOU_IJRVICRD01 = HJOU_IJICDRPLAF"
"ICREDB";"S";"0312";"      ANOMALIE 109"
"ICREDB";"S";"0313";"   FINSI"
"ICREDB";"S";"0314";"* Ecretage du report minimum"
"ICREDB";"S";"0315";"   SI HJOU_IJRVICRD01 < HJOU_IJICDRPLAN"
"ICREDB";"S";"0316";"      HJOU_IJQHECRETP = HJOU_IJRVICRD01 - HJOU_IJICDRPLAN"
"ICREDB";"S";"0317";"      HJOU_IJRVICRD01 = HJOU_IJICDRPLAN"
"ICREDB";"S";"0318";"      ANOMALIE 108"
"ICREDB";"S";"0319";"   FINSI"
"ICREDB";"S";"0320";"* Alimentation du credit/debit permanent"
"ICREDB";"S";"0321";"   HJOU_IJRCDPERMA = HJOU_IJRCDPERMA + HJOU_IJRVICRD01"
"ICREDB";"S";"0322";"*"
"ICREDB";"S";"0323";"FINPROC"
