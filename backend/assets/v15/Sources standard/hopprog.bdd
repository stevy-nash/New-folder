"ICONSCONG";"S";"0797";"                            HJOU_IJRCCPTRA = HJOU_IJRCCPTRA + LOCA_VAL"
"ICONSCONG";"S";"0798";"                            HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - LOCA_VAL"
"ICONSCONG";"S";"0799";"                            *"
"ICONSCONG";"S";"0800";"                            HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + LOCA_VAL"
"ICONSCONG";"S";"0801";"                            HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_VAL"
"ICONSCONG";"S";"0802";"                        SINON"
"ICONSCONG";"S";"0803";"                            SI HJOU_IJRSCPTRA > 0"
"ICONSCONG";"S";"0804";"                                HJOU_IJRCCPTRA = HJOU_IJRCCPTRA + HJOU_IJRSCPTRA"
"ICONSCONG";"S";"0805";"                                *"
"ICONSCONG";"S";"0806";"                                HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + HJOU_IJRSCPTRA"
"ICONSCONG";"S";"0807";"                                HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HJOU_IJRSCPTRA"
"ICONSCONG";"S";"0808";"                                HJOU_IJRSCPTRA = 0"
"ICONSCONG";"S";"0809";"                            FINSI"
"ICONSCONG";"S";"0810";"                        FINSI"
"ICONSCONG";"S";"0811";"                    FINSI"
"ICONSCONG";"S";"0812";"                FINSI"
"ICONSCONG";"S";"0813";"                *"
"ICONSCONG";"S";"0814";"                SI LOCA_VALORIS = ""A"""
"ICONSCONG";"S";"0815";"                    SI PROF_ABSENS = 0"
"ICONSCONG";"S";"0816";"                        SI HJOU_IJRSCPNTRA >= LOCA_VAL"
"ICONSCONG";"S";"0817";"                            * Pris dans non travaillé"
"ICONSCONG";"S";"0818";"                            HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + LOCA_VAL"
"ICONSCONG";"S";"0819";"                            HJOU_IJRSCPNTRA = HJOU_IJRSCPNTRA - LOCA_VAL"
