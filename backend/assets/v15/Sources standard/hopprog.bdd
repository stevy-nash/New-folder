"ICONSCPCH";"S";"0534";"                           FINSI"
"ICONSCPCH";"S";"0535";"                        FINSI"
"ICONSCPCH";"S";"0536";"                     SINON"
"ICONSCPCH";"S";"0537";"* Travail en demi-journée"
