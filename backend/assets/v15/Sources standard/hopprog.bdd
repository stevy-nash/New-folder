"IRAZCO";"S";"0101";"*"
"IRAZCO";"S";"0102";"DEF LOCA_RAZCPT N1"
"IRAZCO";"S";"0103";"LOCA_RAZCPT = 0"
"IRAZCO";"S";"0104";"* la réinitialisation des compteurs est effectuée"
"IRAZCO";"S";"0105";"* par rapport à l'indicateur dans les données globales datées"
"IRAZCO";"S";"0106";"SI PARD_IDIGRAZCPT = ""1"""
"IRAZCO";"S";"0107";"   LOCA_RAZCPT = 1"
"IRAZCO";"S";"0108";"FINSI"
"IRAZCO";"S";"0109";"* par rapport à la consigne ZRAZCT"
"IRAZCO";"S";"0110";"POUR ACTIVITES"
"IRAZCO";"S";"0111";"   SI HABS_MOTIF = ""ZRAZCT"""
"IRAZCO";"S";"0112";"      SI HJOU_DATE = CTRA_DATDEB"
"IRAZCO";"S";"0113";"         LOCA_RAZCPT = 1"
"IRAZCO";"S";"0114";"      SINON"
"IRAZCO";"S";"0115";"         ANOMALIE 149"
"IRAZCO";"S";"0116";"      FINSI"
"IRAZCO";"S";"0117";"   FINSI"
"IRAZCO";"S";"0118";"FINPOUR"
