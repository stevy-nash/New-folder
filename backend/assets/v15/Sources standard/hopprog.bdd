"ITPSACTHT6";"S";"0025";"*"
"ITPSACTHT6";"S";"0026";"* Modifiée par :"
"ITPSACTHT6";"S";"0027";"* Date         : JJ/MM/AAAA"
"ITPSACTHT6";"S";"0028";"* Objet        :"
"ITPSACTHT6";"S";"0029";"*"
"ITPSACTHT6";"S";"0030";"***********************************************************************"
"ITPSACTHT6";"S";"0031";"*"
"ITPSACTHT6";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTHT6";"S";"0033";"*"
"ITPSACTHT6";"S";"0034";"DEBDICO"
"ITPSACTHT6";"S";"0035";"EMPL_IEIACTI;O;A1;X;;;123456789;L;;C3;""Employé géré en activité"";"
"ITPSACTHT6";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTHT6";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTHT6";"S";"0038";"FINDICO"
"ITPSACTHT6";"S";"0039";"*"
"ITPSACTHT6";"S";"0040";"*"
"ITPSACTHT6";"S";"0041";"* DEBANO"
"ITPSACTHT6";"S";"0042";"*"
"ITPSACTHT6";"S";"0043";"* FINANO"
"ITPSACTHT6";"S";"0044";"*"
"ITPSACTHT6";"S";"0045";"* Définition des variables locales"
"ITPSACTHT6";"S";"0046";"*"
"ITPSACTHT6";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTHT6";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTHT6";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHT6";"S";"0050";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTHT6";"S";"0051";"    FINSI"
"ITPSACTHT6";"S";"0052";"FINSI"
"ITPSACTHT6";"S";"0053";"* Employé géré en activité"
"ITPSACTHT6";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTHT6";"S";"0055";"   SI HJOU_IJIACTI <> ""0"""
"ITPSACTHT6";"S";"0056";"        * Calcul de la présence activité le dimanche"
"ITPSACTHT6";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTHT6";"S";"0058";"        SI HJOU_JOUR = ""7"""
"ITPSACTHT6";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTHT6";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTHT6";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTHT6";"S";"0062";"                * d'activité à justifier"
"ITPSACTHT6";"S";"0063";"                PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTHT6";"S";"0064";"                PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTHT6";"S";"0065";"                *"
"ITPSACTHT6";"S";"0066";"                SI PRES_MODE_TRV = "" """
"ITPSACTHT6";"S";"0067";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT6";"S";"0068";"                FINSI"
"ITPSACTHT6";"S";"0069";"                *"
"ITPSACTHT6";"S";"0070";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT6";"S";"0071";"                *"
"ITPSACTHT6";"S";"0072";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT6";"S";"0073";"                *                              (A décommenter si besoin)"
"ITPSACTHT6";"S";"0074";"                *"
"ITPSACTHT6";"S";"0075";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT6";"S";"0076";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT6";"S";"0077";"                * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT6";"S";"0078";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT6";"S";"0079";"                *"
"ITPSACTHT6";"S";"0080";"                * SI HJOU_IJRBHORVAH <> 0"
"ITPSACTHT6";"S";"0081";"                    PRES_TPS_PRES = HJOU_IJRBHORVAH"
"ITPSACTHT6";"S";"0082";"                * SINON"
"ITPSACTHT6";"S";"0083";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTHT6";"S";"0084";"                * FINSI"
"ITPSACTHT6";"S";"0085";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT6";"S";"0086";"                *"
"ITPSACTHT6";"S";"0087";"                PRES_TPS_IMPUTE = 0"
"ITPSACTHT6";"S";"0088";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTHT6";"S";"0089";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTHT6";"S";"0090";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHT6";"S";"0091";"                    POUR EVENEMENTS"
"ITPSACTHT6";"S";"0092";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT6";"S";"0093";"                    FINPOUR"
"ITPSACTHT6";"S";"0094";"                FINSI"
"ITPSACTHT6";"S";"0095";"                * Calcul de l'écart"
"ITPSACTHT6";"S";"0096";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT6";"S";"0097";"            FINSI"
"ITPSACTHT6";"S";"0098";"        FINSI"
"ITPSACTHT6";"S";"0099";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT6";"S";"0100";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT6";"S";"0101";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT6";"S";"0102";"        FINSI"
"ITPSACTHT6";"S";"0103";"   FINSI"
"ITPSACTHT6";"S";"0104";"FINSI"
"ITPSACTHT6";"S";"0105";"*"
"ITPSACTHT6";"S";"0106";"FIN"
