"IGRTTJ";"S";"0284";"      FINSI"
"IGRTTJ";"S";"0285";"**"
"IGRTTJ";"S";"0286";"      SI HABS_MOTIF = ""ZCRJ"""
"IGRTTJ";"S";"0287";"         LOCA_MOT = 1"
"IGRTTJ";"S";"0288";"         LOCA_TRANS = HABS_MOTINBR - HJOU_IJRCRTTJOU"
"IGRTTJ";"S";"0289";"         *"
"IGRTTJ";"S";"0290";"         HJOU_IJRCRTTJOU = HABS_MOTINBR"
"IGRTTJ";"S";"0291";"         HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - LOCA_TRANS"
"IGRTTJ";"S";"0292";"      FINSI"
"IGRTTJ";"S";"0293";"      SI HABS_MOTIF = ""XCRJ"""
"IGRTTJ";"S";"0294";"         LOCA_MOT = 1"
"IGRTTJ";"S";"0295";"         LOCA_PRIS = HABS_MOTINBR + HJOU_IJRCRTTJOU"
"IGRTTJ";"S";"0296";"         LOCA_TRANS = LOCA_PRIS - HJOU_IJRCRTTJOU"
"IGRTTJ";"S";"0297";"         *"
"IGRTTJ";"S";"0298";"         HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + HABS_MOTINBR"
"IGRTTJ";"S";"0299";"         HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - LOCA_TRANS"
"IGRTTJ";"S";"0300";"      FINSI"
"IGRTTJ";"S";"0301";"   FINPOUR"
"IGRTTJ";"S";"0302";"*"
"IGRTTJ";"S";"0303";"* calcul des soldes"
"IGRTTJ";"S";"0304";"   * HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"IGRTTJ";"S";"0305";"   SI HJOU_IJRSNBJRTT < 0"
"IGRTTJ";"S";"0306";"      SI LOCA_MOT = 1"
"IGRTTJ";"S";"0307";"         ANOMALIE 135"
"IGRTTJ";"S";"0308";"      FINSI"
"IGRTTJ";"S";"0309";"   FINSI"
"IGRTTJ";"S";"0310";"** le 21/03/07"
"IGRTTJ";"S";"0311";"** consigne de transfert du compteur RTT en jour en CET"
"IGRTTJ";"S";"0312";"   POUR ACTIVITES"
"IGRTTJ";"S";"0313";"      SI HABS_MOTIF = ""YRTCET"""
"IGRTTJ";"S";"0314";"         SI HABS_MOTINBR <= HJOU_IJRSNBJRTT"
"IGRTTJ";"S";"0315";"            HJOU_IJRTRRTCET = HJOU_IJRTRRTCET + HABS_MOTINBR"
"IGRTTJ";"S";"0316";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - HABS_MOTINBR"
"IGRTTJ";"S";"0317";"         SINON"
"IGRTTJ";"S";"0318";"* solde insuffisant"
"IGRTTJ";"S";"0319";"            ANOMALIE 158"
"IGRTTJ";"S";"0320";"         FINSI"
"IGRTTJ";"S";"0321";"      FINSI"
"IGRTTJ";"S";"0322";"** transfert de RTT en jours  en don absence"
"IGRTTJ";"S";"0323";"      SI HABS_MOTIF = ""YRTTDON"""
"IGRTTJ";"S";"0324";"         SI HABS_MOTINBR <= HJOU_IJRSNBJRTT"
"IGRTTJ";"S";"0325";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - HABS_MOTINBR"
"IGRTTJ";"S";"0326";"         SINON"
"IGRTTJ";"S";"0327";"* solde RTT insuffisant pour transfert en don absence"
"IGRTTJ";"S";"0328";"            ANOMALIE 190"
"IGRTTJ";"S";"0329";"         FINSI"
"IGRTTJ";"S";"0330";"      FINSI"
"IGRTTJ";"S";"0331";"   FINPOUR"
"IGRTTJ";"S";"0332";"   * HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - HJOU_IJRTRRTCET"
"IGRTTJ";"S";"0333";"**"
"IGRTTJ";"S";"0334";"** soldes previsionnels"
"IGRTTJ";"S";"0335";"**"
"IGRTTJ";"S";"0336";"   SI CTRA_DATFIN > TEMP_DATJOU"
"IGRTTJ";"S";"0337";"      SI CTRA_DATFIN < LOCA_DATEFU"
"IGRTTJ";"S";"0338";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"IGRTTJ";"S";"0339";"         LOCA_DATEFU = TEMP_DXFINPER"
"IGRTTJ";"S";"0340";"      SINON"
"IGRTTJ";"S";"0341";"         SI CTRA_DATFIN < LOCA_DATEFU2"
"IGRTTJ";"S";"0342";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"IGRTTJ";"S";"0343";"            LOCA_DATEFU2 = TEMP_DXFINPER"
"IGRTTJ";"S";"0344";"         FINSI"
"IGRTTJ";"S";"0345";"      FINSI"
"IGRTTJ";"S";"0346";"   FINSI"
"IGRTTJ";"S";"0347";"***"
"IGRTTJ";"S";"0348";"   SI TEMP_DATSUI = LOCA_DATEFU"
"IGRTTJ";"S";"0349";"      EMPL_IEQSPRTTJO = HJOU_IJRSNBJRTT"
"IGRTTJ";"S";"0350";"   FINSI"
"IGRTTJ";"S";"0351";"**"
"IGRTTJ";"S";"0352";"   SI TEMP_DATSUI = LOCA_DATEFU2"
"IGRTTJ";"S";"0353";"      EMPL_IEQSPRTTJ2 = HJOU_IJRSNBJRTT"
"IGRTTJ";"S";"0354";"   FINSI"
"IGRTTJ";"S";"0355";"FINSI"
"IGRTTJ";"S";"0356";"FIN"
"IHCOMP";"S";"0001";"************************************************************************"
"IHCOMP";"S";"0002";"*"
"IHCOMP";"S";"0003";"* Règle : IHCOMP"
"IHCOMP";"S";"0004";"* Ordre : 6060"
"IHCOMP";"S";"0005";"* Titre : Calcul des heures complémentaires pour les temps partiels"
"IHCOMP";"S";"0006";"*"
"IHCOMP";"S";"0007";"*----------------------------------------------------------------------"
"IHCOMP";"S";"0008";"*"
"IHCOMP";"S";"0009";"* Créé par : Méthodes et outils"
"IHCOMP";"S";"0010";"* Date     : 23/09/2019"
"IHCOMP";"S";"0011";"* Version  : 1"
"IHCOMP";"S";"0012";"*"
"IHCOMP";"S";"0013";"*----------------------------------------------------------------------"
"IHCOMP";"S";"0014";"*"
"IHCOMP";"S";"0015";"*"
"IHCOMP";"S";"0016";"* Rôle : Calcul des heures complémentaires pour les temps partiels du lundi"
"IHCOMP";"S";"0017";"*        au dimanche (si travailleur de nuit, les heures sont toutes comptabilisées"
"IHCOMP";"S";"0018";"*        sur le dimanche)"
"IHCOMP";"S";"0019";"*         Adaptation de la règle IHSUPP avec ajout suivant :"
"IHCOMP";"S";"0020";"*"
"IHCOMP";"S";"0021";"*         Ajout de l'anomalie 225 en cas de dépassement d'heures de 10%"
"IHCOMP";"S";"0022";"*         du contrat"
"IHCOMP";"S";"0023";"*         + séparation en deux des règles IHSUPP et IHSUPPDIM afin de"
"IHCOMP";"S";"0024";"*         différencier les HS et les HC"
"IHCOMP";"S";"0025";"*         + évolution des HC avec ajout d'un compteur heures payées non majorées,"
"IHCOMP";"S";"0026";"*         HC taux 2 pour les heures payées et les heures à récupérer"
"IHCOMP";"S";"0027";"*"
"IHCOMP";"S";"0028";"*----------------------------------------------------------------------"
"IHCOMP";"S";"0029";"*"
"IHCOMP";"S";"0030";"* Modifiée par : Méthodes et outils"
"IHCOMP";"S";"0031";"* Date         : 30/06/2020"
"IHCOMP";"S";"0032";"* Objet        : Le test de CTRA_ICITAUX est remplacé par HJOU_IJITYPCTRA"
"IHCOMP";"S";"0033";"*                 car le taux du contrat est désormais copié dans JOU"
"IHCOMP";"S";"0034";"*"
"IHCOMP";"S";"0035";"***********************************************************************"
"IHCOMP";"S";"0036";"*"
"IHCOMP";"S";"0037";"* Implémentation des données industrielles"
"IHCOMP";"S";"0038";"*"
"IHCOMP";"S";"0039";"DEBDICO"
"IHCOMP";"S";"0040";"   HJOU_IJIGHSUPPM;O;Z1;X;;;123456789;L;;C2;""Régime HS"";"
"IHCOMP";"S";"0041";"   HJOU_IJRBHSMPAH;N;T6,2;I;;;    56789;;IJRBHSMPAH;V3;""Base HS"";"
"IHCOMP";"S";"0042";"   HJOU_IJQHS1MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 1 à récup."";"
"IHCOMP";"S";"0043";"   HJOU_IJQHS2MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 2 à récup."";"
"IHCOMP";"S";"0044";"   HJOU_IJRSHSMREH;N;T8,2;L;;;     6789;;IJRSHSMREH;V3;""Récupération HS/HC"";"
"IHCOMP";"S";"0045";"   HJOU_IJQHSNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures complémentaires"";"
"IHCOMP";"S";"0046";"   HJOU_IJQHSNMARE;N;T6,2;I;;;     6789;;;V3;""Heures complémentaires récupérables"";"
"IHCOMP";"S";"0047";"   HJOU_IJRTHEOCYC;N;T6,2;I;;;    56789;;IJRTHEOCYC;V3;""Theorie du cycle"";"
"IHCOMP";"S";"0048";"   HJOU_IJQHPAYEES;N;T6,2;I;;;    56789;;;V3;""Heures payées"";"
"IHCOMP";"S";"0049";"   HJOU_IJRBHPAYEE;N;T6,2;I;;;    56789;;IJRBHPAYEE;V3;""Base des heures payées"";"
"IHCOMP";"S";"0050";"   MOTI_IMIGHRPAYE;O;Z1;X;0;1;123456789;C;;C2;""Participe aux heures payées"";"
"IHCOMP";"S";"0051";"   EMPL_IEQSHSMRE1;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 1 HS à recup."";"
"IHCOMP";"S";"0052";"   EMPL_IEQSHSMRE2;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 2 HS à recup."";"
"IHCOMP";"S";"0053";"   PARD_IDIHCTAUX1;O;N2;I;;;123456789;;;C3;""Heures compl. taux 1 (%)"";"
"IHCOMP";"S";"0054";"   PARD_IDIHCTAUX2;O;N2;I;;;123456789;;;C3;""Heures compl. à récup. taux 2 (%)"";"
"IHCOMP";"S";"0055";"   HJOU_IJQHCNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures comp. payées non majorées"";"
"IHCOMP";"S";"0056";"   HJOU_IJQHSNMAP2;N;T6,2;I;;;    56789;;;V3;""Heures complémentaires taux 2"";"
"IHCOMP";"S";"0057";"   HJOU_IJQHSNMAR2;N;T6,2;I;;;     6789;;;V3;""Heures complémentaires taux 2 à récup."";"
"IHCOMP";"S";"0058";"FINDICO"
"IHCOMP";"S";"0059";"DEBANO"
"IHCOMP";"S";"0060";"   171;8;""Dépassement de l'horaire hebdomadaire temps plein"";"
"IHCOMP";"S";"0061";"   192;9;""Heures non majorées payées négatives"";"
"IHCOMP";"S";"0062";"   225;6;""Nombre maxi d'heures complémentaires atteint pour ce contrat"";"
"IHCOMP";"S";"0063";"   226;9;""Solde récup HS/HC insuffisant"";"
"IHCOMP";"S";"0064";"FINANO"
"IHCOMP";"S";"0065";"*"
"IHCOMP";"S";"0066";"* Déclaration des donnees locales"
"IHCOMP";"S";"0067";"*"
"IHCOMP";"S";"0068";"DEF LOCA_NBCYCLE N2"
"IHCOMP";"S";"0069";"LOCA_NBCYCLE = 0"
"IHCOMP";"S";"0070";"DEF LOCA_CAL N1"
"IHCOMP";"S";"0071";"LOCA_CAL = 0"
"IHCOMP";"S";"0072";"DEF LOCA_HORHEB T6.2"
"IHCOMP";"S";"0073";"LOCA_HORHEB = 0"
"IHCOMP";"S";"0074";"DEF LOCA_HORCOH T6.2"
"IHCOMP";"S";"0075";"LOCA_HORCOH = 0"
"IHCOMP";"S";"0076";"DEF LOCA_10 T6.2"
"IHCOMP";"S";"0077";"LOCA_10 = 0"
"IHCOMP";"S";"0078";"DEF LOCA_HCOMP T6.2"
"IHCOMP";"S";"0079";"LOCA_HCOMP = 0"
"IHCOMP";"S";"0080";"DEF LOCA_DATE D"
"IHCOMP";"S";"0081";"LOCA_DATE = "" """
"IHCOMP";"S";"0082";"DEF LOCA_ACOURS N4"
"IHCOMP";"S";"0083";"LOCA_ACOURS = 0"
"IHCOMP";"S";"0084";"DEF LOCA_ACOURS2 N4"
"IHCOMP";"S";"0085";"LOCA_ACOURS2 = 0"
"IHCOMP";"S";"0086";"DEF LOCA_DATEFU D"
"IHCOMP";"S";"0087";"LOCA_DATEFU = "" """
"IHCOMP";"S";"0088";"DEF LOCA_DATEFU2 D"
"IHCOMP";"S";"0089";"LOCA_DATEFU2 = "" """
"IHCOMP";"S";"0090";"* Taux 1 pour récupération"
"IHCOMP";"S";"0091";"DEF LOCA_TAUXC N4.2"
"IHCOMP";"S";"0092";"LOCA_TAUXC = 0"
"IHCOMP";"S";"0093";"LOCA_TAUXC = PARD_IDIHCTAUX1 / 100"
"IHCOMP";"S";"0094";"LOCA_TAUXC = LOCA_TAUXC + 1"
"IHCOMP";"S";"0095";"* Taux 2 pour récupération"
"IHCOMP";"S";"0096";"DEF LOCA_TAUXC2 N4.2"
"IHCOMP";"S";"0097";"LOCA_TAUXC2 = 0"
"IHCOMP";"S";"0098";"LOCA_TAUXC2 = PARD_IDIHCTAUX2 / 100"
"IHCOMP";"S";"0099";"LOCA_TAUXC2 = LOCA_TAUXC2 + 1"
"IHCOMP";"S";"0100";"* Pour calcul de la différence entre Base HS"
"IHCOMP";"S";"0101";"* et théorie"
"IHCOMP";"S";"0102";"DEF LOCA_CAL2 T6.2"
"IHCOMP";"S";"0103";"LOCA_CAL2 = 0"
"IHCOMP";"S";"0104";"DEF LOCA_CONSO N1"
"IHCOMP";"S";"0105";"LOCA_CONSO = 0"
"IHCOMP";"S";"0106";"*"
"IHCOMP";"S";"0107";"* Si temps partiels"
"IHCOMP";"S";"0108";"SI HJOU_IJITYPCTRA > 0"
"IHCOMP";"S";"0109";"   SI HJOU_IJITYPCTRA < 100"
"IHCOMP";"S";"0110";"*"
"IHCOMP";"S";"0111";"* Alimentation des données locales pour calcul soldes prévisionnels"
"IHCOMP";"S";"0112";"*"
"IHCOMP";"S";"0113";"      SI PARD_IDIDDEBANN <> "" """
"IHCOMP";"S";"0114";"         LOCA_DATE(5:4) = PARD_IDIDDEBANN(5:4)"
"IHCOMP";"S";"0115";"      SINON"
"IHCOMP";"S";"0116";"         LOCA_DATE(5:4) = ""0101"""
"IHCOMP";"S";"0117";"      FINSI"
"IHCOMP";"S";"0118";"**"
"IHCOMP";"S";"0119";"      LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IHCOMP";"S";"0120";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHCOMP";"S";"0121";"*"
"IHCOMP";"S";"0122";"      SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IHCOMP";"S";"0123";"         LOCA_ACOURS = LOCA_ACOURS + 1"
"IHCOMP";"S";"0124";"         LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHCOMP";"S";"0125";"      FINSI"
"IHCOMP";"S";"0126";"*"
"IHCOMP";"S";"0127";"      LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IHCOMP";"S";"0128";"      LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IHCOMP";"S";"0129";"      LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IHCOMP";"S";"0130";"      LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IHCOMP";"S";"0131";"*"
"IHCOMP";"S";"0132";"* INRH = 1 calcul des HS chaque dimanche"
"IHCOMP";"S";"0133";"* INRH = 2 calcul des HS le dernier dimanche du cycle"
"IHCOMP";"S";"0134";"* INRH = 3 calcul des HS chaque dimanche et en fin d'annualisation"
"IHCOMP";"S";"0135";"* Raz de la base HS le lundi"
"IHCOMP";"S";"0136";"      SI HJOU_JOUR = ""1"""
"IHCOMP";"S";"0137";"* raz chaque lundi <> 2 (0/1/3)"
"IHCOMP";"S";"0138";"         SI HJOU_IJIGHSUPPM <> ""2"""
"IHCOMP";"S";"0139";"            HJOU_IJRBHSMPAH = 0"
"IHCOMP";"S";"0140";"            HJOU_IJRBHPAYEE = 0"
"IHCOMP";"S";"0141";"         FINSI"
"IHCOMP";"S";"0142";"* raz le premier lundi du cycle si INRH = 2"
"IHCOMP";"S";"0143";"         SI HJOU_IJIGHSUPPM = ""2"""
"IHCOMP";"S";"0144";"* stokage de la duree theorique du code horaire"
"IHCOMP";"S";"0145";"            SI HJOU_RANG = 1"
"IHCOMP";"S";"0146";"               HJOU_IJRBHSMPAH = 0"
"IHCOMP";"S";"0147";"* raz de la duree theorique du cycle"
"IHCOMP";"S";"0148";"               HJOU_IJRTHEOCYC = 0"
"IHCOMP";"S";"0149";"               HJOU_IJRBHPAYEE = 0"
"IHCOMP";"S";"0150";"            FINSI"
"IHCOMP";"S";"0151";"* cumul de la duree theorique du cycle"
"IHCOMP";"S";"0152";"            HJOU_IJRTHEOCYC = HJOU_IJRTHEOCYC + HJOU_HORHEB"
"IHCOMP";"S";"0153";"         FINSI"
"IHCOMP";"S";"0154";"      FINSI"
"IHCOMP";"S";"0155";"      SI HJOU_IJIGHSUPPM <> ""0"""
"IHCOMP";"S";"0156";"* on calcul également la base HS dans le cas ou on"
"IHCOMP";"S";"0157";"* calcul un acquis RTT hebdo"
"IHCOMP";"S";"0158";"      OU HJOU_IJIGRETETR = ""3"""
"IHCOMP";"S";"0159";"         HJOU_IJQHPAYEES = HJOU_IJQPRESBAV"
"IHCOMP";"S";"0160";"         POUR ACTIVITES"
"IHCOMP";"S";"0161";"            SI MOTI_MOTYPE <> ""C"""
"IHCOMP";"S";"0162";"               SI MOTI_IMIGHRSSUP = ""1"""
"IHCOMP";"S";"0163";"               OU MOTI_IMIGHRPAYE = ""1"""
"IHCOMP";"S";"0164";"                  HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHCOMP";"S";"0165";"               FINSI"
"IHCOMP";"S";"0166";"            FINSI"
"IHCOMP";"S";"0167";"** alimentation par consignes"
"IHCOMP";"S";"0168";"            SI HABS_MOTIF = ""ZHPA"""
"IHCOMP";"S";"0169";"               HJOU_IJQHPAYEES = HABS_MOTIDUR"
"IHCOMP";"S";"0170";"            FINSI"
"IHCOMP";"S";"0171";"*"
"IHCOMP";"S";"0172";"            SI HABS_MOTIF = ""XHPA"""
"IHCOMP";"S";"0173";"               HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHCOMP";"S";"0174";"            FINSI"
"IHCOMP";"S";"0175";"         FINPOUR"
"IHCOMP";"S";"0176";"** alimentation des bases hebdo"
"IHCOMP";"S";"0177";"         HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HJOU_IJQPRESBAV"
"IHCOMP";"S";"0178";"*"
"IHCOMP";"S";"0179";"         HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE + HJOU_IJQHPAYEES"
"IHCOMP";"S";"0180";"         POUR ACTIVITES"
"IHCOMP";"S";"0181";"            SI MOTI_MOTYPE <> ""C"""
"IHCOMP";"S";"0182";"               SI MOTI_IMIGHRSSUP = ""1"""
"IHCOMP";"S";"0183";"                  HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HABS_MOTIDUR"
"IHCOMP";"S";"0184";"               FINSI"
"IHCOMP";"S";"0185";"            FINSI"
"IHCOMP";"S";"0186";"         FINPOUR"
"IHCOMP";"S";"0187";"      FINSI"
"IHCOMP";"S";"0188";"*** initialisation de la base HS par consigne"
"IHCOMP";"S";"0189";"      POUR ACTIVITES"
"IHCOMP";"S";"0190";"         SI HABS_MOTIF = ""ZBHS"""
"IHCOMP";"S";"0191";"            HJOU_IJRBHSMPAH = HABS_MOTIDUR"
"IHCOMP";"S";"0192";"         FINSI"
"IHCOMP";"S";"0193";"         SI HABS_MOTIF = ""ZBPA"""
"IHCOMP";"S";"0194";"            HJOU_IJRBHPAYEE = HABS_MOTIDUR"
"IHCOMP";"S";"0195";"         FINSI"
"IHCOMP";"S";"0196";"      FINPOUR"
"IHCOMP";"S";"0197";"      SI HJOU_IJIGHSUPPM <> ""0"""
"IHCOMP";"S";"0198";"* calcul des HS"
"IHCOMP";"S";"0199";"         SI HJOU_JOUR = ""7"""
"IHCOMP";"S";"0200";"            SI HJOU_IJIGHSUPPM = ""1"""
"IHCOMP";"S";"0201";"            OU HJOU_IJIGHSUPPM = ""3"""
"IHCOMP";"S";"0202";"** pour les temps partiels"
"IHCOMP";"S";"0203";"**"
"IHCOMP";"S";"0204";"               LOCA_HORHEB = HJOU_HORHEB"
"IHCOMP";"S";"0205";"               LOCA_HORCOH = PARD_IDIVHORCOH"
"IHCOMP";"S";"0206";"* 10% du contrat pour les temps partiel"
"IHCOMP";"S";"0207";"               LOCA_10 = LOCA_HORHEB * 0.10"
"IHCOMP";"S";"0208";"               LOCA_CAL = 1"
"IHCOMP";"S";"0209";"            FINSI"
"IHCOMP";"S";"0210";"            SI HJOU_IJIGHSUPPM = ""2"""
"IHCOMP";"S";"0211";"* dans le cas ou les HS se calculent en fin de cycle"
"IHCOMP";"S";"0212";"* loca_nbcycle correspond au nombre de semaines"
"IHCOMP";"S";"0213";"               LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"IHCOMP";"S";"0214";"               SI HJOU_RANG = LOCA_NBCYCLE"
"IHCOMP";"S";"0215";"* recalcul des seuils par rapport au nombre de semaines"
"IHCOMP";"S";"0216";"** pour les temps partiels"
"IHCOMP";"S";"0217";"* LOCA_HORHEB = HJOU_HORHEB * LOCA_NBCYCLE"
"IHCOMP";"S";"0218";"                  LOCA_HORHEB = HJOU_IJRTHEOCYC"
"IHCOMP";"S";"0219";"                  LOCA_HORCOH = PARD_IDIVHORCOH * LOCA_NBCYCLE"
"IHCOMP";"S";"0220";"* 10% du contrat pour les temps partiel"
"IHCOMP";"S";"0221";"                  LOCA_10 = LOCA_HORHEB * 0.10"
"IHCOMP";"S";"0222";"                  LOCA_CAL = 1"
"IHCOMP";"S";"0223";"               FINSI"
"IHCOMP";"S";"0224";"            FINSI"
"IHCOMP";"S";"0225";"*  Calcul des heures suppl?mentaires ? 25% et 50%"
"IHCOMP";"S";"0226";"            SI LOCA_CAL = 1"
"IHCOMP";"S";"0227";"               SI LOCA_HORHEB < LOCA_HORCOH"
"IHCOMP";"S";"0228";"                  SI HJOU_IJRBHPAYEE > LOCA_HORHEB"
"IHCOMP";"S";"0229";"                     HJOU_IJQHCNMAPA = HJOU_IJRBHPAYEE - LOCA_HORHEB"
"IHCOMP";"S";"0230";"                  FINSI"
"IHCOMP";"S";"0231";"*"
"IHCOMP";"S";"0232";"                  SI HJOU_IJRBHSMPAH > LOCA_HORHEB"
"IHCOMP";"S";"0233";"                     LOCA_HCOMP = HJOU_IJRBHSMPAH - LOCA_HORHEB"
"IHCOMP";"S";"0234";"* cas ou LOCA_HCOMP > 10% du contrat"
"IHCOMP";"S";"0235";"                     SI LOCA_HCOMP >= LOCA_10"
"IHCOMP";"S";"0332";"         FINPOUR"
"IHCOMP";"S";"0236";"** calcul HS25 % dans le cas ou les heures complementaires > 10% du contra"
"IHCOMP";"S";"0237";"                        HJOU_IJQHSNMAP2 = LOCA_HCOMP - LOCA_10"
"IHCOMP";"S";"0238";"                        LOCA_HCOMP = LOCA_10"
"IHCOMP";"S";"0239";"                     FINSI"
"IHCOMP";"S";"0240";"** calcul des heures complementaires taux 1"
"IHCOMP";"S";"0241";"                     HJOU_IJQHSNMAPA = LOCA_HCOMP"
"IHCOMP";"S";"0242";"*"
"IHCOMP";"S";"0243";"* Dépassement de l'horaire hebdo temps plein"
"IHCOMP";"S";"0244";"                     SI HJOU_IJRBHSMPAH > LOCA_HORCOH"
"IHCOMP";"S";"0245";"                        ANOMALIE 171"
"IHCOMP";"S";"0246";"                     FINSI"
"IHCOMP";"S";"0247";"* Anomalie en cas de dépassement de 10% du contrat"
"IHCOMP";"S";"0248";"                     LOCA_CAL2 = HJOU_IJRBHSMPAH - LOCA_HORHEB"
"IHCOMP";"S";"0249";"                     SI LOCA_CAL2 > LOCA_10"
"IHCOMP";"S";"0250";"                        ANOMALIE 225"
"IHCOMP";"S";"0251";"                     FINSI"
"IHCOMP";"S";"0252";"*"
"IHCOMP";"S";"0253";"                     POUR ACTIVITES"
"IHCOMP";"S";"0254";"* Taux 1"
"IHCOMP";"S";"0255";"                        SI HABS_MOTIF = ""XCOP"""
"IHCOMP";"S";"0256";"                           HJOU_IJQHSNMAPA = HJOU_IJQHSNMAPA + HABS_MOTIDUR"
"IHCOMP";"S";"0257";"                        FINSI"
"IHCOMP";"S";"0258";"                        SI HABS_MOTIF = ""ZCOP"""
"IHCOMP";"S";"0259";"                           HJOU_IJQHSNMAPA = HABS_MOTIDUR"
"IHCOMP";"S";"0260";"                        FINSI"
"IHCOMP";"S";"0261";"* Taux 2"
"IHCOMP";"S";"0262";"                        SI HABS_MOTIF = ""XCOP2"""
"IHCOMP";"S";"0263";"                           HJOU_IJQHSNMAP2 = HJOU_IJQHSNMAP2 + HABS_MOTIDUR"
"IHCOMP";"S";"0264";"                        FINSI"
"IHCOMP";"S";"0265";"                        SI HABS_MOTIF = ""ZCOP2"""
"IHCOMP";"S";"0266";"                           HJOU_IJQHSNMAP2 = HABS_MOTIDUR"
"IHCOMP";"S";"0267";"                        FINSI"
"IHCOMP";"S";"0268";"                     FINPOUR"
"IHCOMP";"S";"0269";"* Taux 1"
"IHCOMP";"S";"0270";"                     HJOU_IJQHCNMAPA = HJOU_IJQHCNMAPA - HJOU_IJQHSNMAPA"
"IHCOMP";"S";"0271";"* Taux 2"
"IHCOMP";"S";"0272";"                     HJOU_IJQHCNMAPA = HJOU_IJQHCNMAPA - HJOU_IJQHSNMAP2"
"IHCOMP";"S";"0273";"*"
"IHCOMP";"S";"0274";"** cas ou les heures complementaires sont a recuperer"
"IHCOMP";"S";"0275";"                     SI HJOU_IJIGHSUPPR = ""1"""
"IHCOMP";"S";"0276";"** a compter du 01/01/2014 elles sont majorées de 10%"
"IHCOMP";"S";"0277";"                        SI HJOU_DATE >= ""01012014"""
"IHCOMP";"S";"0278";"                           HJOU_IJQHSNMAPA = HJOU_IJQHSNMAPA * LOCA_TAUXC"
"IHCOMP";"S";"0279";"                        FINSI"
"IHCOMP";"S";"0280";"                        HJOU_IJQHSNMARE = HJOU_IJQHSNMAPA"
"IHCOMP";"S";"0281";"                        HJOU_IJQHSNMAPA = 0"
"IHCOMP";"S";"0282";"* Ajout de la majoration taux 2 pour les heures à récupérer"
"IHCOMP";"S";"0283";"                        HJOU_IJQHSNMAP2 = HJOU_IJQHSNMAP2 * LOCA_TAUXC2"
"IHCOMP";"S";"0284";"* HJOU_XXXX3 = HC à récup. taux 2"
"IHCOMP";"S";"0285";"                        HJOU_IJQHSNMAR2 = HJOU_IJQHSNMAP2"
"IHCOMP";"S";"0286";"                        HJOU_IJQHSNMAP2 = 0"
"IHCOMP";"S";"0287";"*"
"IHCOMP";"S";"0288";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMARE"
"IHCOMP";"S";"0289";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMAR2"
"IHCOMP";"S";"0290";"                     FINSI"
"IHCOMP";"S";"0291";"                  FINSI"
"IHCOMP";"S";"0292";"*"
"IHCOMP";"S";"0293";"                  SI HJOU_IJQHCNMAPA < 0"
"IHCOMP";"S";"0294";"                     ANOMALIE 192"
"IHCOMP";"S";"0295";"                  FINSI"
"IHCOMP";"S";"0296";"               FINSI"
"IHCOMP";"S";"0297";"            FINSI"
"IHCOMP";"S";"0298";"         FINSI"
"IHCOMP";"S";"0299";"*"
"IHCOMP";"S";"0300";"         POUR ACTIVITES"
"IHCOMP";"S";"0301";"            SI HABS_MOTIF = PARD_IDIVMOTHSR"
"IHCOMP";"S";"0302";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HABS_MOTIDUR"
"IHCOMP";"S";"0303";"               LOCA_CONSO = 1"
"IHCOMP";"S";"0304";"            FINSI"
"IHCOMP";"S";"0305";"            SI HABS_MOTIF = ""ZHCP"""
"IHCOMP";"S";"0306";"               HJOU_IJQHCNMAPA = HABS_MOTIDUR"
"IHCOMP";"S";"0307";"            FINSI"
"IHCOMP";"S";"0308";"* Taux 1"
"IHCOMP";"S";"0309";"            SI HABS_MOTIF = ""XCOR"""
"IHCOMP";"S";"0310";"            OU HABS_MOTIF = ""ZCOR"""
"IHCOMP";"S";"0311";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_IJQHSNMARE"
"IHCOMP";"S";"0312";"               SI HABS_MOTIF = ""XCOR"""
"IHCOMP";"S";"0313";"                  HJOU_IJQHSNMARE = HJOU_IJQHSNMARE + HABS_MOTIDUR"
"IHCOMP";"S";"0314";"               FINSI"
"IHCOMP";"S";"0315";"               SI HABS_MOTIF = ""ZCOR"""
"IHCOMP";"S";"0316";"                  HJOU_IJQHSNMARE = HABS_MOTIDUR"
"IHCOMP";"S";"0317";"               FINSI"
"IHCOMP";"S";"0318";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMARE"
"IHCOMP";"S";"0319";"            FINSI"
"IHCOMP";"S";"0320";"* Taux 2"
"IHCOMP";"S";"0321";"            SI HABS_MOTIF = ""XCOR2"""
"IHCOMP";"S";"0322";"            OU HABS_MOTIF = ""ZCOR2"""
"IHCOMP";"S";"0323";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_IJQHSNMAR2"
"IHCOMP";"S";"0324";"               SI HABS_MOTIF = ""XCOR2"""
"IHCOMP";"S";"0325";"                  HJOU_IJQHSNMAR2 = HJOU_IJQHSNMAR2 + HABS_MOTIDUR"
"IHCOMP";"S";"0326";"               FINSI"
"IHCOMP";"S";"0327";"               SI HABS_MOTIF = ""ZCOR2"""
"IHCOMP";"S";"0328";"                  HJOU_IJQHSNMAR2 = HABS_MOTIDUR"
"IHCOMP";"S";"0329";"               FINSI"
"IHCOMP";"S";"0330";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMAR2"
"IHCOMP";"S";"0331";"            FINSI"
"IHCOMP";"S";"0333";"*"
"IHCOMP";"S";"0334";"         SI LOCA_CONSO = 1"
"IHCOMP";"S";"0335";"            SI HJOU_IJRSHSMREH < 0"
"IHCOMP";"S";"0336";"               ANOMALIE 226"
"IHCOMP";"S";"0337";"               TEMP_CNRETOUR = 2"
"IHCOMP";"S";"0338";"               TEMP_CNMESS = 226"
"IHCOMP";"S";"0339";"            FINSI"
"IHCOMP";"S";"0340";"         FINSI"
"IHCOMP";"S";"0341";"      FINSI"
"IHCOMP";"S";"0342";"**"
"IHCOMP";"S";"0343";"** Soldes previsionnels"
"IHCOMP";"S";"0344";"**"
"IHCOMP";"S";"0345";"      SI CTRA_DATFIN > TEMP_DATJOU"
"IHCOMP";"S";"0346";"         SI CTRA_DATFIN < LOCA_DATEFU"
"IHCOMP";"S";"0347";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHCOMP";"S";"0348";"            LOCA_DATEFU = TEMP_DXFINPER"
"IHCOMP";"S";"0349";"         SINON"
"IHCOMP";"S";"0350";"            SI CTRA_DATFIN < LOCA_DATEFU2"
"IHCOMP";"S";"0351";"               DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHCOMP";"S";"0352";"               LOCA_DATEFU2 = TEMP_DXFINPER"
"IHCOMP";"S";"0353";"            FINSI"
"IHCOMP";"S";"0354";"         FINSI"
"IHCOMP";"S";"0355";"      FINSI"
"IHCOMP";"S";"0356";"***"
"IHCOMP";"S";"0357";"      SI TEMP_DATSUI = LOCA_DATEFU"
"IHCOMP";"S";"0358";"         EMPL_IEQSHSMRE1 = HJOU_IJRSHSMREH"
"IHCOMP";"S";"0359";"      FINSI"
"IHCOMP";"S";"0360";"**"
"IHCOMP";"S";"0361";"      SI TEMP_DATSUI = LOCA_DATEFU2"
"IHCOMP";"S";"0362";"         EMPL_IEQSHSMRE2 = HJOU_IJRSHSMREH"
"IHCOMP";"S";"0363";"      FINSI"
"IHCOMP";"S";"0364";"   FINSI"
"IHCOMP";"S";"0365";"FINSI"
"IHCOMP";"S";"0366";"*"
"IHCOMP";"S";"0367";"FIN"
"IHCOMPDIM";"S";"0001";"************************************************************************"
"IHCOMPDIM";"S";"0002";"*"
"IHCOMPDIM";"S";"0003";"* Règle : IHCOMPDIM"
"IHCOMPDIM";"S";"0004";"* Ordre : 6080"
"IHCOMPDIM";"S";"0005";"* Titre : Calcul des heures complémentaires pour les temps partiels"
"IHCOMPDIM";"S";"0006";"*          lundi 0h au dimanche 24h"
"IHCOMPDIM";"S";"0007";"*"
"IHCOMPDIM";"S";"0008";"*----------------------------------------------------------------------"
"IHCOMPDIM";"S";"0009";"*"
"IHCOMPDIM";"S";"0010";"* Créé par : Méthodes et outils"
"IHCOMPDIM";"S";"0011";"* Date     : 25/09/2019"
"IHCOMPDIM";"S";"0012";"* Version  : 1"
"IHCOMPDIM";"S";"0013";"*"
"IHCOMPDIM";"S";"0014";"*----------------------------------------------------------------------"
"IHCOMPDIM";"S";"0015";"*"
"IHCOMPDIM";"S";"0016";"*"
"IHCOMPDIM";"S";"0017";"* Rôle : Calcul des heures complémentaires pour les temps partiels"
"IHCOMPDIM";"S";"0018";"*"
"IHCOMPDIM";"S";"0019";"*"
"IHCOMPDIM";"S";"0020";"*         Adaptation de la règle IHSUPPDIM avec ajout suivant :"
"IHCOMPDIM";"S";"0021";"*"
"IHCOMPDIM";"S";"0022";"*         Ajout de l'anomalie 225 en cas de dépassement d'heures de 10%"
"IHCOMPDIM";"S";"0023";"*         du contrat"
"IHCOMPDIM";"S";"0024";"*         + séparation en deux des règles IHSUPP et IHSUPPDIM afin de"
"IHCOMPDIM";"S";"0025";"*         différencier les HS et les HC"
"IHCOMPDIM";"S";"0026";"*         + évolution des HC avec ajout d'un compteur heures payées non majorées,"
"IHCOMPDIM";"S";"0027";"*         HC taux 2 pour les heures payées et les heures à récupérer"
"IHCOMPDIM";"S";"0028";"*"
"IHCOMPDIM";"S";"0029";"*----------------------------------------------------------------------"
"IHCOMPDIM";"S";"0030";"*"
"IHCOMPDIM";"S";"0031";"* Modifiée par : Méthodes et outils"
"IHCOMPDIM";"S";"0032";"* Date         : 30/06/2020"
"IHCOMPDIM";"S";"0033";"* Objet        : Le test de CTRA_ICITAUX est remplacé par HJOU_IJITYPCTRA"
"IHCOMPDIM";"S";"0034";"*                 car le taux du contrat est désormais copié dans JOU"
"IHCOMPDIM";"S";"0035";"*"
"IHCOMPDIM";"S";"0036";"***********************************************************************"
"IHCOMPDIM";"S";"0037";"*"
"IHCOMPDIM";"S";"0038";"* Implémentation des données industrielles"
"IHCOMPDIM";"S";"0039";"*"
"IHCOMPDIM";"S";"0040";"DEBDICO"
"IHCOMPDIM";"S";"0041";"   HJOU_IJIGHSUPPM;O;Z1;X;;;123456789;L;;C2;""Régime HS"";"
"IHCOMPDIM";"S";"0042";"   HJOU_IJRBHSMPAH;N;T6,2;I;;;    56789;;IJRBHSMPAH;V3;""Base HS"";"
"IHCOMPDIM";"S";"0043";"   HJOU_IJQHS1MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 1 à récup."";"
"IHCOMPDIM";"S";"0044";"   HJOU_IJQHS2MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 2 à récup."";"
"IHCOMPDIM";"S";"0045";"   HJOU_IJRSHSMREH;N;T8,2;L;;;     6789;;IJRSHSMREH;V3;""Récupération HS/HC"";"
"IHCOMPDIM";"S";"0046";"   HJOU_IJQHSNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures complémentaires"";"
"IHCOMPDIM";"S";"0047";"   HJOU_IJQHSNMARE;N;T6,2;I;;;     6789;;;V3;""Heures complémentaires récupérables"";"
"IHCOMPDIM";"S";"0048";"   HJOU_IJRTHEOCYC;N;T6,2;I;;;    56789;;IJRTHEOCYC;V3;""Theorie du cycle"";"
"IHCOMPDIM";"S";"0049";"   HJOU_IJQHPAYEES;N;T6,2;I;;;    56789;;;V3;""Heures payées"";"
"IHCOMPDIM";"S";"0050";"   HJOU_IJRBHPAYEE;N;T6,2;I;;;    56789;;IJRBHPAYEE;V3;""Base des heures payées"";"
"IHCOMPDIM";"S";"0051";"   MOTI_IMIGHRPAYE;O;Z1;X;0;1;123456789;C;;C2;""Participe aux heures payées"";"
"IHCOMPDIM";"S";"0052";"   EMPL_IEQSHSMRE1;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 1 HS à recup."";"
"IHCOMPDIM";"S";"0053";"   EMPL_IEQSHSMRE2;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 2 HS à recup."";"
"IHCOMPDIM";"S";"0054";"   PARD_IDIHCTAUX1;O;N2;I;;;123456789;;;C3;""Heures compl. taux 1 (%)"";"
"IHCOMPDIM";"S";"0055";"   PARD_IDIHCTAUX2;O;N2;I;;;123456789;;;C3;""Heures compl. à récup. taux 2 (%)"";"
"IHCOMPDIM";"S";"0056";"   HJOU_IJQHCNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures comp. payées non majorées"";"
"IHCOMPDIM";"S";"0057";"   HJOU_IJQHSNMAP2;N;T6,2;I;;;    56789;;;V3;""Heures complémentaires taux 2"";"
"IHCOMPDIM";"S";"0058";"   HJOU_IJQHSNMAR2;N;T6,2;I;;;     6789;;;V3;""Heures complémentaires taux 2 à récup."";"
"IHCOMPDIM";"S";"0059";"FINDICO"
"IHCOMPDIM";"S";"0060";"DEBANO"
"IHREFF";"S";"0096";"FINSI"
"IHCOMPDIM";"S";"0061";"   171;8;""Dépassement de l'horaire hebdomadaire temps plein"";"
"IHCOMPDIM";"S";"0062";"   192;9;""Heures non majorées payées négatives"";"
"IHCOMPDIM";"S";"0063";"   225;6;""Nombre maxi d'heures complémentaires atteint pour ce contrat"";"
"IHCOMPDIM";"S";"0064";"   226;9;""Solde récup HS/HC insuffisant"";"
"IHCOMPDIM";"S";"0065";"FINANO"
"IHCOMPDIM";"S";"0066";"*"
"IHCOMPDIM";"S";"0067";"* Déclaration des donnees locales"
"IHCOMPDIM";"S";"0068";"*"
"IHCOMPDIM";"S";"0069";"DEF LOCA_NBCYCLE N2"
"IHCOMPDIM";"S";"0070";"LOCA_NBCYCLE = 0"
"IHCOMPDIM";"S";"0071";"DEF LOCA_CAL N1"
"IHCOMPDIM";"S";"0072";"LOCA_CAL = 0"
"IHCOMPDIM";"S";"0073";"DEF LOCA_HORHEB T6.2"
"IHCOMPDIM";"S";"0074";"LOCA_HORHEB = 0"
"IHCOMPDIM";"S";"0075";"DEF LOCA_HORCOH T6.2"
"IHCOMPDIM";"S";"0076";"LOCA_HORCOH = 0"
"IHCOMPDIM";"S";"0077";"DEF LOCA_10 T6.2"
"IHCOMPDIM";"S";"0078";"LOCA_10 = 0"
"IHCOMPDIM";"S";"0079";"DEF LOCA_HCOMP T6.2"
"IHCOMPDIM";"S";"0080";"LOCA_HCOMP = 0"
"IHCOMPDIM";"S";"0081";"DEF LOCA_BASEHS T6.2"
"IHCOMPDIM";"S";"0082";"LOCA_BASEHS = 0"
"IHCOMPDIM";"S";"0083";"DEF LOCA_DATE D"
"IHCOMPDIM";"S";"0084";"LOCA_DATE = "" """
"IHCOMPDIM";"S";"0085";"DEF LOCA_ACOURS N4"
"IHCOMPDIM";"S";"0086";"LOCA_ACOURS = 0"
"IHCOMPDIM";"S";"0087";"DEF LOCA_ACOURS2 N4"
"IHCOMPDIM";"S";"0088";"LOCA_ACOURS2 = 0"
"IHCOMPDIM";"S";"0089";"DEF LOCA_DATEFU D"
"IHCOMPDIM";"S";"0090";"LOCA_DATEFU = "" """
"IHCOMPDIM";"S";"0091";"DEF LOCA_DATEFU2 D"
"IHCOMPDIM";"S";"0092";"LOCA_DATEFU2 = "" """
"IHCOMPDIM";"S";"0093";"* Taux 1 pour récupération"
"IHCOMPDIM";"S";"0094";"DEF LOCA_TAUXC N4.2"
"IHCOMPDIM";"S";"0095";"LOCA_TAUXC = 0"
"IHCOMPDIM";"S";"0096";"LOCA_TAUXC = PARD_IDIHCTAUX1 / 100"
"IHCOMPDIM";"S";"0097";"LOCA_TAUXC = LOCA_TAUXC + 1"
"IHCOMPDIM";"S";"0098";"* Taux 2 pour récupération"
"IHCOMPDIM";"S";"0099";"DEF LOCA_TAUXC2 N4.2"
"IHCOMPDIM";"S";"0100";"LOCA_TAUXC2 = 0"
"IHCOMPDIM";"S";"0101";"LOCA_TAUXC2 = PARD_IDIHCTAUX2 / 100"
"IHCOMPDIM";"S";"0102";"LOCA_TAUXC2 = LOCA_TAUXC2 + 1"
"IHCOMPDIM";"S";"0103";"* Pour calcul de la différence entre Base HS"
"IHCOMPDIM";"S";"0104";"* et théorie"
"IHCOMPDIM";"S";"0105";"DEF LOCA_CAL2 T6.2"
"IHCOMPDIM";"S";"0106";"LOCA_CAL2 = 0"
"IHCOMPDIM";"S";"0107";"DEF LOCA_CONSO N1"
"IHCOMPDIM";"S";"0108";"LOCA_CONSO = 0"
"IHCOMPDIM";"S";"0109";"*"
"IHCOMPDIM";"S";"0110";"* Si temps partiels"
"IHCOMPDIM";"S";"0111";"SI HJOU_IJITYPCTRA > 0"
"IHCOMPDIM";"S";"0112";"   SI HJOU_IJITYPCTRA < 100"
"IHCOMPDIM";"S";"0113";"*"
"IHCOMPDIM";"S";"0114";"* Alimentation des données locales pour calcul soldes prévisionnels"
"IHCOMPDIM";"S";"0115";"*"
"IHCOMPDIM";"S";"0116";"      SI PARD_IDIDDEBANN <> "" """
"IHCOMPDIM";"S";"0117";"         LOCA_DATE(5:4) = PARD_IDIDDEBANN(5:4)"
"IHCOMPDIM";"S";"0118";"      SINON"
"IHCOMPDIM";"S";"0119";"         LOCA_DATE(5:4) = ""0101"""
"IHCOMPDIM";"S";"0120";"      FINSI"
"IHCOMPDIM";"S";"0121";"**"
"IHCOMPDIM";"S";"0122";"      LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IHCOMPDIM";"S";"0123";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHCOMPDIM";"S";"0124";"*"
"IHCOMPDIM";"S";"0125";"      SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IHCOMPDIM";"S";"0126";"         LOCA_ACOURS = LOCA_ACOURS + 1"
"IHCOMPDIM";"S";"0127";"         LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHCOMPDIM";"S";"0128";"      FINSI"
"IHCOMPDIM";"S";"0129";"*"
"IHCOMPDIM";"S";"0130";"      LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IHCOMPDIM";"S";"0131";"      LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IHCOMPDIM";"S";"0132";"      LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IHCOMPDIM";"S";"0133";"      LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IHCOMPDIM";"S";"0134";"*"
"IHCOMPDIM";"S";"0135";"* INRH = 1 calcul des HS chaque dimanche"
"IHCOMPDIM";"S";"0136";"* INRH = 2 calcul des HS le dernier dimanche du cycle"
"IHCOMPDIM";"S";"0137";"* INRH = 3 calcul des HS chaque dimanche et en fin d'annualisation"
"IHCOMPDIM";"S";"0138";"* Raz de la base HS le lundi"
"IHCOMPDIM";"S";"0139";"      SI HJOU_JOUR = ""1"""
"IHCOMPDIM";"S";"0140";"* raz chaque lundi <> 2 (0/1/3)"
"IHCOMPDIM";"S";"0141";"         SI HJOU_IJIGHSUPPM <> ""2"""
"IHCOMPDIM";"S";"0142";"            HJOU_IJRBHSMPAH = 0"
"IHCOMPDIM";"S";"0143";"            HJOU_IJRBHPAYEE = 0"
"IHCOMPDIM";"S";"0144";"         FINSI"
"IHCOMPDIM";"S";"0145";"* raz le premier lundi du cycle si INRH = 2"
"IHCOMPDIM";"S";"0146";"         SI HJOU_IJIGHSUPPM = ""2"""
"IHCOMPDIM";"S";"0147";"* stokage de la duree theorique du code horaire"
"IHCOMPDIM";"S";"0148";"            SI HJOU_RANG = 1"
"IHCOMPDIM";"S";"0149";"               HJOU_IJRBHSMPAH = 0"
"IHCOMPDIM";"S";"0150";"* raz de la duree theorique du cycle"
"IHCOMPDIM";"S";"0151";"               HJOU_IJRTHEOCYC = 0"
"IHCOMPDIM";"S";"0152";"               HJOU_IJRBHPAYEE = 0"
"IHCOMPDIM";"S";"0153";"            FINSI"
"IHCOMPDIM";"S";"0154";"* cumul de la duree theorique du cycle"
"IHCOMPDIM";"S";"0155";"            HJOU_IJRTHEOCYC = HJOU_IJRTHEOCYC + HJOU_HORHEB"
"IHCOMPDIM";"S";"0156";"         FINSI"
"IHCOMPDIM";"S";"0157";"      FINSI"
"IHCOMPDIM";"S";"0158";"      SI HJOU_IJIGHSUPPM <> ""0"""
"IHCOMPDIM";"S";"0159";"* on calcul également la base HS dans le cas ou on"
"IHCOMPDIM";"S";"0160";"* calcul un acquis RTT hebdo"
"IHCOMPDIM";"S";"0161";"      OU HJOU_IJIGRETETR = ""3"""
"IHCOMPDIM";"S";"0162";"* Calcul de la base des HS"
"IHCOMPDIM";"S";"0163";"         LOCA_BASEHS = HJOU_IJQPRESBAV"
"IHCOMPDIM";"S";"0164";"* le dimanche on ne prend que les heures jour en cours"
"IHCOMPDIM";"S";"0165";"         SI HJOU_JOUR = ""7"""
"IHCOMPDIM";"S";"0166";"            LOCA_BASEHS = HJOU_IJQPREJENC"
"IHCOMPDIM";"S";"0167";"         FINSI"
"IHCOMPDIM";"S";"0168";"*"
"IHCOMPDIM";"S";"0169";"* le lundi , dans le cas ou l'agent a commençé à 21h00 le dimanche"
"IHCOMPDIM";"S";"0170";"* on prend les heures faites le dimanche apres minuit"
"IHCOMPDIM";"S";"0171";"*"
"IHCOMPDIM";"S";"0172";"         SI HJOU_JOUR = ""1"""
"IHCOMPDIM";"S";"0173";"            LOCA_BASEHS = LOCA_BASEHS + HJOU_IJRPREVEIL"
"IHCOMPDIM";"S";"0174";"         FINSI"
"IHCOMPDIM";"S";"0175";"**"
"IHCOMPDIM";"S";"0176";"         HJOU_IJQHPAYEES = LOCA_BASEHS"
"IHCOMPDIM";"S";"0177";"         POUR ACTIVITES"
"IHCOMPDIM";"S";"0178";"            SI MOTI_MOTYPE <> ""C"""
"IHCOMPDIM";"S";"0179";"               SI MOTI_IMIGHRSSUP = ""1"""
"IHCOMPDIM";"S";"0180";"               OU MOTI_IMIGHRPAYE = ""1"""
"IHCOMPDIM";"S";"0181";"                  HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0182";"               FINSI"
"IHCOMPDIM";"S";"0183";"            FINSI"
"IHCOMPDIM";"S";"0184";"** alimentation par consignes"
"IHCOMPDIM";"S";"0185";"            SI HABS_MOTIF = ""ZHPA"""
"IHCOMPDIM";"S";"0186";"               HJOU_IJQHPAYEES = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0187";"            FINSI"
"IHCOMPDIM";"S";"0188";"*"
"IHCOMPDIM";"S";"0189";"            SI HABS_MOTIF = ""XHPA"""
"IHCOMPDIM";"S";"0190";"               HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0191";"            FINSI"
"IHCOMPDIM";"S";"0192";"         FINPOUR"
"IHCOMPDIM";"S";"0193";"** alimentation des bases hebdo"
"IHCOMPDIM";"S";"0194";"         HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + LOCA_BASEHS"
"IHCOMPDIM";"S";"0195";"*"
"IHCOMPDIM";"S";"0196";"         HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE + HJOU_IJQHPAYEES"
"IHCOMPDIM";"S";"0197";"         POUR ACTIVITES"
"IHCOMPDIM";"S";"0198";"            SI MOTI_MOTYPE <> ""C"""
"IHCOMPDIM";"S";"0199";"               SI MOTI_IMIGHRSSUP = ""1"""
"IHCOMPDIM";"S";"0200";"                  HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0201";"               FINSI"
"IHCOMPDIM";"S";"0202";"            FINSI"
"IHCOMPDIM";"S";"0203";"         FINPOUR"
"IHCOMPDIM";"S";"0204";"      FINSI"
"IHCOMPDIM";"S";"0205";"*** initialisation de la base HS par consigne"
"IHCOMPDIM";"S";"0206";"      POUR ACTIVITES"
"IHCOMPDIM";"S";"0207";"         SI HABS_MOTIF = ""ZBHS"""
"IHCOMPDIM";"S";"0208";"            HJOU_IJRBHSMPAH = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0209";"         FINSI"
"IHCOMPDIM";"S";"0210";"         SI HABS_MOTIF = ""ZBPA"""
"IHCOMPDIM";"S";"0211";"            HJOU_IJRBHPAYEE = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0212";"         FINSI"
"IHCOMPDIM";"S";"0213";"      FINPOUR"
"IHCOMPDIM";"S";"0214";"      SI HJOU_IJIGHSUPPM <> ""0"""
"IHCOMPDIM";"S";"0215";"* calcul des HS"
"IHCOMPDIM";"S";"0216";"         SI HJOU_JOUR = ""7"""
"IHCOMPDIM";"S";"0217";"            SI HJOU_IJIGHSUPPM = ""1"""
"IHCOMPDIM";"S";"0218";"            OU HJOU_IJIGHSUPPM = ""3"""
"IHCOMPDIM";"S";"0219";"** pour les temps partiels"
"IHCOMPDIM";"S";"0220";"**"
"IHCOMPDIM";"S";"0221";"               LOCA_HORHEB = HJOU_HORHEB"
"IHCOMPDIM";"S";"0222";"               LOCA_HORCOH = PARD_IDIVHORCOH"
"IHCOMPDIM";"S";"0223";"* 10% du contrat pour les temps partiel"
"IHCOMPDIM";"S";"0224";"               LOCA_10 = LOCA_HORHEB * 0.10"
"IHCOMPDIM";"S";"0225";"               LOCA_CAL = 1"
"IHCOMPDIM";"S";"0226";"            FINSI"
"IHCOMPDIM";"S";"0227";"            SI HJOU_IJIGHSUPPM = ""2"""
"IHCOMPDIM";"S";"0228";"* dans le cas ou les HS se calculent en fin de cycle"
"IHCOMPDIM";"S";"0229";"* loca_nbcycle correspond au nombre de semaines"
"IHCOMPDIM";"S";"0230";"               LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"IHCOMPDIM";"S";"0231";"               SI HJOU_RANG = LOCA_NBCYCLE"
"IHCOMPDIM";"S";"0232";"* recalcul des seuils par rapport au nombre de semaines"
"IHCOMPDIM";"S";"0233";"** pour les temps partiels"
"IHCOMPDIM";"S";"0234";"* LOCA_HORHEB = HJOU_HORHEB * LOCA_NBCYCLE"
"IHCOMPDIM";"S";"0235";"                  LOCA_HORHEB = HJOU_IJRTHEOCYC"
"IHCOMPDIM";"S";"0236";"                  LOCA_HORCOH = PARD_IDIVHORCOH * LOCA_NBCYCLE"
"IHCOMPDIM";"S";"0237";"* 10% du contrat pour les temps partiel"
"IHCOMPDIM";"S";"0238";"                  LOCA_10 = LOCA_HORHEB * 0.10"
"IHCOMPDIM";"S";"0239";"                  LOCA_CAL = 1"
"IHCOMPDIM";"S";"0240";"               FINSI"
"IHCOMPDIM";"S";"0241";"            FINSI"
"IHCOMPDIM";"S";"0242";"*  Calcul des heures complémentaires à 10 % et 25%"
"IHCOMPDIM";"S";"0243";"            SI LOCA_CAL = 1"
"IHCOMPDIM";"S";"0244";"               SI LOCA_HORHEB < LOCA_HORCOH"
"IHCOMPDIM";"S";"0245";"                  SI HJOU_IJRBHPAYEE > LOCA_HORHEB"
"IHCOMPDIM";"S";"0246";"                     HJOU_IJQHCNMAPA = HJOU_IJRBHPAYEE - LOCA_HORHEB"
"IHCOMPDIM";"S";"0247";"                  FINSI"
"IHCOMPDIM";"S";"0248";"*"
"IHCOMPDIM";"S";"0249";"                  SI HJOU_IJRBHSMPAH > LOCA_HORHEB"
"IHCOMPDIM";"S";"0250";"                     LOCA_HCOMP = HJOU_IJRBHSMPAH - LOCA_HORHEB"
"IHCOMPDIM";"S";"0251";"* cas ou LOCA_HCOMP > 10% du contrat"
"IHCOMPDIM";"S";"0252";"                     SI LOCA_HCOMP >= LOCA_10"
"IHCOMPDIM";"S";"0253";"** calcul HC25 % dans le cas ou les heures complementaires > 10% du contra"
"IHCOMPDIM";"S";"0254";"                        HJOU_IJQHSNMAP2 = LOCA_HCOMP - LOCA_10"
"IHCOMPDIM";"S";"0255";"                        LOCA_HCOMP = LOCA_10"
"IHCOMPDIM";"S";"0256";"                     FINSI"
"IHCOMPDIM";"S";"0257";"** calcul des heures complementaires taux 1"
"IHCOMPDIM";"S";"0258";"                     HJOU_IJQHSNMAPA = LOCA_HCOMP"
"IHCOMPDIM";"S";"0259";"*"
"IHCOMPDIM";"S";"0260";"* Dépassement de l'horaire hebdo temps plein"
"IHCOMPDIM";"S";"0261";"                     SI HJOU_IJRBHSMPAH > LOCA_HORCOH"
"IHCOMPDIM";"S";"0262";"                        ANOMALIE 171"
"IHCOMPDIM";"S";"0263";"                     FINSI"
"IHCOMPDIM";"S";"0264";"* Anomalie en cas de dépassement de 10% du contrat"
"IHCOMPDIM";"S";"0265";"                     LOCA_CAL2 = HJOU_IJRBHSMPAH - LOCA_HORHEB"
"IHCOMPDIM";"S";"0266";"                     SI LOCA_CAL2 > LOCA_10"
"IHCOMPDIM";"S";"0267";"                        ANOMALIE 225"
"IHCOMPDIM";"S";"0268";"                     FINSI"
"IHCOMPDIM";"S";"0269";"*"
"IHCOMPDIM";"S";"0270";"                     POUR ACTIVITES"
"IHCOMPDIM";"S";"0271";"* Taux 1"
"IHCOMPDIM";"S";"0272";"                        SI HABS_MOTIF = ""XCOP"""
"IHCOMPDIM";"S";"0273";"                           HJOU_IJQHSNMAPA = HJOU_IJQHSNMAPA + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0274";"                        FINSI"
"IHCOMPDIM";"S";"0275";"                        SI HABS_MOTIF = ""ZCOP"""
"IHCOMPDIM";"S";"0276";"                           HJOU_IJQHSNMAPA = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0277";"                        FINSI"
"IHCOMPDIM";"S";"0278";"* Taux 2"
"IHCOMPDIM";"S";"0279";"                        SI HABS_MOTIF = ""XCOP2"""
"IHCOMPDIM";"S";"0280";"                           HJOU_IJQHSNMAP2 = HJOU_IJQHSNMAP2 + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0281";"                        FINSI"
"IHCOMPDIM";"S";"0282";"                        SI HABS_MOTIF = ""ZCOP2"""
"IHCOMPDIM";"S";"0283";"                           HJOU_IJQHSNMAP2 = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0284";"                        FINSI"
"IHCOMPDIM";"S";"0285";"                     FINPOUR"
"IHCOMPDIM";"S";"0286";"* Taux 1"
"IHCOMPDIM";"S";"0287";"                     HJOU_IJQHCNMAPA = HJOU_IJQHCNMAPA - HJOU_IJQHSNMAPA"
"IHCOMPDIM";"S";"0288";"* Taux 2"
"IHCOMPDIM";"S";"0289";"                     HJOU_IJQHCNMAPA = HJOU_IJQHCNMAPA - HJOU_IJQHSNMAP2"
"IHCOMPDIM";"S";"0290";"*"
"IHCOMPDIM";"S";"0291";"** cas ou les heures complementaires sont à recuperer"
"IHCOMPDIM";"S";"0292";"                     SI HJOU_IJIGHSUPPR = ""1"""
"IHCOMPDIM";"S";"0293";"** à compter du 01/01/2014 elles sont majorées de 10%"
"IHCOMPDIM";"S";"0294";"                        SI HJOU_DATE >= ""01012014"""
"IHCOMPDIM";"S";"0295";"                           HJOU_IJQHSNMAPA = HJOU_IJQHSNMAPA * LOCA_TAUXC"
"IHCOMPDIM";"S";"0296";"                        FINSI"
"IHCOMPDIM";"S";"0297";"                        HJOU_IJQHSNMARE = HJOU_IJQHSNMAPA"
"IHCOMPDIM";"S";"0298";"                        HJOU_IJQHSNMAPA = 0"
"IHCOMPDIM";"S";"0299";"* Ajout de la majoration taux 2 pour les heures à récupérer"
"IHCOMPDIM";"S";"0300";"                        HJOU_IJQHSNMAP2 = HJOU_IJQHSNMAP2 * LOCA_TAUXC2"
"IHCOMPDIM";"S";"0301";"* HJOU_XXXX3 = HC à récup. taux 2"
"IHCOMPDIM";"S";"0302";"                        HJOU_IJQHSNMAR2 = HJOU_IJQHSNMAP2"
"IHCOMPDIM";"S";"0303";"                        HJOU_IJQHSNMAP2 = 0"
"IHCOMPDIM";"S";"0304";"*"
"IHCOMPDIM";"S";"0305";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMARE"
"IHCOMPDIM";"S";"0306";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMAR2"
"IHCOMPDIM";"S";"0307";"                     FINSI"
"IHCOMPDIM";"S";"0308";"                  FINSI"
"IHCOMPDIM";"S";"0309";"*"
"IHCOMPDIM";"S";"0310";"                  SI HJOU_IJQHCNMAPA < 0"
"IHCOMPDIM";"S";"0311";"                     ANOMALIE 192"
"IHCOMPDIM";"S";"0312";"                  FINSI"
"IHCOMPDIM";"S";"0313";"               FINSI"
"IHCOMPDIM";"S";"0314";"            FINSI"
"IHCOMPDIM";"S";"0315";"         FINSI"
"IHCOMPDIM";"S";"0316";"*"
"IHCOMPDIM";"S";"0317";"         POUR ACTIVITES"
"IHCOMPDIM";"S";"0318";"            SI HABS_MOTIF = PARD_IDIVMOTHSR"
"IHCOMPDIM";"S";"0319";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HABS_MOTIDUR"
"IHCOMPDIM";"S";"0320";"               LOCA_CONSO = 1"
"IHCOMPDIM";"S";"0321";"            FINSI"
"IHCOMPDIM";"S";"0322";"            SI HABS_MOTIF = ""ZHCP"""
"IHCOMPDIM";"S";"0323";"               HJOU_IJQHCNMAPA = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0324";"            FINSI"
"IHCOMPDIM";"S";"0325";"* Taux 1"
"IHCOMPDIM";"S";"0326";"            SI HABS_MOTIF = ""XCOR"""
"IHCOMPDIM";"S";"0327";"            OU HABS_MOTIF = ""ZCOR"""
"IHCOMPDIM";"S";"0328";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_IJQHSNMARE"
"IHCOMPDIM";"S";"0329";"               SI HABS_MOTIF = ""XCOR"""
"IHCOMPDIM";"S";"0330";"                  HJOU_IJQHSNMARE = HJOU_IJQHSNMARE + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0331";"               FINSI"
"IHCOMPDIM";"S";"0332";"               SI HABS_MOTIF = ""ZCOR"""
"IHCOMPDIM";"S";"0333";"                  HJOU_IJQHSNMARE = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0334";"               FINSI"
"IHCOMPDIM";"S";"0335";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMARE"
"IHCOMPDIM";"S";"0336";"            FINSI"
"IHCOMPDIM";"S";"0337";"* Taux 2"
"IHCOMPDIM";"S";"0338";"            SI HABS_MOTIF = ""XCOR2"""
"IHCOMPDIM";"S";"0339";"            OU HABS_MOTIF = ""ZCOR2"""
"IHCOMPDIM";"S";"0340";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_IJQHSNMAR2"
"IHCOMPDIM";"S";"0341";"               SI HABS_MOTIF = ""XCOR2"""
"IHCOMPDIM";"S";"0342";"                  HJOU_IJQHSNMAR2 = HJOU_IJQHSNMAR2 + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0343";"               FINSI"
"IHCOMPDIM";"S";"0344";"               SI HABS_MOTIF = ""ZCOR2"""
"IHCOMPDIM";"S";"0345";"                  HJOU_IJQHSNMAR2 = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0346";"               FINSI"
"IHCOMPDIM";"S";"0347";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMAR2"
"IHCOMPDIM";"S";"0348";"            FINSI"
"IHCOMPDIM";"S";"0349";"         FINPOUR"
"IHCOMPDIM";"S";"0350";"*"
"IHCOMPDIM";"S";"0351";"         SI LOCA_CONSO = 1"
"IHCOMPDIM";"S";"0352";"            SI HJOU_IJRSHSMREH < 0"
"IHCOMPDIM";"S";"0353";"               ANOMALIE 226"
"IHCOMPDIM";"S";"0354";"               TEMP_CNRETOUR = 2"
"IHCOMPDIM";"S";"0355";"               TEMP_CNMESS = 226"
"IHCOMPDIM";"S";"0356";"            FINSI"
"IHCOMPDIM";"S";"0357";"         FINSI"
"IHCOMPDIM";"S";"0358";"      FINSI"
"IHCOMPDIM";"S";"0359";"**"
"IHCOMPDIM";"S";"0360";"** Soldes previsionnels"
"IHCOMPDIM";"S";"0361";"**"
"IHCOMPDIM";"S";"0362";"      SI CTRA_DATFIN > TEMP_DATJOU"
"IHCOMPDIM";"S";"0363";"         SI CTRA_DATFIN < LOCA_DATEFU"
"IHCOMPDIM";"S";"0364";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHCOMPDIM";"S";"0365";"            LOCA_DATEFU = TEMP_DXFINPER"
"IHCOMPDIM";"S";"0366";"         SINON"
"IHCOMPDIM";"S";"0367";"            SI CTRA_DATFIN < LOCA_DATEFU2"
"IHCOMPDIM";"S";"0368";"               DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHCOMPDIM";"S";"0369";"               LOCA_DATEFU2 = TEMP_DXFINPER"
"IHCOMPDIM";"S";"0370";"            FINSI"
"IHCOMPDIM";"S";"0371";"         FINSI"
"IHCOMPDIM";"S";"0372";"      FINSI"
"IHCOMPDIM";"S";"0373";"***"
"IHCOMPDIM";"S";"0374";"      SI TEMP_DATSUI = LOCA_DATEFU"
"IHCOMPDIM";"S";"0375";"         EMPL_IEQSHSMRE1 = HJOU_IJRSHSMREH"
"IHCOMPDIM";"S";"0376";"      FINSI"
"IHCOMPDIM";"S";"0377";"**"
"IHCOMPDIM";"S";"0378";"      SI TEMP_DATSUI = LOCA_DATEFU2"
"IHCOMPDIM";"S";"0379";"         EMPL_IEQSHSMRE2 = HJOU_IJRSHSMREH"
"IHCOMPDIM";"S";"0380";"      FINSI"
"IHCOMPDIM";"S";"0381";"   FINSI"
"IHCOMPDIM";"S";"0382";"FINSI"
"IHCOMPDIM";"S";"0383";"*"
"IHCOMPDIM";"S";"0384";"FIN"
"IHNUIT";"S";"0001";"***********************************************************************"
"IHNUIT";"S";"0002";"*"
"IHNUIT";"S";"0003";"* Règle : IHNUIT"
"IHNUIT";"S";"0004";"* Ordre : 6000"
"IHNUIT";"S";"0005";"* Titre : Calcul des heures de nuit"
"IHNUIT";"S";"0006";"*"
"IHNUIT";"S";"0007";"*----------------------------------------------------------------------"
"IHNUIT";"S";"0008";"*"
"IHNUIT";"S";"0009";"* Créé par : Cellule Industrialisation"
"IHNUIT";"S";"0010";"* Date     : 03/09/2009"
"IHNUIT";"S";"0011";"* Version  : 1"
"IHNUIT";"S";"0012";"*"
"IHNUIT";"S";"0013";"*----------------------------------------------------------------------"
"IHNUIT";"S";"0014";"*"
"IHNUIT";"S";"0015";"*"
"IHNUIT";"S";"0016";"* Rôle : Calcul des heures de nuit"
"IHNUIT";"S";"0017";"*"
"IHNUIT";"S";"0018";"*"
"IHNUIT";"S";"0019";"*"
"IHNUIT";"S";"0020";"*"
"IHNUIT";"S";"0021";"*"
"IHNUIT";"S";"0022";"*----------------------------------------------------------------------"
"IHNUIT";"S";"0023";"*"
"IHNUIT";"S";"0024";"* Modifiée par : Méthodes et outils"
"IHNUIT";"S";"0025";"* Date         : 08/04/2019"
"IHNUIT";"S";"0026";"* Objet        : Lorsque l'heure de début et de fin de nuit étaient"
"IHNUIT";"S";"0027";"*                renseignées dans le profil,"
"IHNUIT";"S";"0028";"*                le compteur ""Heures de nuit payées"" (HJOU_IJQHNUITTO)"
"IHNUIT";"S";"0029";"*                s'alimentait de la présence badgée validée (pour les"
"IHNUIT";"S";"0030";"*                non badgeants et dans le futur pour tous le monde)"
"IHNUIT";"S";"0031";"*"
"IHNUIT";"S";"0032";"***********************************************************************"
"IHNUIT";"S";"0033";"*"
"IHNUIT";"S";"0034";"* Implémentation des données industrielles"
"IHNUIT";"S";"0035";"*"
"IHNUIT";"S";"0036";"DEBDICO"
"IHNUIT";"S";"0037";"   HJOU_IJQHNUITTO;N;T6,2;I;;;     6789;;;V3;""Heures de nuit payées"";"
"IHNUIT";"S";"0038";"   TEMP_ITQNUITMOT;N;T6,2;I;;;      789;;;V3;""Heures de nuit maintenues par motif"";"
"IHNUIT";"S";"0039";"FINDICO"
"IHNUIT";"S";"0040";"*"
"IHNUIT";"S";"0041";"* Déclaration des donnees locales"
"IHNUIT";"S";"0042";"*"
"IHNUIT";"S";"0043";"DEF LOCA_INBADG Z1"
"IHNUIT";"S";"0044";"LOCA_INBADG = ""0"""
"IHNUIT";"S";"0045";"DEF LOCA_NUIT T6.2"
"IHNUIT";"S";"0046";"LOCA_NUIT = 0"
"IHNUIT";"S";"0047";"DEF LOCA_FINNUIT T6.2"
"IHNUIT";"S";"0048";"LOCA_FINNUIT = 0"
"IHNUIT";"S";"0049";"DEF LOCA_NUITM T6.2"
"IHNUIT";"S";"0050";"LOCA_NUITM = 0"
"IHNUIT";"S";"0051";"DEF LOCA_NUITT T6.2"
"IHNUIT";"S";"0052";"LOCA_NUITT = 0"
"IHNUIT";"S";"0053";"*"
"IHNUIT";"S";"0054";"SI HJOU_DATE <= TEMP_DATJOU"
"IHNUIT";"S";"0055";"   LOCA_INBADG = HJOU_IJIGBADGEA"
"IHNUIT";"S";"0056";"SINON"
"IHNUIT";"S";"0057";"   LOCA_INBADG = ""0"""
"IHNUIT";"S";"0058";"FINSI"
"IHNUIT";"S";"0059";"* pour les badgeants, jusqu'à la date du jour"
"IHNUIT";"S";"0060";"* les heures de nuit correspondent aux heures de nuit réelles"
"IHNUIT";"S";"0061";"HJOU_IJQHNUITTO = HJOU_IJQHNUITBA"
"IHNUIT";"S";"0062";"* pour les non badgeants et les badgeants si la date est dans le futur"
"IHNUIT";"S";"0063";"* les heures de nuit sont calculées d'apres les bornes de nuit définie"
"IHNUIT";"S";"0064";"* dans le profil horaire mais limitée à HJPOINV"
"IHNUIT";"S";"0065";"* SI LOCA_INBADG = ""0"""
"IHNUIT";"S";"0066";"* SI PROF_DEBNUIT > PROF_FINNUIT"
"IHNUIT";"S";"0067";"* LOCA_FINNUIT = PROF_FINNUIT + 24.00"
"IHNUIT";"S";"0068";"* LOCA_NUIT = LOCA_FINNUIT - PROF_DEBNUIT"
"IHNUIT";"S";"0069";"* SINON"
"IHNUIT";"S";"0070";"* LOCA_NUIT = PROF_FINNUIT - PROF_DEBNUIT"
"IHNUIT";"S";"0071";"* FINSI"
"IHNUIT";"S";"0072";"* SI LOCA_NUIT >= HJOU_IJQPRESBAV"
"IHNUIT";"S";"0073";"* LOCA_NUIT = HJOU_IJQPRESBAV"
"IHNUIT";"S";"0074";"* FINSI"
"IHNUIT";"S";"0075";"* HJOU_IJQHNUITTO = LOCA_NUIT"
"IHNUIT";"S";"0076";"* FINSI"
"IHNUIT";"S";"0077";"**"
"IHNUIT";"S";"0078";"** Ajout de la valeur des motifs qui maintiennent les heures de nuit"
"IHNUIT";"S";"0079";"**"
"IHNUIT";"S";"0080";"POUR ACTIVITES"
"IHNUIT";"S";"0081";"   SI MOTI_MOTYPE <> ""C"""
"IHNUIT";"S";"0082";"      SI MOTI_IMIGHNUITT = ""1"""
"IHNUIT";"S";"0083";"         SI PROF_IPIGHNUIMA > 0"
"IHNUIT";"S";"0084";"            SI HJOU_IJQHNUITTO <= PROF_IPIGHNUIMA"
"IHNUIT";"S";"0085";"               LOCA_NUITT = HJOU_IJQHNUITTO + HABS_MOTIDUR"
"IHNUIT";"S";"0086";"               SI LOCA_NUITT >= PROF_IPIGHNUIMA"
"IHREFF";"S";"0097";"FIN"
"IHNUIT";"S";"0087";"                  LOCA_NUITT = PROF_IPIGHNUIMA"
"IHNUIT";"S";"0088";"               FINSI"
"IHNUIT";"S";"0089";"               LOCA_NUITM = LOCA_NUITT - HJOU_IJQHNUITTO"
"IHNUIT";"S";"0090";"               TEMP_ITQNUITMOT = TEMP_ITQNUITMOT + LOCA_NUITM"
"IHNUIT";"S";"0091";"               HJOU_IJQHNUITTO = HJOU_IJQHNUITTO + LOCA_NUITM"
"IHNUIT";"S";"0092";"            FINSI"
"IHNUIT";"S";"0093";"         FINSI"
"IHNUIT";"S";"0094";"      FINSI"
"IHNUIT";"S";"0095";"   FINSI"
"IHNUIT";"S";"0096";"FINPOUR"
"IHNUIT";"S";"0097";"*"
"IHNUIT";"S";"0098";"*  analyse des consignes d'init et de MAJ"
"IHNUIT";"S";"0099";"*"
"IHNUIT";"S";"0100";"POUR ACTIVITES"
"IHNUIT";"S";"0101";"   SI HABS_MOTIF = ""XNUI"""
"IHNUIT";"S";"0102";"      HJOU_IJQHNUITTO = HJOU_IJQHNUITTO + HABS_MOTIDUR"
"IHNUIT";"S";"0103";"   FINSI"
"IHNUIT";"S";"0104";"   SI HABS_MOTIF = ""ZNUI"""
"IHNUIT";"S";"0105";"      HJOU_IJQHNUITTO = HABS_MOTIDUR"
"IHNUIT";"S";"0106";"   FINSI"
"IHNUIT";"S";"0107";"FINPOUR"
"IHNUIT";"S";"0108";"FIN"
"IHREFF";"S";"0001";"***********************************************************************"
"IHREFF";"S";"0002";"*"
"IHREFF";"S";"0003";"* Règle : IHREFF"
"IHREFF";"S";"0004";"* Ordre : 3320"
"IHREFF";"S";"0005";"* Titre : Heures effectives"
"IHREFF";"S";"0006";"*"
"IHREFF";"S";"0007";"*----------------------------------------------------------------------"
"IHREFF";"S";"0008";"*"
"IHREFF";"S";"0009";"* Créé par : Cellule Industrialisation"
"IHREFF";"S";"0010";"* Date     : 03/09/2009"
"IHREFF";"S";"0011";"* Version  : 1"
"IHREFF";"S";"0012";"*"
"IHREFF";"S";"0013";"*----------------------------------------------------------------------"
"IHREFF";"S";"0014";"*"
"IHREFF";"S";"0015";"*"
"IHREFF";"S";"0016";"* Rôle : Heures effectives"
"IHREFF";"S";"0017";"*"
"IHREFF";"S";"0018";"*"
"IHREFF";"S";"0019";"*"
"IHREFF";"S";"0020";"*"
"IHREFF";"S";"0021";"*"
"IHREFF";"S";"0022";"*----------------------------------------------------------------------"
"IHREFF";"S";"0023";"*"
"IHREFF";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IHREFF";"S";"0025";"* Date         : JJ/MM/AAAA"
"IHREFF";"S";"0026";"* Objet        :"
"IHREFF";"S";"0027";"*"
"IHREFF";"S";"0028";"***********************************************************************"
"IHREFF";"S";"0029";"*"
"IHREFF";"S";"0030";"* Implémentation des données industrielles"
"IHREFF";"S";"0031";"*"
"IHREFF";"S";"0032";"DEBDICO"
"IHREFF";"S";"0033";"   HJOU_IJQTTEFFEJ;N;T6,2;I;;;     6789;;;V3;""Heures effectives"";"
"IHREFF";"S";"0034";"FINDICO"
"IHREFF";"S";"0035";"*"
"IHREFF";"S";"0036";"* Déclaration des donnees locales"
"IHREFF";"S";"0037";"*"
"IHREFF";"S";"0038";"DEF LOCA_INBADG Z1"
"IHREFF";"S";"0039";"LOCA_INBADG = ""0"""
"IHREFF";"S";"0040";"DEF LOCA_VAL T6.2"
"IHREFF";"S";"0041";"LOCA_VAL = 0"
"IHREFF";"S";"0042";"* si on est dans le futur"
"IHREFF";"S";"0043";"* on positionne la variable INBADG à 0"
"IHREFF";"S";"0044";"* ce qui permet de traiter les badgeants comme des non badgeants"
"IHREFF";"S";"0045";"* afin d'alimenter une présence badgéé fictive (HJPOINV)qui correspond"
"IHREFF";"S";"0046";"* à la théorie - les motifs d'absences non créditeur"
"IHREFF";"S";"0047";"SI HJOU_DATE <= TEMP_DATJOU"
"IHREFF";"S";"0048";"   LOCA_INBADG = HJOU_IJIGBADGEA"
"IHREFF";"S";"0049";"SINON"
"IHREFF";"S";"0050";"   LOCA_INBADG = ""0"""
"IHREFF";"S";"0051";"FINSI"
"IHREFF";"S";"0052";"*HJOU_IJQTTEFFEJ = HJOU_IJQPRESBAV"
"IHREFF";"S";"0053";"HJOU_IJQTTEFFEJ = HJOU_IJQPRESEFF"
"IHREFF";"S";"0054";"POUR ACTIVITES"
"IHREFF";"S";"0055";"   SI MOTI_MOTYPE <> ""C"""
"IHREFF";"S";"0056";"      SI MOTI_IMIGTTEFFE = ""1"""
"IHREFF";"S";"0057";"         HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ + HABS_MOTIDUR"
"IHREFF";"S";"0058";"      FINSI"
"IHREFF";"S";"0059";"      SI MOTI_IMIGTTEFFE = ""2"""
"IHREFF";"S";"0060";"         SI LOCA_INBADG <> ""0"""
"IHREFF";"S";"0061";"            HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ - HABS_MOTIDUR"
"IHREFF";"S";"0062";"         FINSI"
"IHREFF";"S";"0063";"      FINSI"
"IHREFF";"S";"0064";"      SI MOTI_IMIGTTEFFE = ""3"""
"IHREFF";"S";"0065";"         SI HABS_VALORIS = ""J"""
"IHREFF";"S";"0066";"            LOCA_VAL = PROF_IPIABSFORJ"
"IHREFF";"S";"0067";"         FINSI"
"IHREFF";"S";"0068";"         SI HABS_VALORIS = ""M"""
"IHREFF";"S";"0069";"            LOCA_VAL = PROF_IPIABSFORM"
"IHREFF";"S";"0070";"         FINSI"
"IHREFF";"S";"0071";"         SI HABS_VALORIS = ""A"""
"IHREFF";"S";"0072";"            LOCA_VAL = PROF_IPIABSFORS"
"IHREFF";"S";"0073";"         FINSI"
"IHREFF";"S";"0074";"         SI HABS_VALORIS = ""H"""
"IHREFF";"S";"0075";"            LOCA_VAL = HABS_MOTIDUR"
"IHREFF";"S";"0076";"         FINSI"
"IHREFF";"S";"0077";"         HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ + LOCA_VAL"
"IHREFF";"S";"0078";"      FINSI"
"IHREFF";"S";"0079";"   FINSI"
"IHREFF";"S";"0080";"FINPOUR"
"IHREFF";"S";"0081";"*** ecretage des heures effectives"
"IHREFF";"S";"0082";"SI HJOU_IJQTTEFFEJ > PROF_ECRJOU"
"IHREFF";"S";"0083";"   HJOU_IJQTTEFFEJ = PROF_ECRJOU"
"IHREFF";"S";"0084";"FINSI"
"IHREFF";"S";"0085";"*  alimentation par consignes"
"IHREFF";"S";"0086";"POUR ACTIVITES"
"IHREFF";"S";"0087";"   SI HABS_MOTIF = ""XEFF"""
"IHREFF";"S";"0088";"      HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ + HABS_MOTIDUR"
"IHREFF";"S";"0089";"   FINSI"
"IHREFF";"S";"0090";"   SI HABS_MOTIF = ""ZEFF"""
"IHREFF";"S";"0091";"      HJOU_IJQTTEFFEJ = HABS_MOTIDUR"
"IHREFF";"S";"0092";"   FINSI"
"IHREFF";"S";"0093";"FINPOUR"
"IHREFF";"S";"0094";"SI HJOU_IJQTTEFFEJ < 0"
"IHREFF";"S";"0095";"   HJOU_IJQTTEFFEJ = 0"
"IHSAME";"S";"0001";"***********************************************************************"
"IHSAME";"S";"0002";"*"
"IHSAME";"S";"0003";"* Règle : IHSAME"
"IHSAME";"S";"0004";"* Ordre : 6030"
"IHSAME";"S";"0005";"* Titre : Calcul des heures de  samedi"
"IHSAME";"S";"0006";"*"
"IHSAME";"S";"0007";"*----------------------------------------------------------------------"
"IHSAME";"S";"0008";"*"
"IHSAME";"S";"0009";"* Créé par : Cellule Industrialisation"
"IHSAME";"S";"0010";"* Date     : 03/09/2009"
"IHSAME";"S";"0011";"* Version  : 1"
"IHSAME";"S";"0012";"*"
"IHSAME";"S";"0013";"*---------------------------------------------------------------------"
"IHSAME";"S";"0014";"*"
"IHSAME";"S";"0015";"* Rôle : Calcul  des heures de samedi"
"IHSAME";"S";"0016";"*        Elles sont alimentées par les heures badgées de la journée en"
"IHSAME";"S";"0017";"*        cours et les heures de la veille faites apres minuit"
"IHSAME";"S";"0018";"*"
"IHSAME";"S";"0019";"*"
"IHSAME";"S";"0020";"*"
"IHSAME";"S";"0021";"*"
"IHSAME";"S";"0022";"*----------------------------------------------------------------------"
"IHSAME";"S";"0023";"*"
"IHSAME";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IHSAME";"S";"0025";"* Date         : JJ/MM/AAAA"
"IHSAME";"S";"0026";"* Objet        :"
"IHSAME";"S";"0027";"*"
"IHSAME";"S";"0028";"***********************************************************************"
"IHSAME";"S";"0029";"*"
"IHSAME";"S";"0030";"* Implémentation des données industrielles"
"IHSAME";"S";"0031";"*"
"IHSAME";"S";"0032";"DEBDICO"
"IHSAME";"S";"0033";"   HJOU_IJQHSAMTRA;N;T6,2;I;;;    56789;;;V3;""Heures de samedi"";"
"IHSAME";"S";"0034";"FINDICO"
"IHSAME";"S";"0035";"*"
"IHSAME";"S";"0036";"* Déclaration des donnees locales"
"IHSAME";"S";"0037";"*"
"IHSAME";"S";"0038";"*"
"IHSAME";"S";"0039";"* Stockage du total des heures dimanches pour"
"IHSAME";"S";"0040";"* contrôle par rapport à l'écrêtage de la presence"
"IHSAME";"S";"0041";"DEF LOCA_SAM T6.2"
"IHSAME";"S";"0042";"LOCA_SAM = 0"
"IHSAME";"S";"0043";"*"
"IHSAME";"S";"0044";"SI HJOU_DATE <= TEMP_DATJOU"
"IHSAME";"S";"0045";"   SI HJOU_JOUR = ""6"""
"IHSAME";"S";"0046";"      SI HJOU_IJIGBADGEA = ""1"""
"IHSAME";"S";"0047";"         LOCA_SAM = HJOU_IJQPREJENC"
"IHSAME";"S";"0048";"         LOCA_SAM = LOCA_SAM + HJOU_IJRPREVEIL"
"IHSAME";"S";"0049";"         LOCA_SAM = LOCA_SAM - HJOU_IJQECPAUMI"
"IHSAME";"S";"0050";"         SI LOCA_SAM > PROF_ECRJOU"
"IHSAME";"S";"0051";"            LOCA_SAM = PROF_ECRJOU"
"IHSAME";"S";"0052";"         FINSI"
"IHSAME";"S";"0053";"      SINON"
"IHSAME";"S";"0054";"         LOCA_SAM = HJOU_IJQPRESBAV"
"IHSAME";"S";"0055";"      FINSI"
"IHSAME";"S";"0056";"   FINSI"
"IHSAME";"S";"0057";"   HJOU_IJQHSAMTRA = LOCA_SAM"
"IHSAME";"S";"0058";"** Mise a jour par consigne"
"IHSAME";"S";"0059";"   POUR ACTIVITES"
"IHSAME";"S";"0060";"      SI HABS_MOTIF = ""ZSAM"""
"IHSAME";"S";"0061";"         HJOU_IJQHSAMTRA = HABS_MOTIDUR"
"IHSAME";"S";"0062";"      FINSI"
"IHSAME";"S";"0063";"      SI HABS_MOTIF = ""XSAM"""
"IHSAME";"S";"0064";"         HJOU_IJQHSAMTRA = HJOU_IJQHSAMTRA + HABS_MOTIDUR"
"IHSAME";"S";"0065";"      FINSI"
"IHSAME";"S";"0066";"   FINPOUR"
"IHSAME";"S";"0067";"FINSI"
"IHSAME";"S";"0068";"FIN"
"IHSUPP";"S";"0001";"************************************************************************"
"IHSUPP";"S";"0002";"*"
"IHSUPP";"S";"0003";"* Règle : IHSUPP"
"IHSUPP";"S";"0004";"* Ordre : 6050"
"IHSUPP";"S";"0005";"* Titre : Calcul des heures supplémentaires"
"IHSUPP";"S";"0006";"*"
"IHSUPP";"S";"0007";"*----------------------------------------------------------------------"
"IHSUPP";"S";"0008";"*"
"IHSUPP";"S";"0009";"* Créé par : Cellule Industrialisation"
"IHSUPP";"S";"0010";"* Date     : 03/09/2009"
"IHSUPP";"S";"0011";"* Version  : 1"
"IHSUPP";"S";"0012";"*"
"IHSUPP";"S";"0013";"*----------------------------------------------------------------------"
"IHSUPP";"S";"0014";"*"
"IHSUPP";"S";"0015";"*"
"IHSUPP";"S";"0016";"* Rôle : Calcul des heures supplémentaires du lundi au dimanche travaillé"
"IHSUPP";"S";"0017";"*         (si dimanche travaillé de nuit, la totalité du travail de nuit"
"IHSUPP";"S";"0018";"*          est sur le dimanche)"
"IHSUPP";"S";"0019";"*         (gestion uniquement pour les temps plein)"
"IHSUPP";"S";"0020";"*"
"IHSUPP";"S";"0021";"*"
"IHSUPP";"S";"0022";"*         Adaptation de la règle IHSUPP avec ajout suivant :"
"IHSUPP";"S";"0023";"*"
"IHSUPP";"S";"0024";"*         Séparation en deux des règles IHSUPP et IHSUPPDIM afin de"
"IHSUPP";"S";"0025";"*         différencier les HS et les HC"
"IHSUPP";"S";"0026";"*"
"IHSUPP";"S";"0027";"*----------------------------------------------------------------------"
"IHSUPP";"S";"0028";"*"
"IHSUPP";"S";"0029";"* Modifiée par : Méthodes et outils"
"IHSUPP";"S";"0030";"* Date         : 15/10/2019"
"IHSUPP";"S";"0031";"* Objet        : Ajout d'une gestion paiement HS 50% en cours de période"
"IHSUPP";"S";"0032";"*"
"IHSUPP";"S";"0033";"*                 Pour les employés en régime HS à 3 (Calcul HS dimanche et"
"IHSUPP";"S";"0034";"*                 annuelles), si le seuil HORC_IHISEUILHS est renseigné"
"IHSUPP";"S";"0035";"*                 alors celui-ci remplacera le seuil HS taux 2 de PARD"
"IHSUPP";"S";"0036";"*                 (PARD_IDISHSMTX2). Il faut également renseigner la date"
"IHSUPP";"S";"0037";"*                 d'effet (PARD_IDIDATPEHS), c'est à partir de celle-ci que"
"IHSUPP";"S";"0038";"*                 le calcul des HS sera effectif."
"IHSUPP";"S";"0039";"*                 Les HS calculées au delà du seuil seront les heures payées"
"IHSUPP";"S";"0040";"*                 en cours de période et seront soustraite aux heures"
"IHSUPP";"S";"0041";"*                 effectives annuelles (HJOU_IJRTTEPMOD)"
"IHSUPP";"S";"0042";"*"
"IHSUPP";"S";"0043";"***********************************************************************"
"IHSUPP";"S";"0044";"*"
"IHSUPP";"S";"0045";"* Modifiée par : Méthodes et outils"
"IHSUPP";"S";"0046";"* Date         : 30/06/2020"
"IHSUPP";"S";"0047";"* Objet        : Le test de CTRA_ICITAUX est remplacé par HJOU_IJITYPCTRA"
"IHSUPP";"S";"0048";"*                 car le taux du contrat est désormais copié dans JOU"
"IHSUPP";"S";"0049";"*"
"IHSUPP";"S";"0050";"***********************************************************************"
"IHSUPP";"S";"0051";"*"
"IHSUPP";"S";"0052";"* Implémentation des données industrielles"
"IHSUPP";"S";"0053";"*"
"IHSUPP";"S";"0054";"DEBDICO"
"IHSUPP";"S";"0055";"   HJOU_IJIGHSUPPM;O;Z1;X;;;123456789;L;;C2;""Régime HS"";"
"IHSUPP";"S";"0056";"   HJOU_IJRBHSMPAH;N;T6,2;I;;;    56789;;IJRBHSMPAH;V3;""Base HS"";"
"IHSUPP";"S";"0057";"   HJOU_IJRHSHMAJA;N;T8,2;L;;;    56789;;IJRHSHMAJA;V3;""Cumul annuel HS payées"";"
"IHSUPP";"S";"0058";"   HJOU_IJRHSMPAYA;N;T8,2;L;;;    56789;;IJRHSMPAYA;V3;""Cumul annuel HS"";"
"IHSUPP";"S";"0059";"   HJOU_IJRHRECANN;N;T8,2;L;;;    56789;;IJRHRECANN;V3;""Cumul annuel HS à récupérer"";"
"IHSUPP";"S";"0060";"   HJOU_IJQHS1MAPA;N;T6,2;I;;;    56789;;;V3;""Heures sup taux 1"";"
"IHSUPP";"S";"0061";"   HJOU_IJQHS2MAPA;N;T6,2;I;;;    56789;;;V3;""Heures sup taux 2"";"
"IHSUPP";"S";"0062";"   HJOU_IJQHPAYEES;N;T6,2;I;;;    56789;;;V3;""Heures payées"";"
"IHSUPP";"S";"0063";"   HJOU_IJRBHPAYEE;N;T6,2;I;;;    56789;;IJRBHPAYEE;V3;""Base des heures payées"";"
"IHSUPP";"S";"0064";"   HJOU_IJQHS1MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 1 à récup."";"
"IHSUPP";"S";"0065";"   HJOU_IJQHS2MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 2 à récup."";"
"IHSUPP";"S";"0066";"   HJOU_IJRSHSMREH;N;T8,2;L;;;     6789;;IJRSHSMREH;V3;""Récupération HS/HC"";"
"IHSUPP";"S";"0067";"   HJOU_IJRTHEOCYC;N;T6,2;I;;;    56789;;IJRTHEOCYC;V3;""Theorie du cycle"";"
"IHSUPP";"S";"0068";"   HJOU_IJQHRNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures payées non majorées"";"
"IHSUPP";"S";"0069";"   MOTI_IMIGHRPAYE;O;Z1;X;0;1;123456789;C;;C2;""Participe aux heures payées"";"
"IHSUPP";"S";"0070";"   EMPL_IEQSHSMRE1;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 1 HS à recup."";"
"IHSUPP";"S";"0071";"   EMPL_IEQSHSMRE2;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 2 HS à recup."";"
"IHSUPP";"S";"0072";"   PARD_IDIHSTAUX1;O;N2;I;;;123456789;;;C3;""HS taux 1 (%)"";"
"IHSUPP";"S";"0073";"   PARD_IDIHSTAUX2;O;N2;I;;;123456789;;;C3;""HS taux 2 (%)"";"
"IHSUPP";"S";"0074";"   HORC_IHISEUILHS;O;T6,2;I;;;123456789;;;C3;""Seuil paiement des HS"";"
"IHSUPP";"S";"0075";"   PARD_IDIDATPEHS;O;D10;X;;;123456789;;;C3;""Début période HS payées avant fin cycle"";"
"IHSUPP";"S";"0076";"FINDICO"
"IHSUPP";"S";"0077";"DEBANO"
"IHSUPP";"S";"0078";"   192;9;""Heures non majorées payées négatives"";"
"IHSUPP";"S";"0079";"   226;9;""Solde récup HS/HC insuffisant"";"
"IHSUPP";"S";"0080";"FINANO"
"IHSUPP";"S";"0081";"*"
"IHSUPP";"S";"0082";"* Déclaration des donnees locales"
"IHSUPP";"S";"0083";"*"
"IHSUPP";"S";"0084";"DEF LOCA_SHS25 T6.2"
"IHSUPP";"S";"0085";"LOCA_SHS25 = 0"
"IHSUPP";"S";"0086";"DEF LOCA_SHS50 T6.2"
"IHSUPP";"S";"0087";"LOCA_SHS50 = 0"
"IHSUPP";"S";"0088";"DEF LOCA_NBCYCLE N2"
"IHSUPP";"S";"0089";"LOCA_NBCYCLE = 0"
"IHSUPP";"S";"0090";"DEF LOCA_CAL N1"
"IHSUPP";"S";"0091";"LOCA_CAL = 0"
"IHSUPP";"S";"0092";"DEF LOCA_HS25R T6.2"
"IHSUPP";"S";"0093";"LOCA_HS25R = 0"
"IHSUPP";"S";"0094";"DEF LOCA_HS50R T6.2"
"IHSUPP";"S";"0095";"LOCA_HS50R = 0"
"IHSUPP";"S";"0096";"DEF LOCA_DATE D"
"IHSUPP";"S";"0097";"LOCA_DATE = "" """
"IHSUPP";"S";"0098";"DEF LOCA_ACOURS N4"
"IHSUPP";"S";"0099";"LOCA_ACOURS = 0"
"IHSUPP";"S";"0100";"DEF LOCA_ACOURS2 N4"
"IHSUPP";"S";"0101";"LOCA_ACOURS2 = 0"
"IHSUPP";"S";"0102";"DEF LOCA_DATEFU D"
"IHSUPP";"S";"0103";"LOCA_DATEFU = "" """
"IHSUPP";"S";"0104";"DEF LOCA_DATEFU2 D"
"IHSUPP";"S";"0105";"LOCA_DATEFU2 = "" """
"IHSUPP";"S";"0106";"DEF LOCA_TAUX1 N4.2"
"IHSUPP";"S";"0107";"LOCA_TAUX1 = 0"
"IHSUPP";"S";"0108";"DEF LOCA_TAUX2 N4.2"
"IHSUPP";"S";"0109";"LOCA_TAUX2 = 0"
"IHSUPP";"S";"0110";"LOCA_TAUX1 = PARD_IDIHSTAUX1 / 100"
"IHSUPP";"S";"0111";"LOCA_TAUX1 = LOCA_TAUX1 + 1"
"IHSUPP";"S";"0112";"LOCA_TAUX2 = PARD_IDIHSTAUX2 / 100"
"IHSUPP";"S";"0113";"LOCA_TAUX2 = LOCA_TAUX2 + 1"
"IHSUPP";"S";"0114";"DEF LOCA_CONS N1"
"IHSUPP";"S";"0115";"LOCA_CONS = 0"
"IHSUPP";"S";"0116";"DEF LOCA_CONSO N1"
"IHSUPP";"S";"0117";"LOCA_CONSO = 0"
"IHSUPP";"S";"0118";"*"
"IHSUPP";"S";"0119";"*Si HJOU_IJITYPCTRA n'est pas renseigné alors il est considéré comme un temps plein"
"IHSUPP";"S";"0120";"SI HJOU_IJITYPCTRA = 0"
"IHSUPP";"S";"0121";"OU HJOU_IJITYPCTRA = 100"
"IHSUPP";"S";"0122";"*"
"IHSUPP";"S";"0123";"* Alimentation des données locales pour calcul soldes prévisionnels"
"IHSUPP";"S";"0124";"*"
"IHSUPP";"S";"0125";"   SI PARD_IDIDDEBANN <> "" """
"IHSUPP";"S";"0126";"      LOCA_DATE(5:4) = PARD_IDIDDEBANN(5:4)"
"IHSUPP";"S";"0127";"   SINON"
"IHSUPP";"S";"0128";"      LOCA_DATE(5:4) = ""0101"""
"IHSUPP";"S";"0129";"   FINSI"
"IHSUPP";"S";"0130";"**"
"IHSUPP";"S";"0131";"   LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IHSUPP";"S";"0132";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHSUPP";"S";"0133";"*"
"IHSUPP";"S";"0134";"   SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IHSUPP";"S";"0135";"      LOCA_ACOURS = LOCA_ACOURS + 1"
"IHSUPP";"S";"0136";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHSUPP";"S";"0137";"   FINSI"
"IHSUPP";"S";"0138";"*"
"IHSUPP";"S";"0139";"   LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IHSUPP";"S";"0140";"   LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IHSUPP";"S";"0141";"   LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IHSUPP";"S";"0142";"   LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IHSUPP";"S";"0143";"*"
"IHSUPP";"S";"0144";"* INRH = 1 calcul des HS chaque dimanche"
"IHSUPP";"S";"0145";"* INRH = 2 calcul des HS le dernier dimanche du cycle"
"IHSUPP";"S";"0146";"* INRH = 3 calcul des HS chaque dimanche et en fin d'annualisation"
"IHSUPP";"S";"0147";"* Raz de la base HS le lundi"
"IHSUPP";"S";"0148";"   SI HJOU_JOUR = ""1"""
"IHSUPP";"S";"0149";"* raz chaque lundi <> 2 (0/1/3)"
"IHSUPP";"S";"0150";"      SI HJOU_IJIGHSUPPM <> ""2"""
"IHSUPP";"S";"0151";"         HJOU_IJRBHSMPAH = 0"
"IHSUPP";"S";"0152";"         HJOU_IJRBHPAYEE = 0"
"IHSUPP";"S";"0153";"      FINSI"
"IHSUPP";"S";"0154";"* raz le premier lundi du cycle si INRH = 2"
"IHSUPP";"S";"0155";"      SI HJOU_IJIGHSUPPM = ""2"""
"IHSUPP";"S";"0156";"* stokage de la duree theorique du code horaire"
"IHSUPP";"S";"0157";"         SI HJOU_RANG = 1"
"IHSUPP";"S";"0158";"            HJOU_IJRBHSMPAH = 0"
"IHSUPP";"S";"0159";"* raz de la duree theorique du cycle"
"IHSUPP";"S";"0160";"            HJOU_IJRTHEOCYC = 0"
"IHSUPP";"S";"0161";"            HJOU_IJRBHPAYEE = 0"
"IHSUPP";"S";"0162";"         FINSI"
"IHSUPP";"S";"0163";"* cumul de la duree theorique du cycle"
"IHSUPP";"S";"0164";"         HJOU_IJRTHEOCYC = HJOU_IJRTHEOCYC + HJOU_HORHEB"
"IHSUPP";"S";"0165";"      FINSI"
"IHSUPP";"S";"0166";"   FINSI"
"IHSUPP";"S";"0167";"   SI HJOU_IJIGHSUPPM <> ""0"""
"IHSUPP";"S";"0168";"* on calcul également la base HS dans le cas ou on"
"IHSUPP";"S";"0169";"* calcul un acquis RTT hebdo"
"IHSUPP";"S";"0170";"   OU HJOU_IJIGRETETR = ""3"""
"IHSUPP";"S";"0171";"      HJOU_IJQHPAYEES = HJOU_IJQPRESBAV"
"IHSUPP";"S";"0172";"      POUR ACTIVITES"
"IHSUPP";"S";"0173";"         SI MOTI_MOTYPE <> ""C"""
"IHSUPP";"S";"0174";"            SI MOTI_IMIGHRSSUP = ""1"""
"IHSUPP";"S";"0175";"            OU MOTI_IMIGHRPAYE = ""1"""
"IHSUPP";"S";"0176";"               HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHSUPP";"S";"0177";"            FINSI"
"IHSUPP";"S";"0178";"         FINSI"
"IHSUPP";"S";"0179";"** alimentation par consignes"
"IHSUPP";"S";"0180";"         SI HABS_MOTIF = ""ZHPA"""
"IHSUPP";"S";"0181";"            HJOU_IJQHPAYEES = HABS_MOTIDUR"
"IHSUPP";"S";"0182";"         FINSI"
"IHSUPP";"S";"0183";"*"
"IHSUPP";"S";"0184";"         SI HABS_MOTIF = ""XHPA"""
"IHSUPP";"S";"0185";"            HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHSUPP";"S";"0186";"         FINSI"
"IHSUPP";"S";"0187";"      FINPOUR"
"IHSUPP";"S";"0188";"** alimentation des bases hebdo"
"IHSUPP";"S";"0189";"      HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HJOU_IJQPRESBAV"
"IHSUPP";"S";"0190";"*"
"IHSUPP";"S";"0191";"      HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE + HJOU_IJQHPAYEES"
"IHSUPP";"S";"0192";"      POUR ACTIVITES"
"IHSUPP";"S";"0193";"         SI MOTI_MOTYPE <> ""C"""
"IHSUPP";"S";"0194";"            SI MOTI_IMIGHRSSUP = ""1"""
"IHSUPP";"S";"0195";"               HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HABS_MOTIDUR"
"IHSUPP";"S";"0196";"            FINSI"
"IHSUPP";"S";"0197";"         FINSI"
"IHSUPP";"S";"0198";"      FINPOUR"
"IHSUPP";"S";"0199";"   FINSI"
"IHSUPP";"S";"0200";"* raz du cumul des HS en debut de periode d'annualisation"
"IHSUPP";"S";"0201";"   SI PARD_IDIDDEBANN <> "" """
"IHSUPP";"S";"0202";"      SI HJOU_DATE = PARD_IDIDDEBANN"
"IHSUPP";"S";"0203";"         HJOU_IJRHSHMAJA = 0"
"IHSUPP";"S";"0204";"         HJOU_IJRHSMPAYA = 0"
"IHSUPP";"S";"0205";"         HJOU_IJRHRECANN = 0"
"IHSUPP";"S";"0206";"      FINSI"
"IHSUPP";"S";"0207";"   SINON"
"IHSUPP";"S";"0208";"      SI HJOU_DATE(5:4) = ""0101"""
"IHSUPP";"S";"0209";"         HJOU_IJRHSHMAJA = 0"
"IHSUPP";"S";"0210";"         HJOU_IJRHSMPAYA = 0"
"IHSUPP";"S";"0211";"         HJOU_IJRHRECANN = 0"
"IHSUPP";"S";"0212";"      FINSI"
"IHSUPP";"S";"0213";"   FINSI"
"IHSUPP";"S";"0214";"*** initialisation de la base HS par consigne"
"IHSUPP";"S";"0215";"   POUR ACTIVITES"
"IHSUPP";"S";"0216";"      SI HABS_MOTIF = ""ZBHS"""
"IHSUPP";"S";"0217";"         HJOU_IJRBHSMPAH = HABS_MOTIDUR"
"IHSUPP";"S";"0218";"      FINSI"
"IHSUPP";"S";"0219";"      SI HABS_MOTIF = ""ZBPA"""
"IHSUPP";"S";"0220";"         HJOU_IJRBHPAYEE = HABS_MOTIDUR"
"IHSUPP";"S";"0221";"      FINSI"
"IHSUPP";"S";"0222";"   FINPOUR"
"IHSUPP";"S";"0223";"   SI HJOU_IJIGHSUPPM <> ""0"""
"IHSUPP";"S";"0224";"* calcul des HS"
"IHSUPP";"S";"0225";"      SI HJOU_JOUR = ""7"""
"IHSUPP";"S";"0226";"         SI HJOU_IJIGHSUPPM = ""1"""
"IHSUPP";"S";"0227";"         OU HJOU_IJIGHSUPPM = ""3"""
"IHSUPP";"S";"0228";"            LOCA_SHS25 = PARD_IDISHSMTX1"
"IHSUPP";"S";"0229";"* Gestion HS avec seuil dans PARD"
"IHSUPP";"S";"0230";"            LOCA_SHS50 = PARD_IDISHSMTX2"
"IHSUPP";"S";"0231";"*"
"IHSUPP";"S";"0232";"* Gestion paiement des HS en cours de période"
"IHSUPP";"S";"0233";"* (seuil HS taux 2 dans HOR)"
"IHSUPP";"S";"0234";"            SI HORC_IHISEUILHS > 0"
"IHSUPP";"S";"0235";"               SI HJOU_IJIGHSUPPM = ""3"""
"IHSUPP";"S";"0236";"*Date dans PARD"
"IHSUPP";"S";"0237";"                  SI PARD_IDIDATPEHS <> "" """
"IHSUPP";"S";"0238";"                     SI HJOU_DATE >= PARD_IDIDATPEHS"
"IHSUPP";"S";"0239";"                        LOCA_SHS50 = HORC_IHISEUILHS"
"IHSUPP";"S";"0240";"                     FINSI"
"IHSUPP";"S";"0241";"                  FINSI"
"IHSUPP";"S";"0242";"               FINSI"
"IHSUPP";"S";"0243";"            FINSI"
"IHSUPP";"S";"0244";"            LOCA_CAL = 1"
"IHSUPP";"S";"0245";"         FINSI"
"IHSUPP";"S";"0246";"         SI HJOU_IJIGHSUPPM = ""2"""
"IHSUPP";"S";"0247";"* dans le cas ou les HS se calculent en fin de cycle"
"IHSUPP";"S";"0248";"* loca_nbcycle correspond au nombre de semaines"
"IHSUPP";"S";"0249";"            LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"IHSUPP";"S";"0250";"            SI HJOU_RANG = LOCA_NBCYCLE"
"IHSUPP";"S";"0251";"               LOCA_SHS25 = PARD_IDISHSMTX1 * LOCA_NBCYCLE"
"IHSUPP";"S";"0252";"               LOCA_SHS50 = PARD_IDISHSMTX2 * LOCA_NBCYCLE"
"IHSUPP";"S";"0253";"               LOCA_CAL = 1"
"IHSUPP";"S";"0254";"            FINSI"
"IHSUPP";"S";"0255";"         FINSI"
"IHSUPP";"S";"0256";"*  Calcul des heures suppl?mentaires ? 25% et 50%"
"IHSUPP";"S";"0257";"         SI LOCA_CAL = 1"
"IHSUPP";"S";"0258";"            SI HJOU_IJRBHSMPAH >= LOCA_SHS50"
"IHSUPP";"S";"0259";"               HJOU_IJQHS1MAPA = LOCA_SHS50 - LOCA_SHS25"
"IHSUPP";"S";"0260";"               HJOU_IJQHS2MAPA = HJOU_IJRBHSMPAH - LOCA_SHS50"
"IHSUPP";"S";"0261";"* Si gestion paiement des HS en cours de période"
"IHSUPP";"S";"0262";"               SI LOCA_SHS50 = HORC_IHISEUILHS"
"IHSUPP";"S";"0263";"                  LOCA_CONS = 1"
"IHSUPP";"S";"0264";"                  HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD - HJOU_IJQHS2MAPA"
"IHSUPP";"S";"0265";"               FINSI"
"IHSUPP";"S";"0266";"            SINON"
"IHSUPP";"S";"0267";"               SI HJOU_IJRBHSMPAH > LOCA_SHS25"
"IHSUPP";"S";"0268";"                  HJOU_IJQHS1MAPA = HJOU_IJRBHSMPAH - LOCA_SHS25"
"IHSUPP";"S";"0269";"               FINSI"
"IHSUPP";"S";"0270";"            FINSI"
"IHSUPP";"S";"0271";"*"
"IHSUPP";"S";"0272";"            SI HJOU_IJRBHPAYEE > LOCA_SHS25"
"IHSUPP";"S";"0273";"               HJOU_IJQHRNMAPA = HJOU_IJRBHPAYEE - LOCA_SHS25"
"IHSUPP";"S";"0274";"            FINSI"
"IHSUPP";"S";"0275";"*"
"IHSUPP";"S";"0276";"            POUR ACTIVITES"
"IHSUPP";"S";"0277";"*  analyse de la consigne d'initialisation des hs25"
"IHSUPP";"S";"0278";"               SI HABS_MOTIF = ""Z25P"""
"IHSUPP";"S";"0279";"                  HJOU_IJQHS1MAPA = HABS_MOTIDUR"
"IHSUPP";"S";"0280";"               FINSI"
"IHSUPP";"S";"0281";"*  analyse de la consigne d'initialisation des hs50"
"IHSUPP";"S";"0282";"               SI HABS_MOTIF = ""Z50P"""
"IHSUPP";"S";"0283";"                  SI LOCA_CONS = 1"
"IHSUPP";"S";"0284";"                     HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD + HJOU_IJQHS2MAPA"
"IHSUPP";"S";"0285";"                     HJOU_IJQHS2MAPA = HABS_MOTIDUR"
"IHSUPP";"S";"0286";"                     HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD - HJOU_IJQHS2MAPA"
"IHSUPP";"S";"0287";"                  SINON"
"IHSUPP";"S";"0288";"                     HJOU_IJQHS2MAPA = HABS_MOTIDUR"
"IHSUPP";"S";"0289";"                  FINSI"
"IHSUPP";"S";"0290";"               FINSI"
"IHSUPP";"S";"0291";"            FINPOUR"
"IHSUPP";"S";"0292";"*"
"IHSUPP";"S";"0293";"            HJOU_IJQHRNMAPA = HJOU_IJQHRNMAPA - HJOU_IJQHS1MAPA"
"IHSUPP";"S";"0294";"            HJOU_IJQHRNMAPA = HJOU_IJQHRNMAPA - HJOU_IJQHS2MAPA"
"IHSUPP";"S";"0295";"            SI HJOU_IJQHRNMAPA < 0"
"IHSUPP";"S";"0296";"               ANOMALIE 192"
"IHSUPP";"S";"0297";"            FINSI"
"IHSUPP";"S";"0298";"*"
"IHSUPP";"S";"0299";"* Calcul du Cpt annuel des HS totales (payees + recuperees)"
"IHSUPP";"S";"0300";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HJOU_IJQHS1MAPA"
"IHSUPP";"S";"0301";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HJOU_IJQHS2MAPA"
"IHSUPP";"S";"0302";"**"
"IHSUPP";"S";"0303";"*****"
"IHSUPP";"S";"0304";"* analyse de l'indicateur de recuperation"
"IHSUPP";"S";"0305";"            SI HJOU_IJIGHSUPPR = ""1"""
"IHSUPP";"S";"0306";"               HJOU_IJQHS1MARE = HJOU_IJQHS1MAPA * LOCA_TAUX1"
"IHSUPP";"S";"0307";"               HJOU_IJQHS1MAPA = 0"
"IHSUPP";"S";"0308";"               HJOU_IJQHS2MARE = HJOU_IJQHS2MAPA * LOCA_TAUX2"
"IHSUPP";"S";"0309";"               HJOU_IJQHS2MAPA = 0"
"IHSUPP";"S";"0310";"***"
"IHSUPP";"S";"0311";"            FINSI"
"IHSUPP";"S";"0312";"            POUR ACTIVITES"
"IHSUPP";"S";"0313";"*analyse de la consigne d'initialisation des hs25 a recuperer"
"IHSUPP";"S";"0314";"               SI HABS_MOTIF = ""Z25R"""
"IHSUPP";"S";"0315";"                  HJOU_IJQHS1MARE = HABS_MOTIDUR"
"IHSUPP";"S";"0316";"                  LOCA_HS25R = HABS_MOTIDUR / LOCA_TAUX1"
"IHSUPP";"S";"0317";"                  HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + LOCA_HS25R"
"IHSUPP";"S";"0318";"               FINSI"
"IHSUPP";"S";"0319";"*analyse de la consigne d'initialisation des hs50 a recuperer"
"IHSUPP";"S";"0320";"               SI HABS_MOTIF = ""Z50R"""
"IHSUPP";"S";"0321";"                  HJOU_IJQHS2MARE = HABS_MOTIDUR"
"IHSUPP";"S";"0322";"                  LOCA_HS50R = HABS_MOTIDUR / LOCA_TAUX2"
"IHSUPP";"S";"0323";"                  HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + LOCA_HS50R"
"IHSUPP";"S";"0324";"               FINSI"
"IHSUPP";"S";"0325";"            FINPOUR"
"IHSUPP";"S";"0326";"*"
"IHSUPP";"S";"0327";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHS1MARE"
"IHSUPP";"S";"0328";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHS2MARE"
"IHSUPP";"S";"0329";"         FINSI"
"IHSUPP";"S";"0330";"      FINSI"
"IHSUPP";"S";"0331";"*"
"IHSUPP";"S";"0332";"*     Calcul du Compteur annuel des heures supp payees"
"IHSUPP";"S";"0333";"*"
"IHSUPP";"S";"0334";"      HJOU_IJRHSHMAJA = HJOU_IJRHSHMAJA + HJOU_IJQHS1MAPA"
"IHSUPP";"S";"0335";"      HJOU_IJRHSHMAJA = HJOU_IJRHSHMAJA + HJOU_IJQHS2MAPA"
"IHSUPP";"S";"0336";"*"
"IHSUPP";"S";"0337";"*     Calcul du Compteur annuel total des heures supp ? recuperer"
"IHSUPP";"S";"0338";"*"
"IHSUPP";"S";"0339";"      HJOU_IJRHRECANN = HJOU_IJRHRECANN + HJOU_IJQHS1MARE"
"IHSUPP";"S";"0340";"      HJOU_IJRHRECANN = HJOU_IJRHRECANN + HJOU_IJQHS2MARE"
"IHSUPP";"S";"0341";"*"
"IHSUPP";"S";"0342";"* deduction du motif de recup REHS"
"IHSUPP";"S";"0343";"*"
"IHSUPP";"S";"0344";"      POUR ACTIVITES"
"IHSUPP";"S";"0345";"         SI HABS_MOTIF = PARD_IDIVMOTHSR"
"IHSUPP";"S";"0346";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HABS_MOTIDUR"
"IHSUPP";"S";"0347";"            LOCA_CONSO = 1"
"IHSUPP";"S";"0348";"         FINSI"
"IHSUPP";"S";"0349";"*  analyse de la consigne d'initialisation du solde recup"
"IHSUPP";"S";"0350";"         SI HABS_MOTIF = ""ZRHS"""
"IHSUPP";"S";"0351";"            HJOU_IJRSHSMREH = HABS_MOTIDUR"
"IHSUPP";"S";"0352";"         FINSI"
"IHSUPP";"S";"0353";"* analyse de la consigne de mise a jour du solde recup"
"IHSUPP";"S";"0354";"         SI HABS_MOTIF = ""XRHS"""
"IHSUPP";"S";"0355";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HABS_MOTIDUR"
"IHSUPP";"S";"0356";"         FINSI"
"IHSUPP";"S";"0357";"*"
"IHSUPP";"S";"0358";"* analyse de la consigne d'initialisation du cumul HS"
"IHSUPP";"S";"0359";"*"
"IHSUPP";"S";"0360";"         SI HABS_MOTIF = ""ZCHS"""
"IHSUPP";"S";"0361";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA - HJOU_IJRHSHMAJA"
"IHSUPP";"S";"0362";"            HJOU_IJRHSHMAJA = HABS_MOTIDUR"
"IHSUPP";"S";"0363";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HABS_MOTIDUR"
"IHSUPP";"S";"0364";"         FINSI"
"IHSUPP";"S";"0365";"*"
"IHSUPP";"S";"0366";"* analyse de la consigne de mise a jour du cumul HS paye"
"IHSUPP";"S";"0367";"*"
"IHSUPP";"S";"0368";"         SI HABS_MOTIF = ""XCHS"""
"IHSUPP";"S";"0369";"            HJOU_IJRHSHMAJA = HJOU_IJRHSHMAJA + HABS_MOTIDUR"
"IHSUPP";"S";"0370";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HABS_MOTIDUR"
"IHSUPP";"S";"0371";"         FINSI"
"IHSUPP";"S";"0372";"*"
"IHSUPP";"S";"0373";"* analyse de la consigne d'initialisation du cumul HS total"
"IHSUPP";"S";"0374";"*"
"IHSUPP";"S";"0375";"         SI HABS_MOTIF = ""ZTHS"""
"IHSUPP";"S";"0376";"            HJOU_IJRHSMPAYA = HABS_MOTIDUR"
"IHSUPP";"S";"0377";"         FINSI"
"IHSUPP";"S";"0378";"*"
"IHSUPP";"S";"0379";"* analyse de la consigne de mise a jour du cumul HS total"
"IHSUPP";"S";"0380";"*"
"IHSUPP";"S";"0381";"         SI HABS_MOTIF = ""XTHS"""
"IHSUPP";"S";"0382";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HABS_MOTIDUR"
"IHSUPP";"S";"0383";"         FINSI"
"IHSUPP";"S";"0384";"*"
"IHSUPP";"S";"0385";"* analyse de la consigne d'init.du cumul HS recup annuel"
"IHSUPP";"S";"0386";"*"
"IHSUPP";"S";"0387";"         SI HABS_MOTIF = ""ZRHA"""
"IHSUPP";"S";"0388";"            HJOU_IJRHRECANN = HABS_MOTIDUR"
"IHSUPP";"S";"0389";"         FINSI"
"IHSUPP";"S";"0390";"*"
"IHSUPP";"S";"0391";"* analyse de la consigne de mise a jour du cumul HS"
"IHSUPP";"S";"0392";"*"
"IHSUPP";"S";"0393";"         SI HABS_MOTIF = ""XRHA"""
"IHSUPP";"S";"0394";"            HJOU_IJRHRECANN = HJOU_IJRHRECANN + HABS_MOTIDUR"
"IHSUPP";"S";"0395";"         FINSI"
"IHSUPP";"S";"0396";"         SI HABS_MOTIF = ""ZPAY"""
"IHSUPP";"S";"0397";"            HJOU_IJQHRNMAPA = HABS_MOTIDUR"
"IHSUPP";"S";"0398";"         FINSI"
"IHSUPP";"S";"0399";"      FINPOUR"
"IHSUPP";"S";"0400";"*"
"IHSUPP";"S";"0401";"      SI LOCA_CONSO = 1"
"IHSUPP";"S";"0402";"         SI HJOU_IJRSHSMREH < 0"
"IHSUPP";"S";"0403";"            ANOMALIE 226"
"IHSUPP";"S";"0404";"            TEMP_CNRETOUR = 2"
"IHSUPP";"S";"0405";"            TEMP_CNMESS = 226"
"IHSUPP";"S";"0406";"         FINSI"
"IHSUPP";"S";"0407";"      FINSI"
"IHSUPP";"S";"0408";"   FINSI"
"IHSUPP";"S";"0409";"**"
"IHSUPP";"S";"0410";"** Soldes previsionnels"
"IHSUPP";"S";"0411";"**"
"IHSUPP";"S";"0412";"   SI CTRA_DATFIN > TEMP_DATJOU"
"IHSUPP";"S";"0413";"      SI CTRA_DATFIN < LOCA_DATEFU"
"IHSUPP";"S";"0414";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHSUPP";"S";"0415";"         LOCA_DATEFU = TEMP_DXFINPER"
"IHSUPP";"S";"0416";"      SINON"
"IHSUPP";"S";"0417";"         SI CTRA_DATFIN < LOCA_DATEFU2"
"IHSUPP";"S";"0418";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHSUPP";"S";"0419";"            LOCA_DATEFU2 = TEMP_DXFINPER"
"IHSUPP";"S";"0420";"         FINSI"
"IHSUPP";"S";"0421";"      FINSI"
"IHSUPP";"S";"0422";"   FINSI"
"IHSUPP";"S";"0423";"***"
"IHSUPP";"S";"0424";"   SI TEMP_DATSUI = LOCA_DATEFU"
"IHSUPP";"S";"0425";"      EMPL_IEQSHSMRE1 = HJOU_IJRSHSMREH"
"IHSUPP";"S";"0426";"   FINSI"
"IHSUPP";"S";"0427";"**"
"IHSUPP";"S";"0428";"   SI TEMP_DATSUI = LOCA_DATEFU2"
"IHSUPP";"S";"0429";"      EMPL_IEQSHSMRE2 = HJOU_IJRSHSMREH"
"IHSUPP";"S";"0430";"   FINSI"
"IHSUPP";"S";"0431";"FINSI"
"IHSUPP";"S";"0432";"*"
"IHSUPP";"S";"0433";"FIN"
"IHSUPPDIM";"S";"0001";"************************************************************************"
"IHSUPPDIM";"S";"0002";"*"
"IHSUPPDIM";"S";"0003";"* Règle : IHSUPPDIM"
"IHSUPPDIM";"S";"0004";"* Ordre : 6070"
"IHSUPPDIM";"S";"0005";"* Titre : Calcul des heures supplémentaires pour les temps plein"
"IHSUPPDIM";"S";"0006";"*          lundi 0h au dimanche 24h"
"IHSUPPDIM";"S";"0007";"*"
"IHSUPPDIM";"S";"0008";"*----------------------------------------------------------------------"
"IHSUPPDIM";"S";"0009";"*"
"IHSUPPDIM";"S";"0010";"* Créé par : Cellule Industrialisation"
"IHSUPPDIM";"S";"0011";"* Date     : 03/09/2009"
"IHSUPPDIM";"S";"0012";"* Version  : 1"
"IHSUPPDIM";"S";"0013";"*"
"IHSUPPDIM";"S";"0014";"*----------------------------------------------------------------------"
"IHSUPPDIM";"S";"0015";"*"
"IHSUPPDIM";"S";"0016";"*"
"IHSUPPDIM";"S";"0017";"* Rôle : Calcul des heures supplémentaires"
"IHSUPPDIM";"S";"0018";"*         (gestion uniquement pour les temps plein)"
"IHSUPPDIM";"S";"0019";"*"
"IHSUPPDIM";"S";"0020";"*"
"IHSUPPDIM";"S";"0021";"*         Adaptation de la règle IHSUPPDIM avec ajout suivant :"
"IHSUPPDIM";"S";"0022";"*"
"IHSUPPDIM";"S";"0023";"*         Séparation en deux des règles IHSUPP et IHSUPPDIM afin de"
"IHSUPPDIM";"S";"0024";"*         différencier les HS et les HC"
"IHSUPPDIM";"S";"0025";"*"
"IHSUPPDIM";"S";"0026";"*----------------------------------------------------------------------"
"IHSUPPDIM";"S";"0027";"*"
"IHSUPPDIM";"S";"0028";"* Modifiée par : Méthodes et outils"
"IHSUPPDIM";"S";"0029";"* Date         : 15/10/2019"
"IHSUPPDIM";"S";"0030";"* Objet        : Ajout d'une gestion paiement HS 50% en cours de période"
"IHSUPPDIM";"S";"0031";"*"
"IHSUPPDIM";"S";"0032";"*                 Pour les employés en régime HS à 3 (Calcul HS dimanche et"
"IHSUPPDIM";"S";"0033";"*                 annuelles), si le seuil HORC_IHISEUILHS est renseigné"
"IHSUPPDIM";"S";"0034";"*                 alors celui-ci remplacera le seuil HS taux 2 de PARD"
"IHSUPPDIM";"S";"0035";"*                 (PARD_IDISHSMTX2). Il faut également renseigner la date"
"IHSUPPDIM";"S";"0036";"*                 d'effet (PARD_IDIDATPEHS), c'est à partir de celle-ci que"
"IHSUPPDIM";"S";"0037";"*                 le calcul des HS sera effectif."
"IHSUPPDIM";"S";"0038";"*                 Les HS calculées au delà du seuil seront les heures payées"
"IHSUPPDIM";"S";"0039";"*                 en cours de période et seront soustraite aux heures"
"IHSUPPDIM";"S";"0040";"*                 effectives annuelles (HJOU_IJRTTEPMOD)"
"IHSUPPDIM";"S";"0041";"*"
"IHSUPPDIM";"S";"0042";"***********************************************************************"
"IHSUPPDIM";"S";"0043";"*"
"IHSUPPDIM";"S";"0044";"* Modifiée par : Méthodes et outils"
"IHSUPPDIM";"S";"0045";"* Date         : 30/06/2020"
"IHSUPPDIM";"S";"0046";"* Objet        : Le test de CTRA_ICITAUX est remplacé par HJOU_IJITYPCTRA"
"IHSUPPDIM";"S";"0047";"*                 car le taux du contrat est désormais copié dans JOU"
"IHSUPPDIM";"S";"0048";"*"
"IHSUPPDIM";"S";"0049";"***********************************************************************"
"IHSUPPDIM";"S";"0050";"* Modifiée par : Méthodes et outils"
"IHSUPPDIM";"S";"0051";"* Date         : 05/04/2023"
"IHSUPPDIM";"S";"0052";"* Objet        : Création d'une consigne de transfert des HS payées à récupérer*"
"IHSUPPDIM";"S";"0053";"*"
"IHSUPPDIM";"S";"0054";"***********************************************************************"
"IHSUPPDIM";"S";"0055";"*"
"IHSUPPDIM";"S";"0056";"* Implémentation des données industrielles"
"IHSUPPDIM";"S";"0057";"*"
"IHSUPPDIM";"S";"0058";"DEBDICO"
"IHSUPPDIM";"S";"0059";"   HJOU_IJIGHSUPPM;O;Z1;X;;;123456789;L;;C2;""Régime HS"";"
"IHSUPPDIM";"S";"0060";"   HJOU_IJRBHSMPAH;N;T6,2;I;;;    56789;;IJRBHSMPAH;V3;""Base HS"";"
"IHSUPPDIM";"S";"0061";"   HJOU_IJRHSHMAJA;N;T8,2;L;;;    56789;;IJRHSHMAJA;V3;""Cumul annuel HS payées"";"
"IHSUPPDIM";"S";"0062";"   HJOU_IJRHSMPAYA;N;T8,2;L;;;    56789;;IJRHSMPAYA;V3;""Cumul annuel HS"";"
"IHSUPPDIM";"S";"0063";"   HJOU_IJRHRECANN;N;T8,2;L;;;    56789;;IJRHRECANN;V3;""Cumul annuel HS à récupérer"";"
"IHSUPPDIM";"S";"0064";"   HJOU_IJQHS1MAPA;N;T6,2;I;;;    56789;;;V3;""Heures sup taux 1"";"
"IHSUPPDIM";"S";"0065";"   HJOU_IJQHS2MAPA;N;T6,2;I;;;    56789;;;V3;""Heures sup taux 2"";"
"IHSUPPDIM";"S";"0066";"   HJOU_IJQHPAYEES;N;T6,2;I;;;    56789;;;V3;""Heures payées"";"
"IHSUPPDIM";"S";"0067";"   HJOU_IJRBHPAYEE;N;T6,2;I;;;    56789;;IJRBHPAYEE;V3;""Base des heures payées"";"
"IHSUPPDIM";"S";"0068";"   HJOU_IJQHS1MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 1 à récup."";"
"IHSUPPDIM";"S";"0069";"   HJOU_IJQHS2MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 2 à récup."";"
"IHSUPPDIM";"S";"0070";"   HJOU_IJRSHSMREH;N;T8,2;L;;;     6789;;IJRSHSMREH;V3;""Récupération HS/HC"";"
"IHSUPPDIM";"S";"0071";"   HJOU_IJRTHEOCYC;N;T6,2;I;;;    56789;;IJRTHEOCYC;V3;""Theorie du cycle"";"
"IHSUPPDIM";"S";"0072";"   HJOU_IJQHRNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures payées non majorées"";"
"IHSUPPDIM";"S";"0073";"   MOTI_IMIGHRPAYE;O;Z1;X;0;1;123456789;C;;C2;""Participe aux heures payées"";"
"IHSUPPDIM";"S";"0074";"   EMPL_IEQSHSMRE1;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 1 HS à recup."";"
"IHSUPPDIM";"S";"0075";"   EMPL_IEQSHSMRE2;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 2 HS à recup."";"
"IHSUPPDIM";"S";"0076";"   PARD_IDIHSTAUX1;O;N2;I;;;123456789;;;C3;""HS taux 1 (%)"";"
"IHSUPPDIM";"S";"0077";"   PARD_IDIHSTAUX2;O;N2;I;;;123456789;;;C3;""HS taux 2 (%)"";"
"IHSUPPDIM";"S";"0078";"   HORC_IHISEUILHS;O;T6,2;I;;;123456789;;;C3;""Seuil paiement des HS"";"
"IHSUPPDIM";"S";"0079";"   PARD_IDIDATPEHS;O;D10;X;;;123456789;;;C3;""Début période HS payées avant fin cycle"";"
"IHSUPPDIM";"S";"0080";"FINDICO"
"IHSUPPDIM";"S";"0081";"DEBANO"
"IHSUPPDIM";"S";"0082";"   192;9;""Heures non majorées payées négatives"";"
"IHSUPPDIM";"S";"0083";"   226;9;""Solde récup HS/HC insuffisant"";"
"IHSUPPDIM";"S";"0084";"FINANO"
"IHSUPPDIM";"S";"0085";"*"
"IHSUPPDIM";"S";"0086";"* Déclaration des donnees locales"
"IHSUPPDIM";"S";"0087";"*"
"IHSUPPDIM";"S";"0088";"DEF LOCA_SHS25 T6.2"
"IHSUPPDIM";"S";"0089";"LOCA_SHS25 = 0"
"IHSUPPDIM";"S";"0090";"DEF LOCA_SHS50 T6.2"
"IHSUPPDIM";"S";"0091";"LOCA_SHS50 = 0"
"IHSUPPDIM";"S";"0092";"DEF LOCA_NBCYCLE N2"
"IHSUPPDIM";"S";"0093";"LOCA_NBCYCLE = 0"
"IHSUPPDIM";"S";"0094";"DEF LOCA_CAL N1"
"IHSUPPDIM";"S";"0095";"LOCA_CAL = 0"
"IHSUPPDIM";"S";"0096";"DEF LOCA_BASEHS T6.2"
"IHSUPPDIM";"S";"0097";"LOCA_BASEHS = 0"
"IHSUPPDIM";"S";"0098";"DEF LOCA_HS25R T6.2"
"IHSUPPDIM";"S";"0099";"LOCA_HS25R = 0"
"IHSUPPDIM";"S";"0100";"DEF LOCA_HS50R T6.2"
"IHSUPPDIM";"S";"0101";"LOCA_HS50R = 0"
"IHSUPPDIM";"S";"0102";"DEF LOCA_DATE D"
"IHSUPPDIM";"S";"0103";"LOCA_DATE = "" """
"IHSUPPDIM";"S";"0104";"DEF LOCA_ACOURS N4"
"IHSUPPDIM";"S";"0105";"LOCA_ACOURS = 0"
"IHSUPPDIM";"S";"0106";"DEF LOCA_ACOURS2 N4"
"IHSUPPDIM";"S";"0107";"LOCA_ACOURS2 = 0"
"IHSUPPDIM";"S";"0108";"DEF LOCA_DATEFU D"
"IHSUPPDIM";"S";"0109";"LOCA_DATEFU = "" """
"IHSUPPDIM";"S";"0110";"DEF LOCA_DATEFU2 D"
"IHSUPPDIM";"S";"0111";"LOCA_DATEFU2 = "" """
"IHSUPPDIM";"S";"0112";"DEF LOCA_TAUX1 N4.2"
"IHSUPPDIM";"S";"0113";"LOCA_TAUX1 = 0"
"IHSUPPDIM";"S";"0114";"DEF LOCA_TAUX2 N4.2"
"IHSUPPDIM";"S";"0115";"LOCA_TAUX2 = 0"
"IHSUPPDIM";"S";"0116";"LOCA_TAUX1 = PARD_IDIHSTAUX1 / 100"
"IHSUPPDIM";"S";"0117";"LOCA_TAUX1 = LOCA_TAUX1 + 1"
"IHSUPPDIM";"S";"0118";"LOCA_TAUX2 = PARD_IDIHSTAUX2 / 100"
"IHSUPPDIM";"S";"0119";"LOCA_TAUX2 = LOCA_TAUX2 + 1"
"IHSUPPDIM";"S";"0120";"DEF LOCA_CONS N1"
"IHSUPPDIM";"S";"0121";"LOCA_CONS = 0"
"IHSUPPDIM";"S";"0122";"DEF LOCA_CONSO N1"
"IHSUPPDIM";"S";"0123";"LOCA_CONSO = 0"
"IHSUPPDIM";"S";"0124";"*"
"IHSUPPDIM";"S";"0125";"*Si HJOU_IJITYPCTRA n'est pas renseigné alors il est considéré comme un temps plein"
"IHSUPPDIM";"S";"0126";"SI HJOU_IJITYPCTRA = 0"
"IHSUPPDIM";"S";"0127";"OU HJOU_IJITYPCTRA = 100"
"IHSUPPDIM";"S";"0128";"*"
"IHSUPPDIM";"S";"0129";"* Alimentation des données locales pour calcul soldes prévisionnels"
"IHSUPPDIM";"S";"0130";"*"
"IHSUPPDIM";"S";"0131";"   SI PARD_IDIDDEBANN <> "" """
"IHSUPPDIM";"S";"0132";"      LOCA_DATE(5:4) = PARD_IDIDDEBANN(5:4)"
"IHSUPPDIM";"S";"0133";"   SINON"
"IHSUPPDIM";"S";"0134";"      LOCA_DATE(5:4) = ""0101"""
"IHSUPPDIM";"S";"0135";"   FINSI"
"IHSUPPDIM";"S";"0136";"**"
"IHSUPPDIM";"S";"0137";"   LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IHSUPPDIM";"S";"0138";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHSUPPDIM";"S";"0139";"*"
"IHSUPPDIM";"S";"0140";"   SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IHSUPPDIM";"S";"0141";"      LOCA_ACOURS = LOCA_ACOURS + 1"
"IHSUPPDIM";"S";"0142";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHSUPPDIM";"S";"0143";"   FINSI"
"IHSUPPDIM";"S";"0144";"*"
"IHSUPPDIM";"S";"0145";"   LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IHSUPPDIM";"S";"0146";"   LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IHSUPPDIM";"S";"0147";"   LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IHSUPPDIM";"S";"0148";"   LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IHSUPPDIM";"S";"0149";"*"
"IHSUPPDIM";"S";"0150";"* INRH = 1 calcul des HS chaque dimanche"
"IHSUPPDIM";"S";"0151";"* INRH = 2 calcul des HS le dernier dimanche du cycle"
"IHSUPPDIM";"S";"0152";"* INRH = 3 calcul des HS chaque dimanche et en fin d'annualisation"
"IHSUPPDIM";"S";"0153";"* Raz de la base HS le lundi"
"IHSUPPDIM";"S";"0154";"   SI HJOU_JOUR = ""1"""
"IHSUPPDIM";"S";"0155";"* raz chaque lundi <> 2 (0/1/3)"
"IHSUPPDIM";"S";"0156";"      SI HJOU_IJIGHSUPPM <> ""2"""
"IHSUPPDIM";"S";"0157";"         HJOU_IJRBHSMPAH = 0"
"IHSUPPDIM";"S";"0158";"         HJOU_IJRBHPAYEE = 0"
"IHSUPPDIM";"S";"0159";"      FINSI"
"IHSUPPDIM";"S";"0160";"* raz le premier lundi du cycle si INRH = 2"
"IHSUPPDIM";"S";"0161";"      SI HJOU_IJIGHSUPPM = ""2"""
"IHSUPPDIM";"S";"0162";"* stokage de la duree theorique du code horaire"
"IHSUPPDIM";"S";"0163";"         SI HJOU_RANG = 1"
"IHSUPPDIM";"S";"0164";"            HJOU_IJRBHSMPAH = 0"
"IHSUPPDIM";"S";"0165";"* raz de la duree theorique du cycle"
"IHSUPPDIM";"S";"0166";"            HJOU_IJRTHEOCYC = 0"
"IHSUPPDIM";"S";"0167";"            HJOU_IJRBHPAYEE = 0"
"IHSUPPDIM";"S";"0168";"         FINSI"
"IHSUPPDIM";"S";"0169";"* cumul de la duree theorique du cycle"
"IHSUPPDIM";"S";"0170";"         HJOU_IJRTHEOCYC = HJOU_IJRTHEOCYC + HJOU_HORHEB"
"IHSUPPDIM";"S";"0171";"      FINSI"
"IHSUPPDIM";"S";"0172";"   FINSI"
"IHSUPPDIM";"S";"0173";"   SI HJOU_IJIGHSUPPM <> ""0"""
"IHSUPPDIM";"S";"0174";"* on calcul également la base HS dans le cas ou on"
"IHSUPPDIM";"S";"0175";"* calcul un acquis RTT hebdo"
"IHSUPPDIM";"S";"0176";"   OU HJOU_IJIGRETETR = ""3"""
"IHSUPPDIM";"S";"0177";"* Calcul de la base des HS"
"IHSUPPDIM";"S";"0178";"      LOCA_BASEHS = HJOU_IJQPRESBAV"
"IHSUPPDIM";"S";"0179";"* le dimanche on ne prend que les heures jour en cours"
"IHSUPPDIM";"S";"0180";"      SI HJOU_JOUR = ""7"""
"IHSUPPDIM";"S";"0181";"         LOCA_BASEHS = HJOU_IJQPREJENC"
"IHSUPPDIM";"S";"0182";"      FINSI"
"IHSUPPDIM";"S";"0183";"*"
"IHSUPPDIM";"S";"0184";"* le lundi , dans le cas ou l'agent a commençé à 21h00 le dimanche"
"IHSUPPDIM";"S";"0185";"* on prend les heures faites le dimanche apres minuit"
"IHSUPPDIM";"S";"0186";"*"
"IHSUPPDIM";"S";"0187";"      SI HJOU_JOUR = ""1"""
"IHSUPPDIM";"S";"0188";"         LOCA_BASEHS = LOCA_BASEHS + HJOU_IJRPREVEIL"
"IHSUPPDIM";"S";"0189";"      FINSI"
"IHSUPPDIM";"S";"0190";"**"
"IHSUPPDIM";"S";"0191";"      HJOU_IJQHPAYEES = LOCA_BASEHS"
"IHSUPPDIM";"S";"0192";"      POUR ACTIVITES"
"IHSUPPDIM";"S";"0193";"         SI MOTI_MOTYPE <> ""C"""
"IHSUPPDIM";"S";"0194";"            SI MOTI_IMIGHRSSUP = ""1"""
"IHSUPPDIM";"S";"0195";"            OU MOTI_IMIGHRPAYE = ""1"""
"IHSUPPDIM";"S";"0196";"               HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0197";"            FINSI"
"IHSUPPDIM";"S";"0198";"         FINSI"
"IHSUPPDIM";"S";"0199";"** alimentation par consignes"
"IHSUPPDIM";"S";"0200";"         SI HABS_MOTIF = ""ZHPA"""
"IHSUPPDIM";"S";"0201";"            HJOU_IJQHPAYEES = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0202";"         FINSI"
"IHSUPPDIM";"S";"0203";"*"
"IHSUPPDIM";"S";"0204";"         SI HABS_MOTIF = ""XHPA"""
"IHSUPPDIM";"S";"0205";"            HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0206";"         FINSI"
"IHSUPPDIM";"S";"0207";"      FINPOUR"
"IHSUPPDIM";"S";"0208";"** alimentation des bases hebdo"
"IHSUPPDIM";"S";"0209";"      HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + LOCA_BASEHS"
"IHSUPPDIM";"S";"0210";"*"
"IHSUPPDIM";"S";"0211";"      HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE + HJOU_IJQHPAYEES"
"IHSUPPDIM";"S";"0212";"      POUR ACTIVITES"
"IHSUPPDIM";"S";"0213";"         SI MOTI_MOTYPE <> ""C"""
"IHSUPPDIM";"S";"0214";"            SI MOTI_IMIGHRSSUP = ""1"""
"IHSUPPDIM";"S";"0215";"               HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0216";"            FINSI"
"IHSUPPDIM";"S";"0217";"         FINSI"
"IHSUPPDIM";"S";"0218";"      FINPOUR"
"IHSUPPDIM";"S";"0219";"   FINSI"
"IHSUPPDIM";"S";"0220";"* raz du cumul des HS en debut de periode d'annualisation"
"IHSUPPDIM";"S";"0221";"   SI PARD_IDIDDEBANN <> "" """
"IHSUPPDIM";"S";"0222";"      SI HJOU_DATE = PARD_IDIDDEBANN"
"IMISSB";"S";"0014";"*"
"IHSUPPDIM";"S";"0223";"         HJOU_IJRHSHMAJA = 0"
"IHSUPPDIM";"S";"0224";"         HJOU_IJRHSMPAYA = 0"
"IHSUPPDIM";"S";"0225";"         HJOU_IJRHRECANN = 0"
"IHSUPPDIM";"S";"0226";"      FINSI"
"IHSUPPDIM";"S";"0227";"   SINON"
"IHSUPPDIM";"S";"0228";"      SI HJOU_DATE(5:4) = ""0101"""
"IHSUPPDIM";"S";"0229";"         HJOU_IJRHSHMAJA = 0"
"IHSUPPDIM";"S";"0230";"         HJOU_IJRHSMPAYA = 0"
"IHSUPPDIM";"S";"0231";"         HJOU_IJRHRECANN = 0"
"IHSUPPDIM";"S";"0232";"      FINSI"
"IHSUPPDIM";"S";"0233";"   FINSI"
"IHSUPPDIM";"S";"0234";"*** initialisation de la base HS par consigne"
"IHSUPPDIM";"S";"0235";"   POUR ACTIVITES"
"IHSUPPDIM";"S";"0236";"      SI HABS_MOTIF = ""ZBHS"""
"IHSUPPDIM";"S";"0237";"         HJOU_IJRBHSMPAH = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0238";"      FINSI"
"IHSUPPDIM";"S";"0239";"      SI HABS_MOTIF = ""ZBPA"""
"IHSUPPDIM";"S";"0240";"         HJOU_IJRBHPAYEE = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0241";"      FINSI"
"IHSUPPDIM";"S";"0242";"   FINPOUR"
"IHSUPPDIM";"S";"0243";"   SI HJOU_IJIGHSUPPM <> ""0"""
"IHSUPPDIM";"S";"0244";"* calcul des HS"
"IHSUPPDIM";"S";"0245";"      SI HJOU_JOUR = ""7"""
"IHSUPPDIM";"S";"0246";"         SI HJOU_IJIGHSUPPM = ""1"""
"IHSUPPDIM";"S";"0247";"         OU HJOU_IJIGHSUPPM = ""3"""
"IHSUPPDIM";"S";"0248";"            LOCA_SHS25 = PARD_IDISHSMTX1"
"IHSUPPDIM";"S";"0249";"* Gestion HS avec seuil dans PARD"
"IHSUPPDIM";"S";"0250";"            LOCA_SHS50 = PARD_IDISHSMTX2"
"IHSUPPDIM";"S";"0251";"*"
"IHSUPPDIM";"S";"0252";"* Gestion paiement des HS en cours de période"
"IHSUPPDIM";"S";"0253";"* (seuil HS taux 2 dans HOR)"
"IHSUPPDIM";"S";"0254";"            SI HORC_IHISEUILHS > 0"
"IHSUPPDIM";"S";"0255";"               SI HJOU_IJIGHSUPPM = ""3"""
"IHSUPPDIM";"S";"0256";"*Date dans PARD"
"IHSUPPDIM";"S";"0257";"                  SI PARD_IDIDATPEHS <> "" """
"IHSUPPDIM";"S";"0258";"                     SI HJOU_DATE >= PARD_IDIDATPEHS"
"IHSUPPDIM";"S";"0259";"                        LOCA_SHS50 = HORC_IHISEUILHS"
"IHSUPPDIM";"S";"0260";"                     FINSI"
"IHSUPPDIM";"S";"0261";"                  FINSI"
"IHSUPPDIM";"S";"0262";"               FINSI"
"IHSUPPDIM";"S";"0263";"            FINSI"
"IHSUPPDIM";"S";"0264";"            LOCA_CAL = 1"
"IHSUPPDIM";"S";"0265";"         FINSI"
"IHSUPPDIM";"S";"0266";"         SI HJOU_IJIGHSUPPM = ""2"""
"IHSUPPDIM";"S";"0267";"* dans le cas ou les HS se calculent en fin de cycle"
"IHSUPPDIM";"S";"0268";"* loca_nbcycle correspond au nombre de semaines"
"IHSUPPDIM";"S";"0269";"            LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"IHSUPPDIM";"S";"0270";"            SI HJOU_RANG = LOCA_NBCYCLE"
"IHSUPPDIM";"S";"0271";"               LOCA_SHS25 = PARD_IDISHSMTX1 * LOCA_NBCYCLE"
"IHSUPPDIM";"S";"0272";"               LOCA_SHS50 = PARD_IDISHSMTX2 * LOCA_NBCYCLE"
"IHSUPPDIM";"S";"0273";"               LOCA_CAL = 1"
"IHSUPPDIM";"S";"0274";"            FINSI"
"IHSUPPDIM";"S";"0275";"         FINSI"
"IHSUPPDIM";"S";"0276";"*  Calcul des heures suppl?mentaires ? 25% et 50%"
"IHSUPPDIM";"S";"0277";"         SI LOCA_CAL = 1"
"IHSUPPDIM";"S";"0278";"            SI HJOU_IJRBHSMPAH >= LOCA_SHS50"
"IHSUPPDIM";"S";"0279";"               HJOU_IJQHS1MAPA = LOCA_SHS50 - LOCA_SHS25"
"IHSUPPDIM";"S";"0280";"               HJOU_IJQHS2MAPA = HJOU_IJRBHSMPAH - LOCA_SHS50"
"IHSUPPDIM";"S";"0281";"* Si gestion paiement des HS en cours de période"
"IHSUPPDIM";"S";"0282";"               SI LOCA_SHS50 = HORC_IHISEUILHS"
"IHSUPPDIM";"S";"0283";"                  LOCA_CONS = 1"
"IHSUPPDIM";"S";"0284";"                  HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD - HJOU_IJQHS2MAPA"
"IHSUPPDIM";"S";"0285";"               FINSI"
"IHSUPPDIM";"S";"0286";"            SINON"
"IHSUPPDIM";"S";"0287";"               SI HJOU_IJRBHSMPAH > LOCA_SHS25"
"IHSUPPDIM";"S";"0288";"                  HJOU_IJQHS1MAPA = HJOU_IJRBHSMPAH - LOCA_SHS25"
"IHSUPPDIM";"S";"0289";"               FINSI"
"IHSUPPDIM";"S";"0290";"            FINSI"
"IHSUPPDIM";"S";"0291";"*"
"IHSUPPDIM";"S";"0292";"            SI HJOU_IJRBHPAYEE > LOCA_SHS25"
"IHSUPPDIM";"S";"0293";"               HJOU_IJQHRNMAPA = HJOU_IJRBHPAYEE - LOCA_SHS25"
"IHSUPPDIM";"S";"0294";"            FINSI"
"IHSUPPDIM";"S";"0295";"*"
"IHSUPPDIM";"S";"0296";"            POUR ACTIVITES"
"IHSUPPDIM";"S";"0297";"*  analyse de la consigne d'initialisation des hs25"
"IHSUPPDIM";"S";"0298";"               SI HABS_MOTIF = ""Z25P"""
"IHSUPPDIM";"S";"0299";"                  HJOU_IJQHS1MAPA = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0300";"               FINSI"
"IHSUPPDIM";"S";"0301";"*  analyse de la consigne d'initialisation des hs50"
"IHSUPPDIM";"S";"0302";"               SI HABS_MOTIF = ""Z50P"""
"IHSUPPDIM";"S";"0303";"                  SI LOCA_CONS = 1"
"IHSUPPDIM";"S";"0304";"                     HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD + HJOU_IJQHS2MAPA"
"IHSUPPDIM";"S";"0305";"                     HJOU_IJQHS2MAPA = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0306";"                     HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD - HJOU_IJQHS2MAPA"
"IHSUPPDIM";"S";"0307";"                  SINON"
"IHSUPPDIM";"S";"0308";"                     HJOU_IJQHS2MAPA = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0309";"                  FINSI"
"IHSUPPDIM";"S";"0310";"               FINSI"
"IHSUPPDIM";"S";"0311";"            FINPOUR"
"IHSUPPDIM";"S";"0312";"            HJOU_IJQHRNMAPA = HJOU_IJQHRNMAPA - HJOU_IJQHS1MAPA"
"IHSUPPDIM";"S";"0313";"            HJOU_IJQHRNMAPA = HJOU_IJQHRNMAPA - HJOU_IJQHS2MAPA"
"IHSUPPDIM";"S";"0314";"            SI HJOU_IJQHRNMAPA < 0"
"IHSUPPDIM";"S";"0315";"               ANOMALIE 192"
"IHSUPPDIM";"S";"0316";"            FINSI"
"IHSUPPDIM";"S";"0317";"**M&0 : 04/04/2023 : ajout d'une consigne pour transférer les HS payées en HS à récupérer"
"IHSUPPDIM";"S";"0318";"            POUR ACTIVITES"
"IHSUPPDIM";"S";"0319";"               SI HABS_MOTIF = ""YHSREC"""
"IHSUPPDIM";"S";"0320";"                  HJOU_IJQHS1MARE = HJOU_IJQHS1MAPA * LOCA_TAUX1"
"IHSUPPDIM";"S";"0321";"                  HJOU_IJQHS2MARE = HJOU_IJQHS2MAPA * LOCA_TAUX2"
"IHSUPPDIM";"S";"0322";"                  HJOU_IJQHS1MAPA = 0"
"IHSUPPDIM";"S";"0323";"                  HJOU_IJQHS2MAPA = 0"
"IHSUPPDIM";"S";"0324";"               FINSI"
"IHSUPPDIM";"S";"0325";"            FINPOUR"
"IHSUPPDIM";"S";"0326";"*"
"IHSUPPDIM";"S";"0327";"* Calcul du Cpt annuel des HS totales (payees + recuperees)"
"IHSUPPDIM";"S";"0328";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HJOU_IJQHS1MAPA"
"IHSUPPDIM";"S";"0329";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HJOU_IJQHS2MAPA"
"IHSUPPDIM";"S";"0330";"**"
"IHSUPPDIM";"S";"0331";"*****"
"IHSUPPDIM";"S";"0332";"* analyse de l'indicateur de recuperation"
"IHSUPPDIM";"S";"0333";"            SI HJOU_IJIGHSUPPR = ""1"""
"IHSUPPDIM";"S";"0334";"               HJOU_IJQHS1MARE = HJOU_IJQHS1MAPA * LOCA_TAUX1"
"IHSUPPDIM";"S";"0335";"               HJOU_IJQHS1MAPA = 0"
"IHSUPPDIM";"S";"0336";"               HJOU_IJQHS2MARE = HJOU_IJQHS2MAPA * LOCA_TAUX2"
"IHSUPPDIM";"S";"0337";"               HJOU_IJQHS2MAPA = 0"
"IHSUPPDIM";"S";"0338";"***"
"IHSUPPDIM";"S";"0339";"            FINSI"
"IHSUPPDIM";"S";"0340";"            POUR ACTIVITES"
"IHSUPPDIM";"S";"0341";"*analyse de la consigne d'initialisation des hs25 a recuperer"
"IHSUPPDIM";"S";"0342";"               SI HABS_MOTIF = ""Z25R"""
"IHSUPPDIM";"S";"0343";"                  HJOU_IJQHS1MARE = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0344";"                  LOCA_HS25R = HABS_MOTIDUR / LOCA_TAUX1"
"IHSUPPDIM";"S";"0345";"                  HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + LOCA_HS25R"
"IHSUPPDIM";"S";"0346";"               FINSI"
"IHSUPPDIM";"S";"0347";"*analyse de la consigne d'initialisation des hs50 a recuperer"
"IHSUPPDIM";"S";"0348";"               SI HABS_MOTIF = ""Z50R"""
"IHSUPPDIM";"S";"0349";"                  HJOU_IJQHS2MARE = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0350";"                  LOCA_HS50R = HABS_MOTIDUR / LOCA_TAUX2"
"IHSUPPDIM";"S";"0351";"                  HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + LOCA_HS50R"
"IHSUPPDIM";"S";"0352";"               FINSI"
"IHSUPPDIM";"S";"0353";"**M&0 : 04/04/2023 : ajout d'une consigne pour transférer les HS à récupérer en HS payées"
"IHSUPPDIM";"S";"0354";"               SI HABS_MOTIF = ""YHSPAY"""
"IHSUPPDIM";"S";"0355";"                  HJOU_IJQHS1MAPA = HJOU_IJQHS1MARE / LOCA_TAUX1"
"IHSUPPDIM";"S";"0356";"                  HJOU_IJQHS2MAPA = HJOU_IJQHS2MARE / LOCA_TAUX2"
"IHSUPPDIM";"S";"0357";"                  HJOU_IJQHS1MARE = 0"
"IHSUPPDIM";"S";"0358";"                  HJOU_IJQHS2MARE = 0"
"IHSUPPDIM";"S";"0359";"               FINSI"
"IHSUPPDIM";"S";"0360";"*            FINSI"
"IHSUPPDIM";"S";"0361";"**********"
"IHSUPPDIM";"S";"0362";"            FINPOUR"
"IHSUPPDIM";"S";"0363";"*"
"IHSUPPDIM";"S";"0364";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHS1MARE"
"IHSUPPDIM";"S";"0365";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHS2MARE"
"IHSUPPDIM";"S";"0366";"         FINSI"
"IHSUPPDIM";"S";"0367";"      FINSI"
"IHSUPPDIM";"S";"0368";"*"
"IHSUPPDIM";"S";"0369";"*     Calcul du Compteur annuel des heures supp payees"
"IHSUPPDIM";"S";"0370";"*"
"IHSUPPDIM";"S";"0371";"      HJOU_IJRHSHMAJA = HJOU_IJRHSHMAJA + HJOU_IJQHS1MAPA"
"IHSUPPDIM";"S";"0372";"      HJOU_IJRHSHMAJA = HJOU_IJRHSHMAJA + HJOU_IJQHS2MAPA"
"IHSUPPDIM";"S";"0373";"*"
"IHSUPPDIM";"S";"0374";"*     Calcul du Compteur annuel total des heures supp ? recuperer"
"IHSUPPDIM";"S";"0375";"*"
"IHSUPPDIM";"S";"0376";"      HJOU_IJRHRECANN = HJOU_IJRHRECANN + HJOU_IJQHS1MARE"
"IHSUPPDIM";"S";"0377";"      HJOU_IJRHRECANN = HJOU_IJRHRECANN + HJOU_IJQHS2MARE"
"IHSUPPDIM";"S";"0378";"*"
"IHSUPPDIM";"S";"0379";"* deduction du motif de recup REHS"
"IHSUPPDIM";"S";"0380";"*"
"IHSUPPDIM";"S";"0381";"      POUR ACTIVITES"
"IHSUPPDIM";"S";"0382";"         SI HABS_MOTIF = PARD_IDIVMOTHSR"
"IHSUPPDIM";"S";"0383";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HABS_MOTIDUR"
"IHSUPPDIM";"S";"0384";"            LOCA_CONSO = 1"
"IHSUPPDIM";"S";"0385";"         FINSI"
"IHSUPPDIM";"S";"0386";"*  analyse de la consigne d'initialisation du solde recup"
"IHSUPPDIM";"S";"0387";"         SI HABS_MOTIF = ""ZRHS"""
"IHSUPPDIM";"S";"0388";"            HJOU_IJRSHSMREH = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0389";"         FINSI"
"IHSUPPDIM";"S";"0390";"* analyse de la consigne de mise a jour du solde recup"
"IHSUPPDIM";"S";"0391";"         SI HABS_MOTIF = ""XRHS"""
"IHSUPPDIM";"S";"0392";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0393";"         FINSI"
"IHSUPPDIM";"S";"0394";"*"
"IHSUPPDIM";"S";"0395";"* analyse de la consigne d'initialisation du cumul HS"
"IHSUPPDIM";"S";"0396";"*"
"IHSUPPDIM";"S";"0397";"         SI HABS_MOTIF = ""ZCHS"""
"IHSUPPDIM";"S";"0398";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA - HJOU_IJRHSHMAJA"
"IHSUPPDIM";"S";"0399";"            HJOU_IJRHSHMAJA = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0400";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0401";"         FINSI"
"IHSUPPDIM";"S";"0402";"*"
"IHSUPPDIM";"S";"0403";"* analyse de la consigne de mise a jour du cumul HS paye"
"IHSUPPDIM";"S";"0404";"*"
"IHSUPPDIM";"S";"0405";"         SI HABS_MOTIF = ""XCHS"""
"IHSUPPDIM";"S";"0406";"            HJOU_IJRHSHMAJA = HJOU_IJRHSHMAJA + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0407";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0408";"         FINSI"
"IHSUPPDIM";"S";"0409";"*"
"IHSUPPDIM";"S";"0410";"* analyse de la consigne d'initialisation du cumul HS total"
"IHSUPPDIM";"S";"0411";"*"
"IHSUPPDIM";"S";"0412";"         SI HABS_MOTIF = ""ZTHS"""
"IHSUPPDIM";"S";"0413";"            HJOU_IJRHSMPAYA = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0414";"         FINSI"
"IHSUPPDIM";"S";"0415";"*"
"IHSUPPDIM";"S";"0416";"* analyse de la consigne de mise a jour du cumul HS total"
"IHSUPPDIM";"S";"0417";"*"
"IHSUPPDIM";"S";"0418";"         SI HABS_MOTIF = ""XTHS"""
"IHSUPPDIM";"S";"0419";"            HJOU_IJRHSMPAYA = HJOU_IJRHSMPAYA + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0420";"         FINSI"
"IHSUPPDIM";"S";"0421";"*"
"IHSUPPDIM";"S";"0422";"* analyse de la consigne d'init.du cumul HS recup annuel"
"IHSUPPDIM";"S";"0423";"*"
"IHSUPPDIM";"S";"0424";"         SI HABS_MOTIF = ""ZRHA"""
"IHSUPPDIM";"S";"0425";"            HJOU_IJRHRECANN = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0426";"         FINSI"
"IHSUPPDIM";"S";"0427";"*"
"IHSUPPDIM";"S";"0428";"* analyse de la consigne de mise a jour du cumul HS"
"IHSUPPDIM";"S";"0429";"*"
"IHSUPPDIM";"S";"0430";"         SI HABS_MOTIF = ""XRHA"""
"IHSUPPDIM";"S";"0431";"            HJOU_IJRHRECANN = HJOU_IJRHRECANN + HABS_MOTIDUR"
"IHSUPPDIM";"S";"0432";"         FINSI"
"IHSUPPDIM";"S";"0433";"         SI HABS_MOTIF = ""ZPAY"""
"IHSUPPDIM";"S";"0434";"            HJOU_IJQHRNMAPA = HABS_MOTIDUR"
"IHSUPPDIM";"S";"0435";"         FINSI"
"IHSUPPDIM";"S";"0436";"      FINPOUR"
"IHSUPPDIM";"S";"0437";"*"
"IHSUPPDIM";"S";"0438";"      SI LOCA_CONSO = 1"
"IHSUPPDIM";"S";"0439";"         SI HJOU_IJRSHSMREH < 0"
"IHSUPPDIM";"S";"0440";"            ANOMALIE 226"
"IHSUPPDIM";"S";"0441";"            TEMP_CNRETOUR = 2"
"IHSUPPDIM";"S";"0442";"            TEMP_CNMESS = 226"
"IHSUPPDIM";"S";"0443";"         FINSI"
"IHSUPPDIM";"S";"0444";"      FINSI"
"IHSUPPDIM";"S";"0445";"   FINSI"
"IHSUPPDIM";"S";"0446";"**"
"IHSUPPDIM";"S";"0447";"** Soldes previsionnels"
"IHSUPPDIM";"S";"0448";"**"
"IHSUPPDIM";"S";"0449";"   SI CTRA_DATFIN > TEMP_DATJOU"
"IHSUPPDIM";"S";"0450";"      SI CTRA_DATFIN < LOCA_DATEFU"
"IHSUPPDIM";"S";"0451";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHSUPPDIM";"S";"0452";"         LOCA_DATEFU = TEMP_DXFINPER"
"IHSUPPDIM";"S";"0453";"      SINON"
"IHSUPPDIM";"S";"0454";"         SI CTRA_DATFIN < LOCA_DATEFU2"
"IHSUPPDIM";"S";"0455";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHSUPPDIM";"S";"0456";"            LOCA_DATEFU2 = TEMP_DXFINPER"
"IHSUPPDIM";"S";"0457";"         FINSI"
"IHSUPPDIM";"S";"0458";"      FINSI"
"IHSUPPDIM";"S";"0459";"   FINSI"
"IHSUPPDIM";"S";"0460";"***"
"IHSUPPDIM";"S";"0461";"   SI TEMP_DATSUI = LOCA_DATEFU"
"IHSUPPDIM";"S";"0462";"      EMPL_IEQSHSMRE1 = HJOU_IJRSHSMREH"
"IHSUPPDIM";"S";"0463";"   FINSI"
"IHSUPPDIM";"S";"0464";"**"
"IHSUPPDIM";"S";"0465";"   SI TEMP_DATSUI = LOCA_DATEFU2"
"IHSUPPDIM";"S";"0466";"      EMPL_IEQSHSMRE2 = HJOU_IJRSHSMREH"
"IHSUPPDIM";"S";"0467";"   FINSI"
"IHSUPPDIM";"S";"0468";"FINSI"
"IHSUPPDIM";"S";"0469";"*"
"IHSUPPDIM";"S";"0470";"FIN"
