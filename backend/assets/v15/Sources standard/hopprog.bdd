"ICONSCPSCH";"S";"0094";"LOCA_CPR = 0"
"ICONSCPSCH";"S";"0095";"DEF LOCA_CP N3.1"
"ICONSCPSCH";"S";"0096";"LOCA_CP = 0"
"ICONSCPSCH";"S";"0097";"DEF LOCA_CPA N3.1"
"ICONSCPSCH";"S";"0098";"LOCA_CPA = 0"
"ICONSCPSCH";"S";"0099";"DEF LOCA_CPAN N3.1"
"ICONSCPSCH";"S";"0100";"LOCA_CPAN = 0"
"ICONSCPSCH";"S";"0101";"DEF LOCA_VALCPR A1"
"ICONSCPSCH";"S";"0102";"LOCA_VALCPR = "" """
