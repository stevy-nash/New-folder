"IGCSEGLISS";"S";"0473";"      SI HJOU_DATE(7:2) = ""01"""
"IGCSEGLISS";"S";"0474";"         SI HJOU_IJRADCSE > LOCA_DTMAX"
"IGCSEGLISS";"S";"0475";"            ANOMALIE 218"
"IGCSEGLISS";"S";"0476";"         FINSI"
"IGCSEGLISS";"S";"0477";"      FINSI"
"IGCSEGLISS";"S";"0478";"      LOCA_DTMAX = LOCA_DTMAX / 12"
"IGCSEGLISS";"S";"0479";"* --------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0480";"* LOCA_MENS : on affiche l'anomalie que s'il y a une consigne sur la journée"
"IGCSEGLISS";"S";"0481";"* --------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0482";"      SI LOCA_MENS = 1"
"IGCSEGLISS";"S";"0483";"         LOCA_DRPR = HJOU_IJRMDCSE - HJOU_IJRMPCSE"
"IGCSEGLISS";"S";"0484";"         SI HJOU_IJRMDCSE > LOCA_DTMAX"
"IGCSEGLISS";"S";"0485";"         OU LOCA_DRPR > LOCA_DTMAX"
"IGCSEGLISS";"S";"0486";"            ANOMALIE 216"
"IGCSEGLISS";"S";"0487";"         FINSI"
"IGCSEGLISS";"S";"0488";"      SINON"
"IGCSEGLISS";"S";"0489";"         SI LOCA_CONSO = 1"
"IGCSEGLISS";"S";"0490";"*Anomalie en cas de dépassement du droit mensuel"
"IGCSEGLISS";"S";"0491";"            SI HJOU_IJRCUPMCSE > LOCA_MAXM"
"IGCSEGLISS";"S";"0492";"               ANOMALIE 216"
"IGCSEGLISS";"S";"0493";"            FINSI"
"IGCSEGLISS";"S";"0494";"         FINSI"
"IGCSEGLISS";"S";"0495";"      FINSI"
"IGCSEGLISS";"S";"0496";"   SINON"
"IGCSEGLISS";"S";"0497";"* ------------"
"IGCSEGLISS";"S";"0498";"* Forfait jour"
"IGCSEGLISS";"S";"0499";"* ------------"
"IGCSEGLISS";"S";"0500";"* la période retenue est la période d'annualisation"
"IGCSEGLISS";"S";"0501";"      SI HJOU_DATE = PARD_IDIDDEBANN"
"IGCSEGLISS";"S";"0502";"         FAIRE RAZCSE"
"IGCSEGLISS";"S";"0503";"      FINSI"
"IGCSEGLISS";"S";"0504";"* -----------------------"
"IGCSEGLISS";"S";"0505";"* Initialisation du droit : calcul du nombre de jours pour les forfaits jour."
"IGCSEGLISS";"S";"0506";"* -----------------------"
"IGCSEGLISS";"S";"0507";"      SI HJOU_IJRADCSEF = 0"
"IGCSEGLISS";"S";"0508";"         SI HJOU_IJIDACSET > 0"
"IGCSEGLISS";"S";"0509";"* ---------------------------------"
"IGCSEGLISS";"S";"0510";"* Arrondi du droit au 0.5 supérieur"
"IGCSEGLISS";"S";"0511";"* ---------------------------------"
"IGCSEGLISS";"S";"0512";"            LOCA_DROIT = HJOU_IJIDACSET / LOCA_DIV"
"IGCSEGLISS";"S";"0513";"            FAIRE CALCFJ"
"IGCSEGLISS";"S";"0514";"            HJOU_IJRADCSEF = LOCA_DROIT"
"IGCSEGLISS";"S";"0515";"            LOCA_DROIT = 0"
"IGCSEGLISS";"S";"0516";"         FINSI"
"IGCSEGLISS";"S";"0517";"      FINSI"
"IGCSEGLISS";"S";"0518";"* -------------------"
"IGCSEGLISS";"S";"0519";"* Motifs et activités"
"IGCSEGLISS";"S";"0520";"* -------------------"
"IGCSEGLISS";"S";"0521";"      POUR ACTIVITES"
"IGCSEGLISS";"S";"0522";"         SI HABS_MOTIF = ""DECSE"""
"IGCSEGLISS";"S";"0523";"         OU HABS_MOTIF = ""DECSEB"""
"IGCSEGLISS";"S";"0524";"            SI HABS_VALORIS = ""J"""
"IGCSEGLISS";"S";"0525";"               HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 1"
"IGCSEGLISS";"S";"0526";"            SINON"
"IGCSEGLISS";"S";"0527";"               SI HABS_VALORIS = ""A"""
"IGCSEGLISS";"S";"0528";"               OU HABS_VALORIS = ""M"""
"IGCSEGLISS";"S";"0529";"                  HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 0.5"
"IGCSEGLISS";"S";"0530";"               SINON"
"IGCSEGLISS";"S";"0531";"                  ANOMALIE 221"
"IGCSEGLISS";"S";"0532";"                  SI HABS_MOTIDUR > 4"
"IGCSEGLISS";"S";"0533";"                     HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 1"
"IGCSEGLISS";"S";"0534";"                  SINON"
"IGCSEGLISS";"S";"0535";"                     HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + 0.5"
"IGCSEGLISS";"S";"0536";"                  FINSI"
"IGCSEGLISS";"S";"0537";"               FINSI"
"IGCSEGLISS";"S";"0538";"            FINSI"
"IGCSEGLISS";"S";"0539";"         FINSI"
"IGCSEGLISS";"S";"0540";"* -----------------"
"IGCSEGLISS";"S";"0541";"* Droit CSE mensuel"
"IGCSEGLISS";"S";"0542";"* -----------------"
"IGCSEGLISS";"S";"0543";"         SI HABS_MOTIF = ""ZDCSE"""
"IGCSEGLISS";"S";"0544";"            LOCA_MENSJ = 1"
"IGCSEGLISS";"S";"0545";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IGCSEGLISS";"S";"0546";"            FAIRE CALCFJ"
"IGCSEGLISS";"S";"0547";"            HJOU_IJRADCSEF = LOCA_DROIT"
"IGCSEGLISS";"S";"0548";"            LOCA_DROIT = 0"
"IGCSEGLISS";"S";"0549";"         FINSI"
"IGCSEGLISS";"S";"0550";"         SI HABS_MOTIF = ""XDCSE"""
"IGCSEGLISS";"S";"0551";"            LOCA_MENSJ = 1"
"IGCSEGLISS";"S";"0552";"            LOCA_MAJD = LOCA_MAJD + HABS_MOTIDUR"
"IGCSEGLISS";"S";"0553";"         FINSI"
"IGCSEGLISS";"S";"0554";"* ----------------"
"IGCSEGLISS";"S";"0555";"* Pris CSE mensuel"
"IGCSEGLISS";"S";"0556";"* ----------------"
"IGCSEGLISS";"S";"0557";"         SI HABS_MOTIF = ""ZPCSE"""
"IGCSEGLISS";"S";"0558";"            LOCA_MENSJ = 1"
"IGCSEGLISS";"S";"0559";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IGCSEGLISS";"S";"0560";"            FAIRE CALCFJ"
"IGCSEGLISS";"S";"0561";"            HJOU_IJRAPCSEF = LOCA_DROIT"
"IGCSEGLISS";"S";"0562";"         FINSI"
"IGCSEGLISS";"S";"0563";"         SI HABS_MOTIF = ""XPCSE"""
"IGCSEGLISS";"S";"0564";"            LOCA_MENSJ = 1"
"IGCSEGLISS";"S";"0565";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IGCSEGLISS";"S";"0566";"            FAIRE CALCFJ"
"IGCSEGLISS";"S";"0567";"            HJOU_IJRAPCSEF = HJOU_IJRAPCSEF + LOCA_DROIT"
"IGCSEGLISS";"S";"0568";"         FINSI"
"IGCSEGLISS";"S";"0569";"* ----------------"
"IGCSEGLISS";"S";"0570";"* Transfert CSE mensuel"
"IGCSEGLISS";"S";"0571";"* ----------------"
"IGCSEGLISS";"S";"0572";"         SI HABS_MOTIF = ""ZTCSE"""
"IGCSEGLISS";"S";"0573";"            LOCA_MENSJ = 1"
"IGCSEGLISS";"S";"0574";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IGCSEGLISS";"S";"0575";"            FAIRE CALCFJ"
"IGCSEGLISS";"S";"0576";"            HJOU_IJRATCSEF = LOCA_DROIT"
"IGCSEGLISS";"S";"0577";"         FINSI"
"IGCSEGLISS";"S";"0578";"         SI HABS_MOTIF = ""XTCSE"""
"IGCSEGLISS";"S";"0579";"            LOCA_MENSJ = 1"
"IGCSEGLISS";"S";"0580";"            LOCA_DROIT = HABS_MOTIDUR / LOCA_DIV"
"IGCSEGLISS";"S";"0581";"            FAIRE CALCFJ"
"IGCSEGLISS";"S";"0582";"            HJOU_IJRATCSEF = HJOU_IJRATCSEF + LOCA_DROIT"
"IGCSEGLISS";"S";"0583";"         FINSI"
"IGCSEGLISS";"S";"0584";"* -----------------------------"
"IGCSEGLISS";"S";"0585";"* Motif de demande de transfert"
"IGCSEGLISS";"S";"0586";"* -----------------------------"
"IGCSEGLISS";"S";"0587";"         SI HABS_MOTYPE = ""C"""
"IGCSEGLISS";"S";"0588";"            SI MOTI_IMIMATRICS <> "" """
"IGCSEGLISS";"S";"0589";"               LOCA_MAJT = LOCA_MAJT - HABS_MOTIDUR"
"IGCSEGLISS";"S";"0590";"               SI MOTI_IMIMATRICS = HJOU_MATRI"
"IGCSEGLISS";"S";"0591";"                  ANOMALIE 220"
"IGCSEGLISS";"S";"0592";"               FINSI"
"IGCSEGLISS";"S";"0593";"            FINSI"
"IGCSEGLISS";"S";"0594";"         FINSI"
"IGCSEGLISS";"S";"0595";"      FINPOUR"
"IGCSEGLISS";"S";"0596";"* ----------------------------"
"IGCSEGLISS";"S";"0597";"* Cumul des XDCSE sur le droit"
"IGCSEGLISS";"S";"0598";"* ----------------------------"
"IGCSEGLISS";"S";"0599";"      LOCA_DROIT = LOCA_MAJD / LOCA_DIV"
"IGCSEGLISS";"S";"0600";"      SI LOCA_DROIT > 0"
"IGCSEGLISS";"S";"0601";"         FAIRE CALCFJ"
"IGCSEGLISS";"S";"0602";"         HJOU_IJRADCSEF = HJOU_IJRADCSEF + LOCA_DROIT"
"IGCSEGLISS";"S";"0603";"      FINSI"
"IGCSEGLISS";"S";"0604";"      LOCA_MAJD = 0"
"IGCSEGLISS";"S";"0605";"* --------------------"
"IGCSEGLISS";"S";"0606";"* Cumul des transferts"
"IGCSEGLISS";"S";"0607";"* --------------------"
"IGCSEGLISS";"S";"0608";"      LOCA_DROIT = LOCA_MAJT / LOCA_DIV"
"IGCSEGLISS";"S";"0609";"* En cas de droit négatif"
"IGCSEGLISS";"S";"0610";"      SI LOCA_DROIT < 0"
"IGCSEGLISS";"S";"0611";"         LOCA_DROIT = LOCA_DROIT * LOCA_MOINS1"
"IGCSEGLISS";"S";"0612";"      FINSI"
"IGCSEGLISS";"S";"0613";"*"
"IGCSEGLISS";"S";"0614";"      SI LOCA_DROIT > 0"
"IGCSEGLISS";"S";"0615";"         FAIRE CALCFJ"
"IGCSEGLISS";"S";"0616";"         HJOU_IJRATCSEF = HJOU_IJRATCSEF - LOCA_DROIT"
"IGCSEGLISS";"S";"0617";"      FINSI"
"IGCSEGLISS";"S";"0618";"      LOCA_MAJT = 0"
"IGCSEGLISS";"S";"0619";"* ----------------------"
"IGCSEGLISS";"S";"0620";"* Mise à jour des soldes"
"IGCSEGLISS";"S";"0621";"* ----------------------"
"IGCSEGLISS";"S";"0622";"      HJOU_IJRASCSEF = HJOU_IJRADCSEF - HJOU_IJRAPCSEF"
"IGCSEGLISS";"S";"0623";"      HJOU_IJRASCSEF = HJOU_IJRASCSEF + HJOU_IJRATCSEF"
"IGCSEGLISS";"S";"0624";"* ----------------------------------------"
"IGCSEGLISS";"S";"0625";"* Gestion des anomalies"
"IGCSEGLISS";"S";"0626";"* ----------------------------------------"
"IGCSEGLISS";"S";"0627";"      LOCA_DTMAX = HJOU_IJIDACSEM * LOCA_TAUX"
"IGCSEGLISS";"S";"0628";"      LOCA_DROIT = LOCA_DTMAX / LOCA_DIV"
"IGCSEGLISS";"S";"0629";"      LOCA_DROIT = LOCA_DROIT / 8"
"IGCSEGLISS";"S";"0630";"      SI HJOU_DATE(7:2) = ""01"""
"IGCSEGLISS";"S";"0631";"         SI HJOU_IJRADCSEF > LOCA_DROIT"
"IGCSEGLISS";"S";"0632";"            ANOMALIE 218"
"IGCSEGLISS";"S";"0633";"         FINSI"
"IGCSEGLISS";"S";"0634";"      FINSI"
"IGCSEGLISS";"S";"0635";"*"
"IGCSEGLISS";"S";"0636";"      SI LOCA_MENSJ = 1"
"IGCSEGLISS";"S";"0637";"         SI HJOU_IJRADCSEF > LOCA_DROIT"
"IGCSEGLISS";"S";"0638";"         OU HJOU_IJRASCSEF > LOCA_DROIT"
"IGCSEGLISS";"S";"0639";"            ANOMALIE 218"
"IGCSEGLISS";"S";"0640";"         FINSI"
"IGCSEGLISS";"S";"0641";"      FINSI"
"IGCSEGLISS";"S";"0642";"      SI HJOU_IJRASCSE < 0"
"IGCSEGLISS";"S";"0643";"      OU HJOU_IJRASCSEF < 0"
"IGCSEGLISS";"S";"0644";"         ANOMALIE 217"
"IGCSEGLISS";"S";"0645";"      FINSI"
"IGCSEGLISS";"S";"0646";"   FINSI"
"IGCSEGLISS";"S";"0647";"SINON"
"IGCSEGLISS";"S";"0648";"* -------------------------------------------------------"
"IGCSEGLISS";"S";"0649";"* RAZ des droits au lendemain de la date de fin de mandat"
"IGCSEGLISS";"S";"0650";"* -------------------------------------------------------"
"IGCSEGLISS";"S";"0651";"   LIREVALPRE LOCA_DATEFIN HJOU_DATE"
"IGCSEGLISS";"S";"0652";"   *************************************************"
"IGCSEGLISS";"S";"0653";"   *************************************************"
"IGCSEGLISS";"S";"0654";"   * En cas d'ancienne version où le LIREVALPRE ne"
"IGCSEGLISS";"S";"0655";"   * fonctionne pas (Nouveautés 5.2.0)"
"IGCSEGLISS";"S";"0656";"   * Utiliser le réglementaire suivant :"
"IGCSEGLISS";"S";"0657";"   *"
"IGCSEGLISS";"S";"0658";"   * DATAJT HJOU_DATE 12 ""J"" -1"
"IGCSEGLISS";"S";"0659";"   * LOCA_DATEFIN = TEMP_DXFINPER"
"IGCSEGLISS";"S";"0660";"   *************************************************"
"IGCSEGLISS";"S";"0661";"   *************************************************"
"IGCSEGLISS";"S";"0662";"   SI LOCA_DATEFIN = HJOU_IJIDFIN"
"IGCSEGLISS";"S";"0663";"      FAIRE RAZCSE"
"IGCSEGLISS";"S";"0664";"   FINSI"
"IGCSEGLISS";"S";"0665";"FINSI"
"IGCSEGLISS";"S";"0666";"* -------------------------------------------------------"
"IGCSEGLISS";"S";"0667";"* anomalie si le droit + transfert dépasse le maximum mensuel"
"IGCSEGLISS";"S";"0668";"* -------------------------------------------------------"
"IGCSEGLISS";"S";"0669";"* Déclenchement en cas d'un trop grand nombre d'heures reçues"
"IGCSEGLISS";"S";"0670";"* via une consigne de transfert"
"IGCSEGLISS";"S";"0671";"SI LOCA_MENS2 = 1"
"IGCSEGLISS";"S";"0672";"   LOCA_DRTR = HJOU_IJRMDCSE + HJOU_IJRMTCSE"
"IGCSEGLISS";"S";"0673";"   SI LOCA_DRTR > LOCA_MAXM"
"IGCSEGLISS";"S";"0674";"      ANOMALIE 401"
"IGCSEGLISS";"S";"0675";"   FINSI"
"IGCSEGLISS";"S";"0676";"FINSI"
"IGCSEGLISS";"S";"0677";"* ----------------------"
"IGCSEGLISS";"S";"0678";"* Calcul du prévisionnel"
"IGCSEGLISS";"S";"0679";"* ----------------------"
"IGCSEGLISS";"S";"0680";"SI TEMP_DATSUI = LOCA_DATE"
"IGCSEGLISS";"S";"0681";"* Forfait heure"
"IGCSEGLISS";"S";"0682";"   SI HORC_IHINFORFJ <> ""1"""
"IGCSEGLISS";"S";"0683";"      EMPL_IEQSDELCSE = HJOU_IJRASCSE"
"IGCSEGLISS";"S";"0684";"   SINON"
"IGCSEGLISS";"S";"0685";"* Forfait jour"
"IGCSEGLISS";"S";"0686";"      EMPL_IEQSDELCSE = HJOU_IJRASCSEF * 8"
"IGCSEGLISS";"S";"0687";"   FINSI"
"IGCSEGLISS";"S";"0688";"FINSI"
"IGCSEGLISS";"S";"0689";"* ----------"
"IGCSEGLISS";"S";"0690";"* Simulation"
"IGCSEGLISS";"S";"0691";"* ----------"
"IGCSEGLISS";"S";"0692";"DEF CPTG_SOLDECSE T6.2"
"IGCSEGLISS";"S";"0693";"PERGLISS CPTG_SOLDECSE ""060J01"""
"IGCSEGLISS";"S";"0694";"POUR ACTIVITES"
"IGCSEGLISS";"S";"0695";"   SI MOTI_IMIMATRICS <> "" """
"IGCSEGLISS";"S";"0696";"      LOCA_MAT = MOTI_IMIMATRICS"
"IGCSEGLISS";"S";"0697";"      LOCA_MAJD = HABS_MOTIDUR"
"IGCSEGLISS";"S";"0698";"      LOCA_VALO = HABS_VALORIS"
"IGCSEGLISS";"S";"0699";"   FINSI"
"IGCSEGLISS";"S";"0700";"FINPOUR"
"IGECET";"S";"0011";"* Version  : 1"
"IGCSEGLISS";"S";"0701";"* --------------------------------------------------"
"IGCSEGLISS";"S";"0702";"* Blocage si l'on se transmets des droits a soi-même"
"IGCSEGLISS";"S";"0703";"* --------------------------------------------------"
"IGCSEGLISS";"S";"0704";"SI LOCA_MAT = HJOU_MATRI"
"IGCSEGLISS";"S";"0705";"   TEMP_CNRETOUR = 2"
"IGCSEGLISS";"S";"0706";"   TEMP_CNMESS = 220"
"IGCSEGLISS";"S";"0707";"FINSI"
"IGCSEGLISS";"S";"0708";"* ---------------------------------------"
"IGCSEGLISS";"S";"0709";"* Contrôles spécifiques aux forfaits jour"
"IGCSEGLISS";"S";"0710";"* ---------------------------------------"
"IGCSEGLISS";"S";"0711";"SI HORC_IHINFORFJ = ""1"""
"IGCSEGLISS";"S";"0712";"*"
"IGCSEGLISS";"S";"0713";"* Ils ne peuvent transférer que l'équivalent de jours / demi-journées (multiples de 4)"
"IGCSEGLISS";"S";"0714";"   SI LOCA_MAJD > 0"
"IGCSEGLISS";"S";"0715";"      LOCA_DROIT = LOCA_MAJD / LOCA_DIV"
"IGCSEGLISS";"S";"0716";"      LOCA_RESTE = LOCA_DROIT % 4"
"IGCSEGLISS";"S";"0717";"      SI LOCA_RESTE > 0"
"IGCSEGLISS";"S";"0718";"         TEMP_CNRETOUR = 2"
"IGCSEGLISS";"S";"0719";"         TEMP_CNMESS = 219"
"IGCSEGLISS";"S";"0720";"      FINSI"
"IGCSEGLISS";"S";"0721";"   FINSI"
"IGCSEGLISS";"S";"0722";"* ----------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0723";"* Les forfaits jours ne posent que des délégations en journées ou 1/2 journées"
"IGCSEGLISS";"S";"0724";"* ----------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0725";"   SI LOCA_VALO = ""H"""
"IGCSEGLISS";"S";"0726";"      SI LOCA_MAT = "" """
"IGCSEGLISS";"S";"0727";"         TEMP_CNRETOUR = 2"
"IGCSEGLISS";"S";"0728";"         TEMP_CNMESS = 221"
"IGCSEGLISS";"S";"0729";"      FINSI"
"IGCSEGLISS";"S";"0730";"   FINSI"
"IGCSEGLISS";"S";"0731";"FINSI"
"IGCSEGLISS";"S";"0732";"* ---------"
"IGCSEGLISS";"S";"0733";"FIN"
"IGCSEGLISS";"S";"0734";"PROC RAZCSE"
"IGCSEGLISS";"S";"0735";"   HJOU_IJRADCSE = 0"
"IGCSEGLISS";"S";"0736";"   HJOU_IJRAPCSE = 0"
"IGCSEGLISS";"S";"0737";"   HJOU_IJRATCSE = 0"
"IGCSEGLISS";"S";"0738";"   HJOU_IJRASCSE = 0"
"IGCSEGLISS";"S";"0739";"   HJOU_IJRMDCSE = 0"
"IGCSEGLISS";"S";"0740";"   HJOU_IJRMPCSE = 0"
"IGCSEGLISS";"S";"0741";"   HJOU_IJRMTCSE = 0"
"IGCSEGLISS";"S";"0742";"   HJOU_IJRMSCSE = 0"
"IGCSEGLISS";"S";"0743";"   HJOU_IJRADCSEF = 0"
"IGCSEGLISS";"S";"0744";"   HJOU_IJRAPCSEF = 0"
"IGCSEGLISS";"S";"0745";"   HJOU_IJRATCSEF = 0"
"IGCSEGLISS";"S";"0746";"   HJOU_IJRASCSEF = 0"
"IGCSEGLISS";"S";"0747";"*Compteurs glissants RAZ"
"IGCSEGLISS";"S";"0748";"   HJOU_IJRMDCSE11 = 0"
"IGCSEGLISS";"S";"0749";"   HJOU_IJRMDCSE10 = 0"
"IGCSEGLISS";"S";"0750";"   HJOU_IJRMDCSE9 = 0"
"IGCSEGLISS";"S";"0751";"   HJOU_IJRMDCSE8 = 0"
"IGCSEGLISS";"S";"0752";"   HJOU_IJRMDCSE7 = 0"
"IGCSEGLISS";"S";"0753";"   HJOU_IJRMDCSE6 = 0"
"IGCSEGLISS";"S";"0754";"   HJOU_IJRMDCSE5 = 0"
"IGCSEGLISS";"S";"0755";"   HJOU_IJRMDCSE4 = 0"
"IGCSEGLISS";"S";"0756";"   HJOU_IJRMDCSE3 = 0"
"IGCSEGLISS";"S";"0757";"   HJOU_IJRMDCSE2 = 0"
"IGCSEGLISS";"S";"0758";"   HJOU_IJRMDCSE1 = 0"
"IGCSEGLISS";"S";"0759";"*RAZ du cumul pris mensuel"
"IGCSEGLISS";"S";"0760";"   HJOU_IJRCUPMCSE = 0"
"IGCSEGLISS";"S";"0761";"FINPROC"
"IGCSEGLISS";"S";"0762";"* -------------------------------------------"
"IGCSEGLISS";"S";"0763";"* Procédure de calcul des droits forfait jour"
"IGCSEGLISS";"S";"0764";"* -------------------------------------------"
"IGCSEGLISS";"S";"0765";"PROC CALCFJ"
"IGCSEGLISS";"S";"0766";"* --------------------------------------"
"IGCSEGLISS";"S";"0767";"* Durée fixe pour les forfaits jour : 8h"
"IGCSEGLISS";"S";"0768";"* --------------------------------------"
"IGCSEGLISS";"S";"0769";"   LOCA_DROIT = LOCA_DROIT / 8"
"IGCSEGLISS";"S";"0770";"   LOCA_RESTE = LOCA_DROIT % 1"
"IGCSEGLISS";"S";"0771";"   LOCA_DROIT = LOCA_DROIT - LOCA_RESTE"
"IGCSEGLISS";"S";"0772";"   SI LOCA_RESTE > 0"
"IGCSEGLISS";"S";"0773";"      SI LOCA_RESTE < 0.5"
"IGCSEGLISS";"S";"0774";"* -------------------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0775";"* Gestion des arrondis :"
"IGCSEGLISS";"S";"0776";"* si l'on est dans le cas d'un transfert, on majore à la 1/2 journée supérieure"
"IGCSEGLISS";"S";"0777";"* si l'on est dans le cas d'une consigne de MAJ de droit, on minore à la 1/2 inférieure"
"IGCSEGLISS";"S";"0778";"* -------------------------------------------------------------------------------------"
"IGCSEGLISS";"S";"0779";"         SI LOCA_MAJD = 0"
"IGCSEGLISS";"S";"0780";"            LOCA_DROIT = LOCA_DROIT + 0.5"
"IGCSEGLISS";"S";"0781";"         FINSI"
"IGCSEGLISS";"S";"0782";"         ANOMALIE 219"
"IGCSEGLISS";"S";"0783";"      SINON"
"IGCSEGLISS";"S";"0784";"         SI LOCA_RESTE = 0.5"
"IGCSEGLISS";"S";"0785";"            LOCA_DROIT = LOCA_DROIT + 0.5"
"IGCSEGLISS";"S";"0786";"         SINON"
"IGCSEGLISS";"S";"0787";"            SI LOCA_MAJD = 0"
"IGCSEGLISS";"S";"0788";"               LOCA_DROIT = LOCA_DROIT + 1"
"IGCSEGLISS";"S";"0789";"            FINSI"
"IGCSEGLISS";"S";"0790";"            ANOMALIE 219"
"IGCSEGLISS";"S";"0791";"         FINSI"
"IGCSEGLISS";"S";"0792";"      FINSI"
"IGCSEGLISS";"S";"0793";"   FINSI"
"IGCSEGLISS";"S";"0794";"FINPROC"
"IGECET";"S";"0001";"***********************************************************************"
"IGECET";"S";"0002";"*"
"IGECET";"S";"0003";"* Règle : IGECET"
"IGECET";"S";"0004";"* Ordre : 6160"
"IGECET";"S";"0005";"* Titre : Gestion du CET"
"IGECET";"S";"0006";"*"
"IGECET";"S";"0007";"*----------------------------------------------------------------------"
"IGECET";"S";"0008";"*"
"IGECET";"S";"0009";"* Créé par : Cellule Industrialisation"
"IGECET";"S";"0010";"* Date     : 03/09/2009"
"IGECET";"S";"0012";"*"
"IGECET";"S";"0013";"*----------------------------------------------------------------------"
"IGECET";"S";"0014";"*"
"IGECET";"S";"0015";"*"
"IGECET";"S";"0016";"* Rôle : Gestion du CET"
"IGECET";"S";"0017";"*"
"IGECET";"S";"0018";"*"
"IGECET";"S";"0019";"*----------------------------------------------------------------------"
"IGECET";"S";"0020";"*"
"IGECET";"S";"0021";"* Modifiée par : Méthodes et outils"
"IGECET";"S";"0022";"* Date         : 25/10/2019"
"IGECET";"S";"0023";"* Objet        : Ajout de la gestion du transfert CSUP en CET"
"IGECET";"S";"0024";"*"
"IGECET";"S";"0025";"***********************************************************************"
"IGECET";"S";"0026";"*"
"IGECET";"S";"0027";"* Implémentation des données industrielles"
"IGECET";"S";"0028";"*"
"IGECET";"S";"0029";"DEBDICO"
"IGECET";"S";"0030";"   HJOU_IJRSOLDCET;N;N6,1;L;;;    56789;;IJRSOLDCET;V3;""Solde CET"";"
"IGECET";"S";"0031";"   HJOU_IJRSCPCET;N;N6,1;L;;;    56789;;IJRSCPCET;V3;""Solde CET au titre des congés payés"";"
"IGECET";"S";"0032";"   EMPL_IEQSPRJCET;N;N6,1;I;;;     6789;;;V3;""Solde prévisionnel CET en jour"";"
"IGECET";"S";"0033";"FINDICO"
"IGECET";"S";"0034";"*"
"IGECET";"S";"0035";"DEBANO"
"IGECET";"S";"0036";"   157;8;""Solde CET insuffisant"";"
"IGECET";"S";"0037";"FINANO"
"IGECET";"S";"0038";"* Déclaration des donnees locales"
"IGECET";"S";"0039";"*"
"IGECET";"S";"0040";"DEF LOCA_VAL N2.1"
"IGECET";"S";"0041";"LOCA_VAL = 0"
"IGECET";"S";"0042";"* alimentation par consignes"
"IGECET";"S";"0043";"*"
"IGECET";"S";"0044";"* Consignes Standard"
"IGECET";"S";"0045";"POUR ACTIVITES"
"IGECET";"S";"0046";"* Consignes Standard"
"IGECET";"S";"0047";"   SI HABS_MOTIF = ""XDCET"""
"IGECET";"S";"0048";"      HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0049";"   FINSI"
"IGECET";"S";"0050";"   SI HABS_MOTIF = ""ZDCET"""
"IGECET";"S";"0051";"      HJOU_IJRSOLDCET = HABS_MOTINBR"
"IGECET";"S";"0052";"   FINSI"
"IGECET";"S";"0053";"   SI HABS_MOTIF = ""XDCPCET"""
"IGECET";"S";"0054";"      HJOU_IJRSCPCET = HJOU_IJRSCPCET + HABS_MOTINBR"
"IGECET";"S";"0055";"      HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0056";"   FINSI"
"IGECET";"S";"0057";"   SI HABS_MOTIF = ""ZDCPCET"""
"IGECET";"S";"0058";"      HJOU_IJRSOLDCET = HJOU_IJRSOLDCET - HJOU_IJRSCPCET"
"IGECET";"S";"0059";"      HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0060";"      HJOU_IJRSCPCET = HABS_MOTINBR"
"IGECET";"S";"0061";"   FINSI"
"IGECET";"S";"0062";"** transfert de CET en don absence"
"IGECET";"S";"0063";"   SI HABS_MOTIF = ""YCETDON"""
"IGECET";"S";"0064";"      SI HABS_MOTINBR <= HJOU_IJRSOLDCET"
"IGECET";"S";"0065";"         HJOU_IJRSOLDCET = HJOU_IJRSOLDCET - HABS_MOTINBR"
"IGECET";"S";"0066";"      SINON"
"IGECET";"S";"0067";"* solde CET insuffisant pour transfert en don absence"
"IGECET";"S";"0068";"         ANOMALIE 191"
"IGECET";"S";"0069";"      FINSI"
"IGECET";"S";"0070";"   FINSI"
"IGECET";"S";"0071";"*"
"IGECET";"S";"0072";"* Transfert de CP en CET"
"IGECET";"S";"0073";"   SI HABS_MOTIF = ""YCPCET"""
"IGECET";"S";"0074";"      SI TEMP_ITQTRCPCET <> 1"
"IGECET";"S";"0075";"         HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0076";"         HJOU_IJRSCPCET = HJOU_IJRSCPCET + HABS_MOTINBR"
"IGECET";"S";"0077";"      FINSI"
"IGECET";"S";"0078";"   FINSI"
"IGECET";"S";"0079";"* Transfert de CP ancienneté en CET"
"IGECET";"S";"0080";"   SI HABS_MOTIF = ""YCACET"""
"IGECET";"S";"0081";"      SI TEMP_ITQTRCACET <> 1"
"IGECET";"S";"0082";"         HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0083";"      FINSI"
"IGECET";"S";"0084";"   FINSI"
"IGECET";"S";"0085";"* Transfert de CP fractionnement en CET"
"IGECET";"S";"0086";"   SI HABS_MOTIF = ""YCFCET"""
"IGECET";"S";"0087";"      SI TEMP_ITQTRCFCET <> 1"
"IGECET";"S";"0088";"         HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0089";"      FINSI"
"IGECET";"S";"0090";"   FINSI"
"IGECET";"S";"0091";"   *************************************************************************************************"
"IGECET";"S";"0092";"   ****************************************** Transfert de CSUP en CET *****************************"
"IGECET";"S";"0093";"   *************************************************************************************************"
"IGECET";"S";"0094";"   *** En cas de gestion du congé supplémentaire avec la possibilité de transfert en CET,"
"IGECET";"S";"0095";"   *** il faudra décommenter le test si dessous"
"IGECET";"S";"0096";"  * SI HABS_MOTIF = ""YCSCET"""
"IGECET";"S";"0097";"  *    SI TEMP_ITQTRCSCET <> 1"
"IGECET";"S";"0098";"  *       HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0099";"  *    FINSI"
"IGECET";"S";"0100";"  * FINSI"
"IGECET";"S";"0101";"   *************************************************************************************************"
"IGECET";"S";"0102";"   *************************************************************************************************"
"IGECET";"S";"0103";"   *************************************************************************************************"
"IGECET";"S";"0104";"* Transfert de RTT en jour en CET"
"IGECET";"S";"0105";"   SI HABS_MOTIF = ""YRTCET"""
"IGECET";"S";"0106";"      HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0107";"   FINSI"
"IGECET";"S";"0108";"* consigne lié au RTT en heures"
"IGECET";"S";"0109";"   SI HABS_MOTIF = ""XRHCET"""
"IGECET";"S";"0110";"      HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0111";"   FINSI"
"IGECET";"S";"0112";"* consigne liée aux RC"
"IGECET";"S";"0113";"   SI HABS_MOTIF = ""XRCCET"""
"IGECET";"S";"0114";"      HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0115";"   FINSI"
"IGECET";"S";"0116";"* consigne Liée au HS"
"IGECET";"S";"0117";"   SI HABS_MOTIF = ""XHSCET"""
"IGECET";"S";"0118";"      HJOU_IJRSOLDCET = HJOU_IJRSOLDCET + HABS_MOTINBR"
"IGECET";"S";"0119";"   FINSI"
"IGECET";"S";"0120";"* consigne de paiement"
"IGECET";"S";"0121";"   SI HABS_MOTIF = ""CER"""
"IGECET";"S";"0122";"      SI HJOU_IJRSOLDCET >= HABS_MOTINBR"
"IGECET";"S";"0123";"         HJOU_IJRSOLDCET = HJOU_IJRSOLDCET - HABS_MOTINBR"
"IGECET";"S";"0124";"      SINON"
"IGECET";"S";"0125";"         ANOMALIE 157"
"IGECET";"S";"0126";"      FINSI"
"IGECET";"S";"0127";"   FINSI"
"IGECET";"S";"0128";"*"
"IGECET";"S";"0129";"FINPOUR"
"IGECET";"S";"0130";"** gestion du pris"
"IGECET";"S";"0131";"POUR ACTIVITES"
"IGECET";"S";"0132";"   SI HABS_MOTIF = ""CET"""
"IGECET";"S";"0133";"      SI HABS_VALORIS = ""J"""
"IGECET";"S";"0134";"         LOCA_VAL = 1"
"IGECET";"S";"0135";"      SINON"
"IGECET";"S";"0136";"         LOCA_VAL = 0.5"
"IGECET";"S";"0137";"      FINSI"
"IGECET";"S";"0138";"      SI HJOU_IJRSOLDCET >= LOCA_VAL"
"IGECET";"S";"0139";"         HJOU_IJRSOLDCET = HJOU_IJRSOLDCET - LOCA_VAL"
"IGECET";"S";"0140";"         HJOU_IJRSCPCET = HJOU_IJRSCPCET - LOCA_VAL"
"IGECET";"S";"0141";"         SI HJOU_IJRSCPCET < 0"
"IGECET";"S";"0142";"            HJOU_IJRSCPCET = 0"
"IGECET";"S";"0143";"         FINSI"
"IGECET";"S";"0144";"      SINON"
"IGECET";"S";"0145";"* solde insuffisant"
"IGECET";"S";"0146";"         ANOMALIE 157"
"IGECET";"S";"0147";"      FINSI"
"IGECET";"S";"0148";"   FINSI"
"IGECET";"S";"0149";"FINPOUR"
"IGECET";"S";"0150";"* alimentation du solde prévisionnel"
"IGECET";"S";"0151";"SI HJOU_DATE(1:4) = TEMP_DATJOU(1:4)"
"IGECET";"S";"0152";"   SI TEMP_DATSUI(5:4) = ""0101"""
"IGECET";"S";"0153";"      EMPL_IEQSPRJCET = HJOU_IJRSOLDCET"
"IGECET";"S";"0154";"   FINSI"
"IGECET";"S";"0155";"FINSI"
"IGECET";"S";"0156";"FIN"
"IGESRC";"S";"0001";"***********************************************************************"
"IGESRC";"S";"0002";"*"
"IGESRC";"S";"0003";"* Règle : IGESRC"
"IGESRC";"S";"0004";"* Ordre : 6110"
"IGESRC";"S";"0005";"* Titre : Gestion de la contrepartie obligatoire en repos"
"IGESRC";"S";"0006";"*"
"IGESRC";"S";"0007";"*----------------------------------------------------------------------"
"IGESRC";"S";"0008";"*"
"IGESRC";"S";"0009";"* Créé par : Cellule Industrialisation"
"IGESRC";"S";"0010";"* Date     : 03/09/2009"
"IGESRC";"S";"0011";"* Version  : 1"
"IGESRC";"S";"0012";"*"
"IGESRC";"S";"0013";"*----------------------------------------------------------------------"
"IGESRC";"S";"0014";"*"
"IGESRC";"S";"0015";"*"
"IGESRC";"S";"0016";"* Rôle : Gestion de la contrepartie obligatoire en repos (COR)"
"IGESRC";"S";"0017";"*"
"IGESRC";"S";"0018";"*"
"IGESRC";"S";"0019";"*"
"IGESRC";"S";"0020";"*----------------------------------------------------------------------"
"IGESRC";"S";"0021";"*"
"IGESRC";"S";"0022";"* Modifiée par : Méthodes et outils"
"IGESRC";"S";"0023";"* Date         : 26/10/2020"
"IGESRC";"S";"0024";"* Objet        : BT 75236 : Modification calcul du COR acquis afin de"
"IGESRC";"S";"0025";"*                 prendre en compte uniquement les heures au delà du seuil"
"IGESRC";"S";"0026";"*                 ne plus faire la somme de HS taux 1 et 2 mais prendre le"
"IGESRC";"S";"0027";"*                 cumul annuel"
"IGESRC";"S";"0028";"*"
"IGESRC";"S";"0029";"***********************************************************************"
"IGESRC";"S";"0030";"*"
"IGESRC";"S";"0031";"* Implémentation des données industrielles"
"IGESRC";"S";"0032";"*"
"IGESRC";"S";"0033";"*"
"IGESRC";"S";"0034";"DEBDICO"
"IGESRC";"S";"0035";"   HJOU_IJQARCHSMA;N;T6,2;I;;;    56789;;;V3;""COR acquis"";"
"IGESRC";"S";"0036";"   HJOU_IJRSRCHSMA;N;T8,2;L;;;     6789;;IJRSRCHSMA;V3;""Solde COR"";"
"IGESRC";"S";"0037";"   EMPL_IEQSPRCHSM;N;T6,2;I;;;     6789;;;V3;""Solde RC s/ HS majorées"";"
"IGESRC";"S";"0038";"FINDICO"
"IGESRC";"S";"0039";"*"
"IGESRC";"S";"0040";"* Déclaration des donnees locales"
"IGESRC";"S";"0041";"*"
"IGESRC";"S";"0042";"DEF LOCA_RC T6.2"
"IGESRC";"S";"0043";"LOCA_RC = 0"
"IGESRC";"S";"0044";"DEF LOCA_DATE D"
"IGESRC";"S";"0045";"LOCA_DATE = "" """
"IGESRC";"S";"0046";"DEF LOCA_ACOURS N4"
"IGESRC";"S";"0047";"LOCA_ACOURS = 0"
"IGESRC";"S";"0048";"****************"
"IGESRC";"S";"0049";"DEF LOCA_HS T6.2"
"IGESRC";"S";"0050";"LOCA_HS = 0"
"IGESRC";"S";"0051";"DEF LOCA_ACQPER T6.2"
"IGESRC";"S";"0052";"LOCA_ACQPER = 0"
"IGESRC";"S";"0053";"DEF LOCA_DIFF T6.2"
"IGESRC";"S";"0054";"LOCA_DIFF = 0"
"IGESRC";"S";"0055";"*"
"IGESRC";"S";"0056";"*  Calcul repos compensateur en prenant en compte le contingent"
"IGESRC";"S";"0057";"*  le dimanche"
"IGESRC";"S";"0058";"*"
"IGESRC";"S";"0059";"SI HJOU_JOUR = ""7"""
"IGESRC";"S";"0060";"* totalisation des HS25 HS50"
"IGESRC";"S";"0061";"   LOCA_HS = HJOU_IJQHS1MAPA + HJOU_IJQHS2MAPA"
"IGESRC";"S";"0062";"   SI LOCA_HS > 0"
"IGESRC";"S";"0063";"** si le cuml annuel HS > contingent annuel HS"
"IGESRC";"S";"0064";"      SI HJOU_IJRHSHMAJA > PARD_IDISCONTHS"
"IGESRC";"S";"0065";"         LOCA_ACQPER = HJOU_IJRHSHMAJA - PARD_IDISCONTHS"
"IGESRC";"S";"0066";"         *"
"IGESRC";"S";"0067";"         SI LOCA_HS > LOCA_ACQPER"
"IGESRC";"S";"0068";"            LOCA_DIFF = LOCA_HS - LOCA_ACQPER"
"IGESRC";"S";"0069";"            LOCA_ACQPER = LOCA_HS - LOCA_DIFF"
"IGESRC";"S";"0070";"         SINON"
"IGESRC";"S";"0071";"            LOCA_ACQPER = LOCA_HS"
"IGESRC";"S";"0072";"         FINSI"
"IGESRC";"S";"0073";"         ** entreprise de 20 salariés majoration de 50%"
"IGESRC";"S";"0074";"         SI PARD_IDIEFFECTI = ""1"""
"IGESRC";"S";"0075";"            LOCA_RC = LOCA_ACQPER / 2"
"IGESRC";"S";"0076";"         SINON"
"IGESRC";"S";"0077";"            LOCA_RC = LOCA_ACQPER"
"IGESRC";"S";"0078";"         FINSI"
"IGESRC";"S";"0079";"      FINSI"
"IGESRC";"S";"0080";"* acquis période"
"IGESRC";"S";"0081";"      HJOU_IJQARCHSMA = LOCA_RC"
"IGESRC";"S";"0082";"* Cumul annuel"
"IGESRC";"S";"0083";"      HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA + HJOU_IJQARCHSMA"
"IGESRC";"S";"0084";"*"
"IGESRC";"S";"0085";"   FINSI"
"IGESRC";"S";"0086";"FINSI"
"IGESRC";"S";"0087";"*  Déduction de l'absence RC"
"IGESRC";"S";"0088";"*  Alimentation par consignes"
"IGESRC";"S";"0089";"SI HJOU_IJIGHSUPPM <> ""0"""
"IGESRC";"S";"0090";"   POUR ACTIVITES"
"IGESRC";"S";"0091";"      SI HABS_MOTIF = PARD_IDIVMRCREC"
"IGESRC";"S";"0092";"         HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA - HABS_MOTIDUR"
"IGESRC";"S";"0093";"      FINSI"
"IGESRC";"S";"0094";"* analyse de la consigne d'initialisation de l'acquis RC"
"IGESRC";"S";"0095";"      SI HABS_MOTIF = ""ZARC"""
"IGESRC";"S";"0096";"         HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA - HJOU_IJQARCHSMA"
"IGESRC";"S";"0097";"         HJOU_IJQARCHSMA = HABS_MOTIDUR"
"IGESRC";"S";"0098";"         HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA + HJOU_IJQARCHSMA"
"IGESRC";"S";"0099";"      FINSI"
"IGESRC";"S";"0100";"* ANALYSE de la consigne de mise à jour du solde"
"IGESRC";"S";"0101";"      SI HABS_MOTIF = ""XSRC"""
"IGESRC";"S";"0102";"         HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA + HABS_MOTIDUR"
"IGESRC";"S";"0103";"      FINSI"
"IGESRC";"S";"0104";"* analyse de la consigne d'initialisation du solde"
"IGESRC";"S";"0105";"      SI HABS_MOTIF = ""ZSRC"""
"IGESRC";"S";"0106";"         HJOU_IJRSRCHSMA = HABS_MOTIDUR"
"IGESRC";"S";"0107";"      FINSI"
"IGESRC";"S";"0108";"   FINPOUR"
"IGESRC";"S";"0109";"FINSI"
"IGESRC";"S";"0110";"** Alimentation du compteur prévisionnel"
"IGESRC";"S";"0111";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IGESRC";"S";"0112";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IGESRC";"S";"0113";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IGESRC";"S";"0114";"LOCA_DATE(5:4) = ""0101"""
"IGESRC";"S";"0115";"SI TEMP_DATSUI = LOCA_DATE"
"IGESRC";"S";"0116";"   EMPL_IEQSPRCHSM = HJOU_IJRSRCHSMA"
"IGESRC";"S";"0117";"FINSI"
"IGESRC";"S";"0118";"FIN"
"IGESRCCAL";"S";"0001";"***********************************************************************"
"IGESRCCAL";"S";"0002";"*"
"IGESRCCAL";"S";"0003";"* Règle : IGESRCCAL"
"IGESRCCAL";"S";"0004";"* Ordre : 6120"
"IGESRCCAL";"S";"0005";"* Titre : Calcul du RC Nouvelle-calédonie"
"IGESRCCAL";"S";"0006";"*----------------------------------------------------------------------"
"IGESRCCAL";"S";"0007";"*"
"IGESRCCAL";"S";"0008";"* Créé par : Cellule Industrialisation"
"IGESRCCAL";"S";"0009";"* Date     : 22/06/2013"
"IGESRCCAL";"S";"0010";"* Version  : 1"
"IGESRCCAL";"S";"0011";"*"
"IGESRCCAL";"S";"0012";"*----------------------------------------------------------------------"
"IGESRCCAL";"S";"0013";"*"
"IGESRCCAL";"S";"0014";"*"
"IGESRCCAL";"S";"0015";"* Rôle : Calcul du repos compensateur"
"IGESRCCAL";"S";"0016";"*"
"IGESRCCAL";"S";"0017";"*"
"IGESRCCAL";"S";"0018";"*"
"IGESRCCAL";"S";"0019";"*"
"IGESRCCAL";"S";"0020";"*----------------------------------------------------------------------"
"IGESRCCAL";"S";"0021";"*"
"IGESRCCAL";"S";"0022";"* Modifiée par : Cellule Industrialisation"
"IGESRCCAL";"S";"0023";"* Date         : JJ/MM/AAAA"
"IGESRCCAL";"S";"0024";"* Objet        :"
"IGESRCCAL";"S";"0025";"*"
"IGESRCCAL";"S";"0026";"***********************************************************************"
"IGESRCCAL";"S";"0027";"*"
"IGESRCCAL";"S";"0028";"* Implémentation des données industrielles"
"IGESRCCAL";"S";"0029";"*"
"IGESRCCAL";"S";"0030";"DEBDICO"
"IGESRCCAL";"S";"0031";"   HJOU_IJIGHSUPPM;O;Z1;X;;;123456789;L;;C2;""Régime HS"";"
"IGESRCCAL";"S";"0032";"   HJOU_IJRBRCHSMH;N;T6,2;I;;;    56789;;IJRBRCHSMH;V3;""Base RC"";"
"IGESRCCAL";"S";"0033";"   HJOU_IJQARCHSMA;N;T6,2;I;;;    56789;;;V3;""COR acquis"";"
"IGESRCCAL";"S";"0034";"   HJOU_IJRSRCHSMA;N;T8,2;L;;;     6789;;IJRSRCHSMA;V3;""Solde COR"";"
"IGESRCCAL";"S";"0035";"   EMPL_IEQSPRCHSM;N;T6,2;I;;;     6789;;;V3;""Solde RC s/ HS majorées"";"
"IGESRCCAL";"S";"0036";"FINDICO"
"IGESRCCAL";"S";"0037";"*"
"IGESRCCAL";"S";"0038";"* Déclaration des donnees locales"
"IGESRCCAL";"S";"0039";"*"
"IGESRCCAL";"S";"0040";"DEF LOCA_NBCYCLE N2"
"IGESRCCAL";"S";"0041";"LOCA_NBCYCLE = 0"
"IGESRCCAL";"S";"0042";"DEF LOCA_SHS25 T6.2"
"IGESRCCAL";"S";"0043";"LOCA_SHS25 = 0"
"IGESRCCAL";"S";"0044";"DEF LOCA_CAL N1"
"IGESRCCAL";"S";"0045";"LOCA_CAL = 0"
"IGESRCCAL";"S";"0046";"DEF LOCA_DATE D"
"IGESRCCAL";"S";"0047";"LOCA_DATE = "" """
"IGESRCCAL";"S";"0048";"DEF LOCA_ACOURS N4"
"IGESRCCAL";"S";"0049";"LOCA_ACOURS = 0"
"IGESRCCAL";"S";"0050";"*"
"IGESRCCAL";"S";"0051";"*  RAZ de la base du RC le lundi"
"IGESRCCAL";"S";"0052";"*"
"IGESRCCAL";"S";"0053";"SI HJOU_JOUR = ""1"""
"IGESRCCAL";"S";"0054";"* raz chaque lundi si INRH <> 2 (0/1/3)"
"IGESRCCAL";"S";"0055";"* dont l'indicate"
"IGESRCCAL";"S";"0056";"   SI HJOU_IJIGHSUPPM <> ""2"""
"IGESRCCAL";"S";"0057";"      HJOU_IJRBRCHSMH = 0"
"IGESRCCAL";"S";"0058";"   FINSI"
"IGESRCCAL";"S";"0059";"* raz le premier lundi du cycle si INRH = 2"
"IGESRCCAL";"S";"0060";"   SI HJOU_IJIGHSUPPM = ""2"""
"IGESRCCAL";"S";"0061";"      SI HJOU_RANG = 1"
"IGESRCCAL";"S";"0062";"         HJOU_IJRBRCHSMH = 0"
"IGESRCCAL";"S";"0063";"      FINSI"
"IGESRCCAL";"S";"0064";"   FINSI"
"IGESRCCAL";"S";"0065";"FINSI"
"IGESRCCAL";"S";"0066";"*  calcul de la base du RC"
"IGESRCCAL";"S";"0067";"SI HJOU_IJIGHSUPPM <> ""0"""
"IGESRCCAL";"S";"0068";"   HJOU_IJRBRCHSMH = HJOU_IJRBRCHSMH + HJOU_IJQPRESBAV"
"IGESRCCAL";"S";"0069";"   POUR ACTIVITES"
"IGESRCCAL";"S";"0070";"      SI MOTI_MOTYPE <> ""C"""
"IGESRCCAL";"S";"0071";"         SI MOTI_IMIGRCHSMA = ""1"""
"IGESRCCAL";"S";"0072";"            HJOU_IJRBRCHSMH = HJOU_IJRBRCHSMH + HABS_MOTIDUR"
"IGESRCCAL";"S";"0073";"         FINSI"
"IGESRCCAL";"S";"0074";"      FINSI"
"IGESRCCAL";"S";"0075";"* initialisation de la base par consigne"
"IGESRCCAL";"S";"0076";"      SI HABS_MOTIF = ""ZBRC"""
"IGESRCCAL";"S";"0077";"         HJOU_IJRBRCHSMH = HABS_MOTIDUR"
"IGESRCCAL";"S";"0078";"      FINSI"
"IGESRCCAL";"S";"0079";"   FINPOUR"
"IGESRCCAL";"S";"0080";"FINSI"
"IGESRCCAL";"S";"0081";"*"
"IGESRCCAL";"S";"0082";"*  Calcul repos compensateur en prenant en compte le contingent"
"IGESRCCAL";"S";"0083";"*  le dimanche"
"IGESRCCAL";"S";"0084";"*"
"IGESRCCAL";"S";"0085";"SI HJOU_JOUR = ""7"""
"IGESRCCAL";"S";"0086";"   SI HJOU_IJIGHSUPPM = ""1"""
"IGESRCCAL";"S";"0087";"   OU HJOU_IJIGHSUPPM = ""3"""
"IGESRCCAL";"S";"0088";"      LOCA_CAL = 1"
"IGESRCCAL";"S";"0089";"      LOCA_SHS25 = PARD_IDISHSMTX1"
"IGESRCCAL";"S";"0090";"   FINSI"
"IGESRCCAL";"S";"0091";"   SI HJOU_IJIGHSUPPM = ""2"""
"IGESRCCAL";"S";"0092";"      LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"IGESRCCAL";"S";"0093";"      SI HJOU_RANG = LOCA_NBCYCLE"
"IGESRCCAL";"S";"0094";"         LOCA_SHS25 = PARD_IDISHSMTX1 * LOCA_NBCYCLE"
"IGESRCCAL";"S";"0095";"         LOCA_CAL = 1"
"IGESRCCAL";"S";"0096";"      FINSI"
"IGESRCCAL";"S";"0097";"   FINSI"
"IGESRCCAL";"S";"0098";"   SI LOCA_CAL = 1"
"IGESRCCAL";"S";"0099";"* test SI cumul des HS inf?rieure au Contingent 1"
"IGESRCCAL";"S";"0100";"      SI HJOU_IJRHSHMAJA <= PARD_IDISCONTHS"
"IGESRCCAL";"S";"0101";"* test si base RC supérieur au seuil HS 25%"
"IGESRCCAL";"S";"0102";"* RC egale a 20 % des heures au dela du seuil"
"IGESRCCAL";"S";"0103";"         SI HJOU_IJRBRCHSMH > LOCA_SHS25"
"IGESRCCAL";"S";"0104";"            HJOU_IJQARCHSMA = HJOU_IJRBRCHSMH - LOCA_SHS25"
"IGESRCCAL";"S";"0105";"            HJOU_IJQARCHSMA = HJOU_IJQARCHSMA * 0.2"
"IGESRCCAL";"S";"0106";"         FINSI"
"IGESRCCAL";"S";"0107";"      SINON"
"IGESRCCAL";"S";"0108";"* Test si base RC supérieure au seuil RC"
"IGESRCCAL";"S";"0109";"* RC egale a 50 % des heures au dela du seuil"
"IGESRCCAL";"S";"0110";"         SI HJOU_IJRBRCHSMH > LOCA_SHS25"
"IGESRCCAL";"S";"0111";"            HJOU_IJQARCHSMA = HJOU_IJRBRCHSMH - LOCA_SHS25"
"IGESRCCAL";"S";"0112";"            HJOU_IJQARCHSMA = HJOU_IJQARCHSMA * 0.5"
"IGESRCCAL";"S";"0113";"         FINSI"
"IGESRCCAL";"S";"0114";"      FINSI"
"IGESRCCAL";"S";"0115";"   FINSI"
"IGESRCCAL";"S";"0116";"*"
"IGESRCCAL";"S";"0117";"* cumul du solde"
"IGESRCCAL";"S";"0118";"   HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA + HJOU_IJQARCHSMA"
"IGESRCCAL";"S";"0119";"FINSI"
"IGESRCCAL";"S";"0120";"*  deduction de l'absence RC"
"IGESRCCAL";"S";"0121";"*"
"IGESRCCAL";"S";"0122";"SI HJOU_IJIGHSUPPM <> ""0"""
"IGESRCCAL";"S";"0123";"   POUR ACTIVITES"
"IGESRCCAL";"S";"0124";"      SI HABS_MOTIF = PARD_IDIVMRCREC"
"IGESRCCAL";"S";"0125";"         HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA - HABS_MOTIDUR"
"IGESRCCAL";"S";"0126";"      FINSI"
"IGESRCCAL";"S";"0127";"* analyse de la consigne d'initialisation de l'acquis RC"
"IGESRCCAL";"S";"0128";"      SI HABS_MOTIF = ""ZARC"""
"IGESRCCAL";"S";"0129";"         HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA - HJOU_IJQARCHSMA"
"IGESRCCAL";"S";"0130";"         HJOU_IJQARCHSMA = HABS_MOTIDUR"
"IGESRCCAL";"S";"0131";"         HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA + HJOU_IJQARCHSMA"
"IGESRCCAL";"S";"0132";"      FINSI"
"IGESRCCAL";"S";"0133";"* ANALYSE de la consigne de mise ? jour du solde"
"IGESRCCAL";"S";"0134";"      SI HABS_MOTIF = ""XSRC"""
"IGESRCCAL";"S";"0135";"         HJOU_IJRSRCHSMA = HJOU_IJRSRCHSMA + HABS_MOTIDUR"
"IGESRCCAL";"S";"0136";"      FINSI"
"IGESRCCAL";"S";"0137";"* analyse de la consigne d'initialisation du solde"
"IGESRCCAL";"S";"0138";"      SI HABS_MOTIF = ""ZSRC"""
"IGESRCCAL";"S";"0139";"         HJOU_IJRSRCHSMA = HABS_MOTIDUR"
"IGESRCCAL";"S";"0140";"      FINSI"
"IGESRCCAL";"S";"0141";"   FINPOUR"
"IGESRCCAL";"S";"0142";"FINSI"
"IGESRCCAL";"S";"0143";"** Alimentation du compteur prévisionnel"
"IGESRCCAL";"S";"0144";"** LF le 29/01/06"
"IGESRCCAL";"S";"0145";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IGESRCCAL";"S";"0146";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IGESRCCAL";"S";"0147";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IGESRCCAL";"S";"0148";"LOCA_DATE(5:4) = ""0101"""
"IGESRCCAL";"S";"0149";"SI TEMP_DATSUI = LOCA_DATE"
"IGESRCCAL";"S";"0150";"   EMPL_IEQSPRCHSM = HJOU_IJRSRCHSMA"
"IGESRCCAL";"S";"0151";"FINSI"
"IGESRCCAL";"S";"0152";"FIN"
"IGMOINS18";"S";"0001";"***********************************************************************"
"IGMOINS18";"S";"0002";"*"
"IGMOINS18";"S";"0003";"* Règle : IGMOINS18"
"IGMOINS18";"S";"0004";"* Ordre : 7110"
"IGMOINS18";"S";"0005";"* Titre : Gestion du temps de travail des moins de 18 ans"
"IGMOINS18";"S";"0006";"*"
"IGMOINS18";"S";"0007";"*----------------------------------------------------------------------"
"IGMOINS18";"S";"0008";"*"
"IGMOINS18";"S";"0009";"* Créé par : Méthodes et outils"
"IGMOINS18";"S";"0010";"* Date     : 25/10/2019"
"IGMOINS18";"S";"0011";"* Version  : 1"
"IGMOINS18";"S";"0012";"*"
"IGMOINS18";"S";"0013";"*----------------------------------------------------------------------"
"IGMOINS18";"S";"0014";"*"
"IGMOINS18";"S";"0015";"*"
"IGMOINS18";"S";"0016";"* Rôle : Gestion du temps de travail des moins de 18 ans"
"IGMOINS18";"S";"0017";"*"
"IGMOINS18";"S";"0018";"*"
"IGMOINS18";"S";"0019";"*----------------------------------------------------------------------"
"IGMOINS18";"S";"0020";"*"
"IGMOINS18";"S";"0021";"* Modifiée par :"
"IGMOINS18";"S";"0022";"* Date         : JJ/MM/AAAA"
"IGMOINS18";"S";"0023";"* Objet        :"
"IGMOINS18";"S";"0024";"*"
"IGMOINS18";"S";"0025";"***********************************************************************"
"IGMOINS18";"S";"0026";"*"
"IGMOINS18";"S";"0027";"* Implémentation des données industrielles"
"IGMOINS18";"S";"0028";"*"
"IGMOINS18";"S";"0029";"DEBDICO"
"IGMOINS18";"S";"0030";"   PARD_IDIHSMINEU;O;T6,2;I;;;123456789;;;C3;""Seuil HS pour les moins de 18 ans"";"
"IGMOINS18";"S";"0031";"FINDICO"
"IGMOINS18";"S";"0032";"*"
"IGMOINS18";"S";"0033";"DEBANO"
"IGMOINS18";"S";"0034";"   159;8;""Plus de 6 jours consécutifs de travail dans la semaine"";"
"IGMOINS18";"S";"0035";"   160;8;""Moins de 18 ans : durée du repos quotidien non respecté"";"
"IGMOINS18";"S";"0036";"   164;8;""Moins de 18 ans : le nombre d'HS maximum est atteint"";"
"IGMOINS18";"S";"0037";"   165;6;""Moins de 18 ans : jour férié travaillé si dérogation légale"";"
"IGMOINS18";"S";"0038";"   172;6;""Moins de 18 ans : présence supérieure au maxi sauf si dérogation légale"";"
"IGMOINS18";"S";"0039";"   173;8;""Moins de 18 ans : travail entre 22h et 6h interdit sauf dérogation légale"";"
"IGMOINS18";"S";"0040";"   183;7;""Durée du repos hebdomadaire non respecté"";"
"IGMOINS18";"S";"0041";"FINANO"
"IGMOINS18";"S";"0042";"**********************************************************************"
"IGMOINS18";"S";"0043";"*"
"IGMOINS18";"S";"0044";"* Déclaration des donnees locales"
"IGMOINS18";"S";"0045";"*"
"IGMOINS18";"S";"0046";"DEF LOCA_AGE N2"
"IGMOINS18";"S";"0047";"LOCA_AGE = 0"
"IGMOINS18";"S";"0048";"DEF LOCA_DERBADG T6.2"
"IGMOINS18";"S";"0049";"LOCA_DERBADG = 0"
"IGMOINS18";"S";"0050";"DEF LOCA_CALCUL N1"
"IGMOINS18";"S";"0051";"LOCA_CALCUL = 0"
"IGMOINS18";"S";"0052";"DEF LOCA_24 T6.2"
"IGMOINS18";"S";"0053";"LOCA_24 = 24"
"IGMOINS18";"S";"0054";"DEF LOCA_REPOS T6.2"
"IGMOINS18";"S";"0055";"LOCA_REPOS = 24.00"
"IGMOINS18";"S";"0056";"DEF LOCA_LENDREP2 T6.2"
"IGMOINS18";"S";"0057";"LOCA_LENDREP2 = 0"
"IGMOINS18";"S";"0058";"DEF LOCA_VEILPRESBA T6.2"
"IGMOINS18";"S";"0059";"LOCA_VEILPRESBA = 0"
"IGMOINS18";"S";"0060";"DEF LOCA_PREMBT T6.2"
"IGMOINS18";"S";"0061";"LOCA_PREMBT = 0"
"IGMOINS18";"S";"0062";"DEF LOCA_PTTHEO1 N1"
"IGMOINS18";"S";"0063";"LOCA_PTTHEO1 = 0"
"IGMOINS18";"S";"0064";"DEF LOCA_PTTHEO4 N1"
"IGMOINS18";"S";"0065";"LOCA_PTTHEO4 = 0"
"IGMOINS18";"S";"0066";"DEF LOCA_ANO N1"
"IGMOINS18";"S";"0067";"LOCA_ANO = 0"
"IGMOINS18";"S";"0068";"*"
"IGMOINS18";"S";"0069";"* Si la date de naissance est renseignée"
"IGMOINS18";"S";"0070";"SI EMPS_E2DATENAI <> "" """
"IGMOINS18";"S";"0071";"   DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"IGMOINS18";"S";"0072";"   LOCA_AGE = TEMP_NXANNEE"
"IGMOINS18";"S";"0073";"*"
"IGMOINS18";"S";"0074";"   SI LOCA_AGE < 18"
"IGMOINS18";"S";"0075";"***************************************************************"
"IGMOINS18";"S";"0076";"*************** Durée du travail max journalier ***************"
"IGMOINS18";"S";"0077";"***************************************************************"
"IGMOINS18";"S";"0078";"      SI HJOU_IJQTTEFFEJ > 8"
"IGMOINS18";"S";"0079";"         ANOMALIE 172"
"IGMOINS18";"S";"0080";"      FINSI"
"IGMOINS18";"S";"0081";"***************************************************************"
"IGMOINS18";"S";"0082";"************************* Repos hebdo *************************"
"IGMOINS18";"S";"0083";"***************************************************************"
"IGMOINS18";"S";"0084";"* Pas plus de 5 jours travaillés dans la semaine"
"IGMOINS18";"S";"0085";"      SI HJOU_IJRNBTRAVS > 5"
"IGMOINS18";"S";"0086";"         HJOU_IJRNBTRAVS = 0"
"IGMOINS18";"S";"0087";"         ANOMALIE 159"
"IGMOINS18";"S";"0088";"      FINSI"
"IGMOINS18";"S";"0089";"*"
"IGMOINS18";"S";"0090";"* Minimum 36h de repos consécutives"
"IGMOINS18";"S";"0091";"* Récupération des heures effectives de la veille"
"IGMOINS18";"S";"0092";"      LIREVALPRE LOCA_VEILPRESBA HJOU_IJQTTEFFEJ"
"IGMOINS18";"S";"0093";"* Si pas d'heures effectives la veille"
"IGMOINS18";"S";"0094";"      SI LOCA_VEILPRESBA = 0"
"IGMOINS18";"S";"0095";"*Nb heures repos hebdo"
"IGMOINS18";"S";"0096";"         SI HJOU_IJRREP35H >= 36"
"IGMOINS18";"S";"0097";"*Indicateur pour déclenchement ano"
"IGMOINS18";"S";"0098";"            HJOU_IJRINDANO = 1"
"IGMOINS18";"S";"0099";"            LOCA_CALCUL = 1"
"IGMOINS18";"S";"0100";"            HJOU_IJRREP35H = 36"
"IGMOINS18";"S";"0101";"         FINSI"
"IGMOINS18";"S";"0102";"      FINSI"
"IGMOINS18";"S";"0103";"*"
"IGMOINS18";"S";"0104";"      SI LOCA_CALCUL <> 1"
"IGMOINS18";"S";"0105";"*Si repos la veille"
"IGMOINS18";"S";"0106";"         LIREVALPRE LOCA_LENDREP2 HJOU_IJQTTEFFEJ"
"IGMOINS18";"S";"0107";"         SI LOCA_LENDREP2 = 0"
"IGMOINS18";"S";"0108";"            SI HJOU_IJQTTEFFEJ > 0"
"IGMOINS18";"S";"0109";"*"
"IGMOINS18";"S";"0110";"               HJOU_IJRREP35H = HJOU_IJRREP35H + LOCA_24"
"IGMOINS18";"S";"0111";"               HJOU_IJRREP35H = HJOU_IJRREP35H + HJOU_IJQPRBADGV"
"IGMOINS18";"S";"0112";"*"
"IGMOINS18";"S";"0113";"               SI HJOU_IJRREP35H < 36"
"IGMOINS18";"S";"0114";"                  HJOU_IJRINDANO = HJOU_IJRINDANO + 2"
"IGMOINS18";"S";"0115";"               SINON"
"IGMOINS18";"S";"0116";"                  HJOU_IJRINDANO = 1"
"IGMOINS18";"S";"0117";"               FINSI"
"IGMOINS18";"S";"0118";"            SINON"
"IGMOINS18";"S";"0119";"               HJOU_IJRREP35H = HJOU_IJRREP35H + LOCA_24"
"IGMOINS18";"S";"0120";"            FINSI"
"IGMOINS18";"S";"0121";"         SINON"
"IGMOINS18";"S";"0122";"            SI HJOU_IJQTTEFFEJ = 0"
"IGMOINS18";"S";"0123";"               LIREVALPRE LOCA_DERBADG HJOU_IJQDEBADGV"
"IGMOINS18";"S";"0124";"               HJOU_IJRREP35H = LOCA_24 - LOCA_DERBADG"
"IGMOINS18";"S";"0125";"            SINON"
"IGMOINS18";"S";"0126";"               HJOU_IJRINDANO = HJOU_IJRINDANO + 1"
"IGMOINS18";"S";"0127";"            FINSI"
"IGMOINS18";"S";"0128";"         FINSI"
"IGMOINS18";"S";"0129";"*"
"IGMOINS18";"S";"0130";"         SI HJOU_IJRINDANO = 7"
"IGMOINS18";"S";"0131";"            SI HJOU_IJQTTEFFEJ <> 0"
"IGMOINS18";"S";"0132";"               ANOMALIE 183"
"IGMOINS18";"S";"0133";"               HJOU_IJRINDANO = 0"
"IGMOINS18";"S";"0134";"            FINSI"
"IGMOINS18";"S";"0135";"         FINSI"
"IGMOINS18";"S";"0136";"*"
"IGMOINS18";"S";"0137";"         SI HJOU_IJRINDANO = 8"
"IGMOINS18";"S";"0138";"            ANOMALIE 183"
"IGMOINS18";"S";"0139";"            HJOU_IJRINDANO = 0"
"IGMOINS18";"S";"0140";"         FINSI"
"IGMOINS18";"S";"0141";"      FINSI"
"IGMOINS18";"S";"0142";"***************************************************************"
"IGMOINS18";"S";"0143";"*********************** Repos quotidien ***********************"
"IGMOINS18";"S";"0144";"***************************************************************"
"IGMOINS18";"S";"0145";"      SI HJOU_IJQDEBADGV > 0"
"IGMOINS18";"S";"0146";"         SI HJOU_IJQPRBADGV > 0"
"IGMOINS18";"S";"0147";"            LOCA_REPOS = HJOU_IJQPRBADGV + 24.00"
"IGMOINS18";"S";"0148";"            LOCA_REPOS = LOCA_REPOS - HJOU_IJRSDBADGV"
"IGMOINS18";"S";"0149";"         FINSI"
"IGMOINS18";"S";"0150";"      FINSI"
"IGMOINS18";"S";"0151";"      SI HJOU_IJIGBADGEA = ""0"""
"IGMOINS18";"S";"0152";"** Contrôle si la plage n'est pas à blanc"
"IGMOINS18";"S";"0153";"         SI PROF_PTTHEO1 > 0"
"IGMOINS18";"S";"0154";"            SI PROF_PTTHEO1 < 100"
"IGMOINS18";"S";"0155";"               LOCA_PTTHEO1 = 1"
"IGMOINS18";"S";"0156";"            FINSI"
"IGMOINS18";"S";"0157";"         FINSI"
"IGMOINS18";"S";"0158";"** Contrôle si la plage n'est pas à blanc"
"IGMOINS18";"S";"0159";"         SI PROF_PTTHEO4 > 0"
"IGMOINS18";"S";"0160";"            SI PROF_PTTHEO4 < 100"
"IGMOINS18";"S";"0161";"               LOCA_PTTHEO4 = 1"
"IGMOINS18";"S";"0162";"            FINSI"
"IGMOINS18";"S";"0163";"         FINSI"
"IGMOINS18";"S";"0164";"*"
"IGMOINS18";"S";"0165";"         SI LOCA_PTTHEO1 = 1"
"IGMOINS18";"S";"0166";"            LOCA_PREMBT = PROF_PTTHEO1"
"IGMOINS18";"S";"0167";"            SI LOCA_PTTHEO4 = 1"
"IGMOINS18";"S";"0168";"               HJOU_IJQDEBADGT = PROF_PTTHEO4"
"IGMOINS18";"S";"0169";"            SINON"
"IGMOINS18";"S";"0170";"               HJOU_IJQDEBADGT = PROF_PTTHEO2"
"IGMOINS18";"S";"0171";"            FINSI"
"IGMOINS18";"S";"0172";"            LOCA_REPOS = LOCA_PREMBT + 24.00"
"IGMOINS18";"S";"0173";"            LOCA_REPOS = LOCA_REPOS - HJOU_IJRDBADGTV"
"IGMOINS18";"S";"0174";"         SINON"
"IGMOINS18";"S";"0175";"            SI PROF_PTTHEO3 > 0"
"IGMOINS18";"S";"0176";"               SI PROF_PTTHEO3 < 100"
"IGMOINS18";"S";"0177";"                  LOCA_PREMBT = PROF_PTTHEO3"
"IGMOINS18";"S";"0178";"                  HJOU_IJQDEBADGT = PROF_PTTHEO4"
"IGMOINS18";"S";"0179";"                  LOCA_REPOS = LOCA_PREMBT + 24.00"
"IGMOINS18";"S";"0180";"                  LOCA_REPOS = LOCA_REPOS - HJOU_IJRDBADGTV"
"IGMOINS18";"S";"0181";"               FINSI"
"IGMOINS18";"S";"0182";"            FINSI"
"IGMOINS18";"S";"0183";"         FINSI"
"IGMOINS18";"S";"0184";"      FINSI"
"IGMOINS18";"S";"0185";"***************************************************************"
"IGMOINS18";"S";"0186";"******************** Travail sur jour férié *******************"
"IGMOINS18";"S";"0187";"***************************************************************"
"IGMOINS18";"S";"0188";"      POUR ACTIVITES"
"IGMOINS18";"S";"0189";"         SI HABS_MOTIF = ""FERI"""
"IGMOINS18";"S";"0190";"            SI HJOU_IJQTTEFFEJ > 0"
"IGMOINS18";"S";"0191";"               LOCA_ANO = 1"
"IGMOINS18";"S";"0192";"            FINSI"
"IGMOINS18";"S";"0193";"         FINSI"
"IGMOINS18";"S";"0194";"      FINPOUR"
"IGMOINS18";"S";"0195";"*"
"IGMOINS18";"S";"0196";"      SI LOCA_ANO = 1"
"IGMOINS18";"S";"0197";"         ANOMALIE 165"
"IGMOINS18";"S";"0198";"      FINSI"
"IGMOINS18";"S";"0199";"***************************************************************"
"IGMOINS18";"S";"0200";"*********************** Travail 22h - 6h **********************"
"IGMOINS18";"S";"0201";"***************************************************************"
"IGMOINS18";"S";"0202";"      SI TEMP_NXPOIN > 0"
"IGMOINS18";"S";"0203";"         SI HJOU_IJQPRBADGV < 6"
"IGMOINS18";"S";"0204";"         OU HJOU_IJQDEBADGV > 22"
"IGMOINS18";"S";"0205";"            ANOMALIE 173"
"IGMOINS18";"S";"0206";"         FINSI"
"IGMOINS18";"S";"0207";"      FINSI"
"IGMOINS18";"S";"0208";"*"
"IGMOINS18";"S";"0209";"************************************ Moins de 16 ans *************************************"
"IGMOINS18";"S";"0210";"      SI LOCA_AGE < 16"
"IGMOINS18";"S";"0211";"* anomalie si < 14h"
"IGMOINS18";"S";"0212";"         SI LOCA_REPOS > 0"
"IGMOINS18";"S";"0213";"            SI LOCA_REPOS < 14.00"
"IGMOINS18";"S";"0214";"               ANOMALIE 160"
"IGMOINS18";"S";"0215";"            FINSI"
"IGMOINS18";"S";"0216";"         FINSI"
"IGMOINS18";"S";"0217";"***************************************************************"
"IGMOINS18";"S";"0218";"************************** HS maximum *************************"
"IGMOINS18";"S";"0219";"***************************************************************"
"IGMOINS18";"S";"0220";"* Dépassement de l'horaire hebdo temps plein"
"IGMOINS18";"S";"0221";"         SI HJOU_JOUR = ""7"""
"IGRTTH";"S";"0087";"SI HJOU_IJIGRETETR = ""1"""
"IGMOINS18";"S";"0222";"            SI HJOU_IJRBHSMPAH > PARD_IDIVHORCOH"
"IGMOINS18";"S";"0223";"               ANOMALIE 164"
"IGMOINS18";"S";"0224";"            FINSI"
"IGMOINS18";"S";"0225";"         FINSI"
"IGMOINS18";"S";"0226";"      SINON"
"IGMOINS18";"S";"0227";"************************************* De 16 à 18 ans *************************************"
"IGMOINS18";"S";"0228";"* anomalie si < 12h"
"IGMOINS18";"S";"0229";"         SI LOCA_REPOS > 0"
"IGMOINS18";"S";"0230";"            SI LOCA_REPOS < 12.00"
"IGMOINS18";"S";"0231";"               ANOMALIE 160"
"IGMOINS18";"S";"0232";"            FINSI"
"IGMOINS18";"S";"0233";"         FINSI"
"IGMOINS18";"S";"0234";"***************************************************************"
"IGMOINS18";"S";"0235";"************************** HS maximum *************************"
"IGMOINS18";"S";"0236";"***************************************************************"
"IGMOINS18";"S";"0237";"* Dépassement de l'horaire hebdo temps plein"
"IGMOINS18";"S";"0238";"         SI HJOU_JOUR = ""7"""
"IGMOINS18";"S";"0239";"            SI HJOU_IJRBHSMPAH > PARD_IDIHSMINEU"
"IGMOINS18";"S";"0240";"               ANOMALIE 164"
"IGMOINS18";"S";"0241";"            FINSI"
"IGMOINS18";"S";"0242";"         FINSI"
"IGMOINS18";"S";"0243";"      FINSI"
"IGMOINS18";"S";"0244";"   FINSI"
"IGMOINS18";"S";"0245";"FINSI"
"IGMOINS18";"S";"0246";"*"
"IGMOINS18";"S";"0247";"FIN"
"IGRTTH";"S";"0001";"***********************************************************************"
"IGRTTH";"S";"0002";"*"
"IGRTTH";"S";"0003";"* Règle : IGRTTH"
"IGRTTH";"S";"0004";"* Ordre : 6090"
"IGRTTH";"S";"0005";"* Titre : Gestion RTT en heures"
"IGRTTH";"S";"0006";"*"
"IGRTTH";"S";"0007";"*----------------------------------------------------------------------"
"IGRTTH";"S";"0008";"*"
"IGRTTH";"S";"0009";"* Créé par : Cellule Industrialisation"
"IGRTTH";"S";"0010";"* Date     : 03/09/2009"
"IGRTTH";"S";"0011";"* Version  : 1"
"IGRTTH";"S";"0012";"*"
"IGRTTH";"S";"0013";"*----------------------------------------------------------------------"
"IGRTTH";"S";"0014";"*"
"IGRTTH";"S";"0015";"*"
"IGRTTH";"S";"0016";"* Rôle : Calcul des RTT en heures"
"IGRTTH";"S";"0017";"*"
"IGRTTH";"S";"0018";"*"
"IGRTTH";"S";"0019";"*"
"IGRTTH";"S";"0020";"*----------------------------------------------------------------------"
"IGRTTH";"S";"0021";"*"
"IGRTTH";"S";"0022";"* Modifiée par : Méthodes et outils"
"IGRTTH";"S";"0023";"* Date         : 28/06/2018"
"IGRTTH";"S";"0024";"* Objet        : passage sur 10 caractères des motifs"
"IGRTTH";"S";"0025";"*"
"IGRTTH";"S";"0026";"***********************************************************************"
"IGRTTH";"S";"0027";"*"
"IGRTTH";"S";"0028";"* Modifiée par : Méthodes et outils"
"IGRTTH";"S";"0029";"* Date         : 23/11/2020"
"IGRTTH";"S";"0030";"* Objet        : Même pour une gestion des RTT en heures, lors de la"
"IGRTTH";"S";"0031";"*                 pose du motif RTT employeur, celui-ci alimente le compteur"
"IGRTTH";"S";"0032";"*                 HJOU_IJRNRTTJEM"
"IGRTTH";"S";"0033";"*"
"IGRTTH";"S";"0034";"***********************************************************************"
"IGRTTH";"S";"0035";"*"
"IGRTTH";"S";"0036";"* Implémentation des données industrielles"
"IGRTTH";"S";"0037";"*"
"IGRTTH";"S";"0038";"DEBDICO"
"IGRTTH";"S";"0039";"   HJOU_IJRARTTHEU;N;T6,2;L;;;     6789;;IJRARTTHEU;V3;""RTT acquis (H)"";"
"IGRTTH";"S";"0040";"   HJOU_IJRCRTTHEU;N;T6,2;L;;;     6789;;IJRCRTTHEU;V3;""RTT pris (H)"";"
"IGRTTH";"S";"0041";"   HJOU_IJRSNBHRTT;N;T6,2;L;;;     6789;;IJRSNBHRTT;V3;""Solde RTT (H)"";"
"IGRTTH";"S";"0042";"   EMPL_IEQSPRTTHE;N;T6,2;L;;;     6789;;;V3;""Solde previsionnel RTT en heures"";"
"IGRTTH";"S";"0043";"   PARD_IDISACQRTT;O;T6,2;I;0;;123456789;;;C3;""Seuil RTT"";"
"IGRTTH";"S";"0044";"   CONF_IGIREFRTT;O;A4;X;;;123456789;;;C3;""Date de référence RTT (JJMM)"";"
"IGRTTH";"S";"0045";"   HJOU_IJRNRTTJEM;N;N3,1;I;;;    56789;;IJRNRTTJEM;V3;""Nbre RTT employeurs pris"";"
"IGRTTH";"S";"0046";"FINDICO"
"IGRTTH";"S";"0047";"*"
"IGRTTH";"S";"0048";"DEBANO"
"IGRTTH";"S";"0049";"   135;5;""Solde RTT insuffisant"";"
"IGRTTH";"S";"0050";"FINANO"
"IGRTTH";"S";"0051";"*"
"IGRTTH";"S";"0052";"* Déclaration des donnees locales"
"IGRTTH";"S";"0053";"*"
"IGRTTH";"S";"0054";"DEF LOCA_ACQRTTH T6.2"
"IGRTTH";"S";"0055";"LOCA_ACQRTTH = 0"
"IGRTTH";"S";"0056";"DEF LOCA_BARTT T6.2"
"IGRTTH";"S";"0057";"LOCA_BARTT = 0"
"IGRTTH";"S";"0058";"DEF LOCA_MIRTTS T6.2"
"IGRTTH";"S";"0059";"LOCA_MIRTTS = PROF_IPIVARTTSA / 2"
"IGRTTH";"S";"0060";"DEF LOCA_DATE D"
"IGRTTH";"S";"0061";"LOCA_DATE = "" """
"IGRTTH";"S";"0062";"DEF LOCA_ACOURS N4"
"IGRTTH";"S";"0063";"LOCA_ACOURS = 0"
"IGRTTH";"S";"0064";"DEF LOCA_ACOURS2 N4"
"IGRTTH";"S";"0065";"LOCA_ACOURS2 = 0"
"IGRTTH";"S";"0066";"DEF LOCA_MOT N1"
"IGRTTH";"S";"0067";"LOCA_MOT = 0"
"IGRTTH";"S";"0068";"DEF LOCA_REST N6.3"
"IGRTTH";"S";"0069";"LOCA_REST = 0"
"IGRTTH";"S";"0070";"DEF LOCA_ENTIER N6.1"
"IGRTTH";"S";"0071";"LOCA_ENTIER = 0"
"IGRTTH";"S";"0072";"DEF LOCA_ENLEVER N1"
"IGRTTH";"S";"0073";"LOCA_ENLEVER = 0"
"IGRTTH";"S";"0074";"DEF LOCA_VALID A4"
"IGRTTH";"S";"0075";"LOCA_VALID = "" """
"IGRTTH";"S";"0076";"DEF LOCA_MOTIF A10"
"IGRTTH";"S";"0077";"LOCA_MOTIF = "" """
"IGRTTH";"S";"0078";"DEF LOCA_REF N2"
"IGRTTH";"S";"0079";"LOCA_REF = 0"
"IGRTTH";"S";"0080";"DEF LOCA_DATEFU D"
"IGRTTH";"S";"0081";"LOCA_DATEFU = "" """
"IGRTTH";"S";"0082";"DEF LOCA_DATEFU2 D"
"IGRTTH";"S";"0083";"LOCA_DATEFU2 = "" """
"IGRTTH";"S";"0084";"*"
"IGRTTH";"S";"0085";"* RAZ à la date de référence RTT ou en début d'annualisation"
"IGRTTH";"S";"0086";"*"
"IGRTTH";"S";"0088";"OU HJOU_IJIGRETETR = ""3"""
"IGRTTH";"S";"0089";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IGRTTH";"S";"0090";"*"
"IGRTTH";"S";"0091";"   SI CONF_IGIREFRTT <> "" """
"IGRTTH";"S";"0092";"      LOCA_REF << CONF_IGIREFRTT(1:2)"
"IGRTTH";"S";"0093";"      LOCA_DATE(7:2) << LOCA_REF"
"IGRTTH";"S";"0094";"      LOCA_REF << CONF_IGIREFRTT(3:2)"
"IGRTTH";"S";"0095";"      LOCA_DATE(5:2) << LOCA_REF"
"IGRTTH";"S";"0096";"   SINON"
"IGRTTH";"S";"0097";"      LOCA_DATE = PARD_IDIDDEBANN"
"IGRTTH";"S";"0098";"   FINSI"
"IGRTTH";"S";"0099";"**"
"IGRTTH";"S";"0100";"   LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IGRTTH";"S";"0101";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IGRTTH";"S";"0102";"*"
"IGRTTH";"S";"0103";"   SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IGRTTH";"S";"0104";"      LOCA_ACOURS = LOCA_ACOURS + 1"
"IGRTTH";"S";"0105";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IGRTTH";"S";"0106";"*"
"IGRTTH";"S";"0107";"   FINSI"
"IGRTTH";"S";"0108";"   LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IGRTTH";"S";"0109";"   LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IGRTTH";"S";"0110";"   LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IGRTTH";"S";"0111";"   LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IGRTTH";"S";"0112";"*"
"IGRTTH";"S";"0113";"*"
"IGRTTH";"S";"0114";"*"
"IGRTTH";"S";"0115";"   SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IGRTTH";"S";"0116";"      HJOU_IJRARTTHEU = 0"
"IGRTTH";"S";"0117";"      HJOU_IJRCRTTHEU = 0"
"IGRTTH";"S";"0118";"      HJOU_IJRSNBHRTT = 0"
"IGRTTH";"S";"0119";"   FINSI"
"IGRTTH";"S";"0120";"**"
"IGRTTH";"S";"0121";"** Traitement des RTT en heures - acquisition quotidienne"
"IGRTTH";"S";"0122";"**"
"IGRTTH";"S";"0123";"* calcul de la base RTT"
"IGRTTH";"S";"0124";"   SI HJOU_IJIGRETETR = ""1"""
"IGRTTH";"S";"0125";"      LOCA_BARTT = HJOU_IJQPRESBAV"
"IGRTTH";"S";"0126";"      POUR ACTIVITES"
"IGRTTH";"S";"0127";"         SI MOTI_MOTYPE <> ""C"""
"IGRTTH";"S";"0128";"            SI MOTI_IMIGRETETR = ""1"""
"IGRTTH";"S";"0129";"               LOCA_BARTT = LOCA_BARTT + HABS_MOTIDUR"
"IGRTTH";"S";"0130";"            FINSI"
"IGRTTH";"S";"0131";"         FINSI"
"IGRTTH";"S";"0132";"      FINPOUR"
"IGRTTH";"S";"0133";"*    calcul de l'acquisition par rapport au(x) seuil(s) fixé(s) dans le profil journalier"
"IGRTTH";"S";"0134";"* calcul à la journée"
"IGRTTH";"S";"0135";"      SI PROF_IPISRTTACQ > 0"
"IGRTTH";"S";"0136";"         SI LOCA_BARTT >= PROF_IPISRTTACQ"
"IGRTTH";"S";"0137";"            HJOU_IJRARTTHEU = HJOU_IJRARTTHEU + PROF_IPIVARTTSA"
"IGRTTH";"S";"0138";"         SINON"
"IGRTTH";"S";"0139";"* acquisition d'un demi-RTT à partir du seuil demi-RTT"
"IGRTTH";"S";"0140";"            SI PROF_IPISRTTACD > 0"
"IGRTTH";"S";"0141";"               SI LOCA_BARTT >= PROF_IPISRTTACD"
"IGRTTH";"S";"0142";"                  HJOU_IJRARTTHEU = HJOU_IJRARTTHEU + LOCA_MIRTTS"
"IGRTTH";"S";"0143";"               FINSI"
"IGRTTH";"S";"0144";"            FINSI"
"IGRTTH";"S";"0145";"         FINSI"
"IGRTTH";"S";"0146";"      FINSI"
"IGRTTH";"S";"0147";"   FINSI"
"IGRTTH";"S";"0148";"**"
"IGRTTH";"S";"0149";"**"
"IGRTTH";"S";"0150";"** Traitement des RTT en heures acquisition hebdomadaire"
"IGRTTH";"S";"0151";"   SI HJOU_IJIGRETETR = ""3"""
"IGRTTH";"S";"0152";"      SI HJOU_JOUR = ""7"""
"IGRTTH";"S";"0153";"** cas ou on gere egalement des HS"
"IGRTTH";"S";"0154";"         SI HJOU_IJIGHSUPPM <> ""0"""
"IGRTTH";"S";"0155";"** cas ou la base HS >= seuil HS25"
"IGRTTH";"S";"0156";"            SI HJOU_IJRBHSMPAH >= PARD_IDISHSMTX1"
"IGRTTH";"S";"0157";"               LOCA_ACQRTTH = PARD_IDISHSMTX1 - PARD_IDISACQRTT"
"IGRTTH";"S";"0158";"            SINON"
"IGRTTH";"S";"0159";"               SI HJOU_IJRBHSMPAH >= PARD_IDISACQRTT"
"IGRTTH";"S";"0160";"                  LOCA_ACQRTTH = HJOU_IJRBHSMPAH - PARD_IDISACQRTT"
"IGRTTH";"S";"0161";"               FINSI"
"IGRTTH";"S";"0162";"            FINSI"
"IGRTTH";"S";"0163";"** cas ou ne gere pas de HS"
"IGRTTH";"S";"0164";"         SINON"
"IGRTTH";"S";"0165";"            SI HJOU_IJRBHSMPAH > PARD_IDISACQRTT"
"IGRTTH";"S";"0166";"               LOCA_ACQRTTH = HJOU_IJRBHSMPAH - PARD_IDISACQRTT"
"IGRTTH";"S";"0167";"            FINSI"
"IGRTTH";"S";"0168";"         FINSI"
"IGRTTH";"S";"0169";"** calcul de l'acquiistion"
"IGRTTH";"S";"0170";"         HJOU_IJRARTTHEU = HJOU_IJRARTTHEU + LOCA_ACQRTTH"
"IGRTTH";"S";"0171";"      FINSI"
"IGRTTH";"S";"0172";"   FINSI"
"IGRTTH";"S";"0173";"**"
"IGRTTH";"S";"0174";"**"
"IGRTTH";"S";"0175";"* traitement du motif RTT pris"
"IGRTTH";"S";"0176";"   POUR ACTIVITES"
"IGRTTH";"S";"0177";"      SI HABS_MOTIF = PARD_IDIVMRTTSA"
"IGRTTH";"S";"0178";"      OU HABS_MOTIF = PARD_IDIVMRTTEM"
"IGRTTH";"S";"0179";"         LOCA_MOTIF = HABS_MOTIF"
"IGRTTH";"S";"0180";"         LOCA_MOT = 1"
"IGRTTH";"S";"0181";"         SI HJOU_IJIGRETETR = ""1"""
"IGRTTH";"S";"0182";"         OU HJOU_IJIGRETETR = ""3"""
"IGRTTH";"S";"0183";"            HJOU_IJRCRTTHEU = HJOU_IJRCRTTHEU + HABS_MOTIDUR"
"IGRTTH";"S";"0184";"         FINSI"
"IGRTTH";"S";"0185";"      FINSI"
"IGRTTH";"S";"0186";"*   Contrôle du nombre de RTT employeurs pris"
"IGRTTH";"S";"0187";"*   et mise en place anomalie si cela dépasse"
"IGRTTH";"S";"0188";"*   la valeur indiquée dans les données globales datées"
"IGRTTH";"S";"0189";"      SI HABS_MOTIF = PARD_IDIVMRTTEM"
"IGRTTH";"S";"0190";"         SI HABS_VALORIS = ""J"""
"IGRTTH";"S";"0191";"            HJOU_IJRNRTTJEM = HJOU_IJRNRTTJEM + 1"
"IGRTTH";"S";"0192";"         SINON"
"IGRTTH";"S";"0193";"            HJOU_IJRNRTTJEM = HJOU_IJRNRTTJEM + 0.5"
"IGRTTH";"S";"0194";"         FINSI"
"IGRTTH";"S";"0195";"         SI HJOU_IJRNRTTJEM > PARD_IDISRTTEMP"
"IGRTTH";"S";"0196";"            ANOMALIE 136"
"IGRTTH";"S";"0197";"         FINSI"
"IGRTTH";"S";"0198";"      FINSI"
"IGRTTH";"S";"0199";"   FINPOUR"
"IGRTTH";"S";"0200";"*"
"IGRTTH";"S";"0201";"* analyse des consignes d'initialisation et de mise à jour"
"IGRTTH";"S";"0202";"*"
"IGRTTH";"S";"0203";"   POUR ACTIVITES"
"IGRTTH";"S";"0204";"      SI HABS_MOTIF = ""ZRTT"""
"IGRTTH";"S";"0205";"         HJOU_IJRARTTHEU = HABS_MOTIDUR"
"IGRTTH";"S";"0206";"      FINSI"
"IGRTTH";"S";"0207";"      SI HABS_MOTIF = ""XRTT"""
"IGRTTH";"S";"0208";"         HJOU_IJRARTTHEU = HJOU_IJRARTTHEU + HABS_MOTIDUR"
"IGRTTH";"S";"0209";"      FINSI"
"IGRTTH";"S";"0210";"      SI HABS_MOTIF = ""ZCRH"""
"IGRTTH";"S";"0211";"         HJOU_IJRCRTTHEU = HABS_MOTIDUR"
"IGRTTH";"S";"0212";"      FINSI"
"IGRTTH";"S";"0213";"      SI HABS_MOTIF = ""XCRH"""
"IGRTTH";"S";"0214";"         HJOU_IJRCRTTHEU = HJOU_IJRCRTTHEU + HABS_MOTIDUR"
"IGRTTH";"S";"0215";"      FINSI"
"IGRTTH";"S";"0216";"   FINPOUR"
"IGRTTH";"S";"0217";"*"
"IGRTTH";"S";"0218";"* calcul des soldes"
"IGRTTH";"S";"0219";"   HJOU_IJRSNBHRTT = HJOU_IJRARTTHEU - HJOU_IJRCRTTHEU"
"IGRTTH";"S";"0220";"   SI HJOU_IJRSNBHRTT < 0"
"IGRTTH";"S";"0221";"      SI LOCA_MOT = 1"
"IGRTTH";"S";"0222";"         ANOMALIE 135"
"IGRTTH";"S";"0223";"      FINSI"
"IGRTTH";"S";"0224";"   FINSI"
"IGRTTH";"S";"0225";"**"
"IGRTTH";"S";"0226";"** soldes previsionnels"
"IGRTTH";"S";"0227";"**"
"IGRTTH";"S";"0228";"   SI CTRA_DATFIN > TEMP_DATJOU"
"IGRTTH";"S";"0229";"      SI CTRA_DATFIN < LOCA_DATEFU"
"IGRTTH";"S";"0230";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"IGRTTH";"S";"0231";"         LOCA_DATEFU = TEMP_DXFINPER"
"IGRTTH";"S";"0232";"      SINON"
"IGRTTH";"S";"0233";"         SI CTRA_DATFIN < LOCA_DATEFU2"
"IGRTTH";"S";"0234";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"IGRTTH";"S";"0235";"            LOCA_DATEFU2 = TEMP_DXFINPER"
"IGRTTH";"S";"0236";"         FINSI"
"IGRTTH";"S";"0237";"      FINSI"
"IGRTTH";"S";"0238";"   FINSI"
