"ICOPIE";"S";"0026";"*"
"ICOPIE";"S";"0027";"* Modifiée par : Méthodes et outils"
"ICOPIE";"S";"0028";"* Date         : 27/11/2020"
"ICOPIE";"S";"0029";"* Objet        : Alimentation du filtre Jour PIXID pour export RA (en commentaire)"
"ICOPIE";"S";"0030";"*"
"ICOPIE";"S";"0031";"***********************************************************************"
"ICOPIE";"S";"0032";"* Implémentation des données industrielles"
"ICOPIE";"S";"0033";"*"
"ICOPIE";"S";"0034";"DEBDICO"
"ICOPIE";"S";"0035";"   HJOU_IJQNBADGEA;O;N2;I;0;10;    56789;;;V2;""Nombre de badgeages"";"
"ICOPIE";"S";"0036";"   HJOU_IJQPRESBAJ;N;T6,2;I;;;    56789;;;V2;""Présence badgée"";"
"ICOPIE";"S";"0037";"   HJOU_IJQHNUITBA;N;T6,2;I;;;    56789;;;V2;""Heures de nuit"";"
"ICOPIE";"S";"0038";"   *"
"ICOPIE";"S";"0039";"   * Données pour export RA PIXID"
"ICOPIE";"S";"0040";"   * EMPL_IEIMATRI;O;A10;X;;;789;;;C2;MATRICULE PIXID;"
"ICOPIE";"S";"0041";"   * HJOU_IJIPIXID;O;Z1;X;;;789;L;;C0;FILTRE JOUR EXPORT PIXID;"
"ICOPIE";"S";"0042";"   *"
"ICOPIE";"S";"0043";"FINDICO"
"ICOPIE";"S";"0044";"*"
"ICOPIE";"S";"0045";"* Déclaration des donnees locales"
"ICOPIE";"S";"0046";"*"
"ICOPIE";"S";"0047";"* recopie des valeurs internes dans le domaine HJOU"
"ICOPIE";"S";"0048";"* sont récupérés :"
"ICOPIE";"S";"0049";"*   _ le nombre de mouvements d'une personne : HJNPOIN"
"ICOPIE";"S";"0050";"*   _ le temps badg? (y compris les heures de nuit) : HJPOIN"
"ICOPIE";"S";"0051";"*   _ le temps effectu? de nuit : HJNUIT"
"ICOPIE";"S";"0052";"*"
"ICOPIE";"S";"0053";"SI HJOU_DATE <= TEMP_DATJOU"
"ICOPIE";"S";"0054";"   HJOU_IJQNBADGEA = TEMP_NXPOIN"
"ICOPIE";"S";"0055";"   HJOU_IJQPRESBAJ = TEMP_HXPOIN"
"ICOPIE";"S";"0056";"   HJOU_IJQHNUITBA = TEMP_HXNUIT"
"ICOPIE";"S";"0057";"*"
"ICOPIE";"S";"0058";"   HJOU_IJITYPCTRA = CTRA_ICITAUX"
"ICOPIE";"S";"0059";"FINSI"
"ICOPIE";"S";"0060";"*"
"ICOPIE";"S";"0061";"************************************************************"
"ICOPIE";"S";"0062";"* Gestion du filtre extraction journalier des interimaires PIXID."
"ICOPIE";"S";"0063";"************************************************************"
"ICOPIE";"S";"0064";"* Les interimaires PIXID sont identifies par un matricule PIXID identifie par donnee EMPL_IEIMATRI"
"ICOPIE";"S";"0065";"*SI EMPL_IEIMATRI <> "" """
"ICOPIE";"S";"0066";"* Interimaire identifie."
"ICOPIE";"S";"0067";"*"
"ICOPIE";"S";"0068";"* SI HJOU_IJIPIXID <> ""1"""
"ICOPIE";"S";"0069";"* Positionner le filtre actif."
"ICOPIE";"S";"0070";"*    HJOU_IJIPIXID = ""1"""
"ICOPIE";"S";"0071";"* FINSI"
"ICOPIE";"S";"0072";"*"
"ICOPIE";"S";"0073";"*SINON"
"ICOPIE";"S";"0074";"* Interimaire non identifie."
"ICOPIE";"S";"0075";"*"
"ICOPIE";"S";"0076";"*  SI HJOU_IJIPIXID <> ""0"""
"ICOPIE";"S";"0077";"* Positionner le filtre inactif."
"ICOPIE";"S";"0078";"*    HJOU_IJIPIXID = ""0"""
"ICOPIE";"S";"0079";"*  FINSI"
"ICOPIE";"S";"0080";"*"
"ICOPIE";"S";"0081";"*FINSI"
"ICOPIE";"S";"0082";"***********************************************************"
"ICOPIE";"S";"0083";"FIN"
"ICOUDE";"S";"0001";"***********************************************************************"
"ICOUDE";"S";"0002";"*"
"ICOUDE";"S";"0003";"* Règle : ICOUDE"
"ICOUDE";"S";"0004";"* Ordre : 3030"
"ICOUDE";"S";"0005";"* Titre : Coupure dejeuner"
"ICOUDE";"S";"0006";"*"
"ICOUDE";"S";"0007";"*----------------------------------------------------------------------"
"ICOUDE";"S";"0008";"*"
"ICOUDE";"S";"0009";"* Créé par : Cellule Industrialisation"
"ICOUDE";"S";"0010";"* Date     : 03/09/2009"
"ICOUDE";"S";"0011";"* Version  : 1"
"ICOUDE";"S";"0012";"*"
"ICOUDE";"S";"0013";"*----------------------------------------------------------------------"
"ICOUDE";"S";"0014";"*"
"ICOUDE";"S";"0015";"*"
"ICOUDE";"S";"0016";"* Rôle : Coupure dejeuner"
"ICOUDE";"S";"0017";"*"
"ICOUDE";"S";"0018";"*"
"ICOUDE";"S";"0019";"*"
"ICOUDE";"S";"0020";"*"
"ICOUDE";"S";"0021";"*----------------------------------------------------------------------"
"ICOUDE";"S";"0022";"*"
"ICOUDE";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"ICOUDE";"S";"0024";"* Date         : JJ/MM/AAAA"
"ICOUDE";"S";"0025";"* Objet        :"
"ICOUDE";"S";"0026";"*"
"ICOUDE";"S";"0027";"***********************************************************************"
"ICOUDE";"S";"0028";"*"
"ICOUDE";"S";"0029";"* Implémentation des données industrielles"
"ICOUDE";"S";"0030";"*"
"ICOUDE";"S";"0031";"DEBDICO"
"ICOUDE";"S";"0032";"   HJOU_IJQPAUMERI;N;T6,2;I;;;     6789;;;V3;""Pause déjeuner"";"
"ICOUDE";"S";"0033";"   HJOU_IJQECPAUSM;N;T6,2;I;;;     6789;;;V3;""Ecart pause déjeuner"";"
"ICOUDE";"S";"0034";"FINDICO"
"ICOUDE";"S";"0035";"*"
"ICOUDE";"S";"0036";"* Déclaration des donnees locales"
"ICOUDE";"S";"0037";"*"
"ICOUDE";"S";"0038";"*"
"ICOUDE";"S";"0039";"** les compteurs de la pause DJ sont dupliqués en niveau 3"
"ICOUDE";"S";"0040";"** car dans le cas d'un retour mission sur la plage dejeuner"
"ICOUDE";"S";"0041";"** sur un depart fait la veille les valeurs peuvent être modifiées"
"ICOUDE";"S";"0042";"*"
"ICOUDE";"S";"0043";"SI HJOU_DATE <= TEMP_DATJOU"
"ICOUDE";"S";"0044";"   HJOU_IJQPAUMERI = HJOU_IJQPAUMINT"
"ICOUDE";"S";"0045";"   HJOU_IJQECPAUSM = HJOU_IJQECPAUMI"
"ICOUDE";"S";"0046";"FINSI"
"ICOUDE";"S";"0047";"FIN"
"ICOUPD";"S";"0001";"***********************************************************************"
"ICOUPD";"S";"0002";"*"
"ICOUPD";"S";"0003";"* Règle : ICOUPD"
"ICOUPD";"S";"0004";"* Ordre : 2060"
"ICOUPD";"S";"0005";"* Titre : Coupure déjeuner"
"ICOUPD";"S";"0006";"*"
"ICOUPD";"S";"0007";"*----------------------------------------------------------------------"
"ICOUPD";"S";"0008";"*"
"ICOUPD";"S";"0009";"* Créé par : Cellule Industrialisation"
"ICOUPD";"S";"0010";"* Date     : 03/09/2009"
"ICOUPD";"S";"0011";"* Version  : 1"
"ICOUPD";"S";"0012";"*"
"ICOUPD";"S";"0013";"*----------------------------------------------------------------------"
"ICOUPD";"S";"0014";"*"
"ICOUPD";"S";"0015";"*"
"ICOUPD";"S";"0016";"* Rôle : Coupure déjeuner"
"ICOUPD";"S";"0017";"*"
"ICOUPD";"S";"0018";"*"
"ICOUPD";"S";"0019";"*"
"ICOUPD";"S";"0020";"*----------------------------------------------------------------------"
"ICOUPD";"S";"0021";"*"
"ICOUPD";"S";"0022";"* Modifiée par : Cellule Industrialisation"
"ICOUPD";"S";"0023";"* Date         : JJ/MM/AAAA"
"ICOUPD";"S";"0024";"* Objet        :"
"ICOUPD";"S";"0025";"*"
"ICOUPD";"S";"0026";"***********************************************************************"
"ICOUPD";"S";"0027";"*"
"ICOUPD";"S";"0028";"* Implémentation des données industrielles"
"ICOUPD";"S";"0029";"*"
"ICOUPD";"S";"0030";"DEBDICO"
"ICOUPD";"S";"0031";"   HJOU_INMISS;O;Z1;X;;;123456789;L;;C2;""Mission autorisée"";"
"ICOUPD";"S";"0032";"   TEMP_TEPGP;N;T6,2;I;;;    56789;;;V2;""Valeur de la plus grande pause"";"
"ICOUPD";"S";"0033";"   HJOU_IJQPAUMINT;N;T6,2;I;;;     6789;;;V2;""Valeur interméd. abs. plage pause mérid."";"
"ICOUPD";"S";"0034";"   HJOU_IJQECPAUMI;N;T6,2;I;;;     6789;;;V2;""Valeur intermed. écart pause méridienne"";"
"ICOUPD";"S";"0035";"   HJOU_IJQFMILPDJ;N;N2;I;;;    56789;;;V2;""Flag pause mérid. prés. h.s.bad. lend."";"
"ICOUPD";"S";"0036";"   HJOU_IJQECPAUML;N;T6,2;I;;;     6789;;;V2;""Ecart pause méridienne du lendemain"";"
"ICOUPD";"S";"0037";"FINDICO"
"ICOUPD";"S";"0038";"*"
"ICOUPD";"S";"0039";"*"
"ICOUPD";"S";"0040";"DEBANO"
"ICOUPD";"S";"0041";"   114;5;""Absence en coupure déjeuner inférieure au minimum, retrait du minimum"";"
"ICOUPD";"S";"0042";"   115;5;""Absence de badgeages dans la coupure déjeuner, retrait du minimum"";"
"ICOUPD";"S";"0043";"FINANO"
"ICOUPD";"S";"0044";"* Déclaration des donnees locales"
"ICOUPD";"S";"0045";"*"
"ICOUPD";"S";"0046";"DEF LOCA_TOTPAUSE T6.2"
"ICOUPD";"S";"0047";"LOCA_TOTPAUSE = 0"
"ICOUPD";"S";"0048";"DEF LOCA_ECREPTPG T6.2"
"ICOUPD";"S";"0049";"LOCA_ECREPTPG = 0"
"ICOUPD";"S";"0050";"DEF LOCA_REPAPGP T6.2"
"ICOUPD";"S";"0051";"LOCA_REPAPGP = 0"
"ICOUPD";"S";"0052";"DEF LOCA_ECREPTOT T6.2"
"ICOUPD";"S";"0053";"LOCA_ECREPTOT = 0"
"ICOUPD";"S";"0054";"DEF LOCA_REPATOT T6.2"
"ICOUPD";"S";"0055";"LOCA_REPATOT = 0"
"ICOUPD";"S";"0056";"DEF LOCA_ACTB N1"
"ICOUPD";"S";"0057";"LOCA_ACTB = 0"
"ICOUPD";"S";"0058";"DEF LOCA_PAUSE T6.2"
"ICOUPD";"S";"0059";"LOCA_PAUSE = 0"
"ICOUPD";"S";"0060";"DEF LOCA_SORTIE T6.2"
"ICOUPD";"S";"0061";"LOCA_SORTIE = 0"
"ICOUPD";"S";"0062";"DEF LOCA_ENTREE T6.2"
"ICOUPD";"S";"0063";"LOCA_ENTREE = 0"
"ICOUPD";"S";"0064";"DEF LOCA_MPAUSE T6.2"
"ICOUPD";"S";"0065";"LOCA_MPAUSE = 0"
"ICOUPD";"S";"0066";"DEF LOCA_DEJDEB T6.2"
"ICOUPD";"S";"0067";"LOCA_DEJDEB = 0"
"ICOUPD";"S";"0068";"DEF LOCA_DEJFIN T6.2"
"ICOUPD";"S";"0069";"LOCA_DEJFIN = 0"
"ICOUPD";"S";"0070";"DEF LOCA_TABS T6.2"
"ICOUPD";"S";"0071";"LOCA_TABS = 0"
"ICOUPD";"S";"0072";"DEF LOCA_SENS N2"
"ICOUPD";"S";"0073";"LOCA_SENS = 0"
"ICOUPD";"S";"0074";"DEF LOCA_PLAGE N2"
"ICOUPD";"S";"0075";"LOCA_PLAGE = 0"
"ICOUPD";"S";"0076";"DEF LOCA_IMPUT N2"
"ICOUPD";"S";"0077";"LOCA_IMPUT = 0"
"ICOUPD";"S";"0078";"DEF LOCA_PAUSOR T6.2"
"ICOUPD";"S";"0079";"LOCA_PAUSOR = 0"
"ICOUPD";"S";"0080";"SI HJOU_DATE <= TEMP_DATJOU"
"ICOUPD";"S";"0081";"   SI HJOU_IJQNBADGEA >= 2"
"ICOUPD";"S";"0082";"      PLAGE ""DJ"""
"ICOUPD";"S";"0083";"      SI TEMP_TYPPLA <> "" """
"ICOUPD";"S";"0084";"         SI TEMP_VALTRT1 <> 0.00"
"ICOUPD";"S";"0085";"            LOCA_DEJDEB = TEMP_VALTRT1"
"ICOUPD";"S";"0086";"            LOCA_DEJFIN = TEMP_VALTRT2"
"ICOUPD";"S";"0087";"         FINSI"
"ICOUPD";"S";"0088";"* retour mission dans la plage d?jeuner"
"ICOUPD";"S";"0089";"         SI TEMP_TEMISS = ""2"""
"ICOUPD";"S";"0090";"            ANALYSE LOCA_DEJDEB TEMP_RETOUR"
"ICOUPD";"S";"0091";"            SI TEMP_HIPOIN = 0"
"ICOUPD";"S";"0092";"* cela indique qu'il n'y a pas d'autres"
"ICOUPD";"S";"0093";"* mouvement entre le debut de la plage"
"ICOUPD";"S";"0094";"* DJ et le retour mission"
"ICOUPD";"S";"0095";"               LOCA_DEJDEB = TEMP_RETOUR"
"ICOUPD";"S";"0096";"               LOCA_ACTB = 1"
"ICOUPD";"S";"0097";"            FINSI"
"ICOUPD";"S";"0098";"         FINSI"
"ICOUPD";"S";"0099";"         ANALYSE LOCA_DEJDEB LOCA_DEJFIN"
"ICOUPD";"S";"0100";"         SI TEMP_HIPOIN <> 0"
"ICOUPD";"S";"0101";"* MOUVEMENT DE SORTIE"
"ICOUPD";"S";"0102";"            SI TEMP_HISENS = 1"
"ICOUPD";"S";"0103";"               LOCA_SENS = 1"
"ICOUPD";"S";"0104";"            FINSI"
"ICOUPD";"S";"0105";"            LOCA_PLAGE = 1"
"ICOUPD";"S";"0106";"         SINON"
"ICOUPD";"S";"0107";"            LOCA_TABS = TEMP_HIABS"
"ICOUPD";"S";"0108";"            LOCA_TOTPAUSE = TEMP_HIABS"
"ICOUPD";"S";"0109";"         FINSI"
"ICOUPD";"S";"0110";"         SI LOCA_PLAGE = 1"
"ICOUPD";"S";"0111";"            POUR POINTAGES"
"ICOUPD";"S";"0112";"               SI POIN_HRETRAI >= LOCA_DEJDEB"
"ICOUPD";"S";"0113";"                  SI POIN_HRETRAI <= LOCA_DEJFIN"
"ICOUPD";"S";"0114";"* cas ou le badgeage n'est pas une sortie mission"
"ICOUPD";"S";"0115";"                     SI POIN_IMPUT <> ""MISS"""
"ICOUPD";"S";"0116";"                        LOCA_IMPUT = 0"
"ICOUPD";"S";"0117";"                     SINON"
"ICOUPD";"S";"0118";"                        LOCA_IMPUT = 1"
"ICOUPD";"S";"0119";"                     FINSI"
"ICOUPD";"S";"0120";"* cas ou le badgeage est une sortie mission"
"ICOUPD";"S";"0121";"* mais que la personne n'est pas autorisée à"
"ICOUPD";"S";"0122";"* badger en mission dans ce cas le badgeage"
"ICOUPD";"S";"0123";"* n'est pas considéré comme une sortie mission"
"ICOUPD";"S";"0124";"                     SI POIN_IMPUT = ""MISS"""
"ICOUPD";"S";"0125";"                        SI HJOU_INMISS = ""0"""
"ICOUPD";"S";"0126";"                           LOCA_IMPUT = 0"
"ICOUPD";"S";"0127";"                        SINON"
"ICOUPD";"S";"0128";"                           LOCA_IMPUT = 1"
"ICOUPD";"S";"0129";"                        FINSI"
"ICOUPD";"S";"0130";"                     FINSI"
"ICOUPD";"S";"0131";"                     SI LOCA_IMPUT = 0"
"ICOUPD";"S";"0132";"* on rentre dans le cas ou ce n'est pas"
"ICOUPD";"S";"0133";"* un mouvement de mission"
"ICOUPD";"S";"0134";"*  mouvement de sortie"
"ICOUPD";"S";"0135";"                        SI LOCA_SENS = 1"
"ICOUPD";"S";"0136";"* on remet LOCA_ACTB à 0 dans le cas"
"ICOUPD";"S";"0137";"* ou on a eu une sortie mission"
"ICOUPD";"S";"0138";"* dans la plage DJ LOCA_ACTB est passé à 1"
"ICOUPD";"S";"0139";"* si on a eu un retour mission dans plage DJ"
"ICOUPD";"S";"0140";"* et ensuite une autre sortie non mission"
"ICOUPD";"S";"0141";"* exemple E8.00s12.00 E12.10 SM12.15 E12.20"
"ICOUPD";"S";"0142";"* S12.30 E13.30 S16.00"
"ICOUPD";"S";"0143";"* il faut que sur le mvts S12.30 ACTB = 0"
"ICOUPD";"S";"0144";"                           LOCA_ACTB = 0"
"ICOUPD";"S";"0145";"*  mouvement de sortie"
"ICOUPD";"S";"0146";"                           LOCA_SORTIE = POIN_HRETRAI"
"ICOUPD";"S";"0147";"                           SI LOCA_TOTPAUSE = 0"
"ICOUPD";"S";"0148";"* premiere sortie ds la plage sans"
"ICOUPD";"S";"0149";"* retour"
"ICOUPD";"S";"0150";"                              LOCA_TABS = LOCA_DEJFIN - LOCA_SORTIE"
"ICOUPD";"S";"0151";"                              LOCA_TOTPAUSE = LOCA_TABS"
"ICOUPD";"S";"0152";"                           SINON"
"ICOUPD";"S";"0153";"* sortie dans la plage sans retour"
"ICOUPD";"S";"0154";"                              SI LOCA_SORTIE <> LOCA_DEJFIN"
"ICOUPD";"S";"0155";"* il ne faut pas comptabiliser"
"ICOUPD";"S";"0156";"* de temps d'absence si la sortie"
"ICOUPD";"S";"0157";"* est egale à la boene de fin dejeuner"
"ICOUPD";"S";"0158";"                                 ANALYSE LOCA_SORTIE LOCA_DEJFIN"
"ICOUPD";"S";"0159";"                                 SI TEMP_HIPOIN = 1"
"ICOUPD";"S";"0160";"* si on a qu'un badgeage entre la"
"ICOUPD";"S";"0161";"* sortie et la fin de la plage DJ"
"ICOUPD";"S";"0162";"                                    LOCA_TABS = LOCA_DEJFIN - LOCA_SORTIE"
"ICOUPD";"S";"0163";"                                    LOCA_TOTPAUSE = LOCA_TOTPAUSE + LOCA_TABS"
"ICOUPD";"S";"0164";"* La locale PAUSOR est utilisée"
"ICOUPD";"S";"0165";"* pour le calcul en cours de journé"
"ICOUPD";"S";"0166";"* car lorsqu'on fait l'analyse"
"ICOUPD";"S";"0167";"* LOCA_SORTIE LOCA_DEJFIN"
"ICOUPD";"S";"0168";"* même si on a un mvt d'entree"
"ICOUPD";"S";"0169";"* entre l'leure de sortie et la fin"
"ICOUPD";"S";"0170";"* de plage DJ TEMP_HIPOIN reste à 1"
"ICOUPD";"S";"0171";"* tant qu'il n'y a pas un autre mvt"
"ICOUPD";"S";"0172";"* apres le mouvement d'entree"
"ICOUPD";"S";"0173";"                                    LOCA_PAUSOR = LOCA_TABS"
"ICOUPD";"S";"0174";"                                 FINSI"
"ICOUPD";"S";"0175";"                              FINSI"
"ICOUPD";"S";"0176";"                           FINSI"
"ICOUPD";"S";"0177";"                           LOCA_SENS = 0"
"ICOUPD";"S";"0178";"                        SINON"
"ICOUPD";"S";"0179";"*   c'est une entree"
"ICOUPD";"S";"0180";"                           LOCA_TABS = 0"
"ICOUPD";"S";"0181";"                           LOCA_ENTREE = POIN_HRETRAI"
"ICOUPD";"S";"0182";"                           SI LOCA_PAUSE = 0"
"ICOUPD";"S";"0183";"                              SI LOCA_SORTIE = 0"
"ICOUPD";"S";"0184";"                                 LOCA_SORTIE = LOCA_DEJDEB"
"ICOUPD";"S";"0185";"                              FINSI"
"ICOUPD";"S";"0186";"* premiere pause dans la plage"
"ICOUPD";"S";"0187";"                              LOCA_PAUSE = LOCA_ENTREE - LOCA_SORTIE"
"ICOUPD";"S";"0188";"* totalisation de la pause"
"ICOUPD";"S";"0189";"                              LOCA_TOTPAUSE = LOCA_PAUSE"
"ICOUPD";"S";"0190";"                           SINON"
"ICOUPD";"S";"0191";"                              SI LOCA_ACTB = 0"
"ICOUPD";"S";"0192";"* stockage de la premiere pause"
"ICOUPD";"S";"0193";"                                 LOCA_MPAUSE = LOCA_PAUSE"
"ICOUPD";"S";"0194";"* stockage de la suivante"
"ICOUPD";"S";"0195";"                                 LOCA_PAUSE = LOCA_ENTREE - LOCA_SORTIE"
"ICOUPD";"S";"0196";"* totalisation des pauses"
"ICOUPD";"S";"0197";"                                 LOCA_TOTPAUSE = LOCA_TOTPAUSE + LOCA_PAUSE"
"ICOUPD";"S";"0198";"* la variable PAUSOR est débitée"
"ICOUPD";"S";"0199";"* car elle ne sert que pour le calcul"
"ICOUPD";"S";"0200";"* intermediaire"
"ICOUPD";"S";"0201";"                                 LOCA_TOTPAUSE = LOCA_TOTPAUSE - LOCA_PAUSOR"
"ICOUPD";"S";"0202";"* on conserve la plus grande"
"ICOUPD";"S";"0203";"                                 SI LOCA_MPAUSE > LOCA_PAUSE"
"ICOUPD";"S";"0204";"                                    LOCA_PAUSE = LOCA_MPAUSE"
"ICOUPD";"S";"0205";"                                 FINSI"
"ICOUPD";"S";"0206";"                              FINSI"
"ICOUPD";"S";"0207";"                           FINSI"
"ICOUPD";"S";"0208";"*  inversion du sens du pointage"
"ICOUPD";"S";"0209";"                           LOCA_SENS = 1"
"ICOUPD";"S";"0210";"                        FINSI"
"ICOUPD";"S";"0211";"                     SINON"
"ICOUPD";"S";"0212";"* Dans le cas ou il du temps mission"
"ICOUPD";"S";"0213";"* ou de l'activite badgee et du temps"
"ICOUPD";"S";"0214";"* de presence dans la plage dejeuner"
"ICOUPD";"S";"0215";"* mais qu'il n'y a aucun temps d'absence il ne"
"ICOUPD";"S";"0216";"* faut pas decompter la duree maxi du repas"
"ICOUPD";"S";"0217";"* mais la duree mini."
"ICOUPD";"S";"0218";"                        LOCA_ACTB = 1"
"ICOUPD";"S";"0219";"                        LOCA_SENS = 0"
"ICOUPD";"S";"0220";"                     FINSI"
"ICOUPD";"S";"0221";"                  FINSI"
"ICOUPD";"S";"0222";"               FINSI"
"ICOUPD";"S";"0223";"            FINPOUR"
"ICOUPD";"S";"0224";"         FINSI"
"ICOUPD";"S";"0225";"         SI LOCA_TABS > LOCA_PAUSE"
"ICOUPD";"S";"0226";"            TEMP_TEPGP = LOCA_TABS"
"ICOUPD";"S";"0227";"         SINON"
"ICOUPD";"S";"0228";"            TEMP_TEPGP = LOCA_PAUSE"
"ICOUPD";"S";"0229";"         FINSI"
"ICOUPD";"S";"0230";"* loca_totpause correspond au total des pauses"
"ICOUPD";"S";"0231";"* temp_tepg à la plus grande des pauses"
"ICOUPD";"S";"0232";"* calcul des ecarts par rapport a la coupure mini"
"ICOUPD";"S";"0233";"* pour la plus grande pause"
"ICOUPD";"S";"0234";"         SI TEMP_TEPGP < PROF_COUPMIN"
"ICOUPD";"S";"0235";"            LOCA_ECREPTPG = PROF_COUPMIN - TEMP_TEPGP"
"ICOUPD";"S";"0236";"            SI TEMP_TEPGP > 0"
"ICOUPD";"S";"0237";"               SI PARD_IDIGNPAUSM = ""1"""
"ICOUPD";"S";"0238";"                  ANOMALIE 114"
"ICOUPD";"S";"0239";"               FINSI"
"ICOUPD";"S";"0240";"            FINSI"
"ICOUPD";"S";"0241";"         FINSI"
"ICOUPD";"S";"0242";"         LOCA_REPAPGP = TEMP_TEPGP"
"ICOUPD";"S";"0243";"* calcul des ecarts par rapport a la coupure mini"
"ICOUPD";"S";"0244";"* pour le total des pauses"
"ICOUPD";"S";"0245";"         SI LOCA_TOTPAUSE < PROF_COUPMIN"
"ICOUPD";"S";"0246";"            LOCA_ECREPTOT = PROF_COUPMIN - LOCA_TOTPAUSE"
"ICOUPD";"S";"0247";"            SI LOCA_TOTPAUSE > 0"
"ICOUPD";"S";"0248";"               ANOMALIE 114"
"ICOUPD";"S";"0249";"            FINSI"
"ICOUPD";"S";"0250";"         FINSI"
"ICOUPD";"S";"0251";"         LOCA_REPATOT = LOCA_TOTPAUSE"
"ICOUPD";"S";"0252";"* alimentation des compteurs"
"ICOUPD";"S";"0253";"         SI PARD_IDIGNPAUSM = ""1"""
"ICOUPD";"S";"0254";"* cas ou on retire la plus grande pause"
"ICOUPD";"S";"0255";"            HJOU_IJQPAUMINT = LOCA_REPAPGP"
"ICOUPD";"S";"0256";"            HJOU_IJQECPAUMI = LOCA_ECREPTPG"
"ICOUPD";"S";"0257";"         SINON"
"ICOUPD";"S";"0258";"* cas ou on retire le total des pauses"
"ICOUPD";"S";"0259";"            HJOU_IJQPAUMINT = LOCA_REPATOT"
"ICOUPD";"S";"0260";"            HJOU_IJQECPAUMI = LOCA_ECREPTOT"
"ICOUPD";"S";"0261";"         FINSI"
"ICOUPD";"S";"0262";"* si pas d'absence en coupure dejeuner"
"ICOUPD";"S";"0263";"         SI LOCA_TOTPAUSE = 0"
"ICOUPD";"S";"0264";"            SI HJOU_IJQPAUMINT = 0"
"ICOUPD";"S";"0265";"               SI PARD_IDIGDPAUSM = ""0"""
"ICOUPD";"S";"0266";"*  on retire le minimum"
"ICOUPD";"S";"0267";"                  HJOU_IJQECPAUMI = PROF_COUPMIN"
"ICOUPD";"S";"0268";"                  SI LOCA_ACTB = 0"
"ICOUPD";"S";"0269";"                     ANOMALIE 115"
"ICOUPD";"S";"0270";"                  SINON"
"ICOUPD";"S";"0271";"                     ANOMALIE 114"
"ICOUPD";"S";"0272";"                  FINSI"
"ICOUPD";"S";"0273";"               SINON"
"ICOUPD";"S";"0274";"* on retire le maxi"
"ICOUPD";"S";"0275";"                  SI LOCA_ACTB = 0"
"ICOUPD";"S";"0276";"                     HJOU_IJQECPAUMI = PROF_COUPMAX"
"ICOUPD";"S";"0277";"                     ANOMALIE 121"
"ICOUPD";"S";"0278";"                     SI PROF_COUPMAX = 0"
"ICOUPD";"S";"0279";"                        HJOU_IJQECPAUMI = PROF_COUPMIN"
"ICOUPD";"S";"0280";"                     FINSI"
"ICOUPD";"S";"0281";"                  SINON"
"ICOUPD";"S";"0282";"* Dans le cas ou il du temps mission ou activite et"
"ICOUPD";"S";"0283";"* du temps de presence dans la plage dejeuner"
"ICOUPD";"S";"0284";"* mais qu'il n'y a aucun temps d'absence il ne"
"ICOUPD";"S";"0285";"* faut pas decompter la duree maxi du repas"
"ICOUPD";"S";"0286";"* mais la dur?e mini."
"ICOUPD";"S";"0287";"                     HJOU_IJQECPAUMI = PROF_COUPMIN"
"ICOUPD";"S";"0288";"                     ANOMALIE 114"
"ICOUPD";"S";"0289";"                  FINSI"
"ICOUPD";"S";"0290";"               FINSI"
"ICOUPD";"S";"0291";"            FINSI"
"ICOUPD";"S";"0292";"         FINSI"
"ICOUPD";"S";"0293";"*  pas de calcul de pause dejeuner et de complement"
"ICOUPD";"S";"0294";"*  si la pause dejeuner ? ete decompt? sur le temps"
"ICOUPD";"S";"0295";"*  mission ,sur l'activit? badg?e"
"ICOUPD";"S";"0296";"*  ou si depart mission avant la fin plage dejeuner"
"ICOUPD";"S";"0297";"*  et qu'il n'y a pas de retour"
"ICOUPD";"S";"0298";"         SI HJOU_IJQFMISPDJ = 1"
"ICOUPD";"S";"0299";"         OU HJOU_IJQFMILPDJ = 1"
"ICOUPD";"S";"0300";"            HJOU_IJQPAUMINT = 0"
"ICOUPD";"S";"0301";"            HJOU_IJQECPAUMI = 0"
"ICOUPD";"S";"0302";"         FINSI"
"ICOUPD";"S";"0303";"* Dans le cas ou le premier mouvement d'entree"
"ICOUPD";"S";"0304";"* est dans la plage DJ et qu'il n'existe pas d'autres"
"ICOUPD";"S";"0305";"* mvts dans la plage on alimente le compteur HJECREPL"
"ICOUPD";"S";"0306";"* dans le cas ou se serait un retour mission sur un depart fait"
"ICOUPD";"S";"0307";"* la veille , il faudra alimenter l'ecart repas avec la duree"
"ICOUPD";"S";"0308";"* de la pause minimum"
"ICOUPD";"S";"0309";"         SI PROF_IPIVMISSDV > 0"
"ICOUPD";"S";"0310";"            SI HJOU_INMISS = ""2"""
"ICOUPD";"S";"0311";"            OU HJOU_INMISS = ""3"""
"ICOUPD";"S";"0312";"               SI TEMP_TEMISS <> ""2"""
"ICOUPD";"S";"0313";"* test si on a pas de mouvement avant la"
"ICOUPD";"S";"0314";"* plage dejeuner"
"ICOUPD";"S";"0315";"                  ANALYSE 0.00 LOCA_DEJDEB"
"ICOUPD";"S";"0316";"                  SI TEMP_HIPOIN = 0"
"ICOUPD";"S";"0317";"                     ANALYSE LOCA_DEJDEB LOCA_DEJFIN"
"ICOUPD";"S";"0318";"* si on a qu'un mouvement d'entree dans la plage"
"ICOUPD";"S";"0319";"                     SI TEMP_HIPOIN = 1"
"ICOUPD";"S";"0320";"                        SI TEMP_HISENS = 0"
"ICOUPD";"S";"0321";"                           HJOU_IJQECPAUML = PROF_COUPMIN"
"ICOUPD";"S";"0322";"                        FINSI"
"ICOUPD";"S";"0323";"                     FINSI"
"ICOUPD";"S";"0324";"                  FINSI"
"ICOUPD";"S";"0325";"               FINSI"
"ICOUPD";"S";"0326";"            FINSI"
"ICOUPD";"S";"0327";"         FINSI"
"ICOUPD";"S";"0328";"      FINSI"
"ICOUPD";"S";"0329";"   FINSI"
"ICOUPD";"S";"0330";"FINSI"
"ICOUPD";"S";"0331";"FIN"
"ICPJOU";"S";"0001";"***********************************************************************"
"ICPJOU";"S";"0002";"*"
"ICPJOU";"S";"0003";"* Règle : ICPJOU"
"ICPJOU";"S";"0004";"* Ordre : 3190"
"ICPJOU";"S";"0005";"* Titre : Calcul des compteurs journaliers"
"ICPJOU";"S";"0006";"*"
"ICPJOU";"S";"0007";"*----------------------------------------------------------------------"
"ICPJOU";"S";"0008";"*"
"ICPJOU";"S";"0009";"* Créé par : Cellule Industrialisation"
"ICPJOU";"S";"0010";"* Date     : 03/09/2009"
"ICPJOU";"S";"0011";"* Version  : 1"
"ICPJOU";"S";"0012";"*"
"ICPJOU";"S";"0013";"*----------------------------------------------------------------------"
"ICPJOU";"S";"0014";"*"
"ICPJOU";"S";"0015";"*"
"ICPJOU";"S";"0016";"* Rôle : Calcul des compteurs journaliers"
"ICPJOU";"S";"0017";"*"
"ICPJOU";"S";"0018";"*"
"ICPJOU";"S";"0019";"*"
"ICPJOU";"S";"0020";"*----------------------------------------------------------------------"
"ICPJOU";"S";"0021";"*"
"ICPJOU";"S";"0022";"* Modifiée par : Cellule Industrialisation"
"ICPJOU";"S";"0023";"* Date         : JJ/MM/AAAA"
"ICPJOU";"S";"0024";"* Objet        :"
"ICPJOU";"S";"0025";"*"
"ICPJOU";"S";"0026";"***********************************************************************"
"ICPJOU";"S";"0027";"*"
"ICPJOU";"S";"0028";"*"
"ICPJOU";"S";"0029";"* Implémentation des données industrielles"
"ICPJOU";"S";"0030";"*"
"ICPJOU";"S";"0031";"DEBDICO"
"ICPJOU";"S";"0032";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"ICPJOU";"S";"0033";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"ICPJOU";"S";"0034";"   HJOU_IJQPRESBAV;N;T6,2;I;;;    56789;;;V3;""Présence badgée validée"";"
"ICPJOU";"S";"0035";"FINDICO"
"ICPJOU";"S";"0036";"*"
"ICPJOU";"S";"0037";"* Déclaration des donnees locales"
"ICPJOU";"S";"0038";"*"
"ICPJOU";"S";"0039";"DEF LOCA_INBADG Z1"
"ICPJOU";"S";"0040";"LOCA_INBADG = ""0"""
"ICPJOU";"S";"0041";"* si on est dans le futur"
"ICPJOU";"S";"0042";"* on positionne la variable INBADG à 0"
"ICPJOU";"S";"0043";"* ce qui permet de traiter les badgeants comme des non badgeants"
"ICPJOU";"S";"0044";"* afin d'alimenter une présence badgéé fictive (HJPOINV)qui correspond"
"ICPJOU";"S";"0045";"* à la théorie - les motifs d'absences non créditeur"
"ICPJOU";"S";"0046";"SI HJOU_DATE <= TEMP_DATJOU"
"ICPJOU";"S";"0047";"   LOCA_INBADG = HJOU_IJIGBADGEA"
"ICPJOU";"S";"0048";"* Modif le 21/03/07"
"ICPJOU";"S";"0049";"* pour les badgeants qui declarent leur présence"
"ICPJOU";"S";"0050";"* par la consigne XPRES , ils sont gérés comme des non-badgeant"
"ICPJOU";"S";"0051";"   POUR ACTIVITES"
"ICPJOU";"S";"0052";"      SI HABS_MOTIF = ""XPRES"""
"ICPJOU";"S";"0053";"         LOCA_INBADG = ""0"""
"ICPJOU";"S";"0054";"      FINSI"
"ICPJOU";"S";"0055";"   FINPOUR"
"ICPJOU";"S";"0056";"* Modif le 29/03/07 pour les badgeants qui declarent leur presence"
"ICPJOU";"S";"0057";"* en faisant 1 seul mouvement , il faut que dans le profil horaire"
"ICPJOU";"S";"0058";"* le nombre minimum de badgeage = 1"
"ICPJOU";"S";"0059";"   SI PROF_IPIVMINBAD = 1"
"ICPJOU";"S";"0060";"      SI HJOU_IJQNBADGEA = 1"
"ICPJOU";"S";"0061";"         LOCA_INBADG = ""0"""
"ICPJOU";"S";"0062";"      FINSI"
"ICPJOU";"S";"0063";"   FINSI"
"ICPJOU";"S";"0064";"SINON"
"ICPJOU";"S";"0065";"   LOCA_INBADG = ""0"""
"ICPJOU";"S";"0066";"FINSI"
"ICPJOU";"S";"0067";"*** calcul de la presence jour le 16/05/2010"
"ICPJOU";"S";"0068";"SI LOCA_INBADG = ""1"""
"ICPJOU";"S";"0069";"   TEMP_ITQPRESJOU = HJOU_IJQPRESBAJ"
"ICPJOU";"S";"0070";"   POUR ACTIVITES"
"ICPJOU";"S";"0071";"      SI HABS_MOTYPE = ""P"""
"ICPJOU";"S";"0072";"         TEMP_ITQPRESJOU = TEMP_ITQPRESJOU + HABS_MOTIDUR"
"ICPJOU";"S";"0073";"      FINSI"
"ICPJOU";"S";"0074";"   FINPOUR"
"ICPJOU";"S";"0075";"SINON"
"ICPJOU";"S";"0076";"   TEMP_ITQPRESJOU = HJOU_IJQPRETHEJ"
"ICPJOU";"S";"0077";"   POUR ACTIVITES"
"ICPJOU";"S";"0078";"      SI HABS_MOTYPE = ""A"""
"ICPJOU";"S";"0079";"         TEMP_ITQPRESJOU = TEMP_ITQPRESJOU - HABS_MOTIDUR"
"ICPJOU";"S";"0080";"      FINSI"
"ICPJOU";"S";"0081";"   FINPOUR"
"ICPJOU";"S";"0082";"FINSI"
"ICPJOU";"S";"0083";"*  heures totales avant écrétement"
"ICPJOU";"S";"0084";"HJOU_IJQBHORVAJ = HJOU_IJQPRESBAJ"
"ICPJOU";"S";"0085";"*  déduction écart pause DJ"
"ICPJOU";"S";"0086";"HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQECPAUMI"
"ICPJOU";"S";"0087";"*  rajout du débordement"
"ICPJOU";"S";"0088";"SI PROF_IPIGDEBORD = ""1"""
"ICPJOU";"S";"0089";"   HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQHEXCEDJ"
"ICPJOU";"S";"0090";"FINSI"
"ICPJOU";"S";"0091";"*  alimentation d'un compteur avec la presence point?e valid?e"
"ICPJOU";"S";"0092";"HJOU_IJQPRESBAV = HJOU_IJQBHORVAJ"
"ICPJOU";"S";"0093";"*  Alimentation des heures totales par les"
"ICPJOU";"S";"0094";"*  le compteur des heures non badg?es cr?dit?es"
"ICPJOU";"S";"0095";"HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPRESNBJ"
"ICPJOU";"S";"0096";"*  gestion des non-badgeant : affectation de la th?orie"
"ICPJOU";"S";"0097";"*  - absences ne participant pas aux heures totales"
"ICPJOU";"S";"0098";"SI LOCA_INBADG = ""0"""
"ICPJOU";"S";"0099";"   HJOU_IJQBHORVAJ = HJOU_IJQPRETHEJ"
"ICPJOU";"S";"0100";"   HJOU_IJQPRESBAV = HJOU_IJQPRETHEJ"
"ICPJOU";"S";"0101";"   POUR ACTIVITES"
"ICPJOU";"S";"0102";"      SI MOTI_MOTYPE <> ""C"""
"ICPJOU";"S";"0103";"         SI MOTI_IMIGDEBCRE = ""0"""
"ICPJOU";"S";"0104";"            HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HABS_MOTIDUR"
"ICPJOU";"S";"0105";"         FINSI"
"ICPJOU";"S";"0106";"*"
"ICPJOU";"S";"0107";"         SI MOTI_IMIGCREDNB <> ""1"""
"ICPJOU";"S";"0108";"            HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HABS_MOTIDUR"
"ICPJOU";"S";"0109";"         FINSI"
"ICPJOU";"S";"0110";"* CPN 14/01/21 - ne pas doubler les compteurs"
"ICPJOU";"S";"0111";"         *SI MOTI_IMIGCREDNB = ""1"""
"ICPJOU";"S";"0112";"            *HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HABS_MOTIDUR"
"ICPJOU";"S";"0113";"         *FINSI"
"ICPJOU";"S";"0114";"      FINSI"
"ICPJOU";"S";"0115";"   FINPOUR"
"ICPJOU";"S";"0116";"FINSI"
"ICPJOU";"S";"0117";"FIN"
"ICPTPLANIF";"S";"0001";"***********************************************************************"
"ICPTPLANIF";"S";"0002";"*"
"ICPTPLANIF";"S";"0003";"* Règle : ICPTPLANIF"
"ICPTPLANIF";"S";"0004";"* Ordre : 8040"
"ICPTPLANIF";"S";"0005";"* Titre : Aide à la création des compteurs PL-OP"
"ICPTPLANIF";"S";"0006";"*"
"ICPTPLANIF";"S";"0007";"*----------------------------------------------------------------------"
"ICPTPLANIF";"S";"0008";"*"
"ICPTPLANIF";"S";"0009";"* Créé par : Cellule Industrialisation"
"ICPTPLANIF";"S";"0010";"* Date     : 16/11/2017"
"ICPTPLANIF";"S";"0011";"* Version  : 1"
"ICPTPLANIF";"S";"0012";"*"
"ICPTPLANIF";"S";"0013";"*----------------------------------------------------------------------"
"ICPTPLANIF";"S";"0014";"*"
"ICPTPLANIF";"S";"0015";"*"
"ICPTPLANIF";"S";"0016";"* Rôle : Faciliter la création de certains compteurs utilisés dans les"
"ICPTPLANIF";"S";"0017";"*        modules PL et OP"
"ICPTPLANIF";"S";"0018";"*"
"ICPTPLANIF";"S";"0019";"*        Cette règle est volontairement désactivée et non compilée."
"ICPTPLANIF";"S";"0020";"*        Les compteurs listés ci-dessous ne sont pas créés volontairement"
"ICPTPLANIF";"S";"0021";"*        dans DIC afin de ne pas surcharger le dictionnaire."
"ICPTPLANIF";"S";"0022";"*----------------------------------------------------------------------"
"ICPTPLANIF";"S";"0023";"*"
"ICPTPLANIF";"S";"0024";"* Modifiée par : Méthodes et outils"
"ICPTPLANIF";"S";"0025";"* Date         : 15/11/2019"
"ICPTPLANIF";"S";"0026";"* Objet        : Ajout de deux nouvelles données, CTRA_ICITYPTRAN"
"ICPTPLANIF";"S";"0027";"*                 (Type de transfert) et HJOU_IJQBCTVAR"
"ICPTPLANIF";"S";"0028";"*                 (Cible hebdo des semaines type variation)"
"ICPTPLANIF";"S";"0029";"*"
"ICPTPLANIF";"S";"0030";"***********************************************************************"
"ICPTPLANIF";"S";"0031";"*"
"ICPTPLANIF";"S";"0032";"* Implémentation des données industrielles"
"ICPTPLANIF";"S";"0033";"*"
"ICPTPLANIF";"S";"0034";"DEBDICO"
"ICPTPLANIF";"S";"0035";"   *"
"ICPTPLANIF";"S";"0036";"   ***ONGLET PLANIFICATION LONG TERME ***"
"ICPTPLANIF";"S";"0037";"   *"
"ICPTPLANIF";"S";"0038";"   *HJOU_IJIBCTMODU;N;T6,2;I;;;123456789;;;C3;""Base contrat modul."";"
"ICPTPLANIF";"S";"0039";"   *EMPL_IEIMODUL;O;A1;X;;;123456789;;;C0;""Indicateur modulation"";"
"ICPTPLANIF";"S";"0040";"   *HJOU_IJIAFFSEM;N;A1;X;0;2;123456789;;;C3;""Indic. affect. semaine"";"
"ICPTPLANIF";"S";"0041";"   *CTRA_ICICTRSEMT;O;A10;X;;;123456789;L;;C3;""Semaine type du contrat"";"
"ICPTPLANIF";"S";"0042";"   *HJOU_IJIVALSEM;N;A1;X;;;123456789;;;C0;""Validation semaine"";"
"ICPTPLANIF";"S";"0043";"   *HJOU_IJISAISEM;N;A1;X;;;123456789;;;C3;""Indic. saisie semaine"";"
"ICPTPLANIF";"S";"0044";"   *CTRA_ICITPSPART;N;A1;X;;;123456789;L;;C3;""Indic. temps partiel  "";"
"ICPTPLANIF";"S";"0045";"   *MOTI_IMIMODULT;N;A1;X;0;1;123456789;;;C3;""Indic. abs. modul. "";"
"ICPTPLANIF";"S";"0046";"   *"
"ICPTPLANIF";"S";"0047";"   ***ONGLET ANNUALISATION DES CONTRATS***"
"ICPTPLANIF";"S";"0048";"   *"
"ICPTPLANIF";"S";"0049";"   *HJOU_IJQCTRMIN;O;T6,2;I;;;123456789;;;C0;""Mini contrat annualisation"";"
"ICPTPLANIF";"S";"0050";"   *HJOU_IJQCTRBASE;O;T6,2;I;;;123456789;;;C0;""Base contrat annualisation"";"
"ICPTPLANIF";"S";"0051";"   *HJOU_IJQCTRMAX;O;T6,2;I;;;123456789;;;C0;""Maxi contrat annualisation"";"
"ICPTPLANIF";"S";"0052";"   *HJOU_IJINDICTRA;O;A1;X;0;1;123456789;;;C0;""Indicateur de surcharge"";"
"ICPTPLANIF";"S";"0053";"   *"
"ICPTPLANIF";"S";"0054";"   ***ONGLET DIVERS***"
"ICPTPLANIF";"S";"0055";"   *"
"ICPTPLANIF";"S";"0056";"   *TRAITEMENT DES POSTES"
"ICPTPLANIF";"S";"0057";"   *"
"ICPTPLANIF";"S";"0058";"   *POST_INTPO2J;O;Z1;X;0;1;132456789;;;C0;""Interdire poste sur 2 jours contigus"";"
"ICPTPLANIF";"S";"0059";"   *POST_MAXPOH;O;N2;I;;;123456789;;;C0;""Nb maxi affectation semaine"";"
"ICPTPLANIF";"S";"0060";"   *"
"ICPTPLANIF";"S";"0061";"   *TRAITEMENT DES MOTIFS"
"ICPTPLANIF";"S";"0063";"   *MOTI_IMICHEVAU;O;A1;X;0;1;123456789;;;C3;""Chevauchement du motif"";"
"ICPTPLANIF";"S";"0064";"   *MOTI_IMIINSERT;O;A1;X;0;1;123456789;;;C3;""Insertion du motif"";"
"ICPTPLANIF";"S";"0065";"   *"
"ICPTPLANIF";"S";"0066";"   *TRAITEMENT DE LA PALETTE"
"ICPTPLANIF";"S";"0067";"   *"
