"ITPSACTHTC";"S";"0102";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHTC";"S";"0103";"        FINSI"
"ITPSACTHTC";"S";"0104";"    FINSI"
"ITPSACTHTC";"S";"0105";"FINSI"
