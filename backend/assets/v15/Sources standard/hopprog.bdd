"IINITC";"S";"0026";"*"
"IINITC";"S";"0027";"***********************************************************************"
"IINITC";"S";"0028";"*"
"IINITC";"S";"0029";"* Implémentation des données industrielles"
"IINITC";"S";"0030";"*"
"IINITC";"S";"0031";"DEBDICO"
"IINITC";"S";"0032";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"IINITC";"S";"0033";"FINDICO"
"IINITC";"S";"0034";"*"
"IINITC";"S";"0035";"*"
"IINITC";"S";"0036";"* Déclaration des donnees locales"
"IINITC";"S";"0037";"*"
"IINITC";"S";"0038";"POUR ACTIVITES"
"IINITC";"S";"0039";"   SI HABS_MOTIF = ""XJOU"""
"IINITC";"S";"0040";"      HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HABS_MOTIDUR"
"IINITC";"S";"0041";"   FINSI"
"IINITC";"S";"0042";"   SI HABS_MOTIF = ""ZJOU"""
"IINITC";"S";"0043";"      HJOU_IJQBHORVAJ = HABS_MOTIDUR"
"IINITC";"S";"0044";"   FINSI"
"IINITC";"S";"0045";"FINPOUR"
"IINITC";"S";"0046";"SI HJOU_IJQBHORVAJ < 0"
"IINITC";"S";"0047";"   HJOU_IJQBHORVAJ = 0"
"IINITC";"S";"0048";"FINSI"
"IINITC";"S";"0049";"FIN"
"IMISSB";"S";"0001";"***********************************************************************"
"IMISSB";"S";"0002";"*"
"IMISSB";"S";"0003";"* Règle : IMISSB"
"IMISSB";"S";"0004";"* Ordre : 3230"
"IMISSB";"S";"0005";"* Titre : Durée mission"
"IMISSB";"S";"0006";"*"
"IMISSB";"S";"0007";"*----------------------------------------------------------------------"
"IMISSB";"S";"0008";"*"
"IMISSB";"S";"0009";"* Créé par : Cellule Industrialisation"
"IMISSB";"S";"0010";"* Date     : 03/09/2009"
"IMISSB";"S";"0011";"* Version  : 1"
"IMISSB";"S";"0012";"*"
"IMISSB";"S";"0013";"*----------------------------------------------------------------------"
"IMISSB";"S";"0015";"*"
"IMISSB";"S";"0016";"* Rôle : Durée mission"
"IMISSB";"S";"0017";"*"
"IMISSB";"S";"0018";"*"
"IMISSB";"S";"0019";"*"
"IMISSB";"S";"0020";"* Implémentation des données industrielles"
"IMISSB";"S";"0021";"*"
"IMISSB";"S";"0022";"*"
"IMISSB";"S";"0023";"*----------------------------------------------------------------------"
"IMISSB";"S";"0024";"*"
"IMISSB";"S";"0025";"* Modifiée par : Méthodes et outils"
"IMISSB";"S";"0026";"* Date         : 28/08/2018"
"IMISSB";"S";"0027";"* Objet        :"
"IMISSB";"S";"0028";"*"
"IMISSB";"S";"0029";"***********************************************************************"
"IMISSB";"S";"0030";"*"
"IMISSB";"S";"0031";"DEBDICO"
"IMISSB";"S";"0032";"   HJOU_IJRF3PRBHS;N;Z1;X;0;9;    56789;;IJRF3PRBHS;V3;""Flag prés. b. h.s. sur x jours (N3)"";"
"IMISSB";"S";"0033";"   HJOU_IJQPAUMERI;N;T6,2;I;;;     6789;;;V3;""Pause déjeuner"";"
"IMISSB";"S";"0034";"   HJOU_IJQECPAUSM;N;T6,2;I;;;     6789;;;V3;""Ecart pause déjeuner"";"
"IMISSB";"S";"0035";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"IMISSB";"S";"0036";"   HJOU_IJQPRESBAV;N;T6,2;I;;;    56789;;;V3;""Présence badgée validée"";"
"IMISSB";"S";"0037";"   HJOU_INMISS;O;Z1;X;;;123456789;L;;C2;""Mission autorisée"";"
"IMISSB";"S";"0038";"   HJOU_IJQHMISSJE;N;T6,2;I;;;    56789;;;V3;""Durée mission jour en cours"";"
"IMISSB";"S";"0039";"   HJOU_IJQNABSENT;N;N2;I;;;    56789;;;V3;""Nombre d absences totales"";"
"IMISSB";"S";"0040";"   HJOU_IJQNACTIVJ;N;N2;I;;;    56789;;;V3;""Nombre d activités"";"
"IMISSB";"S";"0041";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"IMISSB";"S";"0042";"FINDICO"
"IMISSB";"S";"0043";"*"
"IMISSB";"S";"0044";"DEBANO"
"IMISSB";"S";"0045";"   114;5;""Absence en coupure déjeuner inférieure au minimum, retrait du minimum"";"
"IMISSB";"S";"0046";"FINANO"
"IMISSB";"S";"0047";"* Déclaration des donnees locales"
"IMISSB";"S";"0048";"*"
"IMISSB";"S";"0049";"DEF LOCA_MISSBAD A10"
"IMISSB";"S";"0050";"LOCA_MISSBAD = "" """
"IMISSB";"S";"0051";"DEF LOCA_MISSBADL A10"
"IMISSB";"S";"0052";"LOCA_MISSBADL = "" """
"IMISSB";"S";"0053";"DEF LOCA_MOTJOUR N1"
"IMISSB";"S";"0054";"LOCA_MOTJOUR = 0"
"IMISSB";"S";"0055";"DEF LOCA_TOTMISS T6.2"
"IMISSB";"S";"0056";"LOCA_TOTMISS = 0"
"IMISSB";"S";"0057";"DEF LOCA_ABS N1"
"IMISSB";"S";"0058";"LOCA_ABS = 0"
"IMISSB";"S";"0059";"DEF LOCA_ACTM N1"
"IMISSB";"S";"0060";"LOCA_ACTM = 0"
"IMISSB";"S";"0061";"*"
"IMISSB";"S";"0062";"SI HJOU_IJRF3PRBHS = ""1"""
"IMISSB";"S";"0063";"   LOCA_TOTMISS = HJOU_IJQMISSRET"
"IMISSB";"S";"0064";"FINSI"
"IMISSB";"S";"0065";"LOCA_TOTMISS = LOCA_TOTMISS + HJOU_IJQMISBADG"
"IMISSB";"S";"0066";"SI PARD_IDIVMOMIBL = "" """
"IMISSB";"S";"0067";"   LOCA_MISSBADL = ""MISS"""
"IMISSB";"S";"0068";"SINON"
"IMISSB";"S";"0069";"   LOCA_MISSBADL = PARD_IDIVMOMIBL"
"IMISSB";"S";"0070";"FINSI"
"IMISSB";"S";"0071";"SI PARD_IDIVMOMISB = "" """
"IMISSB";"S";"0072";"   LOCA_MISSBAD = ""MISS"""
"IMISSB";"S";"0073";"SINON"
"IMISSB";"S";"0074";"   LOCA_MISSBAD = PARD_IDIVMOMISB"
"IMISSB";"S";"0075";"FINSI"
"IMISSB";"S";"0076";"ENLEVER LOCA_MISSBAD"
"IMISSB";"S";"0077";"ENLEVER LOCA_MISSBADL"
"IMISSB";"S";"0078";"SI HJOU_DATE <= TEMP_DATJOU"
"IMISSB";"S";"0079";"* si le compteur HJECREPL > 0 cela indique"
"IMISSB";"S";"0080";"* que le premier mouvement de la journée"
"IMISSB";"S";"0081";"* est une entree dans la plage DJ"
"IMISSB";"S";"0082";"* et qu'il n'y a pas d'autres mvts dans la plage DJ"
"IMISSB";"S";"0083";"* si HJMISSR = 1 cela veut dire que c'est un retour"
"IMISSB";"S";"0084";"* mission sur un depart fait la veille et dans ce cas"
"IMISSB";"S";"0085";"* l'ecart pause repas doit être alimenté avaec la valeur de"
"IMISSB";"S";"0086";"* la coupure minimum"
"IMISSB";"S";"0087";"   SI HJOU_IJRF3PRBHS = ""1"""
"IMISSB";"S";"0088";"      SI HJOU_IJQECPAUML > 0"
"IMISSB";"S";"0089";"* test si pas d'absence matin"
"IMISSB";"S";"0090";"         POUR ACTIVITES"
"IMISSB";"S";"0091";"            SI HABS_VALORIS = ""M"""
"IMISSB";"S";"0092";"               LOCA_ACTM = 1"
"IMISSB";"S";"0093";"            FINSI"
"IMISSB";"S";"0094";"         FINPOUR"
"IMISSB";"S";"0095";"         SI LOCA_ACTM = 0"
"IMISSB";"S";"0096";"            HJOU_IJQPAUMERI = 0"
"IMISSB";"S";"0097";"            HJOU_IJQECPAUSM = HJOU_IJQECPAUML"
"IMISSB";"S";"0098";"            HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQECPAUSM"
"IMISSB";"S";"0099";"            HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQECPAUSM"
"IMISSB";"S";"0100";"            ANOMALIE 114"
"IMISSB";"S";"0101";"         FINSI"
"IMISSB";"S";"0102";"      FINSI"
"IMISSB";"S";"0103";"   FINSI"
"IMISSB";"S";"0104";"** alimentation de la donnée reportable HJMISSR"
"IMISSB";"S";"0105";"** avec la valeur de la donnée HJMISS"
"IMISSB";"S";"0106";"** on test avant si hjnpoin > 0 pour recuperer la"
"IMISSB";"S";"0107";"** valeur de HJMISS car il ne faut pas stocker la"
"IMISSB";"S";"0108";"** valeur de HJMISS sur le jour ou on a pas de badgeage"
"IMISSB";"S";"0109";"** car même si la veille elle etait initialisée à 1"
"IMISSB";"S";"0110";"** le lendemain, comme la valeur du report n'est pas alimentée, on"
"IMISSB";"S";"0111";"** stockerai 0 dans HJMISSR"
"IMISSB";"S";"0112";"   SI HJOU_IJQNBADGEA > 0"
"IMISSB";"S";"0113";"      HJOU_IJRF3PRBHS = HJOU_IJRF2PRBHS"
"IMISSB";"S";"0114";"   FINSI"
"IMISSB";"S";"0115";"   SI HJOU_INMISS = ""2"""
"IMISSB";"S";"0116";"   OU HJOU_INMISS = ""3"""
"IMISSB";"S";"0117";"      SI HJOU_IJRF3PRBHS = ""1"""
"IMISSB";"S";"0118";"         SI HJOU_IJQNBADGEA = 0"
"IMISSB";"S";"0119";"            LOCA_TOTMISS = HJOU_IJQPRETHEJ"
"IMISSB";"S";"0120";"            LOCA_ABS = 1"
"IMISSB";"S";"0121";"         FINSI"
"IMISSB";"S";"0122";"      FINSI"
"IMISSB";"S";"0123";"   FINSI"
"IMISSB";"S";"0124";"*  si l'indicateur INMISSBA = 1 cela indique"
"IMISSB";"S";"0125";"*  qu'il y a eu un depart mission sans retour sur la journee"
"IMISSB";"S";"0126";"*  et que le temps mission doit etre complete par rapport"
"IMISSB";"S";"0127";"*  a la theorie  en tenant compte de HJJOU"
"IMISSB";"S";"0128";"   SI HJOU_IJQFMISBAD = 1"
"IMISSB";"S";"0129";"      SI HJOU_IJQBHORVAJ < HJOU_IJQPRETHEJ"
"IMISSB";"S";"0130";"         LOCA_TOTMISS = HJOU_IJQPRETHEJ - HJOU_IJQBHORVAJ"
"IMISSB";"S";"0131";"      SINON"
"IMISSB";"S";"0132";"         LOCA_TOTMISS = 0"
"IMISSB";"S";"0133";"      FINSI"
"IMISSB";"S";"0134";"   FINSI"
"IMISSB";"S";"0135";"*  test si un motif est present"
"IMISSB";"S";"0136";"* il faut remettre HJMISSR à 0 car dans le cas ou il y un depart"
"IMISSB";"S";"0137";"* mission le lundi, qu'un motif est positionné le mardi"
"IMISSB";"S";"0138";"* il ne faut pas que le motif MISS se mette en place le mercredi"
"IMISSB";"S";"0139";"* si HJNPOIN = 0 par ce qu'on peut avoir un motif sur la journee ou"
"IMISSB";"S";"0140";"* on fait un depart mission"
"IMISSB";"S";"0141";"   POUR ACTIVITES"
"IMISSB";"S";"0142";"      SI HABS_MOTYPE <> ""C"""
"IMISSB";"S";"0143";"         SI HJOU_IJQNBADGEA = 0"
"IMISSB";"S";"0144";"            HJOU_IJRF3PRBHS = ""0"""
"IMISSB";"S";"0145";"            LOCA_MOTJOUR = 1"
"IMISSB";"S";"0146";"         FINSI"
"IMISSB";"S";"0147";"      FINSI"
"IMISSB";"S";"0148";"   FINPOUR"
"IMISSB";"S";"0149";"*  mise en place du motif"
"IMISSB";"S";"0150";"   SI LOCA_TOTMISS <> 0"
"IMISSB";"S";"0151";"* le motif est mis en place s'il n'existe pas de motifs"
"IMISSB";"S";"0152";"* qu'ils soient en H/M/A/J"
"IMISSB";"S";"0153";"      SI LOCA_MOTJOUR = 0"
"IMISSB";"S";"0154";"         HJOU_IJQHMISSJE = LOCA_TOTMISS"
"IMISSB";"S";"0155";"* alimentation du compteur HJNABS pour ne pas déclencher"
"IMISSB";"S";"0156";"* l'anomalie 103/106"
"IMISSB";"S";"0157";"         SI LOCA_ABS = 1"
"IMISSB";"S";"0158";"            HJOU_IJQNABSENT = 1"
"IMISSB";"S";"0159";"            HJOU_IJQNACTIVJ = 1"
"IMISSB";"S";"0160";"         FINSI"
"IMISSB";"S";"0161";"** le 27/06/2013"
"IMISSB";"S";"0162";"** alimentation des compteurs IJQNABSEN1 et IJQNABSEN2 pour ne pas declencher"
"IMISSB";"S";"0163";"** les anomalies 125 et 126"
"IMISSB";"S";"0164";"*"
"IMISSB";"S";"0165";"         HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"IMISSB";"S";"0166";"         HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"IMISSB";"S";"0167";"**"
"IMISSB";"S";"0168";"      FINSI"
"IMISSB";"S";"0169";"   FINSI"
"IMISSB";"S";"0170";"FINSI"
"IMISSB";"S";"0171";"FIN"
