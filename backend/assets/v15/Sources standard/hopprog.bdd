"ICONSCPCH";"S";"0539";"                        OU PROF_ABSENJ = PROF_ABSENS"
"ICONSCPCH";"S";"0540";"                           SI PROF_ABSENJ <> 0"
"ICONSCPCH";"S";"0541";"* Jour travaillé"
"ICONSCPCH";"S";"0542";"                              SI HJOU_IJRSCPTRA >= 0.5"
"ICONSCPCH";"S";"0543";"* Jour non travaillé"
"ICONSCPCH";"S";"0544";"                                 SI HJOU_IJRSCPNTRA >= 0.5"
"ICONSCPCH";"S";"0545";"* Pris dans travaillé"
"ICONSCPCH";"S";"0546";"                                    HJOU_IJRCCPTRA = HJOU_IJRCCPTRA + 0.5"
"ICONSCPCH";"S";"0547";"                                    HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - 0.5"
