"IACQCPAN2M";"S";"0040";"DEBDICO"
"IACQCPAN2M";"S";"0041";"   HJOU_IJRDCOANCI;N;N5,1;I;;;    56789;;IJRDCOANCI;V3;""Droit congé ancienneté"";"
"IACQCPAN2M";"S";"0042";"   HJOU_IJRCCOANCI;N;N5,1;I;;;    56789;;IJRCCOANCI;V3;""Congé ancienneté pris"";"
"IACQCPAN2M";"S";"0043";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"IACQCPAN2M";"S";"0044";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"IACQCPAN2M";"S";"0045";"   *********"
"IACQCPAN2M";"S";"0046";"   HJOU_IJIREGCPAN;O;Z1;X;;;123456789;L;;C2;""Régime des congés d'ancienneté"";"
"IACQCPAN2M";"S";"0047";"   SECH_ISISANC1;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 1 ""RÉGIME 1"""";"
"IACQCPAN2M";"S";"0048";"   SECH_ISISANC2;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 2 ""RÉGIME 1"""";"
