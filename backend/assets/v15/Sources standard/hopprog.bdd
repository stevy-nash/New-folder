"IEXCED";"S";"0011";"* Version  : 1"
"IEXCED";"S";"0012";"*"
"IEXCED";"S";"0013";"*----------------------------------------------------------------------"
"IEXCED";"S";"0014";"*"
"IEXCED";"S";"0015";"*"
"IEXCED";"S";"0016";"* Rôle : Heures jour excedentaires"
"IEXCED";"S";"0017";"*"
"IEXCED";"S";"0018";"*"
"IEXCED";"S";"0019";"*"
"IEXCED";"S";"0020";"*"
"IEXCED";"S";"0021";"* Implémentation des données industrielles"
"IEXCED";"S";"0022";"*"
"IEXCED";"S";"0023";"*----------------------------------------------------------------------"
"IEXCED";"S";"0024";"*"
"IEXCED";"S";"0025";"* Modifiée par : Cellule Industrialisation"
"IEXCED";"S";"0026";"* Date         : JJ/MM/AAAA"
"IEXCED";"S";"0027";"* Objet        :"
"IEXCED";"S";"0028";"*"
"IEXCED";"S";"0029";"***********************************************************************"
"IEXCED";"S";"0030";"*"
"IEXCED";"S";"0031";"DEBDICO"
"IEXCED";"S";"0032";"   HJOU_IJQHEXCED1;N;T6,2;I;;;    56789;;;V2;""Heures excédentaires entrée"";"
"IEXCED";"S";"0033";"   HJOU_IJQHEXCED2;N;T6,2;I;;;    56789;;;V2;""Heures excédentaires sortie"";"
"IEXCED";"S";"0034";"   HJOU_IJQDEBORDT;N;T6,2;I;;;    56789;;;V2;""Présence badgée hors plage totale"";"
"IEXCED";"S";"0035";"FINDICO"
"IEXCED";"S";"0036";"*"
"IEXCED";"S";"0037";"DEBANO"
"IEXCED";"S";"0038";"   110;5;""Heures excédentaires en entrée"";"
"IEXCED";"S";"0039";"   111;5;""Heures excédentaires en sortie"";"
"IEXCED";"S";"0040";"FINANO"
"IEXCED";"S";"0041";"*"
"IEXCED";"S";"0042";"* Déclaration des donnees locales"
"IEXCED";"S";"0043";"*"
"IEXCED";"S";"0044";"SI HJOU_DATE <= TEMP_DATJOU"
"IEXCED";"S";"0045";"   SI HJOU_IJQPRESBAJ > 0"
"IEXCED";"S";"0046";"* debordement en entree"
"IEXCED";"S";"0047";"      PLAGE ""01"""
"IEXCED";"S";"0048";"      SI TEMP_TYPPLA <> "" """
"IEXCED";"S";"0049";"         ANALYSE_R TEMP_VALTRT1 TEMP_VALTRT2"
"IEXCED";"S";"0050";"         SI TEMP_HIPRE >= PROF_IPIVDEBOR1"
"IEXCED";"S";"0051";"            HJOU_IJQHEXCED1 = TEMP_HIPRE"
"IEXCED";"S";"0052";"            ANOMALIE 110"
"IEXCED";"S";"0053";"         FINSI"
"IEXCED";"S";"0054";"      FINSI"
"IEXCED";"S";"0055";"* debordement en sortie"
"IEXCED";"S";"0056";"      PLAGE ""02"""
"IEXCED";"S";"0057";"      SI TEMP_TYPPLA <> "" """
"IEXCED";"S";"0058";"         ANALYSE_R TEMP_VALTRT1 TEMP_VALTRT2"
"IEXCED";"S";"0059";"         SI TEMP_HIPRE >= PROF_IPIVDEBOR2"
"IEXCED";"S";"0060";"            HJOU_IJQHEXCED2 = TEMP_HIPRE"
"IEXCED";"S";"0061";"            ANOMALIE 111"
"IEXCED";"S";"0062";"         FINSI"
"IEXCED";"S";"0063";"      FINSI"
"IEXCED";"S";"0064";"* totalisation du d?bordement"
"IEXCED";"S";"0065";"      HJOU_IJQDEBORDT = HJOU_IJQHEXCED1 + HJOU_IJQHEXCED2"
"IEXCED";"S";"0066";"   FINSI"
"IEXCED";"S";"0067";"FINSI"
"IEXCED";"S";"0068";"FIN"
"IFERIE";"S";"0001";"***********************************************************************"
"IFERIE";"S";"0002";"*"
"IFERIE";"S";"0003";"* Règle : IFERIE"
"IFERIE";"S";"0004";"* Ordre : 6040"
"IFERIE";"S";"0005";"* Titre : Calcul des heures travaillees feriees"
"IFERIE";"S";"0006";"*"
"IFERIE";"S";"0007";"*----------------------------------------------------------------------"
"IFERIE";"S";"0008";"*"
"IFERIE";"S";"0009";"* Créé par : Cellule Industrialisation"
"IFERIE";"S";"0010";"* Date     : 03/09/2009"
"IFERIE";"S";"0011";"* Version  : 1"
"IFERIE";"S";"0012";"*"
"IFERIE";"S";"0013";"*----------------------------------------------------------------------"
"IFERIE";"S";"0014";"*"
"IFERIE";"S";"0015";"*"
"IFERIE";"S";"0016";"* Rôle : Calcul des heures travaillees feriees"
"IFERIE";"S";"0017";"*"
"IFERIE";"S";"0018";"*"
"IFERIE";"S";"0019";"*"
"IFERIE";"S";"0020";"*"
"IFERIE";"S";"0021";"*"
"IFERIE";"S";"0022";"*----------------------------------------------------------------------"
"IFERIE";"S";"0023";"*"
"IFERIE";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IFERIE";"S";"0025";"* Date         : JJ/MM/AAAA"
"IFERIE";"S";"0026";"* Objet        :"
"IFERIE";"S";"0027";"*"
"IFERIE";"S";"0028";"***********************************************************************"
"IFERIE";"S";"0029";"*"
"IFERIE";"S";"0030";"* Implémentation des données industrielles"
"IFERIE";"S";"0031";"*"
"IFERIE";"S";"0032";"DEBDICO"
"IFERIE";"S";"0033";"   HJOU_IJQHJFTRAV;N;T6,2;I;;;    56789;;;V3;""Heures fériées"";"
"IFERIE";"S";"0034";"FINDICO"
"IFERIE";"S";"0035";"*"
"IFERIE";"S";"0036";"* Déclaration des donnees locales"
"IFERIE";"S";"0037";"*"
"IFERIE";"S";"0038";"* Stockage des heures ferié totales pour contrôle par"
"IFERIE";"S";"0039";"* rapport à l'écrêtage de la présence"
"IFERIE";"S";"0040";"*"
"IFERIE";"S";"0041";"DEF LOCA_FERI T6.2"
"IFERIE";"S";"0042";"LOCA_FERI = 0"
"IFERIE";"S";"0043";"*"
"IFERIE";"S";"0044";"SI HJOU_DATE <= TEMP_DATJOU"
"IFERIE";"S";"0045";"   POUR ACTIVITES"
"IFERIE";"S";"0046";"      SI HABS_MOTIF = ""FERI"""
"IFERIE";"S";"0047";"         LOCA_FERI = HJOU_IJRPREVEIL"
"IFERIE";"S";"0048";"         LOCA_FERI = LOCA_FERI + HJOU_IJQPREJENC"
"IFERIE";"S";"0049";"         LOCA_FERI = LOCA_FERI - HJOU_IJQECPAUMI"
"IFERIE";"S";"0050";"* le 23/03"
"IFERIE";"S";"0051";"* pas de gestion du temps de pause"
"IFERIE";"S";"0052";"* LOCA_FERI = LOCA_FERI + HJOU_IJQPAUPPLA"
"IFERIE";"S";"0053";"* LOCA_FERI = LOCA_FERI + HJOU_IJQPAUSPLA"
"IFERIE";"S";"0054";"* Contrôle de l'écrêtage du profil horaire"
"IFERIE";"S";"0055";"         SI LOCA_FERI > PROF_ECRJOU"
"IFERIE";"S";"0056";"            LOCA_FERI = PROF_ECRJOU"
"IFERIE";"S";"0057";"         FINSI"
"IFERIE";"S";"0058";"      FINSI"
"IFERIE";"S";"0059";"      HJOU_IJQHJFTRAV = LOCA_FERI"
"IFERIE";"S";"0060";"   FINPOUR"
"IFERIE";"S";"0061";"*  analyse des consignes"
"IFERIE";"S";"0062";"   POUR ACTIVITES"
"IFERIE";"S";"0063";"      SI HABS_MOTIF = ""XFER"""
"IFERIE";"S";"0064";"         HJOU_IJQHJFTRAV = HJOU_IJQHJFTRAV + HABS_MOTIDUR"
"IFERIE";"S";"0065";"      FINSI"
"IFERIE";"S";"0066";"      SI HABS_MOTIF = ""ZFER"""
"IFERIE";"S";"0067";"         HJOU_IJQHJFTRAV = HABS_MOTIDUR"
"IFERIE";"S";"0068";"      FINSI"
"IFERIE";"S";"0069";"   FINPOUR"
"IFERIE";"S";"0070";"FINSI"
"IFERIE";"S";"0071";"FIN"
"IGCSEGLISS";"S";"0001";"***********************************************************************"
"IGCSEGLISS";"S";"0002";"*"
