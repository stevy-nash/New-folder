"ICONSCONG";"S";"0826";"                                *"
"ICONSCONG";"S";"0827";"                                HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + HJOU_IJRSCPNTRA"
"ICONSCONG";"S";"0828";"                                HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HJOU_IJRSCPNTRA"
