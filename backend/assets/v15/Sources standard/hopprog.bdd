"ITPSACTHTB";"S";"0039";"*"
"ITPSACTHTB";"S";"0040";"*"
"ITPSACTHTB";"S";"0041";"* DEBANO"
"ITPSACTHTB";"S";"0042";"*"
"ITPSACTHTB";"S";"0043";"* FINANO"
"ITPSACTHTB";"S";"0044";"*"
"ITPSACTHTB";"S";"0045";"* Définition des variables locales"
"ITPSACTHTB";"S";"0046";"*"
"ITPSACTHTB";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTHTB";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTHTB";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHTB";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTHTB";"S";"0051";"    FINSI"
"ITPSACTHTB";"S";"0052";"FINSI"
"ITPSACTHTB";"S";"0053";"* Employé géré en activité"
"ITPSACTHTB";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTHTB";"S";"0055";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHTB";"S";"0056";"        * Calcul de la présence activité le dernier jour du mois"
"ITPSACTHTB";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTHTB";"S";"0058";"        SI TEMP_DATSUI(7:2) = ""01"""
"ITPSACTHTB";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTHTB";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTHTB";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTHTB";"S";"0062";"                * d'activité à justifier"
"ITPSACTHTB";"S";"0063";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTHTB";"S";"0064";"                SI HJOU_SECTAFF <> "" """
"ITPSACTHTB";"S";"0065";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTHTB";"S";"0066";"                SINON"
"ITPSACTHTB";"S";"0067";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTHTB";"S";"0068";"                FINSI"
"ITPSACTHTB";"S";"0069";"                *"
"ITPSACTHTB";"S";"0070";"                SI PRES_MODE_TRV = "" """
"ITPSACTHTB";"S";"0071";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHTB";"S";"0072";"                FINSI"
"ITPSACTHTB";"S";"0073";"                *"
"ITPSACTHTB";"S";"0074";"                * ----------------------------------------------------------------------------------"
"ITPSACTHTB";"S";"0075";"                *"
"ITPSACTHTB";"S";"0076";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHTB";"S";"0077";"                *                              (A décommenter si besoin)"
"ITPSACTHTB";"S";"0078";"                *"
"ITPSACTHTB";"S";"0079";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHTB";"S";"0080";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHTB";"S";"0081";"                * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHTB";"S";"0082";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHTB";"S";"0083";"                *"
"ITPSACTHTB";"S";"0084";"                * SI HJOU_IJRTTREFFM <> 0"
"ITPSACTHTB";"S";"0085";"                    PRES_TPS_PRES = HJOU_IJRTTREFFM"
"ITPSACTHTB";"S";"0086";"                * SINON"
"ITPSACTHTB";"S";"0087";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTHTB";"S";"0088";"                * FINSI"
"ITPSACTHTB";"S";"0089";"                * ----------------------------------------------------------------------------------"
"ITPSACTHTB";"S";"0090";"                *"
"ITPSACTHTB";"S";"0091";"                PRES_TPS_IMPUTE = 0"
"ITPSACTHTB";"S";"0092";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTHTB";"S";"0093";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTHTB";"S";"0094";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHTB";"S";"0095";"                    POUR EVENEMENTS"
"ITPSACTHTB";"S";"0096";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHTB";"S";"0097";"                    FINPOUR"
"ITPSACTHTB";"S";"0098";"                FINSI"
"ITPSACTHTB";"S";"0099";"                * Calcul de l'écart"
"ITPSACTHTB";"S";"0100";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHTB";"S";"0101";"            FINSI"
"ITPSACTHTB";"S";"0102";"        FINSI"
"ITPSACTHTB";"S";"0103";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHTB";"S";"0104";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHTB";"S";"0105";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHTB";"S";"0106";"        FINSI"
"ITPSACTHTB";"S";"0107";"    FINSI"
"ITPSACTHTB";"S";"0108";"FINSI"
"ITPSACTHTB";"S";"0109";"*"
"ITPSACTHTB";"S";"0110";"FIN"
