"ICONSCONG";"S";"0764";"                        HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - 0.5"
"ICONSCONG";"S";"0765";"                    SINON"
"ICONSCONG";"S";"0766";"                        SI HJOU_IJRSCPNTRA > 0"
"ICONSCONG";"S";"0767";"                            HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + HJOU_IJRSCPNTRA"
"ICONSCONG";"S";"0768";"                            *"
"ICONSCONG";"S";"0769";"                            HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + HJOU_IJRSCPNTRA"
"ICONSCONG";"S";"0770";"                            HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HJOU_IJRSCPNTRA"
"ICONSCONG";"S";"0771";"                            HJOU_IJRSCPNTRA = 0"
"ICONSCONG";"S";"0772";"                        FINSI"
"ICONSCONG";"S";"0773";"                    FINSI"
"ICONSCONG";"S";"0774";"                FINSI"
