"IACTBA";"S";"0028";"*"
"IACTBA";"S";"0029";"* Modifiée par : Méthodes et outils"
"IACTBA";"S";"0030";"* Date         : 28/08/2018"
"IACTBA";"S";"0031";"* Objet        : BT 43982 : passage à 10 caractères des champs contenant des motifs"
"IACTBA";"S";"0032";"*"
"IACTBA";"S";"0033";"***********************************************************************"
"IACTBA";"S";"0034";"*"
"IACTBA";"S";"0035";"* Implémentation des données industrielles"
"IACTBA";"S";"0036";"*"
"IACTBA";"S";"0037";"*DEBDICO"
"IACTBA";"S";"0038";"*FINDICO"
"IACTBA";"S";"0039";"*"
"IACTBA";"S";"0040";"*"
"IACTBA";"S";"0041";"DEBANO"
"IACTBA";"S";"0042";"   144;5;""Pas de retour sur une sortie avec motif"";"
"IACTBA";"S";"0043";"FINANO"
"IACTBA";"S";"0044";"* Déclaration des donnees locales"
"IACTBA";"S";"0045";"*"
"IACTBA";"S";"0046";"DEF LOCA_ACTBAD A10"
"IACTBA";"S";"0047";"LOCA_ACTBAD = "" """
"IACTBA";"S";"0048";"DEF LOCA_IMPUT A10"
"IACTBA";"S";"0049";"LOCA_IMPUT = "" """
"IACTBA";"S";"0050";"DEF LOCA_ACT T6.2"
"IACTBA";"S";"0051";"LOCA_ACT = 0"
"IACTBA";"S";"0052";"DEF LOCA_DUREE T6.2"
"IACTBA";"S";"0053";"LOCA_DUREE = 0"
"IACTBA";"S";"0054";"DEF LOCA_PTACT N1"
"IACTBA";"S";"0055";"LOCA_PTACT = 0"
"IACTBA";"S";"0056";"DEF LOCA_SORTIE T6.2"
"IACTBA";"S";"0058";"DEF LOCA_RETACT T6.2"
"IACTBA";"S";"0059";"LOCA_RETACT = 0"
"IACTBA";"S";"0060";"DEF LOCA_DUREET T6.2"
"IACTBA";"S";"0061";"LOCA_DUREET = 0"
"IACTBA";"S";"0062";"SI HJOU_DATE <= TEMP_DATJOU"
"IACTBA";"S";"0063";"   SI HJOU_IJIGACTBAD = ""1"""
"IACTBA";"S";"0064";"      POUR POINTAGES"
"IACTBA";"S";"0065";"* Recuperation de l'heure de badgeage"
"IACTBA";"S";"0066";"* si c'est un mouvement de sortie avec motif"
"IACTBA";"S";"0067";"         SI POIN_SENS = ""1"""
"IACTBA";"S";"0068";"            SI POIN_IMPUT = ""ACTBAD"""
"IACTBA";"S";"0069";"               LOCA_PTACT = 1"
"IACTBA";"S";"0070";"               LOCA_IMPUT = POIN_IMPUT"
"IACTBA";"S";"0071";"               LOCA_SORTIE = POIN_HRETRAI"
"IACTBA";"S";"0072";"            FINSI"
"IACTBA";"S";"0073";"         FINSI"
"IACTBA";"S";"0074";"         SI POIN_SENS = ""0"""
"IACTBA";"S";"0075";"            LOCA_PTACT = 0"
"IACTBA";"S";"0076";"* si le badgeage en entree est un retour motif"
"IACTBA";"S";"0077";"            SI LOCA_IMPUT = ""ACTBAD"""
"IACTBA";"S";"0078";"               LOCA_RETACT = POIN_HRETRAI"
"IACTBA";"S";"0079";"               LOCA_IMPUT = "" """
"IACTBA";"S";"0080";"** Calcul de la durée"
"IACTBA";"S";"0081";"               LOCA_DUREE = LOCA_RETACT - LOCA_SORTIE"
"IACTBA";"S";"0082";"               LOCA_DUREET = LOCA_DUREET + LOCA_DUREE"
"IACTBA";"S";"0083";"            FINSI"
"IACTBA";"S";"0084";"         FINSI"
"IACTBA";"S";"0085";"      FINPOUR"
"IACTBA";"S";"0086";"* depart sans retour dans la meme journne"
"IACTBA";"S";"0087";"      SI LOCA_IMPUT = ""ACTBAD"""
"IACTBA";"S";"0088";"         SI LOCA_PTACT = 1"
"IACTBA";"S";"0089";"            ANOMALIE 144"
"IACTBA";"S";"0090";"         FINSI"
"IACTBA";"S";"0091";"      FINSI"
"IACTBA";"S";"0092";"      SI PARD_IDIACTBAD = "" """
"IACTBA";"S";"0093";"         LOCA_ACTBAD = ""ACTBAD"""
"IACTBA";"S";"0094";"      SINON"
"IACTBA";"S";"0095";"         LOCA_ACTBAD = PARD_IDIACTBAD"
"IACTBA";"S";"0096";"      FINSI"
"IACTBA";"S";"0097";"      ENLEVER LOCA_ACTBAD"
"IACTBA";"S";"0098";"      SI LOCA_DUREET > 0"
"IACTBA";"S";"0099";"         AJOUTER LOCA_ACTBAD ""H"" LOCA_DUREET"
"IACTBA";"S";"0100";"      FINSI"
"IACTBA";"S";"0101";"   FINSI"
"IACTBA";"S";"0102";"FINSI"
"IACTBA";"S";"0103";"FIN"
