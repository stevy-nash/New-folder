"ICONGSUP";"S";"0025";"*"
"ICONGSUP";"S";"0026";"* Implémentation des données industrielles"
"ICONGSUP";"S";"0027";"*"
"ICONGSUP";"S";"0028";"DEBDICO"
"ICONGSUP";"S";"0029";"   PARD_IDIAGECSUP;O;N2;I;;;123456789;;;C3;""Age d'acquisition congé supplémentaire"";"
"ICONGSUP";"S";"0030";"   PARD_IDIDCSUP;O;N3,1;I;;;123456789;;;C3;""Droit congé supplémentaire"";"
"ICONGSUP";"S";"0031";"   PARD_IDIVMCSUP;O;A10;X;;;123456789;II;;C3;""Motif congé supplémentaire"";"
"ICONGSUP";"S";"0032";"   HJOU_IJRDCSUP;N;N4,1;I;;;    56789;;IJRDCSUP;V3;""Droit congé supplémentaire"";"
"ICONGSUP";"S";"0033";"   HJOU_IJRCCSUP;N;N4,1;I;;;    56789;;IJRCCSUP;V3;""Pris congé supplémentaire"";"
"ICONGSUP";"S";"0034";"   HJOU_IJRSCSUP;N;N4,1;I;;;    56789;;IJRSCSUP;V3;""Solde congé supplémentaire"";"
"ICONGSUP";"S";"0035";"   TEMP_ITQTRCSCET;N;N2;I;;;      789;;;V3;""Controle transfert CSUP en CET"";"
"ICONGSUP";"S";"0036";"FINDICO"
"ICONGSUP";"S";"0037";"*"
"ICONGSUP";"S";"0038";"DEBANO"
"ICONGSUP";"S";"0039";"   166;9;""Solde congé supplémentaire insuffisant"";"
"ICONGSUP";"S";"0040";"   167;9;""Solde congé supplémentaire insuffisant pour transfert en CET"";"
"ICONGSUP";"S";"0041";"FINANO"
"ICONGSUP";"S";"0042";"*"
"ICONGSUP";"S";"0043";"* Déclaration des donnees locales"
"ICONGSUP";"S";"0044";"DEF LOCA_DATEREF D"
"ICONGSUP";"S";"0045";"LOCA_DATEREF = "" """
"ICONGSUP";"S";"0046";"DEF LOCA_MOIS N2"
"ICONGSUP";"S";"0047";"LOCA_MOIS = 0"
"ICONGSUP";"S";"0048";"DEF LOCA_JOUR N2"
"ICONGSUP";"S";"0049";"LOCA_JOUR = 0"
"ICONGSUP";"S";"0050";"DEF LOCA_AGE N2"
"ICONGSUP";"S";"0051";"LOCA_AGE = 0"
"ICONGSUP";"S";"0052";"DEF LOCA_CONSO N1"
"ICONGSUP";"S";"0053";"LOCA_CONSO = 0"
"ICONGSUP";"S";"0054";"*"
"ICONGSUP";"S";"0055";"*"
"ICONGSUP";"S";"0056";"*"
"ICONGSUP";"S";"0057";"SI PARD_IDIAGECSUP <> 0"
"ICONGSUP";"S";"0058";"   LOCA_MOIS << CONF_ITIVMREFCP(3:2)"
"ICONGSUP";"S";"0059";"   LOCA_JOUR << CONF_ITIVMREFCP(1:2)"
"ICONGSUP";"S";"0060";"   LOCA_DATEREF(1:4) = HJOU_DATE(1:4)"
"ICONGSUP";"S";"0061";"   LOCA_DATEREF(5:2) << LOCA_MOIS"
"ICONGSUP";"S";"0062";"   LOCA_DATEREF(7:2) << LOCA_JOUR"
"ICONGSUP";"S";"0063";"*"
"ICONGSUP";"S";"0064";"* Le congé supplémentaire s'acquiert à la date de référence des CP"
"ICONGSUP";"S";"0065";"* DATE DE RÉFÉRENCE"
"ICONGSUP";"S";"0066";"   SI HJOU_DATE = LOCA_DATEREF"
"ICONGSUP";"S";"0067";"* Si la date de naissance est renseignée"
"ICONGSUP";"S";"0068";"      SI EMPS_E2DATENAI <> "" """
"ICONGSUP";"S";"0069";"         DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"ICONGSUP";"S";"0070";"         LOCA_AGE = TEMP_NXANNEE"
"ICONGSUP";"S";"0071";"      FINSI"
"ICONGSUP";"S";"0072";"*Si l'age de l'employé est supérieur à la donnée définie dans PARD"
"ICONGSUP";"S";"0073";"      SI LOCA_AGE >= PARD_IDIAGECSUP"
"ICONGSUP";"S";"0074";"         HJOU_IJRDCSUP = PARD_IDIDCSUP"
"ICONGSUP";"S";"0075";"         HJOU_IJRCCSUP = 0"
"ICONGSUP";"S";"0076";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUP";"S";"0077";"      FINSI"
"ICONGSUP";"S";"0078";"   FINSI"
"ICONGSUP";"S";"0079";"*"
"ICONGSUP";"S";"0080";"* calcul du pris"
"ICONGSUP";"S";"0081";"   POUR ACTIVITES"
"ICONGSUP";"S";"0082";"      SI HABS_MOTIF = PARD_IDIVMCSUP"
"ICONGSUP";"S";"0083";"         LOCA_CONSO = 1"
"ICONGSUP";"S";"0084";"         SI HABS_VALORIS = ""J"""
"ICONGSUP";"S";"0085";"            HJOU_IJRCCSUP = HJOU_IJRCCSUP + 1"
"ICONGSUP";"S";"0086";"            HJOU_IJRSCSUP = HJOU_IJRSCSUP - 1"
"ICONGSUP";"S";"0087";"         SINON"
"ICONGSUP";"S";"0088";"            HJOU_IJRCCSUP = HJOU_IJRCCSUP + 0.5"
"ICONGSUP";"S";"0089";"            HJOU_IJRSCSUP = HJOU_IJRSCSUP - 0.5"
"ICONGSUP";"S";"0090";"         FINSI"
"ICONGSUP";"S";"0091";"      FINSI"
"ICONGSUP";"S";"0092";"   FINPOUR"
"ICONGSUP";"S";"0093";"*"
"ICONGSUP";"S";"0094";"   SI LOCA_CONSO = 1"
"ICONGSUP";"S";"0095";"      SI HJOU_IJRSCSUP < 0"
"ICONGSUP";"S";"0096";"         TEMP_CNRETOUR = 2"
"ICONGSUP";"S";"0097";"         TEMP_CNMESS = 166"
"ICONGSUP";"S";"0098";"      FINSI"
"ICONGSUP";"S";"0099";"   FINSI"
"ICONGSUP";"S";"0100";"** Analyse des consignes"
"ICONGSUP";"S";"0101";"   POUR ACTIVITES"
"ICONGSUP";"S";"0102";"      SI HABS_MOTIF = ""XDCSUP"""
"ICONGSUP";"S";"0103";"         HJOU_IJRDCSUP = HJOU_IJRDCSUP + HABS_MOTINBR"
"ICONGSUP";"S";"0104";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUP";"S";"0105";"      FINSI"
"ICONGSUP";"S";"0106";"      SI HABS_MOTIF = ""ZDCSUP"""
"ICONGSUP";"S";"0107";"         HJOU_IJRDCSUP = HABS_MOTINBR"
"ICONGSUP";"S";"0108";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUP";"S";"0109";"      FINSI"
"ICONGSUP";"S";"0110";"      SI HABS_MOTIF = ""XCCSUP"""
"ICONGSUP";"S";"0111";"         HJOU_IJRCCSUP = HJOU_IJRCCSUP + HABS_MOTINBR"
"ICONGSUP";"S";"0112";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUP";"S";"0113";"      FINSI"
"ICONGSUP";"S";"0114";"      SI HABS_MOTIF = ""ZCCSUP"""
"ICONGSUP";"S";"0115";"         HJOU_IJRCCSUP = HABS_MOTINBR"
"ICONGSUP";"S";"0116";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUP";"S";"0117";"      FINSI"
"ICONGSUP";"S";"0118";"   FINPOUR"
"ICONGSUP";"S";"0119";"   *"
"ICONGSUP";"S";"0120";"   SI HJOU_IJRSCSUP < 0"
"ICONGSUP";"S";"0121";"      ANOMALIE 166"
"ICONGSUP";"S";"0122";"   FINSI"
"ICONGSUP";"S";"0123";"*"
"ICONGSUP";"S";"0124";"** transfert de congés supplémentaires vers le CET"
"ICONGSUP";"S";"0125";"   POUR ACTIVITES"
"ICONGSUP";"S";"0126";"      SI HABS_MOTIF = ""YCSCET"""
"ICONGSUP";"S";"0127";"         SI HABS_MOTINBR <= HJOU_IJRSCSUP"
"ICONGSUP";"S";"0128";"            HJOU_IJRSCSUP = HJOU_IJRSCSUP - HABS_MOTINBR"
"ICONGSUP";"S";"0129";"         SINON"
"ICONGSUP";"S";"0130";"* solde cp supplémentaires insuffisant pour transfert en CET"
"ICONGSUP";"S";"0131";"            TEMP_ITQTRCSCET = 1"
"ICONGSUP";"S";"0132";"            ANOMALIE 167"
"ICONGSUP";"S";"0133";"         FINSI"
"ICONGSUP";"S";"0134";"      FINSI"
"ICONGSUP";"S";"0135";"   FINPOUR"
"ICONGSUP";"S";"0136";"FINSI"
"ICONGSUP";"S";"0137";"FIN"
