"ICONSCPCH";"S";"0041";"   HJOU_IJRSCOPRIN;N;N6,1;I;;;    56789;;IJRSCOPRIN;V3;""Solde congé payé"";"
"ICONSCPCH";"S";"0042";"   HJOU_IJRDCOPRIN;N;N6,1;I;;;    56789;;IJRDCOPRIN;V3;""Droit congé payé"";"
"ICONSCPCH";"S";"0043";"   HJOU_IJRCCOPRIN;N;N6,1;I;;;    56789;;IJRCCOPRIN;V3;""Congé payé pris"";"
"ICONSCPCH";"S";"0044";"   HJOU_IJRCCOANTI;N;N6,1;I;;;     6789;;IJRCCOANTI;V3;""Congé anticipé"";"
"ICONSCPCH";"S";"0045";"   HJOU_IJRDCOANCI;N;N5,1;I;;;    56789;;IJRDCOANCI;V3;""Droit congé ancienneté"";"
"ICONSCPCH";"S";"0046";"   HJOU_IJRCCOANCI;N;N5,1;I;;;    56789;;IJRCCOANCI;V3;""Congé ancienneté pris"";"
"ICONSCPCH";"S";"0047";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"ICONSCPCH";"S";"0048";"   MOTI_IMICONTCPS;O;Z1;X;;;123456789;L9;;C3;""Maintien congé"";"
"ICONSCPCH";"S";"0049";"   HJOU_IJRNBCPSAM;N;N2;I;;;    56789;;IJRNBCPSAM;V3;""Nombre de congés samedi"";"
"ICONSCPCH";"S";"0050";"   HJOU_IJRSAMEAPR;N;N2;I;;;    56789;;IJRSAMEAPR;V3;""Calcul interm nbr. samedi a prendre."";"
"ICONSCPCH";"S";"0051";"   PARD_IDINBRSAMD;O;N2;I;0;;123456789;;;C3;""Nombre de congés samedi à prendre"";"
"ICONSCPCH";"S";"0052";"   * Acquisition des CP"
"ICONSCPCH";"S";"0053";"   HJOU_IJRPACQCP;N;N5,2;I;;;    56789;;IJRPACQCP;V3;""Acquisition congé pris"";"
"ICONSCPCH";"S";"0054";"   HJOU_IJRSACQCP;N;N6,2;I;;;    56789;;IJRSACQCP;V3;""Solde acquisition congé"";"
"ICONSCPCH";"S";"0055";"   * Jours travaillés"
"ICONSCPCH";"S";"0056";"   HJOU_IJRCPTJTRA;N;N2;I;;;    56789;;IJRCPTJTRA;V3;""Compteur de suivi des jours travaillés"";"
"ICONSCPCH";"S";"0057";"   HORC_IHIMOACQCP;O;A1;X;;;123456789;L;;C3;""Mode d'acquisition des congés"";"
"ICONSCPCH";"S";"0058";"   * CP pris hebdo"
"ICONSCPCH";"S";"0059";"   HJOU_IJRCPCOH;N;N5,1;I;;;    56789;;IJRCPCOH;V3;""Congés pris hebdo"";"
"ICONSCPCH";"S";"0060";"   *****"
"ICONSCPCH";"S";"0061";"   HJOU_IJRCPJEUDI;N;N2;I;;;    56789;;IJRCPJEUDI;V3;""Calcul intermediaire congé payé jeudi"";"
"ICONSCPCH";"S";"0062";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"ICONSCPCH";"S";"0063";"   * Motifs"
"ICONSCPCH";"S";"0064";"   PARD_IDIVMCOREL;O;A10;X;;;123456789;II;;C2;""Reliquat congé payé"";"
"ICONSCPCH";"S";"0065";"   PARD_IDIVMCOANC;O;A10;X;;;123456789;II;;C2;""Congé ancienneté"";"
"ICONSCPCH";"S";"0066";"   PARD_IDIVMCOPRI;O;A10;X;;;123456789;II;;C2;""Congé payé"";"
"ICONSCPCH";"S";"0067";"   PARD_IDIVMCOANT;O;A10;X;;;123456789;II;;C2;""Congé anticipé"";"
"ICONSCPCH";"S";"0069";"   HJOU_IJRJRCONG;N;N2;I;;;    56789;;IJRJRCONG;V3;""Congé sur la journée"";"
"ICONSCPCH";"S";"0070";"   HORC_IHIDRJTRAV;O;N5,2;I;;;123456789;;;C3;""Acquis congé payé"";"
"ICONSCPCH";"S";"0071";"   * CP sur jours travaillés"
"ICONSCPCH";"S";"0072";"   HJOU_IJRDCPTRA;N;N5,1;I;;;    56789;;IJRDCPTRA;V3;""Droit CP travaillés"";"
"ICONSCPCH";"S";"0073";"   HJOU_IJRCCPTRA;N;N5,1;I;;;    56789;;IJRCCPTRA;V3;""Pris CP travaillés"";"
"ICONSCPCH";"S";"0074";"   HJOU_IJRSCPTRA;N;N5,1;I;;;    56789;;IJRSCPTRA;V3;""Solde CP travaillés"";"
"ICONSCPCH";"S";"0075";"   * CP sur jours non travaillés"
"ICONSCPCH";"S";"0076";"   HJOU_IJRDCPNTRA;N;N5,1;I;;;    56789;;IJRDCPNTRA;V3;""Droit CP non travaillés"";"
"ICONSCPCH";"S";"0077";"   HJOU_IJRCCPNTRA;N;N5,1;I;;;    56789;;IJRCCPNTRA;V3;""Pris CP non travaillés"";"
"ICONSCPCH";"S";"0078";"   HJOU_IJRSCPNTRA;N;N5,1;I;;;    56789;;IJRSCPNTRA;V3;""Solde CP non travaillés"";"
"ICONSCPCH";"S";"0079";"FINDICO"
"ICONSCPCH";"S";"0080";"*"
"ICONSCPCH";"S";"0081";"DEBANO"
"ICONSCPCH";"S";"0082";"   134;5;""Prise de congés anticipés"";"
"ICONSCPCH";"S";"0083";"   168;8;""Solde congés ancienneté insuffisant"";"
"ICONSCPCH";"S";"0084";"   197;8;""Solde acquisition congé insuffisant"";"
"ICONSCPCH";"S";"0085";"   198;8;""Solde congé payé insuffisant"";"
