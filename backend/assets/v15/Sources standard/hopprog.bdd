"IGRTTJ";"S";"0031";"***********************************************************************"
"IGRTTJ";"S";"0032";"*"
"IGRTTJ";"S";"0033";"* Implémentation des données industrielles"
"IGRTTJ";"S";"0034";"*"
"IGRTTJ";"S";"0035";"DEBDICO"
"IGRTTJ";"S";"0036";"   HJOU_IJRARTTJOU;N;N6,1;I;;;     6789;;IJRARTTJOU;V3;""RTT acquis (J)"";"
"IGRTTJ";"S";"0037";"   HJOU_IJRACRTTJM;N;N6,3;L;;;     6789;;IJRACRTTJM;V3;""RTT acquis mensuel (J)"";"
"IGRTTJ";"S";"0038";"   HJOU_IJRCRTTJOU;N;N6,1;I;;;     6789;;IJRCRTTJOU;V3;""RTT pris (J)"";"
"IGRTTJ";"S";"0039";"   HJOU_IJRSNBJRTT;N;N6,1;I;;;     6789;;IJRSNBJRTT;V3;""Solde RTT (J)"";"
"IGRTTJ";"S";"0040";"   HJOU_IJRNRTTJEM;N;N3,1;I;;;    56789;;IJRNRTTJEM;V3;""Nbre RTT employeurs pris"";"
"IGRTTJ";"S";"0041";"   EMPL_IEQSPRTTJO;N;N6,1;I;;;     6789;;;V3;""Solde prévisionnel RTT en jour"";"
"IGRTTJ";"S";"0042";"   HJOU_IJRTRRTCET;N;N6,1;I;;;    56789;;IJRTRRTCET;V3;""Cpt intermediaire transfert RTT/CET"";"
"IGRTTJ";"S";"0043";"   CONF_IGIREFRTT;O;A4;X;;;123456789;;;C3;""Date de référence RTT (JJMM)"";"
"IGRTTJ";"S";"0044";"   EMPL_IEQSPRTTJ2;N;N6,1;I;;;     6789;;;V3;""Solde prév. RTT en jour deuxième période"";"
"IGRTTJ";"S";"0045";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"IGRTTJ";"S";"0046";"   PARD_IDISRPEP;N;N4,1;I;000000000000;;    56789;;;C3;""Nbre de jours de repos annuels"";"
"IGRTTJ";"S";"0047";"FINDICO"
"IGRTTJ";"S";"0048";"*"
"IGRTTJ";"S";"0049";"DEBANO"
"IGRTTJ";"S";"0050";"   135;5;""Solde RTT insuffisant"";"
"IGRTTJ";"S";"0051";"   136;5;""Nbre de jours RTT employeur supérieur au seuil autorisé"";"
"IGRTTJ";"S";"0052";"   158;9;""Solde RTT en jours insuffisant pour transfert en CET"";"
"IGRTTJ";"S";"0053";"FINANO"
"IGRTTJ";"S";"0054";"*"
"IGRTTJ";"S";"0055";"* Déclaration des donnees locales"
"IGRTTJ";"S";"0056";"*"
"IGRTTJ";"S";"0057";"DEF LOCA_DATE D"
"IGRTTJ";"S";"0058";"LOCA_DATE = "" """
"IGRTTJ";"S";"0059";"DEF LOCA_ACOURS N4"
"IGRTTJ";"S";"0060";"LOCA_ACOURS = 0"
"IGRTTJ";"S";"0061";"DEF LOCA_ACOURS2 N4"
"IGRTTJ";"S";"0062";"LOCA_ACOURS2 = 0"
"IGRTTJ";"S";"0063";"DEF LOCA_MOT N1"
"IGRTTJ";"S";"0064";"LOCA_MOT = 0"
"IGRTTJ";"S";"0065";"DEF LOCA_REST N6.3"
"IGRTTJ";"S";"0066";"LOCA_REST = 0"
"IGRTTJ";"S";"0067";"DEF LOCA_ENTIER N6.1"
"IGRTTJ";"S";"0068";"LOCA_ENTIER = 0"
"IGRTTJ";"S";"0069";"DEF LOCA_ENLEVER N1"
"IGRTTJ";"S";"0070";"LOCA_ENLEVER = 0"
"IGRTTJ";"S";"0071";"DEF LOCA_VALID A4"
"IGRTTJ";"S";"0072";"LOCA_VALID = "" """
"IGRTTJ";"S";"0073";"DEF LOCA_MOTIF A10"
"IGRTTJ";"S";"0074";"LOCA_MOTIF = "" """
"IGRTTJ";"S";"0075";"DEF LOCA_REF N2"
"IGRTTJ";"S";"0076";"LOCA_REF = 0"
"IGRTTJ";"S";"0077";"DEF LOCA_DATEFU D"
"IGRTTJ";"S";"0078";"LOCA_DATEFU = "" """
"IGRTTJ";"S";"0079";"DEF LOCA_DATEFU2 D"
"IGRTTJ";"S";"0080";"LOCA_DATEFU2 = "" """
"IGRTTJ";"S";"0081";"DEF LOCA_TRANS N6.1"
"IGRTTJ";"S";"0082";"LOCA_TRANS = 0"
"IGRTTJ";"S";"0083";"DEF LOCA_PRIS N6.1"
"IGRTTJ";"S";"0084";"LOCA_PRIS = 0"
"IGRTTJ";"S";"0085";"DEF LOCA_DROIT N6.1"
"IGRTTJ";"S";"0086";"LOCA_DROIT = 0"
"IGRTTJ";"S";"0087";"*"
"IGRTTJ";"S";"0088";"* RAZ au a la date de référence RTT ou en debut d'annualisation"
"IGRTTJ";"S";"0089";"*"
"IGRTTJ";"S";"0090";"SI HJOU_IJIGRETETR = ""2"""
"IGRTTJ";"S";"0091";"OU HJOU_IJIGRETETR = ""4"""
"IGRTTJ";"S";"0092";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IGRTTJ";"S";"0093";"*"
"IGRTTJ";"S";"0094";"   SI CONF_IGIREFRTT <> "" """
"IGRTTJ";"S";"0095";"      LOCA_REF << CONF_IGIREFRTT(1:2)"
"IGRTTJ";"S";"0096";"      LOCA_DATE(7:2) << LOCA_REF"
"IGRTTJ";"S";"0097";"      LOCA_REF << CONF_IGIREFRTT(3:2)"
"IGRTTJ";"S";"0098";"      LOCA_DATE(5:2) << LOCA_REF"
"IGRTTJ";"S";"0099";"   SINON"
"IGRTTJ";"S";"0100";"      LOCA_DATE = PARD_IDIDDEBANN"
"IGRTTJ";"S";"0101";"   FINSI"
"IGRTTJ";"S";"0102";"**"
"IGRTTJ";"S";"0103";"   LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IGRTTJ";"S";"0104";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IGRTTJ";"S";"0105";"*"
"IGRTTJ";"S";"0106";"   SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IGRTTJ";"S";"0107";"      LOCA_ACOURS = LOCA_ACOURS + 1"
"IGRTTJ";"S";"0108";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IGRTTJ";"S";"0109";"*"
"IGRTTJ";"S";"0110";"   FINSI"
"IGRTTJ";"S";"0111";"   LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IGRTTJ";"S";"0112";"   LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IGRTTJ";"S";"0113";"   LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IGRTTJ";"S";"0114";"   LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IGRTTJ";"S";"0115";"*"
"IGRTTJ";"S";"0116";"*"
"IGRTTJ";"S";"0117";"*"
"IGRTTJ";"S";"0118";"   SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IGRTTJ";"S";"0119";"      HJOU_IJRSNBHRTT = 0"
"IGRTTJ";"S";"0120";"      HJOU_IJRARTTJOU = 0"
"IGRTTJ";"S";"0121";"      HJOU_IJRCRTTJOU = 0"
"IGRTTJ";"S";"0122";"      HJOU_IJRSNBJRTT = 0"
"IGRTTJ";"S";"0123";"      HJOU_IJRNRTTJEM = 0"
"IGRTTJ";"S";"0124";"      HJOU_IJRTRRTCET = 0"
"IGRTTJ";"S";"0125";"      HJOU_IJRACRTTJM = 0"
"IGRTTJ";"S";"0126";"   FINSI"
"IGRTTJ";"S";"0127";"**Traitement des RTT en acquisition annuelle"
"IGRTTJ";"S";"0128";"   SI HJOU_IJIGRETETR = ""2"""
"IGRTTJ";"S";"0129";"      SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IGRTTJ";"S";"0130";"* Acquisition annuelle"
"IGRTTJ";"S";"0131";"         HJOU_IJRARTTJOU = PARD_IDISRPEP"
"IGRTTJ";"S";"0132";"      FINSI"
"IGRTTJ";"S";"0133";"   FINSI"
"IGRTTJ";"S";"0134";"** traitement des RTT en jour acquisition mensuelle"
"IGRTTJ";"S";"0135";"   SI HJOU_IJIGRETETR = ""4"""
"IGRTTJ";"S";"0136";"      SI HJOU_DATE(7:2) = ""01"""
"IGRTTJ";"S";"0137";"* Cumul de l'acquis mensuel"
"IGRTTJ";"S";"0138";"         HJOU_IJRACRTTJM = HJOU_IJRACRTTJM + HJOU_IJIACQRTTJ"
"IGRTTJ";"S";"0139";"*"
"IGRTTJ";"S";"0140";"* arrondi de l'acquis a l'entier supérieur"
"IGRTTJ";"S";"0141";"         LOCA_REST = HJOU_IJRACRTTJM % 1"
"IGRTTJ";"S";"0142";"         LOCA_ENTIER = HJOU_IJRACRTTJM - LOCA_REST"
"IGRTTJ";"S";"0143";"         SI LOCA_REST > 0"
"IGRTTJ";"S";"0144";"            LOCA_ENTIER = LOCA_ENTIER + 1"
"IGRTTJ";"S";"0145";"         FINSI"
"IGRTTJ";"S";"0146";"* alimentation du compteur de droit"
"IGRTTJ";"S";"0147";"         LOCA_TRANS = LOCA_ENTIER - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0148";"         HJOU_IJRARTTJOU = LOCA_ENTIER"
"IGRTTJ";"S";"0149";"         *"
"IGRTTJ";"S";"0150";"         HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
"IGRTTJ";"S";"0151";"         *"
"IGRTTJ";"S";"0152";"      FINSI"
"IGRTTJ";"S";"0153";"   FINSI"
"IGRTTJ";"S";"0154";"* traitement du motif RTT pris"
"IGRTTJ";"S";"0155";"   POUR ACTIVITES"
"IGRTTJ";"S";"0156";"      SI HABS_MOTIF = PARD_IDIVMRTTSA"
"IGRTTJ";"S";"0157";"      OU HABS_MOTIF = PARD_IDIVMRTTEM"
"IGRTTJ";"S";"0158";"         LOCA_MOTIF = HABS_MOTIF"
"IGRTTJ";"S";"0159";"         LOCA_MOT = 1"
"IGRTTJ";"S";"0160";"         SI HJOU_IJIGRETETR = ""2"""
"IGRTTJ";"S";"0161";"         OU HJOU_IJIGRETETR = ""4"""
"IGRTTJ";"S";"0162";"* La regle VALACT qui permet de supprimer un motif"
"IGRTTJ";"S";"0163";"* par rapport au type de jour O/S/D/F n'étant pas"
"IGRTTJ";"S";"0164";"* déroulée dans le futur on va tester la validité du motif"
"IGRTTJ";"S";"0165";"* avant d'effectuer le calcul des soldes"
"IGRTTJ";"S";"0166";"* pour que le solde prévisionnel soit juste"
"IGRTTJ";"S";"0167";"**********************************************"
"IGRTTJ";"S";"0168";"            LOCA_ENLEVER = 0"
"IGRTTJ";"S";"0169";"            LOCA_VALID = MOTI_VALID"
"IGRTTJ";"S";"0170";"            SI LOCA_VALID(1:1) = ""O"""
"IGRTTJ";"S";"0171";"               SI PARD_IDIJOUROUV = ""1"""
"IGRTTJ";"S";"0172";"                  SI HJOU_IJQPRETHEJ = 0"
"IGRTTJ";"S";"0173";"                     LOCA_ENLEVER = 1"
"IGRTTJ";"S";"0174";"                  FINSI"
"IGRTTJ";"S";"0175";"               SINON"
"IGRTTJ";"S";"0176";"                  SI HJOU_JOUR = ""6"""
"IGRTTJ";"S";"0177";"                     SI HJOU_IJQPRETHEJ = 0"
"IGRTTJ";"S";"0178";"                        LOCA_ENLEVER = 1"
"IGRTTJ";"S";"0179";"                     FINSI"
"IGRTTJ";"S";"0180";"                  FINSI"
"IGRTTJ";"S";"0181";"               FINSI"
"IGRTTJ";"S";"0182";"            FINSI"
"IGRTTJ";"S";"0183";"            SI LOCA_VALID(2:1) = ""S"""
"IGRTTJ";"S";"0184";"               LOCA_ENLEVER = 0"
"IGRTTJ";"S";"0185";"            FINSI"
"IGRTTJ";"S";"0186";"            SI LOCA_VALID(3:1) = "" """
"IGRTTJ";"S";"0187";"               SI HJOU_JOUR = ""7"""
"IGRTTJ";"S";"0188";"                  SI HJOU_IJQPRETHEJ = 0"
"IGRTTJ";"S";"0189";"                     LOCA_ENLEVER = 1"
"IGRTTJ";"S";"0190";"                  FINSI"
"IGRTTJ";"S";"0191";"               FINSI"
"IGRTTJ";"S";"0192";"            FINSI"
"IGRTTJ";"S";"0193";"******************************************************"
"IGRTTJ";"S";"0194";"            SI LOCA_ENLEVER = 0"
"IGRTTJ";"S";"0195";"               SI HABS_VALORIS = ""J"""
"IGRTTJ";"S";"0196";"                  HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + 1"
"IGRTTJ";"S";"0197";"                  HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - 1"
"IGRTTJ";"S";"0198";"               SINON"
"IGRTTJ";"S";"0199";"                  HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + 0.5"
"IGRTTJ";"S";"0200";"                  HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - 0.5"
"IGRTTJ";"S";"0201";"               FINSI"
"IGRTTJ";"S";"0202";"            FINSI"
"IGRTTJ";"S";"0203";"         FINSI"
"IGRTTJ";"S";"0204";"      FINSI"
"IGRTTJ";"S";"0205";"*   Contrôle du nombre de RTT employeurs pris"
"IGRTTJ";"S";"0206";"*   et mise en place anomalie si cela dépasse"
"IGRTTJ";"S";"0207";"*   la valeur indiquée dans les données globales datées"
"IGRTTJ";"S";"0208";"      SI HABS_MOTIF = PARD_IDIVMRTTEM"
"IGRTTJ";"S";"0209";"         SI HABS_VALORIS = ""J"""
"IGRTTJ";"S";"0210";"            HJOU_IJRNRTTJEM = HJOU_IJRNRTTJEM + 1"
"IGRTTJ";"S";"0211";"         SINON"
"IGRTTJ";"S";"0212";"            HJOU_IJRNRTTJEM = HJOU_IJRNRTTJEM + 0.5"
"IGRTTJ";"S";"0213";"         FINSI"
"IGRTTJ";"S";"0214";"         SI HJOU_IJRNRTTJEM > PARD_IDISRTTEMP"
"IGRTTJ";"S";"0215";"            ANOMALIE 136"
"IGRTTJ";"S";"0216";"         FINSI"
"IGRTTJ";"S";"0217";"      FINSI"
"IGRTTJ";"S";"0218";"   FINPOUR"
"IGRTTJ";"S";"0219";"   SI LOCA_ENLEVER = 1"
"IGRTTJ";"S";"0220";"      ENLEVER LOCA_MOTIF"
"IGRTTJ";"S";"0221";"   FINSI"
"IGRTTJ";"S";"0222";"*"
"IGRTTJ";"S";"0223";"* analyse des consignes d'initialisation et de mise à jour"
"IGRTTJ";"S";"0224";"*"
"IGRTTJ";"S";"0225";"   POUR ACTIVITES"
"IGRTTJ";"S";"0226";"*"
"IGRTTJ";"S";"0227";"      SI HJOU_IJIGRETETR = ""4"""
"IGRTTJ";"S";"0228";"         SI HABS_MOTIF = ""ZARTJ"""
"IGRTTJ";"S";"0229";"            LOCA_MOT = 1"
"IGRTTJ";"S";"0230";"            HJOU_IJRACRTTJM = HABS_MOTINBR"
"IGRTTJ";"S";"0231";"*"
"IGRTTJ";"S";"0232";"* arrondi de l'acquis a l'entier supérieur"
"IGRTTJ";"S";"0233";"            LOCA_REST = HJOU_IJRACRTTJM % 1"
"IGRTTJ";"S";"0234";"            LOCA_ENTIER = HJOU_IJRACRTTJM - LOCA_REST"
"IGRTTJ";"S";"0235";"            SI LOCA_REST > 0"
"IGRTTJ";"S";"0236";"               LOCA_ENTIER = LOCA_ENTIER + 1"
"IGRTTJ";"S";"0237";"            FINSI"
"IGRTTJ";"S";"0238";"            *"
"IGRTTJ";"S";"0239";"            LOCA_TRANS = LOCA_ENTIER - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0240";"* alimentation du compteur de droit"
"IGRTTJ";"S";"0241";"            HJOU_IJRARTTJOU = LOCA_ENTIER"
"IGRTTJ";"S";"0242";"            *"
"IGRTTJ";"S";"0243";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
"IGRTTJ";"S";"0244";"         FINSI"
"IGRTTJ";"S";"0245";"      FINSI"
"IGRTTJ";"S";"0246";"**"
"IGRTTJ";"S";"0247";"      SI HJOU_IJIGRETETR = ""4"""
"IGRTTJ";"S";"0248";"         SI HABS_MOTIF = ""XARTJ"""
"IGRTTJ";"S";"0249";"            LOCA_MOT = 1"
"IGRTTJ";"S";"0250";"            HJOU_IJRACRTTJM = HJOU_IJRACRTTJM + HABS_MOTINBR"
"IGRTTJ";"S";"0251";"*"
"IGRTTJ";"S";"0252";"* arrondi de l'acquis a l'entier supérieur"
"IGRTTJ";"S";"0253";"            LOCA_REST = HJOU_IJRACRTTJM % 1"
"IGRTTJ";"S";"0254";"            LOCA_ENTIER = HJOU_IJRACRTTJM - LOCA_REST"
"IGRTTJ";"S";"0255";"            SI LOCA_REST > 0"
"IGRTTJ";"S";"0256";"               LOCA_ENTIER = LOCA_ENTIER + 1"
"IGRTTJ";"S";"0257";"            FINSI"
"IGRTTJ";"S";"0258";"            *"
"IGRTTJ";"S";"0259";"            LOCA_DROIT = HABS_MOTINBR + HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0260";"            LOCA_TRANS = LOCA_DROIT - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0261";"* alimentation du compteur de droit"
"IGRTTJ";"S";"0262";"            HJOU_IJRARTTJOU = LOCA_ENTIER"
"IGRTTJ";"S";"0263";"            *"
"IGRTTJ";"S";"0264";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
"IGRTTJ";"S";"0265";"         FINSI"
"IGRTTJ";"S";"0266";"      FINSI"
"IGRTTJ";"S";"0267";"**"
"IGRTTJ";"S";"0268";"      SI HJOU_IJIGRETETR = ""2"""
"IGRTTJ";"S";"0269";"         LOCA_MOT = 1"
"IGRTTJ";"S";"0270";"         SI HABS_MOTIF = ""ZRTJ"""
"IGRTTJ";"S";"0271";"            LOCA_TRANS = HABS_MOTINBR - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0272";"            *"
"IGRTTJ";"S";"0273";"            HJOU_IJRARTTJOU = HABS_MOTINBR"
"IGRTTJ";"S";"0274";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
"IGRTTJ";"S";"0275";"         FINSI"
"IGRTTJ";"S";"0276";"         SI HABS_MOTIF = ""XRTJ"""
