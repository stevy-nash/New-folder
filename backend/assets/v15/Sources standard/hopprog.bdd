"ICONTR";"S";"0108";"DEF LOCA_DELAI N3.2"
"ICONTR";"S";"0109";"LOCA_DELAI = 0"
"ICONTR";"S";"0110";"DEF LOCA_CARENCE N8.2"
"ICONTR";"S";"0111";"LOCA_CARENCE = 0"
"ICONTR";"S";"0112";"DEF LOCA_REST N6.2"
"ICONTR";"S";"0113";"LOCA_REST = 0"
"ICONTR";"S";"0114";"DEF LOCA_INTCAR N8.0"
"ICONTR";"S";"0115";"LOCA_INTCAR = 0"
"ICONTR";"S";"0116";"*"
"ICONTR";"S";"0117";"SI HJOU_DATE <= TEMP_DATJOU"
"ICONTR";"S";"0118";"   LOCA_INBADG = HJOU_IJIGBADGEA"
"ICONTR";"S";"0119";"SINON"
"ICONTR";"S";"0120";"   LOCA_INBADG = ""0"""
"ICONTR";"S";"0121";"FINSI"
"ICONTR";"S";"0122";"*"
"ICONTR";"S";"0123";"SI EMPS_E2DATENAI <> "" """
"ICONTR";"S";"0124";"   DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"ICONTR";"S";"0125";"   LOCA_AGE = TEMP_NXANNEE"
"ICONTR";"S";"0126";"FINSI"
"ICONTR";"S";"0127";"*"
"ICONTR";"S";"0128";"*  mise en place anomalie maxi hebdo le dimanche"
"ICONTR";"S";"0129";"*"
"ICONTR";"S";"0130";"SI HJOU_JOUR = ""7"""
"ICONTR";"S";"0131";"   SI HJOU_IJRTTEFFEH > PARD_IDISMXTHEB"
"ICONTR";"S";"0132";"      ANOMALIE 130"
"ICONTR";"S";"0133";"   FINSI"
"ICONTR";"S";"0134";"* Stockage des 12 dernieres semaines"
"ICONTR";"S";"0135";"   HJOU_IJRHTRAS01 = HJOU_IJRHTRAS02"
"ICONTR";"S";"0136";"   HJOU_IJRHTRAS02 = HJOU_IJRHTRAS03"
"ICONTR";"S";"0137";"   HJOU_IJRHTRAS03 = HJOU_IJRHTRAS04"
"ICONTR";"S";"0138";"   HJOU_IJRHTRAS04 = HJOU_IJRHTRAS05"
"ICONTR";"S";"0139";"   HJOU_IJRHTRAS05 = HJOU_IJRHTRAS06"
"ICONTR";"S";"0140";"   HJOU_IJRHTRAS06 = HJOU_IJRHTRAS07"
"ICONTR";"S";"0141";"   HJOU_IJRHTRAS07 = HJOU_IJRHTRAS08"
"ICONTR";"S";"0142";"   HJOU_IJRHTRAS08 = HJOU_IJRHTRAS09"
"ICONTR";"S";"0143";"   HJOU_IJRHTRAS09 = HJOU_IJRHTRAS10"
"ICONTR";"S";"0144";"   HJOU_IJRHTRAS10 = HJOU_IJRHTRAS11"
"ICONTR";"S";"0145";"   HJOU_IJRHTRAS11 = HJOU_IJRHTRAS12"
"ICONTR";"S";"0146";"   HJOU_IJRHTRAS12 = HJOU_IJRTTEFFEH"
"ICONTR";"S";"0147";"*    calcul de la moyenne"
"ICONTR";"S";"0148";"*"
"ICONTR";"S";"0149";"   HJOU_IJRHTRM12S = HJOU_IJRHTRAS01 + HJOU_IJRHTRAS02"
"ICONTR";"S";"0150";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS03"
"ICONTR";"S";"0151";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS04"
"ICONTR";"S";"0152";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS05"
"ICONTR";"S";"0153";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS06"
"ICONTR";"S";"0154";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS07"
"ICONTR";"S";"0155";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS08"
"ICONTR";"S";"0156";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS09"
"ICONTR";"S";"0157";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS10"
"ICONTR";"S";"0158";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS11"
"ICONTR";"S";"0159";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS12"
"ICONTR";"S";"0160";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S / 12"
"ICONTR";"S";"0161";"*    mise en place de l'anomalie"
"ICONTR";"S";"0162";"*"
"ICONTR";"S";"0163";"   SI HJOU_IJRHTRM12S > PARD_IDISMXT12S"
"ICONTR";"S";"0164";"      ANOMALIE 131"
"ICONTR";"S";"0165";"   FINSI"
"ICONTR";"S";"0166";"FINSI"
"ICONTR";"S";"0167";"*"
"ICONTR";"S";"0168";"* calcul de la dur?e du repos quotidien"
"ICONTR";"S";"0169";"*"
"ICONTR";"S";"0170";"* Si l'age de la personne n'est pas renseigné"
"ICONTR";"S";"0171";"* ou que la personne est majeur"
"ICONTR";"S";"0172";"SI EMPS_E2DATENAI = "" """
"ICONTR";"S";"0173";"OU LOCA_AGE >= 18"
"ICONTR";"S";"0174";"   SI HJOU_IJQDEBADGV > 0"
"ICONTR";"S";"0175";"      SI HJOU_IJQPRBADGV > 0"
"ICONTR";"S";"0176";"         LOCA_REPOS = HJOU_IJQPRBADGV + 24.00"
"ICONTR";"S";"0177";"         LOCA_REPOS = LOCA_REPOS - HJOU_IJRSDBADGV"
"ICONTR";"S";"0178";"      FINSI"
"ICONTR";"S";"0179";"   FINSI"
"ICONTR";"S";"0180";"   SI LOCA_INBADG = ""0"""
"ICONTR";"S";"0181";"** Contrôle si la plage n'est pas à blanc"
"ICONTR";"S";"0182";"      SI PROF_PTTHEO1 > 0"
"ICONTR";"S";"0183";"         SI PROF_PTTHEO1 < 100"
"ICONTR";"S";"0184";"            LOCA_PTTHEO1 = 1"
"ICONTR";"S";"0185";"         FINSI"
"ICONTR";"S";"0186";"      FINSI"
"ICONTR";"S";"0187";"** Contrôle si la plage n'est pas à blanc"
"ICONTR";"S";"0188";"      SI PROF_PTTHEO4 > 0"
"ICONTR";"S";"0189";"         SI PROF_PTTHEO4 < 100"
"ICONTR";"S";"0190";"            LOCA_PTTHEO4 = 1"
"ICONTR";"S";"0191";"         FINSI"
"ICONTR";"S";"0192";"      FINSI"
"ICONTR";"S";"0193";"*"
"ICONTR";"S";"0194";"      SI LOCA_PTTHEO1 = 1"
"ICONTR";"S";"0195";"         LOCA_PREMBT = PROF_PTTHEO1"
"ICONTR";"S";"0196";"         SI LOCA_PTTHEO4 = 1"
"ICONTR";"S";"0197";"            HJOU_IJQDEBADGT = PROF_PTTHEO4"
"ICONTR";"S";"0198";"         SINON"
"ICONTR";"S";"0199";"            HJOU_IJQDEBADGT = PROF_PTTHEO2"
"ICONTR";"S";"0200";"         FINSI"
"ICONTR";"S";"0201";"         LOCA_REPOS = LOCA_PREMBT + 24.00"
"ICONTR";"S";"0202";"         LOCA_REPOS = LOCA_REPOS - HJOU_IJRDBADGTV"
"ICONTR";"S";"0203";"      SINON"
"ICONTR";"S";"0204";"         SI PROF_PTTHEO3 > 0"
"ICONTR";"S";"0205";"            SI PROF_PTTHEO3 < 100"
"ICONTR";"S";"0206";"               LOCA_PREMBT = PROF_PTTHEO3"
"ICONTR";"S";"0207";"               HJOU_IJQDEBADGT = PROF_PTTHEO4"
"ICONTR";"S";"0208";"               LOCA_REPOS = LOCA_PREMBT + 24.00"
"ICONTR";"S";"0209";"               LOCA_REPOS = LOCA_REPOS - HJOU_IJRDBADGTV"
"ICONTR";"S";"0210";"            FINSI"
"ICONTR";"S";"0211";"         FINSI"
"ICONTR";"S";"0212";"      FINSI"
"ICONTR";"S";"0213";"   FINSI"
"ICONTR";"S";"0214";"*"
"ICONTR";"S";"0215";"*"
"ICONTR";"S";"0216";"* anomalie si < 11h"
"ICONTR";"S";"0217";"*"
"ICONTR";"S";"0218";"   SI LOCA_REPOS > 0"
"ICONTR";"S";"0219";"      SI LOCA_REPOS < 11.00"
"ICONTR";"S";"0220";"         ANOMALIE 132"
"ICONTR";"S";"0221";"      FINSI"
"ICONTR";"S";"0222";"   FINSI"
"ICONTR";"S";"0223";"FINSI"
"ICONTR";"S";"0224";"*"
"ICONTR";"S";"0225";"* calcul de l'amplitude de la journ?e"
"ICONTR";"S";"0226";"*"
"ICONTR";"S";"0227";"LOCA_AMPLI = HJOU_IJQDEBADGV - HJOU_IJQPRBADGV"
"ICONTR";"S";"0228";"SI LOCA_AMPLI > 12"
"ICONTR";"S";"0229";"   ANOMALIE 133"
"ICONTR";"S";"0230";"FINSI"
"ICONTR";"S";"0231";"** Contrôle temps minimum légal pour les temps partiels"
"ICONTR";"S";"0232";"** contrôle effectué"
"ICONTR";"S";"0233";"**"
"ICONTR";"S";"0234";"SI HJOU_IJITYPCTRA > 0"
"ICONTR";"S";"0235";"   SI HJOU_IJITYPCTRA < 100"
"ICONTR";"S";"0236";"** pas de contrôle si l'indicateur du contrat ICIDEROG = 1"
"ICONTR";"S";"0237";"      SI CTRA_ICIDEROGTP <> ""1"""
"ICONTR";"S";"0238";"         FAIRE CONTROLE"
"ICONTR";"S";"0239";"      FINSI"
"ICONTR";"S";"0240";"   FINSI"
"ICONTR";"S";"0241";"FINSI"
"ICONTR";"S";"0242";"**********"
"ICONTR";"S";"0243";"* Anomalie des contraintes légales : repos 35h"
"ICONTR";"S";"0244";"* Badgeant"
"ICONTR";"S";"0245";"SI LOCA_INBADG = ""1"""
"ICONTR";"S";"0246";"* Si l'age de la personne n'est pas renseigné"
"ICONTR";"S";"0247";"* ou que la personne est majeur"
"ICONTR";"S";"0248";"   SI EMPS_E2DATENAI = "" """
"ICONTR";"S";"0249";"   OU LOCA_AGE >= 18"
"ICONTR";"S";"0250";"* Récupération des heures effectives de la veille"
"ICONTR";"S";"0251";"* LIREVALPRE LOCA_VEILPRESBA HJOU_IJQPRESBAJ"
"ICONTR";"S";"0252";"      LIREVALPRE LOCA_VEILPRESBA HJOU_IJQTTEFFEJ"
"ICONTR";"S";"0253";"* Si pas d'heures effectives la veille"
"ICONTR";"S";"0254";"      SI LOCA_VEILPRESBA = 0"
"ICONTR";"S";"0255";"*Nb heures repos hebdo"
"ICONTR";"S";"0256";"         SI HJOU_IJRREP35H >= 35"
"ICONTR";"S";"0257";"*Indicateur pour déclenchement ano"
"ICONTR";"S";"0258";"            HJOU_IJRINDANO = 1"
"ICONTR";"S";"0259";"            LOCA_CALCUL = 1"
"ICONTR";"S";"0260";"            HJOU_IJRREP35H = 35"
"ICONTR";"S";"0261";"         FINSI"
"ICONTR";"S";"0262";"      FINSI"
"ICONTR";"S";"0263";"*"
"ICONTR";"S";"0264";"      SI LOCA_CALCUL <> 1"
"ICONTR";"S";"0265";"*Si repos la veille"
"ICONTR";"S";"0266";"* LIREVALPRE LOCA_LENDREP HJOU_IJQNBADGEA"
"ICONTR";"S";"0267";"         LIREVALPRE LOCA_LENDREP2 HJOU_IJQTTEFFEJ"
"ICONTR";"S";"0268";"         SI LOCA_LENDREP2 = 0"
"ICONTR";"S";"0269";"* SI HJOU_IJQPRESBAJ > 0"
"ICONTR";"S";"0270";"            SI HJOU_IJQTTEFFEJ > 0"
"ICONTR";"S";"0271";"*"
"ICONTR";"S";"0272";"               HJOU_IJRREP35H = HJOU_IJRREP35H + LOCA_24"
"ICONTR";"S";"0273";"               HJOU_IJRREP35H = HJOU_IJRREP35H + HJOU_IJQPRBADGV"
"ICONTR";"S";"0274";"*"
"ICONTR";"S";"0275";"               SI HJOU_IJRREP35H < LOCA_35"
"ICONTR";"S";"0276";"                  HJOU_IJRINDANO = HJOU_IJRINDANO + 2"
"ICONTR";"S";"0277";"               SINON"
"ICONTR";"S";"0278";"                  HJOU_IJRINDANO = 1"
"ICONTR";"S";"0279";"               FINSI"
"ICONTR";"S";"0280";"            SINON"
"ICONTR";"S";"0281";"               HJOU_IJRREP35H = HJOU_IJRREP35H + LOCA_24"
"ICONTR";"S";"0282";"            FINSI"
"ICONTR";"S";"0283";"         SINON"
"ICONTR";"S";"0284";"* SI HJOU_IJQPRESBAJ = 0"
"ICONTR";"S";"0285";"            SI HJOU_IJQTTEFFEJ = 0"
"ICONTR";"S";"0286";"               LIREVALPRE LOCA_DERBADG HJOU_IJQDEBADGV"
"ICONTR";"S";"0287";"               HJOU_IJRREP35H = LOCA_24 - LOCA_DERBADG"
"ICONTR";"S";"0288";"            SINON"
"ICTRBA";"S";"0027";"*"
"ICONTR";"S";"0289";"               HJOU_IJRINDANO = HJOU_IJRINDANO + 1"
"ICONTR";"S";"0290";"            FINSI"
"ICONTR";"S";"0291";"         FINSI"
"ICONTR";"S";"0292";"*"
"ICONTR";"S";"0293";"         SI HJOU_IJRINDANO = 7"
"ICONTR";"S";"0294";"* SI HJOU_IJQPRESBAJ <> 0"
"ICONTR";"S";"0295";"            SI HJOU_IJQTTEFFEJ <> 0"
"ICONTR";"S";"0296";"               ANOMALIE 183"
"ICONTR";"S";"0297";"               HJOU_IJRINDANO = 0"
"ICONTR";"S";"0298";"            FINSI"
"ICONTR";"S";"0299";"         FINSI"
"ICONTR";"S";"0300";"*"
"ICONTR";"S";"0301";"         SI HJOU_IJRINDANO = 8"
"ICONTR";"S";"0302";"            ANOMALIE 183"
"ICONTR";"S";"0303";"            HJOU_IJRINDANO = 0"
"ICONTR";"S";"0304";"         FINSI"
"ICONTR";"S";"0305";"      FINSI"
"ICONTR";"S";"0306";"   FINSI"
"ICONTR";"S";"0307";"FINSI"
"ICONTR";"S";"0308";"*"
"ICONTR";"S";"0309";"*-----------------------------------------------------------------"
"ICONTR";"S";"0310";"*                REPOS LEGAL HEBDOMADAIRE                        *"
"ICONTR";"S";"0311";"*-----------------------------------------------------------------"
"ICONTR";"S";"0312";"* Suite à l'ajout de la gestion des moins de 18 ans,"
"ICONTR";"S";"0313";"* ajout du test de l'âge, pour déclencher l'anomalie"
"ICONTR";"S";"0314";"* 159 si la personne est majeure"
"ICONTR";"S";"0315";"*"
"ICONTR";"S";"0316";"SI HJOU_DATE < TEMP_DATJOU"
"ICONTR";"S";"0317";"   SI HJOU_IJQTTEFFEJ > 0"
"ICONTR";"S";"0318";"      HJOU_IJRNBTRAVS = HJOU_IJRNBTRAVS + 1"
"ICONTR";"S";"0319";"   SINON"
"ICONTR";"S";"0320";"      HJOU_IJRNBTRAVS = 0"
"ICONTR";"S";"0321";"   FINSI"
"ICONTR";"S";"0322";"******"
"ICONTR";"S";"0323";"* Pour les personnes d'au moins 18 ans"
"ICONTR";"S";"0324";"   SI EMPS_E2DATENAI = "" """
"ICONTR";"S";"0325";"   OU LOCA_AGE >= 18"
"ICONTR";"S";"0326";"** Mise en place d'une anomalie si plus de 6 jours travaillés"
"ICONTR";"S";"0327";"      SI HJOU_IJRNBTRAVS > 6"
"ICONTR";"S";"0328";"         HJOU_IJRNBTRAVS = 0"
"ICONTR";"S";"0329";"         ANOMALIE 159"
"ICONTR";"S";"0330";"      FINSI"
"ICONTR";"S";"0331";"   FINSI"
"ICONTR";"S";"0332";"FINSI"
"ICONTR";"S";"0333";"*-----------------------------------------------------------------"
"ICONTR";"S";"0334";"*                        DELAI DE CARENCE                         *"
"ICONTR";"S";"0335";"*-----------------------------------------------------------------"
"ICONTR";"S";"0336";"* Stockage de la date de fin de contrat"
"ICONTR";"S";"0337";"*"
"ICONTR";"S";"0338";"SI CTRA_TYPCTRA = ""CDD"""
"ICONTR";"S";"0339";"OU CADM_TYPCTRA = ""CDD"""
"ICONTR";"S";"0340";"   SI HJOU_DATE = CTRA_DATFIN"
"ICONTR";"S";"0341";"* Stockage de la date de fin de contrat"
"ICONTR";"S";"0342";"      DATDIFF CTRA_DATDEB 12 CTRA_DATFIN 12"
"ICONTR";"S";"0343";"* Stockage du nombre de jours dans le contrat"
"ICONTR";"S";"0344";"      HJOU_IJRNBRJCTR = TEMP_NXJOUR"
"ICONTR";"S";"0345";"      HJOU_IJRNBRJCTR = TEMP_NXJOUR + 1"
"ICONTR";"S";"0346";"*"
"ICONTR";"S";"0347";"      SI HJOU_IJRNBRJCTR >= 14"
"ICONTR";"S";"0348";"         LOCA_CARENCE = HJOU_IJRNBRJCTR / 3"
"ICONTR";"S";"0349";"      SINON"
"ICONTR";"S";"0350";"         LOCA_CARENCE = HJOU_IJRNBRJCTR / 2"
"ICONTR";"S";"0351";"      FINSI"
"ICONTR";"S";"0352";"**"
"ICONTR";"S";"0353";"**arrondi"
"ICONTR";"S";"0354";"**"
"ICONTR";"S";"0355";"      LOCA_REST = LOCA_CARENCE % 1"
"ICONTR";"S";"0356";"      LOCA_CARENCE = LOCA_CARENCE - LOCA_REST"
"ICONTR";"S";"0357";"      SI LOCA_REST > 0"
"ICONTR";"S";"0358";"         LOCA_CARENCE = LOCA_CARENCE + 1"
"ICONTR";"S";"0359";"      FINSI"
"ICONTR";"S";"0360";"** Dans le cas ou les jours d'ouverture sont du lundi au vendredi"
"ICONTR";"S";"0361";"      SI PARD_IDIJOUROUV = ""0"""
"ICONTR";"S";"0362";"* - DURÉE DU CONTRAT À DIVISER PAR 2 OU 3"
"ICONTR";"S";"0363";"*- DIVISER LE CHIFFRE OBTENU PAR 5"
"ICONTR";"S";"0364";"*- PRENDRE LA PARTIE ENTIÈRE, LA MULTIPLIER PAR 2 (4 *2 = 8) ET L'AJOUTER"
"ICONTR";"S";"0365";"*"
"ICONTR";"S";"0366";"         LOCA_DELAI = LOCA_CARENCE / 5"
"ICONTR";"S";"0367";"         LOCA_REST = LOCA_DELAI % 1"
"ICONTR";"S";"0368";"         LOCA_DELAI = LOCA_DELAI - LOCA_REST"
"ICONTR";"S";"0369";"         LOCA_DELAI = LOCA_DELAI * 2"
"ICONTR";"S";"0370";"         LOCA_CARENCE = LOCA_DELAI + LOCA_CARENCE"
"ICONTR";"S";"0371";"      FINSI"
"ICONTR";"S";"0372";"*"
"ICONTR";"S";"0373";"      LOCA_INTCAR = LOCA_CARENCE"
"ICONTR";"S";"0374";"      DATAJT CTRA_DATFIN 12 ""J"" LOCA_INTCAR"
"ICONTR";"S";"0375";"      CADM_DATCARENCE = TEMP_DXFINPER"
"ICONTR";"S";"0376";"   FINSI"
"ICONTR";"S";"0377";"SINON"
"ICONTR";"S";"0378";"   CADM_DATCARENCE = "" """
"ICONTR";"S";"0379";"FINSI"
"ICONTR";"S";"0380";"*"
"ICONTR";"S";"0381";"FIN"
"ICONTR";"S";"0382";"*"
"ICONTR";"S";"0383";"PROC CONTROLE"
"ICONTR";"S";"0384";"*"
"ICONTR";"S";"0385";"   SI HJOU_JOUR = ""7"""
"ICONTR";"S";"0386";"      SI HORC_MOYCYCLE < PARD_IDIMINLEGA"
"ICONTR";"S";"0387";"         ANOMALIE 180"
"ICONTR";"S";"0388";"      FINSI"
"ICONTR";"S";"0389";"   FINSI"
"ICONTR";"S";"0390";"*"
"ICONTR";"S";"0391";"FINPROC"
