"ICONSCPCH";"S";"0515";"                           LOCA_VAL = 0"
"ICONSCPCH";"S";"0516";"                           LOCA_VALCP = ""J"""
"ICONSCPCH";"S";"0517";"                           LOCA_NOANNUL = 1"
"ICONSCPCH";"S";"0518";"                        SINON"
"ICONSCPCH";"S";"0519";"                           SI HJOU_IJRSCPNTRA > 0"
"ICONSCPCH";"S";"0520";"                              HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + HJOU_IJRSCPNTRA"
"ICONSCPCH";"S";"0521";"*"
