"ITPSACTPT9";"S";"0016";"*"
"ITPSACTPT9";"S";"0017";"* Rôle :"
"ITPSACTPT9";"S";"0018";"*"
"ITPSACTPT9";"S";"0019";"* Calcul du temps de présence activité avec la présence théorique"
"ITPSACTPT9";"S";"0020";"* pour population = section et mode semaine"
"ITPSACTPT9";"S";"0021";"* (gestion activité avec indicateur dans SEH)"
"ITPSACTPT9";"S";"0022";"*"
"ITPSACTPT9";"S";"0023";"*"
"ITPSACTPT9";"S";"0024";"*----------------------------------------------------------------------"
"ITPSACTPT9";"S";"0025";"*"
"ITPSACTPT9";"S";"0026";"* Modifiée par :"
"ITPSACTPT9";"S";"0027";"* Date         : JJ/MM/AAAA"
"ITPSACTPT9";"S";"0028";"* Objet        :"
"ITPSACTPT9";"S";"0029";"*"
"ITPSACTPT9";"S";"0030";"***********************************************************************"
"ITPSACTPT9";"S";"0031";"*"
"ITPSACTPT9";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTPT9";"S";"0033";"*"
"ITPSACTPT9";"S";"0034";"DEBDICO"
"ITPSACTPT9";"S";"0035";"SECH_ISIACTI;O;A1;X;;;123456789;L;;C3;""Section géré en activité"";"
"ITPSACTPT9";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTPT9";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTPT9";"S";"0038";"FINDICO"
"ITPSACTPT9";"S";"0039";"*"
"ITPSACTPT9";"S";"0040";"*"
"ITPSACTPT9";"S";"0041";"* DEBANO"
"ITPSACTPT9";"S";"0042";"*"
"ITPSACTPT9";"S";"0043";"* FINANO"
"ITPSACTPT9";"S";"0044";"*"
"ITPSACTPT9";"S";"0045";"* Définition des variables locales"
"ITPSACTPT9";"S";"0046";"*"
"ITPSACTPT9";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTPT9";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTPT9";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTPT9";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTPT9";"S";"0051";"    FINSI"
"ITPSACTPT9";"S";"0052";"FINSI"
"ITPSACTPT9";"S";"0053";"*"
"ITPSACTPT9";"S";"0054";"* Employé géré en activité"
"ITPSACTPT9";"S";"0055";"SI HJOU_IJIACTI <> "" """
"ITPSACTPT9";"S";"0056";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTPT9";"S";"0057";"        * Calcul de la présence activité le dimanche"
"ITPSACTPT9";"S";"0058";"        * Ou dernier jour du contrat"
"ITPSACTPT9";"S";"0059";"        SI HJOU_JOUR = ""7"""
"ITPSACTPT9";"S";"0060";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTPT9";"S";"0061";"            SI PRES_VALID <> ""O"""
"ITPSACTPT9";"S";"0062";"                PRES_VALID = ""N"""
"ITPSACTPT9";"S";"0063";"                *"
"ITPSACTPT9";"S";"0064";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTPT9";"S";"0065";"                SI HJOU_SECTAFF <> "" """
"ITPSACTPT9";"S";"0066";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTPT9";"S";"0067";"                SINON"
"ITPSACTPT9";"S";"0068";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTPT9";"S";"0069";"                FINSI"
"ITPSACTPT9";"S";"0070";"                *"
"ITPSACTPT9";"S";"0071";"                SI PRES_MODE_TRV = "" """
"ITPSACTPT9";"S";"0072";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPT9";"S";"0073";"                FINSI"
"ITPSACTPT9";"S";"0074";"                *"
"ITPSACTPT9";"S";"0075";"                * ----------------------------------------------------------------------------------"
"ITPSACTPT9";"S";"0076";"                *"
"ITPSACTPT9";"S";"0077";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTPT9";"S";"0078";"                *                              (A décommenter si besoin)"
"ITPSACTPT9";"S";"0079";"                *"
"ITPSACTPT9";"S";"0080";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTPT9";"S";"0081";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test de la"
"ITPSACTPT9";"S";"0082";"                * présence théorique différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTPT9";"S";"0083";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTPT9";"S";"0084";"                *"
"ITPSACTPT9";"S";"0085";"                * SI HJOU_IJRPRETHEH <> 0"
"ITPSACTPT9";"S";"0086";"                    PRES_TPS_PRES = HJOU_IJRPRETHEH"
"ITPSACTPT9";"S";"0087";"                * SINON"
"ITPSACTPT9";"S";"0088";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTPT9";"S";"0089";"                * FINSI"
"ITPSACTPT9";"S";"0090";"                * ----------------------------------------------------------------------------------"
"ITPSACTPT9";"S";"0091";"                *"
"ITPSACTPT9";"S";"0092";"                PRES_TPS_IMPUTE = 0"
"ITPSACTPT9";"S";"0093";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTPT9";"S";"0094";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTPT9";"S";"0095";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTPT9";"S";"0096";"                    POUR EVENEMENTS"
"ITPSACTPT9";"S";"0097";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTPT9";"S";"0098";"                    FINPOUR"
"ITPSACTPT9";"S";"0099";"                FINSI"
"ITPSACTPT9";"S";"0100";"                *"
"ITPSACTPT9";"S";"0101";"                * Calcul de l'écart"
"ITPSACTPT9";"S";"0102";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTPT9";"S";"0103";"            FINSI"
"ITPSACTPT9";"S";"0104";"        FINSI"
"ITPSACTPT9";"S";"0105";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTPT9";"S";"0106";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTPT9";"S";"0107";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTPT9";"S";"0108";"        FINSI"
"ITPSACTPT9";"S";"0109";"    FINSI"
"ITPSACTPT9";"S";"0110";"FINSI"
"ITPSACTPT9";"S";"0111";"*"
"ITPSACTPT9";"S";"0112";"FIN"
