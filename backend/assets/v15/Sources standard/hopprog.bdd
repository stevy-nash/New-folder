"ICONSCONG";"S";"0648";"   FINSI"
"ICONSCONG";"S";"0649";"** Initialisation du compteur de samedi CP par consigne"
"ICONSCONG";"S";"0650";"      POUR ACTIVITES"
"ICONSCONG";"S";"0651";"         SI HABS_MOTIF = ""ZCPSAM"""
"ICONSCONG";"S";"0652";"            HJOU_IJRNBCPSAM = HABS_MOTINBR"
"ICONSCONG";"S";"0653";"         FINSI"
"ICONSCONG";"S";"0654";"         SI HABS_MOTIF = ""XCPSAM"""
"ICONSCONG";"S";"0655";"            HJOU_IJRNBCPSAM = HJOU_IJRNBCPSAM + HABS_MOTINBR"
"ICONSCONG";"S";"0656";"         FINSI"
"ICONSCONG";"S";"0657";"      FINPOUR"
"ICONSCONG";"S";"0658";"*** fin de calcul maintien CP samedi"
"ICONSCONG";"S";"0659";"   * FINSI"
"ICONSCONG";"S";"0660";"*Pour ajouter les cp sur jour non travaillé"
"ICONSCONG";"S";"0661";"*RAZ"
"ICONSCONG";"S";"0662";"   * Maintenir le CP lorqu'il y a un CP"
"ICONSCONG";"S";"0663";"   * suivi d'un motif maintenant les congés"
"ICONSCONG";"S";"0664";"   * suivi d'un jour de repos"
"ICONSCONG";"S";"0665";"   SI HJOU_IJRJRCONG <> 0"
"ICONSCONG";"S";"0666";"      *RAZ"
"ICONSCONG";"S";"0667";"      HJOU_IJRJRCONG = 0"
"ICONSCONG";"S";"0668";"   FINSI"
"ICONSCONG";"S";"0669";"    *Récupération si il y a un CP sur la journée"
"ICONSCONG";"S";"0670";"   POUR ACTIVITES"
"ICONSCONG";"S";"0671";"      * Maintien motif CP"
"ICONSCONG";"S";"0672";"      SI MOTI_IMICONTCPS = ""3"""
"ICONSCONG";"S";"0673";"* LOCA_VALID = MOTI_VALID"
"ICONSCONG";"S";"0674";"* Ouvrés"
"ICONSCONG";"S";"0853";"            * Travail journée complète"
"ICONSCONG";"S";"0675";"         LOCA_ACQUIS = HORC_IHIDRJTRAV + HORC_IHIDRNTRAV"
"ICONSCONG";"S";"0676";"         SI LOCA_ACQUIS = 2.08"
"ICONSCONG";"S";"0677";"            LOCA_JOUR = ""5"""
"ICONSCONG";"S";"0678";"         FINSI"
"ICONSCONG";"S";"0679";"* Ouvrables"
"ICONSCONG";"S";"0680";"         SI LOCA_ACQUIS = 2.50"
"ICONSCONG";"S";"0681";"            LOCA_JOUR = ""6"""
"ICONSCONG";"S";"0682";"         FINSI"
"ICONSCONG";"S";"0683";"* Uniquement jusqu'au dernier jour de la semaine"
"ICONSCONG";"S";"0684";"         SI HJOU_JOUR < LOCA_JOUR"
"ICONSCONG";"S";"0685";"            SI HABS_VALORIS = ""J"""
"ICONSCONG";"S";"0686";"               SI PROF_ABSENS <> 0"
"ICONSCONG";"S";"0687";"                  HJOU_IJRJRCONG = 1"
"ICONSCONG";"S";"0688";"               SINON"
"ICONSCONG";"S";"0689";"* Cas où une personne ne travaille que le matin"
"ICONSCONG";"S";"0690";"                  SI PROF_ABSENJ = PROF_ABSENM"
"ICONSCONG";"S";"0691";"                     HJOU_IJRJRCONG = 1"
"ICONSCONG";"S";"0692";"                  SINON"
"ICONSCONG";"S";"0693";"                     SI HJOU_IJQPRETHEJ <> 0"
"ICONSCONG";"S";"0694";"                        HJOU_IJRJRCONG = 0"
"ICONSCONG";"S";"0695";"                     SINON"
"ICONSCONG";"S";"0696";"                        HJOU_IJRJRCONG = 1"
"ICONSCONG";"S";"0697";"                     FINSI"
"ICONSCONG";"S";"0698";"                  FINSI"
"ICONSCONG";"S";"0699";"               FINSI"
"ICONSCONG";"S";"0700";"            SINON"
"ICONSCONG";"S";"0701";"               SI HABS_VALORIS = ""A"""
"ICONSCONG";"S";"0702";"                  HJOU_IJRJRCONG = 1"
"ICONSCONG";"S";"0703";"               SINON"
"ICONSCONG";"S";"0704";"                  SI HABS_VALORIS = ""M"""
"ICONSCONG";"S";"0705";"                     HJOU_IJRJRCONG = 0"
"ICONSCONG";"S";"0706";"                  FINSI"
"ICONSCONG";"S";"0707";"               FINSI"
"ICONSCONG";"S";"0708";"            FINSI"
"ICONSCONG";"S";"0709";"         FINSI"
"ICONSCONG";"S";"0710";"      FINSI"
"ICONSCONG";"S";"0711";"   FINPOUR"
"ICONSCONG";"S";"0712";"* FINSI"
"ICONSCONG";"S";"0713";"FINSI"
"ICONSCONG";"S";"0714";"FIN"
"ICONSCONG";"S";"0715";"*"
"ICONSCONG";"S";"0716";"PROC TPSPART"
"ICONSCONG";"S";"0717";"    * Gestion temps partiel avec jour travaillés/non travaillés"
"ICONSCONG";"S";"0718";"    SI HJOU_IJQPRETHEJ = 0"
"ICONSCONG";"S";"0719";"        * Pris dans non travaillé"
"ICONSCONG";"S";"0720";"        SI HJOU_IJRSCPNTRA >= LOCA_VAL"
"ICONSCONG";"S";"0721";"            HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + LOCA_VAL"
"ICONSCONG";"S";"0722";"            HJOU_IJRSCPNTRA = HJOU_IJRSCPNTRA - LOCA_VAL"
"ICONSCONG";"S";"0723";"            *"
"ICONSCONG";"S";"0724";"            HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + LOCA_VAL"
"ICONSCONG";"S";"0725";"            HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_VAL"
"ICONSCONG";"S";"0726";"        SINON"
"ICONSCONG";"S";"0727";"            SI HJOU_IJRSCPNTRA > 0"
"ICONSCONG";"S";"0728";"                HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + HJOU_IJRSCPNTRA"
"ICONSCONG";"S";"0729";"                *"
"ICONSCONG";"S";"0730";"                HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + HJOU_IJRSCPNTRA"
"ICONSCONG";"S";"0731";"                HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HJOU_IJRSCPNTRA"
"ICONSCONG";"S";"0732";"                HJOU_IJRSCPNTRA = 0"
"ICONSCONG";"S";"0733";"            FINSI"
"ICONSCONG";"S";"0734";"        FINSI"
"ICONSCONG";"S";"0735";"    SINON"
"ICONSCONG";"S";"0736";"        * Travail en demi-journée"
"ICONSCONG";"S";"0737";"        SI PROF_ABSENJ = PROF_ABSENM"
"ICONSCONG";"S";"0738";"        OU PROF_ABSENJ = PROF_ABSENS"
"ICONSCONG";"S";"0739";"            SI PROF_ABSENJ <> 0"
"ICONSCONG";"S";"0740";"                SI LOCA_VALORIS = ""J"""
"ICONSCONG";"S";"0741";"                    SI HJOU_IJRSCPTRA >= 0.5"
"ICONSCONG";"S";"0742";"                        * Pris dans travaillé"
"ICONSCONG";"S";"0743";"                        HJOU_IJRCCPTRA = HJOU_IJRCCPTRA + 0.5"
"ICONSCONG";"S";"0744";"                        HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - 0.5"
"ICONSCONG";"S";"0745";"                        *"
"ICONSCONG";"S";"0746";"                        HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + 0.5"
"ICONSCONG";"S";"0747";"                        HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - 0.5"
"ICONSCONG";"S";"0748";"                    SINON"
"ICONSCONG";"S";"0749";"                        SI HJOU_IJRSCPTRA > 0"
"ICONSCONG";"S";"0750";"                            HJOU_IJRCCPTRA = HJOU_IJRCCPTRA + HJOU_IJRSCPTRA"
"ICONSCONG";"S";"0751";"                            *"
"ICONSCONG";"S";"0752";"                            HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + HJOU_IJRSCPTRA"
"ICONSCONG";"S";"0753";"                            HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HJOU_IJRSCPTRA"
"ICONSCONG";"S";"0754";"                            HJOU_IJRSCPTRA = 0"
"ICONSCONG";"S";"0755";"                        FINSI"
"ICONSCONG";"S";"0756";"                    FINSI"
"ICONSCONG";"S";"0757";"                    *"
"ICONSCONG";"S";"0758";"                    SI HJOU_IJRSCPNTRA >= 0.5"
"ICONSCONG";"S";"0759";"                        * Pris dans non travaillé"
"ICONSCONG";"S";"0760";"                        HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + 0.5"
"ICONSCONG";"S";"0761";"                        HJOU_IJRSCPNTRA = HJOU_IJRSCPNTRA - 0.5"
