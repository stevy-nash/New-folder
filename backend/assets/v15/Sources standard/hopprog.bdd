"IGRTTJ";"S";"0279";"            LOCA_TRANS = LOCA_DROIT - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0280";"            *"
"IGRTTJ";"S";"0281";"            HJOU_IJRARTTJOU = HJOU_IJRARTTJOU + HABS_MOTINBR"
"IGRTTJ";"S";"0282";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
