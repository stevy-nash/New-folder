"IRETEN";"S";"0030";"*"
"IRETEN";"S";"0031";"DEBDICO"
"IRETEN";"S";"0032";"   HJOU_IJQABSPLFJ;N;T6,2;I;;;    56789;;;V3;""Total absences plages"";"
"IRETEN";"S";"0033";"FINDICO"
"IRETEN";"S";"0034";"*"
"IRETEN";"S";"0035";"* Déclaration des donnees locales"
"IRETEN";"S";"0036";"*"
"IRETEN";"S";"0037";"SI HJOU_DATE <= TEMP_DATJOU"
"IRETEN";"S";"0038";"   HJOU_IJQABSPLFJ = HJOU_IJQABSPLFT"
"IRETEN";"S";"0039";"* Initialisation par consigne"
"IRETEN";"S";"0040";"   POUR ACTIVITES"
"IRETEN";"S";"0041";"      SI HABS_MOTIF = ""ZABS"""
"IRETEN";"S";"0042";"         HJOU_IJQABSPLFJ = HABS_MOTIDUR"
"IRETEN";"S";"0043";"      FINSI"
"IRETEN";"S";"0044";"   FINPOUR"
"IRETEN";"S";"0045";"FINSI"
"IRETEN";"S";"0046";"FIN"
"ISOLDECP";"S";"0001";"***********************************************************************"
"ISOLDECP";"S";"0002";"*"
"ISOLDECP";"S";"0003";"* Règle : ISOLDECP"
"ISOLDECP";"S";"0004";"* Ordre : 3650"
"ISOLDECP";"S";"0005";"* Titre : Gestion du solde des congés payés"
"ISOLDECP";"S";"0006";"*"
"ISOLDECP";"S";"0007";"*----------------------------------------------------------------------"
"ISOLDECP";"S";"0008";"*"
"ISOLDECP";"S";"0009";"* Créé par : Méthodes et outils"
"ISOLDECP";"S";"0010";"* Date     : 06/05/2019"
"ISOLDECP";"S";"0011";"* Version  : 1"
"ISOLDECP";"S";"0012";"*"
"ISOLDECP";"S";"0013";"*----------------------------------------------------------------------"
"ISOLDECP";"S";"0014";"*"
"ISOLDECP";"S";"0015";"*"
"ISOLDECP";"S";"0016";"* Rôle : Gestion du solde des congés payés"
"ISOLDECP";"S";"0017";"*"
"ISOLDECP";"S";"0018";"*        Récupération de la partie calcul du solde des congés payés"
"ISOLDECP";"S";"0019";"*        de la règle ICONGE, ICONGEP et ICONGES du package indus V11 suite"
"ISOLDECP";"S";"0020";"*        à la division de la règle en droit / pris /solde"
"ISOLDECP";"S";"0021";"*"
"ISOLDECP";"S";"0022";"* Implémentation des données industrielles"
"ISOLDECP";"S";"0023";"*"
"ISOLDECP";"S";"0024";"*"
"ISOLDECP";"S";"0025";"*----------------------------------------------------------------------"
"ISOLDECP";"S";"0026";"*"
"ISOLDECP";"S";"0027";"* Modifiée par :"
"ISOLDECP";"S";"0028";"* Date         : JJ/MM/AAAA"
"ISOLDECP";"S";"0029";"* Objet        :"
"ISOLDECP";"S";"0030";"*"
"ISOLDECP";"S";"0031";"*"
"ISOLDECP";"S";"0032";"***********************************************************************"
"ISOLDECP";"S";"0033";"*"
"ISOLDECP";"S";"0034";"DEBDICO"
"ISOLDECP";"S";"0035";"   HJOU_IJRSCORELI;N;N6,1;I;;;    56789;;IJRSCORELI;V3;""Reliquat congé payé"";"
"ISOLDECP";"S";"0036";"   HJOU_IJRSCOPRIN;N;N6,1;I;;;    56789;;IJRSCOPRIN;V3;""Solde congé payé"";"
"ISOLDECP";"S";"0037";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"ISOLDECP";"S";"0038";"   HJOU_IJRSGCONGE;N;N6,2;I;;;    56789;;IJRSGCONGE;V3;""Solde global des congés"";"
"ISOLDECP";"S";"0039";"   EMPL_IEQSPGCONG;N;N6,1;I;;;    56789;;;V3;""Solde prévisionnel des congés"";"
"ISOLDECP";"S";"0040";"   EMPL_IEQSPGCON2;N;N6,1;I;;;    56789;;;V3;""Solde prév. global des congés période 2"";"
"ISOLDECP";"S";"0041";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"ISOLDECP";"S";"0042";"   HJOU_IJRCOVER;N;N5,2;I;;;    56789;;IJRCOVER;V3;""Jours de congés versés"";"
"ISOLDECP";"S";"0043";"   HORC_IHIMOACQCP;O;A1;X;;;123456789;L;;C3;""Mode d'acquisition des congés"";"
"ISOLDECP";"S";"0044";"   HJOU_IJRSACQCP;N;N6,2;I;;;    56789;;IJRSACQCP;V3;""Solde acquisition congé"";"
"ISOLDECP";"S";"0045";"   * CP sur jours travaillés"
"ISOLDECP";"S";"0046";"   HJOU_IJRSCPTRA;N;N5,1;I;;;    56789;;IJRSCPTRA;V3;""Solde CP travaillés"";"
"ISOLDECP";"S";"0047";"FINDICO"
"ISOLDECP";"S";"0048";"*"
"ISOLDECP";"S";"0049";"DEBANO"
"ISOLDECP";"S";"0050";"   156;9;""Solde CP insuffisant pour transfert en CET"";"
"ISOLDECP";"S";"0051";"   185;9;""Solde congés ancienneté insuffisant pour transfert en CET"";"
"ISOLDECP";"S";"0052";"   189;9;""Solde congés insuffisant pour transfert en don jours d'absence"";"
"ISOLDECP";"S";"0053";"FINANO"
"ISOLDECP";"S";"0054";"*"
"ISOLDECP";"S";"0055";"* Déclaration des donnees locales"
"ISOLDECP";"S";"0056";"* Variables utilisées pour calculer la date de reference"
"ISOLDECP";"S";"0057";"DEF LOCA_DATE D"
"ISOLDECP";"S";"0058";"DEF LOCA_DATEFU D"
"ISOLDECP";"S";"0059";"DEF LOCA_DATEFU2 D"
"ISOLDECP";"S";"0060";"DEF LOCA_ACOURS N4"
"ISOLDECP";"S";"0061";"DEF LOCA_ACOURS2 N4"
"ISOLDECP";"S";"0062";"DEF LOCA_REF N2"
"ISOLDECP";"S";"0063";"* stockage de l'année du jour de l'historique"
"ISOLDECP";"S";"0064";"LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"ISOLDECP";"S";"0065";"* stockage du mois de reference"
"ISOLDECP";"S";"0066";"LOCA_REF << CONF_ITIVMREFCP(3:2)"
"ISOLDECP";"S";"0067";"* stokage du mois de reference"
"ISOLDECP";"S";"0068";"LOCA_DATE(5:2) << LOCA_REF"
"ISOLDECP";"S";"0069";"* stockage du jour de reference"
"ISOLDECP";"S";"0070";"LOCA_REF << CONF_ITIVMREFCP(1:2)"
"ISOLDECP";"S";"0071";"* loca_date contient maintenant l'année du jour de l'historique"
"ISOLDECP";"S";"0072";"* et le mois et le jour de reference"
"ISOLDECP";"S";"0073";"LOCA_DATE(7:2) << LOCA_REF"
"ISOLDECP";"S";"0074";"* stockage de l'annee en cours"
"ISOLDECP";"S";"0075";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"ISOLDECP";"S";"0076";"LOCA_ACOURS2 = LOCA_ACOURS + 1"
"ISOLDECP";"S";"0077";"*"
"ISOLDECP";"S";"0078";"* calcul de la date de reference d'initialisation de cp"
"ISOLDECP";"S";"0079";"* et de date butoir  pour calculer le solde futur"
"ISOLDECP";"S";"0080";"SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"ISOLDECP";"S";"0081";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"ISOLDECP";"S";"0082";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"ISOLDECP";"S";"0083";"*"
"ISOLDECP";"S";"0084";"FINSI"
"ISOLDECP";"S";"0085";"LOCA_DATEFU(1:4) << LOCA_ACOURS"
"ISOLDECP";"S";"0086";"LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"ISOLDECP";"S";"0087";"LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"ISOLDECP";"S";"0088";"LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"ISOLDECP";"S";"0089";"*"
"ISOLDECP";"S";"0090";"* test si gestion des cp"
"ISOLDECP";"S";"0091";"SI HJOU_IJIACOPRIN = ""1"""
"ISOLDECP";"S";"0092";"   POUR ACTIVITES"
"ISOLDECP";"S";"0093";"** transfert de CP en CET"
"ISOLDECP";"S";"0094";"      SI HABS_MOTIF = ""YCPCET"""
"ISOLDECP";"S";"0095";"         SI HABS_MOTINBR <= HJOU_IJRSCOPRIN"
"ISOLDECP";"S";"0096";"            HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HABS_MOTINBR"
"ISOLDECP";"S";"0097";"*Jours de congés versés"
"ISOLDECP";"S";"0098";"            HJOU_IJRCOVER = HJOU_IJRCOVER + HABS_MOTINBR"
"ISOLDECP";"S";"0099";"            SI HORC_IHIDRNTRAV <> 0"
"ISOLDECP";"S";"0100";"                HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - HABS_MOTINBR"
"ISOLDECP";"S";"0101";"            FINSI"
"ISOLDECP";"S";"0102";"         SINON"
"ISOLDECP";"S";"0103";"* solde cp insuffisant pour transfert en CET"
"ISOLDECP";"S";"0104";"            ANOMALIE 156"
"ISOLDECP";"S";"0105";"            TEMP_ITQTRCPCET = 1"
"ISOLDECP";"S";"0106";"         FINSI"
"ISOLDECP";"S";"0107";"      FINSI"
"ISOLDECP";"S";"0108";"** transfert de CP ancienneté en CET"
"ISOLDECP";"S";"0109";"      SI HABS_MOTIF = ""YCACET"""
"ISOLDECP";"S";"0110";"         SI HABS_MOTINBR <= HJOU_IJRSCOANCI"
"ISOLDECP";"S";"0111";"            HJOU_IJRSCOANCI = HJOU_IJRSCOANCI - HABS_MOTINBR"
"ISOLDECP";"S";"0112";"         SINON"
"ISOLDECP";"S";"0113";"* solde cp ancienneté insuffisant pour transfert en CET"
"ISOLDECP";"S";"0114";"            ANOMALIE 185"
"ISOLDECP";"S";"0115";"            TEMP_ITQTRCACET = 1"
"ISOLDECP";"S";"0116";"         FINSI"
"ISOLDECP";"S";"0117";"      FINSI"
"ISOLDECP";"S";"0118";"** transfert de CP en don absence"
"ISOLDECP";"S";"0119";"      SI HABS_MOTIF = ""YCPDON"""
"ISOLDECP";"S";"0120";"         SI HABS_MOTINBR <= HJOU_IJRSCOPRIN"
"ISOLDECP";"S";"0121";"            HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HABS_MOTINBR"
"ISOLDECP";"S";"0122";"*Jours de congés versés"
"ISOLDECP";"S";"0123";"            HJOU_IJRCOVER = HJOU_IJRCOVER + HABS_MOTINBR"
"ISOLDECP";"S";"0124";"            SI HORC_IHIDRNTRAV <> 0"
"ISOLDECP";"S";"0125";"                HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - HABS_MOTINBR"
"ISOLDECP";"S";"0126";"            FINSI"
"ISOLDECP";"S";"0127";"         SINON"
"ISOLDECP";"S";"0128";"* solde cp insuffisant pour transfert en don absence"
"ISOLDECP";"S";"0129";"            ANOMALIE 189"
"ISOLDECP";"S";"0130";"            TEMP_ITQTRCPDON = 1"
"ISOLDECP";"S";"0131";"         FINSI"
"ISOLDECP";"S";"0132";"      FINSI"
"ISOLDECP";"S";"0133";"   FINPOUR"
"ISOLDECP";"S";"0134";"*  totalisation des soldes***"
"ISOLDECP";"S";"0135";"   HJOU_IJRSGCONGE = HJOU_IJRSCORELI"
"ISOLDECP";"S";"0136";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOANCI"
"ISOLDECP";"S";"0137";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOPRIN"
"ISOLDECP";"S";"0138";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSACQCP"
"ISOLDECP";"S";"0139";"   *"
"ISOLDECP";"S";"0140";"   POUR ACTIVITES"
"ISOLDECP";"S";"0141";"      SI HABS_MOTIF = ""ZCJVER"""
"ISOLDECP";"S";"0142";"         HJOU_IJRCOVER = HABS_MOTINBR"
"ISOLDECP";"S";"0143";"      FINSI"
"ISOLDECP";"S";"0144";"      SI HABS_MOTIF = ""XCJVER"""
"ISOLDECP";"S";"0145";"         HJOU_IJRCOVER = HJOU_IJRCOVER + HABS_MOTINBR"
"ISOLDECP";"S";"0146";"      FINSI"
"ISOLDECP";"S";"0147";"   FINPOUR"
"ISOLDECP";"S";"0148";"*"
"ISOLDECP";"S";"0149";"* alimentation du solde prévisionnel"
"ISOLDECP";"S";"0150";"*"
"ISOLDECP";"S";"0151";"* ca ou l'employé a une date de fin de contrat ou date de cloture < loca_datefu"
"ISOLDECP";"S";"0152";"*"
"ISOLDECP";"S";"0153";"   SI CTRA_DATFIN > TEMP_DATJOU"
"ISOLDECP";"S";"0154";"      SI CTRA_DATFIN < LOCA_DATEFU"
"ISOLDECP";"S";"0155";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"ISOLDECP";"S";"0156";"         LOCA_DATEFU = TEMP_DXFINPER"
"ISOLDECP";"S";"0157";"      SINON"
"ISOLDECP";"S";"0158";"         SI CTRA_DATFIN < LOCA_DATEFU2"
"ISOLDECP";"S";"0159";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"ISOLDECP";"S";"0160";"            LOCA_DATEFU2 = TEMP_DXFINPER"
"ISOLDECP";"S";"0161";"         FINSI"
"ISOLDECP";"S";"0162";"      FINSI"
"ISOLDECP";"S";"0163";"   FINSI"
"ISOLDECP";"S";"0164";"***"
"ISOLDECP";"S";"0165";"   SI TEMP_DATSUI = LOCA_DATEFU"
"ISOLDECP";"S";"0166";"      EMPL_IEQSPGCONG = HJOU_IJRSGCONGE"
"ISOLDECP";"S";"0167";"   FINSI"
"ISOLDECP";"S";"0168";"   SI TEMP_DATSUI = LOCA_DATEFU2"
"ISOLDECP";"S";"0169";"      EMPL_IEQSPGCON2 = HJOU_IJRSGCONGE"
"ISOLDECP";"S";"0170";"   FINSI"
"ISOLDECP";"S";"0171";"FINSI"
"ISOLDECP";"S";"0172";"FIN"
"ISTATI";"S";"0001";"***********************************************************************"
