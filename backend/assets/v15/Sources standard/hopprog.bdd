"IPOPUACTS";"S";"0018";"*"
"IPOPUACTS";"S";"0019";"*----------------------------------------------------------------------"
"IPOPUACTS";"S";"0020";"*"
"IPOPUACTS";"S";"0021";"* Modifiée par :"
"IPOPUACTS";"S";"0022";"* Date         : JJ/MM/AAAA"
"IPOPUACTS";"S";"0023";"* Objet        :"
"IPOPUACTS";"S";"0024";"*"
"IPOPUACTS";"S";"0025";"***********************************************************************"
"IPOPUACTS";"S";"0026";"*"
"IPOPUACTS";"S";"0027";"* Implémentation des données industrielles"
"IPOPUACTS";"S";"0028";"*"
"IPOPUACTS";"S";"0029";"DEBDICO"
"IPOPUACTS";"S";"0030";"SECH_ISIACTI;O;A1;X;;;123456789;L;;C3;""Section gérée en activité"";"
"IPOPUACTS";"S";"0031";"FINDICO"
"IPOPUACTS";"S";"0032";"*"
"IPOPUACTS";"S";"0033";"* Déclaration des donnees locales"
"IPOPUACTS";"S";"0034";"*"
"IPOPUACTS";"S";"0035";"* A la date du jour"
"IPOPUACTS";"S";"0036";"SI HJOU_DATE = TEMP_DATJOU"
"IPOPUACTS";"S";"0037";"    * Si employé géré en activité"
"IPOPUACTS";"S";"0038";"    SI SECH_ISIACTI <> "" """
"IPOPUACTS";"S";"0039";"        SI SECH_ISIACTI <> ""0"""
"IPOPUACTS";"S";"0040";"            EMPL_CLE_POP = HJOU_SECTORI"
"IPOPUACTS";"S";"0041";"            * ----------------------------------------------------------------------------------"
"IPOPUACTS";"S";"0042";"            * Pour le traitement des populations gérées en activité,"
"IPOPUACTS";"S";"0043";"            * le compteur TYP_GEST est alimenté en fonction"
"IPOPUACTS";"S";"0044";"            * de la valeur de l'indicateur IEIACTI"
"IPOPUACTS";"S";"0045";"            *"
"IPOPUACTS";"S";"0046";"            * Choix valeur TYP_GEST :"
"IPOPUACTS";"S";"0047";"            * - H : Horodaté (avec une heure de début et de fin)"
"IPOPUACTS";"S";"0048";"            * - M : Mixte (avec une heure de début, de fin et une durée"
"IPOPUACTS";"S";"0049";"            * - C : Chantier"
"IPOPUACTS";"S";"0050";"            * - D : Déclaratif (avec une durée)"
"IPOPUACTS";"S";"0051";"            * ----------------------------------------------------------------------------------"
"IPOPUACTS";"S";"0052";"            * Horodaté"
"IPOPUACTS";"S";"0053";"            SI SECH_ISIACTI = ""1"""
"IPOPUACTS";"S";"0054";"                EMPL_TYP_GEST = ""H"""
"IPOPUACTS";"S";"0055";"            SINON"
"IPOPUACTS";"S";"0056";"                * Déclaratif"
"IPOPUACTS";"S";"0057";"                SI SECH_ISIACTI = ""2"""
"IPOPUACTS";"S";"0058";"                    EMPL_TYP_GEST = ""D"""
"IPOPUACTS";"S";"0059";"                SINON"
"IPOPUACTS";"S";"0060";"                    * Mixte"
"IPOPUACTS";"S";"0061";"                    SI SECH_ISIACTI = ""3"""
"IPOPUACTS";"S";"0062";"                        EMPL_TYP_GEST = ""M"""
"IPOPUACTS";"S";"0063";"                    SINON"
"IPOPUACTS";"S";"0064";"                        * Chantier"
"IPOPUACTS";"S";"0065";"                        SI SECH_ISIACTI = ""4"""
"IPOPUACTS";"S";"0066";"                            EMPL_TYP_GEST = ""C"""
"IPOPUACTS";"S";"0067";"                        FINSI"
"IPOPUACTS";"S";"0068";"                    FINSI"
"IPOPUACTS";"S";"0069";"                FINSI"
"IPOPUACTS";"S";"0070";"            FINSI"
"IPOPUACTS";"S";"0071";"            * ----------------------------------------------------------------------------------"
"IPOPUACTS";"S";"0072";"            * Le compteur MODE_TRV est à choisir selon le besoin (par défaut en jour)"
"IPOPUACTS";"S";"0073";"            *"
"IPOPUACTS";"S";"0074";"            * Choix valeur MODE_TRV :"
"IPOPUACTS";"S";"0075";"            * - J : Jour"
"IPOPUACTS";"S";"0076";"            * - S : Semaine"
"IPOPUACTS";"S";"0077";"            * - M : Mois"
"IPOPUACTS";"S";"0078";"            * ----------------------------------------------------------------------------------"
"IPOPUACTS";"S";"0079";"            * En jour par défaut"
"IPOPUACTS";"S";"0080";"            EMPL_MODE_TRV = ""J"""
"IPOPUACTS";"S";"0081";"        FINSI"
"IPOPUACTS";"S";"0082";"    FINSI"
"IPOPUACTS";"S";"0083";"FINSI"
"IPOPUACTS";"S";"0084";"*"
"IPOPUACTS";"S";"0085";"FIN"
"IPRESM";"S";"0001";"************************************************************************"
"IPRESM";"S";"0002";"*"
"IPRESM";"S";"0003";"* Règle : IPRESM"
"IPRESM";"S";"0004";"* Ordre : 2110"
"IPRESM";"S";"0005";"* Titre : Presence matin et apres-midi"
"IPRESM";"S";"0006";"*"
"IPRESM";"S";"0007";"*----------------------------------------------------------------------"
"IPRESM";"S";"0008";"*"
"IPRESM";"S";"0009";"* Créé par : Cellule Industrialisation"
"IPRESM";"S";"0010";"* Date     : 03/09/2009"
"IPRESM";"S";"0011";"* Version  : 1"
"IPRESM";"S";"0012";"*"
"IPRESM";"S";"0013";"*----------------------------------------------------------------------"
"IPRESM";"S";"0014";"*"
"IPRESM";"S";"0015";"*"
"IPRESM";"S";"0016";"* Rôle : Presence matin et apres-midi"
"IPRESM";"S";"0017";"*"
"IPRESM";"S";"0018";"*"
"IPRESM";"S";"0019";"*"
"IPRESM";"S";"0020";"*"
"IPRESM";"S";"0021";"*----------------------------------------------------------------------"
"IPRESM";"S";"0022";"*"
"IPRESM";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"IPRESM";"S";"0024";"* Date         : JJ/MM/AAAA"
"IPRESM";"S";"0025";"* Objet        :"
"IPRESM";"S";"0026";"*"
"IPRESM";"S";"0027";"***********************************************************************"
"IPRESM";"S";"0028";"*"
"IPRESM";"S";"0029";"*"
"IPRESM";"S";"0030";"* Implémentation des données industrielles"
"IPRESM";"S";"0031";"*"
"IPRESM";"S";"0032";"DEBDICO"
"IPRESM";"S";"0033";"   HJOU_IJQPRESBA1;N;T6,2;I;;;    56789;;;V2;""Présence badgée matin"";"
"IPRESM";"S";"0034";"   HJOU_IJQPRESBA2;N;T6,2;I;;;    56789;;;V2;""Présence badgée après-midi"";"
"IPRESM";"S";"0035";"FINDICO"
"IPRESM";"S";"0036";"*"
"IPRESM";"S";"0037";"* Déclaration des donnees locales"
"IPRESM";"S";"0038";"*"
"IPRESM";"S";"0039";"SI HJOU_DATE <= TEMP_DATJOU"
"IPRESM";"S";"0040";"   SI HJOU_IJIGBADGEA = ""1"""
"IPRESM";"S";"0041";"* Temps de presence matin"
"IPRESM";"S";"0042";"      SI PROF_PTTHEO1 > 0"
"IPRESM";"S";"0043";"         SI PROF_PTTHEO1 < 100"
"IPRESM";"S";"0044";"            ANALYSE PROF_PTTHEO1 PROF_PTTHEO2"
"IPRESM";"S";"0045";"            SI TEMP_HIPRE > 0"
"IPRESM";"S";"0046";"               HJOU_IJQPRESBA1 = 1"
"IPRESM";"S";"0047";"            FINSI"
"IPRESM";"S";"0048";"         SINON"
"IPRESM";"S";"0049";"            HJOU_IJQPRESBA1 = 2"
"IPRESM";"S";"0050";"         FINSI"
"IPRESM";"S";"0051";"      FINSI"
"IPRESM";"S";"0052";"* Temps de presence apres-midi"
"IPRESM";"S";"0053";"      SI PROF_PTTHEO3 > 0"
"IPRESM";"S";"0054";"         SI PROF_PTTHEO3 < 100"
"IPRESM";"S";"0055";"            ANALYSE PROF_PTTHEO3 PROF_PTTHEO4"
"IPRESM";"S";"0056";"            SI TEMP_HIPRE > 0"
"IPRESM";"S";"0057";"               HJOU_IJQPRESBA2 = 1"
"IPRESM";"S";"0058";"            FINSI"
"IPRESM";"S";"0059";"         SINON"
"IPRESM";"S";"0060";"            HJOU_IJQPRESBA2 = 2"
"IPRESM";"S";"0061";"         FINSI"
"IPRESM";"S";"0062";"      FINSI"
"IPRESM";"S";"0063";"   FINSI"
"IPRESM";"S";"0064";"FINSI"
"IPRESM";"S";"0065";"FIN"
"IPRESTHEO";"S";"0001";"***********************************************************************"
"IPRESTHEO";"S";"0002";"*"
"IPRESTHEO";"S";"0003";"* Règle : IPRESTHEO"
"IPRESTHEO";"S";"0004";"* Ordre : 3100"
"IPRESTHEO";"S";"0005";"* Titre : Présence théorique"
"IPRESTHEO";"S";"0006";"*"
"IPRESTHEO";"S";"0007";"*----------------------------------------------------------------------"
"IPRESTHEO";"S";"0008";"*"
"IPRESTHEO";"S";"0009";"* Créé par : Méthodes et outils"
"IPRESTHEO";"S";"0010";"* Date     : 10/08/2018"
"IPRESTHEO";"S";"0011";"* Version  : 1"
"IPRESTHEO";"S";"0012";"*"
"IPRESTHEO";"S";"0013";"*----------------------------------------------------------------------"
"IPRESTHEO";"S";"0014";"*"
"IPRESTHEO";"S";"0015";"*"
"IPRESTHEO";"S";"0016";"* Rôle : Calcul de la présence théorique"
"IPRESTHEO";"S";"0017";"*"
"IPRESTHEO";"S";"0018";"*"
"IPRESTHEO";"S";"0019";"***********************************************************************"
"IPRESTHEO";"S";"0020";"*"
"IPRESTHEO";"S";"0021";"* Implémentation des données industrielles"
"IPRESTHEO";"S";"0022";"*"
"IPRESTHEO";"S";"0023";"DEBDICO"
"IPRESTHEO";"S";"0024";"   HJOU_IJRNBMOTIH;N;N3;I;;;    56789;;IJRNBMOTIH;V3;""Nombre de motifs hebdomadaire"";"
"IPRESTHEO";"S";"0025";"FINDICO"
"IPRESTHEO";"S";"0026";"*"
"IPRESTHEO";"S";"0027";"* Déclaration des donnees locales"
"IPRESTHEO";"S";"0028";"*"
"IPRESTHEO";"S";"0029";"* alimentation de la théorie journalière par le profil sauf pour les plannings d'optimum"
"IPRESTHEO";"S";"0030";"SI CTRA_TYPEPLAN <> ""1"""
"IPRESTHEO";"S";"0031";"   SI CTRA_TYPEPLAN <> ""6"""
"IPRESTHEO";"S";"0032";"      HJOU_IJQPRETHEJ = PROF_PRETHEO"
"IPRESTHEO";"S";"0033";"   FINSI"
"IPRESTHEO";"S";"0034";"FINSI"
"IPRESTHEO";"S";"0035";"* consignes init"
"IPRESTHEO";"S";"0036";"POUR ACTIVITES"
"IPRESTHEO";"S";"0037";"   SI HABS_MOTYPE = ""C"""
"IPRESTHEO";"S";"0038";"      SI HABS_MOTIF = ""ZPLMAT"""
"IPRESTHEO";"S";"0039";"         HJOU_IJQPLGMAT = HABS_MOTIDUR"
"IPRESTHEO";"S";"0040";"         HJOU_IJQPLGTOTJ = HJOU_IJQPLGMAT + HJOU_IJQPLGAPM"
"IPRESTHEO";"S";"0041";"         HJOU_IJQPRETHEJ = HJOU_IJQPLGTOTJ"
"IPRESTHEO";"S";"0042";"      FINSI"
"IPRESTHEO";"S";"0043";"      SI HABS_MOTIF = ""ZPLAPM"""
"IPRESTHEO";"S";"0044";"         HJOU_IJQPLGAPM = HABS_MOTIDUR"
"IPRESTHEO";"S";"0045";"         HJOU_IJQPLGTOTJ = HJOU_IJQPLGMAT + HJOU_IJQPLGAPM"
"IPRESTHEO";"S";"0046";"         HJOU_IJQPRETHEJ = HJOU_IJQPLGTOTJ"
"IPRESTHEO";"S";"0047";"      FINSI"
"IPRESTHEO";"S";"0048";"      SI HABS_MOTIF = ""ZTHJ"""
"IPRESTHEO";"S";"0049";"         HJOU_IJQPRETHEJ = HABS_MOTIDUR"
"IPRESTHEO";"S";"0050";"      FINSI"
"IPRESTHEO";"S";"0051";"   FINSI"
"IPRESTHEO";"S";"0052";"FINPOUR"
"IPRESTHEO";"S";"0053";"*"
"IPRESTHEO";"S";"0054";"* planning optimum non validé (absences/présences non planifiables)"
"IPRESTHEO";"S";"0055";"*"
"IPRESTHEO";"S";"0056";"SI CTRA_TYPEPLAN = ""1"""
"IPRESTHEO";"S";"0057";"OU CTRA_TYPEPLAN = ""6"""
"IPRESTHEO";"S";"0058";"   SI HJOU_HJVALPLN = 0"
"IPRESTHEO";"S";"0059";"   OU HJOU_HJVALPLN = 2"
"IPRESTHEO";"S";"0060";"      HJOU_IJQPRETHEJ = HJOU_IJQPLGTOTJ"
"IPRESTHEO";"S";"0061";"   FINSI"
"IPRESTHEO";"S";"0062";"FINSI"
"IPRESTHEO";"S";"0063";"*"
"IPRESTHEO";"S";"0064";"*"
"IPRESTHEO";"S";"0065";"* Gestion sur plages dynamiques"
"IPRESTHEO";"S";"0066";"*"
"IPRESTHEO";"S";"0067";"SI PROF_PLAGEDYN = 1"
"IPRESTHEO";"S";"0068";"* non optimum"
"IPRESTHEO";"S";"0069";"   SI CTRA_TYPEPLAN <> ""1"""
"IPRESTHEO";"S";"0070";"      SI CTRA_TYPEPLAN <> ""6"""
"IPRESTHEO";"S";"0071";"* non ressources"
"IPRESTHEO";"S";"0072";"         SI EMPL_IEIEMPRESS <> ""1"""
"IPRESTHEO";"S";"0073";"            HJOU_IJQPRETHEJ = HJOU_IJQPLGTOTJ"
"IPRESTHEO";"S";"0074";"         FINSI"
"IPRESTHEO";"S";"0075";"      FINSI"
"IPRESTHEO";"S";"0076";"   FINSI"
"IPRESTHEO";"S";"0077";"FINSI"
"IPRESTHEO";"S";"0078";"*"
"IPRESTHEO";"S";"0079";"FIN"
"IPRIME";"S";"0001";"***********************************************************************"
"IPRIME";"S";"0002";"*"
"IPRIME";"S";"0003";"* Règle : IPRIME"
"IPRIME";"S";"0004";"* Ordre : 6010"
"IPRIME";"S";"0005";"* Titre : Calcul des primes"
"IPRIME";"S";"0006";"*"
"IPRIME";"S";"0007";"*----------------------------------------------------------------------"
"IPRIME";"S";"0008";"*"
"IPRIME";"S";"0009";"* Créé par : Cellule Industrialisation"
"IPRIME";"S";"0010";"* Date     : 03/09/2009"
"IPRIME";"S";"0011";"* Version  : 1"
"IPRIME";"S";"0012";"*"
"IPRIME";"S";"0013";"*----------------------------------------------------------------------"
"IPRIME";"S";"0014";"*"
"IPRIME";"S";"0015";"*"
"IPRIME";"S";"0016";"* Rôle : Calcul des primes"
"IPRIME";"S";"0017";"*"
"IPRIME";"S";"0018";"*"
"IPRIME";"S";"0019";"*"
"IPRIME";"S";"0020";"*"
"IPRIME";"S";"0021";"*"
"IPRIME";"S";"0022";"*----------------------------------------------------------------------"
"IPRIME";"S";"0023";"*"
"IPRIME";"S";"0024";"* Modifiée par : Méthodes et Outils"
"IPRIME";"S";"0025";"* Date         : 04/04/2023"
"IPRIME";"S";"0026";"* Objet        : Ajout d'une prime basée sur HOR avec déclenchement quotidien"
"IPRIME";"S";"0027";"*"
"IPRIME";"S";"0028";"***********************************************************************"
"IPRIME";"S";"0029";"*"
"IPRIME";"S";"0030";"* Implémentation des données industrielles"
"IPRIME";"S";"0031";"*"
"IPRIME";"S";"0032";"DEBDICO"
"IPRIME";"S";"0033";"   HJOU_IJQNPREQUJ;N;N2;I;;;    56789;;;V3;""Prime jour"";"
"IPRIME";"S";"0034";"   HJOU_IJQNPANIJR;N;N2;I;;;    56789;;;V3;""Panier jour"";"
"IPRIME";"S";"0035";"   HJOU_IJQNPREQUN;N;N2;I;;;    56789;;;V3;""Prime nuit"";"
"IPRIME";"S";"0036";"   HJOU_IJQNPANINU;N;N2;I;;;    56789;;;V3;""Panier nuit"";"
"IPRIME";"S";"0037";"   HJOU_IJQNPRIDIV;N;N2;I;;;    56789;;;V3;""Prime divers"";"
"IPRIME";"S";"0038";"   HJOU_IJQNPRISPE;N;N2;I;;;    56789;;;V3;""Prime spécifique"";"
"IPRIME";"S";"0039";"   ****** prime dans HOR"
"IPRIME";"S";"0040";"   HORC_IHINPRIST;O;Z1;X;0;1;      789;C;;C2;""Prime de poste"";"
"IPRIME";"S";"0041";"   HORC_IHISPRIST;O;T6,2;I;;;123456789;;;C2;""Seuil déclenchement prime de poste"";"
"IPRIME";"S";"0042";"   HJOU_IJQPRIHOST;N;N2;I;;;    56789;;;V3;""Prime de poste"";"
"IPRIME";"S";"0043";"   MOTI_IMIGPRIMH;O;Z1;X;0;1;123456789;C;;C2;""Participe à la prime de poste"";"
"IPRIME";"S";"0044";"   ******"
"IPRIME";"S";"0045";"FINDICO"
"IPRIME";"S";"0046";"*"
"IPRIME";"S";"0047";"* Déclaration des donnees locales"
"IPRIME";"S";"0048";"*"
"IPRIME";"S";"0049";"DEF LOCA_PRIMJ T6.2"
"IPRIME";"S";"0050";"LOCA_PRIMJ = 0"
"IPRIME";"S";"0051";"DEF LOCA_PRIMN T6.2"
"IPRIME";"S";"0052";"LOCA_PRIMN = 0"
"IPRIME";"S";"0053";"DEF LOCA_PRIMPJ T6.2"
"IPRIME";"S";"0054";"LOCA_PRIMPJ = 0"
"IPRIME";"S";"0055";"DEF LOCA_PRIMPN T6.2"
"IPRIME";"S";"0056";"LOCA_PRIMPN = 0"
"IPRIME";"S";"0057";"DEF LOCA_PRIMD T6.2"
"IPRIME";"S";"0058";"LOCA_PRIMD = 0"
"IPRIME";"S";"0059";"DEF LOCA_PRIMS T6.2"
"IPRIME";"S";"0060";"LOCA_PRIMS = 0"
"IPRIME";"S";"0061";"DEF LOCA_PRIMH T6.2"
"IPRIME";"S";"0062";"LOCA_PRIMH = 0"
"IPRIME";"S";"0063";"LOCA_PRIMJ = HJOU_IJQPRESBAV"
"IPRIME";"S";"0064";"LOCA_PRIMPJ = HJOU_IJQPRESBAV"
"IPRIME";"S";"0065";"LOCA_PRIMN = HJOU_IJQHNUITTO"
"IPRIME";"S";"0066";"LOCA_PRIMPN = HJOU_IJQHNUITTO"
"IPRIME";"S";"0067";"LOCA_PRIMD = HJOU_IJQPRESBAV"
"IPRIME";"S";"0068";"LOCA_PRIMS = HJOU_IJQPRESBAV"
"IPRIME";"S";"0069";"* la base de calcul de la prime de poste est le temps"
"IPRIME";"S";"0070";"* badgé validé"
"IPRIME";"S";"0071";"LOCA_PRIMH = HJOU_IJQPRESBAV"
"IPRIME";"S";"0072";"*"
"IPRIME";"S";"0073";"POUR ACTIVITES"
"IPRIME";"S";"0074";"   SI MOTI_MOTYPE <> ""C"""
"IPRIME";"S";"0075";"      SI MOTI_IMIGPRIEQJ = ""1"""
"IPRIME";"S";"0076";"         LOCA_PRIMJ = LOCA_PRIMJ + HABS_MOTIDUR"
"IPRIME";"S";"0077";"      FINSI"
"IPRIME";"S";"0078";"*"
"IPRIME";"S";"0079";"      SI MOTI_IMIGPRIEQN = ""1"""
"IPRIME";"S";"0080";"         SI MOTI_IMIGHNUITT <> ""1"""
"IPRIME";"S";"0081";"* on rajoute le temps du motif uniquement, s'il n'etait"
"IPRIME";"S";"0082";"* pas déja comptabilisé dans les heures de nuit totales"
"IPRIME";"S";"0083";"            LOCA_PRIMN = LOCA_PRIMN + HABS_MOTIDUR"
"IPRIME";"S";"0084";"         FINSI"
"IPRIME";"S";"0085";"      SINON"
"IPRIME";"S";"0086";"** cas d'un motif qui maintient les heures de nuit"
"IPRIME";"S";"0087";"** mais qui ne declenche pas de prime"
"IPRIME";"S";"0088";"         LOCA_PRIMN = LOCA_PRIMN - TEMP_ITQNUITMOT"
"IPRIME";"S";"0089";"      FINSI"
"IPRIME";"S";"0090";"*"
"IPRIME";"S";"0091";"      SI MOTI_IMIGPANIJR = ""1"""
"IPRIME";"S";"0092";"         LOCA_PRIMPJ = LOCA_PRIMPJ + HABS_MOTIDUR"
"IPRIME";"S";"0093";"      FINSI"
"IPRIME";"S";"0094";"*"
"IPRIME";"S";"0095";"      SI MOTI_IMIGPANINU = ""1"""
"IPRIME";"S";"0096";"         SI MOTI_IMIGHNUITT <> ""1"""
"IPRIME";"S";"0097";"            LOCA_PRIMPN = LOCA_PRIMPN + HABS_MOTIDUR"
"IPRIME";"S";"0098";"         FINSI"
"IPRIME";"S";"0099";"      SINON"
"IPRIME";"S";"0100";"         LOCA_PRIMPN = LOCA_PRIMPN - TEMP_ITQNUITMOT"
"IPRIME";"S";"0101";"      FINSI"
"IPRIME";"S";"0102";"*"
"IPRIME";"S";"0103";"      SI MOTI_IMIGPRIDIV = ""1"""
"IPRIME";"S";"0104";"         LOCA_PRIMD = LOCA_PRIMD + HABS_MOTIDUR"
"IPRIME";"S";"0105";"      FINSI"
"IPRIME";"S";"0106";"*"
"IPRIME";"S";"0107";"      SI MOTI_IMIGPRISPE = ""1"""
"IPRIME";"S";"0108";"         LOCA_PRIMS = LOCA_PRIMS + HABS_MOTIDUR"
"IPRIME";"S";"0109";"      FINSI"
"IPRIME";"S";"0110";"   FINSI"
"IPRIME";"S";"0111";"****** Prime dans HOR"
"IPRIME";"S";"0112";"   SI MOTI_IMIGPRIMH = ""1"""
"IPRIME";"S";"0113";"      LOCA_PRIMH = LOCA_PRIMH + HABS_MOTIDUR"
"IPRIME";"S";"0114";"   FINSI"
"IPRIME";"S";"0115";"******"
"IPRIME";"S";"0116";"FINPOUR"
"IPRIME";"S";"0117";"SI LOCA_PRIMJ >= PROF_IPISPRIEQJ"
"IPRIME";"S";"0118";"   SI PROF_IPINPRIEQJ = ""1"""
"IPRIME";"S";"0119";"      HJOU_IJQNPREQUJ = 1"
"IPRIME";"S";"0120";"   FINSI"
"IPRIME";"S";"0121";"FINSI"
"IPRIME";"S";"0122";"SI LOCA_PRIMPJ >= PROF_IPISPANIJR"
"IPRIME";"S";"0123";"   SI PROF_IPIGPANIJR = ""1"""
"IPRIME";"S";"0124";"      HJOU_IJQNPANIJR = 1"
"IPRIME";"S";"0125";"   FINSI"
"IPRIME";"S";"0126";"FINSI"
"IPRIME";"S";"0127";"SI LOCA_PRIMN >= PROF_IPISPRIEQN"
"IPRIME";"S";"0128";"   SI PROF_IPINPRIEQN = ""1"""
"IPRIME";"S";"0129";"      HJOU_IJQNPREQUN = 1"
"IPRIME";"S";"0130";"   FINSI"
"IPRIME";"S";"0131";"FINSI"
"IPRIME";"S";"0132";"SI LOCA_PRIMPN >= PROF_IPISPANINU"
"IPRIME";"S";"0133";"   SI PROF_IPIGPANINU = ""1"""
"IPRIME";"S";"0134";"      HJOU_IJQNPANINU = 1"
"IPRIME";"S";"0135";"   FINSI"
"IPRIME";"S";"0136";"FINSI"
"IPRIME";"S";"0137";"SI LOCA_PRIMD >= PROF_IPISPRIDIV"
"IPRIME";"S";"0138";"   SI PROF_IPIGPRIDIV = ""1"""
"IPRIME";"S";"0139";"      HJOU_IJQNPRIDIV = 1"
"IPRIME";"S";"0140";"   FINSI"
"IPRIME";"S";"0141";"FINSI"
"IPRIME";"S";"0142";"SI LOCA_PRIMS >= PROF_IPISPRISPE"
"IPRIME";"S";"0143";"   SI PROF_IPINPRISPE = ""1"""
"IPRIME";"S";"0144";"      HJOU_IJQNPRISPE = 1"
"IPRIME";"S";"0145";"   FINSI"
"IPRIME";"S";"0146";"FINSI"
"IPRIME";"S";"0147";"*********prime dans HOR"
"IPRIME";"S";"0148";"SI LOCA_PRIMH >= HORC_IHISPRIST"
"IPRIME";"S";"0149";"   SI HORC_IHINPRIST = ""1"""
"IPRIME";"S";"0150";"      HJOU_IJQPRIHOST = 1"
"IPRIME";"S";"0151";"   FINSI"
"IPRIME";"S";"0152";"FINSI"
"IPRIME";"S";"0153";"**********"
"IPRIME";"S";"0154";"POUR ACTIVITES"
"IPRIME";"S";"0155";"   SI HABS_MOTIF = ""ZPRJ"""
"IPRIME";"S";"0156";"      HJOU_IJQNPREQUJ = HABS_MOTINBR"
"IPRIME";"S";"0157";"   FINSI"
"IPRIME";"S";"0158";"   SI HABS_MOTIF = ""ZPRN"""
"IPRIME";"S";"0159";"      HJOU_IJQNPREQUN = HABS_MOTINBR"
"IPRIME";"S";"0160";"   FINSI"
"IPRIME";"S";"0161";"   SI HABS_MOTIF = ""ZPAJ"""
"IPRIME";"S";"0162";"      HJOU_IJQNPANIJR = HABS_MOTINBR"
"IPRIME";"S";"0163";"   FINSI"
"IPRIME";"S";"0164";"   SI HABS_MOTIF = ""ZPAN"""
"IPRIME";"S";"0165";"      HJOU_IJQNPANINU = HABS_MOTINBR"
"IPRIME";"S";"0166";"   FINSI"
"IPRIME";"S";"0167";"   SI HABS_MOTIF = ""ZPRD"""
"IPRIME";"S";"0168";"      HJOU_IJQNPRIDIV = HABS_MOTINBR"
"IPRIME";"S";"0169";"   FINSI"
"IPRIME";"S";"0170";"   SI HABS_MOTIF = ""ZPRS"""
"IPRIME";"S";"0171";"      HJOU_IJQNPRISPE = HABS_MOTINBR"
"IPRIME";"S";"0172";"   FINSI"
"IPRIME";"S";"0173";"****prime dans HOR"
"IPRIME";"S";"0174";"      SI HABS_MOTIF = ""ZPRH"""
"IPRIME";"S";"0175";"         HJOU_IJQPRIHOST = HABS_MOTINBR"
"IPRIME";"S";"0176";"      FINSI"
"IPRIME";"S";"0177";"********"
"IPRIME";"S";"0178";"FINPOUR"
"IPRIME";"S";"0179";"FIN"
