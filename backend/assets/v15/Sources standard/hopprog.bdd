"ITPSACTHT4";"S";"0060";"            PRES_VALID = ""N"""
"ITPSACTHT4";"S";"0061";"            *"
"ITPSACTHT4";"S";"0062";"            PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTHT4";"S";"0063";"            PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTHT4";"S";"0064";"            *"
"ITPSACTHT4";"S";"0065";"            SI PRES_MODE_TRV = "" """
"ITPSACTHT4";"S";"0066";"               PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT4";"S";"0067";"            FINSI"
"ITPSACTHT4";"S";"0068";"            *"
"ITPSACTHT4";"S";"0069";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT4";"S";"0070";"            *"
"ITPSACTHT4";"S";"0071";"            * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT4";"S";"0072";"            *                              (A décommenter si besoin)"
"ITPSACTHT4";"S";"0073";"            *"
"ITPSACTHT4";"S";"0074";"            * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT4";"S";"0075";"            * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT4";"S";"0076";"            * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT4";"S";"0077";"            * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT4";"S";"0078";"            *"
"ITPSACTHT4";"S";"0079";"            * SI HJOU_IJQBHORVAJ <> 0"
"ITPSACTHT4";"S";"0080";"                PRES_TPS_PRES = HJOU_IJQBHORVAJ"
"ITPSACTHT4";"S";"0081";"            * SINON"
"ITPSACTHT4";"S";"0082";"                * PRES_TPS_PRES = 0.01"
"ITPSACTHT4";"S";"0083";"            * FINSI"
"ITPSACTHT4";"S";"0084";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT4";"S";"0085";"            *"
"ITPSACTHT4";"S";"0086";"            *"
"ITPSACTHT4";"S";"0087";"            *"
"ITPSACTPT2";"S";"0041";"* DEBANO"
"ITPSACTHT4";"S";"0088";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT4";"S";"0089";"            *"
"ITPSACTHT4";"S";"0090";"            * !!!                Pour gestion des temps de présence par consigne                !!!"
"ITPSACTHT4";"S";"0091";"            *                              (A décommenter si besoin)"
"ITPSACTHT4";"S";"0092";"            *"
"ITPSACTHT4";"S";"0093";"            * Si besoin de gérer les temps de présence par consigne, décommenter le"
"ITPSACTHT4";"S";"0094";"            * POUR ACTIVITES ci-dessous ainsi le test LOCA_DURABS <> 0"
"ITPSACTHT4";"S";"0095";"            *"
"ITPSACTHT4";"S";"0096";"            * récupération des temps de présence declaré par consigne"
"ITPSACTHT4";"S";"0097";"            * POUR ACTIVITES"
"ITPSACTHT4";"S";"0098";"                * SI HABS_MOTYPE = ""C"""
"ITPSACTHT4";"S";"0099";"                    * Motif participant au temps d'activité à justifier"
"ITPSACTHT4";"S";"0100";"                    * SI MOTI_MOTIF = ""XPRES"""
"ITPSACTHT4";"S";"0101";"                        * LOCA_DURABS = LOCA_DURABS + HABS_MOTIDUR"
"ITPSACTHT4";"S";"0102";"                    * FINSI"
"ITPSACTHT4";"S";"0103";"                * FINSI"
"ITPSACTHT4";"S";"0104";"            * FINPOUR"
"ITPSACTHT4";"S";"0105";"            *"
"ITPSACTHT4";"S";"0106";"            * SI LOCA_DURABS <> 0"
"ITPSACTHT4";"S";"0107";"                * PRES_TPS_PRES = LOCA_DURABS"
"ITPSACTHT4";"S";"0108";"            * FINSI"
"ITPSACTHT4";"S";"0109";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT4";"S";"0110";"            *"
"ITPSACTHT4";"S";"0111";"            *"
"ITPSACTHT4";"S";"0112";"            PRES_TPS_IMPUTE = 0"
"ITPSACTHT4";"S";"0113";"            SI HJOU_IJIACTI = ""1"""
"ITPSACTHT4";"S";"0114";"            OU HJOU_IJIACTI = ""2"""
"ITPSACTHT4";"S";"0115";"            OU HJOU_IJIACTI = ""3"""
"ITPSACTHT4";"S";"0116";"                POUR EVENEMENTS"
"ITPSACTHT4";"S";"0117";"                    PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT4";"S";"0118";"                FINPOUR"
"ITPSACTHT4";"S";"0119";"            FINSI"
"ITPSACTHT4";"S";"0120";"            * Calcul de l'écart"
"ITPSACTHT4";"S";"0121";"            PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT4";"S";"0122";"        FINSI"
"ITPSACTHT4";"S";"0123";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT4";"S";"0124";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT4";"S";"0125";"            HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT4";"S";"0126";"        FINSI"
"ITPSACTHT4";"S";"0127";"    FINSI"
"ITPSACTHT4";"S";"0128";"FINSI"
"ITPSACTHT4";"S";"0129";"*"
"ITPSACTHT4";"S";"0130";"FIN"
"ITPSACTHT5";"S";"0001";"**********************************************************************"
"ITPSACTHT5";"S";"0002";"*"
"ITPSACTHT5";"S";"0003";"* Règle : ITPSACTHT5"
"ITPSACTHT5";"S";"0004";"* Ordre : 3470"
"ITPSACTHT5";"S";"0005";"* Titre : #HQ ACTIVITY# Tps de présence Activité avec heures totales,"
"ITPSACTHT5";"S";"0006";"*          population = section et mode semaine (indicateur dans EMP)"
"ITPSACTHT5";"S";"0007";"*"
"ITPSACTHT5";"S";"0008";"*---------------------------------------------------------------------"
"ITPSACTHT5";"S";"0009";"*"
"ITPSACTHT5";"S";"0010";"* Créé par : Méthodes et outils"
"ITPSACTHT5";"S";"0011";"* Date     : 17/08/2020"
"ITPSACTHT5";"S";"0012";"* Version  : 1"
"ITPSACTHT5";"S";"0013";"*"
"ITPSACTHT5";"S";"0014";"*---------------------------------------------------------------------"
"ITPSACTHT5";"S";"0015";"*"
"ITPSACTHT5";"S";"0016";"*"
"ITPSACTHT5";"S";"0017";"* Rôle :"
"ITPSACTHT5";"S";"0018";"*"
"ITPSACTHT5";"S";"0019";"* Calcul du temps de présence activité avec les heures totales"
"ITPSACTHT5";"S";"0020";"* pour population = section et mode semaine"
"ITPSACTHT5";"S";"0021";"* (gestion activité avec indicateur dans EMP)"
"ITPSACTHT5";"S";"0022";"*"
"ITPSACTHT5";"S";"0023";"*"
"ITPSACTHT5";"S";"0024";"*----------------------------------------------------------------------"
"ITPSACTHT5";"S";"0025";"*"
"ITPSACTHT5";"S";"0026";"* Modifiée par :"
"ITPSACTHT5";"S";"0027";"* Date         : JJ/MM/AAAA"
"ITPSACTHT5";"S";"0028";"* Objet        :"
"ITPSACTHT5";"S";"0029";"*"
"ITPSACTHT5";"S";"0030";"***********************************************************************"
"ITPSACTHT5";"S";"0031";"*"
"ITPSACTHT5";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTHT5";"S";"0033";"*"
"ITPSACTHT5";"S";"0034";"DEBDICO"
"ITPSACTHT5";"S";"0035";"EMPL_IEIACTI;O;A1;X;;;123456789;L;;C3;""Employé géré en activité"";"
"ITPSACTHT5";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTHT5";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTHT5";"S";"0038";"FINDICO"
"ITPSACTHT5";"S";"0039";"*"
"ITPSACTHT5";"S";"0040";"*"
"ITPSACTHT5";"S";"0041";"* DEBANO"
"ITPSACTHT5";"S";"0042";"*"
"ITPSACTHT5";"S";"0043";"* FINANO"
"ITPSACTHT5";"S";"0044";"*"
"ITPSACTHT5";"S";"0045";"* Définition des variables locales"
"ITPSACTHT5";"S";"0046";"*"
"ITPSACTHT5";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTHT5";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTHT5";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHT5";"S";"0050";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTHT5";"S";"0051";"    FINSI"
"ITPSACTHT5";"S";"0052";"FINSI"
"ITPSACTHT5";"S";"0053";"*"
"ITPSACTHT5";"S";"0054";"* Employé géré en activité"
"ITPSACTHT5";"S";"0055";"SI HJOU_IJIACTI <> "" """
"ITPSACTHT5";"S";"0056";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHT5";"S";"0057";"        * Calcul de la présence activité le dimanche"
"ITPSACTHT5";"S";"0058";"        * Ou dernier jour du contrat"
"ITPSACTHT5";"S";"0059";"        SI HJOU_JOUR = ""7"""
"ITPSACTHT5";"S";"0060";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTHT5";"S";"0061";"            SI PRES_VALID <> ""O"""
"ITPSACTHT5";"S";"0062";"                PRES_VALID = ""N"""
"ITPSACTHT5";"S";"0063";"                *"
"ITPSACTHT5";"S";"0064";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTHT5";"S";"0065";"                SI HJOU_SECTAFF <> "" """
"ITPSACTHT5";"S";"0066";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTHT5";"S";"0067";"                SINON"
"ITPSACTHT5";"S";"0068";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTHT5";"S";"0069";"                FINSI"
"ITPSACTHT5";"S";"0070";"                *"
"ITPSACTHT5";"S";"0071";"                SI PRES_MODE_TRV = "" """
"ITPSACTHT5";"S";"0072";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT5";"S";"0073";"                FINSI"
"ITPSACTHT5";"S";"0074";"                *"
"ITPSACTHT5";"S";"0075";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT5";"S";"0076";"                *"
"ITPSACTHT5";"S";"0077";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT5";"S";"0078";"                *                              (A décommenter si besoin)"
"ITPSACTHT5";"S";"0079";"                *"
"ITPSACTHT5";"S";"0080";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT5";"S";"0081";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT5";"S";"0082";"                * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT5";"S";"0083";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT5";"S";"0084";"                *"
"ITPSACTHT5";"S";"0085";"                * SI HJOU_IJRBHORVAH <> 0"
"ITPSACTHT5";"S";"0086";"                    PRES_TPS_PRES = HJOU_IJRBHORVAH"
"ITPSACTHT5";"S";"0087";"                * SINON"
"ITPSACTHT5";"S";"0088";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTHT5";"S";"0089";"                * FINSI"
"ITPSACTHT5";"S";"0090";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT5";"S";"0091";"                *"
"ITPSACTHT5";"S";"0092";"                PRES_TPS_IMPUTE = 0"
"ITPSACTHT5";"S";"0093";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTHT5";"S";"0094";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTHT5";"S";"0095";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHT5";"S";"0096";"                    POUR EVENEMENTS"
"ITPSACTHT5";"S";"0097";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT5";"S";"0098";"                    FINPOUR"
"ITPSACTHT5";"S";"0099";"                FINSI"
"ITPSACTHT5";"S";"0100";"                *"
"ITPSACTHT5";"S";"0101";"                * Calcul de l'écart"
"ITPSACTHT5";"S";"0102";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT5";"S";"0103";"            FINSI"
"ITPSACTHT5";"S";"0104";"        FINSI"
"ITPSACTHT5";"S";"0105";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT5";"S";"0106";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT5";"S";"0107";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT5";"S";"0108";"        FINSI"
"ITPSACTHT5";"S";"0109";"    FINSI"
"ITPSACTHT5";"S";"0110";"FINSI"
"ITPSACTHT5";"S";"0111";"*"
"ITPSACTHT5";"S";"0112";"FIN"
