"IABSGA";"S";"0276";"                SI LOCA_DUR10 <> 0"
"IABSGA";"S";"0277";"                    ZEVE_EVENEMENT = ""ABS"""
"IABSGA";"S";"0278";"                    ZEVE_VALEUR01 = LOCA_MOT10"
"IABSGA";"S";"0279";"                    ZEVE_VALEUR02 = LOCA_VALO10"
"IABSGA";"S";"0280";"                    ZEVE_DUREE_EVE = LOCA_DUR10"
"IABSGA";"S";"0281";"                    ZEVE_CLE_POP = PRES_CLE_POP"
"IABSGA";"S";"0282";"                    ADDEVEN"
"IABSGA";"S";"0283";"                FINSI"
"IABSGA";"S";"0284";"                *"
"IABSGA";"S";"0285";"                PRES_TPS_IMPUTE = 0"
"IABSGA";"S";"0286";"                POUR EVENEMENTS"
"IABSGA";"S";"0287";"                    PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"IABSGA";"S";"0288";"                FINPOUR"
"IABSGA";"S";"0289";"                * Calcul de l'écart"
"IABSGA";"S";"0290";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"IABSGA";"S";"0291";"            FINSI"
"IABSGA";"S";"0292";"        FINSI"
"IABSGA";"S";"0293";"    FINSI"
"IABSGA";"S";"0294";"FINSI"
"IABSGA";"S";"0295";"*"
"IABSGA";"S";"0296";"FIN"
