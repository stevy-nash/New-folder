"ICONSCPCH";"S";"0566";"                                    HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - 0.5"
"ICONSCPCH";"S";"0567";"*"
"ICONSCPCH";"S";"0568";"                                    LOCA_CP = 1"
"ICONSCPCH";"S";"0569";"                                    LOCA_VAL = 0"
"ICONSCPCH";"S";"0570";"                                    LOCA_VALCP = ""J"""
