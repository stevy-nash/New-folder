"ICONSCPCH";"S";"0523";"                              HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HJOU_IJRSCPNTRA"
"ICONSCPCH";"S";"0524";"                              HJOU_IJRSCPNTRA = 0"
"ICONSCPCH";"S";"0525";"*"
"ICONSCPCH";"S";"0526";"                              LOCA_CP = 0.5"
"ICONSCPCH";"S";"0527";"                              LOCA_VAL = 0.5"
"ICONSCPCH";"S";"0528";"                              SI LOCA_CPR > 0"
"ICONSCPCH";"S";"0529";"                              OU LOCA_CPAN > 0"
"ICONSCPCH";"S";"0530";"                                 LOCA_VALCP = ""A"""
"ICONSCPCH";"S";"0531";"                              SINON"
