"ICONSCPCH";"S";"0562";"                                    HJOU_IJRCCPTRA = HJOU_IJRCCPTRA + 0.5"
"ICONSCPCH";"S";"0563";"                                    HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - 0.5"
"ICONSCPCH";"S";"0564";"*"
