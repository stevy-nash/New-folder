"ITPSACTHT9";"S";"0031";"*"
"ITPSACTHT9";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTHT9";"S";"0033";"*"
"ITPSACTHT9";"S";"0034";"DEBDICO"
"ITPSACTHT9";"S";"0035";"SECH_ISIACTI;O;A1;X;;;123456789;L;;C3;""Section géré en activité"";"
"ITPSACTHT9";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTHT9";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTHT9";"S";"0038";"FINDICO"
"ITPSACTHT9";"S";"0039";"*"
"ITPSACTHT9";"S";"0040";"*"
"ITPSACTHT9";"S";"0041";"* DEBANO"
"ITPSACTHT9";"S";"0042";"*"
"ITPSACTHT9";"S";"0043";"* FINANO"
"ITPSACTHT9";"S";"0044";"*"
"ITPSACTHT9";"S";"0045";"* Définition des variables locales"
"ITPSACTHT9";"S";"0046";"*"
"ITPSACTHT9";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTHT9";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTHT9";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHT9";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTHT9";"S";"0051";"    FINSI"
"ITPSACTHT9";"S";"0052";"FINSI"
"ITPSACTHT9";"S";"0053";"*"
"ITPSACTHT9";"S";"0054";"* Employé géré en activité"
"ITPSACTHT9";"S";"0055";"SI HJOU_IJIACTI <> "" """
"ITPSACTHT9";"S";"0056";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHT9";"S";"0057";"        * Calcul de la présence activité le dimanche"
"ITPSACTHT9";"S";"0058";"        * Ou dernier jour du contrat"
"ITPSACTHT9";"S";"0059";"        SI HJOU_JOUR = ""7"""
"ITPSACTHT9";"S";"0060";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTHT9";"S";"0061";"            SI PRES_VALID <> ""O"""
"ITPSACTHT9";"S";"0062";"                PRES_VALID = ""N"""
"ITPSACTHT9";"S";"0063";"                *"
"ITPSACTHT9";"S";"0064";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTHT9";"S";"0065";"                SI HJOU_SECTAFF <> "" """
"ITPSACTHT9";"S";"0066";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTHT9";"S";"0067";"                SINON"
"ITPSACTHT9";"S";"0068";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTHT9";"S";"0069";"                FINSI"
"ITPSACTHT9";"S";"0070";"                *"
"ITPSACTHT9";"S";"0071";"                SI PRES_MODE_TRV = "" """
"ITPSACTHT9";"S";"0072";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT9";"S";"0073";"                FINSI"
"ITPSACTHT9";"S";"0074";"                *"
"ITPSACTHT9";"S";"0075";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT9";"S";"0076";"                *"
"ITPSACTHT9";"S";"0077";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT9";"S";"0078";"                *                              (A décommenter si besoin)"
"ITPSACTHT9";"S";"0079";"                *"
"ITPSACTHT9";"S";"0080";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT9";"S";"0081";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT9";"S";"0082";"                * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT9";"S";"0083";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT9";"S";"0084";"                *"
"ITPSACTHT9";"S";"0085";"                * SI HJOU_IJRBHORVAH <> 0"
"ITPSACTHT9";"S";"0086";"                    PRES_TPS_PRES = HJOU_IJRBHORVAH"
"ITPSACTHT9";"S";"0087";"                * SINON"
"ITPSACTHT9";"S";"0088";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTHT9";"S";"0089";"                * FINSI"
"ITPSACTHT9";"S";"0090";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT9";"S";"0091";"                *"
"ITPSACTHT9";"S";"0092";"                PRES_TPS_IMPUTE = 0"
"ITPSACTHT9";"S";"0093";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTHT9";"S";"0094";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTHT9";"S";"0095";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHT9";"S";"0096";"                    POUR EVENEMENTS"
"ITPSACTHT9";"S";"0097";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT9";"S";"0098";"                    FINPOUR"
"ITPSACTHT9";"S";"0099";"                FINSI"
"ITPSACTHT9";"S";"0100";"                *"
"ITPSACTHT9";"S";"0101";"                * Calcul de l'écart"
"ITPSACTHT9";"S";"0102";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT9";"S";"0103";"            FINSI"
"ITPSACTHT9";"S";"0104";"        FINSI"
"ITPSACTHT9";"S";"0105";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT9";"S";"0106";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT9";"S";"0107";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT9";"S";"0108";"        FINSI"
"ITPSACTHT9";"S";"0109";"    FINSI"
"ITPSACTHT9";"S";"0110";"FINSI"
