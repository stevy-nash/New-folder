"ICONGF";"S";"0001";"*"
"ICONGF";"S";"0002";"* Règle : ICONGF"
"ICONGF";"S";"0003";"* Ordre : 3660"
"ICONGF";"S";"0004";"* Titre : Congés fractionnement"
"ICONGF";"S";"0005";"*"
"ICONGF";"S";"0006";"*----------------------------------------------------------------------"
"ICONGF";"S";"0007";"*"
"ICONGF";"S";"0008";"* Créé par : Cellule Industrialisation"
"ICONGF";"S";"0009";"* Date     : 03/09/2009"
"ICONGF";"S";"0010";"* Version  : 1"
"ICONGF";"S";"0011";"*"
"ICONGF";"S";"0012";"*----------------------------------------------------------------------"
"ICONGF";"S";"0013";"*"
"ICONGF";"S";"0014";"*"
"ICONGF";"S";"0015";"* Rôle : Congés fractionnement"
"ICONGF";"S";"0016";"*"
"ICONGF";"S";"0017";"*"
"ICONGF";"S";"0018";"*----------------------------------------------------------------------"
"ICONGF";"S";"0019";"*"
"ICONGF";"S";"0020";"* Modifiée par : Cellule Industrialisation"
"ICONGF";"S";"0021";"* Date         : JJ/MM/AAAA"
"ICONGF";"S";"0022";"* Objet        :"
"ICONGF";"S";"0023";"*"
"ICONGF";"S";"0024";"***********************************************************************"
"ICONGF";"S";"0025";"* Modification pour le package V11"
"ICONGF";"S";"0026";"*"
"ICONGF";"S";"0027";"* Modifiée par : Méthodes et outils"
"ICONGF";"S";"0028";"* Date         : 09/11/2018"
"ICONGF";"S";"0029";"* Objet        : Modification du numéro de règle pour permettre la valorisation"
"ICONGF";"S";"0030";"*                de la durée des motifs congés en cas de chaînage (durée définie"
"ICONGF";"S";"0031";"*                suivant le paramétrage de l'indicateur ""Gestion de la durée du motif"""
"ICONGF";"S";"0032";"*                (IMIGDURABS) dans ACT et la durée est alimentée dans la règle"
"ICONGF";"S";"0033";"*                3058 - durée des absences)"
"ICONGF";"S";"0034";"*                (passage de l'ordre 3220 à l'ordre 3051)"
"ICONGF";"S";"0035";"*"
"ICONGF";"S";"0036";"***********************************************************************"
"ICONGF";"S";"0037";"* Calcul des dates prévisionnels solde congé global"
"ICONGF";"S";"0038";"*"
"ICONGF";"S";"0039";"DEF LOCA_NBCOFRA N3.1"
"ICONGF";"S";"0041";"DEF LOCA_FLAG N1"
"ICONGF";"S";"0042";"LOCA_FLAG = 0"
"ICONGF";"S";"0043";"DEF LOCA_CALCUL N1"
"ICONGF";"S";"0044";"LOCA_CALCUL = 0"
"ICONGF";"S";"0045";"DEF LOCA_FERI N1"
"ICONGF";"S";"0046";"LOCA_FERI = 0"
"ICONGF";"S";"0047";"* Détection des fériés"
"ICONGF";"S";"0048";"CALENDRIER ""FERI"""
"ICONGF";"S";"0049";"SI TEMP_CALEND = ""FERI"""
"ICONGF";"S";"0050";"   LOCA_FERI = 1"
"ICONGF";"S";"0051";"FINSI"
"ICONGF";"S";"0052";"*"
"ICONGF";"S";"0053";"DEF LOCA_DATE D"
"ICONGF";"S";"0054";"LOCA_DATE = "" """
"ICONGF";"S";"0055";"DEF LOCA_DATEFU D"
"ICONGF";"S";"0056";"LOCA_DATEFU = "" """
"ICONGF";"S";"0057";"DEF LOCA_DATEFU2 D"
"ICONGF";"S";"0058";"LOCA_DATEFU2 = "" """
"ICONGF";"S";"0059";"DEF LOCA_ACOURS N4"
"ICONGF";"S";"0060";"LOCA_ACOURS = 0"
"ICONGF";"S";"0061";"DEF LOCA_ACOURS2 N4"
"ICONGF";"S";"0062";"LOCA_ACOURS2 = 0"
"ICONGF";"S";"0063";"DEF LOCA_REF N2"
"ICONGF";"S";"0064";"LOCA_REF = 0"
"ICONGF";"S";"0065";"* stockage de l'année du jour de l'historique"
"ICONGF";"S";"0066";"LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"ICONGF";"S";"0067";"* stockage du mois de reference"
"ICONGF";"S";"0068";"LOCA_REF << CONF_ITIVMREFCP(3:2)"
"ICONGF";"S";"0069";"* stokage du mois de reference"
"ICONGF";"S";"0070";"LOCA_DATE(5:2) << LOCA_REF"
"ICONGF";"S";"0071";"* stockage du jour de reference"
"ICONGF";"S";"0072";"LOCA_REF << CONF_ITIVMREFCP(1:2)"
"ICONGF";"S";"0073";"* loca_date contient maintenant l'année du jour de l'historique"
"ICONGF";"S";"0074";"* et le mois et le jour de reference"
"ICONGF";"S";"0075";"LOCA_DATE(7:2) << LOCA_REF"
"ICONGF";"S";"0076";"* stockage de l'annee en cours"
"ICONGF";"S";"0077";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"ICONGF";"S";"0078";"LOCA_ACOURS2 = LOCA_ACOURS + 1"
"ICONGF";"S";"0079";"*"
"ICONGF";"S";"0080";"* calcul de la date de reference d'initialisation de cp"
"ICONGF";"S";"0081";"* et de date butoir  pour calculer le solde futur"
"ICONGF";"S";"0082";"SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"ICONGF";"S";"0083";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"ICONGF";"S";"0084";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"ICONGF";"S";"0085";"*"
"ICONGF";"S";"0086";"FINSI"
"ICONGF";"S";"0087";"LOCA_DATEFU(1:4) << LOCA_ACOURS"
"ICONGF";"S";"0088";"LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"ICONGF";"S";"0089";"LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"ICONGF";"S";"0090";"LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"ICONGF";"S";"0091";"*"
"ICONGF";"S";"0092";"* Implémentation des données industrielles"
"ICONGF";"S";"0093";"*"
"ICONGF";"S";"0094";"DEBDICO"
"ICONGF";"S";"0095";"   HJOU_IJRNBCOFRA;N;N5,1;I;;;     6789;;IJRNBCOFRA;V3;""Nbre congé payé dans période de fract."";"
"ICONGF";"S";"0096";"   HJOU_IJRDCOFRAC;N;N6,1;I;;;    56789;;IJRDCOFRAC;V3;""Droit congé fractionnement"";"
"ICONGF";"S";"0097";"   HJOU_IJRCCOFRAC;N;N6,1;I;;;    56789;;IJRCCOFRAC;V3;""Congé fractionnement pris"";"
"ICONGF";"S";"0098";"   HJOU_IJRSCOFRAC;N;N6,1;I;;;    56789;;IJRSCOFRAC;V3;""Solde congé fractionnement"";"
"ICONGF";"S";"0099";"   PARD_IDICALFRAC;O;Z1;X;0;1;123456789;C;;C3;""Calcul Congés fractionnement"";"
"ICONGF";"S";"0100";"   PARD_IDIVMCOFRA;O;A10;X;;;123456789;II;;C2;""Congé fractionnement"";"
"ICONGF";"S";"0101";"FINDICO"
"ICONGF";"S";"0102";"*"
"ICONGF";"S";"0103";"DEBANO"
"ICONGF";"S";"0104";"   169;9;""Solde congés fractionnement insuffisant"";"
"ICONGF";"S";"0105";"   186;9;""Solde congés fractionnement insuffisant pour transfert en CET"";"
"ICONGF";"S";"0106";"FINANO"
"ICONGF";"S";"0107";"* Déclaration des donnees locales"
"ICONGF";"S";"0108";"DEF LOCA_MOTCFRAC N1"
"ICONGF";"S";"0109";"LOCA_MOTCFRAC = 0"
"ICONGF";"S";"0110";"DEF LOCA_ACQTOTAL N4.2"
"ICONGF";"S";"0111";"LOCA_ACQTOTAL = 0"
"ICONGF";"S";"0112";"DEF LOCA_PLAFOND N2"
"ICONGF";"S";"0113";"LOCA_PLAFOND = 0"
"ICONGF";"S";"0114";"*"
"ICONGF";"S";"0115";"** Comptabilisation des CP pris entre le 01/05 et le 31/10"
"ICONGF";"S";"0116";"SI PARD_IDIVMCOFRA <> "" """
"ICONGF";"S";"0117";"** RAZ au 01/05"
"ICONGF";"S";"0118";"   SI HJOU_DATE(5:4) = ""0501"""
"ICONGF";"S";"0119";"      HJOU_IJRNBCOFRA = 0"
"ICONGF";"S";"0120";"   FINSI"
"ICONGF";"S";"0121";"** RAZ du doit/consommé au 01/11"
"ICONGF";"S";"0122";"   SI HJOU_DATE(5:4) = ""1101"""
"ICONGF";"S";"0123";"      HJOU_IJRDCOFRAC = 0"
"ICONGF";"S";"0124";"      HJOU_IJRCCOFRAC = 0"
"ICONGF";"S";"0125";"   FINSI"
"ICONGF";"S";"0126";"*"
"ICONGF";"S";"0127";"* Calcul des droit en automatique"
"ICONGF";"S";"0128";"*"
"ICONGF";"S";"0129";"   SI PARD_IDICALFRAC = ""1"""
"ICONGF";"S";"0130";"**"
"ICONGF";"S";"0131";"** Comptabilisation des CP pris entre le 01/05 et le 31/10"
"ICONGF";"S";"0132";"** Pour le mois de mai on ne compte pas les CP et les CP reliquat"
"ICONGF";"S";"0133";"**"
"ICONGF";"S";"0134";"      SI HJOU_DATE(5:4) >= ""0501"""
"ICONGF";"S";"0135";"         SI HJOU_DATE(5:4) <= ""0531"""
"ICONGF";"S";"0136";"            POUR ACTIVITES"
"ICONGF";"S";"0137";"*SI HABS_MOTIF = PARD_IDIVMCOANC"
"ICONGF";"S";"0138";"               SI HABS_MOTIF = PARD_IDIVMCOANT"
"ICONGF";"S";"0139";"                  SI HABS_VALORIS = ""J"""
"ICONGF";"S";"0140";"                     HJOU_IJRNBCOFRA = HJOU_IJRNBCOFRA + 1"
"ICONGF";"S";"0141";"                     LOCA_FLAG = 1"
"ICONGF";"S";"0142";"                  SINON"
"ICONGF";"S";"0143";"                     HJOU_IJRNBCOFRA = HJOU_IJRNBCOFRA + 0.5"
"ICONGF";"S";"0144";"                     LOCA_FLAG = 1"
"ICONGF";"S";"0145";"                  FINSI"
"ICONGF";"S";"0146";"               FINSI"
"ICONGF";"S";"0147";"            FINPOUR"
"ICONGF";"S";"0148";"*pas de raz le samedi, dimanche ou férié si congés dans la semaine"
"ICONGF";"S";"0149";"            SI HJOU_JOUR = ""6"""
"ICONGF";"S";"0150";"            OU HJOU_JOUR = ""7"""
"ICONGF";"S";"0151";"            OU LOCA_FERI = 1"
"ICONGF";"S";"0152";"               LIREVALPRE LOCA_NBCOFRA HJOU_IJRNBCOFRA"
"ICONGF";"S";"0153";"               SI LOCA_NBCOFRA > 0"
"ICONGF";"S";"0154";"                  LOCA_FLAG = 1"
"ICONGF";"S";"0155";"               FINSI"
"ICONGF";"S";"0156";"            FINSI"
"ICONGF";"S";"0157";"         FINSI"
"ICONGF";"S";"0158";"      FINSI"
"ICONGF";"S";"0159";"**"
"ICONGF";"S";"0160";"      SI HJOU_DATE(5:4) >= ""0601"""
"ICONGF";"S";"0161";"         SI HJOU_DATE(5:4) <= ""1031"""
"ICONGF";"S";"0162";"            POUR ACTIVITES"
"ICONGF";"S";"0163";"*SI HABS_MOTIF = PARD_IDIVMCOANC"
"ICONGF";"S";"0164";"               SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONGF";"S";"0165";"*OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONGF";"S";"0166";"                  SI HABS_VALORIS = ""J"""
"ICONGF";"S";"0167";"                     HJOU_IJRNBCOFRA = HJOU_IJRNBCOFRA + 1"
"ICONGF";"S";"0168";"                     LOCA_FLAG = 1"
"ICONGF";"S";"0169";"                  SINON"
"ICONGF";"S";"0170";"                     HJOU_IJRNBCOFRA = HJOU_IJRNBCOFRA + 0.5"
"ICONGF";"S";"0171";"                     LOCA_FLAG = 1"
"ICONGF";"S";"0172";"                  FINSI"
"ICONGF";"S";"0173";"               FINSI"
"ICONGF";"S";"0174";"            FINPOUR"
"ICONGF";"S";"0175";"*pas de raz le samedi, dimanche ou férié si congés dans la semaine"
"ICONGF";"S";"0176";"            SI HJOU_JOUR = ""6"""
"ICONGF";"S";"0177";"            OU HJOU_JOUR = ""7"""
"ICONGF";"S";"0178";"            OU LOCA_FERI = 1"
"ICONGF";"S";"0179";"               LIREVALPRE LOCA_NBCOFRA HJOU_IJRNBCOFRA"
"ICONGF";"S";"0180";"               SI LOCA_NBCOFRA > 0"
"ICONGF";"S";"0181";"                  LOCA_FLAG = 1"
"ICONGF";"S";"0182";"               FINSI"
"ICONGF";"S";"0183";"            FINSI"
"ICONGF";"S";"0184";"         FINSI"
"ICONGF";"S";"0185";"      FINSI"
"ICONGF";"S";"0186";"** si on est dans la période 01/01 au 30/04 ou du 1/11 au 31/12"
"ICONGF";"S";"0187";"* on stocke les congés de l'année dans un compteur de droit CFRAC"
"ICONGF";"S";"0188";"*Prise en compte si 10j ouvrés ou 12j ouvrables consécutifs"
"ICONGF";"S";"0189";"*"
"ICONGF";"S";"0190";"      SI PARD_IDINBRSAMD > 0"
"ICONGF";"S";"0191";"         SI HJOU_IJRNBCOFRA >= 12"
"ICONGF";"S";"0192";"            LOCA_CALCUL = 1"
"ICONGF";"S";"0193";"         SINON"
"ICONGF";"S";"0194";"            SI LOCA_FLAG = 0"
"ICONGF";"S";"0195";"               SI LOCA_FERI = 0"
"ICONGF";"S";"0196";"                  HJOU_IJRNBCOFRA = 0"
"ICONGF";"S";"0197";"               FINSI"
"ICONGF";"S";"0198";"            FINSI"
"ICONGF";"S";"0199";"         FINSI"
"ICONGF";"S";"0200";"      SINON"
"ICONGF";"S";"0201";"         SI HJOU_IJRNBCOFRA >= 10"
"ICONGF";"S";"0202";"            LOCA_CALCUL = 1"
"ICONGF";"S";"0203";"         SINON"
"ICONGF";"S";"0204";"            SI LOCA_FLAG = 0"
"ICONGF";"S";"0205";"               SI LOCA_FERI = 0"
"ICONGF";"S";"0206";"                  HJOU_IJRNBCOFRA = 0"
"ICONGF";"S";"0207";"               FINSI"
"ICONGF";"S";"0208";"            FINSI"
"ICONGF";"S";"0209";"         FINSI"
"ICONGF";"S";"0210";"      FINSI"
"ICONGF";"S";"0211";"**"
"ICONGF";"S";"0212";"**"
"ICONGF";"S";"0213";"** calcul du droit"
"ICONGF";"S";"0214";"      SI HJOU_DATE(5:4) = ""1101"""
"ICONGF";"S";"0215";"* calcul du fractionnement que pour les employes dont le compteur Doit CP est alimenté"
"ICONGF";"S";"0216";"         SI HJOU_IJRDCOPRIN > 0"
"ICONGF";"S";"0217";"            LOCA_ACQTOTAL = HORC_IHIDRJTRAV + HORC_IHIDRNTRAV"
"ICONGF";"S";"0218";"* Jours ouvrés"
"ICONGF";"S";"0219";"            SI LOCA_ACQTOTAL = 2.08"
"ICONGF";"S";"0220";"               LOCA_PLAFOND = 10"
"ICONGF";"S";"0221";"            SINON"
"ICONGF";"S";"0222";"* Jours ouvrables"
"ICONGF";"S";"0223";"               SI LOCA_ACQTOTAL = 2.5"
"ICONGF";"S";"0224";"                  LOCA_PLAFOND = 12"
"ICONGF";"S";"0225";"               FINSI"
"ICONGF";"S";"0226";"            FINSI"
"ICONGF";"S";"0227";"*"
"ICONGF";"S";"0228";"            SI HJOU_IJRNBCOFRA >= LOCA_PLAFOND"
"ICONGF";"S";"0229";"* si l'employé a pris entre 15 et 17.5 jour -> acquis de 1 jour"
"ICONGF";"S";"0230";"               SI HJOU_IJRNBCOFRA <= 17.5"
"ICONGF";"S";"0231";"                  SI HJOU_IJRNBCOFRA > 15"
"ICONGF";"S";"0232";"                     HJOU_IJRDCOFRAC = 1"
"ICONGF";"S";"0233";"                  SINON"
"ICONGF";"S";"0234";"* l'employé a pris au maxi 15 jours -> acquis de 2 jours"
"ICONGF";"S";"0235";"                     HJOU_IJRDCOFRAC = 2"
"ICONGF";"S";"0236";"                  FINSI"
"ICONGF";"S";"0237";"               FINSI"
"ICONGF";"S";"0238";"            FINSI"
"ICONGF";"S";"0239";"         FINSI"
"ICONGF";"S";"0240";"      FINSI"
"ICONGF";"S";"0241";"   FINSI"
"ICONGF";"S";"0242";"* calcul du pris"
"ICONGF";"S";"0243";"   POUR ACTIVITES"
"ICONGF";"S";"0244";"* calcul du pris"
"ICONGF";"S";"0245";"      SI HABS_MOTIF = PARD_IDIVMCOFRA"
"ICONGF";"S";"0246";"         LOCA_MOTCFRAC = 1"
"ICONGF";"S";"0247";"         SI HABS_VALORIS = ""J"""
"ICONGF";"S";"0248";"            HJOU_IJRCCOFRAC = HJOU_IJRCCOFRAC + 1"
"ICONGF";"S";"0249";"            HJOU_IJRSCOFRAC = HJOU_IJRSCOFRAC - 1"
"ICONGF";"S";"0250";"         SINON"
"ICONGF";"S";"0251";"            HJOU_IJRCCOFRAC = HJOU_IJRCCOFRAC + 0.5"
"ICONGF";"S";"0252";"            HJOU_IJRSCOFRAC = HJOU_IJRSCOFRAC - 0.5"
"ICONGF";"S";"0253";"         FINSI"
"ICONGF";"S";"0254";"      FINSI"
"ICONGF";"S";"0255";"** Analyse des consignes"
"ICONGF";"S";"0256";"      SI HABS_MOTIF = ""XDCF"""
"ICONGF";"S";"0257";"         HJOU_IJRDCOFRAC = HJOU_IJRDCOFRAC + HABS_MOTINBR"
"ICONGSUPM";"S";"0016";"*"
"ICONGF";"S";"0258";"         HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"ICONGF";"S";"0259";"      FINSI"
"ICONGF";"S";"0260";"      SI HABS_MOTIF = ""ZDCF"""
"ICONGF";"S";"0261";"         HJOU_IJRDCOFRAC = HABS_MOTINBR"
"ICONGF";"S";"0262";"         HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"ICONGF";"S";"0263";"      FINSI"
"ICONGF";"S";"0264";"      SI HABS_MOTIF = ""XCCF"""
"ICONGF";"S";"0265";"         HJOU_IJRCCOFRAC = HJOU_IJRCCOFRAC + HABS_MOTINBR"
"ICONGF";"S";"0266";"         HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"ICONGF";"S";"0267";"      FINSI"
"ICONGF";"S";"0268";"      SI HABS_MOTIF = ""ZCCF"""
"ICONGF";"S";"0269";"         HJOU_IJRCCOFRAC = HABS_MOTINBR"
"ICONGF";"S";"0270";"         HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"ICONGF";"S";"0271";"      FINSI"
"ICONGF";"S";"0272";"   FINPOUR"
"ICONGF";"S";"0273";"*Recalcul solde"
"ICONGF";"S";"0274";"   HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"ICONGF";"S";"0275";"*"
"ICONGF";"S";"0276";"   SI LOCA_MOTCFRAC = 1"
"ICONGF";"S";"0277";"* Anomalie si le solde < 0"
"ICONGF";"S";"0278";"      SI HJOU_IJRSCOFRAC < 0"
"ICONGF";"S";"0279";"         ANOMALIE 169"
"ICONGF";"S";"0280";"      FINSI"
"ICONGF";"S";"0281";"   FINSI"
"ICONGF";"S";"0282";"*"
"ICONGF";"S";"0283";"** transfert de congé de fractionnement en CET"
"ICONGF";"S";"0284";"   POUR ACTIVITES"
"ICONGF";"S";"0285";"      SI HABS_MOTIF = ""YCFCET"""
"ICONGF";"S";"0286";"         SI HABS_MOTINBR <= HJOU_IJRSCOFRAC"
"ICONGF";"S";"0287";"            HJOU_IJRSCOFRAC = HJOU_IJRSCOFRAC - HABS_MOTINBR"
"ICONGF";"S";"0288";"         SINON"
"ICONGF";"S";"0289";"* solde cp fractionnement insuffisant pour transfert en CET"
"ICONGF";"S";"0290";"            TEMP_ITQTRCFCET = 1"
"ICONGF";"S";"0291";"            ANOMALIE 186"
"ICONGF";"S";"0292";"         FINSI"
"ICONGF";"S";"0293";"      FINSI"
"ICONGF";"S";"0294";"   FINPOUR"
"ICONGF";"S";"0295";"* rajout du solde fractionnement dans le solde CP global"
"ICONGF";"S";"0296";"*"
"ICONGF";"S";"0297";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOFRAC"
"ICONGF";"S";"0298";"* alimentation du solde prévisionnel"
"ICONGF";"S";"0299";"*"
"ICONGF";"S";"0300";"* ca ou l'employé a une date de fin de contrat ou date de cloture < loca_datefu"
"ICONGF";"S";"0301";"*"
"ICONGF";"S";"0302";"   SI CTRA_DATFIN > TEMP_DATJOU"
"ICONGF";"S";"0303";"      SI CTRA_DATFIN < LOCA_DATEFU"
"ICONGF";"S";"0304";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"ICONGF";"S";"0305";"         LOCA_DATEFU = TEMP_DXFINPER"
"ICONGF";"S";"0306";"      SINON"
"ICONGF";"S";"0307";"         SI CTRA_DATFIN < LOCA_DATEFU2"
"ICONGF";"S";"0308";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"ICONGF";"S";"0309";"            LOCA_DATEFU2 = TEMP_DXFINPER"
"ICONGF";"S";"0310";"         FINSI"
"ICONGF";"S";"0311";"      FINSI"
"ICONGF";"S";"0312";"   FINSI"
"ICONGF";"S";"0313";"*"
"ICONGF";"S";"0314";"   SI TEMP_DATSUI = LOCA_DATEFU"
"ICONGF";"S";"0315";"      EMPL_IEQSPGCONG = HJOU_IJRSGCONGE"
"ICONGF";"S";"0316";"   FINSI"
"ICONGF";"S";"0317";"*"
"ICONGF";"S";"0318";"   SI TEMP_DATSUI = LOCA_DATEFU2"
"ICONGF";"S";"0319";"      EMPL_IEQSPGCON2 = HJOU_IJRSGCONGE"
"ICONGF";"S";"0320";"   FINSI"
"ICONGF";"S";"0321";"FINSI"
"ICONGF";"S";"0322";"FIN"
