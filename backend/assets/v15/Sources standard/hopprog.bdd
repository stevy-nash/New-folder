"ISTATI";"S";"0014";"*"
"ISTATI";"S";"0015";"*"
"ISTATI";"S";"0016";"* Rôle : Statistiques et compteur Explorer"
"ISTATI";"S";"0017";"*"
"ISTATI";"S";"0018";"*"
"ISTATI";"S";"0019";"*"
"ISTATI";"S";"0020";"*"
"ISTATI";"S";"0021";"*----------------------------------------------------------------------"
"ISTATI";"S";"0022";"*"
"ISTATI";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"ISTATI";"S";"0024";"* Date         : JJ/MM/AAAA"
"ISTATI";"S";"0025";"* Objet        :"
"ISTATI";"S";"0026";"*"
"ISTATI";"S";"0027";"***********************************************************************"
"ISTATI";"S";"0028";"*"
"ISTATI";"S";"0029";"* Implémentation des données industrielles"
"ISTATI";"S";"0030";"*"
"ISTATI";"S";"0031";"DEBDICO"
"ISTATI";"S";"0032";"   HJOU_IJRNNUITRA;N;N5,1;I;;;    56789;;IJRNNUITRA;V3;""Nbre de nuits travaillées annuel"";"
"ISTATI";"S";"0033";"   HJOU_IJRNSAMTRA;N;N5,1;I;;;    56789;;IJRNSAMTRA;V3;""Nbre de samedi travaillés annuel"";"
"ISTATI";"S";"0034";"   HJOU_IJRNDIMTRA;N;N5,1;I;;;    56789;;IJRNDIMTRA;V3;""Nbre de dimanche travaillés annuel"";"
"ISTATI";"S";"0035";"   HJOU_IJRNJFETRA;N;N5,1;I;;;    56789;;IJRNJFETRA;V3;""Nbre de fériés travaillés annuel"";"
"ISTATI";"S";"0036";"   HJOU_IJQETTEPRT;N;T8,2;L;;;    56789;;;V3;""Ecart TTE / présence théorique"";"
"ISTATI";"S";"0037";"FINDICO"
"ISTATI";"S";"0038";"*"
"ISTATI";"S";"0039";"* Déclaration des donnees locales"
"ISTATI";"S";"0040";"*"
"ISTATI";"S";"0041";"*---------------------------------------------------------------"
"ISTATI";"S";"0042";"*          STATISTIQUES                                        *"
"ISTATI";"S";"0043";"*---------------------------------------------------------------"
"ISTATI";"S";"0044";"** raz des compteurs au 01/01 ou en debut d'annualisation"
"ISTATI";"S";"0045";"SI PARD_IDIDDEBANN <> "" """
"ISTATI";"S";"0046";"   SI HJOU_DATE = PARD_IDIDDEBANN"
"ISTATI";"S";"0047";"      HJOU_IJRNNUITRA = 0"
"ISTATI";"S";"0048";"      HJOU_IJRNSAMTRA = 0"
"ISTATI";"S";"0049";"      HJOU_IJRNDIMTRA = 0"
"ISTATI";"S";"0050";"      HJOU_IJRNJFETRA = 0"
"ISTATI";"S";"0051";"   FINSI"
"ISTATI";"S";"0052";"SINON"
"ISTATI";"S";"0053";"   SI HJOU_DATE(5:4) = ""0101"""
"ISTATI";"S";"0054";"      HJOU_IJRNNUITRA = 0"
"ISTATI";"S";"0055";"      HJOU_IJRNSAMTRA = 0"
"ISTATI";"S";"0056";"      HJOU_IJRNDIMTRA = 0"
"ISTATI";"S";"0057";"      HJOU_IJRNJFETRA = 0"
"ISTATI";"S";"0058";"   FINSI"
"ISTATI";"S";"0059";"FINSI"
"ISTATI";"S";"0060";"* nombre de nuits travailles"
"ISTATI";"S";"0061";"SI HJOU_IJQHNUITTO > 0"
"ISTATI";"S";"0062";"   HJOU_IJRNNUITRA = HJOU_IJRNNUITRA + 1"
"ISTATI";"S";"0063";"FINSI"
"ISTATI";"S";"0064";"* nombre de samedi travailles"
"ISTATI";"S";"0065";"SI HJOU_JOUR = ""6"""
"ISTATI";"S";"0066";"   SI HJOU_IJQTTEFFEJ > 0"
"ISTATI";"S";"0067";"      HJOU_IJRNSAMTRA = HJOU_IJRNSAMTRA + 1"
"ISTATI";"S";"0068";"   FINSI"
"ISTATI";"S";"0069";"FINSI"
"ISTATI";"S";"0070";"* nombre de dimanche travailles"
"ISTATI";"S";"0071";"SI HJOU_JOUR = ""7"""
"ISTATI";"S";"0072";"   SI HJOU_IJQTTEFFEJ > 0"
"ISTATI";"S";"0073";"      HJOU_IJRNDIMTRA = HJOU_IJRNDIMTRA + 1"
"ISTATI";"S";"0074";"   FINSI"
"ISTATI";"S";"0075";"FINSI"
"ISTATI";"S";"0076";"* nombre de jours feries travailles"
"ISTATI";"S";"0077";"SI HJOU_IJQHJFTRAV > 0"
"ISTATI";"S";"0078";"   HJOU_IJRNJFETRA = HJOU_IJRNJFETRA + 1"
"ISTATI";"S";"0079";"FINSI"
"ISTATI";"S";"0080";"*"
"ISTATI";"S";"0081";"* consignes d'initialisation"
"ISTATI";"S";"0082";"POUR ACTIVITES"
"ISTATI";"S";"0083";"   SI HABS_MOTIF = ""ZNBN"""
"ISTATI";"S";"0084";"      HJOU_IJRNNUITRA = HABS_MOTINBR"
"ISTATI";"S";"0085";"   FINSI"
"ISTATI";"S";"0086";"   SI HABS_MOTIF = ""ZNBS"""
"ISTATI";"S";"0087";"      HJOU_IJRNSAMTRA = HABS_MOTINBR"
"ISTATI";"S";"0088";"   FINSI"
"ISTATI";"S";"0089";"   SI HABS_MOTIF = ""ZNBD"""
"ISTATI";"S";"0090";"      HJOU_IJRNDIMTRA = HABS_MOTINBR"
"ISTATI";"S";"0091";"   FINSI"
"ISTATI";"S";"0092";"   SI HABS_MOTIF = ""ZNBF"""
"ISTATI";"S";"0093";"      HJOU_IJRNJFETRA = HABS_MOTINBR"
"ISTATI";"S";"0094";"   FINSI"
"ISTATI";"S";"0095";"FINPOUR"
"ISTATI";"S";"0096";"*"
"ISTATI";"S";"0097";"*---------------------------------------------------------------"
"ISTATI";"S";"0098";"*          COMPTEUR EXPLORER                                   *"
"ISTATI";"S";"0099";"*---------------------------------------------------------------"
"ISTATI";"S";"0100";"*"
"ISTATI";"S";"0101";"* Calcul de l'écart heures effectives/théorie"
"ISTATI";"S";"0102";"* selon le type de traitement"
"ISTATI";"S";"0103";"*"
"ISTATI";"S";"0104";"* Traitement fin de semaine Type 1"
"ISTATI";"S";"0105";"*"
"ISTATI";"S";"0106";"SI HJOU_DATE <= TEMP_DATJOU"
"ISTATI";"S";"0107";"   SI HJOU_IJIGCDTYPP = ""1"""
"ISTATI";"S";"0108";"      SI HJOU_JOUR = ""7"""
"ISTATI";"S";"0109";"         HJOU_IJQETTEPRT = HJOU_IJRTTEFFEH - HJOU_IJRPRETHEH"
"ISTATI";"S";"0110";"      FINSI"
"ISTATI";"S";"0111";"   FINSI"
"ISTATI";"S";"0112";"*"
"ISTATI";"S";"0113";"* Traitement fin de mois Type 2"
"ISTATI";"S";"0114";"*"
"ISTATI";"S";"0115";"   SI HJOU_IJIGCDTYPP = ""2"""
"ISTATI";"S";"0116";"      SI TEMP_DATSUI(7:2) = ""01"""
"ISTATI";"S";"0117";"         HJOU_IJQETTEPRT = HJOU_IJRTTEFFEM - HJOU_IJRPRETHEM"
"ISTATI";"S";"0118";"      FINSI"
"ISTATI";"S";"0119";"   FINSI"
"ISTATI";"S";"0120";"*"
"ISTATI";"S";"0121";"* Traitement sur calendrier type 3"
"ISTATI";"S";"0122";"*"
"ISTATI";"S";"0123";"   SI HJOU_IJIGCDTYPP = ""3"""
"ISTATI";"S";"0124";"      POUR ACTIVITES"
"ISTATI";"S";"0125";"         SI HABS_MOTIF = ""FINP"""
"ISTATI";"S";"0126";"            HJOU_IJQETTEPRT = HJOU_IJRTTEFFEM - HJOU_IJRPRETHEM"
"ISTATI";"S";"0127";"         FINSI"
"ISTATI";"S";"0128";"      FINPOUR"
"ISTATI";"S";"0129";"   FINSI"
"ISTATI";"S";"0130";"*"
"ISTATI";"S";"0131";"* Traitement mixte"
"ISTATI";"S";"0132";"*"
"ISTATI";"S";"0133";"   SI HJOU_IJIGCDTYPP = ""5"""
"ISTATI";"S";"0134";"      SI HJOU_JOUR = ""7"""
"ISTATI";"S";"0135";"         SI TEMP_DATSUI(7:2) <> ""01"""
"ISTATI";"S";"0136";"            HJOU_IJQETTEPRT = HJOU_IJRTTEFFEH - HJOU_IJRPRETHEH"
"ISTATI";"S";"0137";"         FINSI"
"ISTATI";"S";"0138";"      FINSI"
"ISTATI";"S";"0139";"      SI TEMP_DATSUI(7:2) = ""01"""
"ISTATI";"S";"0140";"         HJOU_IJQETTEPRT = HJOU_IJRTTEFFEM - HJOU_IJRPRETHEM"
"ISTATI";"S";"0141";"      FINSI"
"ISTATI";"S";"0142";"   FINSI"
"ISTATI";"S";"0143";"FINSI"
"ISTATI";"S";"0144";"FIN"
"ISUPAC";"S";"0001";"***********************************************************************"
"ISUPAC";"S";"0002";"*"
"ISUPAC";"S";"0003";"* Règle : ISUPAC"
"ISUPAC";"S";"0004";"* Ordre : 3170"
"ISUPAC";"S";"0005";"* Titre : Suppression d'un motif si badgeage"
"ISUPAC";"S";"0006";"*"
"ISUPAC";"S";"0007";"*----------------------------------------------------------------------"
"ISUPAC";"S";"0008";"*"
"ISUPAC";"S";"0009";"* Créé par : Cellule Industrialisation"
"ISUPAC";"S";"0010";"* Date     : 03/09/2009"
"ISUPAC";"S";"0011";"* Version  : 1"
"ISUPAC";"S";"0012";"*"
"ISUPAC";"S";"0013";"*----------------------------------------------------------------------"
"ISUPAC";"S";"0014";"*"
"ISUPAC";"S";"0015";"*"
"ISUPAC";"S";"0016";"* Rôle : Suppression d'un motif si badgeage"
"ISUPAC";"S";"0017";"*"
"ISUPAC";"S";"0018";"*"
"ISUPAC";"S";"0019";"*"
"ISUPAC";"S";"0020";"*"
"ISUPAC";"S";"0021";"*----------------------------------------------------------------------"
"ISUPAC";"S";"0022";"*"
"ISUPAC";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"ISUPAC";"S";"0024";"* Date         : JJ/MM/AAAA"
"ISUPAC";"S";"0025";"* Objet        :"
"ISUPAC";"S";"0026";"*"
"ISUPAC";"S";"0027";"***********************************************************************"
"ISUPAC";"S";"0028";"*"
"ISUPAC";"S";"0029";"* Modifiée par : Méthodes et outils"
"ISUPAC";"S";"0030";"* Date         : 21/05/2019"
"ISUPAC";"S";"0031";"* Objet        : Ajout du test MOTI_TYPMAT = "" "" pour le déclenchement"
"ISUPAC";"S";"0032";"*                 de l'anomalie 123 car il ne faut pas déclencher cette anomalie"
"ISUPAC";"S";"0033";"*                 en cas de pose de motif de type ""arrêt"""
"ISUPAC";"S";"0034";"*"
"ISUPAC";"S";"0035";"***********************************************************************"
"ISUPAC";"S";"0036";"*"
"ISUPAC";"S";"0037";"* Implémentation des données industrielles"
"ISUPAC";"S";"0038";"*"
"ISUPAC";"S";"0039";"DEBDICO"
"ISUPAC";"S";"0040";"   HJOU_IJQNACTIVJ;N;N2;I;;;    56789;;;V3;""Nombre d activités"";"
"ISUPAC";"S";"0041";"   HJOU_IJQNABSEN1;N;N2;I;;;    56789;;;V3;""Nombre d absences matin"";"
"ISUPAC";"S";"0042";"   HJOU_IJQNABSEN2;N;N2;I;;;    56789;;;V3;""Nombre d absences après-midi"";"
"ISUPAC";"S";"0043";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"ISUPAC";"S";"0044";"FINDICO"
"ISUPAC";"S";"0045";"*"
"ISUPAC";"S";"0046";"DEBANO"
"ISUPAC";"S";"0047";"   123;5;""Suppression d'un motif d'absence car badgeages"";"
"ISUPAC";"S";"0048";"FINANO"
"ISUPAC";"S";"0049";"* Déclaration des donnees locales"
"ISUPAC";"S";"0050";"*"
"ISUPAC";"S";"0051";"DEF LOCA_MOTIFJ A10"
"ISUPAC";"S";"0052";"LOCA_MOTIFJ = "" """
"ISUPAC";"S";"0053";"DEF LOCA_MOTIFM A10"
"ISUPAC";"S";"0054";"LOCA_MOTIFM = "" """
"ISUPAC";"S";"0055";"DEF LOCA_MOTIFA A10"
"ISUPAC";"S";"0056";"LOCA_MOTIFA = "" """
"ISUPAC";"S";"0057";"DEF LOCA_ABSH T6.2"
"ISUPAC";"S";"0058";"LOCA_ABSH = 0"
"ISUPAC";"S";"0059";"DEF LOCA_SEUIL T6.2"
"ISUPAC";"S";"0060";"LOCA_SEUIL = 0"
"ISUPAC";"S";"0061";"*"
"ISUPAC";"S";"0062";"*"
"ISUPAC";"S";"0063";"POUR ACTIVITES"
"ISUPAC";"S";"0064";"   SI HABS_MOTYPE <> ""C"""
"ISUPAC";"S";"0065";"      SI HABS_VALORIS = ""H"""
"ISUPAC";"S";"0066";"         LOCA_ABSH = LOCA_ABSH + HABS_MOTIDUR"
"ISUPAC";"S";"0067";"      FINSI"
"ISUPAC";"S";"0068";"      SI HABS_VALORIS = ""J"""
"ISUPAC";"S";"0069";"         HJOU_IJQNACTIVJ = HJOU_IJQNACTIVJ + 1"
"ISUPAC";"S";"0070";"      FINSI"
"ISUPAC";"S";"0071";"      SI HABS_VALORIS = ""M"""
"ISUPAC";"S";"0072";"         HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"ISUPAC";"S";"0073";"      FINSI"
"ISUPAC";"S";"0074";"      SI HABS_VALORIS = ""A"""
"ISUPAC";"S";"0075";"         HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"ISUPAC";"S";"0076";"      FINSI"
"ISUPAC";"S";"0077";"   FINSI"
"ISUPAC";"S";"0078";"FINPOUR"
"ISUPAC";"S";"0079";"SI HJOU_IJQNBADGEA = 0"
"ISUPAC";"S";"0080";"   SI LOCA_ABSH > 0"
"ISUPAC";"S";"0081";"* le 03/10/2012"
"ISUPAC";"S";"0082";"* pas de déclenchement d'anomalie 125/126"
"ISUPAC";"S";"0083";"* si le total des motifs en heure > (theorie/2) +2"
"ISUPAC";"S";"0084";"      LOCA_SEUIL = HJOU_IJQPRETHEJ / 2"
"ISUPAC";"S";"0085";"      LOCA_SEUIL = LOCA_SEUIL + 2"
"ISUPAC";"S";"0086";"      SI LOCA_ABSH >= LOCA_SEUIL"
"ISUPAC";"S";"0087";"* cas ou on a un motif matin"
"ISUPAC";"S";"0088";"         SI HJOU_IJQNABSEN1 > 0"
"ISUPAC";"S";"0089";"            HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"ISUPAC";"S";"0090";"         SINON"
"ISUPAC";"S";"0091";"* cas ou on a un motif apres-midi"
"ISUPAC";"S";"0092";"            SI HJOU_IJQNABSEN2 > 0"
"ISUPAC";"S";"0093";"               HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"ISUPAC";"S";"0094";"* aucun motif matin ou apres-midi"
"ISUPAC";"S";"0095";"* on considere qu'il est absent la journée"
"ISUPAC";"S";"0096";"            SINON"
"ISUPAC";"S";"0097";"               HJOU_IJQNACTIVJ = HJOU_IJQNACTIVJ + 1"
"ISUPAC";"S";"0098";"            FINSI"
"ISUPAC";"S";"0099";"         FINSI"
"ISUPAC";"S";"0100";"      SINON"
"ISUPAC";"S";"0101";"* cas ou le total des motifs en heure < (théorie/2) + 2"
"ISUPAC";"S";"0102";"         SI HJOU_IJQNABSEN1 > 0"
"ISUPAC";"S";"0103";"            HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"ISUPAC";"S";"0104";"         SINON"
"ISUPAC";"S";"0105";"            SI HJOU_IJQNABSEN2 > 0"
"ISUPAC";"S";"0106";"               HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"ISUPAC";"S";"0107";"            SINON"
"ISUPAC";"S";"0108";"* cas ou on a aucun motif matin ou apres-midi"
"ISUPAC";"S";"0109";"               HJOU_IJQNABSEN1 = 50"
"ISUPAC";"S";"0110";"               HJOU_IJQNABSEN2 = 50"
"ISUPAC";"S";"0111";"            FINSI"
"ISUPAC";"S";"0112";"         FINSI"
"ISUPAC";"S";"0113";"      FINSI"
"ISUPAC";"S";"0114";"   FINSI"
"ISUPAC";"S";"0115";"FINSI"
"ISUPAC";"S";"0116";"SI LOCA_ABSH > 0"
"ISUPAC";"S";"0117";"   SI HJOU_IJQPRESBA1 = 1"
"ISUPAC";"S";"0118";"      SI HJOU_IJQPRESBA2 = 0"
"ISUPAC";"S";"0119";"         SI HJOU_IJQNABSEN2 = 0"
"ISUPAC";"S";"0120";"            HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"ISUPAC";"S";"0121";"         FINSI"
"ISUPAC";"S";"0122";"      FINSI"
"ISUPAC";"S";"0123";"   FINSI"
"ISUPAC";"S";"0124";"   SI HJOU_IJQPRESBA2 = 1"
"ISUPAC";"S";"0125";"      SI HJOU_IJQPRESBA1 = 0"
"ISUPAC";"S";"0126";"         SI HJOU_IJQNABSEN1 = 0"
"ISUPAC";"S";"0127";"            HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"ISUPAC";"S";"0128";"         FINSI"
"ISUPAC";"S";"0129";"      FINSI"
"ISUPAC";"S";"0130";"   FINSI"
"ISUPAC";"S";"0131";"FINSI"
"ISUPAC";"S";"0132";"*"
"ISUPAC";"S";"0133";"*  Test si absence jour et badgeage"
"ISUPAC";"S";"0134";"*  Test du parametre suppression d'un motif car badgeage"
"ISUPAC";"S";"0135";"*  parametre pard_paretour"
"ISUPAC";"S";"0136";"POUR ACTIVITES"
"ISUPAC";"S";"0137";"   SI HABS_MOTYPE <> ""C"""
"ISUPAC";"S";"0138";"      SI PARD_IDIGPRIBAD = ""1"""
"ISUPAC";"S";"0139";"         SI HJOU_IJQNACTIVJ > 0"
"ISUPAC";"S";"0140";"            SI HJOU_IJQNBADGEA > 0"
"ISUPAC";"S";"0141";"               SI HABS_VALORIS = ""J"""
"ISUPAC";"S";"0142";"                  LOCA_MOTIFJ = HABS_MOTIF"
"ISUPAC";"S";"0143";"                  SI LOCA_MOTIFJ = ""FERI"""
"ISUPAC";"S";"0144";"                     HABS_MOTIDUR = 0"
"ISUPAC";"S";"0145";"                  SINON"
"ISUPAC";"S";"0146";"                     SI MOTI_TYPMAT = "" """
"ISUPAC";"S";"0147";"                        ANOMALIE 123"
"ISUPAC";"S";"0148";"                     FINSI"
"ISUPAC";"S";"0149";"                  FINSI"
"ISUPAC";"S";"0150";"               FINSI"
"ISUPAC";"S";"0151";"            FINSI"
"ISUPAC";"S";"0152";"         FINSI"
"ISUPAC";"S";"0153";"*  Test si absence matin et badgeage"
"ISUPAC";"S";"0154";"         SI HJOU_IJQNABSEN1 >= 1"
"ISUPAC";"S";"0155";"            SI HJOU_IJQPRESBA1 = 1"
"ISUPAC";"S";"0156";"               SI HABS_VALORIS = ""M"""
"ISUPAC";"S";"0157";"                  LOCA_MOTIFM = HABS_MOTIF"
"ISUPAC";"S";"0158";"                  SI MOTI_TYPMAT = "" """
"ISUPAC";"S";"0159";"                     ANOMALIE 123"
