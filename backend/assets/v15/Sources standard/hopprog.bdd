"ICONSCPSCH";"S";"1034";"            FINSI"
"ICONSCPSCH";"S";"1035";"* Consignes CP non travaillé"
"ICONSCPSCH";"S";"1036";"            SI HABS_MOTIF = ""XCCPNT"""
"ICONSCPSCH";"S";"1037";"               HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + HABS_MOTINBR"
"ICONSCPSCH";"S";"1038";"               HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"ICONSCPSCH";"S";"1039";"* Recalcul des compteurs congé payé"
"ICONSCPSCH";"S";"1040";"               HJOU_IJRCCOPRIN = HJOU_IJRCCPTRA + HJOU_IJRCCPNTRA"
"ICONSCPSCH";"S";"1041";"               HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"ICONSCPSCH";"S";"1042";"            FINSI"
"ICONSCPSCH";"S";"1043";"            SI HABS_MOTIF = ""ZCCPNT"""
"ICONSCPSCH";"S";"1044";"               HJOU_IJRCCPNTRA = HABS_MOTINBR"
"ICONSCPSCH";"S";"1045";"               HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"ICONSCPSCH";"S";"1046";"* Recalcul des compteurs congé payé"
"ICONSCPSCH";"S";"1047";"               HJOU_IJRCCOPRIN = HJOU_IJRCCPTRA + HJOU_IJRCCPNTRA"
"ICONSCPSCH";"S";"1048";"               HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"ICONSCPSCH";"S";"1049";"            FINSI"
"ICONSCPSCH";"S";"1050";"         FINSI"
"ICONSCPSCH";"S";"1051";"      FINPOUR"
"ICONSCPSCH";"S";"1052";"      *"
"ICONSCPSCH";"S";"1053";"      SI LOCA_ANCI = 1"
"ICONSCPSCH";"S";"1054";"         SI HJOU_IJRSCOANCI < 0"
"ICONSCPSCH";"S";"1055";"            ANOMALIE 168"
"ICONSCPSCH";"S";"1056";"         FINSI"
"ICONSCPSCH";"S";"1057";"      FINSI"
"ICONSCPSCH";"S";"1058";"      *"
"ICONSCPSCH";"S";"1059";"      SI LOCA_ACP = 1"
"ICONSCPSCH";"S";"1060";"         SI HJOU_IJRSACQCP < 0"
"ICONSCPSCH";"S";"1061";"            ANOMALIE 197"
"ICONSCPSCH";"S";"1062";"         FINSI"
"ICONSCPSCH";"S";"1063";"      FINSI"
"ICONSCPSCH";"S";"1064";"      *"
"ICONSCPSCH";"S";"1065";"      SI LOCA_CPMOT = 1"
"ICONSCPSCH";"S";"1066";"         SI HORC_IHIDRNTRAV = 0"
"ICONSCPSCH";"S";"1067";"            SI HJOU_IJRSCOPRIN < 0"
"ICONSCPSCH";"S";"1068";"               ANOMALIE 198"
"ICONSCPSCH";"S";"1069";"            FINSI"
"ICONSCPSCH";"S";"1070";"         SINON"
"ICONSCPSCH";"S";"1071";"            SI HJOU_IJRSCPTRA < 0"
"ICONSCPSCH";"S";"1072";"               ANOMALIE 198"
"ICONSCPSCH";"S";"1073";"            FINSI"
"ICONSCPSCH";"S";"1074";"         FINSI"
"ICONSCPSCH";"S";"1075";"      FINSI"
"ICONSCPSCH";"S";"1076";"      *"
"ICONSCPSCH";"S";"1077";"**"
"ICONSCPSCH";"S";"1078";"** Calcul maintien CP samedi"
"ICONSCPSCH";"S";"1079";"**"
"ICONSCPSCH";"S";"1080";"**"
"ICONSCPSCH";"S";"1081";"      SI PARD_IDINBRSAMD > 0"
"ICONSCPSCH";"S";"1082";"         SI HJOU_JOUR = ""6"""
"ICONSCPSCH";"S";"1083";"            POUR ACTIVITES"
"ICONSCPSCH";"S";"1084";"               SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"1085";"               OU HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"1086";"               OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCPSCH";"S";"1087";"                  SI HABS_VALORIS = ""J"""
"ICONSCPSCH";"S";"1088";"                     LOCA_NBCPSAM = LOCA_NBCPSAM + 1"
"ICONSCPSCH";"S";"1089";"                  FINSI"
"ICONSCPSCH";"S";"1090";"                  *"
"ICONSCPSCH";"S";"1091";"                  SI HABS_VALORIS = ""M"""
"ICONSCPSCH";"S";"1092";"                     LOCA_NBCPSAM = LOCA_NBCPSAM + 0.5"
"ICONSCPSCH";"S";"1093";"                  FINSI"
"ICONSCPSCH";"S";"1094";"                  *"
"ICONSCPSCH";"S";"1095";"                  SI HABS_VALORIS = ""A"""
"ICONSCPSCH";"S";"1096";"                     LOCA_NBCPSAM = LOCA_NBCPSAM + 0.5"
"ICONSCPSCH";"S";"1097";"                  FINSI"
"ICONSCPSCH";"S";"1098";"               FINSI"
"ICONSCPSCH";"S";"1099";"            FINPOUR"
"ICONSCPSCH";"S";"1100";"            *"
"ICONSCPSCH";"S";"1101";"            SI LOCA_NBCPSAM > 0"
"ICONSCPSCH";"S";"1102";"                SI LOCA_NBCPSAM > 1"
"ICONSCPSCH";"S";"1103";"                    LOCA_NBCPSAM = 1"
"ICONSCPSCH";"S";"1104";"                FINSI"
"ICONSCPSCH";"S";"1105";"                *"
"ICONSCPSCH";"S";"1106";"                HJOU_IJRNBCPSAM = HJOU_IJRNBCPSAM + LOCA_NBCPSAM"
"ICONSCPSCH";"S";"1107";"            FINSI"
"ICONSCPSCH";"S";"1108";"         FINSI"
"ICONSCPSCH";"S";"1109";"      FINSI"
"ICONSCPSCH";"S";"1110";"** Initialisation du compteur de samedi CP par consigne"
"ICONSCPSCH";"S";"1111";"      POUR ACTIVITES"
"ICONSCPSCH";"S";"1112";"         SI HABS_MOTIF = ""ZCPSAM"""
"ICONSCPSCH";"S";"1113";"            HJOU_IJRNBCPSAM = HABS_MOTINBR"
"ICONSCPSCH";"S";"1114";"         FINSI"
"ICONSCPSCH";"S";"1115";"         SI HABS_MOTIF = ""XCPSAM"""
"ICONSCPSCH";"S";"1116";"            HJOU_IJRNBCPSAM = HJOU_IJRNBCPSAM + HABS_MOTINBR"
"ICONSCPSCH";"S";"1117";"         FINSI"
"ICONSCPSCH";"S";"1118";"      FINPOUR"
"ICONSCPSCH";"S";"1119";"*** fin de calcul maintien CP samedi"
"ICONSCPSCH";"S";"1120";"   FINSI"
"ICONSCPSCH";"S";"1121";"**"
"ICONSCPSCH";"S";"1122";"** le 16/05/2011***************************************"
"ICONSCPSCH";"S";"1123";"* si la date <= date du jour"
"ICONSCPSCH";"S";"1124";"* dans le cas où le chainage est fait avec le même motif"
"ICONSCPSCH";"S";"1125";"* le motif reliquat et égal au motif CP"
"ICONSCPSCH";"S";"1126";"* Dans le cas où on a 2 motifs"
"ICONSCPSCH";"S";"1127";"* de type congés 1/2 journée, ils sont transformés en"
"ICONSCPSCH";"S";"1128";"* un motif de type  PARD_IDIVMCOPRI journée entière"
"ICONSCPSCH";"S";"1129";"*"
"ICONSCPSCH";"S";"1130";"* SI LOCA_FUTUR = 0"
"ICONSCPSCH";"S";"1131";"   LOCA_NBDEMI = 0"
"ICONSCPSCH";"S";"1132";"   POUR ACTIVITES"
"ICONSCPSCH";"S";"1133";"      SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"1134";"         SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"1135";"            SI HABS_VALORIS <> ""J"""
"ICONSCPSCH";"S";"1136";"               LOCA_NBDEMI = LOCA_NBDEMI + 1"
"ICONSCPSCH";"S";"1137";"            FINSI"
"ICONSCPSCH";"S";"1138";"         FINSI"
"ICONSCPSCH";"S";"1139";"      FINSI"
"ICONSCPSCH";"S";"1140";"   FINPOUR"
"ICONSCPSCH";"S";"1141";"   SI LOCA_NBDEMI = 2"
"ICONSCPSCH";"S";"1142";"* cela veut dire qu'on se trouve avec 2 motifs"
"ICONSCPSCH";"S";"1143";"* de type congés 1/2 journée"
"ICONSCPSCH";"S";"1144";"* c'est normal que l'on fasse 2 fois un enlever"
"ICONSCPSCH";"S";"1145";"* sur PACPANNU , c'est dans le cas où on se retouve avec un"
"ICONSCPSCH";"S";"1146";"* CP de type M et un CP de type A sur la même journée"
"ICONSCPSCH";"S";"1147";"      ENLEVER PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"1148";"      ENLEVER PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"1149";"      ENLEVER PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"1150";"      ENLEVER PARD_IDIVMCOANT"
"ICONSCPSCH";"S";"1151";"      * AJOUTER PARD_IDIVMCOPRI ""J"" PROF_ABSENJ"
"ICONSCPSCH";"S";"1152";"      AJOUTER PARD_IDIVMCOPRI ""J"" LOCA_DUREEJ"
"ICONSCPSCH";"S";"1153";"      LOCA_NBDEMI = 0"
"ICONSCPSCH";"S";"1154";"   FINSI"
"ICONSCPSCH";"S";"1155";"* FINSI"
"ICONSCPSCH";"S";"1156";"*Pour ajouter les cp sur jour non travaillé"
"ICONSCPSCH";"S";"1157";"   * Maintenir le CP lorqu'il y a un CP"
"ICONSCPSCH";"S";"1158";"   * suivi d'un motif maintenant les congés"
"ICONSCPSCH";"S";"1159";"   * suivi d'un jour de repos"
"ICONSCPSCH";"S";"1160";"   SI HJOU_IJRJRCONG <> 0"
"ICONSCPSCH";"S";"1161";"      *RAZ"
"ICONSCPSCH";"S";"1162";"      HJOU_IJRJRCONG = 0"
"ICONSCPSCH";"S";"1163";"   FINSI"
"ICONSCPSCH";"S";"1164";"    *Récupération si il y a un CP sur la journée"
"ICONSCPSCH";"S";"1165";"   POUR ACTIVITES"
"ICONSCPSCH";"S";"1166";"      * Maintien motif CP"
"ICONSCPSCH";"S";"1167";"      SI MOTI_IMICONTCPS = ""3"""
"ICONSCPSCH";"S";"1168";"* LOCA_VALID = MOTI_VALID"
"ICONSCPSCH";"S";"1169";"* Ouvrés"
"ICONSCPSCH";"S";"1170";"         LOCA_ACQUIS = HORC_IHIDRJTRAV + HORC_IHIDRNTRAV"
"ICONSCPSCH";"S";"1171";"         SI LOCA_ACQUIS = 2.08"
"ICONSCPSCH";"S";"1172";"            LOCA_JOUR = ""5"""
"ICONSCPSCH";"S";"1173";"         FINSI"
"ICONSCPSCH";"S";"1174";"* Ouvrables"
"ICONSCPSCH";"S";"1175";"         SI LOCA_ACQUIS = 2.50"
"ICONSCPSCH";"S";"1176";"            LOCA_JOUR = ""6"""
"ICONSCPSCH";"S";"1177";"         FINSI"
"ICONSCPSCH";"S";"1178";"* Uniquement jusqu'au dernier jour de la semaine"
"ICONSCPSCH";"S";"1179";"         SI HJOU_JOUR < LOCA_JOUR"
"ICONSCPSCH";"S";"1180";"            SI HABS_VALORIS = ""J"""
"ICONSCPSCH";"S";"1181";"               SI PROF_ABSENS <> 0"
"ICONSCPSCH";"S";"1182";"                  HJOU_IJRJRCONG = 1"
"ICONSCPSCH";"S";"1183";"               SINON"
"ICONSCPSCH";"S";"1184";"* Cas où une personne ne travaille que le matin"
"ICONSCPSCH";"S";"1185";"                  SI PROF_ABSENJ = PROF_ABSENM"
"ICONSCPSCH";"S";"1186";"                     HJOU_IJRJRCONG = 1"
"ICONSCPSCH";"S";"1187";"                  SINON"
"ICONSCPSCH";"S";"1188";"                     SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPSCH";"S";"1189";"                        HJOU_IJRJRCONG = 0"
"ICONSCPSCH";"S";"1190";"                     SINON"
"ICONSCPSCH";"S";"1191";"                        HJOU_IJRJRCONG = 1"
"ICONSCPSCH";"S";"1192";"                     FINSI"
"ICONSCPSCH";"S";"1193";"                  FINSI"
"ICONSCPSCH";"S";"1194";"               FINSI"
"ICONSCPSCH";"S";"1195";"            SINON"
"ICONSCPSCH";"S";"1196";"               SI HABS_VALORIS = ""A"""
"ICONSCPSCH";"S";"1197";"                  HJOU_IJRJRCONG = 1"
"ICONSCPSCH";"S";"1198";"               SINON"
"ICONSCPSCH";"S";"1199";"                  SI HABS_VALORIS = ""M"""
"ICONSCPSCH";"S";"1200";"                     HJOU_IJRJRCONG = 0"
"ICONSCPSCH";"S";"1201";"                  FINSI"
"ICONSCPSCH";"S";"1202";"               FINSI"
"ICONSCPSCH";"S";"1203";"            FINSI"
"ICONSCPSCH";"S";"1204";"         FINSI"
"ICONSCPSCH";"S";"1205";"      FINSI"
"ICONSCPSCH";"S";"1206";"   FINPOUR"
"ICONSCPSCH";"S";"1207";"* FINSI"
"ICONSCPSCH";"S";"1208";"FINSI"
"ICONSCPSCH";"S";"1209";"FIN"
