"IABSGAEV";"S";"0035";"* DEBANO"
"IABSGAEV";"S";"0036";"*"
"IABSGAEV";"S";"0037";"* FINANO"
"IABSGAEV";"S";"0038";"*"
"IABSGAEV";"S";"0039";"* Définition des variables locales"
