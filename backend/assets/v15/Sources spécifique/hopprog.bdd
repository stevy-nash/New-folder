"SHBONIF";"S";"0027";"*"
"SHBONIF";"S";"0028";"* Implémentation des données industrielles"
"SHBONIF";"S";"0029";"*"
"SHBONIF";"S";"0030";"DEBDICO"
"SHBONIF";"S";"0031";"   HJOU_SJQHBONIF;N;T6,2;I;;;     6789;;;V3;""Heures de Bonification (JL)"";"
"SHBONIF";"S";"0032";"   CTRA_SCIBONIF;O;A1;X;;;123456789;L;;C2;""Droit à la Bonification"";"
"SHBONIF";"S";"0033";"   PARD_SDIHBONIF;O;T6,2;I;;;      789;;;C3;""Heures de bonification (JL)"";"
"SHBONIF";"S";"0034";"   HJOU_SJRABPBOH;N;N6,1;I;;;     6789;;SJRABPBOH;V3;""Absence pénalisant la bonif. hebdo"";"
"SHBONIF";"S";"0035";"   MOTI_SMIABPBON;O;Z1;X;;;    56789;L1;;C3;""Pénalise acquis. Hrs bonificaiton"";"
"SHBONIF";"S";"0036";"   *"
"SHBONIF";"S";"0037";"   HJOU_IJRCJDISP6;N;N6,2;L;;;    56789;;IJRCJDISP6;V3;""Presence calendaire hebdo"";"
"SHBONIF";"S";"0038";"FINDICO"
"SHBONIF";"S";"0039";"*"
"SHBONIF";"S";"0040";"* Déclaration des donnees locales"
"SHBONIF";"S";"0041";"*"
"SHBONIF";"S";"0042";"DEF LOCA_DROIT N2"
"SHBONIF";"S";"0043";"LOCA_DROIT = 0"
"SHBONIF";"S";"0044";"DEF LOCA_HBONIF T6.2"
"SHBONIF";"S";"0045";"LOCA_HBONIF = 0"
"SHBONIF";"S";"0046";"DEF LOCA_ABSP N4.1"
"SHBONIF";"S";"0047";"LOCA_ABSP = 0"
"SHBONIF";"S";"0048";"DEF LOCA_TP N2"
"SHBONIF";"S";"0049";"LOCA_TP = 0"
"SHBONIF";"S";"0050";"DEF LOCA_JOUR N6"
"SHBONIF";"S";"0051";"*"
"SHBONIF";"S";"0052";"SI HJOU_IJITYPCTRA < 100"
"SHBONIF";"S";"0053";"   SI HJOU_IJITYPCTRA > 0"
"SHBONIF";"S";"0054";"      LOCA_TP = 1"
"SHBONIF";"S";"0055";"   FINSI"
"SHBONIF";"S";"0056";"FINSI"
"SHBONIF";"S";"0057";"*"
"SHBONIF";"S";"0058";"* JJA - 18/09/2025 - FFT025006121 : Vérif si entrée en cours de semaine >>"
"SHBONIF";"S";"0059";"SI HJOU_JOUR = ""1"""
"SHBONIF";"S";"0060";"   HJOU_IJRCJDISP6 = 0"
"SHBONIF";"S";"0061";"FINSI"
"SHBONIF";"S";"0062";"*"
"SHBONIF";"S";"0063";"HJOU_IJRCJDISP6 = HJOU_IJRCJDISP6 + 1"
"SHBONIF";"S";"0064";"*"
"SHBONIF";"S";"0065";"* JJA - 18/09/2025 <<"
"SHBONIF";"S";"0066";"*"
"SHBONIF";"S";"0067";"* Journaliste ?"
"SHBONIF";"S";"0068";"SI HJOU_SJQCATEGOR = ""J"""
"SHBONIF";"S";"0069";"* Exclu forfait jour"
"SHBONIF";"S";"0070";"   SI HJOU_SJQFORFJR <> ""1"""
"SHBONIF";"S";"0071";"* Droit à la bonif ?"
"SHBONIF";"S";"0072";"      SI CTRA_SCIBONIF = ""1"""
"SHBONIF";"S";"0073";"* Exclu les temps partiels"
"SHBONIF";"S";"0074";"         SI LOCA_TP <> 1"
"SHBONIF";"S";"0075";"* Différant de stagiaire"
"SHBONIF";"S";"0076";"*            SI CTRA_TYPCTRA <> ""STG"""
"SHBONIF";"S";"0077";"* Différant apprenti"
"SHBONIF";"S";"0078";"*               SI CTRA_TYPCTRA <> ""CAP"""
"SHBONIF";"S";"0079";"            SI HJOU_IJRCJDISP6 = 7"
"SHBONIF";"S";"0080";"               LOCA_DROIT = 1"
"SHBONIF";"S";"0081";"               LOCA_HBONIF = PARD_SDIHBONIF"
"SHBONIF";"S";"0082";"            FINSI"
"SHBONIF";"S";"0083";"*               FINSI"
"SHBONIF";"S";"0084";"*            FINSI"
"SHBONIF";"S";"0085";"         FINSI"
"SHBONIF";"S";"0086";"      FINSI"
"SHBONIF";"S";"0087";"   FINSI"
"SHBONIF";"S";"0088";"FINSI"
"SHBONIF";"S";"0089";"*"
"SHBONIF";"S";"0090";"* RAZ hebdo"
"SHBONIF";"S";"0091";"SI HJOU_JOUR = ""1"""
"SHBONIF";"S";"0092";"   HJOU_SJRABPBOH = 0"
"SHBONIF";"S";"0093";"FINSI"
"SHBONIF";"S";"0094";"*"
"SHBONIF";"S";"0095";"* Comptabilise le nombre absence pénalisant la bonification"
"SHBONIF";"S";"0096";"POUR ACTIVITES"
"SHBONIF";"S";"0097";"   SI HABS_MOTYPE <> ""C"""
"SHBONIF";"S";"0098";"      SI MOTI_SMIABPBON = ""1"""
"SHBONIF";"S";"0099";"         SI HJOU_IJQPRETHEJ > 0"
"SHBONIF";"S";"0100";"            SI HABS_VALORIS = ""J"""
"SHBONIF";"S";"0101";"               SI PROF_ABSENM = 0"
"SHBONIF";"S";"0102";"               OU PROF_ABSENS = 0"
"SHBONIF";"S";"0103";"                  LOCA_ABSP = LOCA_ABSP + 0.5"
"SHBONIF";"S";"0104";"               SINON"
"SHBONIF";"S";"0105";"                  LOCA_ABSP = LOCA_ABSP + 1"
"SHBONIF";"S";"0106";"               FINSI"
"SHBONIF";"S";"0107";"            SINON"
"SHBONIF";"S";"0108";"               LOCA_ABSP = LOCA_ABSP + 0.5"
"SHBONIF";"S";"0109";"            FINSI"
"SHBONIF";"S";"0110";"         FINSI"
"SHBONIF";"S";"0111";"      FINSI"
"SHBONIF";"S";"0112";"   FINSI"
"SHBONIF";"S";"0113";"FINPOUR"
"SHBONIF";"S";"0114";"*"
"SHBONIF";"S";"0115";"SI LOCA_ABSP > 1"
"SHBONIF";"S";"0116";"   LOCA_ABSP = 1"
"SHBONIF";"S";"0117";"FINSI"
"SHBONIF";"S";"0118";"*"
"SHBONIF";"S";"0119";"HJOU_SJRABPBOH = HJOU_SJRABPBOH + LOCA_ABSP"
"SHBONIF";"S";"0120";"*"
"SHBONIF";"S";"0121";"* Acquisition le dimanche >>"
"SHBONIF";"S";"0122";"SI HJOU_JOUR = ""7"""
"SHBONIF";"S";"0123";"   SI LOCA_DROIT = 1"
"SHBONIF";"S";"0124";"      SI HJOU_SJRABPBOH = 0"
"SHBONIF";"S";"0125";"         HJOU_SJQHBONIF = LOCA_HBONIF"
"SHBONIF";"S";"0126";"      FINSI"
"SHBONIF";"S";"0127";"   FINSI"
"SHBONIF";"S";"0128";"FINSI"
"SHBONIF";"S";"0129";"*"
"SHBONIF";"S";"0130";"* MAJ et Init par consigne"
"SHBONIF";"S";"0131";"POUR ACTIVITES"
"SHBONIF";"S";"0132";"   SI HABS_MOTIF = ""XHBONIF"""
"SHBONIF";"S";"0133";"      HJOU_SJQHBONIF = HJOU_SJQHBONIF + HABS_MOTIDUR"
"SHBONIF";"S";"0134";"   FINSI"
"SHBONIF";"S";"0135";"   SI HABS_MOTIF = ""ZHBONIF"""
"SHBONIF";"S";"0136";"      HJOU_SJQHBONIF = HABS_MOTIDUR"
"SHBONIF";"S";"0137";"   FINSI"
"SHBONIF";"S";"0138";"FINPOUR"
"SHBONIF";"S";"0139";"*"
"SHBONIF";"S";"0140";"FIN"
