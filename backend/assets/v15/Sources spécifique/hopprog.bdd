"SROLE";"S";"0057";"         SI CTRA_SCIFORFJ = ""1"""
"SROLE";"S";"0058";"            SI EMPL_HORSECT(1:3) = ""RED"""
"SROLE";"S";"0059";"            OU EMPL_HORSECT(1:3) = ""TVR"""
"SROLE";"S";"0060";"               EMPL_SEQROLEC = ""MANAREDACF"""
"SROLE";"S";"0061";"               LOCA_ROLE = 1"
"SROLE";"S";"0062";"            FINSI"
"SROLE";"S";"0063";"         FINSI"
"SROLE";"S";"0064";"      FINSI"
"SROLE";"S";"0065";"   FINSI"
