"SDRCP";"S";"0063";"   HJOU_SJQDRCPAN;O;N6,1;I;;;      789;;;V3;""Droit CP annuel"";"
"SDRCP";"S";"0064";"   HJOU_SJIDRCPAN;O;N6,1;I;;;      789;;;C2;""Droit CP annuel forcé"";"
