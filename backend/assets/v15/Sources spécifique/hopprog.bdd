"SACQCSUP";"S";"0052";"DEF LOCA_DRFJ N2"
"SACQCSUP";"S";"0053";"LOCA_DRFJ = 0"
"SACQCSUP";"S";"0054";"DEF LOCA_DRFAB N2"
"SACQCSUP";"S";"0055";"LOCA_DRFAB = 0"
"SACQCSUP";"S";"0056";"*"
"SACQCSUP";"S";"0057";"DEF LOCA_ANCJ N4"
"SACQCSUP";"S";"0058";"LOCA_ANCJ = 0"
"SACQCSUP";"S";"0059";"DEF LOCA_ANCA N4"
"SACQCSUP";"S";"0060";"LOCA_ANCA = 0"
"SACQCSUP";"S";"0061";"DEF LOCA_AGE N4"
"SACQCSUP";"S";"0062";"LOCA_AGE = 0"
"SACQCSUP";"S";"0063";"*"
"SACQCSUP";"S";"0064";"SI CONF_ITIVMREFCP <> "" """
"SACQCSUP";"S";"0065";"* Calcul de la date de référence CP"
"SACQCSUP";"S";"0066";"* stockage de l'année du jour de l'historique"
"SACQCSUP";"S";"0067";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"SACQCSUP";"S";"0068";"* stockage du mois de reference"
"SACQCSUP";"S";"0069";"   LOCA_REF << CONF_ITIVMREFCP(3:2)"
"SACQCSUP";"S";"0070";"* stokage du mois de reference"
"SACQCSUP";"S";"0071";"   LOCA_DATE(5:2) << LOCA_REF"
"SACQCSUP";"S";"0072";"* stockage du jour de reference"
"SACQCSUP";"S";"0073";"   LOCA_REF << CONF_ITIVMREFCP(1:2)"
"SACQCSUP";"S";"0074";"* loca_date contient maintenant l'année du jour de l'historique"
"SACQCSUP";"S";"0075";"* et le mois et le jour de reference"
"SACQCSUP";"S";"0076";"   LOCA_DATE(7:2) << LOCA_REF"
"SACQCSUP";"S";"0077";"SINON"
"SACQCSUP";"S";"0078";"   LOCA_DATE = "" """
"SACQCSUP";"S";"0079";"FINSI"
"SACQCSUP";"S";"0080";"*"
"SACQCSUP";"S";"0081";"* Définition si droit au CSUP pour cadre au forfait jour ?"
"SACQCSUP";"S";"0082";"SI HJOU_SJQFORFJR = ""1"""
"SACQCSUP";"S";"0083";"   SI HJOU_SJQSOCIETE = ""MO"""
"SACQCSUP";"S";"0084";"   OU HJOU_SJQSOCIETE = ""PC"""
"SACQCSUP";"S";"0085";"   OU HJOU_SJQSOCIETE = ""YR"""
"SACQCSUP";"S";"0086";"*======================================================*"
"SACQCSUP";"S";"0087";"***Ajout HL VBN le 04/02/2026  :: PBR026004755"
"SACQCSUP";"S";"0088";"      SI HJOU_DATE < ""01012026"""
"SACQCSUP";"S";"0089";"         SI HJOU_SJQCATEGOR <> ""AM"""
"SACQCSUP";"S";"0090";"            LOCA_DRFJ = 1"
"SACQCSUP";"S";"0091";"         FINSI"
"SACQCSUP";"S";"0092";"      SINON"
"SACQCSUP";"S";"0093";"         SI HJOU_SJQCATEGOR = ""C"""
"SACQCSUP";"S";"0094";"         OU HJOU_SJQCATEGOR = ""D"""
"SACQCSUP";"S";"0095";"            LOCA_DRFJ = 1"
"SACQCSUP";"S";"0096";"         FINSI"
"SACQCSUP";"S";"0097";"      FINSI"
"SACQCSUP";"S";"0098";"*======================================================*"
"SACQCSUP";"S";"0099";"   FINSI"
"SACQCSUP";"S";"0100";"FINSI"
"SACQCSUP";"S";"0101";"*"
"SACQCSUP";"S";"0102";"* Définition si droit au CSUP pour la fabircation ?"
"SACQCSUP";"S";"0103";"SI HJOU_SJQSOCIETE = ""MO"""
"SACQCSUP";"S";"0104";"OU HJOU_SJQSOCIETE = ""YR"""
"SACQCSUP";"S";"0105";"* Garde fou - uniquement pour la direction industrielle"
"SACQCSUP";"S";"0106";"   SI HJOU_SECTORI(1:3) = ""DIN"""
"SACQCSUP";"S";"0107";"      SI SECH_SSICSUPF = ""1"""
"SACQCSUP";"S";"0108";"         LOCA_DRFAB = 1"
"SACQCSUP";"S";"0109";"      FINSI"
"SACQCSUP";"S";"0110";"   FINSI"
"SACQCSUP";"S";"0111";"FINSI"
"SACQCSUP";"S";"0112";"*"
"SACQCSUP";"S";"0113";"*"
"SACQCSUP";"S";"0114";"* Calcul de l'acquisition au 01/01/N"
"SACQCSUP";"S";"0115";"SI HJOU_DATE(5:4) = ""0101"""
"SACQCSUP";"S";"0116";"*"
"SACQCSUP";"S";"0117";"   SI LOCA_DRFJ = 1"
"SACQCSUP";"S";"0118";"   OU LOCA_DRFAB = 1"
"SACQCSUP";"S";"0119";"*"
"SACQCSUP";"S";"0120";"* Cacul de l'ancienneté"
"SACQCSUP";"S";"0121";"      SI EMPS_E2DATEANC <> "" """
"SACQCSUP";"S";"0122";"         DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"SACQCSUP";"S";"0123";"         LOCA_ANCJ = TEMP_NXJOUR"
"SACQCSUP";"S";"0124";"         LOCA_ANCA = TEMP_NXANNEE"
"SACQCSUP";"S";"0125";"      FINSI"
"SACQCSUP";"S";"0126";"*"
"SACQCSUP";"S";"0127";"* Calcul de l'age"
"SACQCSUP";"S";"0128";"      SI EMPS_E2DATENAI <> "" """
"SACQCSUP";"S";"0129";"         DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"SACQCSUP";"S";"0130";"         LOCA_AGE = TEMP_NXANNEE"
"SACQCSUP";"S";"0131";"      FINSI"
"SACQCSUP";"S";"0132";"*"
"SACQCSUP";"S";"0133";"* Si droit au CSUP FJ >>"
"SACQCSUP";"S";"0134";"      SI LOCA_DRFJ = 1"
"SACQCSUP";"S";"0135";"* Ancienneté > 10 ans"
"SACQCSUP";"S";"0136";"         SI LOCA_ANCA >= 10"
"SACQCSUP";"S";"0137";"            SI LOCA_AGE >= 55"
"SACQCSUP";"S";"0138";"               HJOU_SJRACQSUPF = 5"
"SACQCSUP";"S";"0139";"            SINON"
"SACQCSUP";"S";"0140";"               HJOU_SJRACQSUPF = 4"
"SACQCSUP";"S";"0141";"            FINSI"
"SACQCSUP";"S";"0142";"         FINSI"
"SACQCSUP";"S";"0143";"      FINSI"
"SACQCSUP";"S";"0144";"*"
"SACQCSUP";"S";"0145";"* Si droit au CSUP Fabrication >>"
"SACQCSUP";"S";"0146";"      SI LOCA_DRFAB = 1"
"SACQCSUP";"S";"0147";"* Entre 50ans et 55ans"
"SACQCSUP";"S";"0148";"         SI LOCA_AGE >= 50"
"SACQCSUP";"S";"0149";"            SI LOCA_AGE < 55"
"SACQCSUP";"S";"0150";"               HJOU_SJRACQSUPI = 2"
"SACQCSUP";"S";"0151";"            FINSI"
"SACQCSUP";"S";"0152";"         FINSI"
"SACQCSUP";"S";"0153";"* Après 55 ans"
"SACQCSUP";"S";"0154";"         SI LOCA_AGE >= 55"
"SACQCSUP";"S";"0155";"            HJOU_SJRACQSUPI = 3"
"SACQCSUP";"S";"0156";"         FINSI"
"SACQCSUP";"S";"0157";"      FINSI"
"SACQCSUP";"S";"0158";"*"
"SACQCSUP";"S";"0159";"*"
"SACQCSUP";"S";"0160";"   SINON"
"SACQCSUP";"S";"0161";"      HJOU_SJRACQSUPF = 0"
"SACQCSUP";"S";"0162";"      HJOU_SJRACQSUPI = 0"
"SACQCSUP";"S";"0163";"* Droit ?"
"SACQCSUP";"S";"0164";"   FINSI"
"SACQCSUP";"S";"0165";"* Date acquis ?"
"SACQCSUP";"S";"0166";"FINSI"
"SACQCSUP";"S";"0167";"*"
"SACQCSUP";"S";"0168";"* Acquisition C. supplémentaire >>"
"SACQCSUP";"S";"0169";"*"
"SACQCSUP";"S";"0170";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SACQCSUP";"S";"0171";"*"
"SACQCSUP";"S";"0172";"*======================================================*"
"SACQCSUP";"S";"0173";"****Ajout HL VBN le 04/02/2026  :: PBR026004755"
"SACQCSUP";"S";"0174";"   SI HJOU_DATE < ""01012026"""
"SACQCSUP";"S";"0175";"* Calcul acquisition"
"SACQCSUP";"S";"0176";"      SI HJOU_DATE > CONF_SDIDATDEM"
"SACQCSUP";"S";"0177";"         HJOU_SJRDCSUP = HJOU_SJRACQSUPF + HJOU_SJRACQSUPI"
"SACQCSUP";"S";"0178";"      SINON"
"SACQCSUP";"S";"0179";"         HJOU_SJRDCSUP = 0"
"SACQCSUP";"S";"0180";"      FINSI"
"SACQCSUP";"S";"0181";"   FINSI"
"SACQCSUP";"S";"0182";"*======================================================*"
"SACQCSUP";"S";"0183";"* RAZ du pris"
"SACQCSUP";"S";"0184";"   HJOU_SJRCCSUP = 0"
"SACQCSUP";"S";"0185";"* Solde >>"
"SACQCSUP";"S";"0186";"   HJOU_SJRSCSUP = HJOU_SJRDCSUP - HJOU_SJRCCSUP"
"SACQCSUP";"S";"0187";"FINSI"
"SACQCSUP";"S";"0188";"*"
"SACQCSUP";"S";"0189";"* Maj et Init par consignes >>"
"SACQCSUP";"S";"0190";"POUR ACTIVITES"
"SACQCSUP";"S";"0191";"   SI HABS_MOTIF = ""XDCSUP"""
"SACQCSUP";"S";"0192";"      HJOU_SJRDCSUP = HJOU_SJRDCSUP + HABS_MOTINBR"
"SACQCSUP";"S";"0193";"   FINSI"
"SACQCSUP";"S";"0194";"   SI HABS_MOTIF = ""ZDCSUP"""
"SACQCSUP";"S";"0195";"      HJOU_SJRDCSUP = HABS_MOTINBR"
"SACQCSUP";"S";"0196";"   FINSI"
"SACQCSUP";"S";"0197";"FINPOUR"
"SACQCSUP";"S";"0198";"*"
"SACQCSUP";"S";"0199";"* Solde"
"SACQCSUP";"S";"0200";"HJOU_SJRSCSUP = HJOU_SJRDCSUP - HJOU_SJRCCSUP"
"SACQCSUP";"S";"0201";"*"
"SACQCSUP";"S";"0202";"FIN"
