"IGRTTJ";"S";"0248";"         SI HABS_MOTIF = ""XARTJ"""
"IGRTTJ";"S";"0249";"            LOCA_MOT = 1"
"IGRTTJ";"S";"0250";"            HJOU_IJRACRTTJM = HJOU_IJRACRTTJM + HABS_MOTINBR"
"IGRTTJ";"S";"0251";"*"
"IGRTTJ";"S";"0252";"* arrondi de l'acquis a l'entier supérieur"
"IGRTTJ";"S";"0253";"            LOCA_REST = HJOU_IJRACRTTJM % 1"
"IGRTTJ";"S";"0254";"            LOCA_ENTIER = HJOU_IJRACRTTJM - LOCA_REST"
"IGRTTJ";"S";"0255";"            SI LOCA_REST > 0"
"IGRTTJ";"S";"0256";"               LOCA_ENTIER = LOCA_ENTIER + 1"
"IGRTTJ";"S";"0257";"            FINSI"
