"SSTC";"S";"0040";"* Paiement RTT"
"SSTC";"S";"0041";"ENLEVER ""Y830"""
"SSTC";"S";"0042";"ENLEVER ""Y830"""
"SSTC";"S";"0043";"* Paiement CET"
"SSTC";"S";"0044";"ENLEVER ""7141"""
"SSTC";"S";"0045";"ENLEVER ""7141"""
"SSTC";"S";"0046";"* Paiement CPR P1"
"SSTC";"S";"0047";"ENLEVER ""YO63"""
"SSTC";"S";"0048";"ENLEVER ""YO63"""
"SSTC";"S";"0049";"* Paiement CPR P2"
"SSTC";"S";"0050";"ENLEVER ""YO64"""
"SSTC";"S";"0051";"ENLEVER ""YO64"""
