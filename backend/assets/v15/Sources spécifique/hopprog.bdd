"SCPTBASE";"S";"0232";"FINPOUR"
"SCPTBASE";"S";"0233";"*"
"SCPTBASE";"S";"0234";"**** Ajout des heures en plus"
"SCPTBASE";"S";"0235";"*"
"SCPTBASE";"S";"0236";"POUR ACTIVITES"
"SCPTBASE";"S";"0237";"*"
"SCPTBASE";"S";"0238";"   SI MOTI_MOTYPE <> ""C"""
"SCPTBASE";"S";"0239";"      SI MOTI_IMIGTTEFFE = ""1"""
"SCPTBASE";"S";"0240";"         SI HABS_VALORIS = ""H"""
"SCPTBASE";"S";"0241";"            SI HABS_HRAFIN > 0"
"SCPTBASE";"S";"0242";"               SI HABS_HRAFIN <> LOCA_NULL"
"SCPTBASE";"S";"0243";"                  LOCA_HF = HABS_HRAFIN"
"SCPTBASE";"S";"0244";"                  LOCA_HD = HABS_HRADEB"
"SCPTBASE";"S";"0245";"* Si pas de plage"
"SCPTBASE";"S";"0246";"                  SI HJOU_IJQMVTENT1 = HJOU_IJQMVTSOR1"
"SCPTBASE";"S";"0247";"* Exception pour la formation et type présence"
"SCPTBASE";"S";"0248";"*                     SI HABS_MOTIF <> ""FOR"""
"SCPTBASE";"S";"0249";"                     SI HABS_MOTYPE <> ""P"""
"SCPTBASE";"S";"0250";"                        FAIRE SPL"
"SCPTBASE";"S";"0251";"                     SINON"
"SCPTBASE";"S";"0252";"* Si repos et pas formation"
