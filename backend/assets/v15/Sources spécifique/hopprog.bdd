"IPIXID";"S";"0036";"   *   CONF_IGICLIPIX;O;A30;X;;;789;;;C3;REFERENCE CLIENT PIXID;"
"IPIXID";"S";"0037";"   *   HJOU_IJIPIXID;O;Z1;X;;;789;L;;C0;FILTRE JOUR EXPORT IXID;"
