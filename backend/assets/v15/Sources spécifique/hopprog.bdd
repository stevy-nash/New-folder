"SCONSCPCH";"S";"1458";"*"
"SCONSCPCH";"S";"1459";"PROC CONSOP1"
"SCONSCPCH";"S";"1460";"   SI HJOU_SJRSPREP1 >= LOCA_VAL"
"SCONSCPCH";"S";"1461";"      HJOU_SJRCPREP1 = HJOU_SJRCPREP1 + LOCA_VAL"
"SCONSCPCH";"S";"1462";"      HJOU_SJRSPREP1 = HJOU_SJRSPREP1 - LOCA_VAL"
"SCONSCPCH";"S";"1463";"      LOCA_CPR1 = LOCA_VAL"
"SCONSCPCH";"S";"1464";"      LOCA_VAL = 0"
"SCONSCPCH";"S";"1465";"   SINON"
"SCONSCPCH";"S";"1466";"      SI HJOU_SJRSPREP1 > 0"
"SCONSCPCH";"S";"1467";"         LOCA_VAL = LOCA_VAL - HJOU_SJRSPREP1"
"SCONSCPCH";"S";"1468";"         HJOU_SJRCPREP1 = HJOU_SJRCPREP1 + HJOU_SJRSPREP1"
"SCONSCPCH";"S";"1469";"         LOCA_CPR1 = HJOU_SJRSPREP1"
"SCONSCPCH";"S";"1470";"         HJOU_SJRSPREP1 = 0"
"SCONSCPCH";"S";"1471";"      FINSI"
"SCONSCPCH";"S";"1472";"   FINSI"
"SCONSCPCH";"S";"1473";"FINPROC"
"SCONSCPCH";"S";"1474";"*"
"SCONSCPCH";"S";"1475";"PROC CONSOP2"
"SCONSCPCH";"S";"1476";"   SI HJOU_SJRSPREP2 >= LOCA_VAL"
"SCONSCPCH";"S";"1477";"      HJOU_SJRCPREP2 = HJOU_SJRCPREP2 + LOCA_VAL"
"SCONSCPCH";"S";"1478";"      HJOU_SJRSPREP2 = HJOU_SJRSPREP2 - LOCA_VAL"
"SCONSCPCH";"S";"1479";"      LOCA_CPR2 = LOCA_VAL"
"SCONSCPCH";"S";"1480";"      LOCA_VAL = 0"
"SCONSCPCH";"S";"1481";"   SINON"
"SCONSCPCH";"S";"1482";"      SI HJOU_SJRSPREP2 > 0"
"SCONSCPCH";"S";"1483";"         LOCA_VAL = LOCA_VAL - HJOU_SJRSPREP2"
"SCONSCPCH";"S";"1484";"         HJOU_SJRCPREP2 = HJOU_SJRCPREP2 + HJOU_SJRSPREP2"
"SCONSCPCH";"S";"1485";"         LOCA_CPR2 = HJOU_SJRSPREP2"
"SCONSCPCH";"S";"1486";"         HJOU_SJRSPREP2 = 0"
"SCONSCPCH";"S";"1487";"      FINSI"
"SCONSCPCH";"S";"1488";"   FINSI"
"SCONSCPCH";"S";"1489";"FINPROC"
"SCONSCPCH";"S";"1490";"*"
"SCONSCPCH";"S";"1491";"PROC CONSOP3"
"SCONSCPCH";"S";"1492";"   SI HJOU_SJRSPREP3 >= LOCA_VAL"
"SCONSCPCH";"S";"1493";"      HJOU_SJRCPREP3 = HJOU_SJRCPREP3 + LOCA_VAL"
"SCONSCPCH";"S";"1494";"      HJOU_SJRSPREP3 = HJOU_SJRSPREP3 - LOCA_VAL"
"SCONSCPCH";"S";"1495";"      LOCA_CPR3 = LOCA_VAL"
"SCONSCPCH";"S";"1496";"      LOCA_VAL = 0"
"SCONSCPCH";"S";"1497";"   SINON"
"SCONSCPCH";"S";"1498";"      SI HJOU_SJRSPREP1 > 0"
"SCONSCPCH";"S";"1499";"         LOCA_VAL = LOCA_VAL - HJOU_SJRSPREP3"
"SCONSCPCH";"S";"1500";"         HJOU_SJRCPREP3 = HJOU_SJRCPREP3 + HJOU_SJRSPREP3"
"SCONSCPCH";"S";"1501";"         LOCA_CPR3 = HJOU_SJRSPREP3"
"SCONSCPCH";"S";"1502";"         HJOU_SJRSPREP3 = 0"
"SCONSCPCH";"S";"1503";"      FINSI"
"SCONSCPCH";"S";"1504";"   FINSI"
"SCONSCPCH";"S";"1505";"FINPROC"
"SCONSCPCH";"S";"1506";"*"
"SCONSCPCH";"S";"1507";"PROC CONSOP4"
"SCONSCPCH";"S";"1508";"   SI HJOU_SJRSPREP4 >= LOCA_VAL"
"SCONSCPCH";"S";"1509";"      HJOU_SJRCPREP4 = HJOU_SJRCPREP4 + LOCA_VAL"
"SCONSCPCH";"S";"1510";"      HJOU_SJRSPREP4 = HJOU_SJRSPREP4 - LOCA_VAL"
"SCONSCPCH";"S";"1511";"      LOCA_CPR4 = LOCA_VAL"
"SCONSCPCH";"S";"1512";"      LOCA_VAL = 0"
"SCONSCPCH";"S";"1513";"   SINON"
"SCONSCPCH";"S";"1514";"      SI HJOU_SJRSPREP4 > 0"
"SCONSCPCH";"S";"1515";"         LOCA_VAL = LOCA_VAL - HJOU_SJRSPREP4"
"SCONSCPCH";"S";"1516";"         HJOU_SJRCPREP4 = HJOU_SJRCPREP4 + HJOU_SJRSPREP4"
"SCONSCPCH";"S";"1517";"         LOCA_CPR4 = HJOU_SJRSPREP4"
"SCONSCPCH";"S";"1518";"         HJOU_SJRSPREP4 = 0"
"SCONSCPCH";"S";"1519";"      FINSI"
"SCONSCPCH";"S";"1520";"   FINSI"
"SCONSCPCH";"S";"1521";"FINPROC"
