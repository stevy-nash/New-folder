"ITPSACTHT7";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTHT7";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTHT7";"S";"0062";"                * d'activité à justifier"
"ITPSACTHT7";"S";"0063";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTHT7";"S";"0064";"                SI HJOU_SECTAFF <> "" """
"ITPSACTHT7";"S";"0065";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTHT7";"S";"0066";"                SINON"
"ITPSACTHT7";"S";"0067";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTHT7";"S";"0068";"                FINSI"
"ITPSACTHT7";"S";"0069";"                *"
"ITPSACTHT7";"S";"0070";"                SI PRES_MODE_TRV = "" """
"ITPSACTHT7";"S";"0071";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT7";"S";"0072";"                FINSI"
"ITPSACTHT7";"S";"0073";"                *"
"ITPSACTHT7";"S";"0074";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT7";"S";"0075";"                *"
"ITPSACTHT7";"S";"0076";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT7";"S";"0077";"                *                              (A décommenter si besoin)"
"ITPSACTHT7";"S";"0078";"                *"
"ITPSACTHT7";"S";"0079";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT7";"S";"0080";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT7";"S";"0081";"                * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT7";"S";"0082";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT7";"S";"0083";"                *"
"ITPSACTHT7";"S";"0084";"                * SI HJOU_IJRTTREFFM <> 0"
"ITPSACTHT7";"S";"0085";"                    PRES_TPS_PRES = HJOU_IJRTTREFFM"
"ITPSACTHT7";"S";"0086";"                * SINON"
"ITPSACTHT7";"S";"0087";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTHT7";"S";"0088";"                * FINSI"
"ITPSACTHT7";"S";"0089";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT7";"S";"0090";"                *"
"ITPSACTHT7";"S";"0091";"                PRES_TPS_IMPUTE = 0"
"ITPSACTHT7";"S";"0092";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTHT7";"S";"0093";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTHT7";"S";"0094";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHT7";"S";"0095";"                    POUR EVENEMENTS"
"ITPSACTHT7";"S";"0096";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT7";"S";"0097";"                    FINPOUR"
"ITPSACTHT7";"S";"0098";"                FINSI"
"ITPSACTHT7";"S";"0099";"                * Calcul de l'écart"
"ITPSACTHT7";"S";"0100";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT7";"S";"0101";"            FINSI"
"ITPSACTHT7";"S";"0102";"        FINSI"
"ITPSACTHT7";"S";"0103";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT7";"S";"0104";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT7";"S";"0105";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT7";"S";"0106";"        FINSI"
"ITPSACTHT7";"S";"0107";"    FINSI"
"ITPSACTHT7";"S";"0108";"FINSI"
"ITPSACTHT7";"S";"0109";"*"
"ITPSACTHT7";"S";"0110";"FIN"
