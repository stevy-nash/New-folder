"ICONGSUPM";"S";"0012";"*----------------------------------------------------------------------"
"ICONGSUPM";"S";"0013";"*"
"ICONGSUPM";"S";"0014";"*"
"ICONGSUPM";"S";"0015";"* Rôle : Gestion du congé supplémentaire lié à l'âge pour MULTI-SITES"
"ICONGSUPM";"S";"0016";"*"
"ICONGSUPM";"S";"0017";"*"
"ICONGSUPM";"S";"0018";"*----------------------------------------------------------------------"
"ICONGSUPM";"S";"0019";"*"
"ICONGSUPM";"S";"0020";"* Modifiée par : Cellule Industrialisation"
"ICONGSUPM";"S";"0021";"* Date         : JJ/MM/AAAA"
"ICONGSUPM";"S";"0022";"* Objet        :"
"ICONGSUPM";"S";"0023";"*"
"ICONGSUPM";"S";"0024";"***********************************************************************"
"ICONGSUPM";"S";"0025";"*"
"ICONGSUPM";"S";"0026";"* Implémentation des données industrielles"
"ICONGSUPM";"S";"0027";"*"
"ICONGSUPM";"S";"0028";"DEBDICO"
"ICONGSUPM";"S";"0029";"   SECH_ISIAGECSUP;O;N2;I;;;123456789;;;C3;""Age d'acquisition congé supplémentaire"";"
"ICONGSUPM";"S";"0030";"   SECH_ISIDCSUP;O;N3,1;I;;;123456789;;;C3;""Droit congé supplémentaire"";"
"ICONGSUPM";"S";"0031";"   PARD_IDIVMCSUP;O;A10;X;;;123456789;II;;C3;""Motif congé supplémentaire"";"
"ICONGSUPM";"S";"0032";"   HJOU_IJRDCSUP;N;N4,1;I;;;    56789;;IJRDCSUP;V3;""Droit congé supplémentaire"";"
"ICONGSUPM";"S";"0033";"   HJOU_IJRCCSUP;N;N4,1;I;;;    56789;;IJRCCSUP;V3;""Pris congé supplémentaire"";"
"ICONGSUPM";"S";"0034";"   HJOU_IJRSCSUP;N;N4,1;I;;;    56789;;IJRSCSUP;V3;""Solde congé supplémentaire"";"
"ICONGSUPM";"S";"0035";"   TEMP_ITQTRCSCET;N;N2;I;;;      789;;;V3;""Controle transfert CSUP en CET"";"
"ICONGSUPM";"S";"0036";"FINDICO"
"ICONGSUPM";"S";"0037";"*"
"ICONGSUPM";"S";"0038";"DEBANO"
"ICONGSUPM";"S";"0039";"   166;9;""Solde congé supplémentaire insuffisant"";"
"ICONGSUPM";"S";"0040";"   167;9;""Solde congé supplémentaire insuffisant pour transfert en CET"";"
"ICONGSUPM";"S";"0041";"FINANO"
"ICONGSUPM";"S";"0042";"*"
"ICONGSUPM";"S";"0043";"* Déclaration des donnees locales"
"ICONGSUPM";"S";"0044";"DEF LOCA_DATEREF D"
"ICONGSUPM";"S";"0045";"LOCA_DATEREF = "" """
"ICONGSUPM";"S";"0046";"DEF LOCA_MOIS N2"
"ICONGSUPM";"S";"0047";"LOCA_MOIS = 0"
"ICONGSUPM";"S";"0048";"DEF LOCA_JOUR N2"
"ICONGSUPM";"S";"0049";"LOCA_JOUR = 0"
"ICONGSUPM";"S";"0050";"DEF LOCA_AGE N2"
"ICONGSUPM";"S";"0051";"LOCA_AGE = 0"
"ICONGSUPM";"S";"0052";"DEF LOCA_CONSO N1"
"ICONGSUPM";"S";"0053";"LOCA_CONSO = 0"
"ICONGSUPM";"S";"0054";"*"
"ICONGSUPM";"S";"0055";"*"
"ICONGSUPM";"S";"0056";"*"
"ICONGSUPM";"S";"0057";"SI SECH_ISIAGECSUP <> 0"
"ICONGSUPM";"S";"0058";"   LOCA_MOIS << CONF_ITIVMREFCP(3:2)"
"ICONGSUPM";"S";"0059";"   LOCA_JOUR << CONF_ITIVMREFCP(1:2)"
"ICONGSUPM";"S";"0060";"   LOCA_DATEREF(1:4) = HJOU_DATE(1:4)"
"ICONGSUPM";"S";"0061";"   LOCA_DATEREF(5:2) << LOCA_MOIS"
"ICONGSUPM";"S";"0062";"   LOCA_DATEREF(7:2) << LOCA_JOUR"
"ICONGSUPM";"S";"0063";"*"
"ICONGSUPM";"S";"0064";"* Le congé supplémentaire lié à l'âge s'acquiert à la date de référence des CP"
"ICONGSUPM";"S";"0065";"* Date de référence"
"ICONGSUPM";"S";"0066";"   SI HJOU_DATE = LOCA_DATEREF"
"ICONGSUPM";"S";"0067";"* Si la date de naissance est renseignée dans EMP"
"ICONGSUPM";"S";"0068";"      SI EMPS_E2DATENAI <> "" """
"ICONGSUPM";"S";"0069";"         DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"ICONGSUPM";"S";"0070";"         LOCA_AGE = TEMP_NXANNEE"
"ICONGSUPM";"S";"0071";"      FINSI"
"ICONGSUPM";"S";"0072";"*Si l'age de l'employé est supérieur à la donnée dans SEH"
"ICONGSUPM";"S";"0073";"      SI LOCA_AGE >= SECH_ISIAGECSUP"
"ICONGSUPM";"S";"0074";"         HJOU_IJRDCSUP = SECH_ISIDCSUP"
"ICONGSUPM";"S";"0075";"         HJOU_IJRCCSUP = 0"
"ICONGSUPM";"S";"0076";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUPM";"S";"0077";"      FINSI"
"ICONGSUPM";"S";"0078";"   FINSI"
"ICONGSUPM";"S";"0079";"*"
"ICONGSUPM";"S";"0080";"* calcul du pris"
"ICONGSUPM";"S";"0081";"   POUR ACTIVITES"
"ICONGSUPM";"S";"0082";"      SI HABS_MOTIF = PARD_IDIVMCSUP"
"ICONGSUPM";"S";"0083";"         LOCA_CONSO = 1"
"ICONGSUPM";"S";"0084";"         SI HABS_VALORIS = ""J"""
"ICONGSUPM";"S";"0085";"            HJOU_IJRCCSUP = HJOU_IJRCCSUP + 1"
"ICONGSUPM";"S";"0086";"            HJOU_IJRSCSUP = HJOU_IJRSCSUP - 1"
"ICONGSUPM";"S";"0087";"         SINON"
"ICONGSUPM";"S";"0088";"            HJOU_IJRCCSUP = HJOU_IJRCCSUP + 0.5"
"ICONGSUPM";"S";"0089";"            HJOU_IJRSCSUP = HJOU_IJRSCSUP - 0.5"
"ICONGSUPM";"S";"0090";"         FINSI"
"ICONGSUPM";"S";"0091";"      FINSI"
"ICONGSUPM";"S";"0092";"   FINPOUR"
"ICONGSUPM";"S";"0093";"*"
"ICONGSUPM";"S";"0094";"   SI LOCA_CONSO = 1"
"ICONGSUPM";"S";"0095";"      SI HJOU_IJRSCSUP < 0"
"ICONGSUPM";"S";"0096";"         TEMP_CNRETOUR = 2"
"ICONGSUPM";"S";"0097";"         TEMP_CNMESS = 166"
"ICONGSUPM";"S";"0098";"      FINSI"
"ICONGSUPM";"S";"0099";"   FINSI"
"ICONGSUPM";"S";"0100";"** Analyse des consignes"
"ICONGSUPM";"S";"0101";"   POUR ACTIVITES"
"ICONGSUPM";"S";"0102";"      SI HABS_MOTIF = ""XDCSUP"""
"ICONGSUPM";"S";"0103";"         HJOU_IJRDCSUP = HJOU_IJRDCSUP + HABS_MOTINBR"
"ICONGSUPM";"S";"0104";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUPM";"S";"0105";"      FINSI"
"ICONGSUPM";"S";"0106";"      SI HABS_MOTIF = ""ZDCSUP"""
"ICONGSUPM";"S";"0107";"         HJOU_IJRDCSUP = HABS_MOTINBR"
"ICONGSUPM";"S";"0108";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUPM";"S";"0109";"      FINSI"
"ICONGSUPM";"S";"0110";"      SI HABS_MOTIF = ""XCCSUP"""
"ICONGSUPM";"S";"0111";"         HJOU_IJRCCSUP = HJOU_IJRCCSUP + HABS_MOTINBR"
"ICONGSUPM";"S";"0112";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUPM";"S";"0113";"      FINSI"
"ICONGSUPM";"S";"0114";"      SI HABS_MOTIF = ""ZCCSUP"""
"ICONGSUPM";"S";"0115";"         HJOU_IJRCCSUP = HABS_MOTINBR"
"ICONGSUPM";"S";"0116";"         HJOU_IJRSCSUP = HJOU_IJRDCSUP - HJOU_IJRCCSUP"
"ICONGSUPM";"S";"0117";"      FINSI"
"ICONGSUPM";"S";"0118";"   FINPOUR"
"ICONGSUPM";"S";"0119";"   *"
"ICONGSUPM";"S";"0120";"   SI HJOU_IJRSCSUP < 0"
"ICONGSUPM";"S";"0121";"      ANOMALIE 166"
"ICONGSUPM";"S";"0122";"   FINSI"
"ICONGSUPM";"S";"0123";"*"
"ICONGSUPM";"S";"0124";"** transfert de congés de supplémentaires vers le CET"
"ICONGSUPM";"S";"0125";"   POUR ACTIVITES"
"ICONGSUPM";"S";"0126";"      SI HABS_MOTIF = ""YCSCET"""
"ICONGSUPM";"S";"0127";"         SI HABS_MOTINBR <= HJOU_IJRSCSUP"
"ICONGSUPM";"S";"0128";"            HJOU_IJRSCSUP = HJOU_IJRSCSUP - HABS_MOTINBR"
"ICONGSUPM";"S";"0129";"         SINON"
"ICONGSUPM";"S";"0130";"* solde cp supplémentaires insuffisant pour transfert vers CET"
"ICONGSUPM";"S";"0131";"            TEMP_ITQTRCSCET = 1"
"ICONGSUPM";"S";"0132";"            ANOMALIE 161"
"ICONGSUPM";"S";"0133";"         FINSI"
"ICONGSUPM";"S";"0134";"      FINSI"
"ICONGSUPM";"S";"0135";"   FINPOUR"
"ICONGSUPM";"S";"0136";"FINSI"
"ICONGSUPM";"S";"0137";"FIN"
