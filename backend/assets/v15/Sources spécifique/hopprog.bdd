"SGDH";"S";"0110";"   FINSI"
"SGDH";"S";"0111";"FINSI"
"SGDH";"S";"0112";"*"
"SGDH";"S";"0113";"* Init des droits annuels et des seuils d'abattement selon société >>"
"SGDH";"S";"0114";"* Selon service spécifique DH"
"SGDH";"S";"0115";"SI HJOU_SECTORI = ""DRE256"""
"SGDH";"S";"0116";"* Société MO"
"SGDH";"S";"0117";"   SI HJOU_SJQSOCIETE = ""MO"""
"SGDH";"S";"0118";"      LOCA_DROIT = 1"
"SGDH";"S";"0119";"      LOCA_DDH = PARD_SDIDDHAMO"
"SGDH";"S";"0120";"      LOCA_SEUILABAT = PARD_SDISADHMO"
"SGDH";"S";"0121";"      LOCA_ABATJ = 0.5"
"SGDH";"S";"0122";"   FINSI"
"SGDH";"S";"0123";"FINSI"
"SGDH";"S";"0124";"*"
"SGDH";"S";"0125";"* RAZ mois"
"SGDH";"S";"0126";"SI HJOU_DATE(7:2) = ""01"""
"SGDH";"S";"0127";"   HJOU_SJRACQDHM = 0"
"SGDH";"S";"0128";"FINSI"
"SGDH";"S";"0129";"*"
"SGDH";"S";"0130";"*"
"SGDH";"S";"0131";"***** DEB : Gestion de l'acquisition >>"
"SGDH";"S";"0132";"*"
"SGDH";"S";"0133";"* RAZ des droits à période de référence >>"
"SGDH";"S";"0134";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGDH";"S";"0135";"   HJOU_SJRDDH = 0"
"SGDH";"S";"0136";"   HJOU_SJRCDH = 0"
"SGDH";"S";"0137";"   HJOU_SJRNABSDH = 0"
"SGDH";"S";"0138";"   HJOU_SJRABPFA = 0"
"SGDH";"S";"0139";"   HJOU_SJRSDH = HJOU_SJRDDH - HJOU_SJRCDH"
"SGDH";"S";"0140";"FINSI"
"SGDH";"S";"0141";"*"
"SGDH";"S";"0142";"* DEB - Calcul Abattement >>"
"SGDH";"S";"0143";"*"
"SGDH";"S";"0144";"* Vérif. si motif stop l'acquisition du droit DH ?"
"SGDH";"S";"0145";"POUR ACTIVITES"
"SGDH";"S";"0146";"* Réduit acqusition selon le nombre de jour absences dans le mois"
"SGDH";"S";"0147";"   SI MOTI_SMIABATRTT = ""1"""
"SGDH";"S";"0148";"      SI HABS_VALORIS = ""J"""
"SGDH";"S";"0149";"         HJOU_SJRNABSDH = HJOU_SJRNABSDH + 1"
"SGDH";"S";"0150";"      SINON"
"SGDH";"S";"0151";"         HJOU_SJRNABSDH = HJOU_SJRNABSDH + 0.5"
"SGDH";"S";"0152";"      FINSI"
"SGDH";"S";"0153";"   FINSI"
"SGDH";"S";"0154";"* Stop acquisition dès le 1° jour"
"SGDH";"S";"0155";"   SI MOTI_SMIABATRTT = ""2"""
"SGDH";"S";"0156";"* A VALIDER, non précisé dans spécification >>"
"SGDH";"S";"0157";"*      LOCA_STOPACQ = 1"
"SGDH";"S";"0158";"   FINSI"
"SGDH";"S";"0159";"FINPOUR"
"SGDH";"S";"0160";"*"
"SGDH";"S";"0161";"SI LOCA_SEUILABAT > 0"
"SGDH";"S";"0162";"   SI LOCA_SEUILABAT <= HJOU_SJRNABSDH"
"SGDH";"S";"0163";"      HJOU_SJRABPFA = HJOU_SJRABPFA + LOCA_ABATJ"
"SGDH";"S";"0164";"      HJOU_SJRDDH = HJOU_SJRDDH - LOCA_ABATJ"
"SGDH";"S";"0165";"      HJOU_SJRNABSDH = 0"
"SGDH";"S";"0166";"*"
"SGDH";"S";"0167";"      SI HJOU_SJRDDH < 0"
"SGDH";"S";"0168";"         HJOU_SJRDDH = 0"
"SGDH";"S";"0169";"      FINSI"
"SGDH";"S";"0170";"*"
"SGDH";"S";"0171";"   FINSI"
"SGDH";"S";"0172";"FINSI"
"SGDH";"S";"0173";"*"
"SGDH";"S";"0174";"* Init via consignes"
"SGDH";"S";"0175";"POUR ACTIVITES"
"SGDH";"S";"0176";"   SI HABS_MOTIF = ""ZNABPF"""
"SGDH";"S";"0177";"      HJOU_SJRNABSDH = HABS_MOTINBR"
"SGDH";"S";"0178";"   FINSI"
"SGDH";"S";"0179";"FINPOUR"
"SGDH";"S";"0180";"*"
"SGDH";"S";"0181";"* FIN <<"
"SGDH";"S";"0182";"*"
"SGDH";"S";"0183";"* Calcul de l'acquisition jour au 30° afin de gérer au plus juste les entrées/sorties au mois"
"SGDH";"S";"0184";"SI LOCA_STOPACQ <> 1"
"SGDH";"S";"0185";"   LOCA_ACQ = LOCA_DDH / 12"
"SGDH";"S";"0186";"   LOCA_ACQ = LOCA_ACQ / 30"
"SGDH";"S";"0187";"SINON"
"SGDH";"S";"0188";"   LOCA_ACQ = 0"
"SGDH";"S";"0189";"FINSI"
"SGDH";"S";"0190";"* Calcul accquisition mois"
"SGDH";"S";"0191";"SI HJOU_DATE(7:2) < ""31"""
"SGDH";"S";"0192";"   HJOU_SJRACQDHM = HJOU_SJRACQDHM + LOCA_ACQ"
"SGDH";"S";"0193";"FINSI"
"SGDH";"S";"0194";"*"
"SGDH";"S";"0195";"* Gestion du mois de février"
"SGDH";"S";"0196";"SI TEMP_DATSUI(5:4) = ""0301"""
"SGDH";"S";"0197";"* années bisextilles"
"SGDH";"S";"0198";"   SI LOCA_ABIS = 1"
"SGDH";"S";"0199";"      HJOU_SJRACQDHM = HJOU_SJRACQDHM + LOCA_ACQ"
"SGDH";"S";"0200";"* années non bisextilles"
"SGDH";"S";"0201";"   SINON"
"SGDH";"S";"0202";"      HJOU_SJRACQDHM = HJOU_SJRACQDHM + LOCA_ACQ"
"SGDH";"S";"0203";"      HJOU_SJRACQDHM = HJOU_SJRACQDHM + LOCA_ACQ"
"SGDH";"S";"0204";"   FINSI"
"SGDH";"S";"0205";"FINSI"
"SGDH";"S";"0206";"*"
"SGDH";"S";"0207";"* Acquisition dernier jour du mois"
"SGDH";"S";"0208";"SI TEMP_DATSUI(7:2) = ""01"""
"SGDH";"S";"0209";"OU HJOU_SJQFINC = 1"
"SGDH";"S";"0210";"OU CTRA_SCIDATSTC = HJOU_DATE"
"SGDH";"S";"0211";"*OU HJOU_SJQINSTC = ""1"""
"SGDH";"S";"0212";"   SI HJOU_SJRACQDHM > 0"
"SGDH";"S";"0213";"      HJOU_SJRACQDHM = HJOU_SJRACQDHM + 0.0001"
"SGDH";"S";"0214";"      HJOU_SJRDDH = HJOU_SJRDDH + HJOU_SJRACQDHM"
"SGDH";"S";"0215";"   FINSI"
"SGDH";"S";"0216";"FINSI"
"SGDH";"S";"0217";"*"
"SGDH";"S";"0218";"* Gestion de l'arrondi à fin de période"
"SGDH";"S";"0219";"SI TEMP_DATSUI(5:4) = LOCA_DATE(5:4)"
"SGDH";"S";"0220";"*OU HJOU_SJQINSTC = ""1"""
"SGDH";"S";"0221";"OU CTRA_SCIDATSTC = HJOU_DATE"
"SGDH";"S";"0222";"OU HJOU_SJQFINC = 1"
"SGDH";"S";"0223";"   LOCA_VALAROND = HJOU_SJRDDH"
"SGDH";"S";"0224";"   FAIRE ARRONDI"
"SGDH";"S";"0225";"   HJOU_SJRDDH = LOCA_VALAROND"
"SGDH";"S";"0226";"FINSI"
"SGDH";"S";"0227";"*"
"SGDH";"S";"0228";"* Init et MAJ du droit par consignes >>"
"SGDH";"S";"0229";"POUR ACTIVITES"
"SGDH";"S";"0230";"* MAJ"
"SGDH";"S";"0231";"   SI HABS_MOTIF = ""XDDH"""
"SGDH";"S";"0232";"      HJOU_SJRDDH = HJOU_SJRDDH + HABS_MOTINBR"
"SGDH";"S";"0233";"   FINSI"
"SGDH";"S";"0234";"* Init"
"SGDH";"S";"0235";"   SI HABS_MOTIF = ""ZDDH"""
"SGDH";"S";"0236";"      HJOU_SJRDDH = HABS_MOTINBR"
"SGDH";"S";"0237";"   FINSI"
"SGDH";"S";"0238";"FINPOUR"
"SGDH";"S";"0239";"*"
"SGDH";"S";"0240";"* Solde >>"
"SGDH";"S";"0241";"HJOU_SJRSDH = HJOU_SJRDDH - HJOU_SJRCDH"
"SGDH";"S";"0242";"*"
"SGDH";"S";"0243";"***** DEB : Gestion de la consommation >>"
"SGDH";"S";"0244";"POUR ACTIVITES"
"SGDH";"S";"0245";"*"
"SGDH";"S";"0246";"   SI HJOU_IJQPRETHEJ > 0"
"SGDH";"S";"0247";"      SI HABS_MOTIF = PARD_SDIVMDH"
"SGDH";"S";"0248";"         LOCA_MOT = 1"
"SGDH";"S";"0249";"*"
"SGDH";"S";"0250";"         SI HABS_VALORIS = ""J"""
"SGDH";"S";"0251";"            SI PROF_ABSENM = 0"
"SGDH";"S";"0252";"            OU PROF_ABSENS = 0"
"SGDH";"S";"0253";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SGDH";"S";"0254";"            SINON"
"SGDH";"S";"0255";"               LOCA_PRIS = LOCA_PRIS + 1"
"SGDH";"S";"0256";"            FINSI"
"SGDH";"S";"0257";"         SINON"
"SGDH";"S";"0258";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SGDH";"S";"0259";"         FINSI"
"SGDH";"S";"0260";"*"
"SGDH";"S";"0261";"      FINSI"
"SGDH";"S";"0262";"   FINSI"
"SGDH";"S";"0263";"FINPOUR"
"SGDH";"S";"0264";"*"
"SGDH";"S";"0265";"SI LOCA_PRIS > 1"
"SGDH";"S";"0266";"   LOCA_PRIS = 1"
"SGDH";"S";"0267";"FINSI"
"SGDH";"S";"0268";"*"
"SGDH";"S";"0269";"SI LOCA_PRIS > 0"
"SGDH";"S";"0270";"   HJOU_SJRCDH = HJOU_SJRCDH + LOCA_PRIS"
"SGDH";"S";"0271";"FINSI"
"SGDH";"S";"0272";"*"
"SGDH";"S";"0273";"* Init et MAJ du pris par consignes >>"
"SGDH";"S";"0274";"POUR ACTIVITES"
"SGDH";"S";"0275";"* MAJ"
"SGDH";"S";"0276";"   SI HABS_MOTIF = ""XCDH"""
"SGDH";"S";"0277";"      HJOU_SJRCDH = HJOU_SJRCDH + HABS_MOTINBR"
"SGDH";"S";"0278";"   FINSI"
"SGDH";"S";"0279";"* Init"
"SGDH";"S";"0280";"   SI HABS_MOTIF = ""ZCDH"""
"SGDH";"S";"0281";"      HJOU_SJRCDH = HABS_MOTINBR"
"SGDH";"S";"0282";"   FINSI"
"SGDH";"S";"0283";"FINPOUR"
"SGDH";"S";"0284";"*"
"SGDH";"S";"0285";"* Solde >>"
"SGDH";"S";"0286";"HJOU_SJRSDH = HJOU_SJRDDH - HJOU_SJRCDH"
"SGDH";"S";"0287";"*"
"SGDH";"S";"0288";"***** DEB : Gestion du pris en attente >>"
"SGDH";"S";"0289";"*"
"SGDH";"S";"0290";"POUR WACTIVITES"
"SGDH";"S";"0291";"   SI WABS_ANNUL = ""0"""
"SGDH";"S";"0292";"      SI LOCA_FERI <> 1"
"SGDH";"S";"0293";"         SI HJOU_IJQPRETHEJ > 0.00"
"SGDH";"S";"0294";"*"
"SGDH";"S";"0295";"            SI WABS_MOTIF = PARD_SDIVMDH"
"SGDH";"S";"0296";"* Gestion de la valorisation >>"
"SGDH";"S";"0297";"               SI WABS_VALORIS = ""J"""
"SGDH";"S";"0298";"                  SI PROF_ABSENM = 0"
"SGDH";"S";"0299";"                  OU PROF_ABSENS = 0"
"SGDH";"S";"0300";"                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SGDH";"S";"0301";"                  SINON"
"SGDH";"S";"0302";"                     LOCA_PRISW = 1"
"SGDH";"S";"0303";"                  FINSI"
"SGDH";"S";"0304";"               SINON"
"SGDH";"S";"0305";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SGDH";"S";"0306";"               FINSI"
"SGDH";"S";"0307";"            FINSI"
"SGDH";"S";"0308";"         FINSI"
"SGDH";"S";"0309";"      FINSI"
"SGDH";"S";"0310";"   FINSI"
"SGDH";"S";"0311";"FINPOUR"
"SGDH";"S";"0312";"*"
"SGDH";"S";"0313";"SI LOCA_PRISW > 1"
"SGDH";"S";"0314";"   LOCA_PRISW = 1"
"SGDH";"S";"0315";"FINSI"
"SGDH";"S";"0316";"*"
"SGDH";"S";"0317";"SI LOCA_PRISW > 0"
"SGDH";"S";"0318";"   HJOU_SJRCDHW = HJOU_SJRCDHW + LOCA_PRISW"
"SGDH";"S";"0319";"FINSI"
"SGDH";"S";"0320";"*"
"SGDH";"S";"0321";"* Solde >>"
"SGDH";"S";"0322";"HJOU_SJRSDH = HJOU_SJRDDH - HJOU_SJRCDH"
"SGDH";"S";"0323";"*"
"SGDH";"S";"0324";"* Identification du seuil DH autorisé"
"SGDH";"S";"0325";"* Par défaut 0"
"SGDH";"S";"0326";"* Autorise un négatif de 1J sur décembre"
"SGDH";"S";"0327";"SI HJOU_DATE(5:2) = ""12"""
"SGDH";"S";"0328";"   SI HJOU_DATE(5:4) <> ""1231"""
"SGDH";"S";"0329";"      SI HJOU_SJRDDH >= 1"
"SGDH";"S";"0330";"         LOCA_SEUIL = -1"
"SGDH";"S";"0331";"      FINSI"
"SGDH";"S";"0332";"   FINSI"
"SGDH";"S";"0333";"FINSI"
"SGDH";"S";"0334";"*"
"SGDH";"S";"0335";"***** Gestion des anomalies >>"
"SGDH";"S";"0336";"*"
"SGDH";"S";"0337";"SI LOCA_MOT = 1"
"SGDH";"S";"0338";"* Si droit ?"
"SGDH";"S";"0339";"   SI LOCA_DROIT <> 1"
"SGDH";"S";"0340";"      ANOMALIE 245"
"SGDH";"S";"0341";"      SI TEMP_CNMOTIF = PARD_SDIVMDH"
"SGDH";"S";"0342";"         TEMP_CNRETOUR = 2"
"SGDH";"S";"0343";"         TEMP_CNMESS = 245"
"SGDH";"S";"0344";"      FINSI"
"SGDH";"S";"0345";"   FINSI"
"SGDH";"S";"0346";"* Si solde négatif ?"
"SGDH";"S";"0347";"   SI HJOU_SJRSDH < LOCA_SEUIL"
"SGDH";"S";"0348";"      ANOMALIE 246"
"SGDH";"S";"0349";"      SI TEMP_CNMOTIF = PARD_SDIVMDH"
"SGDH";"S";"0350";"         TEMP_CNRETOUR = 2"
"SGDH";"S";"0351";"         TEMP_CNMESS = 246"
"SGDH";"S";"0352";"      FINSI"
"SGDH";"S";"0353";"   FINSI"
"SGDH";"S";"0354";"*"
"SGDH";"S";"0355";"FINSI"
"SGDH";"S";"0356";"*"
"SGDH";"S";"0357";"***** Solde prévisionnel >>"
"SGDH";"S";"0358";"*"
"SGDH";"S";"0359";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGDH";"S";"0360";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SGDH";"S";"0361";"      SI HJOU_SJQFINC = 1"
"SGDH";"S";"0362";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGDH";"S";"0363";"         LOCA_DATEFU = TEMP_DXFINPER"
"SGDH";"S";"0364";"      FINSI"
"SGDH";"S";"0365";"   FINSI"
"SGDH";"S";"0366";"FINSI"
"SGDH";"S";"0367";"*"
"SGDH";"S";"0368";"SI TEMP_DATSUI = LOCA_DATEFU"
"SGDH";"S";"0369";"* JJA - 13/06/2025 - Pris prèv."
"SGDH";"S";"0370";"   EMPL_SEQCDH = HJOU_SJRCDH + HJOU_SJRCDHW"
"SGDH";"S";"0371";"*"
"SGDH";"S";"0372";"   EMPL_SEQSPDH = HJOU_SJRSDH - HJOU_SJRCDHW"
"SGDH";"S";"0373";"FINSI"
"SGDH";"S";"0374";"*"
"SGDH";"S";"0375";"FIN"
"SGDH";"S";"0376";"*"
"SGDH";"S";"0377";"* Gestion arrondis"
"SGDH";"S";"0378";"PROC ARRONDI"
"SGDH";"S";"0379";"*"
"SGDH";"S";"0380";"*DEF LOCA_VALAROND N6.2"
"SGDH";"S";"0381";"*LOCA_VALAROND = 0"
"SGDH";"S";"0382";"*DEF LOCA_RESTE N6.2"
"SGDH";"S";"0383";"*LOCA_RESTE = 0"
"SGDH";"S";"0384";"*DEF LOCA_ENTIER N6.2"
"SGDH";"S";"0385";"*LOCA_ENTIER = 0"
"SGDH";"S";"0386";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGDH";"S";"0387";"*DEF LOCA_TYPARROND N2"
"SGDH";"S";"0388";"*LOCA_TYPARROND = 0"
"SGDH";"S";"0389";"*"
"SGDH";"S";"0390";"* Arrondi à l'entier supérieur >>"
"SGDH";"S";"0391";"   SI LOCA_TYPARROND = 1"
"SGDH";"S";"0392";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGDH";"S";"0393";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGDH";"S";"0394";"      SI LOCA_RESTE > 0"
"SGDH";"S";"0395";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGDH";"S";"0396";"      FINSI"
"SGDH";"S";"0397";"      LOCA_VALAROND = LOCA_ENTIER"
"SGDH";"S";"0398";"   FINSI"
"SGDH";"S";"0399";"*"
"SGDH";"S";"0400";"* Arrondi à demi supérieur >>"
"SGDH";"S";"0401";"   SI LOCA_TYPARROND = 2"
"SGDH";"S";"0402";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGDH";"S";"0403";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGDH";"S";"0404";"      SI LOCA_RESTE > 0.5"
"SGDH";"S";"0405";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGDH";"S";"0406";"      SINON"
"SGDH";"S";"0407";"         SI LOCA_RESTE > 0"
"SGDH";"S";"0408";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGDH";"S";"0409";"         FINSI"
"SGDH";"S";"0410";"      FINSI"
"SGDH";"S";"0411";"      LOCA_VALAROND = LOCA_ENTIER"
"SGDH";"S";"0412";"   FINSI"
"SGDH";"S";"0413";"*"
"SGDH";"S";"0414";"* Arrondi à demi le plus proche >>"
"SGDH";"S";"0415";"   SI LOCA_TYPARROND = 3"
"SGDH";"S";"0416";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGDH";"S";"0417";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGDH";"S";"0418";"      SI LOCA_RESTE >= 0.75"
"SGDH";"S";"0419";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGDH";"S";"0420";"      SINON"
"SGDH";"S";"0421";"         SI LOCA_RESTE >= 0.25"
"SGDH";"S";"0422";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGDH";"S";"0423";"         FINSI"
"SGDH";"S";"0424";"      FINSI"
"SGDH";"S";"0425";"      LOCA_VALAROND = LOCA_ENTIER"
"SGDH";"S";"0426";"   FINSI"
"SGDH";"S";"0427";"*"
"SGDH";"S";"0428";"FINPROC"
"SGDH";"S";"0429";"*"
"SGECET";"S";"0001";"***********************************************************************"
"SGECET";"S";"0002";"*"
"SGECET";"S";"0003";"* Règle : SGECET"
"SGECET";"S";"0004";"* Ordre : 6165"
"SGECET";"S";"0005";"* Titre : GCF : Gestion du CET"
"SGECET";"S";"0006";"*"
