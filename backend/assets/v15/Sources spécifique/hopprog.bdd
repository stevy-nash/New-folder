"SGRTTJ";"S";"0176";"LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"SGRTTJ";"S";"0177";"LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"SGRTTJ";"S";"0178";"LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"SGRTTJ";"S";"0179";"*"
"SGRTTJ";"S";"0180";"POUR ACTIVITES"
"SGRTTJ";"S";"0181";"   SI HABS_MOTIF = ""JF"""
"SGRTTJ";"S";"0182";"      LOCA_FERI = 1"
"SGRTTJ";"S";"0183";"   FINSI"
"SGRTTJ";"S";"0184";"* Contrôle si collab en MTT"
"SGRTTJ";"S";"0185";"   SI HABS_MOTIF = PARD_SDIVIMTT"
"SGRTTJ";"S";"0186";"      LOCA_MTT = 1"
"SGRTTJ";"S";"0187";"   FINSI"
"SGRTTJ";"S";"0188";"FINPOUR"
"SGRTTJ";"S";"0189";"*"
"SGRTTJ";"S";"0190";"* Définition année bisextille"
"SGRTTJ";"S";"0191";"SI TEMP_DATSUI(5:4) = ""0301"""
"SGRTTJ";"S";"0192";"   SI HJOU_DATE(7:2) = ""29"""
"SGRTTJ";"S";"0193";"      LOCA_ABIS = 1"
"SGRTTJ";"S";"0194";"   FINSI"
"SGRTTJ";"S";"0195";"FINSI"
"SGRTTJ";"S";"0196";"*"
"SGRTTJ";"S";"0197";"* RAZ mois"
"SGRTTJ";"S";"0198";"SI HJOU_DATE(7:2) = ""01"""
"SGRTTJ";"S";"0199";"   HJOU_IJRACRTTJM = 0"
"SGRTTJ";"S";"0200";"   HJOU_SJRABRTTM = 0"
"SGRTTJ";"S";"0201";"   HJOU_SJRACQJRTT = 0"
"SGRTTJ";"S";"0202";"   HJOU_SJRNABSABR = 0"
"SGRTTJ";"S";"0203";"FINSI"
"SGRTTJ";"S";"0204";"* RAZ année - à la date de référence RTT"
"SGRTTJ";"S";"0205";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGRTTJ";"S";"0206";"   FAIRE RAZCTP"
"SGRTTJ";"S";"0207";"FINSI"
"SGRTTJ";"S";"0208";"*"
"SGRTTJ";"S";"0209";"SI HJOU_IJIGRETETR = ""1"""
"SGRTTJ";"S";"0210";"   SI HORC_SHIACRTTA > 0"
"SGRTTJ";"S";"0211";"      LOCA_DROIT = 1"
"SGRTTJ";"S";"0212";"   FINSI"
"SGRTTJ";"S";"0213";"   SI HJOU_SJQFORFJR = ""1"""
"SGRTTJ";"S";"0214";"      LOCA_DROIT = 1"
"SGRTTJ";"S";"0215";"   FINSI"
"SGRTTJ";"S";"0216";"FINSI"
"SGRTTJ";"S";"0217";"*"
"SGRTTJ";"S";"0218";"SI LOCA_DROIT = 1"
"SGRTTJ";"S";"0219";"*"
"SGRTTJ";"S";"0220";"* DEB - Calcul Abattement >>"
"SGRTTJ";"S";"0221";"*"
"SGRTTJ";"S";"0222";"* Compte nombre de jour absence pour abattement"
"SGRTTJ";"S";"0223";"   POUR ACTIVITES"
"SGRTTJ";"S";"0224";"* Réduit acqusition selon le nombre de jour absences dans le mois"
"SGRTTJ";"S";"0225";"      SI MOTI_SMIABATRTT = ""1"""
"SGRTTJ";"S";"0226";"         SI HABS_VALORIS = ""J"""
"SGRTTJ";"S";"0227";"            HJOU_SJRNABSABR = HJOU_SJRNABSABR + 1"
"SGRTTJ";"S";"0228";"         SINON"
"SGRTTJ";"S";"0229";"            HJOU_SJRNABSABR = HJOU_SJRNABSABR + 0.5"
"SGRTTJ";"S";"0230";"         FINSI"
"SGRTTJ";"S";"0231";"      FINSI"
"SGRTTJ";"S";"0232";"* Stop acquisition dès le 1° jour"
"SGRTTJ";"S";"0233";"      SI MOTI_SMIABATRTT = ""2"""
"SGRTTJ";"S";"0234";"         LOCA_STOPACQ = 1"
"SGRTTJ";"S";"0235";"      FINSI"
"SGRTTJ";"S";"0236";"   FINPOUR"
"SGRTTJ";"S";"0237";"*"
"SGRTTJ";"S";"0238";"* Si Mi-Temps thérapeutique stop acquisition RTT (sauf forfait jour)"
"SGRTTJ";"S";"0239";"   SI LOCA_MTT = 1"
"SGRTTJ";"S";"0240";"      SI HJOU_SJQFORFJR <> ""1"""
"SGRTTJ";"S";"0241";"         LOCA_STOPACQ = 1"
"SGRTTJ";"S";"0242";"      FINSI"
"SGRTTJ";"S";"0243";"   FINSI"
"SGRTTJ";"S";"0244";"*"
"SGRTTJ";"S";"0245";"   SI LOCA_SHISEUILAB > 0"
"SGRTTJ";"S";"0246";"      SI LOCA_SHISEUILAB <= HJOU_SJRNABSABR"
"SGRTTJ";"S";"0247";"         HJOU_SJRABRTTM = HJOU_SJRABRTTM + LOCA_SHIABAJR"
"SGRTTJ";"S";"0248";"         HJOU_SJRNABSABR = 0"
"SGRTTJ";"S";"0249";"      FINSI"
"SGRTTJ";"S";"0250";"   FINSI"
"SGRTTJ";"S";"0251";"*"
"SGRTTJ";"S";"0252";"* Init via consignes"
"SGRTTJ";"S";"0253";"   POUR ACTIVITES"
"SGRTTJ";"S";"0254";"      SI HABS_MOTIF = ""ZNABRT"""
"SGRTTJ";"S";"0255";"         HJOU_SJRNABSABR = HABS_MOTINBR"
"SGRTTJ";"S";"0256";"      FINSI"
"SGRTTJ";"S";"0257";"   FINPOUR"
