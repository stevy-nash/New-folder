"SDACQ";"S";"0210";"***************"
"SDACQ";"S";"0211";"* RAZ date d'acquisition N-4 si fin d'historique < année N-4"
"SDACQ";"S";"0212";"SI EMPL_SEIDATFIN(1:4) < LOCA_DATEP4(1:4)"
"SDACQ";"S";"0213";"   EMPL_SEIDATACQ4 = "" """
"SDACQ";"S";"0214";"FINSI"
"SDACQ";"S";"0215";"SI HJOU_DATE(1:4) = LOCA_DATEP4(1:4)"
"SDACQ";"S";"0216";"   SI HJOU_DATE(5:4) = ""0101"""
"SDACQ";"S";"0217";"   OU HJOU_DATE = HJOU_SJRDDEBCTR"
"SDACQ";"S";"0218";"      EMPL_SEIDATACQ4 = HJOU_DATE"
"SDACQ";"S";"0219";"   FINSI"
"SDACQ";"S";"0220";"   SI HJOU_DATE(1:4) <> TEMP_DATPRE(1:4)"
"SDACQ";"S";"0221";"      EMPL_SEIDATACQ4 = HJOU_DATE"
"SDACQ";"S";"0222";"   FINSI"
"SDACQ";"S";"0223";"FINSI"
"SDACQ";"S";"0224";"***************"
"SDACQ";"S";"0225";"* Année N - 5"
"SDACQ";"S";"0226";"***************"
"SDACQ";"S";"0227";"* RAZ date d'acquisition N-5 si fin d'historique < année N-5"
"SDACQ";"S";"0228";"SI EMPL_SEIDATFIN(1:4) < LOCA_DATEP5(1:4)"
"SDACQ";"S";"0229";"   EMPL_SEIDATACQ5 = "" """
"SDACQ";"S";"0230";"FINSI"
"SDACQ";"S";"0231";"SI HJOU_DATE(1:4) = LOCA_DATEP5(1:4)"
"SDACQ";"S";"0232";"   SI HJOU_DATE(5:4) = ""0101"""
"SDACQ";"S";"0233";"   OU HJOU_DATE = HJOU_SJRDDEBCTR"
"SDACQ";"S";"0234";"      EMPL_SEIDATACQ5 = HJOU_DATE"
"SDACQ";"S";"0235";"   FINSI"
"SDACQ";"S";"0236";"   SI HJOU_DATE(1:4) <> TEMP_DATPRE(1:4)"
"SDACQ";"S";"0237";"      EMPL_SEIDATACQ5 = HJOU_DATE"
"SDACQ";"S";"0238";"   FINSI"
"SDACQ";"S";"0239";"FINSI"
"SDACQ";"S";"0240";"*"
"SDACQ";"S";"0241";"*********************************************"
"SDACQ";"S";"0242";"*    Calcul des dates de fin de périodes    *"
"SDACQ";"S";"0243";"*********************************************"
"SDACQ";"S";"0244";"* Année N-5"
"SDACQ";"S";"0245";"SI HJOU_DATE(1:4) = LOCA_DATEP5(1:4)"
"SDACQ";"S";"0246";"   SI HJOU_DATE = CTRA_DATFIN"
"SDACQ";"S";"0247";"   OU HJOU_DATE(5:4) = ""1231"""
"SDACQ";"S";"0248";"      EMPL_SEIDATFCN5(1:8) = HJOU_DATE(1:8)"
"SDACQ";"S";"0249";"   FINSI"
"SDACQ";"S";"0250";"   SI EMPL_SEIDATFCN5(1:8) > ""19000101"""
"SDACQ";"S";"0251";"      SI EMPL_SEIDATFCN5(1:8) = EMPL_SEIDATFIN(1:8)"
"SDACQ";"S";"0252";"         EMPL_SEIDATFCN4 = "" """
"SDACQ";"S";"0253";"         EMPL_SEIDATFCN3 = "" """
"SDACQ";"S";"0254";"         EMPL_SEIDATFCN2 = "" """
"SDACQ";"S";"0255";"         EMPL_SEIDATFCN1 = "" """
"SDACQ";"S";"0256";"         EMPL_SEIDATFCN = "" """
"SDACQ";"S";"0257";"         EMPL_SEIDATFCN9 = "" """
"SDACQ";"S";"0258";"      FINSI"
"SDACQ";"S";"0259";"   FINSI"
"SDACQ";"S";"0260";"FINSI"
"SDACQ";"S";"0261";"* Année N-4"
"SDACQ";"S";"0262";"SI HJOU_DATE(1:4) = LOCA_DATEP4(1:4)"
"SDACQ";"S";"0263";"   SI HJOU_DATE = CTRA_DATFIN"
"SDACQ";"S";"0264";"   OU HJOU_DATE(5:4) = ""1231"""
"SDACQ";"S";"0265";"      EMPL_SEIDATFCN4(1:8) = HJOU_DATE(1:8)"
"SDACQ";"S";"0266";"   FINSI"
"SDACQ";"S";"0267";"   SI EMPL_SEIDATFCN4(1:8) > ""19000101"""
"SDACQ";"S";"0268";"      SI EMPL_SEIDATFCN4(1:8) = EMPL_SEIDATFIN(1:8)"
"SDACQ";"S";"0269";"         EMPL_SEIDATFCN3 = "" """
"SDACQ";"S";"0270";"         EMPL_SEIDATFCN2 = "" """
"SDACQ";"S";"0271";"         EMPL_SEIDATFCN1 = "" """
"SDACQ";"S";"0272";"         EMPL_SEIDATFCN = "" """
"SDACQ";"S";"0273";"         EMPL_SEIDATFCN9 = "" """
"SDACQ";"S";"0274";"      FINSI"
"SDACQ";"S";"0275";"   FINSI"
"SDACQ";"S";"0276";"FINSI"
"SDACQ";"S";"0277";"* Année N-3"
"SDACQ";"S";"0278";"SI HJOU_DATE(1:4) = LOCA_DATEP3(1:4)"
"SDACQ";"S";"0279";"   SI HJOU_DATE = CTRA_DATFIN"
"SDACQ";"S";"0280";"   OU HJOU_DATE(5:4) = ""1231"""
"SDACQ";"S";"0281";"      EMPL_SEIDATFCN3(1:8) = HJOU_DATE(1:8)"
"SDACQ";"S";"0282";"   FINSI"
"SDACQ";"S";"0283";"   SI EMPL_SEIDATFCN3(1:8) > ""19000101"""
"SDACQ";"S";"0284";"      SI EMPL_SEIDATFCN3(1:8) = EMPL_SEIDATFIN(1:8)"
"SDACQ";"S";"0285";"         EMPL_SEIDATFCN2 = "" """
"SDACQ";"S";"0286";"         EMPL_SEIDATFCN1 = "" """
"SDACQ";"S";"0287";"         EMPL_SEIDATFCN = "" """
"SDACQ";"S";"0288";"         EMPL_SEIDATFCN9 = "" """
"SDACQ";"S";"0289";"      FINSI"
"SDACQ";"S";"0290";"   FINSI"
"SDACQ";"S";"0291";"FINSI"
"SDACQ";"S";"0292";"* Année N-2"
"SDACQ";"S";"0293";"SI HJOU_DATE(1:4) = LOCA_DATEP2(1:4)"
"SDACQ";"S";"0294";"   SI HJOU_DATE = CTRA_DATFIN"
"SDACQ";"S";"0295";"   OU HJOU_DATE(5:4) = ""1231"""
"SDACQ";"S";"0296";"      EMPL_SEIDATFCN2(1:8) = HJOU_DATE(1:8)"
"SDACQ";"S";"0297";"   FINSI"
"SDACQ";"S";"0298";"   SI EMPL_SEIDATFCN2(1:8) > ""19000101"""
"SDACQ";"S";"0299";"      SI EMPL_SEIDATFCN2(1:8) = EMPL_SEIDATFIN(1:8)"
"SDACQ";"S";"0300";"         EMPL_SEIDATFCN1 = "" """
"SDACQ";"S";"0301";"         EMPL_SEIDATFCN = "" """
"SDACQ";"S";"0302";"         EMPL_SEIDATFCN9 = "" """
"SDACQ";"S";"0303";"      FINSI"
"SDACQ";"S";"0304";"   FINSI"
"SDACQ";"S";"0305";"FINSI"
"SDACQ";"S";"0306";"* Année N-1"
"SDACQ";"S";"0307";"SI HJOU_DATE(1:4) = LOCA_DATEP1(1:4)"
"SDACQ";"S";"0308";"   SI HJOU_DATE = CTRA_DATFIN"
"SDACQ";"S";"0309";"   OU HJOU_DATE(5:4) = ""1231"""
"SDACQ";"S";"0310";"      EMPL_SEIDATFCN1(1:8) = HJOU_DATE(1:8)"
"SDACQ";"S";"0311";"   FINSI"
"SDACQ";"S";"0312";"   SI EMPL_SEIDATFCN1(1:8) > ""19000101"""
"SDACQ";"S";"0313";"      SI EMPL_SEIDATFCN1(1:8) = EMPL_SEIDATFIN(1:8)"
"SDACQ";"S";"0314";"         EMPL_SEIDATFCN = "" """
"SDACQ";"S";"0315";"         EMPL_SEIDATFCN9 = "" """
"SDACQ";"S";"0316";"      FINSI"
"SDACQ";"S";"0317";"   FINSI"
"SDACQ";"S";"0318";"FINSI"
"SDACQ";"S";"0319";"* Année en cours"
"SDACQ";"S";"0320";"SI HJOU_DATE(1:4) = LOCA_DATEAC(1:4)"
"SDACQ";"S";"0321";"   SI HJOU_DATE = CTRA_DATFIN"
"SDACQ";"S";"0322";"   OU HJOU_DATE(5:4) = ""1231"""
"SDACQ";"S";"0323";"* La date de fin de période correspond à une fin de contrat ou au 31/12."
"SDACQ";"S";"0324";"* -> On met à jour la date de fin de période N temporaire"
"SDACQ";"S";"0325";"* qu'on ne recopiera dans la vraie date de fin de période QUE"
"SDACQ";"S";"0326";"* lorsqu'on aura atteint la fin de l'historique connu (EMPL_SEIDATFIN)"
"SDACQ";"S";"0327";"* cf plus bas."
"SDACQ";"S";"0328";"      EMPL_SEIDFCNT(1:8) = HJOU_DATE(1:8)"
"SDACQ";"S";"0329";"   FINSI"
"SDACQ";"S";"0330";"   SI EMPL_SEIDATFCN(1:8) > ""19000101"""
"SDACQ";"S";"0331";"      SI EMPL_SEIDATFCN(1:8) = EMPL_SEIDATFIN(1:8)"
"SDACQ";"S";"0332";"         EMPL_SEIDATFCN9 = "" """
"SDACQ";"S";"0333";"      FINSI"
"SDACQ";"S";"0334";"   FINSI"
"SDACQ";"S";"0335";"FINSI"
"SDACQ";"S";"0336";"* Année N+1"
"SDACQ";"S";"0337";"SI HJOU_DATE(1:4) = LOCA_DATEFU(1:4)"
"SDACQ";"S";"0338";"   SI HJOU_DATE = CTRA_DATFIN"
"SDACQ";"S";"0339";"   OU HJOU_DATE = EMPL_SEIDATFIN"
"SDACQ";"S";"0340";"   OU HJOU_DATE(5:4) = ""1231"""
"SDACQ";"S";"0341";"* La date de fin de période correspond à une fin de contrat ou au 31/12."
"SDACQ";"S";"0342";"* -> On met à jour la date de fin de période N temporaire"
"SDACQ";"S";"0343";"* qu'on ne recopiera dans la vraie date de fin de période QUE"
"SDACQ";"S";"0344";"* lorsqu'on aura atteint la fin de l'historique connu (EMPL_SEIDATFIN)"
"SDACQ";"S";"0345";"* cf plus bas."
"SDACQ";"S";"0346";"      EMPL_SEIDFCN9T(1:8) = HJOU_DATE(1:8)"
"SDACQ";"S";"0347";"   FINSI"
"SDACQ";"S";"0348";"FINSI"
"SDACQ";"S";"0349";"* Si on est positionné sur le dernier jour connu de l'historique"
"SDACQ";"S";"0350";"* alors on recopie les dates de fin de période CN N et N+1 temporaires"
"SDACQ";"S";"0351";"* car on est sûr que ce sont les bonnes dates"
"SDACQ";"S";"0352";"SI LOCA_DATEFU(1:4) < EMPL_SEIDATFIN(1:4)"
"SDACQ";"S";"0353";"   SI HJOU_DATE(1:4) = LOCA_DATEFU(1:4)"
"SDACQ";"S";"0354";"      SI HJOU_DATE = CTRA_DATFIN"
"SDACQ";"S";"0355";"      OU HJOU_DATE(5:4) = ""1231"""
"SDACQ";"S";"0356";"         EMPL_SEIDATFCN = "" """
"SDACQ";"S";"0357";"         EMPL_SEIDATFCN9 = "" """
"SDACQ";"S";"0358";"         SI EMPL_SEIDFCNT(1:8) > ""19000101"""
"SDACQ";"S";"0359";"            EMPL_SEIDATFCN = EMPL_SEIDFCNT"
"SDACQ";"S";"0360";"            EMPL_SEIDFCNT = "" """
"SDACQ";"S";"0361";"         FINSI"
"SDACQ";"S";"0362";"         SI EMPL_SEIDFCN9T(1:8) > ""19000101"""
"SDACQ";"S";"0363";"            EMPL_SEIDATFCN9 = EMPL_SEIDFCN9T"
"SDACQ";"S";"0364";"            EMPL_SEIDFCN9T = "" """
"SDACQ";"S";"0365";"         FINSI"
"SDACQ";"S";"0366";"      FINSI"
"SDACQ";"S";"0367";"   FINSI"
"SDACQ";"S";"0368";"SINON"
"SDACQ";"S";"0369";"   SI HJOU_DATE = EMPL_SEIDATFIN"
"SDACQ";"S";"0370";"      EMPL_SEIDATFCN = "" """
"SDACQ";"S";"0371";"      EMPL_SEIDATFCN9 = "" """
"SDACQ";"S";"0372";"      SI EMPL_SEIDFCNT(1:8) > ""19000101"""
"SDACQ";"S";"0373";"         EMPL_SEIDATFCN = EMPL_SEIDFCNT"
"SDACQ";"S";"0374";"         EMPL_SEIDFCNT = "" """
"SDACQ";"S";"0375";"      FINSI"
"SDACQ";"S";"0376";"      SI EMPL_SEIDFCN9T(1:8) > ""19000101"""
"SDACQ";"S";"0377";"         EMPL_SEIDATFCN9 = EMPL_SEIDFCN9T"
"SDACQ";"S";"0378";"         EMPL_SEIDFCN9T = "" """
"SDACQ";"S";"0379";"      FINSI"
"SDACQ";"S";"0380";"   FINSI"
"SDACQ";"S";"0381";"FINSI"
"SDACQ";"S";"0382";"*"
"SDACQ";"S";"0383";"FIN"
