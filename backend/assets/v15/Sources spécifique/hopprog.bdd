"SGASTR";"S";"0430";"*"
"SGASTR";"S";"0431";"FINSI"
"SGASTR";"S";"0432";"*"
"SGASTR";"S";"0433";"***** Astreinte pour la société ESJ - EVO : FFT025006588 >> *****"
"SGASTR";"S";"0434";"*"
"SGASTR";"S";"0435";"SI LOCA_TYPAST = ""ESJ"""
"SGASTR";"S";"0436";"*"
"SGASTR";"S";"0437";"* RAZ le lundi"
"SGASTR";"S";"0438";"   SI HJOU_JOUR = ""1"""
"SGASTR";"S";"0439";"      HJOU_SJRJASTC = 0"
"SGASTR";"S";"0440";"   FINSI"
"SGASTR";"S";"0441";"*"
"SGASTR";"S";"0442";"   SI LOCA_AST = 1"
"SGASTR";"S";"0443";"      SI HJOU_JOUR = ""6"""
"SGASTR";"S";"0444";"      OU HJOU_JOUR = ""7"""
"SGASTR";"S";"0445";"         HJOU_SJRJASTC = HJOU_SJRJASTC + 1"
"SGASTR";"S";"0446";"      SINON"
"SGASTR";"S";"0447";"         HJOU_SJRJASTC = 0"
"SGASTR";"S";"0448";"      FINSI"
