"IINITC";"S";"0032";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"IINITC";"S";"0033";"FINDICO"
"IINITC";"S";"0034";"*"
"IINITC";"S";"0035";"*"
"IINITC";"S";"0036";"* Déclaration des donnees locales"
"IINITC";"S";"0037";"*"
"IINITC";"S";"0038";"POUR ACTIVITES"
"IINITC";"S";"0039";"   SI HABS_MOTIF = ""XJOU"""
"IINITC";"S";"0040";"      HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HABS_MOTIDUR"
"IINITC";"S";"0041";"   FINSI"
"IINITC";"S";"0042";"   SI HABS_MOTIF = ""ZJOU"""
"IINITC";"S";"0043";"      HJOU_IJQBHORVAJ = HABS_MOTIDUR"
"IINITC";"S";"0044";"   FINSI"
"IINITC";"S";"0045";"FINPOUR"
"IINITC";"S";"0046";"SI HJOU_IJQBHORVAJ < 0"
"IINITC";"S";"0047";"   HJOU_IJQBHORVAJ = 0"
"IINITC";"S";"0048";"FINSI"
"IINITC";"S";"0049";"FIN"
