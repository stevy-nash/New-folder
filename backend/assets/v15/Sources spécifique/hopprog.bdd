"SSTC";"S";"0031";"DEF LOCA_SOLDECET N8.2"
"SSTC";"S";"0032";"LOCA_SOLDECET = 0"
"SSTC";"S";"0033";"*"
"SSTC";"S";"0034";"* Paiement CP1"
"SSTC";"S";"0035";"ENLEVER ""Y832"""
"SSTC";"S";"0036";"ENLEVER ""Y832"""
