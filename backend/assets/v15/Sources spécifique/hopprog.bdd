"SHSUPPDIM";"S";"0367";"*"
"SHSUPPDIM";"S";"0368";"   FINSI"
"SHSUPPDIM";"S";"0369";"*"
"SHSUPPDIM";"S";"0370";"FINSI"
"SHSUPPDIM";"S";"0371";"*"
"SHSUPPDIM";"S";"0372";"* Exclu forfait jour"
