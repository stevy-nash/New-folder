"IGRTTJ";"S";"0234";"            LOCA_ENTIER = HJOU_IJRACRTTJM - LOCA_REST"
"IGRTTJ";"S";"0235";"            SI LOCA_REST > 0"
"IGRTTJ";"S";"0236";"               LOCA_ENTIER = LOCA_ENTIER + 1"
