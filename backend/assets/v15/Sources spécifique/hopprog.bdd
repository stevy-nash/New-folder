"IXPRES";"S";"0014";"*"
"IXPRES";"S";"0015";"*"
"IXPRES";"S";"0016";"* Rôle : Priorite de la consigne XPRES"
"IXPRES";"S";"0017";"*"
"IXPRES";"S";"0018";"*"
"IXPRES";"S";"0019";"*"
"IXPRES";"S";"0020";"*"
