"SGCSEGLISS";"S";"0548";"      HJOU_IJRASCSE = HJOU_IJRASCSE + HJOU_IJRATCSE"
"SGCSEGLISS";"S";"0549";"*"
"SGCSEGLISS";"S";"0550";"* Solde CSE reliquat >>"
"SGCSEGLISS";"S";"0551";"      HJOU_SJRSCSER = HJOU_IJRMDCSE1 + HJOU_IJRMDCSE2"
"SGCSEGLISS";"S";"0552";"      HJOU_SJRSCSER = HJOU_SJRSCSER + HJOU_IJRMDCSE3"
"SGCSEGLISS";"S";"0553";"      HJOU_SJRSCSER = HJOU_SJRSCSER + HJOU_IJRMDCSE4"
"SGCSEGLISS";"S";"0554";"      HJOU_SJRSCSER = HJOU_SJRSCSER + HJOU_IJRMDCSE5"
