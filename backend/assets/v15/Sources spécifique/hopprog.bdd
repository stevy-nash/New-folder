"ICONSCPSCH";"S";"0531";"                                HJOU_IJRSCPNTRA = HJOU_IJRSCPNTRA - LOCA_VAL"
"ICONSCPSCH";"S";"0532";"                                *"
"ICONSCPSCH";"S";"0533";"                                HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + LOCA_VAL"
"ICONSCPSCH";"S";"0534";"                                HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_VAL"
"ICONSCPSCH";"S";"0535";"                                *"
