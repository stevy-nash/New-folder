"ITPSACTHTB";"S";"0094";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHTB";"S";"0095";"                    POUR EVENEMENTS"
"ITPSACTHTB";"S";"0096";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHTB";"S";"0097";"                    FINPOUR"
"ITPSACTHTB";"S";"0098";"                FINSI"
"ITPSACTHTB";"S";"0099";"                * Calcul de l'écart"
"ITPSACTHTB";"S";"0100";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHTB";"S";"0101";"            FINSI"
"ITPSACTHTB";"S";"0102";"        FINSI"
"ITPSACTHTB";"S";"0103";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHTB";"S";"0104";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHTB";"S";"0105";"           HJOU_IJQMODL = ""FMOD01"""
