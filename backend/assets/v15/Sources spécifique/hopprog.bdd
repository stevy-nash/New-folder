"IXPRES";"S";"0022";"*"
"IXPRES";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"IXPRES";"S";"0024";"* Date         : JJ/MM/AAAA"
"IXPRES";"S";"0025";"* Objet        :"
"IXPRES";"S";"0026";"*"
"IXPRES";"S";"0027";"***********************************************************************"
"IXPRES";"S";"0028";"*"
"IXPRES";"S";"0029";"*"
"IXPRES";"S";"0030";"* Déclaration des donnees locales"
"IXPRES";"S";"0031";"*"
"IXPRES";"S";"0032";"DEF LOCA_MOT1 A10"
"IXPRES";"S";"0033";"LOCA_MOT1 = "" """
"IXPRES";"S";"0034";"DEF LOCA_MOT2 A10"
"IXPRES";"S";"0035";"LOCA_MOT2 = "" """
"IXPRES";"S";"0036";"DEF LOCA_VALORIS A1"
"IXPRES";"S";"0037";"LOCA_VALORIS = "" """
"IXPRES";"S";"0038";"DEF LOCA_VAL1 A1"
"IXPRES";"S";"0039";"LOCA_VAL1 = "" """
"IXPRES";"S";"0040";"DEF LOCA_VAL2 A1"
"IXPRES";"S";"0041";"LOCA_VAL2 = "" """
"IXPRES";"S";"0042";"*"
"IXPRES";"S";"0043";"POUR ACTIVITES"
"IXPRES";"S";"0044";"   SI HABS_MOTIF = ""XPRES"""
"IXPRES";"S";"0045";"      LOCA_VALORIS = HABS_VALORIS"
"IXPRES";"S";"0046";"   FINSI"
"IXPRES";"S";"0047";"   SI HABS_MOTIF <> ""XPRES"""
"IXPRES";"S";"0048";"      SI HABS_VALORIS <> ""H"""
"IXPRES";"S";"0049";"         SI HABS_MOTYPE <> ""C"""
"IXPRES";"S";"0050";"            SI LOCA_MOT1 = "" """
"IXPRES";"S";"0051";"               LOCA_MOT1 = HABS_MOTIF"
"IXPRES";"S";"0052";"               LOCA_VAL1 = HABS_VALORIS"
"IXPRES";"S";"0053";"            SINON"
"IXPRES";"S";"0054";"               LOCA_MOT2 = HABS_MOTIF"
"IXPRES";"S";"0055";"               LOCA_VAL2 = HABS_VALORIS"
"IXPRES";"S";"0056";"            FINSI"
"IXPRES";"S";"0057";"         FINSI"
"IXPRES";"S";"0058";"      FINSI"
"IXPRES";"S";"0059";"   FINSI"
"IXPRES";"S";"0060";"FINPOUR"
"IXPRES";"S";"0061";"* cas ou XPRES est passé en J"
"IXPRES";"S";"0062";"SI LOCA_VALORIS = ""J"""
"IXPRES";"S";"0063";"   ENLEVER LOCA_MOT1"
"IXPRES";"S";"0064";"   ENLEVER LOCA_MOT2"
"IXPRES";"S";"0065";"FINSI"
"IXPRES";"S";"0066";"* cas ou XPRES est passé en M"
"IXPRES";"S";"0067";"SI LOCA_VALORIS = ""M"""
"IXPRES";"S";"0068";"   SI LOCA_VAL1 = ""M"""
"IXPRES";"S";"0069";"      ENLEVER LOCA_MOT1"
"IXPRES";"S";"0070";"   FINSI"
"IXPRES";"S";"0071";"   SI LOCA_VAL2 = ""M"""
"IXPRES";"S";"0072";"      ENLEVER LOCA_MOT2"
"IXPRES";"S";"0073";"   FINSI"
"IXPRES";"S";"0074";"   SI LOCA_VAL1 = ""J"""
"IXPRES";"S";"0075";"      ENLEVER LOCA_MOT1"
"IXPRES";"S";"0076";"      AJOUTER LOCA_MOT1 ""A"" PROF_ABSENS"
"IXPRES";"S";"0077";"   FINSI"
"IXPRES";"S";"0078";"FINSI"
"IXPRES";"S";"0079";"* cas ou XPRES est passé en A"
"IXPRES";"S";"0080";"SI LOCA_VALORIS = ""A"""
"IXPRES";"S";"0081";"   SI LOCA_VAL1 = ""A"""
"IXPRES";"S";"0082";"      ENLEVER LOCA_MOT1"
"IXPRES";"S";"0083";"   FINSI"
"IXPRES";"S";"0084";"   SI LOCA_VAL2 = ""A"""
"IXPRES";"S";"0085";"      ENLEVER LOCA_MOT2"
"IXPRES";"S";"0086";"   FINSI"
"IXPRES";"S";"0087";"   SI LOCA_VAL1 = ""J"""
"IXPRES";"S";"0088";"      ENLEVER LOCA_MOT1"
"IXPRES";"S";"0089";"      AJOUTER LOCA_MOT1 ""M"" PROF_ABSENM"
"IXPRES";"S";"0090";"   FINSI"
"IXPRES";"S";"0091";"FINSI"
"IXPRES";"S";"0092";"FIN"
"SACQCMDF";"S";"0001";"***********************************************************************"
"SACQCMDF";"S";"0002";"*"
"SACQCMDF";"S";"0003";"* Règle : SACQCMDF"
"SACQCMDF";"S";"0004";"* Ordre : 3590"
"SACQCMDF";"S";"0005";"* Titre : GCF : Gestion acquis. C. mère/père fami."
"SACQCMDF";"S";"0006";"*"
"SACQCMDF";"S";"0007";"*----------------------------------------------------------------------"
"SACQCMDF";"S";"0008";"*"
"SACQCMDF";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SACQCMDF";"S";"0010";"* Date     : 20/01/2025"
"SACQCMDF";"S";"0011";"* Version  : 1"
"SACQCMDF";"S";"0012";"*"
"SACQCMDF";"S";"0013";"*----------------------------------------------------------------------"
"SACQCMDF";"S";"0014";"*"
"SACQCMDF";"S";"0015";"*"
"SACQCMDF";"S";"0016";"* Rôle : BT 65154 : Gestion acquisition des CP mère/père de famille"
"SACQCMDF";"S";"0017";"*                   et même date de référence que les CP"
"SACQCMDF";"S";"0018";"*"
"SACQCMDF";"S";"0019";"*"
"SACQCMDF";"S";"0020";"*----------------------------------------------------------------------"
"SACQCMDF";"S";"0021";"*"
"SACQCMDF";"S";"0022";"* Modifiée par :"
"SACQCMDF";"S";"0023";"* Date         : JJ/MM/AAAA"
"SACQCMDF";"S";"0024";"* Objet        :"
"SACQCMDF";"S";"0025";"*"
"SACQCMDF";"S";"0026";"*"
"SACQCMDF";"S";"0027";"***********************************************************************"
"SACQCMDF";"S";"0028";"*"
"SACQCMDF";"S";"0029";"DEBDICO"
"SACQCMDF";"S";"0030";"   HJOU_SJRDCMDF;N;N5,1;I;;;    56789;;SJRDCMDF;V3;""Droit C. mère/père de famille"";"
"SACQCMDF";"S";"0031";"   HJOU_SJRCCMDF;N;N5,1;I;;;    56789;;SJRCCMDF;V3;""Pris C. mère/père de famille"";"
"SACQCMDF";"S";"0032";"   HJOU_SJRSCMDF;N;N5,1;I;;;    56789;;SJRSCMDF;V3;""Solde C. mère/père de famille"";"
"SACQCMDF";"S";"0033";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"SACQCMDF";"S";"0034";"   *"
"SACQCMDF";"S";"0035";"FINDICO"
"SACQCMDF";"S";"0036";"*"
"SACQCMDF";"S";"0037";"DEBANO"
"SACQCMDF";"S";"0038";"   *"
"SACQCMDF";"S";"0039";"FINANO"
"SACQCMDF";"S";"0040";"*"
"SACQCMDF";"S";"0041";"* Déclaration des donnees locales"
"SACQCMDF";"S";"0042";"* Variables utilisées pour calculer la date de reference"
"SACQCMDF";"S";"0043";"DEF LOCA_DATE D"
"SACQCMDF";"S";"0044";"DEF LOCA_REF N2"
"SACQCMDF";"S";"0045";"*"
"SACQCMDF";"S";"0046";"DEF LOCA_CMDF N2"
"SACQCMDF";"S";"0047";"LOCA_CMDF = 0"
"SACQCMDF";"S";"0048";"*"
"SACQCMDF";"S";"0049";"DEF LOCA_AVRIL D"
"SACQCMDF";"S";"0050";"LOCA_AVRIL = "" """
"SACQCMDF";"S";"0051";"DEF LOCA_PLAFOND N2"
"SACQCMDF";"S";"0052";"*LOCA_PLAFOND = HJOU_SJQDRCPAN"
"SACQCMDF";"S";"0053";"LOCA_PLAFOND = 25"
"SACQCMDF";"S";"0054";"DEF LOCA_AGE N4"
"SACQCMDF";"S";"0055";"LOCA_AGE = 0"
"SACQCMDF";"S";"0056";"DEF LOCA_AGEENF N4"
"SACQCMDF";"S";"0057";"LOCA_AGEENF = 0"
"SACQCMDF";"S";"0058";"DEF LOCA_NBENFANT N2"
"SACQCMDF";"S";"0059";"LOCA_NBENFANT = 0"
"SACQCMDF";"S";"0060";"DEF LOCA_NBJENF N2"
"SACQCMDF";"S";"0061";"LOCA_NBJENF = 0"
"SACQCMDF";"S";"0062";"*"
"SACQCMDF";"S";"0063";"DEF LOCA_DCP N6.1"
"SACQCMDF";"S";"0064";"LOCA_DCP = 0"
"SACQCMDF";"S";"0065";"DEF LOCA_DIF N6.1"
"SACQCMDF";"S";"0066";"LOCA_DIF = 0"
"SACQCMDF";"S";"0067";"*"
"SACQCMDF";"S";"0068";"DEF LOCA_ANCJ N4"
"SACQCMDF";"S";"0069";"LOCA_ANCJ = 0"
"SACQCMDF";"S";"0070";"*"
"SACQCMDF";"S";"0071";"SI EMPS_E2DATEANC <> "" """
"SACQCMDF";"S";"0072";"   DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"SACQCMDF";"S";"0073";"   LOCA_ANCJ = TEMP_NXJOUR"
"SACQCMDF";"S";"0074";"FINSI"
"SACQCMDF";"S";"0075";"*"
"SACQCMDF";"S";"0076";"* Identification du LOT2 et suppression anomalie avant le 01/10/2025 >>"
"SACQCMDF";"S";"0077";"DEF LOCA_LOT2 N2"
"SACQCMDF";"S";"0078";"LOCA_LOT2 = 0"
"SACQCMDF";"S";"0079";"*"
"SACQCMDF";"S";"0080";"SI HJOU_DATE(1:8) < ""20251001"""
"SACQCMDF";"S";"0081";"   SI HJOU_SECTORI(1:3) <> ""DIN"""
"SACQCMDF";"S";"0082";"      SI HJOU_SECTORI(1:3) <> ""DRE"""
"SACQCMDF";"S";"0083";"         SI HJOU_SECTORI(1:3) <> ""RED"""
"SACQCMDF";"S";"0084";"            SI HJOU_SECTORI(1:3) <> ""TVR"""
"SACQCMDF";"S";"0085";"               LOCA_LOT2 = 1"
"SACQCMDF";"S";"0086";"            FINSI"
"SACQCMDF";"S";"0087";"         FINSI"
"SACQCMDF";"S";"0088";"      FINSI"
"SACQCMDF";"S";"0089";"   FINSI"
"SACQCMDF";"S";"0090";"FINSI"
"SACQCMDF";"S";"0091";"*"
"SACQCMDF";"S";"0092";"SI CONF_ITIVMREFCP <> "" """
"SACQCMDF";"S";"0093";"* Calcul de la date de référence CP"
"SACQCMDF";"S";"0094";"* stockage de l'année du jour de l'historique"
"SACQCMDF";"S";"0095";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"SACQCMDF";"S";"0096";"* stockage du mois de reference"
"SACQCMDF";"S";"0097";"   LOCA_REF << CONF_ITIVMREFCP(3:2)"
"SACQCMDF";"S";"0098";"* stokage du mois de reference"
"SACQCMDF";"S";"0099";"   LOCA_DATE(5:2) << LOCA_REF"
"SACQCMDF";"S";"0100";"* stockage du jour de reference"
"SACQCMDF";"S";"0101";"   LOCA_REF << CONF_ITIVMREFCP(1:2)"
"SACQCMDF";"S";"0102";"* loca_date contient maintenant l'année du jour de l'historique"
"SACQCMDF";"S";"0103";"* et le mois et le jour de reference"
"SACQCMDF";"S";"0104";"   LOCA_DATE(7:2) << LOCA_REF"
"SACQCMDF";"S";"0105";"SINON"
"SACQCMDF";"S";"0106";"   LOCA_DATE = "" """
"SACQCMDF";"S";"0107";"FINSI"
"SACQCMDF";"S";"0108";"*"
"SACQCMDF";"S";"0109";"* Test si gestion des cp"
"SACQCMDF";"S";"0110";"SI HJOU_IJIACOPRIN = ""1"""
"SACQCMDF";"S";"0111";"   SI HJOU_DATE >= CONF_SDIDATDEM"
"SACQCMDF";"S";"0112";"      SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SACQCMDF";"S";"0113";"*"
"SACQCMDF";"S";"0114";"* Init >>"
"SACQCMDF";"S";"0115";"         HJOU_SJRDCMDF = 0"
"SACQCMDF";"S";"0116";"*"
"SACQCMDF";"S";"0117";"* Condition anciennété"
"SACQCMDF";"S";"0118";"         SI LOCA_ANCJ <= 366"
"SACQCMDF";"S";"0119";"            SI HJOU_IJRDCOPRIN < LOCA_PLAFOND"
"SACQCMDF";"S";"0120";"*"
"SACQCMDF";"S";"0121";"* Début calcul acquisition >>"
"SACQCMDF";"S";"0122";"*"
"SACQCMDF";"S";"0123";"* Age de l'employé"
"SACQCMDF";"S";"0124";"               SI EMPS_E2DATENAI <> "" """
"SACQCMDF";"S";"0125";"                  DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"SACQCMDF";"S";"0126";"                  LOCA_AGE = TEMP_NXANNEE"
"SACQCMDF";"S";"0127";"               SINON"
"SACQCMDF";"S";"0128";"* Si pas de date de naissance renseigné, plus de 21 par défaut"
"SACQCMDF";"S";"0129";"                  LOCA_AGE = 21"
"SACQCMDF";"S";"0130";"               FINSI"
"SACQCMDF";"S";"0131";"*"
"SACQCMDF";"S";"0132";"               LOCA_AVRIL(1:4) = HJOU_DATE(1:4)"
"SACQCMDF";"S";"0133";"               LOCA_AVRIL(5:4) = ""0401"""
"SACQCMDF";"S";"0134";"*"
"SACQCMDF";"S";"0135";"               POUR ENFANTS"
"SACQCMDF";"S";"0136";"*Age de l'enfant au 1er avril"
"SACQCMDF";"S";"0137";"                  DATDIFF ENFT_ENFDATENAI 12 LOCA_AVRIL 12"
"SACQCMDF";"S";"0138";"                  LOCA_AGEENF = TEMP_NXANNEE"
"SACQCMDF";"S";"0139";"******"
"SACQCMDF";"S";"0140";"                  SI LOCA_AGEENF < 15"
"SACQCMDF";"S";"0141";"*Nb enfants de l'employé"
"SACQCMDF";"S";"0142";"                     SI ENFT_ENFACHARGE = ""1"""
"SACQCMDF";"S";"0143";"                        LOCA_NBENFANT = LOCA_NBENFANT + 1"
"SACQCMDF";"S";"0144";"                     FINSI"
"SACQCMDF";"S";"0145";"                  FINSI"
"SACQCMDF";"S";"0146";"               FINPOUR"
"SACQCMDF";"S";"0147";"*"
"SACQCMDF";"S";"0148";"               SI LOCA_NBENFANT > 0"
"SACQCMDF";"S";"0149";"*Moins de 21 ans"
"SACQCMDF";"S";"0150";"                  SI LOCA_AGE < 21"
"SACQCMDF";"S";"0151";"                     SI HJOU_IJRDCOPRIN <= 6"
"SACQCMDF";"S";"0152";"*Ajout 1 jour par enfants à charge"
"SACQCMDF";"S";"0153";"                        LOCA_NBJENF = LOCA_NBENFANT"
"SACQCMDF";"S";"0154";"                        HJOU_SJRDCMDF = HJOU_SJRDCMDF + LOCA_NBJENF"
"SACQCMDF";"S";"0155";"                     SINON"
"SACQCMDF";"S";"0156";"*Ajout 2 jours par enfants à charge"
"SACQCMDF";"S";"0157";"                        LOCA_NBJENF = LOCA_NBENFANT * 2"
"SACQCMDF";"S";"0158";"                        HJOU_SJRDCMDF = HJOU_SJRDCMDF + LOCA_NBJENF"
"SACQCMDF";"S";"0159";"                        LOCA_DCP = HJOU_IJRDCOPRIN + HJOU_SJRDCMDF"
"SACQCMDF";"S";"0160";"* Vérification plafond"
"SACQCMDF";"S";"0161";"                        SI LOCA_DCP > LOCA_PLAFOND"
"SACQCMDF";"S";"0162";"                           LOCA_DIF = LOCA_DCP - LOCA_PLAFOND"
"SACQCMDF";"S";"0163";"                           SI LOCA_DIF >= HJOU_SJRDCMDF"
"SACQCMDF";"S";"0164";"                              HJOU_SJRDCMDF = 0"
"SACQCMDF";"S";"0165";"                           SINON"
"SACQCMDF";"S";"0166";"                              HJOU_SJRDCMDF = HJOU_SJRDCMDF - LOCA_DIF"
"SACQCMDF";"S";"0167";"                           FINSI"
"SACQCMDF";"S";"0168";"                        FINSI"
"SACQCMDF";"S";"0169";"                     FINSI"
"SACQCMDF";"S";"0170";"                  SINON"
"SACQCMDF";"S";"0171";"*Plus de 21 ans"
"SACQCMDF";"S";"0172";"*Ajout 2 jours par enfants à charge"
"SACQCMDF";"S";"0173";"                     LOCA_NBJENF = LOCA_NBENFANT * 2"
"SACQCMDF";"S";"0174";"                     HJOU_SJRDCMDF = HJOU_SJRDCMDF + LOCA_NBJENF"
"SACQCMDF";"S";"0175";"                     LOCA_DCP = HJOU_IJRDCOPRIN + HJOU_SJRDCMDF"
"SACQCMDF";"S";"0176";"* Vérification plafond"
"SACQCMDF";"S";"0177";"                     SI LOCA_DCP > LOCA_PLAFOND"
"SACQCMDF";"S";"0178";"                        LOCA_DIF = LOCA_DCP - LOCA_PLAFOND"
"SACQCMDF";"S";"0179";"                        SI LOCA_DIF >= HJOU_SJRDCMDF"
"SACQCMDF";"S";"0180";"                           HJOU_SJRDCMDF = 0"
"SACQCMDF";"S";"0181";"                        SINON"
"SACQCMDF";"S";"0182";"                           HJOU_SJRDCMDF = HJOU_SJRDCMDF - LOCA_DIF"
"SACQCMDF";"S";"0183";"                        FINSI"
"SACQCMDF";"S";"0184";"                     FINSI"
"SACQCMDF";"S";"0185";"                  FINSI"
"SACQCMDF";"S";"0186";"               FINSI"
"SACQCMDF";"S";"0187";"*"
"SACQCMDF";"S";"0188";"* Fin calcul acquisition >>"
"SACQCMDF";"S";"0189";"*"
"SACQCMDF";"S";"0190";"            FINSI"
"SACQCMDF";"S";"0191";"         FINSI"
"SACQCMDF";"S";"0192";"*"
"SACQCMDF";"S";"0193";"* RAZ du pris"
"SACQCMDF";"S";"0194";"         HJOU_SJRCCMDF = 0"
"SACQCMDF";"S";"0195";"         HJOU_SJRSCMDF = HJOU_SJRDCMDF - HJOU_SJRCCMDF"
"SACQCMDF";"S";"0196";"*"
"SACQCMDF";"S";"0197";"      FINSI"
"SACQCMDF";"S";"0198";"   SINON"
"SACQCMDF";"S";"0199";"* RAZ"
"SACQCMDF";"S";"0200";"      HJOU_SJRDCMDF = 0"
"SACQCMDF";"S";"0201";"      HJOU_SJRCCMDF = 0"
"SACQCMDF";"S";"0202";"      HJOU_SJRSCMDF = HJOU_SJRDCMDF - HJOU_SJRCCMDF"
"SACQCMDF";"S";"0203";"   FINSI"
"SACQCMDF";"S";"0204";"*"
"SACQCMDF";"S";"0205";"   SI LOCA_LOT2 = 1"
"SACQCMDF";"S";"0206";"* RAZ"
"SACQCMDF";"S";"0207";"      HJOU_SJRDCMDF = 0"
"SACQCMDF";"S";"0208";"      HJOU_SJRCCMDF = 0"
"SACQCMDF";"S";"0209";"      HJOU_SJRSCMDF = HJOU_SJRDCMDF - HJOU_SJRCCMDF"
"SACQCMDF";"S";"0210";"   FINSI"
"SACQCMDF";"S";"0211";"*"
"SACQCMDF";"S";"0212";"* Init et MAJ droit par consigne >>"
"SACQCMDF";"S";"0213";"   POUR ACTIVITES"
"SACQCMDF";"S";"0214";"      SI HABS_MOTIF = ""ZDCMDF"""
"SACQCMDF";"S";"0215";"         HJOU_SJRDCMDF = HABS_MOTINBR"
"SACQCMDF";"S";"0216";"      FINSI"
"SACQCMDF";"S";"0217";"      SI HABS_MOTIF = ""XDCMDF"""
"SACQCMDF";"S";"0218";"         HJOU_SJRDCMDF = HJOU_SJRDCMDF + HABS_MOTINBR"
"SACQCMDF";"S";"0219";"      FINSI"
"SACQCMDF";"S";"0220";"   FINPOUR"
"SACQCMDF";"S";"0221";"*"
"SACQCMDF";"S";"0222";"* Solde >>"
"SACQCMDF";"S";"0223";"   HJOU_SJRSCMDF = HJOU_SJRDCMDF - HJOU_SJRCCMDF"
"SACQCMDF";"S";"0224";"*"
"SACQCMDF";"S";"0225";"FINSI"
"SACQCMDF";"S";"0226";"*"
"SACQCMDF";"S";"0227";"FIN"
"SACQCP";"S";"0001";"***********************************************************************"
"SACQCP";"S";"0002";"*"
"SACQCP";"S";"0003";"* Règle : SACQCP"
"SACQCP";"S";"0004";"* Ordre : 3575"
"SACQCP";"S";"0005";"* Titre : GCF : Gestion de l'acquisition des congés payés"
"SACQCP";"S";"0006";"*"
