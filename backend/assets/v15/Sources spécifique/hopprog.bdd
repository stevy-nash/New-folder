"ICHEVM";"S";"0026";"*"
"ICHEVM";"S";"0027";"***********************************************************************"
"ICHEVM";"S";"0028";"*"
"ICHEVM";"S";"0029";"*"
"ICHEVM";"S";"0030";"* Implémentation des données industrielles"
"ICHEVM";"S";"0031";"*"
"ICHEVM";"S";"0032";"DEBDICO"
"ICHEVM";"S";"0033";"   HJOU_IJQMVTENT1;N;T6,2;I;;;    56789;;;V2;""Mouvement entree1"";"
"ICHEVM";"S";"0034";"   HJOU_IJQMVTENT2;N;T6,2;I;;;    56789;;;V2;""Mouvement entree2"";"
"ICHEVM";"S";"0035";"   HJOU_IJQMVTENT3;N;T6,2;I;;;    56789;;;V2;""Mouvement entree3"";"
"ICHEVM";"S";"0036";"   HJOU_IJQMVTENT4;N;T6,2;I;;;    56789;;;V2;""Mouvement entree4"";"
"ICHEVM";"S";"0037";"   HJOU_IJQMVTENT5;N;T6,2;I;;;    56789;;;V2;""Mouvement entree5"";"
"ICHEVM";"S";"0038";"   HJOU_IJQMVTSOR1;N;T6,2;I;;;    56789;;;V2;""Mouvement sortie1"";"
"ICHEVM";"S";"0039";"   HJOU_IJQMVTSOR2;N;T6,2;I;;;    56789;;;V2;""Mouvement sortie2"";"
"ICHEVM";"S";"0040";"   HJOU_IJQMVTSOR3;N;T6,2;I;;;    56789;;;V2;""Mouvement sortie3"";"
"ICHEVM";"S";"0041";"   HJOU_IJQMVTSOR4;N;T6,2;I;;;    56789;;;V2;""Mouvement sortie4"";"
"ICHEVM";"S";"0042";"   HJOU_IJQMVTSOR5;N;T6,2;I;;;    56789;;;V2;""Mouvement sortie5"";"
"ICHEVM";"S";"0043";"FINDICO"
"ICHEVM";"S";"0044";"*"
"ICHEVM";"S";"0045";"* Déclaration des donnees locales"
"ICHEVM";"S";"0046";"*"
"ICHEVM";"S";"0047";"DEF LOCA_MVT0 N1"
"ICHEVM";"S";"0048";"LOCA_MVT0 = 0"
"ICHEVM";"S";"0049";"SI HJOU_DATE <= TEMP_DATJOU"
"ICHEVM";"S";"0050";"   POUR POINTAGES"
"ICHEVM";"S";"0051";"      SI LOCA_MVT0 = 0"
"ICHEVM";"S";"0052";"         HJOU_IJQMVTENT1 = POIN_HRETRAI"
"ICHEVM";"S";"0053";"         LOCA_MVT0 = 1"
"ICHEVM";"S";"0054";"*"
"ICHEVM";"S";"0055";"* cas ou le premier pointage de la journée est à 0.00"
"ICHEVM";"S";"0056";"*"
"ICHEVM";"S";"0057";"         SI HJOU_IJQMVTENT1 = 0"
"ICHEVM";"S";"0058";"            HJOU_IJQMVTENT1 = 100"
"ICHEVM";"S";"0059";"         FINSI"
"ICHEVM";"S";"0060";"*"
"ICHEVM";"S";"0061";"      SINON"
"ICHEVM";"S";"0062";"         SI HJOU_IJQMVTSOR1 = 0"
"ICHEVM";"S";"0063";"            HJOU_IJQMVTSOR1 = POIN_HRETRAI"
"ICHEVM";"S";"0064";"         SINON"
"ICHEVM";"S";"0065";"            SI HJOU_IJQMVTENT2 = 0"
"ICHEVM";"S";"0066";"               HJOU_IJQMVTENT2 = POIN_HRETRAI"
"ICHEVM";"S";"0067";"            SINON"
"ICHEVM";"S";"0068";"               SI HJOU_IJQMVTSOR2 = 0"
"ICHEVM";"S";"0069";"                  HJOU_IJQMVTSOR2 = POIN_HRETRAI"
"ICHEVM";"S";"0070";"               SINON"
"ICHEVM";"S";"0071";"                  SI HJOU_IJQMVTENT3 = 0"
"ICHEVM";"S";"0072";"                     HJOU_IJQMVTENT3 = POIN_HRETRAI"
"ICHEVM";"S";"0073";"                  SINON"
"ICHEVM";"S";"0074";"                     SI HJOU_IJQMVTSOR3 = 0"
"ICHEVM";"S";"0075";"                        HJOU_IJQMVTSOR3 = POIN_HRETRAI"
"ICHEVM";"S";"0076";"                     SINON"
"ICHEVM";"S";"0077";"                        SI HJOU_IJQMVTENT4 = 0"
"ICHEVM";"S";"0078";"                           HJOU_IJQMVTENT4 = POIN_HRETRAI"
"ICHEVM";"S";"0079";"                        SINON"
"ICHEVM";"S";"0080";"                           SI HJOU_IJQMVTSOR4 = 0"
"ICHEVM";"S";"0081";"                              HJOU_IJQMVTSOR4 = POIN_HRETRAI"
"ICHEVM";"S";"0082";"                           SINON"
"ICHEVM";"S";"0083";"                              SI HJOU_IJQMVTENT5 = 0"
"ICHEVM";"S";"0084";"                                 HJOU_IJQMVTENT5 = POIN_HRETRAI"
"ICHEVM";"S";"0085";"                              SINON"
"ICHEVM";"S";"0086";"                                 SI HJOU_IJQMVTSOR5 = 0"
"ICHEVM";"S";"0087";"                                    HJOU_IJQMVTSOR5 = POIN_HRETRAI"
"ICHEVM";"S";"0088";"                                 FINSI"
"ICHEVM";"S";"0089";"                              FINSI"
"ICHEVM";"S";"0090";"                           FINSI"
"ICHEVM";"S";"0091";"                        FINSI"
"ICHEVM";"S";"0092";"                     FINSI"
"ICHEVM";"S";"0093";"                  FINSI"
"ICHEVM";"S";"0094";"               FINSI"
"ICHEVM";"S";"0095";"            FINSI"
"ICHEVM";"S";"0096";"         FINSI"
"ICHEVM";"S";"0097";"      FINSI"
"ICHEVM";"S";"0098";"*FINSI"
