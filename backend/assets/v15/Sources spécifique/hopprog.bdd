"SCPTBASE";"S";"0066";"* Définition des variables locales"
"SCPTBASE";"S";"0067";"*"
"SCPTBASE";"S";"0068";"DEF LOCA_5 N6.2"
"SCPTBASE";"S";"0069";"LOCA_5 = 5.00"
"SCPTBASE";"S";"0070";"DEF LOCA_NULL T6.2"
"SCPTBASE";"S";"0071";"LOCA_NULL = 545.00"
"SCPTBASE";"S";"0072";"DEF LOCA_HD T6.2"
"SCPTBASE";"S";"0073";"LOCA_HD = 0"
"SCPTBASE";"S";"0074";"DEF LOCA_HF T6.2"
"SCPTBASE";"S";"0075";"LOCA_HF = 0"
"SCPTBASE";"S";"0076";"DEF LOCA_MVE T6.2"
"SCPTBASE";"S";"0077";"LOCA_MVE = 0"
"SCPTBASE";"S";"0078";"DEF LOCA_MVS T6.2"
"SCPTBASE";"S";"0079";"LOCA_MVS = 0"
"SCPTBASE";"S";"0080";"DEF LOCA_HRMIDI T6.2"
"SCPTBASE";"S";"0081";"LOCA_HRMIDI = PROF_HRMIDI"
"SCPTBASE";"S";"0082";"*"
"SCPTBASE";"S";"0083";"*** Calcul milieu de plage si vide pour 1 vacation"
"SCPTBASE";"S";"0084";"SI HJOU_IJIGBADGEA <> ""1"""
"SCPTBASE";"S";"0085";"   SI LOCA_HRMIDI = LOCA_NULL"
"SCPTBASE";"S";"0086";"   OU LOCA_HRMIDI = 0.00"
"SCPTBASE";"S";"0087";"      SI HJOU_IJQMVTENT1 <> HJOU_IJQMVTSOR1"
"SCPTBASE";"S";"0088";"         SI HJOU_IJQMVTENT2 = HJOU_IJQMVTSOR2"
"SCPTBASE";"S";"0089";"            SI PROF_ABSENM > 0"
"SCPTBASE";"S";"0090";"               SI PROF_ABSENS > 0"
"SCPTBASE";"S";"0091";"                  LOCA_HRMIDI = HJOU_IJQMVTENT1 + HJOU_IJQMVTSOR1"
"SCPTBASE";"S";"0092";"                  LOCA_HRMIDI = LOCA_HRMIDI / 2"
"SCPTBASE";"S";"0093";"               FINSI"
"SCPTBASE";"S";"0094";"            FINSI"
"SCPTBASE";"S";"0095";"         FINSI"
"SCPTBASE";"S";"0096";"      FINSI"
"SCPTBASE";"S";"0097";"   FINSI"
"SCPTBASE";"S";"0098";"FINSI"
"SCPTBASE";"S";"0099";"*"
"SCPTBASE";"S";"0100";"**** alimentation avec les compteurs V2"
"SCPTBASE";"S";"0101";"*"
"SCPTBASE";"S";"0102";"HJOU_SJQHTENT1 = HJOU_IJQMVTENT1"
"SCPTBASE";"S";"0103";"HJOU_SJQHTENT2 = HJOU_IJQMVTENT2"
"SCPTBASE";"S";"0104";"HJOU_SJQHTENT3 = HJOU_IJQMVTENT3"
"SCPTBASE";"S";"0105";"HJOU_SJQHTENT4 = HJOU_IJQMVTENT4"
"SCPTBASE";"S";"0106";"HJOU_SJQHTENT5 = HJOU_IJQMVTENT5"
"SCPTBASE";"S";"0107";"HJOU_SJQHTSOR1 = HJOU_IJQMVTSOR1"
"SCPTBASE";"S";"0108";"HJOU_SJQHTSOR2 = HJOU_IJQMVTSOR2"
"SCPTBASE";"S";"0109";"HJOU_SJQHTSOR3 = HJOU_IJQMVTSOR3"
