"SGRJF";"S";"0065";"* Déclaration des donnees locales"
"SGRJF";"S";"0066";"*"
"SGRJF";"S";"0067";"DEF LOCA_DROIT N2"
"SGRJF";"S";"0068";"LOCA_DROIT = 0"
"SGRJF";"S";"0069";"DEF LOCA_MOT N2"
"SGRJF";"S";"0070";"LOCA_MOT = 0"
"SGRJF";"S";"0071";"DEF LOCA_PRIS N6.2"
"SGRJF";"S";"0072";"LOCA_PRIS = 0"
"SGRJF";"S";"0073";"DEF LOCA_PERCO N6.2"
"SGRJF";"S";"0074";"LOCA_PERCO = 0"
"SGRJF";"S";"0075";"DEF LOCA_PRISW N6.2"
"SGRJF";"S";"0076";"LOCA_PRISW = 0"
"SGRJF";"S";"0077";"DEF LOCA_PERCOW N6.2"
"SGRJF";"S";"0078";"LOCA_PERCOW = 0"
"SGRJF";"S";"0079";"DEF LOCA_FERI N2"
"SGRJF";"S";"0080";"LOCA_FERI = 0"
"SGRJF";"S";"0081";"DEF LOCA_DRJF N6.2"
"SGRJF";"S";"0082";"LOCA_DRJF = 0"
"SGRJF";"S";"0083";"DEF LOCA_ABS N2"
"SGRJF";"S";"0084";"LOCA_ABS = 0"
"SGRJF";"S";"0085";"* TYPACQ : 1 = Acquisition au fil de l'eau / 2 = Acquistion dés le 1° jour au forfait"
"SGRJF";"S";"0086";"DEF LOCA_TYPACQ N2"
"SGRJF";"S";"0087";"LOCA_TYPACQ = 0"
"SGRJF";"S";"0088";"*"
"SGRJF";"S";"0089";"DEF LOCA_DEB D"
"SGRJF";"S";"0090";"LOCA_DEB(5:4) = ""0101"""
"SGRJF";"S";"0091";"DEF LOCA_FIN D"
"SGRJF";"S";"0092";"LOCA_FIN(5:4) = ""1231"""
"SGRJF";"S";"0093";"DEF LOCA_NBJI N6.2"
"SGRJF";"S";"0094";"LOCA_NBJI = 0"
"SGRJF";"S";"0095";"DEF LOCA_COEFFI N8.5"
"SGRJF";"S";"0096";"LOCA_COEFFI = 0"
"SGRJF";"S";"0097";"DEF LOCA_DRJFI N8.4"
"SGRJF";"S";"0098";"LOCA_DRJFI = 0"
"SGRJF";"S";"0099";"DEF LOCA_ACQRJF N9.5"
"SGRJF";"S";"0100";"LOCA_ACQRJF = 0"
"SGRJF";"S";"0101";"DEF LOCA_JS N2"
"SGRJF";"S";"0102";"LOCA_JS = 0"
"SGRJF";"S";"0103";"*"
"SGRJF";"S";"0104";"DEF LOCA_DATE D"
"SGRJF";"S";"0105";"LOCA_DATE(5:4) = ""0101"""
"SGRJF";"S";"0106";"DEF LOCA_DATEFU D"
"SGRJF";"S";"0107";"LOCA_DATEFU(5:4) = ""0101"""
"SGRJF";"S";"0108";"DEF LOCA_ANNEE N4"
"SGRJF";"S";"0109";"LOCA_ANNEE << TEMP_DATJOU(1:4)"
"SGRJF";"S";"0110";"LOCA_DATE(1:4) << LOCA_ANNEE"
"SGRJF";"S";"0111";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SGRJF";"S";"0112";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SGRJF";"S";"0113";"*"
"SGRJF";"S";"0114";"DEF LOCA_VALAROND N6.2"
"SGRJF";"S";"0115";"LOCA_VALAROND = 0"
"SGRJF";"S";"0116";"DEF LOCA_RESTE N6.2"
"SGRJF";"S";"0117";"LOCA_RESTE = 0"
"SGRJF";"S";"0118";"DEF LOCA_ENTIER N6.2"
"SGRJF";"S";"0119";"LOCA_ENTIER = 0"
"SGRJF";"S";"0120";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGRJF";"S";"0121";"DEF LOCA_TYPARROND N2"
"SGRJF";"S";"0122";"LOCA_TYPARROND = 1"
"SGRJF";"S";"0123";"*"
"SGRJF";"S";"0124";"DEF LOCA_SEUIL N2"
"SGRJF";"S";"0125";"LOCA_SEUIL = 0"
"SGRJF";"S";"0126";"*"
"SGRJF";"S";"0127";"* Droit RJF par défaut 10 jours"
"SGRJF";"S";"0128";"DEF LOCA_DRJFDFT N6.2"
"SGRJF";"S";"0129";"LOCA_DRJFDFT = 10.00"
"SGRJF";"S";"0130";"*"
"SGRJF";"S";"0131";"*"
"SGRJF";"S";"0132";"* Société MO >>"
"SGRJF";"S";"0133";"SI HJOU_SJQSOCIETE = ""MO"""
"SGRJF";"S";"0134";"   LOCA_DRJFDFT = PARD_SDIDRJFMO"
"SGRJF";"S";"0135";"FINSI"
"SGRJF";"S";"0136";"* Société PC >>"
"SGRJF";"S";"0137";"SI HJOU_SJQSOCIETE = ""PC"""
"SGRJF";"S";"0138";"   LOCA_DRJFDFT = PARD_SDIDRJFPC"
"SGRJF";"S";"0139";"FINSI"
"SGRJF";"S";"0140";"* Société YR >>"
"SGRJF";"S";"0141";"SI HJOU_SJQSOCIETE = ""YR"""
"SGRJF";"S";"0142";"   LOCA_DRJFDFT = PARD_SDIDRJFYR"
"SGRJF";"S";"0143";"FINSI"
"SGRJF";"S";"0144";"* Société RC >>"
"SGRJF";"S";"0145";"SI HJOU_SJQSOCIETE = ""RC"""
"SGRJF";"S";"0146";"   LOCA_DRJFDFT = PARD_SDIDRJFRC"
"SGRJF";"S";"0147";"FINSI"
"SGRJF";"S";"0148";"*"
"SGRJF";"S";"0149";"POUR ACTIVITES"
"SGRJF";"S";"0150";"* Motif férié >>"
"SGRJF";"S";"0151";"   SI HABS_MOTIF = ""JF"""
"SGRJF";"S";"0152";"      LOCA_FERI = 1"
"SGRJF";"S";"0153";"   FINSI"
"SGRJF";"S";"0154";"* Journée de solidarité"
"SGRJF";"S";"0155";"   SI HABS_MOTIF = ""JSOL"""
"SGRJF";"S";"0156";"      LOCA_JS = 1"
"SGRJF";"S";"0157";"   FINSI"
"SGRJF";"S";"0158";"* Motif d'absence réduisant RJF"
"SGRJF";"S";"0159";"   SI HABS_MOTYPE = ""A"""
"SGRJF";"S";"0160";"      SI MOTI_SMIABATRTT = ""1"""
"SGRJF";"S";"0161";"      OU MOTI_SMIABATRTT = ""2"""
"SGRJF";"S";"0162";"         LOCA_ABS = 1"
"SGRJF";"S";"0163";"      FINSI"
"SGRJF";"S";"0164";"   FINSI"
"SGRJF";"S";"0165";"*"
"SGRJF";"S";"0166";"FINPOUR"
"SGRJF";"S";"0167";"*"
"SGRJF";"S";"0168";"* RAZ début d'année"
"SGRJF";"S";"0169";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGRJF";"S";"0170";"   HJOU_SJRACQRJF = 0"
"SGRJF";"S";"0171";"   HJOU_SJRDRJF = 0"
"SGRJF";"S";"0172";"* RAZ du pris"
"SGRJF";"S";"0173";"   HJOU_SJRCRJF = 0"
"SGRJF";"S";"0174";"   HJOU_SJRSRJF = HJOU_SJRDRJF - HJOU_SJRCRJF"
"SGRJF";"S";"0175";"FINSI"
"SGRJF";"S";"0176";"*"
"SGRJF";"S";"0177";"***** Définition du droit annuel de RJF >> *********************************************************"
"SGRJF";"S";"0178";"*"
"SGRJF";"S";"0179";"* On exclut forfait jour"
"SGRJF";"S";"0180";"* SI HJOU_SJQFORFJR <> ""1"""
"SGRJF";"S";"0181";"*"
"SGRJF";"S";"0182";"***** Si Journaliste >>"
"SGRJF";"S";"0183";"SI HJOU_SJQCATEGOR = ""J"""
"SGRJF";"S";"0184";"   LOCA_DROIT = 1"
"SGRJF";"S";"0185";"   SI HJOU_SJQSOCIETE = ""MO"""
"SGRJF";"S";"0186";"* Acquis au forfait"
"SGRJF";"S";"0187";"      LOCA_TYPACQ = 2"
"SGRJF";"S";"0188";"      LOCA_DRJF = PARD_SDIDRJFMOJ"
"SGRJF";"S";"0189";"   SINON"
"SGRJF";"S";"0190";"* Acquis au fil de l'eau"
"SGRJF";"S";"0191";"      LOCA_TYPACQ = 1"
"SGRJF";"S";"0192";"      LOCA_DRJF = PARD_SDIDRJFJL"
"SGRJF";"S";"0193";"   FINSI"
"SGRJF";"S";"0194";"SINON"
"SGRJF";"S";"0195";"*"
"SGRJF";"S";"0196";"***** Autre population que Journaliste >>"
"SGRJF";"S";"0197";"*"
"SGRJF";"S";"0198";"* On exclut forfait jour"
"SGRJF";"S";"0199";"   SI HJOU_SJQFORFJR <> ""1"""
"SGRJF";"S";"0200";"* Si calendrier de jour férié travaillé"
"SGRJF";"S";"0201";"      SI HORC_SHICALEND <> "" """
"SGRJF";"S";"0202";"*"
"SGRJF";"S";"0203";"* JJA - 18/07/2025 - FFT RJF pour E et S de la rédaction >>"
"SGRJF";"S";"0204";"*"
"SGRJF";"S";"0205";"         SI HJOU_SECTORI(1:3) = ""RED"""
"SGRJF";"S";"0206";"            SI HJOU_SJQCATEGOR = ""E"""
"SGRJF";"S";"0207";"            OU HJOU_SJQCATEGOR = ""S"""
"SGRJF";"S";"0208";"*"
"SGRJF";"S";"0209";"               LOCA_DROIT = 1"
"SGRJF";"S";"0210";"               SI HJOU_SJQSOCIETE = ""MO"""
"SGRJF";"S";"0211";"* Acquis au forfait"
"SGRJF";"S";"0212";"                  LOCA_TYPACQ = 2"
"SGRJF";"S";"0213";"                  LOCA_DRJF = PARD_SDIDRJFMOJ"
"SGRJF";"S";"0214";"               SINON"
"SGRJF";"S";"0215";"* Acquis au fil de l'eau"
"SGRJF";"S";"0216";"                  LOCA_TYPACQ = 1"
"SGRJF";"S";"0217";"                  LOCA_DRJF = PARD_SDIDRJFJL"
"SGRJF";"S";"0218";"               FINSI"
"SGRJF";"S";"0219";"*"
"SGRJF";"S";"0220";"            FINSI"
"SGRJF";"S";"0221";"         FINSI"
"SGRJF";"S";"0222";"*"
"SGRJF";"S";"0223";"* JJA - 18/07/2025 - FFT <<"
"SGRJF";"S";"0224";"*"
"SGRJF";"S";"0225";"* Si INDUSTRIE, Infographie ou PFI de la montagne  >>"
"SGRJF";"S";"0226";"* Acquis au forfait"
"SGRJF";"S";"0227";"         SI HJOU_SECTORI(1:3) = ""DIN"""
"SGRJF";"S";"0228";"         OU HJOU_SJITYPSERV = ""INFOGRAPHIE"""
"SGRJF";"S";"0229";"         OU HJOU_SJITYPSERV = ""HORS-SERIE"""
"SGRJF";"S";"0230";"         OU HJOU_SJITYPSERV = ""PFI"""
"SGRJF";"S";"0231";"         OU HJOU_SJITYPSERV = ""TDC"""
"SGRJF";"S";"0232";"* Si service donne droit"
"SGRJF";"S";"0233";"            SI SECH_SSIGRJF = ""1"""
"SGRJF";"S";"0234";"*"
"SGRJF";"S";"0235";"* Société MO >>"
"SGRJF";"S";"0236";"               SI HJOU_SJQSOCIETE = ""MO"""
"SGRJF";"S";"0237";"                  LOCA_DROIT = 1"
"SGRJF";"S";"0238";"                  SI HJOU_SJITYPSERV = ""TDC"""
"SGRJF";"S";"0239";"                     LOCA_TYPACQ = 1"
"SGRJF";"S";"0240";"                  SINON"
"SGRJF";"S";"0241";"                     LOCA_TYPACQ = 2"
"SGRJF";"S";"0242";"                  FINSI"
"SGRJF";"S";"0243";"                  LOCA_DRJF = PARD_SDIDRJFMO"
"SGRJF";"S";"0244";"*"
"SGRJF";"S";"0245";"               FINSI"
"SGRJF";"S";"0246";"* Si PFI"
"SGRJF";"S";"0247";"               SI HJOU_SJITYPSERV = ""PFI"""
"SGRJF";"S";"0248";"               OU HJOU_SJITYPSERV = ""HORS-SERIE"""
"SGRJF";"S";"0249";"* Société PC >>"
"SGRJF";"S";"0250";"                  SI HJOU_SJQSOCIETE = ""PC"""
"SGRJF";"S";"0251";"                     LOCA_DROIT = 1"
"SGRJF";"S";"0252";"                     LOCA_TYPACQ = 2"
"SGRJF";"S";"0253";"                     LOCA_DRJF = PARD_SDIDRJFPC"
"SGRJF";"S";"0254";"                  FINSI"
"SGRJF";"S";"0255";"* Société YR >>"
"SGRJF";"S";"0256";"                  SI HJOU_SJQSOCIETE = ""YR"""
"SGRJF";"S";"0257";"                     LOCA_DROIT = 1"
"SGRJF";"S";"0258";"                     LOCA_TYPACQ = 2"
"SGRJF";"S";"0259";"                     LOCA_DRJF = PARD_SDIDRJFYR"
"SGRJF";"S";"0260";"                  FINSI"
"SGRJF";"S";"0261";"* Société RC >>"
"SGRJF";"S";"0262";"                  SI HJOU_SJQSOCIETE = ""RC"""
"SGRJF";"S";"0263";"                     LOCA_DROIT = 1"
"SGRJF";"S";"0264";"                     LOCA_TYPACQ = 2"
"SGRJF";"S";"0265";"                     LOCA_DRJF = PARD_SDIDRJFRC"
"SGRJF";"S";"0266";"                  FINSI"
"SGRJF";"S";"0267";"               FINSI"
