"SGASTR";"S";"0538";"   FINSI"
"SGASTR";"S";"0539";"   SI HABS_MOTIF = ""ZP5219"""
"SGASTR";"S";"0540";"      HJOU_SJQPRPERM = HABS_MOTINBR"
"SGASTR";"S";"0541";"   FINSI"
"SGASTR";"S";"0542";"   SI HABS_MOTIF = ""ZP5227"""
