"SCPTBASE";"S";"0283";"FINPOUR"
"SCPTBASE";"S";"0284";"*"
"SCPTBASE";"S";"0285";"**** Déduction des absence en heure"
"SCPTBASE";"S";"0286";"*"
"SCPTBASE";"S";"0287";"POUR ACTIVITES"
"SCPTBASE";"S";"0288";"   SI MOTI_MOTYPE = ""A"""
"SCPTBASE";"S";"0289";"      SI HABS_VALORIS = ""H"""
"SCPTBASE";"S";"0290";"         SI MOTI_IMIGTTEFFE <> ""1"""
"SCPTBASE";"S";"0291";"            SI HABS_HRAFIN > 0"
"SCPTBASE";"S";"0292";"               SI HABS_HRAFIN <> LOCA_NULL"
"SCPTBASE";"S";"0293";"                  LOCA_HF = HABS_HRAFIN"
"SCPTBASE";"S";"0294";"                  LOCA_HD = HABS_HRADEB"
"SCPTBASE";"S";"0295";"                  SI HJOU_SJQHTENT1 > 0"
"SCPTBASE";"S";"0296";"                     SI LOCA_HD >= HJOU_SJQHTENT1"
"SCPTBASE";"S";"0297";"                        SI LOCA_HD < HJOU_SJQHTSOR1"
"SCPTBASE";"S";"0298";"                           SI LOCA_HF > HJOU_SJQHTSOR1"
"SCPTBASE";"S";"0299";"                              HJOU_SJQHTSOR1 = LOCA_HD"
"SCPTBASE";"S";"0300";"                           SINON"
