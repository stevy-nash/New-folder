"ICUMUL";"S";"0030";"*"
"ICUMUL";"S";"0031";"* Implémentation des données industrielles"
"ICUMUL";"S";"0032";"*"
"ICUMUL";"S";"0033";"DEBDICO"
"ICUMUL";"S";"0034";"   HJOU_IJRPRESBAH;N;T6,2;I;;;     6789;;IJRPRESBAH;V3;""Présence badgée hebdomadaire"";"
"ICUMUL";"S";"0035";"   HJOU_IJRBHORVAH;N;T6,2;I;;;     6789;;IJRBHORVAH;V3;""Heures totales hebdomadaires"";"
"ICUMUL";"S";"0036";"   HJOU_IJRTTEFFEH;N;T6,2;I;;;     6789;;IJRTTEFFEH;V3;""Heures effectives hebdomadaires"";"
"ICUMUL";"S";"0037";"   HJOU_IJRPRETHEH;N;T6,2;I;;;     6789;;IJRPRETHEH;V3;""Théorie hebdomadaire"";"
"ICUMUL";"S";"0038";"   HJOU_IJRNJTRAVH;N;N4,1;I;;;    56789;;IJRNJTRAVH;V3;""Nbre de jours travaillés hebdomadaires"";"
"ICUMUL";"S";"0039";"   HJOU_IJRNABSPFH;N;N2;I;;;     6789;;IJRNABSPFH;V3;""Nbre de retards hebdomadaires"";"
"ICUMUL";"S";"0040";"   HJOU_IJRNJPRESH;N;N4,1;I;;;    56789;;IJRNJPRESH;V3;""Nbre de jours de présence hebdomadaires"";"
"ICUMUL";"S";"0041";"   HJOU_IJRABSPLFH;N;T6,2;I;;;     6789;;IJRABSPLFH;V3;""Total absences plages hebdomadaires"";"
"ICUMUL";"S";"0042";"   HJOU_IJRPRESNBH;N;T6,2;I;;;    56789;;IJRPRESNBH;V3;""Activités créditées hebdomadaires"";"
"ICUMUL";"S";"0043";"   HJOU_IJRBHORVHR;N;T6,2;I;;;    56789;;IJRBHORVAH;V3;""Report base HV hebdo"";"
"ICUMUL";"S";"0044";"   HJOU_IJIGCDTYPP;O;Z1;X;;;123456789;L;;C2;""Période de traitement"";"
"ICUMUL";"S";"0045";"   HJOU_IJRNJTRAVA;N;N5,1;I;;;    56789;;IJRNJTRAVA;V3;""Nbre de jours travaillés annuel"";"
"ICUMUL";"S";"0046";"   HJOU_IJRNJPRESA;N;N5,1;I;;;    56789;;IJRNJPRESA;V3;""Nbre de jours de présence annuel"";"
"ICUMUL";"S";"0047";"   HJOU_IJRPRESBAM;N;T6,2;I;;;     6789;;IJRPRESBAM;V3;""Présence badgée période"";"
"ICUMUL";"S";"0048";"   HJOU_IJRPRESNBM;N;T6,2;I;;;    56789;;IJRPRESNBM;V3;""Activités créditées période"";"
"ICUMUL";"S";"0049";"   HJOU_IJRTTREFFM;N;T8,2;L;;;     6789;;IJRTTREFFM;V3;""Heures totales période"";"
"ICUMUL";"S";"0050";"   HJOU_IJRTTEFFEM;N;T8,2;L;;;     6789;;IJRTTEFFEM;V3;""Heures effectives période"";"
"ICUMUL";"S";"0051";"   HJOU_IJRPRETHEM;N;T8,2;L;;;     6789;;IJRPRETHEM;V3;""Théorie période"";"
"ICUMUL";"S";"0052";"   HJOU_IJRVCTANNM;N;T6,2;I;;;     6789;;IJRVCTANNM;V3;""Contrat périodique"";"
"ICUMUL";"S";"0053";"   HJOU_IJRABSPLFM;N;T6,2;I;;;     6789;;IJRABSPLFM;V3;""Total absences plages période"";"
"ICUMUL";"S";"0054";"   HJOU_IJRNABSPFM;N;N2;I;;;     6789;;IJRNABSPFM;V3;""Nbre de retards période"";"
"ICUMUL";"S";"0055";"   HJOU_IJQNJPRESJ;N;N4,1;I;;;    56789;;;V3;""Nombre de jours de présence jour"";"
"ICUMUL";"S";"0056";"   HJOU_IJRNJPRESP;N;N4,1;I;;;    56789;;IJRNJPRESP;V3;""Nbre de jours de présence période"";"
"ICUMUL";"S";"0057";"   HJOU_IJQNJTRAVJ;N;N4,1;I;;;    56789;;;V3;""Nombre de jours travaillés jour"";"
"ICUMUL";"S";"0058";"   HJOU_IJRNJTRAVM;N;N4,1;I;;;     6789;;IJRNJTRAVM;V3;""Nbre de jours travaillés période"";"
"ICUMUL";"S";"0059";"   HJOU_IJRBHORVMR;N;T8,2;L;;;    56789;;IJRTTREFFM;V3;""Report base HV mensuelle"";"
"ICUMUL";"S";"0060";"   EMPL_IEQPRNJTRA;N;N5,1;I;;;    56789;;;V3;""Nbre de jours travaillés annuel prév."";"
"ICUMUL";"S";"0061";"   HJOU_IJRNJTRMCP;N;N4,1;I;;;     6789;;IJRNJTRMCP;V3;""Nbr jours trav. mens. pour acquis CP"";"
"ICUMUL";"S";"0062";"   TEMP_ITQNBJTRAV;N;N3,1;I;;;      789;;;V3;""Nbr délég. à déduire jours trav. annuels"";"
"ICUMUL";"S";"0063";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"ICUMUL";"S";"0064";"FINDICO"
"ICUMUL";"S";"0065";"*"
"ICUMUL";"S";"0066";"* Déclaration des donnees locales"
"ICUMUL";"S";"0067";"*"
"ICUMUL";"S";"0068";"* theorie demi-journ?e"
"ICUMUL";"S";"0069";"DEF LOCA_DEMIJ T6.2"
"ICUMUL";"S";"0070";"LOCA_DEMIJ = HJOU_IJQPRETHEJ / 2"
"ICUMUL";"S";"0071";"LOCA_DEMIJ = LOCA_DEMIJ + 2"
"ICUMUL";"S";"0072";"*  RAZ des compteurs hebdo"
"ICUMUL";"S";"0073";"SI HJOU_JOUR = ""1"""
"ICUMUL";"S";"0074";"   HJOU_IJRPRESBAH = 0"
"ICUMUL";"S";"0075";"   HJOU_IJRBHORVAH = 0"
"ICUMUL";"S";"0076";"   HJOU_IJRTTEFFEH = 0"
"ICUMUL";"S";"0077";"   HJOU_IJRPRETHEH = 0"
"ICUMUL";"S";"0078";"   HJOU_IJRNJTRAVH = 0"
"ICUMUL";"S";"0079";"   HJOU_IJRNABSPFH = 0"
"ICUMUL";"S";"0080";"   HJOU_IJRNJPRESH = 0"
"ICUMUL";"S";"0081";"   HJOU_IJRABSPLFH = 0"
"ICUMUL";"S";"0082";"   HJOU_IJRPRESNBH = 0"
"ICUMUL";"S";"0083";"   HJOU_IJRBHORVHR = 0"
"ICUMUL";"S";"0084";"FINSI"
"ICUMUL";"S";"0085";"*  cumul des compteurs hebdo"
"ICUMUL";"S";"0086";"*"
"ICUMUL";"S";"0087";"*  presence badg?e"
"ICUMUL";"S";"0088";"HJOU_IJRPRESBAH = HJOU_IJRPRESBAH + HJOU_IJQPRESBAJ"
"ICUMUL";"S";"0089";"*  Activites credites"
"ICUMUL";"S";"0090";"HJOU_IJRPRESNBH = HJOU_IJRPRESNBH + HJOU_IJQPRESNBJ"
"ICUMUL";"S";"0091";"*  heures totales"
"ICUMUL";"S";"0092";"HJOU_IJRBHORVAH = HJOU_IJRBHORVAH + HJOU_IJQBHORVAJ"
"ICUMUL";"S";"0093";"*  travail effectif"
"ICUMUL";"S";"0094";"HJOU_IJRTTEFFEH = HJOU_IJRTTEFFEH + HJOU_IJQTTEFFEJ"
"ICUMUL";"S";"0095";"*  theorie profil"
"ICUMUL";"S";"0096";"HJOU_IJRPRETHEH = HJOU_IJRPRETHEH + HJOU_IJQPRETHEJ"
"ICUMUL";"S";"0097";"*  nombre de retards"
"ICUMUL";"S";"0098";"HJOU_IJRNABSPFH = HJOU_IJRNABSPFH + HJOU_IJQNABSPFI"
"ICUMUL";"S";"0099";"*  absence plage fixe"
"ICUMUL";"S";"0100";"HJOU_IJRABSPLFH = HJOU_IJRABSPLFH + HJOU_IJQABSPLFJ"
"ICUMUL";"S";"0101";"*"
"ICUMUL";"S";"0102";"* RAZ des compteurs p?riodoques"
"ICUMUL";"S";"0103";"* dans le cas ou la periode de traitement est"
"ICUMUL";"S";"0104";"* hebdomadaire ou mensuel, les compteurs periodiques sont remis ? 0"
"ICUMUL";"S";"0105";"* le 1er de chaque mois sinon ils sont reinitialises le 1er jour"
"ICUMUL";"S";"0106";"* de la periode"
"ICUMUL";"S";"0107";"*"
"ICUMUL";"S";"0108";"SI HJOU_IJIGCDTYPP = ""1"""
"ICUMUL";"S";"0109";"OU HJOU_IJIGCDTYPP = ""5"""
"ICUMUL";"S";"0110";"OU HJOU_IJIGCDTYPP = ""2"""
"ICUMUL";"S";"0111";"OU HJOU_IJIGCDTYPP = ""4"""
"ICUMUL";"S";"0112";"   SI HJOU_DATE(7:2) = ""01"""
"ICUMUL";"S";"0113";"      FAIRE RAZCPT"
"ICUMUL";"S";"0114";"   FINSI"
"ICUMUL";"S";"0115";"FINSI"
"ICUMUL";"S";"0116";"* le compteur IJRNJTRMCP correspond au nombre de jour travaillés"
"ICUMUL";"S";"0117";"* mensuel. Il est réinitialisé à 0 le 1er de chaque mois quel que soit le type"
"ICUMUL";"S";"0118";"* de traitement."
"ICUMUL";"S";"0119";"SI HJOU_DATE(7:2) = ""01"""
"ICUMUL";"S";"0120";"   HJOU_IJRNJTRMCP = 0"
"ICUMUL";"S";"0121";"FINSI"
"ICUMUL";"S";"0122";"*"
"ICUMUL";"S";"0123";"SI HJOU_IJIGCDTYPP = ""3"""
"ICUMUL";"S";"0124";"   POUR ACTIVITES"
"ICUMUL";"S";"0125";"      SI HABS_MOTIF = ""FINP"""
"ICUMUL";"S";"0126";"         FAIRE RAZCPT"
"ICUMUL";"S";"0127";"      FINSI"
"ICUMUL";"S";"0128";"   FINPOUR"
"ICUMUL";"S";"0129";"FINSI"
"ICUMUL";"S";"0130";"*"
"ICUMUL";"S";"0131";"* RAZ des compteurs annuels"
"ICUMUL";"S";"0132";"*"
"ICUMUL";"S";"0133";"*"
"ICUMUL";"S";"0134";"SI PARD_IDIDDEBANN <> "" """
"ICUMUL";"S";"0135";"   SI HJOU_DATE = PARD_IDIDDEBANN"
"ICUMUL";"S";"0136";"      HJOU_IJRNJTRAVA = 0"
"ICUMUL";"S";"0137";"      HJOU_IJRNJPRESA = 0"
"ICUMUL";"S";"0138";"      FAIRE RAZCPT"
"ICUMUL";"S";"0139";"   FINSI"
"ICUMUL";"S";"0140";"SINON"
"ICUMUL";"S";"0141";"   SI HJOU_DATE(5:4) = ""0101"""
"ICUMUL";"S";"0142";"      HJOU_IJRNJTRAVA = 0"
"ICUMUL";"S";"0143";"      HJOU_IJRNJPRESA = 0"
"ICUMUL";"S";"0144";"   FINSI"
"ICUMUL";"S";"0145";"FINSI"
"ICUMUL";"S";"0146";"*"
"ICUMUL";"S";"0147";"* cumul des compteurs mois"
"ICUMUL";"S";"0148";"*"
"ICUMUL";"S";"0149";"* presence badgee"
"ICUMUL";"S";"0150";"HJOU_IJRPRESBAM = HJOU_IJRPRESBAM + HJOU_IJQPRESBAJ"
"ICUMUL";"S";"0151";"* Activites credites"
"ICUMUL";"S";"0152";"HJOU_IJRPRESNBM = HJOU_IJRPRESNBM + HJOU_IJQPRESNBJ"
"ICUMUL";"S";"0153";"* heures totales"
"ICUMUL";"S";"0154";"HJOU_IJRTTREFFM = HJOU_IJRTTREFFM + HJOU_IJQBHORVAJ"
"ICUMUL";"S";"0155";"* travail effectif"
"ICUMUL";"S";"0156";"HJOU_IJRTTEFFEM = HJOU_IJRTTEFFEM + HJOU_IJQTTEFFEJ"
"ICUMUL";"S";"0157";"* theorie profil"
"ICUMUL";"S";"0158";"HJOU_IJRPRETHEM = HJOU_IJRPRETHEM + HJOU_IJQPRETHEJ"
"ICUMUL";"S";"0159";"* theorie annuelle"
"ICUMUL";"S";"0160";"HJOU_IJRVCTANNM = HJOU_IJRVCTANNM + HJOU_PRECYCLE"
"ICUMUL";"S";"0161";"* heures retenues"
"ICUMUL";"S";"0162";"HJOU_IJRABSPLFM = HJOU_IJRABSPLFM + HJOU_IJQABSPLFJ"
"ICUMUL";"S";"0163";"* nb de retards"
"ICUMUL";"S";"0164";"HJOU_IJRNABSPFM = HJOU_IJRNABSPFM + HJOU_IJQNABSPFI"
"ICUMUL";"S";"0165";"*"
"ICUMUL";"S";"0166";"* cumul du nb de jours travaillés et du nombre de jours de presence"
"ICUMUL";"S";"0167";"*"
"ICUMUL";"S";"0168";"SI TEMP_ITQPRESJOU > 0"
"ICUMUL";"S";"0169";"   HJOU_IJQNJPRESJ = 1"
"ICUMUL";"S";"0170";"   HJOU_IJRNJPRESH = HJOU_IJRNJPRESH + 1"
"ICUMUL";"S";"0171";"   HJOU_IJRNJPRESP = HJOU_IJRNJPRESP + 1"
"ICUMUL";"S";"0172";"   HJOU_IJRNJPRESA = HJOU_IJRNJPRESA + 1"
"ICUMUL";"S";"0173";"FINSI"
"ICUMUL";"S";"0174";"SI HJOU_IJQTTEFFEJ >= LOCA_DEMIJ"
"ICUMUL";"S";"0175";"   HJOU_IJQNJTRAVJ = 1"
"ICUMUL";"S";"0176";"   HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA + 1"
"ICUMUL";"S";"0177";"   HJOU_IJRNJTRAVH = HJOU_IJRNJTRAVH + 1"
"ICUMUL";"S";"0178";"   HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM + 1"
"ICUMUL";"S";"0179";"   HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP + 1"
"ICUMUL";"S";"0180";"SINON"
"ICUMUL";"S";"0181";"   SI HJOU_IJQTTEFFEJ > 0"
"ICUMUL";"S";"0182";"      HJOU_IJQNJTRAVJ = 0.5"
"ICUMUL";"S";"0183";"      HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA + 0.5"
"ICUMUL";"S";"0184";"      HJOU_IJRNJTRAVH = HJOU_IJRNJTRAVH + 0.5"
"ICUMUL";"S";"0185";"      HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM + 0.5"
"ICUMUL";"S";"0186";"      HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP + 0.5"
"ICUMUL";"S";"0187";"   FINSI"
"ICUMUL";"S";"0188";"FINSI"
"ICUMUL";"S";"0189";"** déduction des demi-journée délégation"
"ICUMUL";"S";"0190";"HJOU_IJQNJTRAVJ = HJOU_IJQNJTRAVJ - TEMP_ITQNBJTRAV"
"ICUMUL";"S";"0191";"HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA - TEMP_ITQNBJTRAV"
"ICUMUL";"S";"0192";"HJOU_IJRNJTRAVH = HJOU_IJRNJTRAVH - TEMP_ITQNBJTRAV"
"ICUMUL";"S";"0193";"HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM - TEMP_ITQNBJTRAV"
"ICUMUL";"S";"0194";"HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP - TEMP_ITQNBJTRAV"
"ICUMUL";"S";"0195";"**"
"ICUMUL";"S";"0196";"* alimentation par consignes"
"ICUMUL";"S";"0197";"POUR ACTIVITES"
"ICUMUL";"S";"0198";"* jours travailles"
"ICUMUL";"S";"0199";"   SI HABS_MOTIF = ""XTRV"""
"ICUMUL";"S";"0200";"   OU HABS_MOTIF = ""ZTRV"""
"ICUMUL";"S";"0201";"      HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM - HJOU_IJRNJTRAVH"
"ICUMUL";"S";"0202";"      HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP - HJOU_IJRNJTRAVH"
"ICUMUL";"S";"0203";"      HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA - HJOU_IJRNJTRAVH"
"ICUMUL";"S";"0204";"      SI HABS_MOTIF = ""XTRV"""
"ICUMUL";"S";"0205";"         HJOU_IJRNJTRAVH = HJOU_IJRNJTRAVH + HABS_MOTINBR"
"ICUMUL";"S";"0206";"      FINSI"
"ICUMUL";"S";"0207";"      SI HABS_MOTIF = ""ZTRV"""
"ICUMUL";"S";"0208";"         HJOU_IJRNJTRAVH = HABS_MOTINBR"
"ICUMUL";"S";"0209";"      FINSI"
"ICUMUL";"S";"0210";"      SI HJOU_IJRNJTRAVH < 0"
"ICUMUL";"S";"0211";"         HJOU_IJRNJTRAVH = 0"
"ICUMUL";"S";"0212";"      FINSI"
"ICUMUL";"S";"0213";"      HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM + HJOU_IJRNJTRAVH"
"ICUMUL";"S";"0214";"      HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP + HJOU_IJRNJTRAVH"
"ICUMUL";"S";"0215";"      HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA + HJOU_IJRNJTRAVH"
"ICUMUL";"S";"0216";"   FINSI"
"ICUMUL";"S";"0217";"* jours de presence"
"ICUMUL";"S";"0218";"   SI HABS_MOTIF = ""XPRE"""
"ICUMUL";"S";"0219";"   OU HABS_MOTIF = ""ZPRE"""
"ICUMUL";"S";"0220";"      HJOU_IJRNJPRESP = HJOU_IJRNJPRESP - HJOU_IJRNJPRESH"
"ICUMUL";"S";"0221";"      HJOU_IJRNJPRESA = HJOU_IJRNJPRESA - HJOU_IJRNJPRESH"
"ICUMUL";"S";"0222";"      SI HABS_MOTIF = ""XPRE"""
"ICUMUL";"S";"0223";"         HJOU_IJRNJPRESH = HJOU_IJRNJPRESH + HABS_MOTINBR"
"ICUMUL";"S";"0224";"      FINSI"
"ICUMUL";"S";"0225";"      SI HABS_MOTIF = ""ZPRE"""
"ICUMUL";"S";"0226";"         HJOU_IJRNJPRESH = HABS_MOTINBR"
"ICUMUL";"S";"0227";"      FINSI"
"ICUMUL";"S";"0228";"      SI HJOU_IJRNJPRESH < 0"
"ICUMUL";"S";"0229";"         HJOU_IJRNJPRESH = 0"
"ICUMUL";"S";"0230";"      FINSI"
"ICUMUL";"S";"0231";"      HJOU_IJRNJPRESP = HJOU_IJRNJPRESP + HJOU_IJRNJPRESH"
"ICUMUL";"S";"0232";"      HJOU_IJRNJPRESA = HJOU_IJRNJPRESA + HJOU_IJRNJPRESH"
"ICUMUL";"S";"0233";"   FINSI"
"ICUMUL";"S";"0234";"FINPOUR"
"ICUMUL";"S";"0235";"** Alimentation di compteur des heures travaillées annuelles"
"ICUMUL";"S";"0236";"** le 20/03/07"
"ICUMUL";"S";"0237";"SI HJOU_DATE(1:4) = TEMP_DATJOU(1:4)"
"ICUMUL";"S";"0238";"   SI TEMP_DATSUI(5:4) = ""0101"""
"ICUMUL";"S";"0239";"      EMPL_IEQPRNJTRA = HJOU_IJRNJTRAVA"
"ICUMUL";"S";"0240";"   FINSI"
"ICUMUL";"S";"0241";"FINSI"
"ICUMUL";"S";"0242";"FIN"
"ICUMUL";"S";"0243";"*** procedure raz compteurs periodiques"
"ICUMUL";"S";"0244";"PROC RAZCPT"
"ICUMUL";"S";"0245";"   HJOU_IJRPRESBAM = 0"
"ICUMUL";"S";"0246";"   HJOU_IJRPRESNBM = 0"
"ICUMUL";"S";"0247";"   HJOU_IJRTTREFFM = 0"
"ICUMUL";"S";"0248";"   HJOU_IJRTTEFFEM = 0"
"ICUMUL";"S";"0249";"   HJOU_IJRPRETHEM = 0"
"ICUMUL";"S";"0250";"   HJOU_IJRVCTANNM = 0"
"ICUMUL";"S";"0251";"   HJOU_IJRNABSPFM = 0"
"ICUMUL";"S";"0252";"   HJOU_IJRABSPLFM = 0"
"ICUMUL";"S";"0253";"   HJOU_IJRNJTRAVM = 0"
"ICUMUL";"S";"0254";"   HJOU_IJRNJPRESP = 0"
"ICUMUL";"S";"0255";"   HJOU_IJRBHORVMR = 0"
"ICUMUL";"S";"0256";"FINPROC"
