"SCUMUL";"S";"0065";"*"
"SCUMUL";"S";"0066";"* Déclaration des donnees locales"
"SCUMUL";"S";"0067";"*"
"SCUMUL";"S";"0068";"* theorie demi-journ?e"
"SCUMUL";"S";"0069";"DEF LOCA_DEMIJ T6.2"
"SCUMUL";"S";"0070";"LOCA_DEMIJ = HJOU_IJQPRETHEJ / 2"
"SCUMUL";"S";"0071";"LOCA_DEMIJ = LOCA_DEMIJ + 1.30"
"SCUMUL";"S";"0072";"*  RAZ des compteurs hebdo"
"SCUMUL";"S";"0073";"SI HJOU_JOUR = ""1"""
"SCUMUL";"S";"0074";"   HJOU_IJRPRESBAH = 0"
"SCUMUL";"S";"0075";"   HJOU_IJRBHORVAH = 0"
"SCUMUL";"S";"0076";"   HJOU_IJRTTEFFEH = 0"
"SCUMUL";"S";"0077";"   HJOU_IJRPRETHEH = 0"
"SCUMUL";"S";"0078";"   HJOU_IJRNJTRAVH = 0"
"SCUMUL";"S";"0079";"*   HJOU_IJRNABSPFH = 0"
"SCUMUL";"S";"0080";"   HJOU_IJRNJPRESH = 0"
"SCUMUL";"S";"0081";"   HJOU_IJRABSPLFH = 0"
"SCUMUL";"S";"0082";"   HJOU_IJRPRESNBH = 0"
"SCUMUL";"S";"0083";"   HJOU_IJRBHORVHR = 0"
"SCUMUL";"S";"0084";"FINSI"
"SCUMUL";"S";"0085";"*  cumul des compteurs hebdo"
"SCUMUL";"S";"0086";"*"
"SCUMUL";"S";"0087";"*  presence badg?e"
"SCUMUL";"S";"0088";"HJOU_IJRPRESBAH = HJOU_IJRPRESBAH + HJOU_IJQPRESBAJ"
"SCUMUL";"S";"0089";"*  Activites credites"
"SCUMUL";"S";"0090";"HJOU_IJRPRESNBH = HJOU_IJRPRESNBH + HJOU_IJQPRESNBJ"
"SCUMUL";"S";"0091";"*  heures totales"
"SCUMUL";"S";"0092";"HJOU_IJRBHORVAH = HJOU_IJRBHORVAH + HJOU_IJQBHORVAJ"
"SCUMUL";"S";"0093";"*  travail effectif"
"SCUMUL";"S";"0094";"HJOU_IJRTTEFFEH = HJOU_IJRTTEFFEH + HJOU_IJQTTEFFEJ"
"SCUMUL";"S";"0095";"*  theorie profil"
"SCUMUL";"S";"0096";"HJOU_IJRPRETHEH = HJOU_IJRPRETHEH + HJOU_IJQPRETHEJ"
"SCUMUL";"S";"0097";"*  nombre de retards"
"SCUMUL";"S";"0098";"* HJOU_IJRNABSPFH = HJOU_IJRNABSPFH + HJOU_IJQNABSPFI"
"SCUMUL";"S";"0099";"*  absence plage fixe"
"SCUMUL";"S";"0100";"HJOU_IJRABSPLFH = HJOU_IJRABSPLFH + HJOU_IJQABSPLFJ"
"SCUMUL";"S";"0101";"*"
"SCUMUL";"S";"0102";"* RAZ des compteurs p?riodoques"
"SCUMUL";"S";"0103";"* dans le cas ou la periode de traitement est"
"SCUMUL";"S";"0104";"* hebdomadaire ou mensuel, les compteurs periodiques sont remis ? 0"
"SCUMUL";"S";"0105";"* le 1er de chaque mois sinon ils sont reinitialises le 1er jour"
"SCUMUL";"S";"0106";"* de la periode"
"SCUMUL";"S";"0107";"*"
"SCUMUL";"S";"0108";"SI HJOU_IJIGCDTYPP = ""1"""
"SCUMUL";"S";"0109";"OU HJOU_IJIGCDTYPP = ""5"""
"SCUMUL";"S";"0110";"OU HJOU_IJIGCDTYPP = ""2"""
"SCUMUL";"S";"0111";"OU HJOU_IJIGCDTYPP = ""4"""
"SCUMUL";"S";"0112";"   SI HJOU_DATE(7:2) = ""01"""
"SCUMUL";"S";"0113";"      FAIRE RAZCPT"
"SCUMUL";"S";"0114";"   FINSI"
"SCUMUL";"S";"0115";"FINSI"
"SCUMUL";"S";"0116";"* le compteur IJRNJTRMCP correspond au nombre de jour travaillés"
"SCUMUL";"S";"0117";"* mensuel. Il est réinitialisé à 0 le 1er de chaque mois quel que soit le type"
"SCUMUL";"S";"0118";"* de traitement."
"SCUMUL";"S";"0119";"SI HJOU_DATE(7:2) = ""01"""
"SCUMUL";"S";"0120";"   HJOU_IJRNJTRMCP = 0"
"SCUMUL";"S";"0121";"FINSI"
"SCUMUL";"S";"0122";"*"
"SCUMUL";"S";"0123";"SI HJOU_IJIGCDTYPP = ""3"""
"SCUMUL";"S";"0124";"   POUR ACTIVITES"
"SCUMUL";"S";"0125";"      SI HABS_MOTIF = ""FINP"""
"SCUMUL";"S";"0126";"         FAIRE RAZCPT"
"SCUMUL";"S";"0127";"      FINSI"
"SCUMUL";"S";"0128";"   FINPOUR"
"SCUMUL";"S";"0129";"FINSI"
"SCUMUL";"S";"0130";"*"
"SCUMUL";"S";"0131";"* RAZ des compteurs annuels"
"SCUMUL";"S";"0132";"*"
"SCUMUL";"S";"0133";"*"
"SCUMUL";"S";"0134";"SI PARD_IDIDDEBANN <> "" """
"SCUMUL";"S";"0135";"   SI HJOU_DATE = PARD_IDIDDEBANN"
"SCUMUL";"S";"0136";"      HJOU_IJRNJTRAVA = 0"
"SCUMUL";"S";"0137";"      HJOU_IJRNJPRESA = 0"
"SCUMUL";"S";"0138";"      HJOU_IJRTTEPMOD = 0"
"SCUMUL";"S";"0139";"      FAIRE RAZCPT"
"SCUMUL";"S";"0140";"   FINSI"
"SCUMUL";"S";"0141";"SINON"
"SCUMUL";"S";"0142";"   SI HJOU_DATE(5:4) = ""0101"""
"SCUMUL";"S";"0143";"      HJOU_IJRNJTRAVA = 0"
"SCUMUL";"S";"0144";"      HJOU_IJRNJPRESA = 0"
"SCUMUL";"S";"0145";"      HJOU_IJRTTEPMOD = 0"
"SCUMUL";"S";"0146";"   FINSI"
"SCUMUL";"S";"0147";"FINSI"
"SCUMUL";"S";"0148";"*"
"SCUMUL";"S";"0149";"* cumul des compteurs mois"
"SCUMUL";"S";"0150";"*"
"SCUMUL";"S";"0151";"* presence badgee"
"SCUMUL";"S";"0152";"HJOU_IJRPRESBAM = HJOU_IJRPRESBAM + HJOU_IJQPRESBAJ"
"SCUMUL";"S";"0153";"* Activites credites"
"SCUMUL";"S";"0154";"HJOU_IJRPRESNBM = HJOU_IJRPRESNBM + HJOU_IJQPRESNBJ"
"SCUMUL";"S";"0155";"* heures totales"
"SCUMUL";"S";"0156";"HJOU_IJRTTREFFM = HJOU_IJRTTREFFM + HJOU_IJQBHORVAJ"
"SCUMUL";"S";"0157";"* travail effectif"
"SCUMUL";"S";"0158";"HJOU_IJRTTEFFEM = HJOU_IJRTTEFFEM + HJOU_IJQTTEFFEJ"
"SCUMUL";"S";"0159";"* theorie profil"
"SCUMUL";"S";"0160";"HJOU_IJRPRETHEM = HJOU_IJRPRETHEM + HJOU_IJQPRETHEJ"
"SCUMUL";"S";"0161";"* theorie annuelle"
"SCUMUL";"S";"0162";"* HJOU_IJRVCTANNM = HJOU_IJRVCTANNM + HJOU_PRECYCLE"
"SCUMUL";"S";"0163";"* travail effectiv annuel"
"SCUMUL";"S";"0164";"HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD + HJOU_IJQTTEFFEJ"
"SCUMUL";"S";"0165";"*"
"SCUMUL";"S";"0166";"* cumul du nb de jours travaillés et du nombre de jours de presence"
"SCUMUL";"S";"0167";"*"
"SCUMUL";"S";"0168";"SI TEMP_ITQPRESJOU > 0.02"
"SCUMUL";"S";"0169";"   HJOU_IJQNJPRESJ = 1"
"SCUMUL";"S";"0170";"   HJOU_IJRNJPRESH = HJOU_IJRNJPRESH + 1"
"SCUMUL";"S";"0171";"   HJOU_IJRNJPRESP = HJOU_IJRNJPRESP + 1"
"SCUMUL";"S";"0172";"   HJOU_IJRNJPRESA = HJOU_IJRNJPRESA + 1"
"SCUMUL";"S";"0173";"FINSI"
"SCUMUL";"S";"0174";"*"
"SCUMUL";"S";"0175";"* Nombres jours travaillé hors forfait jour >>"
"SCUMUL";"S";"0176";"*"
"SCUMUL";"S";"0177";"SI HJOU_SJQFORFJR <> ""1"""
"SCUMUL";"S";"0178";"   SI HJOU_IJQTTEFFEJ >= LOCA_DEMIJ"
"SCUMUL";"S";"0179";"      HJOU_IJQNJTRAVJ = 1"
"SCUMUL";"S";"0180";"   SINON"
"SCUMUL";"S";"0181";"      SI HJOU_IJQTTEFFEJ > 0.02"
"SCUMUL";"S";"0182";"         HJOU_IJQNJTRAVJ = 0.5"
"SCUMUL";"S";"0183";"      FINSI"
"SCUMUL";"S";"0184";"   FINSI"
"SCUMUL";"S";"0185";"FINSI"
"SCUMUL";"S";"0186";"*"
"SCUMUL";"S";"0187";"* Cas de TEVA"
"SCUMUL";"S";"0188";"SI HJOU_SJQSOCIETE = ""PO"""
"SCUMUL";"S";"0189";"   POUR ACTIVITES"
"SCUMUL";"S";"0190";"      SI HABS_MOTIF = ""POPRES"""
"SCUMUL";"S";"0191";"         SI HABS_VALORIS = ""J"""
"SCUMUL";"S";"0192";"            HJOU_IJQNJTRAVJ = 1"
"SCUMUL";"S";"0193";"         SINON"
"SCUMUL";"S";"0194";"            HJOU_IJQNJTRAVJ = 0.5"
"SCUMUL";"S";"0195";"         FINSI"
"SCUMUL";"S";"0196";"      FINSI"
"SCUMUL";"S";"0197";"   FINPOUR"
"SCUMUL";"S";"0198";"FINSI"
"SCUMUL";"S";"0199";"*"
"SCUMUL";"S";"0200";"HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA + HJOU_IJQNJTRAVJ"
"SCUMUL";"S";"0201";"HJOU_IJRNJTRAVH = HJOU_IJRNJTRAVH + HJOU_IJQNJTRAVJ"
"SCUMUL";"S";"0202";"HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM + HJOU_IJQNJTRAVJ"
"SCUMUL";"S";"0203";"HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP + HJOU_IJQNJTRAVJ"
"SCUMUL";"S";"0204";"*"
"SCUMUL";"S";"0205";"** déduction des demi-journée délégation"
"SCUMUL";"S";"0206";"HJOU_IJQNJTRAVJ = HJOU_IJQNJTRAVJ - TEMP_ITQNBJTRAV"
"SCUMUL";"S";"0207";"HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA - TEMP_ITQNBJTRAV"
"SCUMUL";"S";"0208";"HJOU_IJRNJTRAVH = HJOU_IJRNJTRAVH - TEMP_ITQNBJTRAV"
"SCUMUL";"S";"0209";"HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM - TEMP_ITQNBJTRAV"
"SCUMUL";"S";"0210";"HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP - TEMP_ITQNBJTRAV"
"SCUMUL";"S";"0211";"**"
"SCUMUL";"S";"0212";"* alimentation par consignes"
"SCUMUL";"S";"0213";"POUR ACTIVITES"
"SCUMUL";"S";"0214";"* jours travailles"
"SCUMUL";"S";"0215";"   SI HABS_MOTIF = ""XTRV"""
"SCUMUL";"S";"0216";"   OU HABS_MOTIF = ""ZTRV"""
"SCUMUL";"S";"0217";"      HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM - HJOU_IJRNJTRAVH"
"SCUMUL";"S";"0218";"      HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP - HJOU_IJRNJTRAVH"
"SCUMUL";"S";"0219";"      HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA - HJOU_IJRNJTRAVH"
"SCUMUL";"S";"0220";"      SI HABS_MOTIF = ""XTRV"""
"SCUMUL";"S";"0221";"         HJOU_IJRNJTRAVH = HJOU_IJRNJTRAVH + HABS_MOTINBR"
"SCUMUL";"S";"0222";"      FINSI"
"SCUMUL";"S";"0223";"      SI HABS_MOTIF = ""ZTRV"""
"SCUMUL";"S";"0224";"         HJOU_IJRNJTRAVH = HABS_MOTINBR"
"SCUMUL";"S";"0225";"      FINSI"
"SCUMUL";"S";"0226";"      SI HJOU_IJRNJTRAVH < 0"
"SCUMUL";"S";"0227";"         HJOU_IJRNJTRAVH = 0"
"SCUMUL";"S";"0228";"      FINSI"
"SCUMUL";"S";"0229";"      HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM + HJOU_IJRNJTRAVH"
"SCUMUL";"S";"0230";"      HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP + HJOU_IJRNJTRAVH"
"SCUMUL";"S";"0231";"      HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA + HJOU_IJRNJTRAVH"
"SCUMUL";"S";"0232";"   FINSI"
"SCUMUL";"S";"0233";"* jours de presence"
"SCUMUL";"S";"0234";"   SI HABS_MOTIF = ""XPRE"""
"SCUMUL";"S";"0235";"   OU HABS_MOTIF = ""ZPRE"""
"SCUMUL";"S";"0236";"      HJOU_IJRNJPRESP = HJOU_IJRNJPRESP - HJOU_IJRNJPRESH"
"SCUMUL";"S";"0237";"      HJOU_IJRNJPRESA = HJOU_IJRNJPRESA - HJOU_IJRNJPRESH"
"SCUMUL";"S";"0238";"      SI HABS_MOTIF = ""XPRE"""
"SCUMUL";"S";"0239";"         HJOU_IJRNJPRESH = HJOU_IJRNJPRESH + HABS_MOTINBR"
"SCUMUL";"S";"0240";"      FINSI"
"SCUMUL";"S";"0241";"      SI HABS_MOTIF = ""ZPRE"""
"SCUMUL";"S";"0242";"         HJOU_IJRNJPRESH = HABS_MOTINBR"
"SCUMUL";"S";"0243";"      FINSI"
"SCUMUL";"S";"0244";"      SI HJOU_IJRNJPRESH < 0"
"SCUMUL";"S";"0245";"         HJOU_IJRNJPRESH = 0"
"SCUMUL";"S";"0246";"      FINSI"
"SCUMUL";"S";"0247";"      HJOU_IJRNJPRESP = HJOU_IJRNJPRESP + HJOU_IJRNJPRESH"
"SCUMUL";"S";"0248";"      HJOU_IJRNJPRESA = HJOU_IJRNJPRESA + HJOU_IJRNJPRESH"
"SCUMUL";"S";"0249";"   FINSI"
"SCUMUL";"S";"0250";"   SI HABS_MOTIF = ""ZTRFJ"""
"SCUMUL";"S";"0251";"      HJOU_IJRNJTRAVA = HABS_MOTINBR"
"SCUMUL";"S";"0252";"   FINSI"
"SCUMUL";"S";"0253";"FINPOUR"
"SCUMUL";"S";"0254";"** Alimentation di compteur des heures travaillées annuelles"
"SCUMUL";"S";"0255";"** le 20/03/07"
"SCUMUL";"S";"0256";"SI HJOU_DATE(1:4) = TEMP_DATJOU(1:4)"
"SCUMUL";"S";"0257";"   SI TEMP_DATSUI(5:4) = ""0101"""
"SCUMUL";"S";"0258";"      EMPL_IEQPRNJTRA = HJOU_IJRNJTRAVA"
"SCUMUL";"S";"0259";"      EMPL_IEQTTREFFA = HJOU_IJRTTEPMOD"
"SCUMUL";"S";"0260";"   FINSI"
"SCUMUL";"S";"0261";"FINSI"
"SCUMUL";"S";"0262";"*"
"SCUMUL";"S";"0263";"* Collaborateur absent ?"
"SCUMUL";"S";"0264";"SI HJOU_IJQPRETHEJ > 0.02"
"SCUMUL";"S";"0265";"   SI HJOU_IJQTTEFFEJ = 0"
"SCUMUL";"S";"0266";"      POUR ACTIVITES"
"SCUMUL";"S";"0267";"         SI HABS_MOTYPE = ""A"""
"SCUMUL";"S";"0268";"            HJOU_SJQEMPABS = 1"
"SCUMUL";"S";"0269";"            HJOU_IJRCJDISP4 = 1"
"SCUMUL";"S";"0270";"         FINSI"
"SCUMUL";"S";"0271";"      FINPOUR"
"SCUMUL";"S";"0272";"   FINSI"
"SCUMUL";"S";"0273";"SINON"
"SCUMUL";"S";"0274";"   SI HJOU_IJQTTEFFEJ <= 0.02"
"SCUMUL";"S";"0275";"      HJOU_IJRCJDISP4 = 1"
"SCUMUL";"S";"0276";"   FINSI"
"SCUMUL";"S";"0277";"FINSI"
"SCUMUL";"S";"0278";"*"
"SCUMUL";"S";"0279";"* Présent ?"
"SCUMUL";"S";"0280";"HJOU_IJRCJDISP5 = 1"
"SCUMUL";"S";"0281";"SI HJOU_IJRCJDISP4 = 1"
"SCUMUL";"S";"0282";"   HJOU_IJRCJDISP5 = 0"
"SCUMUL";"S";"0283";"FINSI"
"SCUMUL";"S";"0284";"*"
"SCUMUL";"S";"0285";"FIN"
"SCUMUL";"S";"0286";"*** procedure raz compteurs periodiques"
"SCUMUL";"S";"0287";"PROC RAZCPT"
"SCUMUL";"S";"0288";"   HJOU_IJRPRESBAM = 0"
"SCUMUL";"S";"0289";"   HJOU_IJRPRESNBM = 0"
"SCUMUL";"S";"0290";"   HJOU_IJRTTREFFM = 0"
"SCUMUL";"S";"0291";"   HJOU_IJRTTEFFEM = 0"
"SCUMUL";"S";"0292";"   HJOU_IJRPRETHEM = 0"
"SCUMUL";"S";"0293";"*   HJOU_IJRVCTANNM = 0"
"SCUMUL";"S";"0294";"   HJOU_IJRNJTRAVM = 0"
"SCUMUL";"S";"0295";"   HJOU_IJRNJPRESP = 0"
"SCUMUL";"S";"0296";"*   HJOU_IJRBHORVMR = 0"
"SCUMUL";"S";"0297";"FINPROC"
"SDACQ";"S";"0001";"***********************************************************************"
"SDACQ";"S";"0002";"*"
"SDACQ";"S";"0003";"* Règle : SDACQ"
