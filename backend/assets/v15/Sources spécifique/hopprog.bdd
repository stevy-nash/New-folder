"IACQCPAN2M";"S";"0098";"* Récupération du jour de la date d'ancienneté"
"IACQCPAN2M";"S";"0099";"   LOCA_REF << EMPS_E2DATEANC(7:2)"
"IACQCPAN2M";"S";"0100";"   LOCA_DATE(7:2) << LOCA_REF"
"IACQCPAN2M";"S";"0101";"SINON"
"IACQCPAN2M";"S";"0102";"   LOCA_DATE = "" """
"IACQCPAN2M";"S";"0103";"FINSI"
"IACQCPAN2M";"S";"0104";"*"
"IACQCPAN2M";"S";"0105";"* GESTION DE L'ACQUISITION DES CONGES D'ANCIENNETE"
"IACQCPAN2M";"S";"0106";"* Date de référence des congés d'ancienneté"
"IACQCPAN2M";"S";"0107";"SI HJOU_DATE = LOCA_DATE"
"IACQCPAN2M";"S";"0108";"* Cacul de l'ancienneté"
"IACQCPAN2M";"S";"0109";"   DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"IACQCPAN2M";"S";"0110";"   LOCA_ANCIEN = TEMP_NXANNEE"
"IACQCPAN2M";"S";"0111";"*"
"IACQCPAN2M";"S";"0112";"* Si ""régime 1"""
"IACQCPAN2M";"S";"0113";"   SI HJOU_IJIREGCPAN = ""1"""
"IACQCPAN2M";"S";"0114";"      SI SECH_ISISANC1 > 0"
"IACQCPAN2M";"S";"0115";"* Acquisition selon les seuils"
"IACQCPAN2M";"S";"0116";"         SI LOCA_ANCIEN >= SECH_ISISANC1"
"IACQCPAN2M";"S";"0117";"            SI LOCA_ANCIEN < SECH_ISISANC2"
"IACQCPAN2M";"S";"0118";"            OU SECH_ISISANC2 = 0"
"IACQCPAN2M";"S";"0119";"               HJOU_IJRDCOANCI = SECH_ISIDCANC1"
"IACQCPAN2M";"S";"0120";"            SINON"
"IACQCPAN2M";"S";"0121";"               SI LOCA_ANCIEN < SECH_ISISANC3"
"IACQCPAN2M";"S";"0122";"               OU SECH_ISISANC3 = 0"
"IACQCPAN2M";"S";"0123";"                  HJOU_IJRDCOANCI = SECH_ISIDCANC2"
"IACQCPAN2M";"S";"0124";"               SINON"
"IACQCPAN2M";"S";"0125";"                  SI LOCA_ANCIEN < SECH_ISISANC4"
"IACQCPAN2M";"S";"0126";"                  OU SECH_ISISANC4 = 0"
"IACQCPAN2M";"S";"0127";"                     HJOU_IJRDCOANCI = SECH_ISIDCANC3"
"IACQCPAN2M";"S";"0128";"                  SINON"
"IACQCPAN2M";"S";"0129";"                     SI LOCA_ANCIEN < SECH_ISISANC5"
"IACQCPAN2M";"S";"0130";"                     OU SECH_ISISANC5 = 0"
"IACQCPAN2M";"S";"0131";"                        HJOU_IJRDCOANCI = SECH_ISIDCANC4"
"IACQCPAN2M";"S";"0132";"                     SINON"
"IACQCPAN2M";"S";"0133";"                        SI LOCA_ANCIEN < SECH_ISISANC6"
"IACQCPAN2M";"S";"0134";"                        OU SECH_ISISANC6 = 0"
"IACQCPAN2M";"S";"0135";"                           HJOU_IJRDCOANCI = SECH_ISIDCANC5"
"IACQCPAN2M";"S";"0136";"                        SINON"
"IACQCPAN2M";"S";"0137";"                           HJOU_IJRDCOANCI = SECH_ISIDCANC6"
"IACQCPAN2M";"S";"0138";"                        FINSI"
"IACQCPAN2M";"S";"0139";"                     FINSI"
"IACQCPAN2M";"S";"0140";"                  FINSI"
"IACQCPAN2M";"S";"0141";"               FINSI"
"IACQCPAN2M";"S";"0142";"            FINSI"
"IACQCPAN2M";"S";"0143";"         FINSI"
"IACQCPAN2M";"S";"0144";"      FINSI"
"IACQCPAN2M";"S";"0145";"   FINSI"
"IACQCPAN2M";"S";"0146";"* Si ""régime 2"""
"IACQCPAN2M";"S";"0147";"   SI HJOU_IJIREGCPAN = ""2"""
"IACQCPAN2M";"S";"0148";"      SI SECH_ISISANNC1 > 0"
"IACQCPAN2M";"S";"0149";"* Acquisition selon les seuils"
"IACQCPAN2M";"S";"0150";"         SI LOCA_ANCIEN >= SECH_ISISANNC1"
"IACQCPAN2M";"S";"0151";"            SI LOCA_ANCIEN < SECH_ISISANNC2"
"IACQCPAN2M";"S";"0152";"            OU SECH_ISISANNC2 = 0"
"IACQCPAN2M";"S";"0153";"               HJOU_IJRDCOANCI = SECH_ISIDCANNC1"
"IACQCPAN2M";"S";"0154";"            SINON"
"IACQCPAN2M";"S";"0155";"               SI LOCA_ANCIEN < SECH_ISISANNC3"
"IACQCPAN2M";"S";"0156";"               OU SECH_ISISANNC3 = 0"
"IACQCPAN2M";"S";"0157";"                  HJOU_IJRDCOANCI = SECH_ISIDCANNC2"
"IACQCPAN2M";"S";"0158";"               SINON"
"IACQCPAN2M";"S";"0159";"                  SI LOCA_ANCIEN < SECH_ISISANNC4"
"IACQCPAN2M";"S";"0160";"                  OU SECH_ISISANNC4 = 0"
"IACQCPAN2M";"S";"0161";"                     HJOU_IJRDCOANCI = SECH_ISIDCANNC3"
"IACQCPAN2M";"S";"0162";"                  SINON"
"IACQCPAN2M";"S";"0163";"                     SI LOCA_ANCIEN < SECH_ISISANNC5"
"IACQCPAN2M";"S";"0164";"                     OU SECH_ISISANNC5 = 0"
"IACQCPAN2M";"S";"0165";"                        HJOU_IJRDCOANCI = SECH_ISIDCANNC4"
"IACQCPAN2M";"S";"0166";"                     SINON"
"IACQCPAN2M";"S";"0167";"                        SI LOCA_ANCIEN < SECH_ISISANNC6"
"IACQCPAN2M";"S";"0168";"                        OU SECH_ISISANNC6 = 0"
"IACQCPAN2M";"S";"0169";"                           HJOU_IJRDCOANCI = SECH_ISIDCANNC5"
"IACQCPAN2M";"S";"0170";"                        SINON"
"IACQCPAN2M";"S";"0171";"                           HJOU_IJRDCOANCI = SECH_ISIDCANNC6"
"IACQCPAN2M";"S";"0172";"                        FINSI"
"IACQCPAN2M";"S";"0173";"                     FINSI"
"IACQCPAN2M";"S";"0174";"                  FINSI"
"IACQCPAN2M";"S";"0175";"               FINSI"
"IACQCPAN2M";"S";"0176";"            FINSI"
"IACQCPAN2M";"S";"0177";"         FINSI"
"IACQCPAN2M";"S";"0178";"      FINSI"
"IACQCPAN2M";"S";"0179";"   FINSI"
"IACQCPAN2M";"S";"0180";"* Remise à zéro du pris"
"IACQCPAN2M";"S";"0181";"   HJOU_IJRCCOANCI = 0"
"IACQCPAN2M";"S";"0182";"   HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"IACQCPAN2M";"S";"0183";"FINSI"
"IACQCPAN2M";"S";"0184";"* GESTION CONSIGNES D'INIT. ET MAJ"
"IACQCPAN2M";"S";"0185";"POUR ACTIVITES"
"IACQCPAN2M";"S";"0186";"* consignes de MAJ du droit congés d'ancienneté"
"IACQCPAN2M";"S";"0187";"   SI HABS_MOTIF = ""XDCA"""
"IACQCPAN2M";"S";"0188";"      LOCA_CA = 1"
"IACQCPAN2M";"S";"0189";"      LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCOANCI"
"IACQCPAN2M";"S";"0190";"      LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCOANCI"
"IACQCPAN2M";"S";"0191";"      *"
"IACQCPAN2M";"S";"0192";"      HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + HABS_MOTINBR"
"IACQCPAN2M";"S";"0193";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACQCPAN2M";"S";"0194";"   FINSI"
"IACQCPAN2M";"S";"0195";"* Droit congé d'ancienneté"
"IACQCPAN2M";"S";"0196";"   SI HABS_MOTIF = ""ZDCA"""
"IACQCPAN2M";"S";"0197";"      LOCA_CA = 1"
"IACQCPAN2M";"S";"0198";"      LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCOANCI"
"IACQCPAN2M";"S";"0199";"      *"
"IACQCPAN2M";"S";"0200";"      HJOU_IJRDCOANCI = HABS_MOTINBR"
"IACQCPAN2M";"S";"0201";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACQCPAN2M";"S";"0202";"   FINSI"
"IACQCPAN2M";"S";"0203";"FINPOUR"
"IACQCPAN2M";"S";"0204";"*"
"IACQCPAN2M";"S";"0205";"SI LOCA_CA = 1"
"IACQCPAN2M";"S";"0206";"   SI HJOU_IJRSCOANCI < 0"
"IACQCPAN2M";"S";"0207";"      ANOMALIE 168"
"IACQCPAN2M";"S";"0208";"   FINSI"
"IACQCPAN2M";"S";"0209";"FINSI"
"IACQCPAN2M";"S";"0210";"*"
"IACQCPAN2M";"S";"0211";"FIN"
"IACTBA";"S";"0001";"***********************************************************************"
