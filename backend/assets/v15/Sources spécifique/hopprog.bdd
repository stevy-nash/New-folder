"IACQCPAN1M";"S";"0075";"*"
"IACQCPAN1M";"S";"0076";"* Déclaration des donnees locales"
"IACQCPAN1M";"S";"0077";"* Variables utilisées pour calculer la date de reference"
"IACQCPAN1M";"S";"0078";"DEF LOCA_DATE D"
"IACQCPAN1M";"S";"0079";"DEF LOCA_REF N2"
"IACQCPAN1M";"S";"0080";"* Variables utilisées pour le calcul de l'ancienneté"
"IACQCPAN1M";"S";"0081";"DEF LOCA_ANCIEN N6.1"
"IACQCPAN1M";"S";"0082";"LOCA_ANCIEN = 0"
"IACQCPAN1M";"S";"0083";"DEF LOCA_TRANS N6.1"
"IACQCPAN1M";"S";"0084";"LOCA_TRANS = 0"
"IACQCPAN1M";"S";"0085";"DEF LOCA_DROIT N6.1"
"IACQCPAN1M";"S";"0086";"LOCA_DROIT = 0"
"IACQCPAN1M";"S";"0087";"DEF LOCA_CA N1"
"IACQCPAN1M";"S";"0088";"LOCA_CA = 0"
"IACQCPAN1M";"S";"0089";"*"
"IACQCPAN1M";"S";"0090";"* Calcul de la date de référence CP"
"IACQCPAN1M";"S";"0091";"* stockage de l'année du jour de l'historique"
"IACQCPAN1M";"S";"0092";"SI CONF_ITIVMREFCP <> "" """
"IACQCPAN1M";"S";"0093";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IACQCPAN1M";"S";"0094";"* stockage du mois de reference"
"IACQCPAN1M";"S";"0095";"   LOCA_REF << CONF_ITIVMREFCP(3:2)"
"IACQCPAN1M";"S";"0096";"* stokage du mois de reference"
"IACQCPAN1M";"S";"0097";"   LOCA_DATE(5:2) << LOCA_REF"
"IACQCPAN1M";"S";"0098";"* stockage du jour de reference"
"IACQCPAN1M";"S";"0099";"   LOCA_REF << CONF_ITIVMREFCP(1:2)"
"IACQCPAN1M";"S";"0100";"* loca_date contient maintenant l'année du jour de l'historique"
"IACQCPAN1M";"S";"0101";"* et le mois et le jour de reference"
"IACQCPAN1M";"S";"0102";"   LOCA_DATE(7:2) << LOCA_REF"
"IACQCPAN1M";"S";"0103";"SINON"
"IACQCPAN1M";"S";"0104";"   LOCA_DATE = "" """
"IACQCPAN1M";"S";"0105";"FINSI"
"IACQCPAN1M";"S";"0106";"*"
"IACQCPAN1M";"S";"0107";"* GESTION DE L'ACQUISITION DES CONGES D'ANCIENNETE"
"IACQCPAN1M";"S";"0108";"* Date de référence des congés d'ancienneté"
"IACQCPAN1M";"S";"0109";"SI HJOU_DATE = LOCA_DATE"
"IACQCPAN1M";"S";"0110";"* Cacul de l'ancienneté"
"IACQCPAN1M";"S";"0111";"   DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"IACQCPAN1M";"S";"0112";"   LOCA_ANCIEN = TEMP_NXANNEE"
"IACQCPAN1M";"S";"0113";"*"
"IACQCPAN1M";"S";"0114";"* Si ""régime 1"""
"IACQCPAN1M";"S";"0115";"   SI HJOU_IJIREGCPAN = ""1"""
"IACQCPAN1M";"S";"0116";"      SI SECH_ISISANC1 > 0"
"IACQCPAN1M";"S";"0117";"* Acquisition selon les seuils"
"IACQCPAN1M";"S";"0118";"         SI LOCA_ANCIEN >= SECH_ISISANC1"
"IACQCPAN1M";"S";"0119";"            SI LOCA_ANCIEN < SECH_ISISANC2"
"IACQCPAN1M";"S";"0120";"            OU SECH_ISISANC2 = 0"
"IACQCPAN1M";"S";"0121";"               HJOU_IJRDCOANCI = SECH_ISIDCANC1"
"IACQCPAN1M";"S";"0122";"            SINON"
"IACQCPAN1M";"S";"0123";"               SI LOCA_ANCIEN < SECH_ISISANC3"
"IACQCPAN1M";"S";"0124";"               OU SECH_ISISANC3 = 0"
"IACQCPAN1M";"S";"0125";"                  HJOU_IJRDCOANCI = SECH_ISIDCANC2"
"IACQCPAN1M";"S";"0126";"               SINON"
"IACQCPAN1M";"S";"0127";"                  SI LOCA_ANCIEN < SECH_ISISANC4"
"IACQCPAN1M";"S";"0128";"                  OU SECH_ISISANC4 = 0"
"IACQCPAN1M";"S";"0129";"                     HJOU_IJRDCOANCI = SECH_ISIDCANC3"
"IACQCPAN1M";"S";"0130";"                  SINON"
"IACQCPAN1M";"S";"0131";"                     SI LOCA_ANCIEN < SECH_ISISANC5"
"IACQCPAN1M";"S";"0132";"                     OU SECH_ISISANC5 = 0"
"IACQCPAN1M";"S";"0133";"                        HJOU_IJRDCOANCI = SECH_ISIDCANC4"
"IACQCPAN1M";"S";"0134";"                     SINON"
"IACQCPAN1M";"S";"0135";"                        SI LOCA_ANCIEN < SECH_ISISANC6"
"IACQCPAN1M";"S";"0136";"                        OU SECH_ISISANC6 = 0"
"IACQCPAN1M";"S";"0137";"                           HJOU_IJRDCOANCI = SECH_ISIDCANC5"
"IACQCPAN1M";"S";"0138";"                        SINON"
"IACQCPAN1M";"S";"0139";"                           HJOU_IJRDCOANCI = SECH_ISIDCANC6"
"IACQCPAN1M";"S";"0140";"                        FINSI"
"IACQCPAN1M";"S";"0141";"                     FINSI"
"IACQCPAN1M";"S";"0142";"                  FINSI"
"IACQCPAN1M";"S";"0143";"               FINSI"
"IACQCPAN1M";"S";"0144";"            FINSI"
"IACQCPAN1M";"S";"0145";"         FINSI"
"IACQCPAN1M";"S";"0146";"      FINSI"
"IACQCPAN1M";"S";"0147";"   FINSI"
"IACQCPAN1M";"S";"0148";"* Si ""régime 2"""
"IACQCPAN1M";"S";"0149";"   SI HJOU_IJIREGCPAN = ""2"""
"IACQCPAN1M";"S";"0150";"      SI SECH_ISISANNC1 > 0"
"IACQCPAN1M";"S";"0151";"* Acquisition selon les seuils"
"IACQCPAN1M";"S";"0152";"         SI LOCA_ANCIEN >= SECH_ISISANNC1"
"IACQCPAN1M";"S";"0153";"            SI LOCA_ANCIEN < SECH_ISISANNC2"
"IACQCPAN1M";"S";"0154";"            OU SECH_ISISANNC2 = 0"
"IACQCPAN1M";"S";"0155";"               HJOU_IJRDCOANCI = SECH_ISIDCANNC1"
"IACQCPAN1M";"S";"0156";"            SINON"
"IACQCPAN1M";"S";"0157";"               SI LOCA_ANCIEN < SECH_ISISANNC3"
"IACQCPAN1M";"S";"0158";"               OU SECH_ISISANNC3 = 0"
"IACQCPAN1M";"S";"0159";"                  HJOU_IJRDCOANCI = SECH_ISIDCANNC2"
"IACQCPAN1M";"S";"0160";"               SINON"
"IACQCPAN1M";"S";"0161";"                  SI LOCA_ANCIEN < SECH_ISISANNC4"
"IACQCPAN1M";"S";"0162";"                  OU SECH_ISISANNC4 = 0"
"IACQCPAN1M";"S";"0163";"                     HJOU_IJRDCOANCI = SECH_ISIDCANNC3"
"IACQCPAN1M";"S";"0164";"                  SINON"
"IACQCPAN1M";"S";"0165";"                     SI LOCA_ANCIEN < SECH_ISISANNC5"
"IACQCPAN1M";"S";"0166";"                     OU SECH_ISISANNC5 = 0"
"IACQCPAN1M";"S";"0167";"                        HJOU_IJRDCOANCI = SECH_ISIDCANNC4"
"IACQCPAN1M";"S";"0168";"                     SINON"
"IACQCPAN1M";"S";"0169";"                        SI LOCA_ANCIEN < SECH_ISISANNC6"
"IACQCPAN1M";"S";"0170";"                        OU SECH_ISISANNC6 = 0"
"IACQCPAN1M";"S";"0171";"                           HJOU_IJRDCOANCI = SECH_ISIDCANNC5"
"IACQCPAN1M";"S";"0172";"                        SINON"
"IACQCPAN1M";"S";"0173";"                           HJOU_IJRDCOANCI = SECH_ISIDCANNC6"
"IACQCPAN1M";"S";"0174";"                        FINSI"
"IACQCPAN1M";"S";"0175";"                     FINSI"
"IACQCPAN1M";"S";"0176";"                  FINSI"
"IACQCPAN1M";"S";"0177";"               FINSI"
"IACQCPAN1M";"S";"0178";"            FINSI"
"IACQCPAN1M";"S";"0179";"         FINSI"
"IACQCPAN1M";"S";"0180";"      FINSI"
"IACQCPAN1M";"S";"0181";"   FINSI"
"IACQCPAN1M";"S";"0182";"* Remise à zéro du pris"
"IACQCPAN1M";"S";"0183";"   HJOU_IJRCCOANCI = 0"
"IACQCPAN1M";"S";"0184";"   HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"IACQCPAN1M";"S";"0185";"FINSI"
"IACQCPAN1M";"S";"0186";"* GESTION CONSIGNES D'INIT. ET MAJ"
"IACQCPAN1M";"S";"0187";"POUR ACTIVITES"
"IACQCPAN1M";"S";"0188";"* consignes de MAJ du droit congés d'ancienneté"
"IACQCPAN1M";"S";"0189";"   SI HABS_MOTIF = ""XDCA"""
"IACQCPAN1M";"S";"0190";"      LOCA_CA = 1"
"IACQCPAN1M";"S";"0191";"      LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCOANCI"
"IACQCPAN1M";"S";"0192";"      LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCOANCI"
"IACQCPAN1M";"S";"0193";"      *"
"IACQCPAN1M";"S";"0194";"      HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + HABS_MOTINBR"
"IACQCPAN1M";"S";"0195";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACQCPAN1M";"S";"0196";"   FINSI"
"IACQCPAN1M";"S";"0197";"* Droit congé d'ancienneté"
"IACQCPAN1M";"S";"0198";"   SI HABS_MOTIF = ""ZDCA"""
"IACQCPAN1M";"S";"0199";"      LOCA_CA = 1"
"IACQCPAN1M";"S";"0200";"      LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCOANCI"
"IACQCPAN1M";"S";"0201";"      *"
"IACQCPAN1M";"S";"0202";"      HJOU_IJRDCOANCI = HABS_MOTINBR"
"IACQCPAN1M";"S";"0203";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACQCPAN1M";"S";"0204";"   FINSI"
"IACQCPAN1M";"S";"0205";"FINPOUR"
"IACQCPAN1M";"S";"0206";"*"
"IACQCPAN1M";"S";"0207";"SI LOCA_CA = 1"
"IACQCPAN1M";"S";"0208";"   SI HJOU_IJRSCOANCI < 0"
"IACQCPAN1M";"S";"0209";"      ANOMALIE 168"
"IACQCPAN1M";"S";"0210";"   FINSI"
"IACQCPAN1M";"S";"0211";"FINSI"
"IACQCPAN1M";"S";"0212";"*"
"IACQCPAN1M";"S";"0213";"FIN"
