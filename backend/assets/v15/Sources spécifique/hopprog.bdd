"SGRJF";"S";"0029";"* Implémentation des données industrielles"
"SGRJF";"S";"0030";"*"
"SGRJF";"S";"0031";"DEBDICO"
"SGRJF";"S";"0032";"   HJOU_SJRDRJF;N;N6,2;I;;;     6789;;SJRDRJF;V3;""Droit RJF"";"
