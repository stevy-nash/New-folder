"SDACQ";"S";"0053";"*********************************************"
"SDACQ";"S";"0054";"*     Calcul des dates prévisionnelles      *"
"SDACQ";"S";"0055";"*********************************************"
"SDACQ";"S";"0056";"DEF LOCA_PASSE5 N4"
"SDACQ";"S";"0057";"DEF LOCA_PASSE4 N4"
"SDACQ";"S";"0058";"DEF LOCA_PASSE3 N4"
"SDACQ";"S";"0059";"DEF LOCA_PASSE2 N4"
"SDACQ";"S";"0060";"DEF LOCA_PASSE1 N4"
"SDACQ";"S";"0061";"DEF LOCA_PASSE9 N4"
"SDACQ";"S";"0062";"DEF LOCA_DATEP5 D"
"SDACQ";"S";"0063";"DEF LOCA_DATEP4 D"
"SDACQ";"S";"0064";"DEF LOCA_DATEP3 D"
"SDACQ";"S";"0065";"DEF LOCA_DATEP2 D"
"SDACQ";"S";"0066";"DEF LOCA_DATEP1 D"
"SDACQ";"S";"0067";"DEF LOCA_DATEP9 D"
"SDACQ";"S";"0068";"DEF LOCA_DATPRE D"
"SDACQ";"S";"0069";"LOCA_DATPRE = "" """
"SDACQ";"S";"0070";"DEF LOCA_ACOURS N4"
"SDACQ";"S";"0071";"DEF LOCA_FUTUR N4"
"SDACQ";"S";"0072";"DEF LOCA_DATEAC D"
"SDACQ";"S";"0073";"DEF LOCA_DATEFU D"
"SDACQ";"S";"0074";"* stockage de l'annee"
"SDACQ";"S";"0075";"LOCA_PASSE5 << TEMP_DATJOU(1:4)"
"SDACQ";"S";"0076";"LOCA_PASSE5 = LOCA_PASSE5 - 5"
"SDACQ";"S";"0077";"LOCA_PASSE4 << TEMP_DATJOU(1:4)"
"SDACQ";"S";"0078";"LOCA_PASSE4 = LOCA_PASSE4 - 4"
"SDACQ";"S";"0079";"LOCA_PASSE3 << TEMP_DATJOU(1:4)"
"SDACQ";"S";"0080";"LOCA_PASSE3 = LOCA_PASSE3 - 3"
"SDACQ";"S";"0081";"LOCA_PASSE2 << TEMP_DATJOU(1:4)"
"SDACQ";"S";"0082";"LOCA_PASSE2 = LOCA_PASSE2 - 2"
"SDACQ";"S";"0083";"LOCA_PASSE1 << TEMP_DATJOU(1:4)"
"SDACQ";"S";"0084";"LOCA_PASSE1 = LOCA_PASSE1 - 1"
"SDACQ";"S";"0085";"LOCA_PASSE9 << TEMP_DATJOU(1:4)"
"SDACQ";"S";"0086";"LOCA_PASSE9 = LOCA_PASSE9 + 1"
"SDACQ";"S";"0087";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"SDACQ";"S";"0088";"LOCA_FUTUR << TEMP_DATJOU(1:4)"
"SDACQ";"S";"0089";"LOCA_FUTUR = LOCA_FUTUR + 1"
"SDACQ";"S";"0090";"LOCA_DATEP5(1:4) << LOCA_PASSE5"
"SDACQ";"S";"0091";"LOCA_DATEP4(1:4) << LOCA_PASSE4"
"SDACQ";"S";"0092";"LOCA_DATEP3(1:4) << LOCA_PASSE3"
"SDACQ";"S";"0093";"LOCA_DATEP2(1:4) << LOCA_PASSE2"
"SDACQ";"S";"0094";"LOCA_DATEP1(1:4) << LOCA_PASSE1"
"SDACQ";"S";"0095";"LOCA_DATEP9(1:4) << LOCA_PASSE9"
"SDACQ";"S";"0096";"LOCA_DATEAC(1:4) << LOCA_ACOURS"
"SDACQ";"S";"0097";"LOCA_DATEFU(1:4) << LOCA_FUTUR"
"SDACQ";"S";"0098";"* stockage du 1er janvier"
"SDACQ";"S";"0099";"LOCA_DATEP5(5:4) = ""0101"""
"SDACQ";"S";"0100";"LOCA_DATEP4(5:4) = ""0101"""
"SDACQ";"S";"0101";"LOCA_DATEP3(5:4) = ""0101"""
"SDACQ";"S";"0102";"LOCA_DATEP2(5:4) = ""0101"""
"SDACQ";"S";"0103";"LOCA_DATEP1(5:4) = ""0101"""
"SDACQ";"S";"0104";"LOCA_DATEP9(5:4) = ""0101"""
"SDACQ";"S";"0105";"LOCA_DATEAC(5:4) = ""0101"""
"SDACQ";"S";"0106";"LOCA_DATEFU(5:4) = ""0101"""
"SDACQ";"S";"0107";"*"
"SDACQ";"S";"0108";"*"
"SDACQ";"S";"0109";"* RAZ des dates temporaires de fin de période"
"SDACQ";"S";"0110";"*"
"SDACQ";"S";"0111";"SI HJOU_DATE = LOCA_DATEAC"
"SDACQ";"S";"0112";"   EMPL_SEIDFCNT = "" """
"SDACQ";"S";"0113";"FINSI"
"SDACQ";"S";"0114";"SI HJOU_DATE = LOCA_DATEFU"
"SDACQ";"S";"0115";"   EMPL_SEIDFCN9T = "" """
"SDACQ";"S";"0116";"FINSI"
"SDACQ";"S";"0117";"*"
"SDACQ";"S";"0118";"*******************************************"
"SDACQ";"S";"0119";"*  Calcul date d'acquisition des congés   *"
"SDACQ";"S";"0120";"*******************************************"
"SDACQ";"S";"0121";"*SI EMPL_SEIDATFIN > EMPL_DATTRAI"
"SDACQ";"S";"0122";"*DATAJT EMPL_DATTRAI 12 ""J"" -7"
"SDACQ";"S";"0123";"*EMPL_SEIDATFIN = TEMP_DXFINPER"
"SDACQ";"S";"0124";"EMPL_SEIDATFIN = EMPL_DATTRAI"
"SDACQ";"S";"0125";"*FINSI"
"SDACQ";"S";"0126";"* Année N"
"SDACQ";"S";"0127";"**********"
"SDACQ";"S";"0128";"* RAZ date d'acquisition N si fin d'historique < année N"
"SDACQ";"S";"0129";"SI EMPL_SEIDATFIN(1:4) < TEMP_DATJOU(1:4)"
"SDACQ";"S";"0130";"   EMPL_SEIDATACQN = "" """
"SDACQ";"S";"0131";"FINSI"
"SDACQ";"S";"0132";"SI HJOU_DATE(1:4) = LOCA_DATEP9(1:4)"
"SDACQ";"S";"0133";"* on est positionné dans l'année en cours"
"SDACQ";"S";"0134";"   SI HJOU_DATE(5:4) = ""0101"""
"SDACQ";"S";"0135";"   OU HJOU_DATE = HJOU_SJRDDEBCTR"
"SDACQ";"S";"0136";"* Par défaut,la date d'acquisition correspond au 1er janvier ou à la date d'ouverture de l'agent."
"SDACQ";"S";"0137";"      EMPL_SEIDATACQ9 = HJOU_DATE"
"SDACQ";"S";"0138";"   FINSI"
"SDACQ";"S";"0139";"   SI HJOU_DATE(1:4) <> TEMP_DATPRE(1:4)"
"SDACQ";"S";"0140";"* sinon sauvegarde du 1er jour de l'historique après un changement d'année"
"SDACQ";"S";"0141";"* permet de prendre en compte les agents étant absent au 1er janvier"
"SDACQ";"S";"0142";"* exemple : contrat se termine en décembre et nouveau contrat débute mi-janvier."
"SDACQ";"S";"0143";"      EMPL_SEIDATACQ9 = HJOU_DATE"
"SDACQ";"S";"0144";"   FINSI"
"SDACQ";"S";"0145";"FINSI"
"SDACQ";"S";"0146";"SI HJOU_DATE(1:4) = TEMP_DATJOU(1:4)"
"SDACQ";"S";"0147";"* on est positionné dans l'année en cours"
"SDACQ";"S";"0148";"   SI HJOU_DATE(5:4) = ""0101"""
"SDACQ";"S";"0149";"   OU HJOU_DATE = HJOU_SJRDDEBCTR"
"SDACQ";"S";"0150";"* Par défaut,la date d'acquisition correspond au 1er janvier ou à la date d'ouverture de l'agent."
"SDACQ";"S";"0151";"      EMPL_SEIDATACQN = HJOU_DATE"
"SDACQ";"S";"0152";"   FINSI"
"SDACQ";"S";"0153";"   SI HJOU_DATE(1:4) <> TEMP_DATPRE(1:4)"
"SDACQ";"S";"0154";"* sinon sauvegarde du 1er jour de l'historique après un changement d'année"
"SDACQ";"S";"0155";"* permet de prendre en compte les agents étant absent au 1er janvier"
"SDACQ";"S";"0156";"* exemple : contrat se termine en décembre et nouveau contrat débute mi-janvier."
"SDACQ";"S";"0157";"      EMPL_SEIDATACQN = HJOU_DATE"
"SDACQ";"S";"0158";"   FINSI"
"SDACQ";"S";"0159";"FINSI"
"SDACQ";"S";"0160";"***************"
"SDACQ";"S";"0161";"* Année N - 1"
"SDACQ";"S";"0162";"***************"
"SDACQ";"S";"0163";"* RAZ date d'acquisition N-1 si fin d'historique < année N-1"
"SDACQ";"S";"0164";"SI EMPL_SEIDATFIN(1:4) < LOCA_DATEP1(1:4)"
"SDACQ";"S";"0165";"   EMPL_SEIDATACQ1 = "" """
"SDACQ";"S";"0166";"FINSI"
"SDACQ";"S";"0167";"SI HJOU_DATE(1:4) = LOCA_DATEP1(1:4)"
"SDACQ";"S";"0168";"   SI HJOU_DATE(5:4) = ""0101"""
"SDACQ";"S";"0169";"   OU HJOU_DATE = HJOU_SJRDDEBCTR"
"SDACQ";"S";"0170";"      EMPL_SEIDATACQ1 = HJOU_DATE"
"SDACQ";"S";"0171";"   FINSI"
"SDACQ";"S";"0172";"   SI HJOU_DATE(1:4) <> TEMP_DATPRE(1:4)"
"SDACQ";"S";"0173";"      EMPL_SEIDATACQ1 = HJOU_DATE"
