"SHSUPPDIM";"S";"0535";"         FINSI"
"SHSUPPDIM";"S";"0536";"      FINSI"
"SHSUPPDIM";"S";"0537";"* Anomalie Pas droit aux HS"
"SHSUPPDIM";"S";"0538";"      SI LOCA_DROIT <> 1"
"SHSUPPDIM";"S";"0539";"         ANOMALIE 203"
"SHSUPPDIM";"S";"0540";"         SI TEMP_CNMOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM";"S";"0541";"            TEMP_CNRETOUR = 2"
"SHSUPPDIM";"S";"0542";"            TEMP_CNMESS = 203"
"SHSUPPDIM";"S";"0543";"         FINSI"
"SHSUPPDIM";"S";"0544";"      FINSI"
"SHSUPPDIM";"S";"0545";"* Cas particulier - Anomamie si saisie en semaine pour la société LI - Edition"
"SHSUPPDIM";"S";"0546";"      SI LOCA_SPEC = ""EDIT"""
"SHSUPPDIM";"S";"0547";"         SI HJOU_JOUR < ""6"""
"SHSUPPDIM";"S";"0548";"            LOCA_DROIT = 0"
"SHSUPPDIM";"S";"0549";"            ANOMALIE 204"
"SHSUPPDIM";"S";"0550";"            SI TEMP_CNMOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM";"S";"0551";"               TEMP_CNRETOUR = 2"
"SHSUPPDIM";"S";"0552";"               TEMP_CNMESS = 204"
