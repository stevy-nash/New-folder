"SACQCP";"S";"0788";"         HJOU_SJRSPREP3 = HJOU_SJRDPREP3 - HJOU_SJRCPREP3"
"SACQCP";"S";"0789";"      FINSI"
"SACQCP";"S";"0790";"   FINSI"
"SACQCP";"S";"0791";"*"
"SACQCP";"S";"0792";"* Période 2 >>"
"SACQCP";"S";"0793";"   SI HJOU_SJRDPREP2 = 0"
"SACQCP";"S";"0794";"      SI HJOU_SJRDAFREP2 = "" """
"SACQCP";"S";"0795";"         HJOU_SJRDPREP2 = 0"
"SACQCP";"S";"0796";"         HJOU_SJRCPREP2 = 0"
"SACQCP";"S";"0797";"         HJOU_SJRSPREP2 = HJOU_SJRDPREP2 - HJOU_SJRCPREP2"
