"SGRTTJ";"S";"0259";"* FIN <<"
"SGRTTJ";"S";"0260";"*"
"SGRTTJ";"S";"0261";"****** Calcul acquisition jour par jour avec aqcusition en fin de mois ******"
"SGRTTJ";"S";"0262";"*"
"SGRTTJ";"S";"0263";"* Calcul de l'acquisition jour au 30° afin de gérer au plus juste les entrées/sorties au mois"
"SGRTTJ";"S";"0264";"   SI LOCA_STOPACQ <> 1"
"SGRTTJ";"S";"0265";"*"
"SGRTTJ";"S";"0266";"      LOCA_DRTT = HORC_SHIACRTTA"
"SGRTTJ";"S";"0267";"* Si forfait jour autres que journalistes le droit dépend des paramètres dans CFG sinon HOR"
"SGRTTJ";"S";"0268";"      SI HJOU_SJQFORFJR = ""1"""
"SGRTTJ";"S";"0269";"         SI HJOU_SJQCATEGOR <> ""J"""
"SGRTTJ";"S";"0270";"            LOCA_DRTT = 0"
"SGRTTJ";"S";"0271";"            FAIRE DRTT"
"SGRTTJ";"S";"0272";"            LOCA_DRTT = LOCA_DRTTI"
"SGRTTJ";"S";"0273";"*"
"SGRTTJ";"S";"0274";"* 23/01/2026-SYA-PBR026003232: priorité au param du code Hor (à partir du 01/01/2026)"
"SGRTTJ";"S";"0275";"SI HJOU_DATE >= ""01/01/2026"""
"SGRTTJ";"S";"0276";"SI HORC_PRIOHOR = ""1"""
"SGRTTJ";"S";"0277";"      LOCA_DRTT = HORC_SHIACRTTA"
"SGRTTJ";"S";"0278";"FINSI"
"SGRTTJ";"S";"0279";"FINSI"
"SGRTTJ";"S";"0280";"*"
"SGRTTJ";"S";"0281";"         FINSI"
"SGRTTJ";"S";"0282";"      FINSI"
"SGRTTJ";"S";"0283";"      LOCA_ACQ = LOCA_DRTT / 12"
"SGRTTJ";"S";"0284";"      LOCA_ACQMOIS = LOCA_DRTT / 12"
"SGRTTJ";"S";"0285";"      LOCA_ACQ = LOCA_ACQ / 30"
"SGRTTJ";"S";"0286";"   SINON"
"SGRTTJ";"S";"0287";"      LOCA_ACQ = 0"
"SGRTTJ";"S";"0288";"   FINSI"
"SGRTTJ";"S";"0289";"*"
"SGRTTJ";"S";"0290";"   HJOU_SJQACRTT = LOCA_ACQ"
"SGRTTJ";"S";"0291";"*"
"SGRTTJ";"S";"0292";"* Calcul accquisition mois"
"SGRTTJ";"S";"0293";"   SI HJOU_DATE(7:2) < ""31"""
"SGRTTJ";"S";"0294";"      HJOU_SJRACQJRTT = HJOU_SJRACQJRTT + HJOU_SJQACRTT"
"SGRTTJ";"S";"0295";"   FINSI"
"SGRTTJ";"S";"0296";"*"
"SGRTTJ";"S";"0297";"* Gestion du mois de février"
"SGRTTJ";"S";"0298";"   SI TEMP_DATSUI(5:4) = ""0301"""
"SGRTTJ";"S";"0299";"* années bisextilles"
"SGRTTJ";"S";"0300";"      SI LOCA_ABIS = 1"
"SGRTTJ";"S";"0301";"         HJOU_SJRACQJRTT = HJOU_SJRACQJRTT + HJOU_SJQACRTT"
"SGRTTJ";"S";"0302";"* années non bisextilles"
"SGRTTJ";"S";"0303";"      SINON"
"SGRTTJ";"S";"0304";"         HJOU_SJRACQJRTT = HJOU_SJRACQJRTT + HJOU_SJQACRTT"
"SGRTTJ";"S";"0305";"         HJOU_SJRACQJRTT = HJOU_SJRACQJRTT + HJOU_SJQACRTT"
"SGRTTJ";"S";"0306";"      FINSI"
"SGRTTJ";"S";"0307";"   FINSI"
"SGRTTJ";"S";"0308";"*"
"SGRTTJ";"S";"0309";"   SI TEMP_DATSUI(7:2) = ""01"""
"SGRTTJ";"S";"0310";"*   OU HJOU_SJQINSTC = ""1"""
"SGRTTJ";"S";"0311";"   OU CTRA_SCIDATSTC = HJOU_DATE"
"SGRTTJ";"S";"0312";"      SI HJOU_SJRACQJRTT > 0"
