"ITPSACTHT9";"S";"0076";"                *"
"ITPSACTHT9";"S";"0077";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT9";"S";"0078";"                *                              (A décommenter si besoin)"
"ITPSACTHT9";"S";"0079";"                *"
"ITPSACTHT9";"S";"0080";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT9";"S";"0081";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT9";"S";"0082";"                * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT9";"S";"0083";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT9";"S";"0084";"                *"
"ITPSACTHT9";"S";"0085";"                * SI HJOU_IJRBHORVAH <> 0"
"ITPSACTHT9";"S";"0086";"                    PRES_TPS_PRES = HJOU_IJRBHORVAH"
"ITPSACTHT9";"S";"0087";"                * SINON"
"ITPSACTHT9";"S";"0088";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTHT9";"S";"0089";"                * FINSI"
"ITPSACTHT9";"S";"0090";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT9";"S";"0091";"                *"
"ITPSACTHT9";"S";"0092";"                PRES_TPS_IMPUTE = 0"
"ITPSACTHT9";"S";"0093";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTHT9";"S";"0094";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTHT9";"S";"0095";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHT9";"S";"0096";"                    POUR EVENEMENTS"
"ITPSACTHT9";"S";"0097";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT9";"S";"0098";"                    FINPOUR"
"ITPSACTHT9";"S";"0099";"                FINSI"
"ITPSACTHT9";"S";"0100";"                *"
"ITPSACTHT9";"S";"0101";"                * Calcul de l'écart"
"ITPSACTHT9";"S";"0102";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT9";"S";"0103";"            FINSI"
"ITPSACTHT9";"S";"0104";"        FINSI"
"ITPSACTHT9";"S";"0105";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT9";"S";"0106";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT9";"S";"0107";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT9";"S";"0108";"        FINSI"
"ITPSACTHT9";"S";"0109";"    FINSI"
"ITPSACTHT9";"S";"0110";"FINSI"
"ITPSACTHT9";"S";"0111";"*"
"ITPSACTHT9";"S";"0112";"FIN"
