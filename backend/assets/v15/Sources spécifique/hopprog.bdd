"SGTTFJ";"S";"0144";"   LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"SGTTFJ";"S";"0145";"   LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"SGTTFJ";"S";"0146";"*"
"SGTTFJ";"S";"0147";"   POUR ACTIVITES"
"SGTTFJ";"S";"0148";"      SI HABS_MOTIF = ""JF"""
"SGTTFJ";"S";"0149";"         LOCA_FERI = 1"
"SGTTFJ";"S";"0150";"      FINSI"
"SGTTFJ";"S";"0151";"   FINPOUR"
"SGTTFJ";"S";"0152";"*"
"SGTTFJ";"S";"0153";"* Identification passage en forfait jour"
"SGTTFJ";"S";"0154";"   LIREVALPRE LOCA_SJQFORFJR HJOU_SJQFORFJR"
"SGTTFJ";"S";"0155";"   SI LOCA_SJQFORFJR <> HJOU_SJQFORFJR"
"SGTTFJ";"S";"0156";"      LOCA_CHGT = 1"
"SGTTFJ";"S";"0157";"   FINSI"
"SGTTFJ";"S";"0158";"*"
"SGTTFJ";"S";"0159";"* RAZ mois"
"SGTTFJ";"S";"0160";"   SI HJOU_DATE(7:2) = ""01"""
"SGTTFJ";"S";"0161";"      HJOU_IJRACRTTJM = 0"
"SGTTFJ";"S";"0162";"      HJOU_SJRABRTTM = 0"
"SGTTFJ";"S";"0163";"      HJOU_SJRACQJRTT = 0"
"SGTTFJ";"S";"0164";"      HJOU_SJRNABSABR = 0"
"SGTTFJ";"S";"0165";"   FINSI"
"SGTTFJ";"S";"0166";"* RAZ année - à la date de référence RTT"
"SGTTFJ";"S";"0167";"   SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGTTFJ";"S";"0168";"      FAIRE RAZCTP"
"SGTTFJ";"S";"0169";"   FINSI"
"SGTTFJ";"S";"0170";"*"
"SGTTFJ";"S";"0171";"   LOCA_DROIT = 1"
"SGTTFJ";"S";"0172";"*"
"SGTTFJ";"S";"0173";"   SI LOCA_DROIT = 1"
"SGTTFJ";"S";"0174";"*"
"SGTTFJ";"S";"0175";"****** Calcul acquisition dés le 1° jours de la période *******"
"SGTTFJ";"S";"0176";"*"
"SGTTFJ";"S";"0177";"*"
"SGTTFJ";"S";"0178";"* Acquisition à période de référence >>"
"SGTTFJ";"S";"0179";"      SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGTTFJ";"S";"0180";"      OU HJOU_SJQDEBC = 1"
"SGTTFJ";"S";"0181";"      OU LOCA_CHGT = 1"
"SGTTFJ";"S";"0182";"*"
"SGTTFJ";"S";"0183";"* RAZ du pris"
"SGTTFJ";"S";"0184";"         SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGTTFJ";"S";"0185";"            HJOU_IJRCRTTJOU = 0"
"SGTTFJ";"S";"0186";"         FINSI"
"SGTTFJ";"S";"0187";"*"
"SGTTFJ";"S";"0188";"         LOCA_DEB(1:4) = HJOU_DATE(1:4)"
"SGTTFJ";"S";"0189";"         LOCA_FIN(1:4) = HJOU_DATE(1:4)"
"SGTTFJ";"S";"0190";"*"
"SGTTFJ";"S";"0191";"* Proratise en fonction de la présence sur l'année en cours"
"SGTTFJ";"S";"0192";"*"
"SGTTFJ";"S";"0193";"         POUR PERIODES"
"SGTTFJ";"S";"0194";"* On prend que les contrats en cours d'année"
"SGTTFJ";"S";"0195";"            SI CTRA_DATDEB <= LOCA_FIN"
"SGTTFJ";"S";"0196";"               SI CTRA_DATFIN >= LOCA_DEB"
"SGTTFJ";"S";"0197";"                  SI CTRA_SCIFORFJ = ""1"""
"SGTTFJ";"S";"0198";"* Calcul nombre du jour de présence en calendaire sur l'année"
"SGTTFJ";"S";"0199";"                     FAIRE DRTT"
"SGTTFJ";"S";"0200";"                     LOCA_DRTT = LOCA_DRTT + LOCA_DRTTI"
"SGTTFJ";"S";"0201";"                  FINSI"
"SGTTFJ";"S";"0202";"               FINSI"
"SGTTFJ";"S";"0203";"            FINSI"
"SGTTFJ";"S";"0204";"         FINPOUR"
"SGTTFJ";"S";"0205";"*"
"SGTTFJ";"S";"0206";"         HJOU_IJRARTTJOU = LOCA_DRTT"
"SGTTFJ";"S";"0207";"*"
"SGTTFJ";"S";"0208";"* Gestion de l'arrondi à fin de période"
"SGTTFJ";"S";"0209";"         SI HJOU_IJRARTTJOU > 0"
"SGTTFJ";"S";"0210";"            LOCA_RESTE = HJOU_IJRARTTJOU % 1"
"SGTTFJ";"S";"0211";"            LOCA_ENTIER = HJOU_IJRARTTJOU - LOCA_RESTE"
"SGTTFJ";"S";"0212";"            SI LOCA_RESTE > 0.5"
"SGTTFJ";"S";"0213";"               LOCA_ENTIER = LOCA_ENTIER + 1"
"SGTTFJ";"S";"0214";"            SINON"
"SGTTFJ";"S";"0215";"               SI LOCA_RESTE > 0"
"SGTTFJ";"S";"0216";"                  LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGTTFJ";"S";"0217";"               FINSI"
"SGTTFJ";"S";"0218";"            FINSI"
"SGTTFJ";"S";"0219";"            HJOU_IJRARTTJOU = LOCA_ENTIER"
"SGTTFJ";"S";"0220";"         FINSI"
"SGTTFJ";"S";"0221";"*"
"SGTTFJ";"S";"0222";"      FINSI"
"SGTTFJ";"S";"0223";"   FINSI"
"SGTTFJ";"S";"0224";"*"
"SGTTFJ";"S";"0225";"   SI HJOU_IJRARTTJOU < 0"
"SGTTFJ";"S";"0226";"      HJOU_IJRARTTJOU = 0"
"SGTTFJ";"S";"0227";"   FINSI"
"SGTTFJ";"S";"0228";"*"
"SGTTFJ";"S";"0229";"****** Calcul des soldes *******"
"SGTTFJ";"S";"0230";"   HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"SGTTFJ";"S";"0231";"*"
"SGTTFJ";"S";"0232";"****** Traitement du motif RTT pris >> *************************************************************"
"SGTTFJ";"S";"0233";"*"
"SGTTFJ";"S";"0234";"   POUR ACTIVITES"
"SGTTFJ";"S";"0235";"      SI HABS_MOTIF = PARD_IDIVMRTTSA"
"SGTTFJ";"S";"0236";"         LOCA_MOTIF = HABS_MOTIF"
"SGTTFJ";"S";"0237";"         LOCA_MOT = 1"
"SGTTFJ";"S";"0238";"         LOCA_ENLEVER = 0"
"SGTTFJ";"S";"0239";"*"
"SGTTFJ";"S";"0240";"         SI HJOU_IJQPRETHEJ = 0"
"SGTTFJ";"S";"0241";"            LOCA_ENLEVER = 1"
"SGTTFJ";"S";"0242";"         FINSI"
"SGTTFJ";"S";"0243";"*"
"SGTTFJ";"S";"0244";"         SI LOCA_ENLEVER = 0"
"SGTTFJ";"S";"0245";"            SI HABS_VALORIS = ""J"""
"SGTTFJ";"S";"0246";"               SI PROF_ABSENM = 0"
"SGTTFJ";"S";"0247";"               OU PROF_ABSENS = 0"
"SGTTFJ";"S";"0248";"                  HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + 0.5"
"SGTTFJ";"S";"0249";"                  HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - 0.5"
"SGTTFJ";"S";"0250";"               SINON"
"SGTTFJ";"S";"0251";"                  HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + 1"
"SGTTFJ";"S";"0252";"                  HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - 1"
"SGTTFJ";"S";"0253";"               FINSI"
"SGTTFJ";"S";"0254";"            SINON"
"SGTTFJ";"S";"0255";"               HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + 0.5"
"SGTTFJ";"S";"0256";"               HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - 0.5"
"SGTTFJ";"S";"0257";"            FINSI"
"SGTTFJ";"S";"0258";"         FINSI"
"SGTTFJ";"S";"0259";"      FINSI"
"SGTTFJ";"S";"0260";"   FINPOUR"
"SGTTFJ";"S";"0261";"*"
"SGTTFJ";"S";"0262";"   SI LOCA_ENLEVER = 1"
"SGTTFJ";"S";"0263";"      ENLEVER LOCA_MOTIF"
"SGTTFJ";"S";"0264";"   FINSI"
"SGTTFJ";"S";"0265";"*"
"SGTTFJ";"S";"0266";"***** Gestion du pris RTT en attente >> ******"
"SGTTFJ";"S";"0267";"*"
"SGTTFJ";"S";"0268";"   POUR WACTIVITES"
"SGTTFJ";"S";"0269";"      SI WABS_ANNUL = ""0"""
"SGTTFJ";"S";"0270";"         SI LOCA_FERI <> 1"
"SGTTFJ";"S";"0271";"            SI PROF_PRETHEO > 0.00"
"SGTTFJ";"S";"0272";"               SI WABS_MOTIF = PARD_IDIVMRTTSA"
"SGTTFJ";"S";"0273";"* Gestion de la valorisation >>"
"SGTTFJ";"S";"0274";"                  SI WABS_VALORIS = ""J"""
"SGTTFJ";"S";"0275";"                     SI PROF_ABSENM = 0"
"SGTTFJ";"S";"0276";"                     OU PROF_ABSENS = 0"
"SGTTFJ";"S";"0277";"                        LOCA_VALW = LOCA_VALW + 0.5"
"SGTTFJ";"S";"0278";"                     SINON"
"SGTTFJ";"S";"0279";"                        LOCA_VALW = 1"
"SGTTFJ";"S";"0280";"                     FINSI"
"SGTTFJ";"S";"0281";"                  SINON"
"SGTTFJ";"S";"0282";"                     LOCA_VALW = LOCA_VALW + 0.5"
"SGTTFJ";"S";"0283";"                  FINSI"
"SGTTFJ";"S";"0284";"*"
"SGTTFJ";"S";"0285";"               FINSI"
"SGTTFJ";"S";"0286";"            FINSI"
"SGTTFJ";"S";"0287";"         FINSI"
"SGTTFJ";"S";"0288";"      FINSI"
"SGTTFJ";"S";"0289";"   FINPOUR"
"SGTTFJ";"S";"0290";"*"
"SGTTFJ";"S";"0291";"   SI LOCA_VALW > 1"
"SGTTFJ";"S";"0292";"      LOCA_VALW = 1"
"SGTTFJ";"S";"0293";"   FINSI"
"SGTTFJ";"S";"0294";"*"
"SGTTFJ";"S";"0295";"   SI LOCA_VALW > 0"
"SGTTFJ";"S";"0296";"      HJOU_SJRCRTTW = HJOU_SJRCRTTW + LOCA_VALW"
"SGTTFJ";"S";"0297";"   FINSI"
"SGTTFJ";"S";"0298";"*"
"SGTTFJ";"S";"0299";"* Analyse des consignes d'initialisation et de mise à jour"
"SGTTFJ";"S";"0300";"*"
"SGTTFJ";"S";"0301";"   POUR ACTIVITES"
"SGTTFJ";"S";"0302";"*"
"SGTTFJ";"S";"0303";"      SI HABS_MOTIF = ""ZARTJ"""
"SGTTFJ";"S";"0304";"         HJOU_IJRACRTTJM = HABS_MOTINBR"
"SGTTFJ";"S";"0305";"         HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + HJOU_IJRACRTTJM"
"SGTTFJ";"S";"0306";"      FINSI"
"SGTTFJ";"S";"0307";"*"
"SGTTFJ";"S";"0308";"      SI HABS_MOTIF = ""XARTJ"""
"SGTTFJ";"S";"0309";"         HJOU_IJRACRTTJM = HJOU_IJRACRTTJM + HABS_MOTINBR"
"SGTTFJ";"S";"0310";"         HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + HJOU_IJRACRTTJM"
"SGTTFJ";"S";"0311";"      FINSI"
"SGTTFJ";"S";"0312";"*"
"SGTTFJ";"S";"0313";"      SI HABS_MOTIF = ""ZRTJ"""
"SGTTFJ";"S";"0314";"         HJOU_IJRARTTJOU = HABS_MOTINBR"
"SGTTFJ";"S";"0315";"      FINSI"
"SGTTFJ";"S";"0316";"      SI HABS_MOTIF = ""XRTJ"""
"SGTTFJ";"S";"0317";"         HJOU_IJRARTTJOU = HJOU_IJRARTTJOU + HABS_MOTINBR"
"SGTTFJ";"S";"0318";"      FINSI"
"SGTTFJ";"S";"0319";"*"
"SGTTFJ";"S";"0320";"      SI HABS_MOTIF = ""ZCRJ"""
"SGTTFJ";"S";"0321";"         HJOU_IJRCRTTJOU = HABS_MOTINBR"
"SGTTFJ";"S";"0322";"      FINSI"
"SGTTFJ";"S";"0323";"      SI HABS_MOTIF = ""XCRJ"""
"SGTTFJ";"S";"0324";"         HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + HABS_MOTINBR"
"SGTTFJ";"S";"0325";"      FINSI"
"SGTTFJ";"S";"0326";"   FINPOUR"
"SGTTFJ";"S";"0327";"*"
"SGTTFJ";"S";"0328";"* Calcul des soldes"
"SGTTFJ";"S";"0329";"   HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"SGTTFJ";"S";"0330";"*"
"SGTTFJ";"S";"0331";"   SI LOCA_MOT = 1"
"SGTTFJ";"S";"0332";"      SI HJOU_IJRSNBJRTT < 0"
"SGTTFJ";"S";"0333";"         ANOMALIE 135"
"SGTTFJ";"S";"0334";"         SI TEMP_CNMOTIF = LOCA_MOTIF"
"SGTTFJ";"S";"0335";"            TEMP_CNRETOUR = 2"
"SGTTFJ";"S";"0336";"            TEMP_CNMESS = 135"
"SGTTFJ";"S";"0337";"         FINSI"
"SGTTFJ";"S";"0338";"      FINSI"
"SGTTFJ";"S";"0339";"   FINSI"
"SGTTFJ";"S";"0340";"*"
"SGTTFJ";"S";"0341";"* Consigne de transfert du compteur RTT en jour en CET"
"SGTTFJ";"S";"0342";"   POUR ACTIVITES"
"SGTTFJ";"S";"0343";"      SI HABS_MOTIF = ""YCETRTT"""
"SGTTFJ";"S";"0344";"         SI HABS_MOTINBR <= HJOU_IJRSNBJRTT"
"SGTTFJ";"S";"0345";"            HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + HABS_MOTINBR"
"SGTTFJ";"S";"0346";"         SINON"
"SGTTFJ";"S";"0347";"            ANOMALIE 158"
"SGTTFJ";"S";"0348";"         FINSI"
"SGTTFJ";"S";"0349";"      FINSI"
"SGTTFJ";"S";"0350";"*"
"SGTTFJ";"S";"0351";"* Transfert de RTT en jours  en don absence"
"SGTTFJ";"S";"0352";"      SI HABS_MOTIF = ""YDONRTT"""
"SGTTFJ";"S";"0353";"         SI HJOU_IJRSNBJRTT >= HABS_MOTINBR"
"SGTTFJ";"S";"0354";"            HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + HABS_MOTINBR"
"SGTTFJ";"S";"0355";"            HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"SGTTFJ";"S";"0356";"         SINON"
"SGTTFJ";"S";"0357";"            HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + HABS_MOTINBR"
"SGTTFJ";"S";"0358";"            HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"SGTTFJ";"S";"0359";"            ANOMALIE 190"
"SGTTFJ";"S";"0360";"            SI TEMP_CNMOTIF = ""YDONRTT"""
"SGTTFJ";"S";"0361";"               TEMP_CNRETOUR = 2"
"SGTTFJ";"S";"0362";"               TEMP_CNMESS = 190"
"SGTTFJ";"S";"0363";"            FINSI"
"SGTTFJ";"S";"0364";"         FINSI"
"SGTTFJ";"S";"0365";"      FINSI"
"SGTTFJ";"S";"0366";"*"
"SGTTFJ";"S";"0367";"   FINPOUR"
"SGTTFJ";"S";"0368";"*"
"SGTTFJ";"S";"0369";"* Calcul des soldes"
"SGTTFJ";"S";"0370";"   HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"SGTTFJ";"S";"0371";"*"
"SGTTFJ";"S";"0372";"* Soldes previsionnels"
"SGTTFJ";"S";"0373";"*"
"SGTTFJ";"S";"0374";"   SI CTRA_DATFIN > TEMP_DATJOU"
"SGTTFJ";"S";"0375";"      SI HJOU_SJQFINC = 1"
"SGTTFJ";"S";"0376";"         SI CTRA_DATFIN < LOCA_DATEFU"
"SGTTFJ";"S";"0377";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGTTFJ";"S";"0378";"            LOCA_DATEFU = TEMP_DXFINPER"
"SGTTFJ";"S";"0379";"         FINSI"
"SGTTFJ";"S";"0380";"      SINON"
"SGTTFJ";"S";"0381";"         SI HJOU_SJQFINC = 1"
"SGTTFJ";"S";"0382";"            SI CTRA_DATFIN < LOCA_DATEFU2"
"SGTTFJ";"S";"0383";"               DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGTTFJ";"S";"0384";"               LOCA_DATEFU2 = TEMP_DXFINPER"
"SGTTFJ";"S";"0385";"            FINSI"
"SGTTFJ";"S";"0386";"         FINSI"
"SGTTFJ";"S";"0387";"      FINSI"
"SGTTFJ";"S";"0388";"   FINSI"
"SGTTFJ";"S";"0389";"***"
"SGTTFJ";"S";"0390";"   SI TEMP_DATSUI = LOCA_DATEFU"
"SGTTFJ";"S";"0391";"      EMPL_IEQSPRTTJO = HJOU_IJRSNBJRTT - HJOU_SJRCRTTW"
"SGTTFJ";"S";"0392";"   FINSI"
"SGTTFJ";"S";"0393";"**"
"SGTTFJ";"S";"0394";"   SI TEMP_DATSUI = LOCA_DATEFU2"
"SGTTFJ";"S";"0395";"      EMPL_IEQSPRTTJ2 = HJOU_IJRSNBJRTT"
"SGTTFJ";"S";"0396";"   FINSI"
"SGTTFJ";"S";"0397";"*"
"SGTTFJ";"S";"0398";"* Forfait jours ?"
"SGTTFJ";"S";"0399";"FINSI"
"SGTTFJ";"S";"0400";"*"
"SGTTFJ";"S";"0401";"FIN"
"SGTTFJ";"S";"0402";"*"
"SGTTFJ";"S";"0403";"PROC RAZCTP"
"SGTTFJ";"S";"0404";"   HJOU_IJRARTTJOU = 0"
"SGTTFJ";"S";"0405";"   HJOU_IJRCRTTJOU = 0"
"SGTTFJ";"S";"0406";"   HJOU_IJRSNBJRTT = 0"
"SGTTFJ";"S";"0407";"   HJOU_IJRACRTTJM = 0"
"SGTTFJ";"S";"0408";"   HJOU_SJRABRTTM = 0"
"SGTTFJ";"S";"0409";"   HJOU_SJRACQJRTT = 0"
"SGTTFJ";"S";"0410";"   HJOU_SJRNABSABR = 0"
"SGTTFJ";"S";"0411";"*"
"SGTTFJ";"S";"0412";"   HJOU_SJRABRTTM = 0"
"SGTTFJ";"S";"0413";"   HJOU_SJRABRTTA = 0"
"SGTTFJ";"S";"0414";"FINPROC"
"SGTTFJ";"S";"0415";"*"
"SGTTFJ";"S";"0416";"*"
"SGTTFJ";"S";"0417";"* Calcul nombre de jour de présence en calendaire sur l'année"
"SGTTFJ";"S";"0418";"*"
"SGTTFJ";"S";"0419";"PROC DRTT"
"SGTTFJ";"S";"0420";"*"
"SGTTFJ";"S";"0421";"   DEF LOCA_DEBX D"
"SGTTFJ";"S";"0422";"   LOCA_DEBX = "" """
"SGTTFJ";"S";"0423";"   DEF LOCA_FINX D"
"SGTTFJ";"S";"0424";"   LOCA_FINX = "" """
"SGTTFJ";"S";"0425";"*"
"SGTTFJ";"S";"0426";"   LOCA_NBJI = 0"
"SGTTFJ";"S";"0427";"   LOCA_DRTTI = 0"
"SGTTFJ";"S";"0428";"   LOCA_COEFFI = 0"
"SGTTFJ";"S";"0429";"*"
"SGTTFJ";"S";"0430";"* Init droit RTT pour forfait jour selon société :"
"SGTTFJ";"S";"0431";"*"
"SGTTFJ";"S";"0432";"* Société EC >>"
"SGTTFJ";"S";"0433";"   SI CTRA_SCISOCIETE = ""EC"""
"SGTTFJ";"S";"0434";"      LOCA_DRTTI = PARD_SDIRTFJEC"
"SGTTFJ";"S";"0435";"   FINSI"
"SGTTFJ";"S";"0436";"*"
"SGTTFJ";"S";"0437";"* Société ES >>"
"SGTTFJ";"S";"0438";"   SI CTRA_SCISOCIETE = ""ES"""
"SGTTFJ";"S";"0439";"      LOCA_DRTTI = PARD_SDIRTFJES"
"SGTTFJ";"S";"0440";"   FINSI"
"SGTTFJ";"S";"0441";"*"
"SGTTFJ";"S";"0442";"* Société HE >>"
"SGTTFJ";"S";"0443";"   SI CTRA_SCISOCIETE = ""HE"""
"SGTTFJ";"S";"0444";"      LOCA_DRTTI = PARD_SDIRTFJHE"
"SGTTFJ";"S";"0445";"   FINSI"
"SGTTFJ";"S";"0446";"*"
"SGTTFJ";"S";"0447";"* Société IR >>"
"SGTTFJ";"S";"0448";"   SI CTRA_SCISOCIETE = ""IR"""
"SGTTFJ";"S";"0449";"      LOCA_DRTTI = PARD_SDIRTFJIR"
"SGTTFJ";"S";"0450";"   FINSI"
"SGTTFJ";"S";"0451";"*"
"SGTTFJ";"S";"0452";"* Société MO >>"
"SGTTFJ";"S";"0453";"   SI CTRA_SCISOCIETE = ""MO"""
"SGTTFJ";"S";"0454";"      LOCA_DRTTI = PARD_SDIRTFJMO"
