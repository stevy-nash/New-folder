"SHSUPPDIM";"S";"0515";"   SI HABS_MOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM";"S";"0516";"      LOCA_DURHS = LOCA_DURHS + HABS_MOTIDUR"
"SHSUPPDIM";"S";"0517";"      SI HJOU_SJRHSPRC = "" """
