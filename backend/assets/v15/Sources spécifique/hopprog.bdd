"SCONTR";"S";"0138";"   SI HJOU_IJRTTEFFEH > LOCA_IDISMXTHEB"
"SCONTR";"S";"0139";"      ANOMALIE 130"
"SCONTR";"S";"0140";"   FINSI"
"SCONTR";"S";"0141";"* Stockage des 12 dernieres semaines"
"SCONTR";"S";"0142";"   HJOU_IJRHTRAS01 = HJOU_IJRHTRAS02"
"SCONTR";"S";"0143";"   HJOU_IJRHTRAS02 = HJOU_IJRHTRAS03"
"SCONTR";"S";"0144";"   HJOU_IJRHTRAS03 = HJOU_IJRHTRAS04"
"SCONTR";"S";"0145";"   HJOU_IJRHTRAS04 = HJOU_IJRHTRAS05"
"SCONTR";"S";"0146";"   HJOU_IJRHTRAS05 = HJOU_IJRHTRAS06"
"SCONTR";"S";"0147";"   HJOU_IJRHTRAS06 = HJOU_IJRHTRAS07"
"SCONTR";"S";"0148";"   HJOU_IJRHTRAS07 = HJOU_IJRHTRAS08"
"SCONTR";"S";"0149";"   HJOU_IJRHTRAS08 = HJOU_IJRHTRAS09"
"SCONTR";"S";"0150";"   HJOU_IJRHTRAS09 = HJOU_IJRHTRAS10"
"SCONTR";"S";"0151";"   HJOU_IJRHTRAS10 = HJOU_IJRHTRAS11"
"SCONTR";"S";"0152";"   HJOU_IJRHTRAS11 = HJOU_IJRHTRAS12"
"SCONTR";"S";"0153";"   HJOU_IJRHTRAS12 = LOCA_IJRTTEFFEH"
"SCONTR";"S";"0154";"*    calcul de la moyenne"
"SCONTR";"S";"0155";"*"
"SCONTR";"S";"0156";"   HJOU_IJRHTRM12S = HJOU_IJRHTRAS01 + HJOU_IJRHTRAS02"
"SCONTR";"S";"0157";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS03"
"SCONTR";"S";"0158";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS04"
"SCONTR";"S";"0159";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS05"
"SCONTR";"S";"0160";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS06"
"SCONTR";"S";"0161";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS07"
"SCONTR";"S";"0162";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS08"
"SCONTR";"S";"0163";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS09"
"SCONTR";"S";"0164";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS10"
"SCONTR";"S";"0165";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS11"
"SCONTR";"S";"0166";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S + HJOU_IJRHTRAS12"
"SCONTR";"S";"0167";"   HJOU_IJRHTRM12S = HJOU_IJRHTRM12S / 12"
