"SCONTR";"S";"0404";"*                        DELAI DE CARENCE                         *"
"SCONTR";"S";"0405";"*-----------------------------------------------------------------"
"SCONTR";"S";"0406";"* Stockage de la date de fin de contrat"
"SCONTR";"S";"0407";"*"
