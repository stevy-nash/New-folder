"ICONSCPSCH";"S";"0542";"                                    HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + HJOU_IJRSCPNTRA"
"ICONSCPSCH";"S";"0543";"                                    *"
"ICONSCPSCH";"S";"0544";"                                    HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + HJOU_IJRSCPNTRA"
"ICONSCPSCH";"S";"0545";"                                    HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HJOU_IJRSCPNTRA"
"ICONSCPSCH";"S";"0546";"                                    HJOU_IJRSCPNTRA = 0"
"ICONSCPSCH";"S";"0547";"                                    *"
"ICONSCPSCH";"S";"0548";"                                    LOCA_CP = 0.5"
"ICONSCPSCH";"S";"0549";"                                    LOCA_VAL = 0.5"
"ICONSCPSCH";"S";"0550";"                                    SI LOCA_CPR > 0"
"ICONSCPSCH";"S";"0551";"                                    OU LOCA_CPAN > 0"
"ICONSCPSCH";"S";"0552";"                                        LOCA_VALCP = ""A"""
"ICONSCPSCH";"S";"0553";"                                    SINON"
