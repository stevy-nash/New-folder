"IPIXID";"S";"0031";"   *   CTRA_ICIQUALIF;O;A40;X;;;789;;;C3;QUALIFICATION;"
"IPIXID";"S";"0032";"   *   CTRA_ICICMDE;O;A30;X;;;789;;;C3;COMMANDE PIXID;"
