"SACQCP";"S";"0265";"FINSI"
"SACQCP";"S";"0266";"* RAZ si solde négatif P4 >>"
"SACQCP";"S";"0267";"SI HJOU_SJRSPREP4 = 0"
"SACQCP";"S";"0268";"   HJOU_SJRDAFREP4 = "" """
"SACQCP";"S";"0269";"   HJOU_SJRDPREP4 = 0"
"SACQCP";"S";"0270";"   HJOU_SJRCPREP4 = 0"
"SACQCP";"S";"0271";"   HJOU_SJRSPREP4 = HJOU_SJRDPREP4 - HJOU_SJRCPREP4"
"SACQCP";"S";"0272";"FINSI"
"SACQCP";"S";"0273";"*"
"SACQCP";"S";"0274";"SI HJOU_SJRDAENAT <> "" """
"SACQCP";"S";"0275";"* MAJ du flag d'envoie"
"SACQCP";"S";"0276";"   SI HJOU_DATE = HJOU_SJRDAENAT"
"SACQCP";"S";"0277";"      HJOU_SJQFLATTCP = 1"
"SACQCP";"S";"0278";"   FINSI"
"SACQCP";"S";"0279";"* RAZ date d'envoie attestation"
"SACQCP";"S";"0280";"   SI HJOU_DATE > HJOU_SJRDAENAT"
"SACQCP";"S";"0281";"      HJOU_SJRDAENAT = "" """
"SACQCP";"S";"0282";"   FINSI"
"SACQCP";"S";"0283";"FINSI"
"SACQCP";"S";"0284";"*"
"SACQCP";"S";"0285";"* Test si gestion des cp"
"SACQCP";"S";"0286";"SI HJOU_IJIACOPRIN = ""1"""
"SACQCP";"S";"0287";"*"
"SACQCP";"S";"0288";"***** Calcul de l'acquition jour par jour dans le mois >>"
"SACQCP";"S";"0289";"*"
"SACQCP";"S";"0290";"   LOCA_ACQAN = HJOU_SJQDRCPAN"
"SACQCP";"S";"0291";"   LOCA_ACQMOIS = LOCA_ACQAN / 12"
"SACQCP";"S";"0292";"*"
"SACQCP";"S";"0293";"   SI HJOU_JOUR <= LOCA_JSEM"
"SACQCP";"S";"0294";"      LOCA_JOUV = 1"
"SACQCP";"S";"0295";"      LOCA_ACQJOUR = LOCA_ACQMOIS / LOCA_JOUVM"
"SACQCP";"S";"0296";"      LOCA_ACQJOUR10 = LOCA_25M / LOCA_JOUVM"
"SACQCP";"S";"0297";"   FINSI"
"SACQCP";"S";"0298";"*"
"SACQCP";"S";"0299";"   HJOU_SJRNBJOUVM = HJOU_SJRNBJOUVM + LOCA_JOUV"
"SACQCP";"S";"0300";"   HJOU_IJRCPTJTRA = HJOU_IJRCPTJTRA + LOCA_JOUV"
"SACQCP";"S";"0301";"*"
"SACQCP";"S";"0302";"* Calcul nombre de jour consécutifs d'absences qui réduit acquis CP >>"
"SACQCP";"S";"0303";"*"
"SACQCP";"S";"0304";"   POUR ACTIVITES"
"SACQCP";"S";"0305";"      SI MOTI_SMIABATCP = ""2"""
"SACQCP";"S";"0306";"      OU MOTI_SMIABATCP = ""3"""
"SACQCP";"S";"0307";"         LOCA_ABATCP = MOTI_SMIABATCP"
"SACQCP";"S";"0308";"         HJOU_SJRDAENAT = "" """
"SACQCP";"S";"0309";"         SI HABS_VALORIS = ""J"""
"SACQCP";"S";"0310";"            LOCA_ABS = 1"
"SACQCP";"S";"0311";"         FINSI"
"SACQCP";"S";"0312";"         SI HABS_VALORIS = ""M"""
"SACQCP";"S";"0313";"         OU HABS_VALORIS = ""A"""
"SACQCP";"S";"0314";"            LOCA_ABS = LOCA_ABS + 0.5"
"SACQCP";"S";"0315";"         FINSI"
"SACQCP";"S";"0316";"      FINSI"
"SACQCP";"S";"0317";"   FINPOUR"
"SACQCP";"S";"0318";"*"
"SACQCP";"S";"0319";"* On regarde ensuite si la journée est une journée de Repos"
"SACQCP";"S";"0320";"   SI HJOU_IJQPRETHEJ = 0"
"SACQCP";"S";"0321";"      LOCA_SAMDIM = 1"
"SACQCP";"S";"0322";"   FINSI"
"SACQCP";"S";"0323";"*"
"SACQCP";"S";"0324";"* On cumule les jours d'absence consécutifs dans un compteur"
"SACQCP";"S";"0325";"   SI LOCA_ABS >= 1"
"SACQCP";"S";"0326";"      HJOU_SJRNABCONS = HJOU_SJRNABCONS + 1"
"SACQCP";"S";"0327";"      SI HJOU_SJRNABCONS = 1"
"SACQCP";"S";"0328";"         HJOU_SJRDATCRE = HJOU_DATE"
"SACQCP";"S";"0329";"      FINSI"
"SACQCP";"S";"0330";"   FINSI"
"SACQCP";"S";"0331";"*"
"SACQCP";"S";"0332";"* Si Pas d'absence ni de jour ou la théorie est = 0,"
"SACQCP";"S";"0333";"* le décompte repart à 0"
"SACQCP";"S";"0334";"   SI LOCA_ABS < 1"
"SACQCP";"S";"0335";"      SI LOCA_SAMDIM < 1"
"SACQCP";"S";"0336";"* RAZ du nbre absence consecutif sur l'année si à cheval sur 2 période"
"SACQCP";"S";"0337";"         SI HJOU_SJRJOURA < HJOU_SJRNABSABC"
"SACQCP";"S";"0338";"            HJOU_SJRNABSABC = 0"
"SACQCP";"S";"0339";"         FINSI"
"SACQCP";"S";"0340";"*"
"SACQCP";"S";"0341";"* On recherche les périodes avec du solde et date vide >>"
"SACQCP";"S";"0342";"* Période 1"
"SACQCP";"S";"0343";"         SI HJOU_SJRSPREP1 > 0"
"SACQCP";"S";"0344";"            SI HJOU_SJRDAFREP1 = "" """
"SACQCP";"S";"0345";"               DATAJT HJOU_DATE 12 ""M"" PARD_SDIMOICPR"
"SACQCP";"S";"0346";"               HJOU_SJRDAFREP1 = TEMP_DXFINPER"
"SACQCP";"S";"0347";"            FINSI"
"SACQCP";"S";"0348";"         FINSI"
"SACQCP";"S";"0349";"* Période 2"
"SACQCP";"S";"0350";"         SI HJOU_SJRSPREP2 > 0"
"SACQCP";"S";"0351";"            SI HJOU_SJRDAFREP2 = "" """
"SACQCP";"S";"0352";"               DATAJT HJOU_DATE 12 ""M"" PARD_SDIMOICPR"
"SACQCP";"S";"0353";"               HJOU_SJRDAFREP2 = TEMP_DXFINPER"
"SACQCP";"S";"0354";"            FINSI"
"SACQCP";"S";"0355";"         FINSI"
"SACQCP";"S";"0356";"* Période 3"
"SACQCP";"S";"0357";"         SI HJOU_SJRSPREP3 > 0"
"SACQCP";"S";"0358";"            SI HJOU_SJRDAFREP3 = "" """
"SACQCP";"S";"0359";"               DATAJT HJOU_DATE 12 ""M"" PARD_SDIMOICPR"
"SACQCP";"S";"0360";"               HJOU_SJRDAFREP3 = TEMP_DXFINPER"
"SACQCP";"S";"0361";"            FINSI"
"SACQCP";"S";"0362";"         FINSI"
"SACQCP";"S";"0363";"* Période 4"
"SACQCP";"S";"0364";"         SI HJOU_SJRSPREP4 > 0"
"SACQCP";"S";"0365";"            SI HJOU_SJRDAFREP4 = "" """
"SACQCP";"S";"0366";"               DATAJT HJOU_DATE 12 ""M"" PARD_SDIMOICPR"
"SACQCP";"S";"0367";"               HJOU_SJRDAFREP4 = TEMP_DXFINPER"
"SACQCP";"S";"0368";"            FINSI"
"SACQCP";"S";"0369";"         FINSI"
"SACQCP";"S";"0370";"*"
"SACQCP";"S";"0371";"* Si arrêt de plus de 30 jours ?"
"SACQCP";"S";"0372";"         SI HJOU_SJRDATCRE <> "" """
"SACQCP";"S";"0373";"            DATDIFF HJOU_SJRDATCRE 12 HJOU_DATE 12"
"SACQCP";"S";"0374";"*"
"SACQCP";"S";"0375";"            SI TEMP_NXJOUR > 30"
"SACQCP";"S";"0376";"               DATAJT HJOU_DATE 12 ""J"" 4"
"SACQCP";"S";"0377";"               HJOU_SJRDAENAT = TEMP_DXFINPER"
"SACQCP";"S";"0378";"            FINSI"
"SACQCP";"S";"0379";"         FINSI"
"SACQCP";"S";"0380";"*"
"SACQCP";"S";"0381";"         HJOU_SJRNABCONS = 0"
"SACQCP";"S";"0382";"         HJOU_SJRDATCRE = "" """
"SACQCP";"S";"0383";"      FINSI"
"SACQCP";"S";"0384";"   FINSI"
"SACQCP";"S";"0385";"*"
"SACQCP";"S";"0386";"* RAZ Nb absence maladie à début de période"
"SACQCP";"S";"0387";"   SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SACQCP";"S";"0388";"      SI HJOU_SJRDATCRE = "" """
"SACQCP";"S";"0389";"      OU HJOU_SJRDATCRE >= HJOU_DATE"
"SACQCP";"S";"0390";"         HJOU_SJRNABSABC = 0"
"SACQCP";"S";"0391";"      FINSI"
"SACQCP";"S";"0392";"   FINSI"
"SACQCP";"S";"0393";"*"
"SACQCP";"S";"0394";"* Compte nombre de jour absence pour abattement"
"SACQCP";"S";"0395";"   POUR ACTIVITES"
"SACQCP";"S";"0396";"* Init par consigne"
"SACQCP";"S";"0397";"      SI HABS_MOTIF = ""ZNABCP"""
"SACQCP";"S";"0398";"         HJOU_SJRNABSABC = HABS_MOTINBR"
"SACQCP";"S";"0399";"      FINSI"
"SACQCP";"S";"0400";"      SI HABS_MOTIF = ""ZNBACS"""
"SACQCP";"S";"0401";"         HJOU_SJRNABCONS = HABS_MOTINBR"
"SACQCP";"S";"0402";"      FINSI"
"SACQCP";"S";"0403";"*"
"SACQCP";"S";"0404";"      SI MOTI_SMIABATCP = ""2"""
"SACQCP";"S";"0405";"      OU MOTI_SMIABATCP = ""3"""
"SACQCP";"S";"0406";"         HJOU_SJRNABSABC = HJOU_SJRNABSABC + 1"
"SACQCP";"S";"0407";"      FINSI"
"SACQCP";"S";"0408";"   FINPOUR"
"SACQCP";"S";"0409";"*"
"SACQCP";"S";"0410";"*"
"SACQCP";"S";"0411";"* Contrôle si motif peut réduire l'acquisiton >>"
"SACQCP";"S";"0412";"*"
"SACQCP";"S";"0413";"   POUR ACTIVITES"
"SACQCP";"S";"0414";"      SI HABS_MOTYPE <> ""C"""
"SACQCP";"S";"0415";"         SI HABS_VALORIS = ""J"""
"SACQCP";"S";"0416";"* Abat dès le premier jour"
"SACQCP";"S";"0417";"            SI MOTI_SMIABATCP = ""1"""
"SACQCP";"S";"0418";"               LOCA_ACQJOUR = 0"
"SACQCP";"S";"0419";"               LOCA_ACQJOUR10 = 0"
"SACQCP";"S";"0420";"            FINSI"
"SACQCP";"S";"0421";"* Abat selon nombre de jour de maintiens"
"SACQCP";"S";"0422";"            SI MOTI_SMIABATCP = ""2"""
"SACQCP";"S";"0423";"               SI HJOU_SJRNABSABC > HJOU_SJRNBJMAIN"
"SACQCP";"S";"0424";"                  LOCA_ACQJOUR = LOCA_ACQJOUR * 0.8"
"SACQCP";"S";"0425";"                  LOCA_ACQJOUR10 = LOCA_ACQJOUR10 * 0.8"
"SACQCP";"S";"0426";"               FINSI"
"SACQCP";"S";"0427";"            FINSI"
"SACQCP";"S";"0428";"* Abat à partir du 365° jour"
"SACQCP";"S";"0429";"            SI MOTI_SMIABATCP = ""3"""
"SACQCP";"S";"0430";"               SI HJOU_SJRNABSABC > LOCA_365"
"SACQCP";"S";"0431";"                  LOCA_ACQJOUR = LOCA_ACQJOUR * 0.8"
"SACQCP";"S";"0432";"                  LOCA_ACQJOUR10 = LOCA_ACQJOUR10 * 0.8"
"SACQCP";"S";"0433";"               FINSI"
"SACQCP";"S";"0434";"            FINSI"
"SACQCP";"S";"0435";"         FINSI"
"SACQCP";"S";"0436";"      FINSI"
"SACQCP";"S";"0437";"   FINPOUR"
"SACQCP";"S";"0438";"*"
"SACQCP";"S";"0439";"   SI HJOU_SJRNBJOUVM <= LOCA_JOUVM"
"SACQCP";"S";"0440";"      HJOU_SJRACQCPM = HJOU_SJRACQCPM + LOCA_ACQJOUR"
"SACQCP";"S";"0441";"      HJOU_SJRACQCPMP = HJOU_SJRACQCPMP + LOCA_ACQJOUR10"
"SACQCP";"S";"0442";"   FINSI"
"SACQCP";"S";"0443";"*"
"SACQCP";"S";"0444";"* Acquis légal"
"SACQCP";"S";"0445";"   SI HJOU_JOUR <= LOCA_JSEM"
"SACQCP";"S";"0446";"      HJOU_SJRDACQCP = HJOU_SJRDACQCP + LOCA_ACQJOUR"
"SACQCP";"S";"0447";"   FINSI"
"SACQCP";"S";"0448";"*"
"SACQCP";"S";"0449";"* Contrôle seuil CP annuel légal :"
"SACQCP";"S";"0450";"   SI HJOU_SJRDACQCP > LOCA_ACQAN"
"SACQCP";"S";"0451";"      HJOU_SJRDACQCP = LOCA_ACQAN"
"SACQCP";"S";"0452";"   FINSI"
"SACQCP";"S";"0453";"* Contrôle seuil CP acquis mensuel :"
"SACQCP";"S";"0454";"   SI HJOU_SJRACQCPM > LOCA_ACQMOIS"
"SACQCP";"S";"0455";"      HJOU_SJRACQCPM = LOCA_ACQMOIS"
"SACQCP";"S";"0456";"   FINSI"
"SACQCP";"S";"0457";"   SI HJOU_SJRACQCPMP > LOCA_25M"
"SACQCP";"S";"0458";"      HJOU_SJRACQCPMP = LOCA_25M"
"SACQCP";"S";"0459";"   FINSI"
"SACQCP";"S";"0460";"*"
"SACQCP";"S";"0461";"***** Calcul de l'acquis le dernier jour du mois ou sortie ou STC >>"
"SACQCP";"S";"0462";"*"
"SACQCP";"S";"0463";"   SI TEMP_DATSUI(7:2) = ""01"""
"SACQCP";"S";"0464";"*   OU HJOU_SJQINSTC = ""1"""
"SACQCP";"S";"0465";"   OU CTRA_SCIDATSTC = HJOU_DATE"
"SACQCP";"S";"0466";"*   OU HJOU_SJQFINC = 1"
"SACQCP";"S";"0467";"      HJOU_IJRDACQCP = HJOU_IJRDACQCP + HJOU_SJRACQCPM"
"SACQCP";"S";"0468";"      HJOU_SJRI045 = HJOU_SJRI045 + HJOU_SJRACQCPMP"
"SACQCP";"S";"0469";"      HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"SACQCP";"S";"0470";"   FINSI"
"SACQCP";"S";"0471";"*"
"SACQCP";"S";"0472";"****** DEBUT : Gestion de l'acquisition en début de période >> *******"
"SACQCP";"S";"0473";"*"
"SACQCP";"S";"0474";"* Traitement au mois de reference"
"SACQCP";"S";"0475";"   SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SACQCP";"S";"0476";"*"
"SACQCP";"S";"0477";"***** DEB : Gestion des congés reportés >> *****"
"SACQCP";"S";"0478";"*"
"SACQCP";"S";"0479";"      SI HJOU_DATE > CONF_SDIDATDEM"
"SACQCP";"S";"0480";"*"
"SACQCP";"S";"0481";"* Glissement des périodes >>"
"SACQCP";"S";"0482";"         FAIRE GLISSER"
"SACQCP";"S";"0483";"*"
"SACQCP";"S";"0484";"         SI LOCA_ABATCP = ""2"""
"SACQCP";"S";"0485";"         OU LOCA_ABATCP = ""3"""
"SACQCP";"S";"0486";"*"
"SACQCP";"S";"0487";"* Si arrêt à cheval sur 2 période < 1 an"
"SACQCP";"S";"0488";"            SI HJOU_SJRNABCONS > 1"
"SACQCP";"S";"0489";"               SI HJOU_SJRNABCONS <= 365"
"SACQCP";"S";"0490";"                  HJOU_SJRDPREP1 = HJOU_IJRSCOPRIN"
"SACQCP";"S";"0491";"                  HJOU_SJRSPREP1 = HJOU_SJRDPREP1 - HJOU_SJRCPREP1"
"SACQCP";"S";"0492";"* Passe le témoin à 1 lors de l'alimentation de la période 1"
"SACQCP";"S";"0493";"                  HJOU_SJQTEMADP = ""1"""
"SACQCP";"S";"0494";"               FINSI"
"SACQCP";"S";"0495";"            FINSI"
"SACQCP";"S";"0496";"*"
"SACQCP";"S";"0497";"* Si arrêt à cheval sur 2 période > 1 an"
"SACQCP";"S";"0498";"            SI HJOU_SJRNABCONS > 365"
"SACQCP";"S";"0499";"               HJOU_SJRDPREP1 = HJOU_IJRSCOPRIN"
"SACQCP";"S";"0500";"               HJOU_SJRSPREP1 = HJOU_SJRDPREP1 - HJOU_SJRCPREP1"
"SACQCP";"S";"0501";"               DATAJT HJOU_DATE 12 ""M"" PARD_SDIMOICPR"
"SACQCP";"S";"0502";"               HJOU_SJRDAFREP1 = TEMP_DXFINPER"
"SACQCP";"S";"0503";"            FINSI"
"SACQCP";"S";"0504";"*"
"SACQCP";"S";"0505";"         FINSI"
"SACQCP";"S";"0506";"      FINSI"
"SACQCP";"S";"0507";"*"
"SACQCP";"S";"0508";"   FINSI"
"SACQCP";"S";"0509";"*"
"SACQCP";"S";"0510";"***** FIN : Gestion des congés reportés << *****"
"SACQCP";"S";"0511";"*"
"SACQCP";"S";"0512";"*   SI HJOU_SJQINSTC = ""1"""
"SACQCP";"S";"0513";"   SI CTRA_SCIDATSTC = HJOU_DATE"
"SACQCP";"S";"0514";"*   SI HJOU_SJQFINC = 1"
"SACQCP";"S";"0515";"   OU TEMP_DATSUI(5:4) = LOCA_DATE(5:4)"
"SACQCP";"S";"0516";"*"
"SACQCP";"S";"0517";"* Arrondi du droit CP en cours d'acquisition sur la période (CP1)"
"SACQCP";"S";"0518";"      SI HJOU_IJRDACQCP > 0"
"SACQCP";"S";"0519";"         LOCA_RESTE = HJOU_IJRDACQCP % 1"
"SACQCP";"S";"0520";"         LOCA_ENTIER = HJOU_IJRDACQCP - LOCA_RESTE"
"SACQCP";"S";"0521";"         SI LOCA_RESTE > 0"
"SACQCP";"S";"0522";"            LOCA_ENTIER = LOCA_ENTIER + 1"
"SACQCP";"S";"0523";"         FINSI"
"SACQCP";"S";"0524";"         HJOU_IJRDACQCP = LOCA_ENTIER"
"SACQCP";"S";"0525";"      FINSI"
"SACQCP";"S";"0526";"* Arrondi du droit CP en cours acquisition au 10° pour paie"
"SACQCP";"S";"0527";"      SI HJOU_SJRI045 > 0"
"SACQCP";"S";"0528";"         LOCA_RESTE = HJOU_SJRI045 % 1"
"SACQCP";"S";"0529";"         LOCA_ENTIER = HJOU_SJRI045 - LOCA_RESTE"
"SACQCP";"S";"0530";"         SI LOCA_RESTE > 0"
"SACQCP";"S";"0531";"            LOCA_ENTIER = LOCA_ENTIER + 1"
"SACQCP";"S";"0532";"         FINSI"
"SACQCP";"S";"0533";"         HJOU_SJRI045 = LOCA_ENTIER"
"SACQCP";"S";"0534";"      FINSI"
"SACQCP";"S";"0535";"* Arrondi du droit CP en cours d'acquisition sur la période (CP1) légal"
"SACQCP";"S";"0536";"      SI HJOU_SJRDACQCP > 0"
"SACQCP";"S";"0537";"         LOCA_RESTE = HJOU_SJRDACQCP % 1"
"SACQCP";"S";"0538";"         LOCA_ENTIER = HJOU_SJRDACQCP - LOCA_RESTE"
"SACQCP";"S";"0539";"         SI LOCA_RESTE > 0"
"SACQCP";"S";"0540";"            LOCA_ENTIER = LOCA_ENTIER + 1"
"SACQCP";"S";"0541";"         FINSI"
"SACQCP";"S";"0542";"         HJOU_SJRDACQCP = LOCA_ENTIER"
"SACQCP";"S";"0543";"      FINSI"
"SACQCP";"S";"0544";"*"
"SACQCP";"S";"0545";"      SI TEMP_DATSUI(5:4) = LOCA_DATE(5:4)"
"SACQCP";"S";"0546";"         SI HJOU_IJRDACQCP < HJOU_SJRDACQCP"
"SACQCP";"S";"0547";"            HJOU_IJRDACQCP = HJOU_SJRDACQCP"
"SACQCP";"S";"0548";"         FINSI"
"SACQCP";"S";"0549";"      FINSI"
"SACQCP";"S";"0550";"*"
"SACQCP";"S";"0551";"   FINSI"
"SACQCP";"S";"0552";"*"
"SACQCP";"S";"0553";"* Traitement au mois de reference"
"SACQCP";"S";"0554";"   SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SACQCP";"S";"0555";"*"
"SACQCP";"S";"0556";"      HJOU_IJRDCOPRIN = HJOU_IJRDACQCP"
"SACQCP";"S";"0557";"      HJOU_SJRJ045 = HJOU_SJRI045"
"SACQCP";"S";"0558";"      HJOU_IJRCCOPRIN = HJOU_IJRPACQCP"
"SACQCP";"S";"0559";"      HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"SACQCP";"S";"0560";"*"
"SACQCP";"S";"0561";"* Acquisition"
"SACQCP";"S";"0562";"      HJOU_IJRDACQCP = 0"
"SACQCP";"S";"0563";"      HJOU_SJRDACQCP = 0"
"SACQCP";"S";"0564";"      HJOU_SJRI045 = 0"
"SACQCP";"S";"0565";"      HJOU_IJRPACQCP = 0"
"SACQCP";"S";"0566";"      HJOU_IJRSACQCP = 0"
"SACQCP";"S";"0567";"*"
"SACQCP";"S";"0568";"* RAZ fractionnement"
"SACQCP";"S";"0569";"      HJOU_IJRDCOFRAC = 0"
"SACQCP";"S";"0570";"      HJOU_IJRCCOFRAC = 0"
"SACQCP";"S";"0571";"      HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"SACQCP";"S";"0572";"*"
"SACQCP";"S";"0573";"      HJOU_SJRNCPTP = 0"
"SACQCP";"S";"0574";"*"
"SACQCP";"S";"0575";"* Gestion du nombre de samedi pris >>"
"SACQCP";"S";"0576";"*"
"SACQCP";"S";"0577";"* Si nombre de samedi pris < nombre samedi à prendre"
"SACQCP";"S";"0578";"      SI HJOU_SJQOUVRABL = ""O"""
"SACQCP";"S";"0579";"         SI HJOU_IJRNBCPSAM < PARD_IDINBRSAMD"
"SACQCP";"S";"0580";"            ANOMALIE 178"
"SACQCP";"S";"0581";"         FINSI"
"SACQCP";"S";"0582";"      FINSI"
"SACQCP";"S";"0583";"*"
"SACQCP";"S";"0584";"* RAZ du nombre de samedi pris"
"SACQCP";"S";"0585";"      HJOU_IJRNBCPSAM = 0"
"SACQCP";"S";"0586";"*"
"SACQCP";"S";"0587";"* Contrôle si droit supérieur au droit annuel à date"
"SACQCP";"S";"0588";"      SI HJOU_IJRDCOPRIN > LOCA_ACQAN"
"SACQCP";"S";"0589";"         ANOMALIE 252"
"SACQCP";"S";"0590";"      FINSI"
"SACQCP";"S";"0591";"*"
"SACQCP";"S";"0592";"   FINSI"
"SACQCP";"S";"0593";"*"
"SACQCP";"S";"0594";"****** FIN : Gestion de l'acquisition en début de période << *******"
"SACQCP";"S";"0595";"*"
"SACQCP";"S";"0596";"****** Gestion du nombre de samedi à prendre >>"
"SACQCP";"S";"0597";"*"
"SACQCP";"S";"0598";"   SI PARD_IDINBRSAMD > 0"
"SACQCP";"S";"0599";"      SI HJOU_IJRSAMEAPR = 0"
"SACQCP";"S";"0600";"         HJOU_IJRSAMEAPR = PARD_IDINBRSAMD"
"SACQCP";"S";"0601";"      FINSI"
"SACQCP";"S";"0602";"   FINSI"
"SACQCP";"S";"0603";"*"
"SACQCP";"S";"0604";"****** Gestion des consignes >>"
"SACQCP";"S";"0605";"*"
"SACQCP";"S";"0606";"   POUR ACTIVITES"
"SACQCP";"S";"0607";"* Droit CP2 acquis J045 (10°)"
"SACQCP";"S";"0608";"      SI HABS_MOTIF = ""ZDJ045"""
"SACQCP";"S";"0609";"         HJOU_SJRJ045 = HABS_MOTINBR"
"SACQCP";"S";"0610";"      FINSI"
"SACQCP";"S";"0611";"*"
"SACQCP";"S";"0612";"* CP en cours acquis"
"SACQCP";"S";"0613";"      SI HABS_MOTIF = ""XDACP"""
"SACQCP";"S";"0614";"         LOCA_ACP = 1"
"SACQCP";"S";"0615";"         HJOU_IJRDACQCP = HJOU_IJRDACQCP + HABS_MOTINBR"
"SACQCP";"S";"0616";"         HJOU_SJRDACQCP = HJOU_SJRDACQCP + HABS_MOTINBR"
"SACQCP";"S";"0617";"         HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"SACQCP";"S";"0618";"      FINSI"
"SACQCP";"S";"0619";"      SI HABS_MOTIF = ""ZDACP"""
"SACQCP";"S";"0620";"         LOCA_ACP = 1"
"SACQCP";"S";"0621";"         HJOU_IJRDACQCP = HABS_MOTINBR"
"SACQCP";"S";"0622";"         HJOU_SJRDACQCP = HABS_MOTINBR"
"SACQCP";"S";"0623";"         HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"SACQCP";"S";"0624";"      FINSI"
"SACQCP";"S";"0625";"* CP Reliquat"
"SACQCP";"S";"0626";"      SI HORC_IHIGESRELI = ""1"""
"SACQCP";"S";"0627";"         SI HABS_MOTIF = ""XRCP"""
"SACQCP";"S";"0628";"            HJOU_IJRSCORELI = HJOU_IJRSCORELI + HABS_MOTINBR"
"SACQCP";"S";"0629";"         FINSI"
"SACQCP";"S";"0630";"         SI HABS_MOTIF = ""ZRCP"""
"SACQCP";"S";"0631";"            HJOU_IJRSCORELI = HABS_MOTINBR"
"SACQCP";"S";"0632";"         FINSI"
"SACQCP";"S";"0633";"      FINSI"
"SACQCP";"S";"0634";"*"
"SACQCP";"S";"0635";"* CP acquis"
"SACQCP";"S";"0636";"      SI HABS_MOTIF = ""XDCP"""
"SACQCP";"S";"0637";"         LOCA_CP = 1"
"SACQCP";"S";"0638";"*"
"SACQCP";"S";"0639";"         HJOU_IJRDCOPRIN = HJOU_IJRDCOPRIN + HABS_MOTINBR"
"SACQCP";"S";"0640";"         HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"SACQCP";"S";"0641";"      FINSI"
"SACQCP";"S";"0642";"      SI HABS_MOTIF = ""ZDCP"""
"SACQCP";"S";"0643";"         LOCA_CP = 1"
"SACQCP";"S";"0644";"*"
"SACQCP";"S";"0645";"         HJOU_IJRDCOPRIN = HABS_MOTINBR"
"SACQCP";"S";"0646";"         HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"SACQCP";"S";"0647";"      FINSI"
"SACQCP";"S";"0648";"*"
"SACQCP";"S";"0649";"* Acquisition et MAJ des droits fractionnement manuel >>"
"SACQCP";"S";"0650";"      SI HABS_MOTIF = ""XDCF"""
"SACQCP";"S";"0651";"         HJOU_IJRDCOFRAC = HJOU_IJRDCOFRAC + HABS_MOTINBR"
"SACQCP";"S";"0652";"         HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"SACQCP";"S";"0653";"      FINSI"
"SACQCP";"S";"0654";"      SI HABS_MOTIF = ""ZDCF"""
"SACQCP";"S";"0655";"         HJOU_IJRDCOFRAC = HABS_MOTINBR"
"SACQCP";"S";"0656";"         HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"SACQCP";"S";"0657";"      FINSI"
"SACQCP";"S";"0658";"      SI HABS_MOTIF = ""XCCF"""
"SACQCP";"S";"0659";"         HJOU_IJRCCOFRAC = HJOU_IJRCCOFRAC + HABS_MOTINBR"
"SACQCP";"S";"0660";"         HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"SACQCP";"S";"0661";"      FINSI"
"SACQCP";"S";"0662";"      SI HABS_MOTIF = ""ZCCF"""
"SACQCP";"S";"0663";"         HJOU_IJRCCOFRAC = HABS_MOTINBR"
"SACQCP";"S";"0664";"         HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"SACQCP";"S";"0665";"      FINSI"
"SACQCP";"S";"0666";"*"
"SACQCP";"S";"0667";"* Acquis et date de report >>"
"SACQCP";"S";"0668";"      SI HABS_MOTIF = ""ZDCPR1"""
"SACQCP";"S";"0669";"         HJOU_SJRDPREP1 = HABS_MOTINBR"
"SACQCP";"S";"0670";"         SI HJOU_SJRDPREP1 = 0"
"SACQCP";"S";"0671";"            HJOU_SJRDAFREP1 = "" """
"SACQCP";"S";"0672";"         FINSI"
"SACQCP";"S";"0673";"      FINSI"
"SACQCP";"S";"0674";"      SI HABS_MOTIF = ""ZDCPR2"""
"SACQCP";"S";"0675";"         HJOU_SJRDPREP2 = HABS_MOTINBR"
"SACQCP";"S";"0676";"         SI HJOU_SJRDPREP2 = 0"
"SACQCP";"S";"0677";"            HJOU_SJRDAFREP2 = "" """
"SACQCP";"S";"0678";"         FINSI"
"SACQCP";"S";"0679";"      FINSI"
"SACQCP";"S";"0680";"      SI HABS_MOTIF = ""ZDCPR3"""
"SACQCP";"S";"0681";"         HJOU_SJRDPREP3 = HABS_MOTINBR"
"SACQCP";"S";"0682";"         SI HJOU_SJRDPREP3 = 0"
"SACQCP";"S";"0683";"            HJOU_SJRDAFREP3 = "" """
"SACQCP";"S";"0684";"         FINSI"
"SACQCP";"S";"0685";"      FINSI"
"SACQCP";"S";"0686";"      SI HABS_MOTIF = ""ZDCPR4"""
"SACQCP";"S";"0687";"         HJOU_SJRDPREP4 = HABS_MOTINBR"
"SACQCP";"S";"0688";"         SI HJOU_SJRDPREP4 = 0"
"SACQCP";"S";"0689";"            HJOU_SJRDAFREP4 = "" """
"SACQCP";"S";"0690";"         FINSI"
"SACQCP";"S";"0691";"      FINSI"
"SACQCP";"S";"0692";"*"
"SACQCP";"S";"0693";"* Date de report >>"
"SACQCP";"S";"0694";"      SI HABS_MOTIF = ""ZDATCPR1"""
"SACQCP";"S";"0695";"         LOCA_MOIS = HABS_MOTINBR"
"SACQCP";"S";"0696";"         DATAJT HJOU_DATE 12 ""M"" LOCA_MOIS"
"SACQCP";"S";"0697";"         HJOU_SJRDAFREP1 = TEMP_DXFINPER"
"SACQCP";"S";"0698";"      FINSI"
"SACQCP";"S";"0699";"      SI HABS_MOTIF = ""ZDATCPR2"""
"SACQCP";"S";"0700";"         LOCA_MOIS = HABS_MOTINBR"
"SACQCP";"S";"0701";"         DATAJT HJOU_DATE 12 ""M"" LOCA_MOIS"
"SACQCP";"S";"0702";"         HJOU_SJRDAFREP2 = TEMP_DXFINPER"
"SACQCP";"S";"0703";"      FINSI"
"SACQCP";"S";"0704";"      SI HABS_MOTIF = ""ZDATCPR3"""
"SACQCP";"S";"0705";"         LOCA_MOIS = HABS_MOTINBR"
"SACQCP";"S";"0706";"         DATAJT HJOU_DATE 12 ""M"" LOCA_MOIS"
"SACQCP";"S";"0707";"         HJOU_SJRDAFREP3 = TEMP_DXFINPER"
"SACQCP";"S";"0708";"      FINSI"
"SACQCP";"S";"0709";"      SI HABS_MOTIF = ""ZDATCPR4"""
"SACQCP";"S";"0710";"         LOCA_MOIS = HABS_MOTINBR"
"SACQCP";"S";"0711";"         DATAJT HJOU_DATE 12 ""M"" LOCA_MOIS"
"SACQCP";"S";"0712";"         HJOU_SJRDAFREP4 = TEMP_DXFINPER"
"SACQCP";"S";"0713";"      FINSI"
"SACQCP";"S";"0714";"*"
"SACQCP";"S";"0715";"   FINPOUR"
"SACQCP";"S";"0716";"*"
"SACQCP";"S";"0717";"* Calcul des soldes >>"
"SACQCP";"S";"0718";"   HJOU_SJRSPREP4 = HJOU_SJRDPREP4 - HJOU_SJRCPREP4"
"SACQCP";"S";"0719";"   HJOU_SJRSPREP3 = HJOU_SJRDPREP3 - HJOU_SJRCPREP3"
"SACQCP";"S";"0720";"   HJOU_SJRSPREP2 = HJOU_SJRDPREP2 - HJOU_SJRCPREP2"
"SACQCP";"S";"0721";"   HJOU_SJRSPREP1 = HJOU_SJRDPREP1 - HJOU_SJRCPREP1"
"SACQCP";"S";"0722";"   HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"SACQCP";"S";"0723";"   HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"SACQCP";"S";"0724";"*"
"SACQCP";"S";"0725";"* Fractionnement >>"
"SACQCP";"S";"0726";"   HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"SACQCP";"S";"0727";"*"
"SACQCP";"S";"0728";"* Gestion ano solde insuffisant"
"SACQCP";"S";"0729";"   SI LOCA_ACP = 1"
"SACQCP";"S";"0730";"      SI HJOU_IJRSACQCP < 0"
"SACQCP";"S";"0731";"         ANOMALIE 197"
"SACQCP";"S";"0732";"      FINSI"
"SACQCP";"S";"0733";"   FINSI"
"SACQCP";"S";"0734";"*"
"SACQCP";"S";"0735";"   SI LOCA_CP = 1"
"SACQCP";"S";"0736";"*"
"SACQCP";"S";"0737";"      SI HJOU_IJRSCOPRIN < 0"
"SACQCP";"S";"0738";"         ANOMALIE 198"
"SACQCP";"S";"0739";"      FINSI"
"SACQCP";"S";"0740";"*"
"SACQCP";"S";"0741";"   FINSI"
"SACQCP";"S";"0742";"FINSI"
"SACQCP";"S";"0743";"*"
"SACQCP";"S";"0744";"FIN"
"SACQCP";"S";"0745";"***** PROCEDURE *****"
"SACQCP";"S";"0746";"*"
"SACQCP";"S";"0747";"***** Glissement des compteurs de report >> ******"
"SACQCP";"S";"0748";"*"
"SACQCP";"S";"0749";"PROC GLISSER"
"SACQCP";"S";"0750";"*"
"SACQCP";"S";"0751";"* Période 3 dans 4"
"SACQCP";"S";"0752";"   HJOU_SJRDPREP4 = HJOU_SJRDPREP3"
"SACQCP";"S";"0753";"   HJOU_SJRCPREP4 = HJOU_SJRCPREP3"
"SACQCP";"S";"0754";"   HJOU_SJRDAFREP4 = HJOU_SJRDAFREP3"
"SACQCP";"S";"0755";"   HJOU_SJRSPREP4 = HJOU_SJRDPREP4 - HJOU_SJRCPREP4"
"SACQCP";"S";"0756";"* Période 2 dans 3"
"SACQCP";"S";"0757";"   HJOU_SJRDPREP3 = HJOU_SJRDPREP2"
"SACQCP";"S";"0758";"   HJOU_SJRCPREP3 = HJOU_SJRCPREP2"
"SACQCP";"S";"0759";"   HJOU_SJRDAFREP3 = HJOU_SJRDAFREP2"
"SACQCP";"S";"0760";"   HJOU_SJRSPREP3 = HJOU_SJRDPREP3 - HJOU_SJRCPREP3"
"SACQCP";"S";"0761";"* Période 1 dans 2"
"SACQCP";"S";"0762";"   HJOU_SJRDPREP2 = HJOU_SJRDPREP1"
"SACQCP";"S";"0763";"   HJOU_SJRCPREP2 = HJOU_SJRCPREP1"
"SACQCP";"S";"0764";"   HJOU_SJRDAFREP2 = HJOU_SJRDAFREP1"
"SACQCP";"S";"0765";"   HJOU_SJRSPREP2 = HJOU_SJRDPREP2 - HJOU_SJRCPREP2"
"SACQCP";"S";"0766";"* Init Période 1"
"SACQCP";"S";"0767";"   HJOU_SJRDPREP1 = 0"
"SACQCP";"S";"0768";"   HJOU_SJRCPREP1 = 0"
"SACQCP";"S";"0769";"   HJOU_SJRDAFREP1 = "" """
"SACQCP";"S";"0770";"   HJOU_SJRSPREP1 = HJOU_SJRDPREP1 - HJOU_SJRCPREP1"
"SACQCP";"S";"0771";"*"
"SACQCP";"S";"0772";"* Vérif si RAZ >>"
"SACQCP";"S";"0773";"*"
"SACQCP";"S";"0774";"* Période 4 >>"
"SACQCP";"S";"0775";"   SI HJOU_SJRDPREP4 = 0"
"SACQCP";"S";"0776";"      SI HJOU_SJRDAFREP4 = "" """
"SACQCP";"S";"0777";"         HJOU_SJRDPREP4 = 0"
"SACQCP";"S";"0778";"         HJOU_SJRCPREP4 = 0"
"SACQCP";"S";"0779";"         HJOU_SJRSPREP4 = HJOU_SJRDPREP4 - HJOU_SJRCPREP4"
"SACQCP";"S";"0780";"      FINSI"
"SACQCP";"S";"0781";"   FINSI"
"SACQCP";"S";"0782";"*"
