"SGCALJF";"S";"0179";"FINSI"
"SGCALJF";"S";"0180";"*"
"SGCALJF";"S";"0181";"* Garde fou : On exclu de la JS les sociétés suivantes qui offre la JS"
"SGCALJF";"S";"0182";"SI HJOU_SJQSOCIETE = ""MO"""
"SGCALJF";"S";"0183";"OU HJOU_SJQSOCIETE = ""PU"""
"SGCALJF";"S";"0184";"OU HJOU_SJQSOCIETE = ""PC"""
"SGCALJF";"S";"0185";"   LOCA_JS = 0"
"SGCALJF";"S";"0186";"FINSI"
"SGCALJF";"S";"0187";"* + Exclu la JS pour Journaliste de la société RC"
"SGCALJF";"S";"0188";"SI HJOU_SJQSOCIETE = ""RC"""
"SGCALJF";"S";"0189";"   SI HJOU_SJQCATEGOR = ""J"""
"SGCALJF";"S";"0190";"      LOCA_JS = 0"
