"SGASTR";"S";"0419";"      FINSI"
"SGASTR";"S";"0420";"*"
"SGASTR";"S";"0421";"   FINSI"
"SGASTR";"S";"0422";"*"
"SGASTR";"S";"0423";"* Paiement des heures d'intervention"
"SGASTR";"S";"0424";"   HJOU_SJQAST5240 = LOCA_DURINTER"
"SGASTR";"S";"0425";"*"
"SGASTR";"S";"0426";"* Spécificité pour la société BE"
"SGASTR";"S";"0427";"   SI HJOU_SJQSOCIETE = ""BE"""
"SGASTR";"S";"0428";"      HJOU_SJQAST5240 = 0"
