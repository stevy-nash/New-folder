"SGCSEGLISS";"S";"0563";"* Gestion des anomalies"
"SGCSEGLISS";"S";"0564";"* ----------------------------------------"
"SGCSEGLISS";"S";"0565";"*"
"SGCSEGLISS";"S";"0566";"      DEF CPTG_SOLDECSEM T6.2"
"SGCSEGLISS";"S";"0567";"      PERGLISS CPTG_SOLDECSEM ""031J01"""
"SGCSEGLISS";"S";"0568";"*"
"SGCSEGLISS";"S";"0569";"      SI LOCA_CONSO = 1"
"SGCSEGLISS";"S";"0570";"      OU LOCA_YCSE = 1"
"SGCSEGLISS";"S";"0571";"* Solde négatif"
"SGCSEGLISS";"S";"0572";"         SI HJOU_IJRMSCSE < 0"
"SGCSEGLISS";"S";"0573";"            ANOMALIE 215"
"SGCSEGLISS";"S";"0574";"            SI TEMP_CNMOTIF = PARD_SDIVMCSE"
"SGCSEGLISS";"S";"0575";"            OU TEMP_CNMOTIF(1:4) = ""YCSE"""
"SGCSEGLISS";"S";"0576";"               TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0577";"               TEMP_CNMESS = 215"
"SGCSEGLISS";"S";"0578";"            FINSI"
"SGCSEGLISS";"S";"0579";"         FINSI"
"SGCSEGLISS";"S";"0580";"      FINSI"
"SGCSEGLISS";"S";"0581";"*"
"SGCSEGLISS";"S";"0582";"* depassement du CSE annuel"
"SGCSEGLISS";"S";"0583";"      LOCA_DTMAX = HJOU_IJIDACSEM * LOCA_TAUX"
"SGCSEGLISS";"S";"0584";"      SI HJOU_DATE(7:2) = ""01"""
"SGCSEGLISS";"S";"0585";"         SI HJOU_IJRADCSE > LOCA_DTMAX"
"SGCSEGLISS";"S";"0586";"            ANOMALIE 218"
"SGCSEGLISS";"S";"0587";"         FINSI"
"SGCSEGLISS";"S";"0588";"      FINSI"
"SGCSEGLISS";"S";"0589";"      LOCA_DTMAX = LOCA_DTMAX / 12"
"SGCSEGLISS";"S";"0590";"* --------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0591";"* LOCA_MENS : on affiche l'anomalie que s'il y a une consigne sur la journée"
"SGCSEGLISS";"S";"0592";"* --------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0593";"      SI LOCA_MENS = 1"
"SGCSEGLISS";"S";"0594";"         LOCA_DRPR = HJOU_IJRMDCSE - HJOU_IJRMPCSE"
"SGCSEGLISS";"S";"0595";"         SI HJOU_IJRMDCSE > LOCA_DTMAX"
"SGCSEGLISS";"S";"0596";"         OU LOCA_DRPR > LOCA_DTMAX"
"SGCSEGLISS";"S";"0597";"            SI LOCA_SUPPLEANT <> 1"
"SGCSEGLISS";"S";"0598";"               ANOMALIE 216"
"SGCSEGLISS";"S";"0599";"            FINSI"
"SGCSEGLISS";"S";"0600";"         FINSI"
"SGCSEGLISS";"S";"0601";"      SINON"
"SGCSEGLISS";"S";"0602";"         SI LOCA_CONSO = 1"
"SGCSEGLISS";"S";"0603";"         OU LOCA_YCSE = 1"
"SGCSEGLISS";"S";"0604";"*Anomalie en cas de dépassement du droit mensuel"
"SGCSEGLISS";"S";"0605";"            SI HJOU_IJRCUPMCSE > LOCA_MAXM"
"SGCSEGLISS";"S";"0606";"               ANOMALIE 216"
"SGCSEGLISS";"S";"0607";"               SI TEMP_CNMOTIF(1:4) = ""YCSE"""
"SGCSEGLISS";"S";"0608";"                  TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0609";"                  TEMP_CNMESS = 216"
"SGCSEGLISS";"S";"0610";"               FINSI"
"SGCSEGLISS";"S";"0611";"            FINSI"
"SGCSEGLISS";"S";"0612";"         FINSI"
