"SHSUPPDIM2";"S";"0837";"***** DEB - Calcul des HS Jour par jour, le dimanche ou fin de cycle >> ****************************"
"SHSUPPDIM2";"S";"0838";"*"
"SHSUPPDIM2";"S";"0839";"SI LOCA_DROIT = 1"
"SHSUPPDIM2";"S";"0840";"*"
"SHSUPPDIM2";"S";"0841";"****** Appréciation au jour le jour >> *************************************************************"
"SHSUPPDIM2";"S";"0842";"*"
"SHSUPPDIM2";"S";"0843";"   SI LOCA_GESTHS = ""4"""
"SHSUPPDIM2";"S";"0844";"*"
"SHSUPPDIM2";"S";"0845";"      SI LOCA_SDIGESTHS <> ""1"""
"SHSUPPDIM2";"S";"0846";"         SI HJOU_IJQTTEFFEJ > HJOU_IJQPRETHEJ"
"SHSUPPDIM2";"S";"0847";"            LOCA_HSUP = HJOU_IJQTTEFFEJ - HJOU_IJQPRETHEJ"
"SHSUPPDIM2";"S";"0848";"* On enlève les inter astreintes"
"SHSUPPDIM2";"S";"0849";"            LOCA_HSUP = LOCA_HSUP - LOCA_INTAST"
"SHSUPPDIM2";"S";"0850";"            SI LOCA_HSUP < 0"
