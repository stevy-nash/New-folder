"SREPDEC";"S";"0356";"   FINSI"
"SREPDEC";"S";"0357";"FINPOUR"
"SREPDEC";"S";"0358";"*"
"SREPDEC";"S";"0359";"SI LOCA_PRISW > 1"
"SREPDEC";"S";"0360";"   LOCA_PRISW = 1"
"SREPDEC";"S";"0361";"FINSI"
"SREPDEC";"S";"0362";"SI LOCA_PRISRECW > 1"
"SREPDEC";"S";"0363";"   LOCA_PRISRECW = 1"
"SREPDEC";"S";"0364";"FINSI"
"SREPDEC";"S";"0365";"*"
"SREPDEC";"S";"0366";"SI LOCA_PRISW > 0"
"SREPDEC";"S";"0367";"   HJOU_SJRCRDECW = HJOU_SJRCRDECW + LOCA_PRISW"
"SREPDEC";"S";"0368";"FINSI"
"SREPDEC";"S";"0369";"SI LOCA_PRISRECW > 0"
"SREPDEC";"S";"0370";"   HJOU_IJRDJDISP2 = HJOU_IJRDJDISP2 + LOCA_PRISRECW"
"SREPDEC";"S";"0371";"FINSI"
"SREPDEC";"S";"0372";"*"
"SREPDEC";"S";"0373";"***** Gestion des anomalies >>"
"SREPDEC";"S";"0374";"*"
"SREPDEC";"S";"0375";"* Alerte si compteur de report non consommé >>"
"SREPDEC";"S";"0376";"SI HJOU_DATE < TEMP_DATJOU"
"SREPDEC";"S";"0377";"   SI TEMP_DATSUI(7:2) = ""01"""
"SREPDEC";"S";"0378";"      SI HJOU_SJRSRDECR > 0"
"SREPDEC";"S";"0379";"         ANOMALIE 302"
"SREPDEC";"S";"0380";"      FINSI"
"SREPDEC";"S";"0381";"   FINSI"
"SREPDEC";"S";"0382";"FINSI"
"SREPDEC";"S";"0383";"*"
"SREPDEC";"S";"0384";"* Solde global >>"
"SREPDEC";"S";"0385";"HJOU_SJRSRDECG = HJOU_SJRSRDEC + HJOU_SJRSRDECR"
"SREPDEC";"S";"0386";"*"
"SREPDEC";"S";"0387";"SI LOCA_MOT = 1"
"SREPDEC";"S";"0388";"* Si droit ?"
"SREPDEC";"S";"0389";"   SI LOCA_DROIT <> 1"
"SREPDEC";"S";"0390";"      ANOMALIE 241"
"SREPDEC";"S";"0391";"      SI TEMP_CNMOTIF = PARD_SDIVMRDEC"
"SREPDEC";"S";"0392";"         TEMP_CNRETOUR = 2"
"SREPDEC";"S";"0393";"         TEMP_CNMESS = 241"
"SREPDEC";"S";"0394";"      FINSI"
"SREPDEC";"S";"0395";"   FINSI"
"SREPDEC";"S";"0396";"* Si solde négatif ?"
"SREPDEC";"S";"0397";"   SI HJOU_SJRSRDECG < LOCA_SEUILNEG"
"SREPDEC";"S";"0398";"      ANOMALIE 242"
"SREPDEC";"S";"0399";"      SI TEMP_CNMOTIF = PARD_SDIVMRDEC"
"SREPDEC";"S";"0400";"         TEMP_CNRETOUR = 2"
"SREPDEC";"S";"0401";"         TEMP_CNMESS = 242"
"SREPDEC";"S";"0402";"      FINSI"
"SREPDEC";"S";"0403";"   FINSI"
"SREPDEC";"S";"0404";"*"
"SREPDEC";"S";"0405";"FINSI"
"SREPDEC";"S";"0406";"*"
"SREPDEC";"S";"0407";"* JJA - 09/10/2025 - EVO : FFT025005874 : Gestion anomalie >>"
"SREPDEC";"S";"0408";"SI LOCA_RECWE = 1"
"SREPDEC";"S";"0409";"* Si droit ?"
"SREPDEC";"S";"0410";"   SI HJOU_SECTORI(1:3) <> ""DSI"""
"SREPDEC";"S";"0411";"      ANOMALIE 323"
"SREPDEC";"S";"0412";"      SI TEMP_CNMOTIF = ""RECWE"""
"SREPDEC";"S";"0413";"         TEMP_CNRETOUR = 2"
"SREPDEC";"S";"0414";"         TEMP_CNMESS = 323"
"SREPDEC";"S";"0415";"      FINSI"
"SREPDEC";"S";"0416";"   FINSI"
"SREPDEC";"S";"0417";"* Si solde négatif ?"
"SREPDEC";"S";"0418";"   SI HJOU_SJRRECDSIJ < 0"
"SREPDEC";"S";"0419";"      ANOMALIE 324"
"SREPDEC";"S";"0420";"      SI TEMP_CNMOTIF = ""RECWE"""
"SREPDEC";"S";"0421";"         TEMP_CNRETOUR = 2"
"SREPDEC";"S";"0422";"         TEMP_CNMESS = 324"
"SREPDEC";"S";"0423";"      FINSI"
"SREPDEC";"S";"0424";"   FINSI"
"SREPDEC";"S";"0425";"FINSI"
"SREPDEC";"S";"0426";"* JJA - 09/10/2025 - EVO : FFT025005874 <<"
"SREPDEC";"S";"0427";"*"
"SREPDEC";"S";"0428";"* Solde global >>"
"SREPDEC";"S";"0429";"HJOU_SJRSRDECG = HJOU_SJRSRDEC + HJOU_SJRSRDECR"
"SREPDEC";"S";"0430";"SI HJOU_DATE = TEMP_DATJOU"
"SREPDEC";"S";"0431";"*"
"SREPDEC";"S";"0432";"* Anomalie de contrôle + 5"
"SREPDEC";"S";"0433";"   SI HJOU_SJRSRDECG > 5.00"
"SREPDEC";"S";"0434";"      ANOMALIE 330"
"SREPDEC";"S";"0435";"   FINSI"
"SREPDEC";"S";"0436";"* Anomalie de contrôle - 5"
"SREPDEC";"S";"0437";"   SI HJOU_SJRSRDECG < -5.00"
"SREPDEC";"S";"0438";"      ANOMALIE 331"
"SREPDEC";"S";"0439";"   FINSI"
"SREPDEC";"S";"0440";"*"
"SREPDEC";"S";"0441";"FINSI"
"SREPDEC";"S";"0442";"*"
"SREPDEC";"S";"0443";"* Solde prévisionnel >>"
"SREPDEC";"S";"0444";"* Alimentation du solde prévisionnel"
"SREPDEC";"S";"0445";"SI CTRA_DATFIN > TEMP_DATJOU"
"SREPDEC";"S";"0446";"   SI HJOU_SJQFINC = 1"
"SREPDEC";"S";"0447";"      EMPL_SEQSPRDEC = HJOU_SJRSRDEC + HJOU_SJRSRDECR"
"SREPDEC";"S";"0448";"      EMPL_SEQSPRDEC = EMPL_SEQSPRDEC - HJOU_SJRCRDECW"
"SREPDEC";"S";"0449";"      EMPL_IEQSPDISP4 = HJOU_SJRRECDSIJ - HJOU_IJRDJDISP2"
"SREPDEC";"S";"0450";"   FINSI"
"SREPDEC";"S";"0451";"FINSI"
"SREPDEC";"S";"0452";"SI TEMP_DATSUI = EMPL_DATTRAI"
"SREPDEC";"S";"0453";"   EMPL_SEQSPRDEC = HJOU_SJRSRDEC + HJOU_SJRSRDECR"
"SREPDEC";"S";"0454";"   EMPL_SEQSPRDEC = EMPL_SEQSPRDEC - HJOU_SJRCRDECW"
"SREPDEC";"S";"0455";"   EMPL_IEQSPDISP4 = HJOU_SJRRECDSIJ - HJOU_IJRDJDISP2"
"SREPDEC";"S";"0456";"FINSI"
"SREPDEC";"S";"0457";"*"
"SREPDEC";"S";"0458";"*"
"SREPDEC";"S";"0459";"FIN"
"SREPDEC";"S";"0460";"*"
