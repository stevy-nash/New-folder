"SGASTR";"S";"0371";"            ANOMALIE 256"
"SGASTR";"S";"0372";"         FINSI"
"SGASTR";"S";"0373";"      FINSI"
"SGASTR";"S";"0374";"   FINSI"
"SGASTR";"S";"0375";"*"
"SGASTR";"S";"0376";"* Gestion anomalies"
"SGASTR";"S";"0377";"*"
"SGASTR";"S";"0378";"* Rupture de la période au cours de la semaine"
"SGASTR";"S";"0379";"   SI HJOU_SJRJASTC = 0"
"SGASTR";"S";"0380";"      LIREVALPRE LOCA_SJRJASTC HJOU_SJRJASTC"
"SGASTR";"S";"0381";"      SI LOCA_SJRJASTC > 0"
"SGASTR";"S";"0382";"         SI HJOU_JOUR <> ""3"""
"SGASTR";"S";"0383";"            ANOMALIE 256"
"SGASTR";"S";"0384";"         SINON"
"SGASTR";"S";"0385";"            SI LOCA_SJRJASTC <> 7"
"SGASTR";"S";"0386";"*               ANOMALIE 256"
