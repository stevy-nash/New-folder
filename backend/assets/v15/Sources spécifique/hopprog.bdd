"SHSUPPDIM2";"S";"1259";"                     HJOU_IJQHRNMAPA = HJOU_IJQHRNMAPA + LOCA_HSUP"
"SHSUPPDIM2";"S";"1260";"                     LOCA_HSUP = 0"
