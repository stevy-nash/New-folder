"SGPFI";"S";"0028";"***********************************************************************"
"SGPFI";"S";"0029";"*"
"SGPFI";"S";"0030";"* Implémentation des données industrielles"
"SGPFI";"S";"0031";"*"
"SGPFI";"S";"0032";"DEBDICO"
"SGPFI";"S";"0033";"   HJOU_SJRDPFI;N;N6,2;I;;;     6789;;SJRDPFI;V3;""Droit Journée PFI"";"
"SGPFI";"S";"0034";"   HJOU_SJRCPFI;N;N6,2;I;;;     6789;;SJRCPFI;V3;""Pris Journée PFI"";"
"SGPFI";"S";"0035";"   HJOU_SJRSPFI;N;N6,2;I;;;     6789;;SJRSPFI;V3;""Solde Journée PFI"";"
"SGPFI";"S";"0036";"   HJOU_SJRCPFIW;N;N6,2;I;;;     6789;;SJRCPFIW;V3;""Pris PFI en attente"";"
"SGPFI";"S";"0037";"   EMPL_SEQSPPFI;N;N6,1;I;;;    56789;;;V3;""Solde prév. Journée PFI"";"
"SGPFI";"S";"0038";"   PARD_SDIVMPFI;O;A10;X;;;123456789;II;;C2;""Motif PFI"";"
"SGPFI";"S";"0039";"   *"
"SGPFI";"S";"0040";"   HJOU_SJRACQPFIM;N;N8,5;L;;;6789;;SJRACQPFIM;V3;""Acquisitoin PFI mois (cumul)"";"
"SGPFI";"S";"0041";"   HJOU_SJRNABSPFI;N;N6,1;I;;;    56789;;SJRNABSPFI;V3;""Nbres absences abat PFI sur année"";"
"SGPFI";"S";"0042";"   HJOU_SJRABPFA;N;N6,2;I;;;     6789;;SJRABPFA;V3;""Abattement PFI annuel"";"
"SGPFI";"S";"0043";"   *"
"SGPFI";"S";"0044";"   PARD_SDIDPFIAMO;N;N4,1;I;000000000000;;    56789;;;C3;""MO : Droit PFI annuel"";"
"SGPFI";"S";"0045";"   PARD_SDIDPFIAYR;N;N4,1;I;000000000000;;    56789;;;C3;""YR : Droit PFI annuel"";"
"SGPFI";"S";"0046";"   PARD_SDIDPFIARC;N;N4,1;I;000000000000;;    56789;;;C3;""RC : Droit PFI annuel"";"
"SGPFI";"S";"0047";"   PARD_SDIDPFIAPC;N;N4,1;I;000000000000;;    56789;;;C3;""PC : Droit PFI annuel"";"
"SGPFI";"S";"0048";"   PARD_SDISAPFIMO;N;N4,1;I;000000000000;;    56789;;;C3;""MO : Seuil nb abs. abat. droit PFI"";"
"SGPFI";"S";"0049";"   PARD_SDISAPFIYR;N;N4,1;I;000000000000;;    56789;;;C3;""YR : Seuil nb abs. abat. droit PFI"";"
"SGPFI";"S";"0050";"   PARD_SDISAPFIRC;N;N4,1;I;000000000000;;    56789;;;C3;""RC : Seuil nb abs. abat. droit PFI"";"
"SGPFI";"S";"0051";"   PARD_SDISAPFIPC;N;N4,1;I;000000000000;;    56789;;;C3;""PC : Seuil nb abs. abat. droit PFI"";"
"SGPFI";"S";"0052";"   *"
"SGPFI";"S";"0053";"   EMPL_SEQCPFI;N;N6,1;I;;;    56789;;;V3;""Pris prév. PFI"";"
"SGPFI";"S";"0054";"FINDICO"
"SGPFI";"S";"0055";"*"
"SGPFI";"S";"0056";"DEBANO"
"SGPFI";"S";"0057";"   234;9;""Pas droit au motif PFI"";"
"SGPFI";"S";"0058";"   235;8;""Solde PFI insuffisant"";"
"SGPFI";"S";"0059";"FINANO"
"SGPFI";"S";"0060";"*"
"SGPFI";"S";"0061";"* Déclaration des donnees locales"
"SGPFI";"S";"0062";"*"
"SGPFI";"S";"0063";"DEF LOCA_DROIT N2"
"SGPFI";"S";"0064";"LOCA_DROIT = 0"
"SGPFI";"S";"0065";"DEF LOCA_MOT N2"
"SGPFI";"S";"0066";"LOCA_MOT = 0"
"SGPFI";"S";"0067";"DEF LOCA_PRIS N6.2"
"SGPFI";"S";"0068";"LOCA_PRIS = 0"
"SGPFI";"S";"0069";"DEF LOCA_PERCO N6.2"
"SGPFI";"S";"0070";"LOCA_PERCO = 0"
"SGPFI";"S";"0071";"DEF LOCA_PRISW N6.2"
"SGPFI";"S";"0072";"LOCA_PRISW = 0"
"SGPFI";"S";"0073";"DEF LOCA_PERCOW N6.2"
"SGPFI";"S";"0074";"LOCA_PERCOW = 0"
"SGPFI";"S";"0075";"DEF LOCA_FERI N2"
"SGPFI";"S";"0076";"LOCA_FERI = 0"
"SGPFI";"S";"0077";"DEF LOCA_DPFI N6.2"
"SGPFI";"S";"0078";"LOCA_DPFI = 0"
"SGPFI";"S";"0079";"DEF LOCA_STOPACQ N2"
"SGPFI";"S";"0080";"LOCA_STOPACQ = 0"
"SGPFI";"S";"0081";"DEF LOCA_ABIS N2"
"SGPFI";"S";"0082";"LOCA_ABIS = 0"
"SGPFI";"S";"0083";"DEF LOCA_ACQ N8.6"
"SGPFI";"S";"0084";"LOCA_ACQ = 0"
"SGPFI";"S";"0085";"DEF LOCA_SEUILABAT N6.2"
"SGPFI";"S";"0086";"LOCA_SEUILABAT = 0"
"SGPFI";"S";"0087";"DEF LOCA_ABATJ N6.2"
"SGPFI";"S";"0088";"LOCA_ABATJ = 0"
"SGPFI";"S";"0089";"DEF LOCA_SEUIL N4"
"SGPFI";"S";"0090";"LOCA_SEUIL = 0"
"SGPFI";"S";"0091";"*"
"SGPFI";"S";"0092";"DEF LOCA_VALAROND N6.2"
"SGPFI";"S";"0093";"LOCA_VALAROND = 0"
"SGPFI";"S";"0094";"DEF LOCA_RESTE N6.2"
"SGPFI";"S";"0095";"LOCA_RESTE = 0"
"SGPFI";"S";"0096";"DEF LOCA_ENTIER N6.2"
"SGPFI";"S";"0097";"LOCA_ENTIER = 0"
"SGPFI";"S";"0098";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGPFI";"S";"0099";"DEF LOCA_TYPARROND N2"
"SGPFI";"S";"0100";"LOCA_TYPARROND = 2"
"SGPFI";"S";"0101";"*"
"SGPFI";"S";"0102";"DEF LOCA_DATE D"
"SGPFI";"S";"0103";"LOCA_DATE(5:4) = ""0101"""
"SGPFI";"S";"0104";"DEF LOCA_DATEFU D"
"SGPFI";"S";"0105";"LOCA_DATEFU(5:4) = ""0101"""
"SGPFI";"S";"0106";"DEF LOCA_ANNEE N4"
"SGPFI";"S";"0107";"LOCA_ANNEE << TEMP_DATJOU(1:4)"
"SGPFI";"S";"0108";"LOCA_DATE(1:4) << LOCA_ANNEE"
"SGPFI";"S";"0109";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SGPFI";"S";"0110";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SGPFI";"S";"0111";"*"
"SGPFI";"S";"0112";"POUR ACTIVITES"
"SGPFI";"S";"0113";"   SI HABS_MOTIF = ""JF"""
"SGPFI";"S";"0114";"      LOCA_FERI = 1"
"SGPFI";"S";"0115";"   FINSI"
"SGPFI";"S";"0116";"FINPOUR"
"SGPFI";"S";"0117";"*"
"SGPFI";"S";"0118";"* Définition année bisextille"
"SGPFI";"S";"0119";"SI TEMP_DATSUI(5:4) = ""0301"""
"SGPFI";"S";"0120";"   SI HJOU_DATE(7:2) = ""29"""
"SGPFI";"S";"0121";"      LOCA_ABIS = 1"
"SGPFI";"S";"0122";"   FINSI"
"SGPFI";"S";"0123";"FINSI"
"SGPFI";"S";"0124";"*"
"SGPFI";"S";"0125";"* Init des droits annuels et des seuils d'abattement selon société >>"
"SGPFI";"S";"0126";"* Selon service spécifique PFI"
"SGPFI";"S";"0127";"SI HJOU_SECTORI = ""DRE405"""
"SGPFI";"S";"0128";"* Société MO"
"SGPFI";"S";"0129";"   SI HJOU_SJQSOCIETE = ""MO"""
"SGPFI";"S";"0130";"      LOCA_DROIT = 1"
"SGPFI";"S";"0131";"      LOCA_DPFI = PARD_SDIDPFIAMO"
"SGPFI";"S";"0132";"      LOCA_SEUILABAT = PARD_SDISAPFIMO"
"SGPFI";"S";"0133";"      LOCA_ABATJ = 0.5"
"SGPFI";"S";"0134";"   FINSI"
"SGPFI";"S";"0135";"* Société YR"
"SGPFI";"S";"0136";"   SI HJOU_SJQSOCIETE = ""YR"""
"SGPFI";"S";"0137";"      LOCA_DROIT = 1"
"SGPFI";"S";"0138";"      LOCA_DPFI = PARD_SDIDPFIAYR"
"SGPFI";"S";"0139";"      LOCA_SEUILABAT = PARD_SDISAPFIYR"
"SGPFI";"S";"0140";"      LOCA_ABATJ = 0.5"
"SGPFI";"S";"0141";"   FINSI"
"SGPFI";"S";"0142";"* Société RC"
"SGPFI";"S";"0143";"   SI HJOU_SJQSOCIETE = ""RC"""
"SGPFI";"S";"0144";"      LOCA_DROIT = 1"
"SGPFI";"S";"0145";"      LOCA_DPFI = PARD_SDIDPFIARC"
"SGPFI";"S";"0146";"      LOCA_SEUILABAT = PARD_SDISAPFIRC"
"SGPFI";"S";"0147";"      LOCA_ABATJ = 0.5"
"SGPFI";"S";"0148";"   FINSI"
"SGPFI";"S";"0149";"* Société PC"
"SGPFI";"S";"0150";"   SI HJOU_SJQSOCIETE = ""PC"""
"SGPFI";"S";"0151";"      LOCA_DROIT = 1"
"SGPFI";"S";"0152";"      LOCA_DPFI = PARD_SDIDPFIAPC"
"SGPFI";"S";"0153";"      LOCA_SEUILABAT = PARD_SDISAPFIPC"
"SGPFI";"S";"0154";"      LOCA_ABATJ = 0.5"
"SGPFI";"S";"0155";"   FINSI"
"SGPFI";"S";"0156";"FINSI"
"SGPFI";"S";"0157";"*"
"SGPFI";"S";"0158";"* RAZ mois"
"SGPFI";"S";"0159";"SI HJOU_DATE(7:2) = ""01"""
"SGPFI";"S";"0160";"   HJOU_SJRACQPFIM = 0"
"SGPFI";"S";"0161";"FINSI"
"SGPFI";"S";"0162";"*"
"SGPFI";"S";"0163";"*"
"SGPFI";"S";"0164";"***** DEB : Gestion de l'acquisition >>"
"SGPFI";"S";"0165";"*"
"SGPFI";"S";"0166";"* RAZ des droits à période de référence >>"
"SGPFI";"S";"0167";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGPFI";"S";"0168";"   HJOU_SJRDPFI = 0"
"SGPFI";"S";"0169";"   HJOU_SJRCPFI = 0"
"SGPFI";"S";"0170";"   HJOU_SJRNABSPFI = 0"
"SGPFI";"S";"0171";"   HJOU_SJRABPFA = 0"
"SGPFI";"S";"0172";"   HJOU_SJRSPFI = HJOU_SJRDPFI - HJOU_SJRCPFI"
"SGPFI";"S";"0173";"FINSI"
"SGPFI";"S";"0174";"*"
"SGPFI";"S";"0175";"* DEB - Calcul Abattement >>"
"SGPFI";"S";"0176";"*"
"SGPFI";"S";"0177";"* Vérif. si motif stop l'acquisition du droit PFI ?"
"SGPFI";"S";"0178";"POUR ACTIVITES"
"SGPFI";"S";"0179";"* Réduit acqusition selon le nombre de jour absences dans le mois"
"SGPFI";"S";"0180";"   SI MOTI_SMIABATRTT = ""1"""
"SGPFI";"S";"0181";"      SI HABS_VALORIS = ""J"""
"SGPFI";"S";"0182";"         HJOU_SJRNABSPFI = HJOU_SJRNABSPFI + 1"
"SGPFI";"S";"0183";"      SINON"
"SGPFI";"S";"0184";"         HJOU_SJRNABSPFI = HJOU_SJRNABSPFI + 0.5"
"SGPFI";"S";"0185";"      FINSI"
"SGPFI";"S";"0186";"   FINSI"
"SGPFI";"S";"0187";"* Stop acquisition dès le 1° jour"
"SGPFI";"S";"0188";"   SI MOTI_SMIABATRTT = ""2"""
"SGPFI";"S";"0189";"* A VALIDER, non précisé dans spécification >>"
"SGPFI";"S";"0190";"*      LOCA_STOPACQ = 1"
"SGPFI";"S";"0191";"   FINSI"
"SGPFI";"S";"0192";"FINPOUR"
"SGPFI";"S";"0193";"*"
"SGPFI";"S";"0194";"SI LOCA_SEUILABAT > 0"
"SGPFI";"S";"0195";"   SI LOCA_SEUILABAT <= HJOU_SJRNABSPFI"
"SGPFI";"S";"0196";"      HJOU_SJRABPFA = HJOU_SJRABPFA + LOCA_ABATJ"
"SGPFI";"S";"0197";"      HJOU_SJRDPFI = HJOU_SJRDPFI - LOCA_ABATJ"
"SGPFI";"S";"0198";"      HJOU_SJRNABSPFI = 0"
"SGPFI";"S";"0199";"*"
"SGPFI";"S";"0200";"      SI HJOU_SJRDPFI < 0"
"SGPFI";"S";"0201";"         HJOU_SJRDPFI = 0"
"SGPFI";"S";"0202";"      FINSI"
"SGPFI";"S";"0203";"*"
"SGPFI";"S";"0204";"   FINSI"
"SGPFI";"S";"0205";"FINSI"
"SGPFI";"S";"0206";"*"
"SGPFI";"S";"0207";"* Init via consignes"
"SGPFI";"S";"0208";"POUR ACTIVITES"
"SGPFI";"S";"0209";"   SI HABS_MOTIF = ""ZNABPF"""
"SGPFI";"S";"0210";"      HJOU_SJRNABSPFI = HABS_MOTINBR"
"SGPFI";"S";"0211";"   FINSI"
"SGPFI";"S";"0212";"FINPOUR"
"SGPFI";"S";"0213";"*"
"SGPFI";"S";"0214";"* FIN <<"
"SGPFI";"S";"0215";"*"
"SGPFI";"S";"0216";"* Calcul de l'acquisition jour au 30° afin de gérer au plus juste les entrées/sorties au mois"
"SGPFI";"S";"0217";"SI LOCA_STOPACQ <> 1"
"SGPFI";"S";"0218";"   LOCA_ACQ = LOCA_DPFI / 12"
"SGPFI";"S";"0219";"   LOCA_ACQ = LOCA_ACQ / 30"
"SGPFI";"S";"0220";"SINON"
"SGPFI";"S";"0221";"   LOCA_ACQ = 0"
"SGPFI";"S";"0222";"FINSI"
"SGPFI";"S";"0223";"* Calcul accquisition mois"
"SGPFI";"S";"0224";"SI HJOU_DATE(7:2) < ""31"""
"SGPFI";"S";"0225";"   HJOU_SJRACQPFIM = HJOU_SJRACQPFIM + LOCA_ACQ"
"SGPFI";"S";"0226";"FINSI"
"SGPFI";"S";"0227";"*"
"SGPFI";"S";"0228";"* Gestion du mois de février"
"SGPFI";"S";"0229";"SI TEMP_DATSUI(5:4) = ""0301"""
"SGPFI";"S";"0230";"* années bisextilles"
"SGPFI";"S";"0231";"   SI LOCA_ABIS = 1"
"SGPFI";"S";"0232";"      HJOU_SJRACQPFIM = HJOU_SJRACQPFIM + LOCA_ACQ"
"SGPFI";"S";"0233";"* années non bisextilles"
"SGPFI";"S";"0234";"   SINON"
"SGPFI";"S";"0235";"      HJOU_SJRACQPFIM = HJOU_SJRACQPFIM + LOCA_ACQ"
"SGPFI";"S";"0236";"      HJOU_SJRACQPFIM = HJOU_SJRACQPFIM + LOCA_ACQ"
"SGPFI";"S";"0237";"   FINSI"
"SGPFI";"S";"0238";"FINSI"
"SGPFI";"S";"0239";"*"
"SGPFI";"S";"0240";"* Acquisition dernier jour du mois"
"SGPFI";"S";"0241";"SI TEMP_DATSUI(7:2) = ""01"""
"SGPFI";"S";"0242";"OU HJOU_SJQFINC = 1"
"SGPFI";"S";"0243";"OU CTRA_SCIDATSTC = HJOU_DATE"
"SGPFI";"S";"0244";"*OU HJOU_SJQINSTC = ""1"""
"SGPFI";"S";"0245";"   SI HJOU_SJRACQPFIM > 0"
"SGPFI";"S";"0246";"      HJOU_SJRACQPFIM = HJOU_SJRACQPFIM + 0.0001"
"SGPFI";"S";"0247";"      HJOU_SJRDPFI = HJOU_SJRDPFI + HJOU_SJRACQPFIM"
"SGPFI";"S";"0248";"   FINSI"
"SGPFI";"S";"0249";"FINSI"
"SGPFI";"S";"0250";"*"
"SGPFI";"S";"0251";"* Gestion de l'arrondi à fin de période"
"SGPFI";"S";"0252";"SI TEMP_DATSUI(5:4) = LOCA_DATE(5:4)"
"SGPFI";"S";"0253";"*OU HJOU_SJQINSTC = ""1"""
"SGPFI";"S";"0254";"OU CTRA_SCIDATSTC = HJOU_DATE"
"SGPFI";"S";"0255";"OU HJOU_SJQFINC = 1"
"SGPFI";"S";"0256";"   LOCA_VALAROND = HJOU_SJRDPFI"
"SGPFI";"S";"0257";"   FAIRE ARRONDI"
"SGPFI";"S";"0258";"   HJOU_SJRDPFI = LOCA_VALAROND"
"SGPFI";"S";"0259";"FINSI"
"SGPFI";"S";"0260";"*"
"SGPFI";"S";"0261";"* Init et MAJ du droit par consignes >>"
"SGPFI";"S";"0262";"POUR ACTIVITES"
"SGPFI";"S";"0263";"* MAJ"
"SGPFI";"S";"0264";"   SI HABS_MOTIF = ""XDPFI"""
"SGPFI";"S";"0265";"      HJOU_SJRDPFI = HJOU_SJRDPFI + HABS_MOTINBR"
"SGPFI";"S";"0266";"   FINSI"
"SGPFI";"S";"0267";"* Init"
"SGPFI";"S";"0268";"   SI HABS_MOTIF = ""ZDPFI"""
"SGPFI";"S";"0269";"      HJOU_SJRDPFI = HABS_MOTINBR"
"SGPFI";"S";"0270";"   FINSI"
"SGPFI";"S";"0271";"FINPOUR"
"SGPFI";"S";"0272";"*"
"SGPFI";"S";"0273";"* Solde >>"
"SGPFI";"S";"0274";"HJOU_SJRSPFI = HJOU_SJRDPFI - HJOU_SJRCPFI"
"SGPFI";"S";"0275";"*"
"SGPFI";"S";"0276";"***** DEB : Gestion de la consommation >>"
"SGPFI";"S";"0277";"POUR ACTIVITES"
"SGPFI";"S";"0278";"*"
"SGPFI";"S";"0279";"* Gestion du PERCO >>"
"SGPFI";"S";"0280";"   SI HABS_MOTIF = ""YPERPFI"""
"SGPFI";"S";"0281";"      LOCA_PERCO = LOCA_PERCO + HABS_MOTINBR"
"SGPFI";"S";"0282";"   FINSI"
"SGPFI";"S";"0283";"*"
"SGPFI";"S";"0284";"* Gestion don de PFI"
"SGPFI";"S";"0285";"   SI HABS_MOTIF = ""YDONPFI"""
"SGPFI";"S";"0286";"      HJOU_SJRCPFI = HJOU_SJRCPFI + HABS_MOTINBR"
"SGPFI";"S";"0287";"      HJOU_SJRSPFI = HJOU_SJRDPFI - HJOU_SJRCPFI"
"SGPFI";"S";"0288";"   FINSI"
"SGPFI";"S";"0289";"*"
"SGPFI";"S";"0290";"   SI HJOU_IJQPRETHEJ > 0"
"SGPFI";"S";"0291";"      SI HABS_MOTIF = PARD_SDIVMPFI"
"SGPFI";"S";"0292";"         LOCA_MOT = 1"
"SGPFI";"S";"0293";"*"
"SGPFI";"S";"0294";"         SI HABS_VALORIS = ""J"""
"SGPFI";"S";"0295";"            SI PROF_ABSENM = 0"
"SGPFI";"S";"0296";"            OU PROF_ABSENS = 0"
"SGPFI";"S";"0297";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SGPFI";"S";"0298";"            SINON"
"SGPFI";"S";"0299";"               LOCA_PRIS = LOCA_PRIS + 1"
"SGPFI";"S";"0300";"            FINSI"
"SGPFI";"S";"0301";"         SINON"
"SGPFI";"S";"0302";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SGPFI";"S";"0303";"         FINSI"
"SGPFI";"S";"0304";"*"
"SGPFI";"S";"0305";"      FINSI"
"SGPFI";"S";"0306";"   FINSI"
"SGPFI";"S";"0307";"FINPOUR"
"SGPFI";"S";"0308";"*"
"SGPFI";"S";"0309";"SI LOCA_PRIS > 1"
"SGPFI";"S";"0310";"   LOCA_PRIS = 1"
"SGPFI";"S";"0311";"FINSI"
"SGPFI";"S";"0312";"*"
"SGPFI";"S";"0313";"SI LOCA_PRIS > 0"
"SGPFI";"S";"0314";"   HJOU_SJRCPFI = HJOU_SJRCPFI + LOCA_PRIS"
"SGPFI";"S";"0315";"FINSI"
"SGPFI";"S";"0316";"*"
"SGPFI";"S";"0317";"SI LOCA_PERCO > 0"
"SGPFI";"S";"0318";"   HJOU_SJRCPFI = HJOU_SJRCPFI + LOCA_PERCO"
"SGPFI";"S";"0319";"FINSI"
"SGPFI";"S";"0320";"*"
"SGPFI";"S";"0321";"* Init et MAJ du pris par consignes >>"
"SGPFI";"S";"0322";"POUR ACTIVITES"
"SGPFI";"S";"0323";"* MAJ"
"SGPFI";"S";"0324";"   SI HABS_MOTIF = ""XCPFI"""
"SGPFI";"S";"0325";"      HJOU_SJRCPFI = HJOU_SJRCPFI + HABS_MOTINBR"
"SGPFI";"S";"0326";"   FINSI"
"SGPFI";"S";"0327";"* Init"
"SGPFI";"S";"0328";"   SI HABS_MOTIF = ""ZCPFI"""
"SGPFI";"S";"0329";"      HJOU_SJRCPFI = HABS_MOTINBR"
"SGPFI";"S";"0330";"   FINSI"
"SGPFI";"S";"0331";"FINPOUR"
"SGPFI";"S";"0332";"*"
"SGPFI";"S";"0333";"* Solde >>"
"SGPFI";"S";"0334";"HJOU_SJRSPFI = HJOU_SJRDPFI - HJOU_SJRCPFI"
"SGPFI";"S";"0335";"*"
"SGPFI";"S";"0336";"***** DEB : Gestion du pris en attente >>"
"SGPFI";"S";"0337";"*"
"SGPFI";"S";"0338";"POUR WACTIVITES"
"SGPFI";"S";"0339";"   SI WABS_ANNUL = ""0"""
"SGPFI";"S";"0340";"      SI LOCA_FERI <> 1"
"SGPFI";"S";"0341";"         SI HJOU_IJQPRETHEJ > 0.00"
"SGPFI";"S";"0342";"*"
"SGPFI";"S";"0343";"* PERCO"
"SGPFI";"S";"0344";"            SI WABS_MOTIF = ""YPERPFI"""
"SGPFI";"S";"0345";"               LOCA_PERCOW = LOCA_PERCOW + WABS_MOTINBR"
"SGPFI";"S";"0346";"            FINSI"
"SGPFI";"S";"0347";"*"
"SGPFI";"S";"0348";"            SI WABS_MOTIF = PARD_SDIVMPFI"
"SGPFI";"S";"0349";"* Gestion de la valorisation >>"
"SGPFI";"S";"0350";"               SI WABS_VALORIS = ""J"""
"SGPFI";"S";"0351";"                  SI PROF_ABSENM = 0"
"SGPFI";"S";"0352";"                  OU PROF_ABSENS = 0"
"SGPFI";"S";"0353";"                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SGPFI";"S";"0354";"                  SINON"
"SGPFI";"S";"0355";"                     LOCA_PRISW = 1"
"SGPFI";"S";"0356";"                  FINSI"
"SGPFI";"S";"0357";"               SINON"
"SGPFI";"S";"0358";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SGPFI";"S";"0359";"               FINSI"
"SGPFI";"S";"0360";"            FINSI"
"SGPFI";"S";"0361";"         FINSI"
"SGPFI";"S";"0362";"      FINSI"
"SGPFI";"S";"0363";"   FINSI"
"SGPFI";"S";"0364";"FINPOUR"
"SGPFI";"S";"0365";"*"
"SGPFI";"S";"0366";"SI LOCA_PRISW > 1"
"SGPFI";"S";"0367";"   LOCA_PRISW = 1"
"SGPFI";"S";"0368";"FINSI"
"SGPFI";"S";"0369";"*"
"SGPFI";"S";"0370";"SI LOCA_PRISW > 0"
"SGPFI";"S";"0371";"   HJOU_SJRCPFIW = HJOU_SJRCPFIW + LOCA_PRISW"
"SGPFI";"S";"0372";"FINSI"
"SGPFI";"S";"0373";"SI LOCA_PERCOW > 0"
"SGPFI";"S";"0374";"   HJOU_SJRCPFIW = HJOU_SJRCPFIW + LOCA_PERCOW"
"SGPFI";"S";"0375";"FINSI"
"SGPFI";"S";"0376";"*"
"SGPFI";"S";"0377";"* Solde >>"
"SGPFI";"S";"0378";"HJOU_SJRSPFI = HJOU_SJRDPFI - HJOU_SJRCPFI"
"SGPFI";"S";"0379";"*"
"SGPFI";"S";"0380";"* Identification du seuil PFI autorisé"
"SGPFI";"S";"0381";"* Par défaut 0"
"SGPFI";"S";"0382";"* Autorise un négatif de 1J sur décembre"
"SGPFI";"S";"0383";"SI HJOU_DATE(5:2) = ""12"""
"SGPFI";"S";"0384";"   SI HJOU_DATE(5:4) <> ""1231"""
"SGPFI";"S";"0385";"      SI HJOU_SJRDPFI >= 1"
"SGPFI";"S";"0386";"         LOCA_SEUIL = -1"
"SGPFI";"S";"0387";"      FINSI"
"SGPFI";"S";"0388";"   FINSI"
"SGPFI";"S";"0389";"FINSI"
"SGPFI";"S";"0390";"*"
"SGPFI";"S";"0391";"***** Gestion des anomalies >>"
"SGPFI";"S";"0392";"*"
"SGPFI";"S";"0393";"SI LOCA_MOT = 1"
"SGPFI";"S";"0394";"* Si droit ?"
"SGPFI";"S";"0395";"   SI LOCA_DROIT <> 1"
"SGPFI";"S";"0396";"      ANOMALIE 234"
"SGPFI";"S";"0397";"      SI TEMP_CNMOTIF = PARD_SDIVMPFI"
"SGPFI";"S";"0398";"         TEMP_CNRETOUR = 2"
"SGPFI";"S";"0399";"         TEMP_CNMESS = 234"
"SGPFI";"S";"0400";"      FINSI"
"SGPFI";"S";"0401";"   FINSI"
"SGPFI";"S";"0402";"* Si solde négatif ?"
"SGPFI";"S";"0403";"   SI HJOU_SJRSPFI < LOCA_SEUIL"
"SGPFI";"S";"0404";"      ANOMALIE 235"
"SGPFI";"S";"0405";"      SI TEMP_CNMOTIF = PARD_SDIVMPFI"
"SGPFI";"S";"0406";"      OU TEMP_CNMOTIF = ""YPERPFI"""
"SGPFI";"S";"0407";"         TEMP_CNRETOUR = 2"
"SGPFI";"S";"0408";"         TEMP_CNMESS = 235"
"SGPFI";"S";"0409";"      FINSI"
"SGPFI";"S";"0410";"   FINSI"
"SGPFI";"S";"0411";"*"
"SGPFI";"S";"0412";"FINSI"
"SGPFI";"S";"0413";"*"
"SGPFI";"S";"0414";"SI LOCA_PERCO > 0"
"SGPFI";"S";"0415";"* Si solde négatif ?"
"SGPFI";"S";"0416";"   SI HJOU_SJRSPFI < 0"
"SGPFI";"S";"0417";"      ANOMALIE 235"
"SGPFI";"S";"0418";"      SI TEMP_CNMOTIF = PARD_SDIVMPFI"
"SGPFI";"S";"0419";"      OU TEMP_CNMOTIF = ""YPERPFI"""
"SGPFI";"S";"0420";"         TEMP_CNRETOUR = 2"
"SGPFI";"S";"0421";"         TEMP_CNMESS = 235"
"SGPFI";"S";"0422";"      FINSI"
"SGPFI";"S";"0423";"   FINSI"
"SGPFI";"S";"0424";"FINSI"
"SGPFI";"S";"0425";"*"
"SGPFI";"S";"0426";"***** Solde prévisionnel >>"
"SGPFI";"S";"0427";"*"
"SGPFI";"S";"0428";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGPFI";"S";"0429";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SGPFI";"S";"0430";"      SI HJOU_SJQFINC = 1"
"SGPFI";"S";"0431";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGPFI";"S";"0432";"         LOCA_DATEFU = TEMP_DXFINPER"
"SGPFI";"S";"0433";"      FINSI"
"SGPFI";"S";"0434";"   FINSI"
"SGPFI";"S";"0435";"FINSI"
"SGPFI";"S";"0436";"*"
"SGPFI";"S";"0437";"SI TEMP_DATSUI = LOCA_DATEFU"
"SGPFI";"S";"0438";"* JJA - 13/06/2025 - Pris prèv."
"SGPFI";"S";"0439";"   EMPL_SEQCPFI = HJOU_SJRCPFI + HJOU_SJRCPFIW"
"SGPFI";"S";"0440";"*"
"SGPFI";"S";"0441";"   EMPL_SEQSPPFI = HJOU_SJRSPFI - HJOU_SJRCPFIW"
"SGPFI";"S";"0442";"FINSI"
"SGPFI";"S";"0443";"*"
"SGPFI";"S";"0444";"FIN"
"SGPFI";"S";"0445";"*"
"SGPFI";"S";"0446";"* Gestion arrondis"
"SGPFI";"S";"0447";"PROC ARRONDI"
"SGPFI";"S";"0448";"*"
"SGPFI";"S";"0449";"*DEF LOCA_VALAROND N6.2"
"SGPFI";"S";"0450";"*LOCA_VALAROND = 0"
"SGPFI";"S";"0451";"*DEF LOCA_RESTE N6.2"
"SGPFI";"S";"0452";"*LOCA_RESTE = 0"
"SGPFI";"S";"0453";"*DEF LOCA_ENTIER N6.2"
"SGPFI";"S";"0454";"*LOCA_ENTIER = 0"
"SGPFI";"S";"0455";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGPFI";"S";"0456";"*DEF LOCA_TYPARROND N2"
"SGPFI";"S";"0457";"*LOCA_TYPARROND = 0"
"SGPFI";"S";"0458";"*"
"SGPFI";"S";"0459";"* Arrondi à l'entier supérieur >>"
"SGPFI";"S";"0460";"   SI LOCA_TYPARROND = 1"
"SGPFI";"S";"0461";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGPFI";"S";"0462";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGPFI";"S";"0463";"      SI LOCA_RESTE > 0"
"SGPFI";"S";"0464";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGPFI";"S";"0465";"      FINSI"
"SGPFI";"S";"0466";"      LOCA_VALAROND = LOCA_ENTIER"
"SGPFI";"S";"0467";"   FINSI"
"SGPFI";"S";"0468";"*"
"SGPFI";"S";"0469";"* Arrondi à demi supérieur >>"
"SGPFI";"S";"0470";"   SI LOCA_TYPARROND = 2"
"SGPFI";"S";"0471";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGPFI";"S";"0472";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGPFI";"S";"0473";"      SI LOCA_RESTE > 0.5"
"SGPFI";"S";"0474";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGPFI";"S";"0475";"      SINON"
"SGPFI";"S";"0476";"         SI LOCA_RESTE > 0"
"SGPFI";"S";"0477";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGPFI";"S";"0478";"         FINSI"
"SGPFI";"S";"0479";"      FINSI"
"SGPFI";"S";"0480";"      LOCA_VALAROND = LOCA_ENTIER"
"SGPFI";"S";"0481";"   FINSI"
"SGPFI";"S";"0482";"*"
"SGPFI";"S";"0483";"* Arrondi à demi le plus proche >>"
"SGPFI";"S";"0484";"   SI LOCA_TYPARROND = 3"
"SGPFI";"S";"0485";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGPFI";"S";"0486";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGPFI";"S";"0487";"      SI LOCA_RESTE >= 0.75"
"SGPFI";"S";"0488";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGPFI";"S";"0489";"      SINON"
"SGPFI";"S";"0490";"         SI LOCA_RESTE >= 0.25"
"SGPFI";"S";"0491";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGPFI";"S";"0492";"         FINSI"
"SGPFI";"S";"0493";"      FINSI"
"SGPFI";"S";"0494";"      LOCA_VALAROND = LOCA_ENTIER"
"SGPFI";"S";"0495";"   FINSI"
"SGPFI";"S";"0496";"*"
"SGPFI";"S";"0497";"FINPROC"
"SGPFI";"S";"0498";"*"
"SGRCI";"S";"0001";"***********************************************************************"
"SGRCI";"S";"0002";"*"
"SGRCI";"S";"0003";"* Règle : SGRCI"
"SGRCI";"S";"0004";"* Ordre : 6200"
"SGRCI";"S";"0005";"* Titre : GCF : Récupération RCI"
"SGRCI";"S";"0006";"*"
