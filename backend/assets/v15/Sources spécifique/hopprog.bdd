"IACQCPAN1";"S";"0075";"*"
"IACQCPAN1";"S";"0076";"* Déclaration des donnees locales"
"IACQCPAN1";"S";"0077";"* Variables utilisées pour calculer la date de reference"
"IACQCPAN1";"S";"0078";"DEF LOCA_DATE D"
"IACQCPAN1";"S";"0079";"DEF LOCA_REF N2"
"IACQCPAN1";"S";"0080";"* Variables utilisées pour le calcul de l'ancienneté"
"IACQCPAN1";"S";"0081";"DEF LOCA_ANCIEN N6.1"
"IACQCPAN1";"S";"0082";"LOCA_ANCIEN = 0"
"IACQCPAN1";"S";"0083";"DEF LOCA_TRANS N6.1"
"IACQCPAN1";"S";"0084";"LOCA_TRANS = 0"
"IACQCPAN1";"S";"0085";"DEF LOCA_DROIT N6.1"
"IACQCPAN1";"S";"0086";"LOCA_DROIT = 0"
"IACQCPAN1";"S";"0087";"DEF LOCA_CA N1"
"IACQCPAN1";"S";"0088";"LOCA_CA = 0"
"IACQCPAN1";"S";"0089";"*"
"IACQCPAN1";"S";"0090";"SI CONF_ITIVMREFCP <> "" """
"IACQCPAN1";"S";"0091";"* Calcul de la date de référence CP"
"IACQCPAN1";"S";"0092";"* stockage de l'année du jour de l'historique"
"IACQCPAN1";"S";"0093";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IACQCPAN1";"S";"0094";"* stockage du mois de reference"
"IACQCPAN1";"S";"0095";"   LOCA_REF << CONF_ITIVMREFCP(3:2)"
"IACQCPAN1";"S";"0096";"* stokage du mois de reference"
"IACQCPAN1";"S";"0097";"   LOCA_DATE(5:2) << LOCA_REF"
"IACQCPAN1";"S";"0098";"* stockage du jour de reference"
"IACQCPAN1";"S";"0099";"   LOCA_REF << CONF_ITIVMREFCP(1:2)"
"IACQCPAN1";"S";"0100";"* loca_date contient maintenant l'année du jour de l'historique"
"IACQCPAN1";"S";"0101";"* et le mois et le jour de reference"
"IACQCPAN1";"S";"0102";"   LOCA_DATE(7:2) << LOCA_REF"
"IACQCPAN1";"S";"0103";"SINON"
"IACQCPAN1";"S";"0104";"   LOCA_DATE = "" """
"IACQCPAN1";"S";"0105";"FINSI"
"IACQCPAN1";"S";"0106";"*"
"IACQCPAN1";"S";"0107";"*"
"IACQCPAN1";"S";"0108";"* GESTION DE L'ACQUISITION DES CONGES D'ANCIENNETE"
"IACQCPAN1";"S";"0109";"* Date de référence des congés d'ancienneté"
"IACQCPAN1";"S";"0110";"SI HJOU_DATE = LOCA_DATE"
"IACQCPAN1";"S";"0111";"* Cacul de l'ancienneté"
"IACQCPAN1";"S";"0112";"   DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"IACQCPAN1";"S";"0113";"   LOCA_ANCIEN = TEMP_NXANNEE"
"IACQCPAN1";"S";"0114";"*"
"IACQCPAN1";"S";"0115";"* Si ""régime 1"""
"IACQCPAN1";"S";"0116";"   SI HJOU_IJIREGCPAN = ""1"""
"IACQCPAN1";"S";"0117";"      SI PARD_IDISANC1 > 0"
"IACQCPAN1";"S";"0118";"* Acquisition selon les seuils"
"IACQCPAN1";"S";"0119";"         SI LOCA_ANCIEN >= PARD_IDISANC1"
"IACQCPAN1";"S";"0120";"            SI LOCA_ANCIEN < PARD_IDISANC2"
"IACQCPAN1";"S";"0121";"            OU PARD_IDISANC2 = 0"
"IACQCPAN1";"S";"0122";"               HJOU_IJRDCOANCI = PARD_IDIDCANC1"
"IACQCPAN1";"S";"0123";"            SINON"
"IACQCPAN1";"S";"0124";"               SI LOCA_ANCIEN < PARD_IDISANC3"
"IACQCPAN1";"S";"0125";"               OU PARD_IDISANC3 = 0"
"IACQCPAN1";"S";"0126";"                  HJOU_IJRDCOANCI = PARD_IDIDCANC2"
"IACQCPAN1";"S";"0127";"               SINON"
"IACQCPAN1";"S";"0128";"                  SI LOCA_ANCIEN < PARD_IDISANC4"
"IACQCPAN1";"S";"0129";"                  OU PARD_IDISANC4 = 0"
"IACQCPAN1";"S";"0130";"                     HJOU_IJRDCOANCI = PARD_IDIDCANC3"
"IACQCPAN1";"S";"0131";"                  SINON"
"IACQCPAN1";"S";"0132";"                     SI LOCA_ANCIEN < PARD_IDISANC5"
"IACQCPAN1";"S";"0133";"                     OU PARD_IDISANC5 = 0"
"IACQCPAN1";"S";"0134";"                        HJOU_IJRDCOANCI = PARD_IDIDCANC4"
"IACQCPAN1";"S";"0135";"                     SINON"
"IACQCPAN1";"S";"0136";"                        SI LOCA_ANCIEN < PARD_IDISANC6"
"IACQCPAN1";"S";"0137";"                        OU PARD_IDISANC6 = 0"
"IACQCPAN1";"S";"0138";"                           HJOU_IJRDCOANCI = PARD_IDIDCANC5"
"IACQCPAN1";"S";"0139";"                        SINON"
"IACQCPAN1";"S";"0140";"                           HJOU_IJRDCOANCI = PARD_IDIDCANC6"
"IACQCPAN1";"S";"0141";"                        FINSI"
"IACQCPAN1";"S";"0142";"                     FINSI"
"IACQCPAN1";"S";"0143";"                  FINSI"
"IACQCPAN1";"S";"0144";"               FINSI"
"IACQCPAN1";"S";"0145";"            FINSI"
"IACQCPAN1";"S";"0146";"         FINSI"
"IACQCPAN1";"S";"0147";"      FINSI"
"IACQCPAN1";"S";"0148";"   FINSI"
"IACQCPAN1";"S";"0149";"* Si ""régime 2"""
"IACQCPAN1";"S";"0150";"   SI HJOU_IJIREGCPAN = ""2"""
"IACQCPAN1";"S";"0151";"      SI PARD_IDISANNC1 > 0"
"IACQCPAN1";"S";"0152";"* Acquisition selon les seuils"
"IACQCPAN1";"S";"0153";"         SI LOCA_ANCIEN >= PARD_IDISANNC1"
"IACQCPAN1";"S";"0154";"            SI LOCA_ANCIEN < PARD_IDISANNC2"
"IACQCPAN1";"S";"0155";"            OU PARD_IDISANNC2 = 0"
"IACQCPAN1";"S";"0156";"               HJOU_IJRDCOANCI = PARD_IDIDCANNC1"
"IACQCPAN1";"S";"0157";"            SINON"
"IACQCPAN1";"S";"0158";"               SI LOCA_ANCIEN < PARD_IDISANNC3"
"IACQCPAN1";"S";"0159";"               OU PARD_IDISANNC3 = 0"
"IACQCPAN1";"S";"0160";"                  HJOU_IJRDCOANCI = PARD_IDIDCANNC2"
"IACQCPAN1";"S";"0161";"               SINON"
"IACQCPAN1";"S";"0162";"                  SI LOCA_ANCIEN < PARD_IDISANNC4"
"IACQCPAN1";"S";"0163";"                  OU PARD_IDISANNC4 = 0"
"IACQCPAN1";"S";"0164";"                     HJOU_IJRDCOANCI = PARD_IDIDCANNC3"
"IACQCPAN1";"S";"0165";"                  SINON"
"IACQCPAN1";"S";"0166";"                     SI LOCA_ANCIEN < PARD_IDISANNC5"
"IACQCPAN1";"S";"0167";"                     OU PARD_IDISANNC5 = 0"
"IACQCPAN1";"S";"0168";"                        HJOU_IJRDCOANCI = PARD_IDIDCANNC4"
"IACQCPAN1";"S";"0169";"                     SINON"
"IACQCPAN1";"S";"0170";"                        SI LOCA_ANCIEN < PARD_IDISANNC6"
"IACQCPAN1";"S";"0171";"                        OU PARD_IDISANNC6 = 0"
"IACQCPAN1";"S";"0172";"                           HJOU_IJRDCOANCI = PARD_IDIDCANNC5"
"IACQCPAN1";"S";"0173";"                        SINON"
"IACQCPAN1";"S";"0174";"                           HJOU_IJRDCOANCI = PARD_IDIDCANNC6"
"IACQCPAN1";"S";"0175";"                        FINSI"
"IACQCPAN1";"S";"0176";"                     FINSI"
"IACQCPAN1";"S";"0177";"                  FINSI"
"IACQCPAN1";"S";"0178";"               FINSI"
"IACQCPAN1";"S";"0179";"            FINSI"
"IACQCPAN1";"S";"0180";"         FINSI"
"IACQCPAN1";"S";"0181";"      FINSI"
"IACQCPAN1";"S";"0182";"   FINSI"
"IACQCPAN1";"S";"0183";"* Remise à zéro du pris"
"IACQCPAN1";"S";"0184";"   HJOU_IJRCCOANCI = 0"
"IACQCPAN1";"S";"0185";"   HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"IACQCPAN1";"S";"0186";"FINSI"
"IACQCPAN1";"S";"0187";"* GESTION CONSIGNES D'INIT. ET MAJ"
"IACQCPAN1";"S";"0188";"POUR ACTIVITES"
"IACQCPAN1";"S";"0189";"* consignes de MAJ du droit congés d'ancienneté"
"IACQCPAN1";"S";"0190";"   SI HABS_MOTIF = ""XDCA"""
"IACQCPAN1";"S";"0191";"      LOCA_CA = 1"
"IACQCPAN1";"S";"0192";"      LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCOANCI"
"IACQCPAN1";"S";"0193";"      LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCOANCI"
"IACQCPAN1";"S";"0194";"      *"
"IACQCPAN1";"S";"0195";"      HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + HABS_MOTINBR"
"IACQCPAN1";"S";"0196";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACQCPAN1";"S";"0197";"   FINSI"
"IACQCPAN1";"S";"0198";"* Droit congé d'ancienneté"
"IACQCPAN1";"S";"0199";"   SI HABS_MOTIF = ""ZDCA"""
"IACQCPAN1";"S";"0200";"      LOCA_CA = 1"
"IACQCPAN1";"S";"0201";"      LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCOANCI"
"IACQCPAN1";"S";"0202";"      *"
"IACQCPAN1";"S";"0203";"      HJOU_IJRDCOANCI = HABS_MOTINBR"
"IACQCPAN1";"S";"0204";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACQCPAN1";"S";"0205";"   FINSI"
"IACQCPAN1";"S";"0206";"FINPOUR"
"IACQCPAN1";"S";"0207";"*"
"IACQCPAN1";"S";"0208";"SI LOCA_CA = 1"
"IACQCPAN1";"S";"0209";"   SI HJOU_IJRSCOANCI < 0"
"IACQCPAN1";"S";"0210";"      ANOMALIE 168"
"IACQCPAN1";"S";"0211";"   FINSI"
"IACQCPAN1";"S";"0212";"FINSI"
"IACQCPAN1";"S";"0213";"*"
"IACQCPAN1";"S";"0214";"FIN"
