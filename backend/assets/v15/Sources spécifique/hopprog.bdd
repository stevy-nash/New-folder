"IDEBOR";"S";"0029";"* Implémentation des données industrielles"
"IDEBOR";"S";"0030";"*"
"IDEBOR";"S";"0031";"DEBDICO"
"IDEBOR";"S";"0032";"   HJOU_IJQHEXCEDJ;N;T6,2;I;;;    56789;;;V3;""Heures totales excédentaires"";"
"IDEBOR";"S";"0033";"FINDICO"
"IDEBOR";"S";"0034";"*"
"IDEBOR";"S";"0035";"* Déclaration des donnees locales"
"IDEBOR";"S";"0036";"*"
"IDEBOR";"S";"0037";"SI HJOU_DATE <= TEMP_DATJOU"
"IDEBOR";"S";"0038";"   HJOU_IJQHEXCEDJ = HJOU_IJQDEBORDT"
"IDEBOR";"S";"0039";"   POUR ACTIVITES"
"IDEBOR";"S";"0040";"      SI HABS_MOTIF = ""ZEXC"""
"IDEBOR";"S";"0041";"         HJOU_IJQHEXCEDJ = HABS_MOTIDUR"
"IDEBOR";"S";"0042";"      FINSI"
"IDEBOR";"S";"0043";"   FINPOUR"
"IDEBOR";"S";"0044";"FINSI"
"IDEBOR";"S";"0045";"FIN"
"IDELEG";"S";"0001";"***********************************************************************"
"IDELEG";"S";"0002";"*"
"IDELEG";"S";"0003";"* Règle : IDELEG"
"IDELEG";"S";"0004";"* Ordre : 3340"
"IDELEG";"S";"0005";"* Titre : Délégations"
"IDELEG";"S";"0006";"*"
"IDELEG";"S";"0007";"*----------------------------------------------------------------------"
"IDELEG";"S";"0008";"*"
"IDELEG";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDELEG";"S";"0010";"* Date     : 03/09/2009"
"IDELEG";"S";"0011";"* Version  : 1"
"IDELEG";"S";"0012";"*"
"IDELEG";"S";"0013";"*----------------------------------------------------------------------"
"IDELEG";"S";"0014";"*"
"IDELEG";"S";"0015";"*"
"IDELEG";"S";"0016";"* Rôle : Gestion des délégations DS/DFS"
"IDELEG";"S";"0017";"*"
"IDELEG";"S";"0018";"*"
"IDELEG";"S";"0019";"*"
"IDELEG";"S";"0020";"*----------------------------------------------------------------------"
"IDELEG";"S";"0021";"*"
"IDELEG";"S";"0022";"* Modifiée par : Méthodes et outils"
"IDELEG";"S";"0023";"* Date         : 18/10/2019"
"IDELEG";"S";"0024";"* Objet        : Suppression des délégations CE, DP, CHSCT et DUP"
"IDELEG";"S";"0025";"*"
"IDELEG";"S";"0026";"***********************************************************************"
"IDELEG";"S";"0027";"*"
"IDELEG";"S";"0028";"* Implémentation des données industrielles"
"IDELEG";"S";"0029";"*"
"IDELEG";"S";"0030";"DEBDICO"
"IDELEG";"S";"0031";"   HJOU_IJIDDELEDS;O;T6,2;I;;;123456789;;;C3;""Droit délégation DS"";"
"IDELEG";"S";"0032";"   HJOU_IJIDATDEDS;O;D10;X;;;123456789;;;C3;""Date début de mandat délégation DS"";"
"IDELEG";"S";"0033";"   HJOU_IJIDATFDDS;O;D10;X;;;123456789;;;C3;""Fin de mandat délégation DS"";"
"IDELEG";"S";"0034";"   HJOU_IJRDDELEDS;N;T6,2;I;;;     6789;;IJRDDELEDS;V3;""Droit délégation DS"";"
"IDELEG";"S";"0035";"   HJOU_IJRCDELEDS;N;T6,2;I;;;     6789;;IJRCDELEDS;V3;""Pris délégation DS"";"
"IDELEG";"S";"0036";"   HJOU_IJRSDELEDS;N;T6,2;I;;;     6789;;;V3;""Solde délégation DS"";"
"IDELEG";"S";"0037";"   HJOU_IJIDDELDFS;O;T6,2;I;;;123456789;;;C3;""Droit délégation DFS"";"
"IDELEG";"S";"0038";"   HJOU_IJIDATDDFS;O;D10;X;;;123456789;;;C3;""Date début de mandat délégation DFS"";"
"IDELEG";"S";"0039";"   HJOU_IJIDATFDFS;O;D10;X;;;123456789;;;C3;""Fin de mandat délégation DFS"";"
"IDELEG";"S";"0040";"   HJOU_IJRDDELDFS;N;T6,2;I;;;     6789;;IJRDDELDFS;V3;""Droit délégation DFS"";"
"IDELEG";"S";"0041";"   HJOU_IJRCDELDFS;N;T6,2;I;;;     6789;;IJRCDELDFS;V3;""Pris délégation DFS"";"
"IDELEG";"S";"0042";"   HJOU_IJRSDELDFS;N;T6,2;I;;;     6789;;;V3;""Solde délégation DFS"";"
"IDELEG";"S";"0043";"   HJOU_IJRNBHDELE;N;T6,2;I;;;     6789;;IJRNBHDELE;V3;""Nbre h. délég. pour jours trav. annuels"";"
"IDELEG";"S";"0044";"FINDICO"
"IDELEG";"S";"0045";"*"
"IDELEG";"S";"0046";"DEBANO"
"IDELEG";"S";"0047";"   205;8;""La date de fin de mandat DS inférieure à la date de début"";"
"IDELEG";"S";"0048";"   206;8;""Date de fin de mandat DS non renseignée"";"
"IDELEG";"S";"0049";"   207;8;""Date de début de mandat DS non renseignée"";"
"IDELEG";"S";"0050";"   208;8;""Pas de mandat délégation DS"";"
"IDELEG";"S";"0051";"   209;8;""Solde délégation DS insuffisant"";"
"IDELEG";"S";"0052";"   210;8;""La date de fin de mandat DFS est inférieure à la date de début"";"
"IDELEG";"S";"0053";"   211;8;""Date de fin de mandat DFS non renseignée"";"
"IDELEG";"S";"0054";"   212;8;""Date de début de mandat DFS non renseignée"";"
"IDELEG";"S";"0055";"   213;8;""Pas de mandat délégation DFS"";"
"IDELEG";"S";"0056";"   214;8;""Solde délégation DFS insuffisant"";"
"IDELEG";"S";"0057";"FINANO"
"IDELEG";"S";"0058";"* Déclaration des donnees locales"
"IDELEG";"S";"0059";"*"
"IDELEG";"S";"0060";"DEF LOCA_MOTDS N1"
"IDELEG";"S";"0061";"LOCA_MOTDS = 0"
"IDELEG";"S";"0062";"DEF LOCA_MOTDFS N1"
"IDELEG";"S";"0063";"LOCA_MOTDFS = 0"
"IDELEG";"S";"0064";"DEF LOCA_ADEDUIRE T6.2"
"IDELEG";"S";"0065";"LOCA_ADEDUIRE = 0"
"IDELEG";"S";"0066";"DEF LOCA_ENTIER N6.2"
"IDELEG";"S";"0067";"LOCA_ENTIER = 0"
"IDELEG";"S";"0068";"DEF LOCA_RESTE N6.2"
"IDELEG";"S";"0069";"LOCA_RESTE = 01"
"IDELEG";"S";"0070";"DEF LOCA_DIV T6.2"
"IDELEG";"S";"0071";"LOCA_DIV = 4"
"IDELEG";"S";"0072";"DEF LOCA_NB N6.2"
"IDELEG";"S";"0073";"LOCA_NB = 0"
"IDELEG";"S";"0074";"**"
"IDELEG";"S";"0075";"** RAZ du nombre annuel de délégation pris"
"IDELEG";"S";"0076";"**"
"IDELEG";"S";"0077";"SI PARD_IDIDDEBANN <> "" """
"IDELEG";"S";"0078";"   SI HJOU_DATE = PARD_IDIDDEBANN"
"IDELEG";"S";"0079";"      HJOU_IJRNBHDELE = 0"
"IDELEG";"S";"0080";"   FINSI"
"IDELEG";"S";"0081";"SINON"
"IDELEG";"S";"0082";"   SI HJOU_DATE(5:4) = ""0101"""
"IDELEG";"S";"0083";"      HJOU_IJRNBHDELE = 0"
"IDELEG";"S";"0084";"   FINSI"
"IDELEG";"S";"0085";"FINSI"
"IDELEG";"S";"0086";"**"
"IDELEG";"S";"0087";"**"
"IDELEG";"S";"0088";"** Raz des compteurs droit/pris si la date de début de délégation est à blanc"
"IDELEG";"S";"0089";"**"
"IDELEG";"S";"0090";"SI HJOU_IJIDATDEDS = "" """
"IDELEG";"S";"0091";"   HJOU_IJRDDELEDS = 0"
"IDELEG";"S";"0092";"   HJOU_IJRCDELEDS = 0"
"IDELEG";"S";"0093";"FINSI"
"IDELEG";"S";"0094";"*"
"IDELEG";"S";"0095";"SI HJOU_IJIDATDDFS = "" """
"IDELEG";"S";"0096";"   HJOU_IJRDDELDFS = 0"
"IDELEG";"S";"0097";"   HJOU_IJRCDELDFS = 0"
"IDELEG";"S";"0098";"FINSI"
"IDELEG";"S";"0099";"*"
"IDELEG";"S";"0100";"** alimentation du droit DS"
"IDELEG";"S";"0101";"** test si le droit est renseigné"
"IDELEG";"S";"0102";"** remise à 0 des compteurs de pris"
"IDELEG";"S";"0103";"SI HJOU_DATE(7:2) = ""01"""
"IDELEG";"S";"0104";"   HJOU_IJRCDELEDS = 0"
"IDELEG";"S";"0105";"   HJOU_IJRCDELDFS = 0"
"IDELEG";"S";"0106";"FINSI"
"IDELEG";"S";"0107";"*********************************************************************************"
"IDELEG";"S";"0108";"** Délégation DS"
"IDELEG";"S";"0109";"*********************************************************************************"
"IDELEG";"S";"0110";"SI HJOU_IJIDDELEDS > 0"
"IDELEG";"S";"0111";"* test si la date de début de mandat est renseignée"
"IDELEG";"S";"0112";"   SI HJOU_IJIDATDEDS <> "" """
"IDELEG";"S";"0113";"      SI HJOU_IJIDATFDDS > HJOU_IJIDATDEDS"
"IDELEG";"S";"0114";"         SI HJOU_DATE(7:2) = ""01"""
"IDELEG";"S";"0115";"         OU HJOU_DATE = HJOU_IJIDATDEDS"
"IDELEG";"S";"0116";"            SI HJOU_DATE >= HJOU_IJIDATDEDS"
"IDELEG";"S";"0117";"               SI HJOU_DATE <= HJOU_IJIDATFDDS"
"IDELEG";"S";"0118";"                  HJOU_IJRDDELEDS = HJOU_IJIDDELEDS"
"IDELEG";"S";"0119";"               SINON"
"IDELEG";"S";"0120";"* la date de fin de mandat est dépassée"
"IDELEG";"S";"0121";"* le compteur est remis à 0"
"IDELEG";"S";"0122";"                  HJOU_IJRDDELEDS = 0"
"IDELEG";"S";"0123";"               FINSI"
"IDELEG";"S";"0124";"            FINSI"
"IDELEG";"S";"0125";"         FINSI"
"IDELEG";"S";"0126";"      SINON"
"IDELEG";"S";"0127";"         SI HJOU_IJIDATFDDS <> "" """
"IDELEG";"S";"0128";"* la date de fin de mandat DS est inférieure à la date de début"
"IDELEG";"S";"0129";"            ANOMALIE 205"
"IDELEG";"S";"0130";"         SINON"
"IDELEG";"S";"0131";"* la date de fin de mandat DS n'est pas renseignée"
"IDELEG";"S";"0132";"            ANOMALIE 206"
"IDELEG";"S";"0133";"         FINSI"
"IDELEG";"S";"0134";"      FINSI"
"IDELEG";"S";"0135";"   SINON"
"IDELEG";"S";"0136";"* la date de début de mandat DS n'est pas renseignée"
"IDELEG";"S";"0137";"      ANOMALIE 207"
"IDELEG";"S";"0138";"   FINSI"
"IDELEG";"S";"0139";"FINSI"
"IDELEG";"S";"0140";"*********************************************************************************"
"IDELEG";"S";"0141";"** Délégation DFS"
"IDELEG";"S";"0142";"*********************************************************************************"
"IDELEG";"S";"0143";"SI HJOU_IJIDDELDFS > 0"
"IDELEG";"S";"0144";"* test si la date de début de mandat est renseignée"
"IDELEG";"S";"0145";"   SI HJOU_IJIDATDDFS <> "" """
"IDELEG";"S";"0146";"      SI HJOU_IJIDATFDFS > HJOU_IJIDATDDFS"
"IDELEG";"S";"0147";"         SI HJOU_DATE(7:2) = ""01"""
"IDELEG";"S";"0148";"         OU HJOU_DATE = HJOU_IJIDATDDFS"
"IDELEG";"S";"0149";"            SI HJOU_DATE >= HJOU_IJIDATDDFS"
"IDELEG";"S";"0150";"               SI HJOU_DATE <= HJOU_IJIDATFDFS"
"IDELEG";"S";"0151";"                  HJOU_IJRDDELDFS = HJOU_IJIDDELDFS"
"IDELEG";"S";"0152";"               SINON"
"IDELEG";"S";"0153";"* la date de fin de mandat est dépassée"
"IDELEG";"S";"0154";"* le compteur est remis à 0"
"IDELEG";"S";"0155";"                  HJOU_IJRDDELDFS = 0"
"IDELEG";"S";"0156";"               FINSI"
"IDELEG";"S";"0157";"            FINSI"
"IDELEG";"S";"0158";"         FINSI"
"IDELEG";"S";"0159";"      SINON"
"IDELEG";"S";"0160";"         SI HJOU_IJIDATFDFS <> "" """
"IDELEG";"S";"0161";"* la date de fin de mandat DFS est inférieure à la date de début"
"IDELEG";"S";"0162";"            ANOMALIE 210"
"IDELEG";"S";"0163";"         SINON"
"IDELEG";"S";"0164";"            ANOMALIE 211"
"IDELEG";"S";"0165";"         FINSI"
"IDELEG";"S";"0166";"      FINSI"
"IDELEG";"S";"0167";"   SINON"
"IDELEG";"S";"0168";"* la date de début de mandat DFS n'est pas renseignée"
"IDELEG";"S";"0169";"      ANOMALIE 212"
"IDELEG";"S";"0170";"   FINSI"
"IDELEG";"S";"0171";"FINSI"
"IDELEG";"S";"0172";"*********************************************************************************"
"IDELEG";"S";"0173";"** alimentation du pris"
"IDELEG";"S";"0174";"*********************************************************************************"
"IDELEG";"S";"0175";"POUR ACTIVITES"
"IDELEG";"S";"0176";"* délégation DS"
"IDELEG";"S";"0177";"   SI HABS_MOTIF = ""DEDS"""
"IDELEG";"S";"0178";"* contrôle si le droit est alimenté"
"IDELEG";"S";"0179";"      SI HJOU_IJRDDELEDS > 0"
"IDELEG";"S";"0180";"         HJOU_IJRCDELEDS = HJOU_IJRCDELEDS + HABS_MOTIDUR"
"IDELEG";"S";"0181";"         LOCA_MOTDS = 1"
"IDELEG";"S";"0182";"      SINON"
"IDELEG";"S";"0183";"* pas de droit"
"IDELEG";"S";"0184";"         ANOMALIE 208"
"IDELEG";"S";"0185";"      FINSI"
"IDELEG";"S";"0186";"   FINSI"
"IDELEG";"S";"0187";"* délégation DFS"
"IDELEG";"S";"0188";"   SI HABS_MOTIF = ""DEDFS"""
"IDELEG";"S";"0189";"* contrôle si le droit est alimenté"
"IDELEG";"S";"0190";"      SI HJOU_IJRDDELDFS > 0"
"IDELEG";"S";"0191";"         HJOU_IJRCDELDFS = HJOU_IJRCDELDFS + HABS_MOTIDUR"
"IDELEG";"S";"0192";"         LOCA_MOTDFS = 1"
"IDELEG";"S";"0193";"      SINON"
"IDELEG";"S";"0194";"* pas de droit"
"IDELEG";"S";"0195";"         ANOMALIE 213"
"IDELEG";"S";"0196";"      FINSI"
"IDELEG";"S";"0197";"   FINSI"
"IDELEG";"S";"0198";"FINPOUR"
"IDELEG";"S";"0199";"**************************************************************************************"
"IDELEG";"S";"0200";"** comptabilisation du nomnbre d'heures motifs délégation"
"IDELEG";"S";"0201";"** pour minoration du nombre de jour travaillés"
"IDELEG";"S";"0202";"** pour les cadre forfait jours"
"IDELEG";"S";"0203";"**************************************************************************************"
"IDELEG";"S";"0204";"SI HJOU_IJICATEGOR = ""03"""
"IDELEG";"S";"0205";"   POUR ACTIVITES"
"IDELEG";"S";"0206";"      SI HABS_MOTIF = ""DEDS"""
"IDELEG";"S";"0207";"      OU HABS_MOTIF = ""DEDFS"""
"IDELEG";"S";"0208";"         HJOU_IJRNBHDELE = HJOU_IJRNBHDELE + HABS_MOTIDUR"
"IDELEG";"S";"0209";"      FINSI"
"IDELEG";"S";"0210";"   FINPOUR"
"IDELEG";"S";"0211";"   SI HJOU_IJRNBHDELE >= 4"
"IDELEG";"S";"0212";"      LOCA_NB = HJOU_IJRNBHDELE / LOCA_DIV"
"IDELEG";"S";"0213";"      LOCA_RESTE = LOCA_NB % 1"
"IDELEG";"S";"0214";"      LOCA_ENTIER = LOCA_NB - LOCA_RESTE"
"IDELEG";"S";"0215";"      LOCA_ADEDUIRE = LOCA_ENTIER * 4"
"IDELEG";"S";"0216";"      HJOU_IJRNBHDELE = HJOU_IJRNBHDELE - LOCA_ADEDUIRE"
"IDELEG";"S";"0217";"** alimentation du compteur de 1/2 journée à deduire dans les jours travaillés"
"IDELEG";"S";"0218";"      TEMP_ITQNBJTRAV = LOCA_ENTIER * 0.5"
"IDELEG";"S";"0219";"   FINSI"
"IDELEG";"S";"0220";"FINSI"
"IDELEG";"S";"0221";"*************************************************************************"
"IDELEG";"S";"0222";"**"
"IDELEG";"S";"0223";"** initialisation du pris par consigne"
"IDELEG";"S";"0224";"*************************************************************************"
"IDELEG";"S";"0225";"POUR ACTIVITES"
"IDELEG";"S";"0226";"   SI HABS_MOTIF = ""XCDEDS"""
"IDELEG";"S";"0227";"      HJOU_IJRCDELEDS = HJOU_IJRCDELEDS + HABS_MOTIDUR"
"IDELEG";"S";"0228";"   FINSI"
"IDELEG";"S";"0229";"   SI HABS_MOTIF = ""ZCDEDS"""
"IDELEG";"S";"0230";"      HJOU_IJRCDELEDS = HABS_MOTIDUR"
"IDELEG";"S";"0231";"   FINSI"
"IDELEG";"S";"0232";"   SI HABS_MOTIF = ""XCDDFS"""
"IDELEG";"S";"0233";"      HJOU_IJRCDELDFS = HJOU_IJRCDELDFS + HABS_MOTIDUR"
"IDELEG";"S";"0234";"   FINSI"
"IDELEG";"S";"0235";"   SI HABS_MOTIF = ""ZCDDFS"""
"IDELEG";"S";"0236";"      HJOU_IJRCDELDFS = HABS_MOTIDUR"
"IDELEG";"S";"0237";"   FINSI"
"IDELEG";"S";"0238";"FINPOUR"
"IDELEG";"S";"0239";"*************************************************************************"
"IDELEG";"S";"0240";"** gestion des soldes"
"IDELEG";"S";"0241";"*************************************************************************"
"IDELEG";"S";"0242";"* DFS"
"IDELEG";"S";"0243";"HJOU_IJRSDELDFS = HJOU_IJRDDELDFS - HJOU_IJRCDELDFS"
"IDELEG";"S";"0244";"SI HJOU_IJRSDELDFS < 0"
"IDELEG";"S";"0245";"   SI LOCA_MOTDFS = 1"
"IDELEG";"S";"0246";"      ANOMALIE 214"
"IDELEG";"S";"0247";"   FINSI"
"IDELEG";"S";"0248";"FINSI"
"IDELEG";"S";"0249";"*"
"IDELEG";"S";"0250";"* DS"
"IDELEG";"S";"0251";"HJOU_IJRSDELEDS = HJOU_IJRDDELEDS - HJOU_IJRCDELEDS"
"IDELEG";"S";"0252";"SI HJOU_IJRSDELEDS < 0"
"IDELEG";"S";"0253";"   SI LOCA_MOTDS = 1"
"IDELEG";"S";"0254";"      ANOMALIE 209"
"IDELEG";"S";"0255";"   FINSI"
"IDELEG";"S";"0256";"FINSI"
"IDELEG";"S";"0257";"FIN"
