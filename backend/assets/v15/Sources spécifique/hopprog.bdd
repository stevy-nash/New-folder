"ITPSACTPT1";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTPT1";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTPT1";"S";"0038";"FINDICO"
"ITPSACTPT1";"S";"0039";"*"
"ITPSACTPT1";"S";"0040";"*"
"ITPSACTPT1";"S";"0041";"* DEBANO"
"ITPSACTPT1";"S";"0042";"*"
"ITPSACTPT1";"S";"0043";"* FINANO"
"ITPSACTPT1";"S";"0044";"*"
"ITPSACTPT1";"S";"0045";"* Définition des variables locales"
"ITPSACTPT1";"S";"0046";"DEF LOCA_DURABS T6.2"
"ITPSACTPT1";"S";"0047";"LOCA_DURABS = 0"
"ITPSACTPT1";"S";"0048";"*"
"ITPSACTPT1";"S";"0049";"* Gestion de l'indicateur activité"
"ITPSACTPT1";"S";"0050";"SI HJOU_IJIACTI = "" """
"ITPSACTPT1";"S";"0051";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTPT1";"S";"0052";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTPT1";"S";"0053";"    FINSI"
"ITPSACTPT1";"S";"0054";"FINSI"
"ITPSACTPT1";"S";"0055";"* Employé géré en activité"
"ITPSACTPT1";"S";"0056";"SI HJOU_IJIACTI <> "" """
"ITPSACTPT1";"S";"0057";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTPT1";"S";"0058";"        * Calcul de la présence activité"
"ITPSACTPT1";"S";"0059";"        SI PRES_VALID <> ""O"""
"ITPSACTPT1";"S";"0060";"            PRES_VALID = ""N"""
"ITPSACTPT1";"S";"0061";"            PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTPT1";"S";"0062";"            SI HJOU_SECTAFF <> "" """
"ITPSACTPT1";"S";"0063";"                PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTPT1";"S";"0064";"            SINON"
"ITPSACTPT1";"S";"0065";"                PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTPT1";"S";"0066";"            FINSI"
"ITPSACTPT1";"S";"0067";"            *"
"ITPSACTPT1";"S";"0068";"            SI PRES_MODE_TRV = "" """
"ITPSACTPT1";"S";"0069";"               PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPT1";"S";"0070";"            FINSI"
"ITPSACTPT1";"S";"0071";"            *"
"ITPSACTPT1";"S";"0072";"            * ----------------------------------------------------------------------------------"
"ITPSACTPT1";"S";"0073";"            *"
"ITPSACTPT1";"S";"0074";"            * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTPT1";"S";"0075";"            *                              (A décommenter si besoin)"
"ITPSACTPT1";"S";"0076";"            *"
"ITPSACTPT1";"S";"0077";"            * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTPT1";"S";"0078";"            * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test de la"
"ITPSACTPT1";"S";"0079";"            * présence théorique différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTPT1";"S";"0080";"            * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTPT1";"S";"0081";"            *"
"ITPSACTPT1";"S";"0082";"            * SI HJOU_IJQPRETHEJ <> 0"
"ITPSACTPT1";"S";"0083";"                PRES_TPS_PRES = HJOU_IJQPRETHEJ"
"ITPSACTPT1";"S";"0084";"            * SINON"
"ITPSACTPT1";"S";"0085";"                * PRES_TPS_PRES = 0.01"
"ITPSACTPT1";"S";"0086";"            * FINSI"
"ITPSACTPT1";"S";"0087";"            * ----------------------------------------------------------------------------------"
"ITPSACTPT1";"S";"0088";"            *"
"ITPSACTPT1";"S";"0089";"            *"
"ITPSACTPT1";"S";"0090";"            *"
"ITPSACTPT1";"S";"0091";"            * ----------------------------------------------------------------------------------"
"ITPSACTPT1";"S";"0092";"            *"
"ITPSACTPT1";"S";"0093";"            * !!!                Pour gestion des temps de présence par consigne                !!!"
"ITPSACTPT1";"S";"0094";"            *                              (A décommenter si besoin)"
"ITPSACTPT1";"S";"0095";"            *"
"ITPSACTPT1";"S";"0096";"            * Si besoin de gérer les temps de présence par consigne, décommenter le"
"ITPSACTPT1";"S";"0097";"            * POUR ACTIVITES ci-dessous ainsi le test LOCA_DURABS <> 0"
"ITPSACTPT1";"S";"0098";"            *"
"ITPSACTPT1";"S";"0099";"            * récupération des temps de présence declaré par consigne"
"ITPSACTPT1";"S";"0100";"            * POUR ACTIVITES"
"ITPSACTPT1";"S";"0101";"                * SI HABS_MOTYPE = ""C"""
"ITPSACTPT1";"S";"0102";"                    * Motif participant au temps d'activité à justifier"
"ITPSACTPT1";"S";"0103";"                    * SI MOTI_MOTIF = ""XPRES"""
"ITPSACTPT1";"S";"0104";"                        * LOCA_DURABS = LOCA_DURABS + HABS_MOTIDUR"
"ITPSACTPT1";"S";"0105";"                    * FINSI"
"ITPSACTPT1";"S";"0106";"                * FINSI"
"ITPSACTPT1";"S";"0107";"            * FINPOUR"
"ITPSACTPT1";"S";"0108";"            *"
"ITPSACTPT1";"S";"0109";"            * SI LOCA_DURABS <> 0"
"ITPSACTPT1";"S";"0110";"                * PRES_TPS_PRES = LOCA_DURABS"
"ITPSACTPT1";"S";"0111";"            * FINSI"
"ITPSACTPT1";"S";"0112";"            * ----------------------------------------------------------------------------------"
"ITPSACTPT1";"S";"0113";"            *"
"ITPSACTPT1";"S";"0114";"            PRES_TPS_IMPUTE = 0"
"ITPSACTPT1";"S";"0115";"            SI HJOU_IJIACTI = ""1"""
"ITPSACTPT1";"S";"0116";"            OU HJOU_IJIACTI = ""2"""
"ITPSACTPT1";"S";"0117";"            OU HJOU_IJIACTI = ""3"""
"ITPSACTPT1";"S";"0118";"                POUR EVENEMENTS"
"ITPSACTPT1";"S";"0119";"                    PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTPT1";"S";"0120";"                FINPOUR"
"ITPSACTPT1";"S";"0121";"            FINSI"
"ITPSACTPT1";"S";"0122";"            * Calcul de l'écart"
"ITPSACTPT1";"S";"0123";"            PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTPT1";"S";"0124";"        FINSI"
"ITPSACTPT1";"S";"0125";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTPT1";"S";"0126";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTPT1";"S";"0127";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTPT1";"S";"0128";"        FINSI"
"ITPSACTPT1";"S";"0129";"    FINSI"
"ITPSACTPT1";"S";"0130";"FINSI"
"ITPSACTPT1";"S";"0131";"*"
"ITPSACTPT1";"S";"0132";"FIN"
