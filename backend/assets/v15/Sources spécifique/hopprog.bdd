"SRAZCO";"S";"0099";"   149;5;""La consigne ZRAZCT doit être positionnée sur la date de début de contrat"";"
"SRAZCO";"S";"0100";"FINANO"
"SRAZCO";"S";"0101";"*"
"SRAZCO";"S";"0102";"* Déclaration des donnees locales"
"SRAZCO";"S";"0103";"DEF LOCA_RAZCPT N1"
"SRAZCO";"S";"0104";"LOCA_RAZCPT = 0"
"SRAZCO";"S";"0105";"DEF LOCA_STC N2"
"SRAZCO";"S";"0106";"LOCA_STC = 0"
"SRAZCO";"S";"0107";"DEF LOCA_DATSTC D"
"SRAZCO";"S";"0108";"LOCA_DATSTC = "" """
"SRAZCO";"S";"0109";"*"
"SRAZCO";"S";"0110";"***** Définition continuité contrat ****************************************************************"
"SRAZCO";"S";"0111";"*"
"SRAZCO";"S";"0112";"SI HJOU_DATE = CTRA_DATDEB"
"SRAZCO";"S";"0113";"   HJOU_SJRJOUR1 = HJOU_SJRJOUR1 + 1"
"SRAZCO";"S";"0114";"   SI HJOU_SJRJOUR1 = 1"
"SRAZCO";"S";"0115";"      HJOU_SJQDEBC = 1"
"SRAZCO";"S";"0116";"   FINSI"
"SRAZCO";"S";"0117";"SINON"
"SRAZCO";"S";"0118";"   SI HJOU_SJRJOUR1 = 0"
"SRAZCO";"S";"0119";"      SI HJOU_DATE(5:4) = ""0101"""
"SRAZCO";"S";"0120";"         HJOU_SJRJOUR1 = HJOU_SJRJOUR1 + 1"
"SRAZCO";"S";"0121";"      FINSI"
"SRAZCO";"S";"0122";"   FINSI"
"SRAZCO";"S";"0123";"FINSI"
"SRAZCO";"S";"0124";"*"
"SRAZCO";"S";"0125";"SI HJOU_DATE = CTRA_DATFIN"
"SRAZCO";"S";"0126";"   SI TEMP_DATCTRSUI <> TEMP_DATSUI"
"SRAZCO";"S";"0127";"      HJOU_SJQFINC = 1"
"SRAZCO";"S";"0128";"* RAZ du jour de contrat"
"SRAZCO";"S";"0129";"      HJOU_SJRJOUR1 = 0"
"SRAZCO";"S";"0130";"   FINSI"
"SRAZCO";"S";"0131";"FINSI"
"SRAZCO";"S";"0132";"*"
"SRAZCO";"S";"0133";"SI HJOU_INSALA = ""1"""
"SRAZCO";"S";"0134";"   HJOU_SJQINSALA = ""1"""
"SRAZCO";"S";"0135";"* STC ?"
"SRAZCO";"S";"0136";"*   SI HJOU_DATE = CTRA_SCIDATSTC"
"SRAZCO";"S";"0137";"*      SI CTRA_SCIDATSTC = CTRA_DATFIN"
"SRAZCO";"S";"0138";"*"
"SRAZCO";"S";"0139";"* JJA - 15/07/2025 - On met à jour tout les contrats passés >>"
"SRAZCO";"S";"0140";"   POUR PERIODES"
"SRAZCO";"S";"0141";"      SI CTRA_SCIDATSTC <> "" """
"SRAZCO";"S";"0142";"         LOCA_DATSTC = CTRA_SCIDATSTC"
"SRAZCO";"S";"0143";"      FINSI"
"SRAZCO";"S";"0144";"   FINPOUR"
"SRAZCO";"S";"0145";"*"
"SRAZCO";"S";"0146";"   SI HJOU_DATE <= LOCA_DATSTC"
"SRAZCO";"S";"0147";"      HJOU_SJQINSTC = ""1"""
"SRAZCO";"S";"0148";"      HJOU_SJQINSALA = ""0"""
"SRAZCO";"S";"0149";"   FINSI"
"SRAZCO";"S";"0150";"* JJA - 15/07/2025 <<"
"SRAZCO";"S";"0151";"*"
"SRAZCO";"S";"0152";"*      FINSI"
"SRAZCO";"S";"0153";"*   FINSI"
"SRAZCO";"S";"0154";"SINON"
"SRAZCO";"S";"0155";"   HJOU_SJQINSTC = ""0"""
"SRAZCO";"S";"0156";"   HJOU_SJQINSALA = ""0"""
"SRAZCO";"S";"0157";"FINSI"
"SRAZCO";"S";"0158";"*"
"SRAZCO";"S";"0159";"SI HJOU_SECTORI(1:3) <> ""DIN"""
"SRAZCO";"S";"0160";"   SI HJOU_SECTORI(1:3) <> ""DRE"""
"SRAZCO";"S";"0161";"      SI HJOU_SECTORI(1:3) <> ""RED"""
"SRAZCO";"S";"0162";"         SI HJOU_SECTORI(1:3) <> ""TVR"""
"SRAZCO";"S";"0163";"*            HJOU_SJQINSTC = ""0"""
"SRAZCO";"S";"0164";"*            HJOU_SJQINSALA = ""0"""
"SRAZCO";"S";"0165";"         FINSI"
"SRAZCO";"S";"0166";"      FINSI"
"SRAZCO";"S";"0167";"   FINSI"
"SRAZCO";"S";"0168";"FINSI"
"SRAZCO";"S";"0169";"*"
"SRAZCO";"S";"0170";"SI CTRA_TYPCTRA = ""STG"""
"SRAZCO";"S";"0171";"   HJOU_SJQINSTC = ""0"""
"SRAZCO";"S";"0172";"   HJOU_SJQINSALA = ""0"""
"SRAZCO";"S";"0173";"FINSI"
