"ISTATI";"S";"0021";"*----------------------------------------------------------------------"
"ISTATI";"S";"0022";"*"
"ISTATI";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"ISTATI";"S";"0024";"* Date         : JJ/MM/AAAA"
"ISTATI";"S";"0025";"* Objet        :"
"ISTATI";"S";"0026";"*"
"ISTATI";"S";"0027";"***********************************************************************"
"ISTATI";"S";"0028";"*"
"ISTATI";"S";"0029";"* Implémentation des données industrielles"
"ISTATI";"S";"0030";"*"
"ISTATI";"S";"0031";"DEBDICO"
"ISTATI";"S";"0032";"   HJOU_IJRNNUITRA;N;N5,1;I;;;    56789;;IJRNNUITRA;V3;""Nbre de nuits travaillées annuel"";"
"ISTATI";"S";"0033";"   HJOU_IJRNSAMTRA;N;N5,1;I;;;    56789;;IJRNSAMTRA;V3;""Nbre de samedi travaillés annuel"";"
"ISTATI";"S";"0034";"   HJOU_IJRNDIMTRA;N;N5,1;I;;;    56789;;IJRNDIMTRA;V3;""Nbre de dimanche travaillés annuel"";"
"ISTATI";"S";"0035";"   HJOU_IJRNJFETRA;N;N5,1;I;;;    56789;;IJRNJFETRA;V3;""Nbre de fériés travaillés annuel"";"
"ISTATI";"S";"0036";"   *   HJOU_IJQETTEPRT;N;T8,2;L;;;    56789;;;V3;""Ecart TTE / présence théorique"";"
"ISTATI";"S";"0037";"   HJOU_IJRDJDISP1;N;N6,2;L;;;    56789;;IJRDJDISP1;V3;""Dimanche travaillé (J)"";"
"ISTATI";"S";"0038";"FINDICO"
"ISTATI";"S";"0039";"*"
"ISTATI";"S";"0040";"* Déclaration des donnees locales"
"ISTATI";"S";"0041";"DEF LOCA_IJQTTEFFEJ T6.2"
"ISTATI";"S";"0042";"LOCA_IJQTTEFFEJ = 0.00"
"ISTATI";"S";"0043";"DEF LOCA_HORNUIT N2"
"ISTATI";"S";"0044";"LOCA_HORNUIT = 0"
"ISTATI";"S";"0045";"DEF LOCA_CALC N2"
"ISTATI";"S";"0046";"LOCA_CALC = 0"
"ISTATI";"S";"0047";"*"
"ISTATI";"S";"0048";"SI HJOU_JOUR = ""1"""
"ISTATI";"S";"0049";"OU HJOU_SJQDEBC = 1"
"ISTATI";"S";"0050";"   HJOU_IJRDJDISP1 = 0"
"ISTATI";"S";"0051";"FINSI"
"ISTATI";"S";"0052";"*"
"ISTATI";"S";"0053";"* Travaille sur horaire de nuit ?"
"ISTATI";"S";"0054";"SI HJOU_SJQHTSOR1 > 24.00"
"ISTATI";"S";"0055";"OU HJOU_SJQHTSOR2 > 24.00"
"ISTATI";"S";"0056";"OU HJOU_SJQHTSOR3 > 24.00"
"ISTATI";"S";"0057";"OU HJOU_SJQHTSOR4 > 24.00"
"ISTATI";"S";"0058";"OU HJOU_SJQHTSOR5 > 24.00"
"ISTATI";"S";"0059";"   LOCA_HORNUIT = 1"
"ISTATI";"S";"0060";"FINSI"
"ISTATI";"S";"0061";"*"
"ISTATI";"S";"0062";"SI TEMP_DATSUI <= HJOU_DATE"
"ISTATI";"S";"0063";"   LOCA_IJQTTEFFEJ = HJOU_IJQTTEFFEJ"
"ISTATI";"S";"0064";"SINON"
"ISTATI";"S";"0065";"   LOCA_IJQTTEFFEJ = HJOU_IJQPRETHEJ"
"ISTATI";"S";"0066";"FINSI"
"ISTATI";"S";"0067";"*"
"ISTATI";"S";"0068";"*---------------------------------------------------------------"
"ISTATI";"S";"0069";"*          STATISTIQUES                                        *"
"ISTATI";"S";"0070";"*---------------------------------------------------------------"
"ISTATI";"S";"0071";"** raz des compteurs au 01/01 ou en debut d'annualisation"
"ISTATI";"S";"0072";"SI PARD_IDIDDEBANN <> "" """
"ISTATI";"S";"0073";"   SI HJOU_DATE = PARD_IDIDDEBANN"
"ISTATI";"S";"0074";"      HJOU_IJRNNUITRA = 0"
"ISTATI";"S";"0075";"      HJOU_IJRNSAMTRA = 0"
"ISTATI";"S";"0076";"      HJOU_IJRNDIMTRA = 0"
"ISTATI";"S";"0077";"      HJOU_IJRNJFETRA = 0"
"ISTATI";"S";"0078";"   FINSI"
"ISTATI";"S";"0079";"SINON"
"ISTATI";"S";"0080";"   SI HJOU_DATE(5:4) = ""0101"""
"ISTATI";"S";"0081";"      HJOU_IJRNNUITRA = 0"
"ISTATI";"S";"0082";"      HJOU_IJRNSAMTRA = 0"
"ISTATI";"S";"0083";"      HJOU_IJRNDIMTRA = 0"
"ISTATI";"S";"0084";"      HJOU_IJRNJFETRA = 0"
"ISTATI";"S";"0085";"   FINSI"
"ISTATI";"S";"0086";"FINSI"
"ISTATI";"S";"0087";"* nombre de nuits travailles"
"ISTATI";"S";"0088";"SI HJOU_IJQHNUITTO > 0"
"ISTATI";"S";"0089";"   HJOU_IJRNNUITRA = HJOU_IJRNNUITRA + 1"
"ISTATI";"S";"0090";"FINSI"
"ISTATI";"S";"0091";"* nombre de samedi travailles"
"ISTATI";"S";"0092";"SI HJOU_JOUR = ""6"""
"ISTATI";"S";"0093";"   SI HJOU_IJQTTEFFEJ > 0.02"
"ISTATI";"S";"0094";"      HJOU_IJRNSAMTRA = HJOU_IJRNSAMTRA + 1"
"ISTATI";"S";"0095";"   FINSI"
"ISTATI";"S";"0096";"FINSI"
"ISTATI";"S";"0097";"* nombre de dimanche travailles"
"ISTATI";"S";"0098";"*"
"ISTATI";"S";"0099";"* JJA - 17/10/2025 - FFT025007196 : Ajustement pour industrie, dimanche travaillé à fin de poste >>"
"ISTATI";"S";"0100";"SI LOCA_CALC <> 1"
"ISTATI";"S";"0101";"   SI HJOU_SECTORI(1:3) = ""DIN"""
"ISTATI";"S";"0102";"      SI HJOU_SJQSOCIETE = ""MO"""
"ISTATI";"S";"0103";"         LOCA_CALC = 1"
"ISTATI";"S";"0104";"*"
"ISTATI";"S";"0105";"         SI LOCA_IJQTTEFFEJ > 0.02"
"ISTATI";"S";"0106";"* Samedi de nuit ?"
"ISTATI";"S";"0107";"            SI HJOU_JOUR = ""6"""
"ISTATI";"S";"0108";"               SI LOCA_HORNUIT = 1"
"ISTATI";"S";"0109";"                  HJOU_IJRDJDISP1 = HJOU_IJRDJDISP1 + 1"
"ISTATI";"S";"0110";"               FINSI"
"ISTATI";"S";"0111";"            FINSI"
"ISTATI";"S";"0112";"* Dimanche de nuit ?"
"ISTATI";"S";"0113";"            SI HJOU_JOUR = ""7"""
"ISTATI";"S";"0114";"               SI HJOU_IJRDJDISP1 = 0"
"ISTATI";"S";"0115";"                  SI LOCA_HORNUIT <> 1"
"ISTATI";"S";"0116";"                     HJOU_IJRDJDISP1 = 1"
"ISTATI";"S";"0117";"                  FINSI"
"ISTATI";"S";"0118";"               FINSI"
"ISTATI";"S";"0119";"            FINSI"
"ISTATI";"S";"0120";"         FINSI"
"ISTATI";"S";"0121";"*"
"ISTATI";"S";"0122";"         SI HJOU_JOUR = ""7"""
"ISTATI";"S";"0123";"            SI HJOU_IJRDJDISP1 > 1"
"ISTATI";"S";"0124";"               HJOU_IJRDJDISP1 = 1"
"ISTATI";"S";"0125";"            FINSI"
"ISTATI";"S";"0126";"            HJOU_IJRNDIMTRA = HJOU_IJRNDIMTRA + HJOU_IJRDJDISP1"
"ISTATI";"S";"0127";"         FINSI"
"ISTATI";"S";"0128";"*"
"ISTATI";"S";"0129";"      FINSI"
"ISTATI";"S";"0130";"   FINSI"
"ISTATI";"S";"0131";"FINSI"
"ISTATI";"S";"0132";"* JJA - 17/10/2025 - FFT025007196 <<"
"ISTATI";"S";"0133";"*"
"ISTATI";"S";"0134";"SI LOCA_CALC <> 1"
"ISTATI";"S";"0135";"   SI HJOU_JOUR = ""7"""
"ISTATI";"S";"0136";"      LOCA_CALC = 1"
"ISTATI";"S";"0137";"      SI LOCA_IJQTTEFFEJ > 0.02"
"ISTATI";"S";"0138";"         HJOU_IJRDJDISP1 = 1"
"ISTATI";"S";"0139";"         HJOU_IJRNDIMTRA = HJOU_IJRNDIMTRA + HJOU_IJRDJDISP1"
"ISTATI";"S";"0140";"      FINSI"
"ISTATI";"S";"0141";"   FINSI"
"ISTATI";"S";"0142";"FINSI"
"ISTATI";"S";"0143";"*"
"ISTATI";"S";"0144";"* nombre de jours feries travailles"
"ISTATI";"S";"0145";"SI HJOU_IJQHJFTRAV > 0.02"
"ISTATI";"S";"0146";"   HJOU_IJRNJFETRA = HJOU_IJRNJFETRA + 1"
"ISTATI";"S";"0147";"FINSI"
"ISTATI";"S";"0148";"*"
"ISTATI";"S";"0149";"* consignes d'initialisation"
"ISTATI";"S";"0150";"POUR ACTIVITES"
"ISTATI";"S";"0151";"   SI HABS_MOTIF = ""ZNBN"""
"ISTATI";"S";"0152";"      HJOU_IJRNNUITRA = HABS_MOTINBR"
"ISTATI";"S";"0153";"   FINSI"
"ISTATI";"S";"0154";"   SI HABS_MOTIF = ""ZNBS"""
"ISTATI";"S";"0155";"      HJOU_IJRNSAMTRA = HABS_MOTINBR"
"ISTATI";"S";"0156";"   FINSI"
"ISTATI";"S";"0157";"   SI HABS_MOTIF = ""ZNBD"""
"ISTATI";"S";"0158";"      HJOU_IJRNDIMTRA = HABS_MOTINBR"
"ISTATI";"S";"0159";"   FINSI"
"ISTATI";"S";"0160";"   SI HABS_MOTIF = ""ZNBF"""
"ISTATI";"S";"0161";"      HJOU_IJRNJFETRA = HABS_MOTINBR"
"ISTATI";"S";"0162";"   FINSI"
"ISTATI";"S";"0163";"FINPOUR"
"ISTATI";"S";"0164";"*"
"ISTATI";"S";"0165";"*---------------------------------------------------------------"
"ISTATI";"S";"0166";"*          COMPTEUR EXPLORER                                   *"
"ISTATI";"S";"0167";"*---------------------------------------------------------------"
"ISTATI";"S";"0168";"*"
"ISTATI";"S";"0169";"* Calcul de l'écart heures effectives/théorie"
"ISTATI";"S";"0170";"* selon le type de traitement"
"ISTATI";"S";"0171";"*"
"ISTATI";"S";"0172";"* Traitement fin de semaine Type 1"
"ISTATI";"S";"0173";"*"
"ISTATI";"S";"0174";"SI HJOU_DATE <= TEMP_DATJOU"
"ISTATI";"S";"0175";"   SI HJOU_IJIGCDTYPP = ""1"""
"ISTATI";"S";"0176";"      SI HJOU_JOUR = ""7"""
"ISTATI";"S";"0177";"*         HJOU_IJQETTEPRT = HJOU_IJRTTEFFEH - HJOU_IJRPRETHEH"
"ISTATI";"S";"0178";"      FINSI"
"ISTATI";"S";"0179";"   FINSI"
"ISTATI";"S";"0180";"*"
"ISTATI";"S";"0181";"* Traitement fin de mois Type 2"
"ISTATI";"S";"0182";"*"
"ISTATI";"S";"0183";"   SI HJOU_IJIGCDTYPP = ""2"""
"ISTATI";"S";"0184";"      SI TEMP_DATSUI(7:2) = ""01"""
"ISTATI";"S";"0185";"*         HJOU_IJQETTEPRT = HJOU_IJRTTEFFEM - HJOU_IJRPRETHEM"
"ISTATI";"S";"0186";"      FINSI"
"ISTATI";"S";"0187";"   FINSI"
"ISTATI";"S";"0188";"*"
"ISTATI";"S";"0189";"* Traitement sur calendrier type 3"
"ISTATI";"S";"0190";"*"
"ISTATI";"S";"0191";"   SI HJOU_IJIGCDTYPP = ""3"""
"ISTATI";"S";"0192";"      POUR ACTIVITES"
"ISTATI";"S";"0193";"         SI HABS_MOTIF = ""FINP"""
"ISTATI";"S";"0194";"*            HJOU_IJQETTEPRT = HJOU_IJRTTEFFEM - HJOU_IJRPRETHEM"
"ISTATI";"S";"0195";"         FINSI"
"ISTATI";"S";"0196";"      FINPOUR"
"ISTATI";"S";"0197";"   FINSI"
"ISTATI";"S";"0198";"*"
"ISTATI";"S";"0199";"* Traitement mixte"
"ISTATI";"S";"0200";"*"
"ISTATI";"S";"0201";"   SI HJOU_IJIGCDTYPP = ""5"""
"ISTATI";"S";"0202";"      SI HJOU_JOUR = ""7"""
"ISTATI";"S";"0203";"         SI TEMP_DATSUI(7:2) <> ""01"""
"ISTATI";"S";"0204";"*            HJOU_IJQETTEPRT = HJOU_IJRTTEFFEH - HJOU_IJRPRETHEH"
"ISTATI";"S";"0205";"         FINSI"
"ISTATI";"S";"0206";"      FINSI"
"ISTATI";"S";"0207";"      SI TEMP_DATSUI(7:2) = ""01"""
"ISTATI";"S";"0208";"*         HJOU_IJQETTEPRT = HJOU_IJRTTEFFEM - HJOU_IJRPRETHEM"
"ISTATI";"S";"0209";"      FINSI"
"ISTATI";"S";"0210";"   FINSI"
"ISTATI";"S";"0211";"FINSI"
"ISTATI";"S";"0212";"FIN"
"ISUPAC";"S";"0001";"***********************************************************************"
"ISUPAC";"S";"0002";"*"
"ISUPAC";"S";"0003";"* Règle : ISUPAC"
"ISUPAC";"S";"0004";"* Ordre : 3170"
"ISUPAC";"S";"0005";"* Titre : Suppression d'un motif si badgeage"
"ISUPAC";"S";"0006";"*"
"ISUPAC";"S";"0007";"*----------------------------------------------------------------------"
"ISUPAC";"S";"0008";"*"
"ISUPAC";"S";"0009";"* Créé par : Cellule Industrialisation"
"ISUPAC";"S";"0010";"* Date     : 03/09/2009"
"ISUPAC";"S";"0011";"* Version  : 1"
"ISUPAC";"S";"0012";"*"
"ISUPAC";"S";"0013";"*----------------------------------------------------------------------"
"ISUPAC";"S";"0014";"*"
"ISUPAC";"S";"0015";"*"
"ISUPAC";"S";"0016";"* Rôle : Suppression d'un motif si badgeage"
"ISUPAC";"S";"0017";"*"
"ISUPAC";"S";"0018";"*"
"ISUPAC";"S";"0019";"*"
"ISUPAC";"S";"0020";"*"
"ISUPAC";"S";"0021";"*----------------------------------------------------------------------"
"ISUPAC";"S";"0022";"*"
"ISUPAC";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"ISUPAC";"S";"0024";"* Date         : JJ/MM/AAAA"
"ISUPAC";"S";"0025";"* Objet        :"
"ISUPAC";"S";"0026";"*"
"ISUPAC";"S";"0027";"***********************************************************************"
"ISUPAC";"S";"0028";"*"
"ISUPAC";"S";"0029";"* Modifiée par : Méthodes et outils"
"ISUPAC";"S";"0030";"* Date         : 21/05/2019"
"ISUPAC";"S";"0031";"* Objet        : Ajout du test MOTI_TYPMAT = "" "" pour le déclenchement"
"ISUPAC";"S";"0032";"*                 de l'anomalie 123 car il ne faut pas déclencher cette anomalie"
"ISUPAC";"S";"0033";"*                 en cas de pose de motif de type ""arrêt"""
"ISUPAC";"S";"0034";"*"
"ISUPAC";"S";"0035";"***********************************************************************"
"ISUPAC";"S";"0036";"*"
"ISUPAC";"S";"0037";"* Implémentation des données industrielles"
"ISUPAC";"S";"0038";"*"
"ISUPAC";"S";"0039";"DEBDICO"
"ISUPAC";"S";"0040";"   HJOU_IJQNACTIVJ;N;N2;I;;;    56789;;;V3;""Nombre d activités"";"
"ISUPAC";"S";"0041";"   HJOU_IJQNABSEN1;N;N2;I;;;    56789;;;V3;""Nombre d absences matin"";"
"ISUPAC";"S";"0042";"   HJOU_IJQNABSEN2;N;N2;I;;;    56789;;;V3;""Nombre d absences après-midi"";"
"ISUPAC";"S";"0043";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"ISUPAC";"S";"0044";"FINDICO"
"ISUPAC";"S";"0045";"*"
"ISUPAC";"S";"0046";"DEBANO"
"ISUPAC";"S";"0047";"   123;5;""Suppression d'un motif d'absence car badgeages"";"
"ISUPAC";"S";"0048";"FINANO"
"ISUPAC";"S";"0049";"* Déclaration des donnees locales"
"ISUPAC";"S";"0050";"*"
"ISUPAC";"S";"0051";"DEF LOCA_MOTIFJ A10"
"ISUPAC";"S";"0052";"LOCA_MOTIFJ = "" """
"ISUPAC";"S";"0053";"DEF LOCA_MOTIFM A10"
"ISUPAC";"S";"0054";"LOCA_MOTIFM = "" """
"ISUPAC";"S";"0055";"DEF LOCA_MOTIFA A10"
"ISUPAC";"S";"0056";"LOCA_MOTIFA = "" """
"ISUPAC";"S";"0057";"DEF LOCA_ABSH T6.2"
"ISUPAC";"S";"0058";"LOCA_ABSH = 0"
"ISUPAC";"S";"0059";"DEF LOCA_SEUIL T6.2"
"ISUPAC";"S";"0060";"LOCA_SEUIL = 0"
"ISUPAC";"S";"0061";"*"
"ISUPAC";"S";"0062";"*"
"ISUPAC";"S";"0063";"POUR ACTIVITES"
"ISUPAC";"S";"0064";"   SI HABS_MOTYPE <> ""C"""
"ISUPAC";"S";"0065";"      SI HABS_VALORIS = ""H"""
"ISUPAC";"S";"0066";"         LOCA_ABSH = LOCA_ABSH + HABS_MOTIDUR"
"ISUPAC";"S";"0067";"      FINSI"
"ISUPAC";"S";"0068";"      SI HABS_VALORIS = ""J"""
"ISUPAC";"S";"0069";"         HJOU_IJQNACTIVJ = HJOU_IJQNACTIVJ + 1"
"ISUPAC";"S";"0070";"      FINSI"
"ISUPAC";"S";"0071";"      SI HABS_VALORIS = ""M"""
"ISUPAC";"S";"0072";"         HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"ISUPAC";"S";"0073";"      FINSI"
"ISUPAC";"S";"0074";"      SI HABS_VALORIS = ""A"""
"ISUPAC";"S";"0075";"         HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"ISUPAC";"S";"0076";"      FINSI"
"ISUPAC";"S";"0077";"   FINSI"
"ISUPAC";"S";"0078";"FINPOUR"
"ISUPAC";"S";"0079";"SI HJOU_IJQNBADGEA = 0"
"ISUPAC";"S";"0080";"   SI LOCA_ABSH > 0"
"ISUPAC";"S";"0081";"* le 03/10/2012"
"ISUPAC";"S";"0082";"* pas de déclenchement d'anomalie 125/126"
"ISUPAC";"S";"0083";"* si le total des motifs en heure > (theorie/2) +2"
"ISUPAC";"S";"0084";"      LOCA_SEUIL = HJOU_IJQPRETHEJ / 2"
"ISUPAC";"S";"0085";"      LOCA_SEUIL = LOCA_SEUIL + 2"
"ISUPAC";"S";"0086";"      SI LOCA_ABSH >= LOCA_SEUIL"
"ISUPAC";"S";"0087";"* cas ou on a un motif matin"
"ISUPAC";"S";"0088";"         SI HJOU_IJQNABSEN1 > 0"
"ISUPAC";"S";"0089";"            HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"ISUPAC";"S";"0090";"         SINON"
"ISUPAC";"S";"0091";"* cas ou on a un motif apres-midi"
"ISUPAC";"S";"0092";"            SI HJOU_IJQNABSEN2 > 0"
"ISUPAC";"S";"0093";"               HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"ISUPAC";"S";"0094";"* aucun motif matin ou apres-midi"
"ISUPAC";"S";"0095";"* on considere qu'il est absent la journée"
"ISUPAC";"S";"0096";"            SINON"
"ISUPAC";"S";"0097";"               HJOU_IJQNACTIVJ = HJOU_IJQNACTIVJ + 1"
"ISUPAC";"S";"0098";"            FINSI"
"ISUPAC";"S";"0099";"         FINSI"
"ISUPAC";"S";"0100";"      SINON"
"ISUPAC";"S";"0101";"* cas ou le total des motifs en heure < (théorie/2) + 2"
"ISUPAC";"S";"0102";"         SI HJOU_IJQNABSEN1 > 0"
"ISUPAC";"S";"0103";"            HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"ISUPAC";"S";"0104";"         SINON"
"ISUPAC";"S";"0105";"            SI HJOU_IJQNABSEN2 > 0"
"ISUPAC";"S";"0106";"               HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"ISUPAC";"S";"0107";"            SINON"
"ISUPAC";"S";"0108";"* cas ou on a aucun motif matin ou apres-midi"
"ISUPAC";"S";"0109";"               HJOU_IJQNABSEN1 = 50"
"ISUPAC";"S";"0110";"               HJOU_IJQNABSEN2 = 50"
"ISUPAC";"S";"0111";"            FINSI"
"ISUPAC";"S";"0112";"         FINSI"
"ISUPAC";"S";"0113";"      FINSI"
"ISUPAC";"S";"0114";"   FINSI"
"ISUPAC";"S";"0115";"FINSI"
"ISUPAC";"S";"0116";"SI LOCA_ABSH > 0"
"ISUPAC";"S";"0117";"   SI HJOU_IJQPRESBA1 = 1"
"ISUPAC";"S";"0118";"      SI HJOU_IJQPRESBA2 = 0"
"ISUPAC";"S";"0119";"         SI HJOU_IJQNABSEN2 = 0"
"ISUPAC";"S";"0120";"            HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"ISUPAC";"S";"0121";"         FINSI"
"ISUPAC";"S";"0122";"      FINSI"
"ISUPAC";"S";"0123";"   FINSI"
"ISUPAC";"S";"0124";"   SI HJOU_IJQPRESBA2 = 1"
"ISUPAC";"S";"0125";"      SI HJOU_IJQPRESBA1 = 0"
"ISUPAC";"S";"0126";"         SI HJOU_IJQNABSEN1 = 0"
"ISUPAC";"S";"0127";"            HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"ISUPAC";"S";"0128";"         FINSI"
"ISUPAC";"S";"0129";"      FINSI"
"ISUPAC";"S";"0130";"   FINSI"
"ISUPAC";"S";"0131";"FINSI"
"ISUPAC";"S";"0132";"*"
"ISUPAC";"S";"0133";"*  Test si absence jour et badgeage"
"ISUPAC";"S";"0134";"*  Test du parametre suppression d'un motif car badgeage"
"ISUPAC";"S";"0135";"*  parametre pard_paretour"
"ISUPAC";"S";"0136";"POUR ACTIVITES"
"ISUPAC";"S";"0137";"   SI HABS_MOTYPE <> ""C"""
"ISUPAC";"S";"0138";"      SI PARD_IDIGPRIBAD = ""1"""
"ISUPAC";"S";"0139";"         SI HJOU_IJQNACTIVJ > 0"
"ISUPAC";"S";"0140";"            SI HJOU_IJQNBADGEA > 0"
"ISUPAC";"S";"0141";"               SI HABS_VALORIS = ""J"""
"ISUPAC";"S";"0142";"                  LOCA_MOTIFJ = HABS_MOTIF"
"ISUPAC";"S";"0143";"                  SI LOCA_MOTIFJ = ""JF"""
"ISUPAC";"S";"0144";"                     HABS_MOTIDUR = 0"
"ISUPAC";"S";"0145";"                  SINON"
"ISUPAC";"S";"0146";"                     SI MOTI_TYPMAT = "" """
"ISUPAC";"S";"0147";"                        ANOMALIE 123"
"ISUPAC";"S";"0148";"                     FINSI"
"ISUPAC";"S";"0149";"                  FINSI"
"ISUPAC";"S";"0150";"               FINSI"
"ISUPAC";"S";"0151";"            FINSI"
"ISUPAC";"S";"0152";"         FINSI"
"ISUPAC";"S";"0153";"*  Test si absence matin et badgeage"
"ISUPAC";"S";"0154";"         SI HJOU_IJQNABSEN1 >= 1"
"ISUPAC";"S";"0155";"            SI HJOU_IJQPRESBA1 = 1"
"ISUPAC";"S";"0156";"               SI HABS_VALORIS = ""M"""
"ISUPAC";"S";"0157";"                  LOCA_MOTIFM = HABS_MOTIF"
"ISUPAC";"S";"0158";"                  SI MOTI_TYPMAT = "" """
"ISUPAC";"S";"0159";"                     ANOMALIE 123"
"ISUPAC";"S";"0160";"                  FINSI"
"ISUPAC";"S";"0161";"               FINSI"
"ISUPAC";"S";"0162";"            FINSI"
"ISUPAC";"S";"0163";"         FINSI"
"ISUPAC";"S";"0164";"* Test si absence soir et badgeage"
"ISUPAC";"S";"0165";"         SI HJOU_IJQNABSEN2 >= 1"
"ISUPAC";"S";"0166";"            SI HJOU_IJQPRESBA2 = 1"
"ISUPAC";"S";"0167";"               SI HABS_VALORIS = ""A"""
"ISUPAC";"S";"0168";"                  LOCA_MOTIFA = HABS_MOTIF"
"ISUPAC";"S";"0169";"                  SI MOTI_TYPMAT = "" """
"ISUPAC";"S";"0170";"                     ANOMALIE 123"
"ISUPAC";"S";"0171";"                  FINSI"
"ISUPAC";"S";"0172";"               FINSI"
"ISUPAC";"S";"0173";"            FINSI"
"ISUPAC";"S";"0174";"         FINSI"
"ISUPAC";"S";"0175";"      FINSI"
"ISUPAC";"S";"0176";"   FINSI"
"ISUPAC";"S";"0177";"FINPOUR"
"ISUPAC";"S";"0178";"*  Retrait du motif d'absence jour"
"ISUPAC";"S";"0179";"SI LOCA_MOTIFJ <> "" """
"ISUPAC";"S";"0180";"   SI LOCA_MOTIFJ <> ""JF"""
"ISUPAC";"S";"0181";"      ENLEVER LOCA_MOTIFJ"
"ISUPAC";"S";"0182";"      HJOU_IJQNACTIVJ = HJOU_IJQNACTIVJ - 1"
"ISUPAC";"S";"0183";"   FINSI"
"ISUPAC";"S";"0184";"FINSI"
"ISUPAC";"S";"0185";"*  Retrait du motif d'absence matin"
"ISUPAC";"S";"0186";"SI LOCA_MOTIFM <> "" """
"ISUPAC";"S";"0187";"   ENLEVER LOCA_MOTIFM"
"ISUPAC";"S";"0188";"   HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 - 1"
"ISUPAC";"S";"0189";"FINSI"
"ISUPAC";"S";"0190";"*  Retrait du motif d'absence apr?s midi"
"ISUPAC";"S";"0191";"SI LOCA_MOTIFA <> "" """
"ISUPAC";"S";"0192";"   ENLEVER LOCA_MOTIFA"
"ISUPAC";"S";"0193";"   HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 - 1"
"ISUPAC";"S";"0194";"FINSI"
"ISUPAC";"S";"0195";"FIN"
"ITELETRAV";"S";"0001";"***********************************************************************"
