"ICONSCPCH";"S";"0953";"*  cp"
"ICONSCPCH";"S";"0954";"                  SI LOCA_CP > 0"
"ICONSCPCH";"S";"0955";"                     HABS_MOTIF = LOCA_PACPANNU"
"ICONSCPCH";"S";"0956";"                  FINSI"
"ICONSCPCH";"S";"0957";"*  anticipes"
"ICONSCPCH";"S";"0958";"                  SI LOCA_CPA > 0"
"ICONSCPCH";"S";"0959";"                     HABS_MOTIF = LOCA_PACPANTI"
"ICONSCPCH";"S";"0960";"                  FINSI"
"ICONSCPCH";"S";"0961";"               FINSI"
"ICONSCPCH";"S";"0962";"            FINPOUR"
"ICONSCPCH";"S";"0963";"         FINSI"
"ICONSCPCH";"S";"0964";"*  ANALYSE des consignes d'initialisation et MAJ"
"ICONSCPCH";"S";"0965";"         POUR ACTIVITES"
"ICONSCPCH";"S";"0966";"* consignes de MAJ"
"ICONSCPCH";"S";"0967";"            SI HABS_MOTIF = ""XCPA"""
"ICONSCPCH";"S";"0968";"               HJOU_IJRCCOANTI = HJOU_IJRCCOANTI + HABS_MOTINBR"
"ICONSCPCH";"S";"0969";"            FINSI"
"ICONSCPCH";"S";"0970";"            SI HABS_MOTIF = ""XCCA"""
"ICONSCPCH";"S";"0971";"               LOCA_ANCI = 1"
"ICONSCPCH";"S";"0972";"               LOCA_PRIS = HABS_MOTINBR + HJOU_IJRCCOANCI"
"ICONSCPCH";"S";"0973";"               LOCA_TRANS = LOCA_PRIS - HJOU_IJRCCOANCI"
"ICONSCPCH";"S";"0974";"*"
"ICONSCPCH";"S";"0975";"               HJOU_IJRCCOANCI = HJOU_IJRCCOANCI + HABS_MOTINBR"
"ICONSCPCH";"S";"0976";"               HJOU_IJRSCOANCI = HJOU_IJRSCOANCI - LOCA_TRANS"
"ICONSCPCH";"S";"0977";"            FINSI"
"ICONSCPCH";"S";"0978";"            SI HABS_MOTIF = ""XPACP"""
"ICONSCPCH";"S";"0979";"               LOCA_ACP = 1"
"ICONSCPCH";"S";"0980";"               HJOU_IJRPACQCP = HJOU_IJRPACQCP + HABS_MOTINBR"
"ICONSCPCH";"S";"0981";"               HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"ICONSCPCH";"S";"0982";"            FINSI"
"ICONSCPCH";"S";"0983";"* consignes d'initialisation"
"ICONSCPCH";"S";"0984";"            SI HABS_MOTIF = ""ZCPA"""
"ICONSCPCH";"S";"0985";"               HJOU_IJRCCOANTI = HABS_MOTINBR"
"ICONSCPCH";"S";"0986";"            FINSI"
"ICONSCPCH";"S";"0987";"            SI HABS_MOTIF = ""ZCCA"""
"ICONSCPCH";"S";"0988";"               LOCA_ANCI = 1"
"ICONSCPCH";"S";"0989";"               LOCA_TRANS = HABS_MOTINBR - HJOU_IJRCCOANCI"
"ICONSCPCH";"S";"0990";"*"
"ICONSCPCH";"S";"0991";"               HJOU_IJRCCOANCI = HABS_MOTINBR"
"ICONSCPCH";"S";"0992";"               HJOU_IJRSCOANCI = HJOU_IJRSCOANCI - LOCA_TRANS"
"ICONSCPCH";"S";"0993";"            FINSI"
"ICONSCPCH";"S";"0994";"            SI HABS_MOTIF = ""ZPACP"""
"ICONSCPCH";"S";"0995";"               LOCA_ACP = 1"
"ICONSCPCH";"S";"0996";"               HJOU_IJRPACQCP = HABS_MOTINBR"
"ICONSCPCH";"S";"0997";"               HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"ICONSCPCH";"S";"0998";"            FINSI"
"ICONSCPCH";"S";"0999";"* Gestion des consignes CP"
"ICONSCPCH";"S";"1000";"            SI HORC_IHIDRNTRAV = 0"
"ICONSCPCH";"S";"1001";"               SI HABS_MOTIF = ""XCCP"""
"ICONSCPCH";"S";"1002";"                  LOCA_CPMOT = 1"
"ICONSCPCH";"S";"1003";"                  LOCA_PRIS = HABS_MOTINBR + HJOU_IJRCCOPRIN"
"ICONSCPCH";"S";"1004";"                  LOCA_TRANS = LOCA_PRIS - HJOU_IJRCCOPRIN"
"ICONSCPCH";"S";"1005";"*"
"ICONSCPCH";"S";"1006";"                  HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + HABS_MOTINBR"
"ICONSCPCH";"S";"1007";"                  HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_TRANS"
"ICONSCPCH";"S";"1008";"               FINSI"
"ICONSCPCH";"S";"1009";"               SI HABS_MOTIF = ""ZCCP"""
"ICONSCPCH";"S";"1010";"                  LOCA_CPMOT = 1"
"ICONSCPCH";"S";"1011";"                  LOCA_TRANS = HABS_MOTINBR - HJOU_IJRCCOPRIN"
"ICONSCPCH";"S";"1012";"*"
"ICONSCPCH";"S";"1013";"                  HJOU_IJRCCOPRIN = HABS_MOTINBR"
"ICONSCPCH";"S";"1014";"                  HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_TRANS"
"ICONSCPCH";"S";"1015";"               FINSI"
"ICONSCPCH";"S";"1016";"            SINON"
"ICONSCPCH";"S";"1017";"* Consignes CP travaillé"
"ICONSCPCH";"S";"1018";"               SI HABS_MOTIF = ""XCCPT"""
"ICONSCPCH";"S";"1019";"                  LOCA_CPMOT = 1"
"ICONSCPCH";"S";"1020";"                  LOCA_PRIS = HABS_MOTINBR + HJOU_IJRCCPTRA"
"ICONSCPCH";"S";"1021";"                  LOCA_TRANS = LOCA_PRIS - HJOU_IJRCCPTRA"
"ICONSCPCH";"S";"1022";"*"
"ICONSCPCH";"S";"1023";"                  HJOU_IJRCCPTRA = HJOU_IJRCCPTRA + HABS_MOTINBR"
"ICONSCPCH";"S";"1024";"                  HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - LOCA_TRANS"
"ICONSCPCH";"S";"1025";"* Recalcul des compteurs congé payé"
"ICONSCPCH";"S";"1026";"                  HJOU_IJRCCOPRIN = HJOU_IJRCCPTRA + HJOU_IJRCCPNTRA"
"ICONSCPCH";"S";"1027";"                  HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_TRANS"
"ICONSCPCH";"S";"1028";"               FINSI"
"ICONSCPCH";"S";"1029";"               SI HABS_MOTIF = ""ZCCPT"""
"ICONSCPCH";"S";"1030";"                  LOCA_CPMOT = 1"
"ICONSCPCH";"S";"1031";"                  LOCA_TRANS = HABS_MOTINBR - HJOU_IJRCCPTRA"
"ICONSCPCH";"S";"1032";"*"
"ICONSCPCH";"S";"1033";"                  HJOU_IJRCCPTRA = HABS_MOTINBR"
"ICONSCPCH";"S";"1034";"                  HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - LOCA_TRANS"
"ICONSCPCH";"S";"1035";"* Recalcul des compteurs congé payé"
"ICONSCPCH";"S";"1036";"                  HJOU_IJRCCOPRIN = HJOU_IJRCCPTRA + HJOU_IJRCCPNTRA"
"ICONSCPCH";"S";"1037";"                  HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_TRANS"
"ICONSCPCH";"S";"1038";"               FINSI"
"ICONSCPCH";"S";"1039";"* Consignes CP non travaillé"
"ICONSCPCH";"S";"1040";"               SI HABS_MOTIF = ""XCCPNT"""
"ICONSCPCH";"S";"1041";"                  HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + HABS_MOTINBR"
"ICONSCPCH";"S";"1042";"                  HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"ICONSCPCH";"S";"1043";"* Recalcul des compteurs congé payé"
"ICONSCPCH";"S";"1044";"                  HJOU_IJRCCOPRIN = HJOU_IJRCCPTRA + HJOU_IJRCCPNTRA"
"ICONSCPCH";"S";"1045";"                  HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"ICONSCPCH";"S";"1046";"               FINSI"
"ICONSCPCH";"S";"1047";"               SI HABS_MOTIF = ""ZCCPNT"""
"ICONSCPCH";"S";"1048";"                  HJOU_IJRCCPNTRA = HABS_MOTINBR"
"ICONSCPCH";"S";"1049";"                  HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"ICONSCPCH";"S";"1050";"* Recalcul des compteurs congé payé"
"ICONSCPCH";"S";"1051";"                  HJOU_IJRCCOPRIN = HJOU_IJRCCPTRA + HJOU_IJRCCPNTRA"
"ICONSCPCH";"S";"1052";"                  HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"ICONSCPCH";"S";"1053";"               FINSI"
"ICONSCPCH";"S";"1054";"            FINSI"
"ICONSCPCH";"S";"1055";"         FINPOUR"
"ICONSCPCH";"S";"1056";"*"
"ICONSCPCH";"S";"1057";"         SI LOCA_ANCI = 1"
"ICONSCPCH";"S";"1058";"            SI HJOU_IJRSCOANCI < 0"
"ICONSCPCH";"S";"1059";"               ANOMALIE 168"
"ICONSCPCH";"S";"1060";"            FINSI"
"ICONSCPCH";"S";"1061";"         FINSI"
"ICONSCPCH";"S";"1062";"*"
"ICONSCPCH";"S";"1063";"         SI LOCA_ACP = 1"
"ICONSCPCH";"S";"1064";"            SI HJOU_IJRSACQCP < 0"
"ICONSCPCH";"S";"1065";"               ANOMALIE 197"
"ICONSCPCH";"S";"1066";"            FINSI"
"ICONSCPCH";"S";"1067";"         FINSI"
"ICONSCPCH";"S";"1068";"*"
"ICONSCPCH";"S";"1069";"         SI LOCA_CPMOT = 1"
"ICONSCPCH";"S";"1070";"            SI HORC_IHIDRNTRAV = 0"
"ICONSCPCH";"S";"1071";"               SI HJOU_IJRSCOPRIN < 0"
"ICONSCPCH";"S";"1072";"                  ANOMALIE 198"
"ICONSCPCH";"S";"1073";"               FINSI"
"ICONSCPCH";"S";"1074";"            SINON"
"ICONSCPCH";"S";"1075";"               SI HJOU_IJRSCPTRA < 0"
"ICONSCPCH";"S";"1076";"                  ANOMALIE 198"
"ICONSCPCH";"S";"1077";"               FINSI"
"ICONSCPCH";"S";"1078";"            FINSI"
"ICONSCPCH";"S";"1079";"         FINSI"
"ICONSCPCH";"S";"1080";"*"
"ICONSCPCH";"S";"1081";"* CP samedi"
"ICONSCPCH";"S";"1082";"         SI PARD_IDINBRSAMD > 0"
"ICONSCPCH";"S";"1083";"            SI HJOU_JOUR = ""6"""
"ICONSCPCH";"S";"1084";"               POUR ACTIVITES"
"ICONSCPCH";"S";"1085";"                  SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"1086";"                  OU HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPCH";"S";"1087";"                  OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCPCH";"S";"1088";"                     SI HABS_VALORIS = ""J"""
"ICONSCPCH";"S";"1089";"                        LOCA_NBCPSAM = LOCA_NBCPSAM + 1"
"ICONSCPCH";"S";"1090";"                     FINSI"
"ICONSCPCH";"S";"1091";"*"
"ICONSCPCH";"S";"1092";"                     SI HABS_VALORIS = ""M"""
"ICONSCPCH";"S";"1093";"                        LOCA_NBCPSAM = LOCA_NBCPSAM + 0.5"
"ICONSCPCH";"S";"1094";"                     FINSI"
"ICONSCPCH";"S";"1095";"*"
"ICONSCPCH";"S";"1096";"                     SI HABS_VALORIS = ""A"""
"ICONSCPCH";"S";"1097";"                        LOCA_NBCPSAM = LOCA_NBCPSAM + 0.5"
"ICONSCPCH";"S";"1098";"                     FINSI"
"ICONSCPCH";"S";"1099";"                  FINSI"
"ICONSCPCH";"S";"1100";"               FINPOUR"
"ICONSCPCH";"S";"1101";"*"
"ICONSCPCH";"S";"1102";"               SI LOCA_NBCPSAM > 0"
"ICONSCPCH";"S";"1103";"                  SI LOCA_NBCPSAM > 1"
"ICONSCPCH";"S";"1104";"                     LOCA_NBCPSAM = 1"
"ICONSCPCH";"S";"1105";"                  FINSI"
"ICONSCPCH";"S";"1106";"*"
"ICONSCPCH";"S";"1107";"                  HJOU_IJRNBCPSAM = HJOU_IJRNBCPSAM + LOCA_NBCPSAM"
"ICONSCPCH";"S";"1108";"               FINSI"
"ICONSCPCH";"S";"1109";"            FINSI"
"ICONSCPCH";"S";"1110";"         FINSI"
"ICONSCPCH";"S";"1111";"** Initialisation du compteur de samedi CP par consigne"
"ICONSCPCH";"S";"1112";"         POUR ACTIVITES"
"ICONSCPCH";"S";"1113";"            SI HABS_MOTIF = ""ZCPSAM"""
"ICONSCPCH";"S";"1114";"               HJOU_IJRNBCPSAM = HABS_MOTINBR"
"ICONSCPCH";"S";"1115";"            FINSI"
"ICONSCPCH";"S";"1116";"            SI HABS_MOTIF = ""XCPSAM"""
"ICONSCPCH";"S";"1117";"               HJOU_IJRNBCPSAM = HJOU_IJRNBCPSAM + HABS_MOTINBR"
"ICONSCPCH";"S";"1118";"            FINSI"
"ICONSCPCH";"S";"1119";"         FINPOUR"
"ICONSCPCH";"S";"1120";"****************fin maintien des cp samedi ***********"
"ICONSCPCH";"S";"1121";"******************************************************"
"ICONSCPCH";"S";"1122";"      FINSI"
"ICONSCPCH";"S";"1123";"* le 30/12/2014"
"ICONSCPCH";"S";"1124";"*"
"ICONSCPCH";"S";"1125";"* SI HJOU_JOUR = ""7"""
"ICONSCPCH";"S";"1126";"* HJOU_IJRMAINTSA = 0"
"ICONSCPCH";"S";"1127";"* FINSI"
"ICONSCPCH";"S";"1128";"*"
"ICONSCPCH";"S";"1129";"** le 16/05/2011***************************************"
"ICONSCPCH";"S";"1130";"* si la date <= date du jour"
"ICONSCPCH";"S";"1131";"* dans le cas ou le chainage est fait avec le même motif"
"ICONSCPCH";"S";"1132";"* le motif reliquat est égal au motif CP"
"ICONSCPCH";"S";"1133";"* Dans le cas ou on a 2 motifs"
"ICONSCPCH";"S";"1134";"* de type conges 1/2 journée, ils sont transformés en"
"ICONSCPCH";"S";"1135";"* un motif de type  PARD_IDIVMCOPRI journée entiere"
"ICONSCPCH";"S";"1136";"*"
"ICONSCPCH";"S";"1137";"* SI LOCA_FUTUR = 0"
"ICONSCPCH";"S";"1138";"      LOCA_NBDEMI = 0"
"ICONSCPCH";"S";"1139";"      POUR ACTIVITES"
"ICONSCPCH";"S";"1140";"         SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPCH";"S";"1141";"            SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"1142";"               SI HABS_VALORIS <> ""J"""
"ICONSCPCH";"S";"1143";"                  LOCA_NBDEMI = LOCA_NBDEMI + 1"
"ICONSCPCH";"S";"1144";"               FINSI"
"ICONSCPCH";"S";"1145";"            FINSI"
"ICONSCPCH";"S";"1146";"         FINSI"
"ICONSCPCH";"S";"1147";"      FINPOUR"
"ICONSCPCH";"S";"1148";"      SI LOCA_NBDEMI = 2"
"ICONSCPCH";"S";"1149";"* cela veut dire qu'on se trouve avec 2 motifs"
"ICONSCPCH";"S";"1150";"* de type congés 1/2 journée"
"ICONSCPCH";"S";"1151";"* c'est normal que l'on fasse 2 fois un enlever"
"ICONSCPCH";"S";"1152";"* sur PACPANNU , c'est dans le cas ou on se retouve avec un"
"ICONSCPCH";"S";"1153";"* CP de type M et un CP de type A sur la même journée"
"ICONSCPCH";"S";"1154";"         ENLEVER PARD_IDIVMCOREL"
"ICONSCPCH";"S";"1155";"         ENLEVER PARD_IDIVMCOANC"
"ICONSCPCH";"S";"1156";"         ENLEVER PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"1157";"         ENLEVER PARD_IDIVMCOPRI"
"ICONSCPCH";"S";"1158";"         ENLEVER PARD_IDIVMCOANT"
"ICONSCPCH";"S";"1159";"* AJOUTER PARD_IDIVMCOPRI ""J"" PROF_ABSENJ"
"ICONSCPCH";"S";"1160";"         AJOUTER PARD_IDIVMCOPRI ""J"" LOCA_DUREEJ"
"ICONSCPCH";"S";"1161";"         LOCA_NBDEMI = 0"
"ICONSCPCH";"S";"1162";"      FINSI"
"ICONSCPCH";"S";"1163";"* FINSI"
"ICONSCPCH";"S";"1164";"*Pour ajouter les cp sur jour non travaillé"
"ICONSCPCH";"S";"1165";"* Maintenir le CP lorqu'il y a un CP"
"ICONSCPCH";"S";"1166";"* suivi d'un motif maintenant les congés"
"ICONSCPCH";"S";"1167";"* suivi d'un jour de repos"
"ICONSCPCH";"S";"1168";"      SI HJOU_IJRJRCONG <> 0"
"ICONSCPCH";"S";"1169";"*RAZ"
"ICONSCPCH";"S";"1170";"         HJOU_IJRJRCONG = 0"
"ICONSCPCH";"S";"1171";"      FINSI"
"ICONSCPCH";"S";"1172";"* Ouvrés"
"ICONSCPCH";"S";"1173";"      LOCA_ACQUIS = HORC_IHIDRJTRAV + HORC_IHIDRNTRAV"
"ICONSCPCH";"S";"1174";"      SI LOCA_ACQUIS = 2.08"
"ICONSCPCH";"S";"1175";"         LOCA_JOUR = ""5"""
"ICONSCPCH";"S";"1176";"      FINSI"
"ICONSCPCH";"S";"1177";"* Ouvrables"
"ICONSCPCH";"S";"1178";"      SI LOCA_ACQUIS = 2.50"
"ICONSCPCH";"S";"1179";"         LOCA_JOUR = ""6"""
"ICONSCPCH";"S";"1180";"      FINSI"
"ICONSCPCH";"S";"1181";"*Récupération si il y a un CP sur la journée"
"ICONSCPCH";"S";"1182";"* Uniquement jusqu'au dernier jour de la semaine"
"ICONSCPCH";"S";"1183";"      SI HJOU_JOUR < LOCA_JOUR"
"ICONSCPCH";"S";"1184";"         POUR ACTIVITES"
"ICONSCPCH";"S";"1185";"* Maintien motif CP"
"ICONSCPCH";"S";"1186";"            SI MOTI_IMICONTCPS = ""3"""
"ICONSCPCH";"S";"1187";"               SI HABS_VALORIS = ""J"""
"ICONSCPCH";"S";"1188";"                  SI PROF_ABSENS <> 0"
"ICONSCPCH";"S";"1189";"                     HJOU_IJRJRCONG = 1"
"ICONSCPCH";"S";"1190";"                  SINON"
"ICONSCPCH";"S";"1191";"* Cas où une personne ne travaille que le matin"
"ICONSCPCH";"S";"1192";"                     SI PROF_ABSENJ = PROF_ABSENM"
"ICONSCPCH";"S";"1193";"                        HJOU_IJRJRCONG = 1"
"ICONSCPCH";"S";"1194";"                     SINON"
"ICONSCPCH";"S";"1195";"                        SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPCH";"S";"1196";"                           HJOU_IJRJRCONG = 0"
"ICONSCPCH";"S";"1197";"                        SINON"
"ICONSCPCH";"S";"1198";"                           HJOU_IJRJRCONG = 1"
"ICONSCPCH";"S";"1199";"                        FINSI"
"ICONSCPCH";"S";"1200";"                     FINSI"
"ICONSCPCH";"S";"1201";"                  FINSI"
"ICONSCPCH";"S";"1202";"               SINON"
"ICONSCPCH";"S";"1203";"                  SI HABS_VALORIS = ""A"""
"ICONSCPCH";"S";"1204";"                     HJOU_IJRJRCONG = 1"
"ICONSCPCH";"S";"1205";"                  SINON"
"ICONSCPCH";"S";"1206";"                     SI HABS_VALORIS = ""M"""
"ICONSCPCH";"S";"1207";"                        HJOU_IJRJRCONG = 0"
"ICONSCPCH";"S";"1208";"                     FINSI"
"ICONSCPCH";"S";"1209";"                  FINSI"
"ICONSCPCH";"S";"1210";"               FINSI"
"ICONSCPCH";"S";"1211";"            FINSI"
"ICONSCPCH";"S";"1212";"         FINPOUR"
"ICONSCPCH";"S";"1213";"      FINSI"
"ICONSCPCH";"S";"1214";"* FINSI"
"ICONSCPCH";"S";"1215";"   FINSI"
"ICONSCPCH";"S";"1216";"   FIN"
"ICONSCPSCH";"S";"0001";"***********************************************************************"
