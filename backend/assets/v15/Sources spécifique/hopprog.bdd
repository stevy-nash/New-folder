"SGASTR";"S";"0515";"      SI HJOU_SECTORI <> ""REDMON140"""
"SGASTR";"S";"0516";"         ANOMALIE 313"
"SGASTR";"S";"0517";"      FINSI"
"SGASTR";"S";"0518";"   FINSI"
"SGASTR";"S";"0519";"*"
"SGASTR";"S";"0520";"FINSI"
