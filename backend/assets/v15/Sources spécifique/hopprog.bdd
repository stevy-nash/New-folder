"IGRTTJ";"S";"0087";"*"
"IGRTTJ";"S";"0088";"* RAZ au a la date de référence RTT ou en debut d'annualisation"
"IGRTTJ";"S";"0089";"*"
"IGRTTJ";"S";"0090";"SI HJOU_IJIGRETETR = ""2"""
"IGRTTJ";"S";"0091";"OU HJOU_IJIGRETETR = ""4"""
"IGRTTJ";"S";"0092";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IGRTTJ";"S";"0093";"*"
"IGRTTJ";"S";"0094";"   SI CONF_IGIREFRTT <> "" """
"IGRTTJ";"S";"0095";"      LOCA_REF << CONF_IGIREFRTT(1:2)"
"IGRTTJ";"S";"0096";"      LOCA_DATE(7:2) << LOCA_REF"
"IGRTTJ";"S";"0097";"      LOCA_REF << CONF_IGIREFRTT(3:2)"
"IGRTTJ";"S";"0098";"      LOCA_DATE(5:2) << LOCA_REF"
"IGRTTJ";"S";"0099";"   SINON"
"IGRTTJ";"S";"0100";"      LOCA_DATE = PARD_IDIDDEBANN"
"IGRTTJ";"S";"0101";"   FINSI"
"IGRTTJ";"S";"0102";"**"
"IGRTTJ";"S";"0103";"   LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IGRTTJ";"S";"0104";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IGRTTJ";"S";"0105";"*"
"IGRTTJ";"S";"0106";"   SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IGRTTJ";"S";"0107";"      LOCA_ACOURS = LOCA_ACOURS + 1"
"IGRTTJ";"S";"0108";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IGRTTJ";"S";"0109";"*"
"IGRTTJ";"S";"0110";"   FINSI"
"IGRTTJ";"S";"0111";"   LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IGRTTJ";"S";"0112";"   LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IGRTTJ";"S";"0113";"   LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IGRTTJ";"S";"0114";"   LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IGRTTJ";"S";"0115";"*"
"IGRTTJ";"S";"0116";"*"
"IGRTTJ";"S";"0117";"*"
"IGRTTJ";"S";"0118";"   SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IGRTTJ";"S";"0119";"      HJOU_IJRSNBHRTT = 0"
"IGRTTJ";"S";"0120";"      HJOU_IJRARTTJOU = 0"
"IGRTTJ";"S";"0121";"      HJOU_IJRCRTTJOU = 0"
"IGRTTJ";"S";"0122";"      HJOU_IJRSNBJRTT = 0"
"IGRTTJ";"S";"0123";"      HJOU_IJRNRTTJEM = 0"
"IGRTTJ";"S";"0124";"      HJOU_IJRTRRTCET = 0"
"IGRTTJ";"S";"0125";"      HJOU_IJRACRTTJM = 0"
"IGRTTJ";"S";"0126";"   FINSI"
"IGRTTJ";"S";"0127";"**Traitement des RTT en acquisition annuelle"
"IGRTTJ";"S";"0128";"   SI HJOU_IJIGRETETR = ""2"""
"IGRTTJ";"S";"0129";"      SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IGRTTJ";"S";"0130";"* Acquisition annuelle"
"IGRTTJ";"S";"0131";"         HJOU_IJRARTTJOU = PARD_IDISRPEP"
"IGRTTJ";"S";"0132";"      FINSI"
"IGRTTJ";"S";"0133";"   FINSI"
"IGRTTJ";"S";"0134";"** traitement des RTT en jour acquisition mensuelle"
"IGRTTJ";"S";"0135";"   SI HJOU_IJIGRETETR = ""4"""
"IGRTTJ";"S";"0136";"      SI HJOU_DATE(7:2) = ""01"""
"IGRTTJ";"S";"0137";"* Cumul de l'acquis mensuel"
"IGRTTJ";"S";"0138";"         HJOU_IJRACRTTJM = HJOU_IJRACRTTJM + HJOU_IJIACQRTTJ"
"IGRTTJ";"S";"0139";"*"
"IGRTTJ";"S";"0140";"* arrondi de l'acquis a l'entier supérieur"
"IGRTTJ";"S";"0141";"         LOCA_REST = HJOU_IJRACRTTJM % 1"
"IGRTTJ";"S";"0142";"         LOCA_ENTIER = HJOU_IJRACRTTJM - LOCA_REST"
"IGRTTJ";"S";"0143";"         SI LOCA_REST > 0"
"IGRTTJ";"S";"0144";"            LOCA_ENTIER = LOCA_ENTIER + 1"
"IGRTTJ";"S";"0145";"         FINSI"
"IGRTTJ";"S";"0146";"* alimentation du compteur de droit"
"IGRTTJ";"S";"0147";"         LOCA_TRANS = LOCA_ENTIER - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0148";"         HJOU_IJRARTTJOU = LOCA_ENTIER"
"IGRTTJ";"S";"0149";"*"
"IGRTTJ";"S";"0150";"         HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
"IGRTTJ";"S";"0151";"*"
"IGRTTJ";"S";"0152";"      FINSI"
"IGRTTJ";"S";"0153";"   FINSI"
"IGRTTJ";"S";"0154";"* traitement du motif RTT pris"
"IGRTTJ";"S";"0155";"   POUR ACTIVITES"
"IGRTTJ";"S";"0156";"      SI HABS_MOTIF = PARD_IDIVMRTTSA"
"IGRTTJ";"S";"0157";"      OU HABS_MOTIF = PARD_IDIVMRTTEM"
"IGRTTJ";"S";"0158";"         LOCA_MOTIF = HABS_MOTIF"
"IGRTTJ";"S";"0159";"         LOCA_MOT = 1"
"IGRTTJ";"S";"0160";"         SI HJOU_IJIGRETETR = ""2"""
"IGRTTJ";"S";"0161";"         OU HJOU_IJIGRETETR = ""4"""
"IGRTTJ";"S";"0162";"* La regle VALACT qui permet de supprimer un motif"
"IGRTTJ";"S";"0163";"* par rapport au type de jour O/S/D/F n'étant pas"
"IGRTTJ";"S";"0164";"* déroulée dans le futur on va tester la validité du motif"
"IGRTTJ";"S";"0165";"* avant d'effectuer le calcul des soldes"
"IGRTTJ";"S";"0166";"* pour que le solde prévisionnel soit juste"
"IGRTTJ";"S";"0167";"**********************************************"
"IGRTTJ";"S";"0168";"            LOCA_ENLEVER = 0"
"IGRTTJ";"S";"0169";"            LOCA_VALID = MOTI_VALID"
"IGRTTJ";"S";"0170";"            SI LOCA_VALID(1:1) = ""O"""
"IGRTTJ";"S";"0171";"               SI PARD_IDIJOUROUV = ""1"""
"IGRTTJ";"S";"0172";"                  SI HJOU_IJQPRETHEJ = 0"
"IGRTTJ";"S";"0173";"                     LOCA_ENLEVER = 1"
"IGRTTJ";"S";"0174";"                  FINSI"
