"ITICKE";"S";"0041";"LOCA_APR = 0"
"ITICKE";"S";"0042";"SI HJOU_DATE <= TEMP_DATJOU"
"ITICKE";"S";"0043";"* Test si la personne a droit aux tickets"
"ITICKE";"S";"0044";"   SI HJOU_IJIGTICKRE = ""1"""
"ITICKE";"S";"0045";"      SI HJOU_IJQPRETHEJ > 0"
"ITICKE";"S";"0046";"         POUR ACTIVITES"
"ITICKE";"S";"0047";"* le motif donne droit au ticket"
"ITICKE";"S";"0048";"            SI MOTI_IMIGTICKRE = ""1"""
"ITICKE";"S";"0049";"               SI HABS_VALORIS = ""M"""
"ITICKE";"S";"0050";"                  LOCA_MAT = 1"
"ITICKE";"S";"0051";"               FINSI"
"ITICKE";"S";"0052";"               SI HABS_VALORIS = ""A"""
"ITICKE";"S";"0053";"                  LOCA_APR = 1"
"ITICKE";"S";"0054";"               FINSI"
"ITICKE";"S";"0055";"               SI HABS_VALORIS = ""J"""
"ITICKE";"S";"0056";"*On accorde un ticket uniquement aux personnes qui"
"ITICKE";"S";"0057";"*travaillent la journée entiere"
"ITICKE";"S";"0058";"                  SI PROF_PTTHEO1 > 0"
"ITICKE";"S";"0059";"                     SI PROF_PTTHEO1 <= 36.00"
"ITICKE";"S";"0060";"                        SI PROF_PTTHEO3 > 0"
"ITICKE";"S";"0061";"                           SI PROF_PTTHEO3 <= 36.00"
"ITICKE";"S";"0062";"                              LOCA_MAT = 1"
"ITICKE";"S";"0063";"                              LOCA_APR = 1"
"ITICKE";"S";"0064";"                           FINSI"
"ITICKE";"S";"0065";"                        FINSI"
"ITICKE";"S";"0066";"                     FINSI"
"ITICKE";"S";"0067";"                  FINSI"
"ITICKE";"S";"0068";"               FINSI"
"ITICKE";"S";"0069";"* dans le cas ou le motif est saisi en heure"
"ITICKE";"S";"0070";"* les heures debut et fin doivent être renseignées"
"ITICKE";"S";"0071";"*"
"ITICKE";"S";"0072";"* Activite matin"
"ITICKE";"S";"0073";"               SI HABS_VALORIS = ""H"""
"ITICKE";"S";"0074";"                  SI PROF_PTTHEO1 > 0"
"ITICKE";"S";"0075";"                     SI PROF_PTTHEO1 <= 36.00"
"ITICKE";"S";"0076";"                        SI HABS_HRADEB <= PROF_PTTHEO1"
"ITICKE";"S";"0077";"                           SI HABS_HRAFIN > PROF_PTTHEO1"
"ITICKE";"S";"0078";"                              LOCA_MAT = 1"
"ITICKE";"S";"0079";"                           FINSI"
"ITICKE";"S";"0080";"                        SINON"
"ITICKE";"S";"0081";"                           SI HABS_HRADEB <= PROF_PTTHEO2"
"ITICKE";"S";"0082";"                              LOCA_MAT = 1"
"ITICKE";"S";"0083";"                           FINSI"
"ITICKE";"S";"0084";"                        FINSI"
"ITICKE";"S";"0085";"                     FINSI"
"ITICKE";"S";"0086";"                  FINSI"
"ITICKE";"S";"0087";"* Activite apres-midi"
"ITICKE";"S";"0088";"                  SI PROF_PTTHEO3 > 0"
"ITICKE";"S";"0089";"                     SI PROF_PTTHEO3 <= 36.00"
"ITICKE";"S";"0090";"                        SI HABS_HRADEB <= PROF_PTTHEO3"
"ITICKE";"S";"0091";"                           SI HABS_HRAFIN > PROF_PTTHEO3"
"ITICKE";"S";"0092";"                              LOCA_APR = 1"
"ITICKE";"S";"0093";"                           FINSI"
"ITICKE";"S";"0094";"                        SINON"
"ITICKE";"S";"0095";"                           SI HABS_HRADEB <= PROF_PTTHEO4"
"ITICKE";"S";"0096";"                              LOCA_APR = 1"
"ITICKE";"S";"0097";"                           FINSI"
"ITICKE";"S";"0098";"                        FINSI"
"ITICKE";"S";"0099";"                     FINSI"
"ITICKE";"S";"0100";"                  FINSI"
"ITICKE";"S";"0101";"* Activite journée"
"ITICKE";"S";"0102";"                  SI PROF_PTTHEO1 > 0"
"ITICKE";"S";"0103";"                     SI PROF_PTTHEO1 <= 36.00"
"ITICKE";"S";"0104";"                        SI PROF_PTTHEO3 > 0"
"ITICKE";"S";"0105";"                           SI PROF_PTTHEO3 <= 36.00"
"ITICKE";"S";"0106";"                              SI HABS_HRADEB <= PROF_PTTHEO2"
"ITICKE";"S";"0107";"                                 SI HABS_HRAFIN >= PROF_PTTHEO3"
"ITICKE";"S";"0108";"                                    LOCA_MAT = 1"
"ITICKE";"S";"0109";"                                    LOCA_APR = 1"
"ITICKE";"S";"0110";"                                 FINSI"
"ITICKE";"S";"0111";"                              FINSI"
"ITICKE";"S";"0112";"                           FINSI"
"ITICKE";"S";"0113";"                        FINSI"
"ITICKE";"S";"0114";"                     FINSI"
"ITICKE";"S";"0115";"                  FINSI"
"ITICKE";"S";"0116";"               FINSI"
"ITICKE";"S";"0117";"            FINSI"
"ITICKE";"S";"0118";"         FINPOUR"
"ITICKE";"S";"0119";"* test de la presence matin et apres-midi"
"ITICKE";"S";"0120";"         SI HJOU_IJQPRESBA1 > 0"
"ITICKE";"S";"0121";"            LOCA_MAT = 1"
"ITICKE";"S";"0122";"         FINSI"
"ITICKE";"S";"0123";"         SI HJOU_IJQPRESBA2 > 0"
"ITICKE";"S";"0124";"            LOCA_APR = 1"
"ITICKE";"S";"0125";"         FINSI"
"ITICKE";"S";"0126";"* Pour les non badgeants"
"ITICKE";"S";"0127";"* il faut egalement que les 4 badgeages théoriques soient"
"ITICKE";"S";"0128";"* renseignés cela indique que l'individu travail la journée"
"ITICKE";"S";"0129";"* entiere"
"ITICKE";"S";"0130";"         SI HJOU_IJIGBADGEA <> ""1"""
"ITICKE";"S";"0131";"            SI PROF_PTTHEO1 > 0"
"ITICKE";"S";"0132";"               SI PROF_PTTHEO1 <= 36.00"
"ITICKE";"S";"0133";"                  SI PROF_PTTHEO3 > 0"
"ITICKE";"S";"0134";"                     SI PROF_PTTHEO3 <= 36.00"
"ITICKE";"S";"0135";"                        LOCA_MAT = 1"
"ITICKE";"S";"0136";"                        LOCA_APR = 1"
"ITICKE";"S";"0137";"                     FINSI"
"ITICKE";"S";"0138";"                  FINSI"
"ITICKE";"S";"0139";"               FINSI"
"ITICKE";"S";"0140";"            FINSI"
"ITICKE";"S";"0141";"* dans le cas ou j'ai un motif qui ne donne pas"
"ITICKE";"S";"0142";"* droit au ticket, qu il soit de type J/M/A"
"ITICKE";"S";"0143";"* on ne donne pas de ticket"
"ITICKE";"S";"0144";"            POUR ACTIVITES"
"ITICKE";"S";"0145";"               SI MOTI_MOTYPE <> ""C"""
"ITICKE";"S";"0146";"                  SI MOTI_IMIGTICKRE <> ""1"""
"ITICKE";"S";"0147";"                     LOCA_MAT = 0"
"ITICKE";"S";"0148";"                     LOCA_APR = 0"
"ITICKE";"S";"0149";"                  FINSI"
"ITICKE";"S";"0150";"               FINSI"
"ITICKE";"S";"0151";"            FINPOUR"
"ITICKE";"S";"0152";"         FINSI"
"ITICKE";"S";"0153";"* Attribution d'un ticket si presence matin et apres-midi"
"ITICKE";"S";"0154";"*"
"ITICKE";"S";"0155";"         SI PARD_IDITICKETS = ""1"""
"ITICKE";"S";"0156";"            SI LOCA_MAT > 0"
"ITICKE";"S";"0157";"               SI LOCA_APR > 0"
"ITICKE";"S";"0158";"                  HJOU_IJQNTICKRE = 1"
"ITICKE";"S";"0159";"               FINSI"
"ITICKE";"S";"0160";"            FINSI"
"ITICKE";"S";"0161";"         FINSI"
"ITICKE";"S";"0162";"* Attribution d'un ticket si presence matin"
"ITICKE";"S";"0163";"*"
"ITICKE";"S";"0164";"         SI PARD_IDITICKETS = ""2"""
"ITICKE";"S";"0165";"            SI LOCA_MAT > 0"
"ITICKE";"S";"0166";"               HJOU_IJQNTICKRE = 1"
"ITICKE";"S";"0167";"            FINSI"
"ITICKE";"S";"0168";"         FINSI"
"ITICKE";"S";"0169";"* Attribution d'un ticket si presence matin ou apres-midi"
"ITICKE";"S";"0170";"*"
"ITICKE";"S";"0171";"         SI PARD_IDITICKETS = ""3"""
"ITICKE";"S";"0172";"            SI LOCA_MAT > 0"
"ITICKE";"S";"0173";"            OU LOCA_APR > 0"
"ITICKE";"S";"0174";"               HJOU_IJQNTICKRE = 1"
"ITICKE";"S";"0175";"            FINSI"
"ITICKE";"S";"0176";"         FINSI"
"ITICKE";"S";"0177";"** Initialisation par consigne"
"ITICKE";"S";"0178";"         POUR ACTIVITES"
"ITICKE";"S";"0179";"            SI HABS_MOTIF = ""ZTCKR"""
"ITICKE";"S";"0180";"               HJOU_IJQNTICKRE = HABS_MOTINBR"
"ITICKE";"S";"0181";"            FINSI"
"ITICKE";"S";"0182";"         FINPOUR"
"ITICKE";"S";"0183";"      FINSI"
"ITICKE";"S";"0184";"   FINSI"
"ITICKE";"S";"0185";"FINSI"
"ITICKE";"S";"0186";"FIN"
"ITPSACTHT1";"S";"0001";"**********************************************************************"
"ITPSACTHT1";"S";"0002";"*"
"ITPSACTHT1";"S";"0003";"* Règle : ITPSACTHT1"
"ITPSACTHT1";"S";"0004";"* Ordre : 3280"
"ITPSACTHT1";"S";"0005";"* Titre : #HQ ACTIVITY# Tps de présence Activité avec heures totales,"
"ITPSACTHT1";"S";"0006";"*          population = section et mode jour (indicateur dans EMP)"
"ITPSACTHT1";"S";"0007";"*"
"ITPSACTHT1";"S";"0008";"*---------------------------------------------------------------------"
"ITPSACTHT1";"S";"0009";"*"
"ITPSACTHT1";"S";"0010";"* Créé par : Méthodes et outils"
"ITPSACTHT1";"S";"0011";"* Date     : 17/08/2020"
"ITPSACTHT1";"S";"0012";"* Version  : 1"
"ITPSACTHT1";"S";"0013";"*"
"ITPSACTHT1";"S";"0014";"*---------------------------------------------------------------------"
"ITPSACTHT1";"S";"0015";"*"
"ITPSACTHT1";"S";"0016";"*"
"ITPSACTHT1";"S";"0017";"* Rôle :"
"ITPSACTHT1";"S";"0018";"*"
"ITPSACTHT1";"S";"0019";"* Calcul du temps de présence activité avec les heures totales"
"ITPSACTHT1";"S";"0020";"* pour population = section et mode jour"
"ITPSACTHT1";"S";"0021";"* (gestion activité avec indicateur dans EMP)"
"ITPSACTHT1";"S";"0022";"*"
"ITPSACTHT1";"S";"0023";"*"
"ITPSACTHT1";"S";"0024";"*----------------------------------------------------------------------"
"ITPSACTHT1";"S";"0025";"*"
"ITPSACTHT1";"S";"0026";"* Modifiée par :"
"ITPSACTHT1";"S";"0027";"* Date         : JJ/MM/AAAA"
"ITPSACTHT1";"S";"0028";"* Objet        :"
"ITPSACTHT1";"S";"0029";"*"
"ITPSACTHT1";"S";"0030";"***********************************************************************"
"ITPSACTHT1";"S";"0031";"*"
"ITPSACTHT1";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTHT1";"S";"0033";"*"
"ITPSACTHT1";"S";"0034";"DEBDICO"
"ITPSACTHT1";"S";"0035";"EMPL_IEIACTI;O;A1;X;;;123456789;L;;C3;""Employé géré en activité"";"
"ITPSACTHT1";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTHT1";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTHT1";"S";"0038";"FINDICO"
"ITPSACTHT1";"S";"0039";"*"
"ITPSACTHT1";"S";"0040";"*"
"ITPSACTHT1";"S";"0041";"* DEBANO"
"ITPSACTHT1";"S";"0042";"*"
"ITPSACTHT1";"S";"0043";"* FINANO"
"ITPSACTHT1";"S";"0044";"*"
"ITPSACTHT1";"S";"0045";"* Définition des variables locales"
"ITPSACTHT1";"S";"0046";"DEF LOCA_DURABS T6.2"
"ITPSACTHT1";"S";"0047";"LOCA_DURABS = 0"
"ITPSACTHT1";"S";"0048";"*"
"ITPSACTHT1";"S";"0049";"* Gestion de l'indicateur activité"
"ITPSACTHT1";"S";"0050";"SI HJOU_IJIACTI = "" """
"ITPSACTHT1";"S";"0051";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHT1";"S";"0052";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTHT1";"S";"0053";"    FINSI"
"ITPSACTHT1";"S";"0054";"FINSI"
"ITPSACTHT1";"S";"0055";"* Employé géré en activité"
"ITPSACTHT1";"S";"0056";"SI HJOU_IJIACTI <> "" """
"ITPSACTHT1";"S";"0057";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHT1";"S";"0058";"        * Calcul de la présence activité"
"ITPSACTHT1";"S";"0059";"        SI PRES_VALID <> ""O"""
"ITPSACTHT1";"S";"0060";"            PRES_VALID = ""N"""
"ITPSACTHT1";"S";"0061";"            PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTHT1";"S";"0062";"            SI HJOU_SECTAFF <> "" """
"ITPSACTHT1";"S";"0063";"                PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTHT1";"S";"0064";"            SINON"
"ITPSACTHT1";"S";"0065";"                PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTHT1";"S";"0066";"            FINSI"
"ITPSACTHT1";"S";"0067";"            *"
"ITPSACTHT1";"S";"0068";"            SI PRES_MODE_TRV = "" """
"ITPSACTHT1";"S";"0069";"               PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT1";"S";"0070";"            FINSI"
"ITPSACTHT1";"S";"0071";"            *"
"ITPSACTHT1";"S";"0072";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT1";"S";"0073";"            *"
"ITPSACTHT1";"S";"0074";"            * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT1";"S";"0075";"            *                              (A décommenter si besoin)"
"ITPSACTHT1";"S";"0076";"            *"
"ITPSACTHT1";"S";"0077";"            * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT1";"S";"0078";"            * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT1";"S";"0079";"            * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT1";"S";"0080";"            * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT1";"S";"0081";"            *"
"ITPSACTHT1";"S";"0082";"            * SI HJOU_IJQBHORVAJ <> 0"
"ITPSACTHT1";"S";"0083";"                PRES_TPS_PRES = HJOU_IJQBHORVAJ"
"ITPSACTHT1";"S";"0084";"            * SINON"
"ITPSACTHT1";"S";"0085";"                * PRES_TPS_PRES = 0.01"
"ITPSACTHT1";"S";"0086";"            * FINSI"
"ITPSACTHT1";"S";"0087";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT1";"S";"0088";"            *"
"ITPSACTHT1";"S";"0089";"            *"
"ITPSACTHT1";"S";"0090";"            *"
"ITPSACTHT1";"S";"0091";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT1";"S";"0092";"            *"
"ITPSACTHT1";"S";"0093";"            * !!!                Pour gestion des temps de présence par consigne                !!!"
"ITPSACTHT1";"S";"0094";"            *                              (A décommenter si besoin)"
"ITPSACTHT1";"S";"0095";"            *"
"ITPSACTHT1";"S";"0096";"            * Si besoin de gérer les temps de présence par consigne, décommenter le"
"ITPSACTHT1";"S";"0097";"            * POUR ACTIVITES ci-dessous ainsi le test LOCA_DURABS <> 0"
"ITPSACTHT1";"S";"0098";"            *"
"ITPSACTHT1";"S";"0099";"            * récupération des temps de présence declaré par consigne"
"ITPSACTHT1";"S";"0100";"            * POUR ACTIVITES"
"ITPSACTHT1";"S";"0101";"                * SI HABS_MOTYPE = ""C"""
"ITPSACTHT1";"S";"0102";"                    * Motif participant au temps d'activité à justifier"
"ITPSACTHT1";"S";"0103";"                    * SI MOTI_MOTIF = ""XPRES"""
"ITPSACTHT1";"S";"0104";"                        * LOCA_DURABS = LOCA_DURABS + HABS_MOTIDUR"
"ITPSACTHT1";"S";"0105";"                    * FINSI"
"ITPSACTHT1";"S";"0106";"                * FINSI"
"ITPSACTHT1";"S";"0107";"            * FINPOUR"
"ITPSACTHT1";"S";"0108";"            *"
"ITPSACTHT1";"S";"0109";"            * SI LOCA_DURABS <> 0"
"ITPSACTHT1";"S";"0110";"                * PRES_TPS_PRES = LOCA_DURABS"
"ITPSACTHT1";"S";"0111";"            * FINSI"
"ITPSACTHT1";"S";"0112";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT1";"S";"0113";"            *"
"ITPSACTHT1";"S";"0114";"            PRES_TPS_IMPUTE = 0"
"ITPSACTHT1";"S";"0115";"            SI HJOU_IJIACTI = ""1"""
"ITPSACTHT1";"S";"0116";"            OU HJOU_IJIACTI = ""2"""
"ITPSACTHT1";"S";"0117";"            OU HJOU_IJIACTI = ""3"""
"ITPSACTHT1";"S";"0118";"                POUR EVENEMENTS"
"ITPSACTHT1";"S";"0119";"                    PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT1";"S";"0120";"                FINPOUR"
"ITPSACTHT1";"S";"0121";"            FINSI"
"ITPSACTHT1";"S";"0122";"            * Calcul de l'écart"
"ITPSACTHT1";"S";"0123";"            PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT1";"S";"0124";"        FINSI"
"ITPSACTHT1";"S";"0125";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT1";"S";"0126";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT1";"S";"0127";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT1";"S";"0128";"        FINSI"
"ITPSACTHT1";"S";"0129";"    FINSI"
"ITPSACTHT1";"S";"0130";"FINSI"
"ITPSACTHT1";"S";"0131";"*"
"ITPSACTHT1";"S";"0132";"FIN"
"ITPSACTHT2";"S";"0001";"**********************************************************************"
"ITPSACTHT2";"S";"0002";"*"
"ITPSACTHT2";"S";"0003";"* Règle : ITPSACTHT2"
"ITPSACTHT2";"S";"0004";"* Ordre : 3290"
"ITPSACTHT2";"S";"0005";"* Titre : #HQ ACTIVITY# Tps de présence Activité avec heures totales,"
"ITPSACTHT2";"S";"0006";"*          population <> section et mode jour (indicateur dans EMP)"
"ITPSACTHT2";"S";"0007";"*"
"ITPSACTHT2";"S";"0008";"*---------------------------------------------------------------------"
"ITPSACTHT2";"S";"0009";"*"
"ITPSACTHT2";"S";"0010";"* Créé par : Méthodes et outils"
"ITPSACTHT2";"S";"0011";"* Date     : 17/08/2020"
"ITPSACTHT2";"S";"0012";"* Version  : 1"
"ITPSACTHT2";"S";"0013";"*"
"ITPSACTHT2";"S";"0014";"*---------------------------------------------------------------------"
"ITPSACTHT2";"S";"0015";"*"
"ITPSACTHT2";"S";"0016";"*"
"ITPSACTHT2";"S";"0017";"* Rôle :"
"ITPSACTHT2";"S";"0018";"*"
"ITPSACTHT2";"S";"0019";"* Calcul du temps de présence activité avec les heures totales"
"ITPSACTHT2";"S";"0020";"* pour population <> section et mode jour"
"ITPSACTHT2";"S";"0021";"* (gestion activité avec indicateur dans EMP)"
"ITPSACTHT2";"S";"0022";"*"
"ITPSACTHT2";"S";"0023";"*"
"ITPSACTHT2";"S";"0024";"*----------------------------------------------------------------------"
"ITPSACTHT2";"S";"0025";"*"
"ITPSACTHT2";"S";"0026";"* Modifiée par :"
"ITPSACTHT2";"S";"0027";"* Date         : JJ/MM/AAAA"
"ITPSACTHT2";"S";"0028";"* Objet        :"
"ITPSACTHT2";"S";"0029";"*"
"ITPSACTHT2";"S";"0030";"***********************************************************************"
"ITPSACTHT2";"S";"0031";"*"
"ITPSACTHT2";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTHT2";"S";"0033";"*"
"ITPSACTHT2";"S";"0034";"DEBDICO"
"ITPSACTHT2";"S";"0035";"EMPL_IEIACTI;O;A1;X;;;123456789;L;;C3;""Employé géré en activité"";"
"ITPSACTHT2";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTHT2";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTHT2";"S";"0038";"FINDICO"
"ITPSACTHT2";"S";"0039";"*"
"ITPSACTHT2";"S";"0040";"*"
"ITPSACTHT2";"S";"0041";"* DEBANO"
"ITPSACTHT2";"S";"0042";"*"
"ITPSACTHT2";"S";"0043";"* FINANO"
"ITPSACTHT2";"S";"0044";"*"
"ITPSACTHT2";"S";"0045";"* Définition des variables locales"
"ITPSACTHT2";"S";"0046";"DEF LOCA_DURABS T6.2"
"ITPSACTHT2";"S";"0047";"LOCA_DURABS = 0"
"ITPSACTHT2";"S";"0048";"*"
"ITPSACTHT2";"S";"0049";"* Gestion de l'indicateur activité"
"ITPSACTHT2";"S";"0050";"SI HJOU_IJIACTI = "" """
"ITPSACTHT2";"S";"0051";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHT2";"S";"0052";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTHT2";"S";"0053";"    FINSI"
"ITPSACTHT2";"S";"0054";"FINSI"
"ITPSACTHT2";"S";"0055";"* Calcul de la présence activité"
"ITPSACTHT2";"S";"0056";"SI HJOU_IJIACTI <> "" """
"ITPSACTHT2";"S";"0057";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHT2";"S";"0058";"        * Calcul de la présence activité"
"ITPSACTHT2";"S";"0059";"        SI PRES_VALID <> ""O"""
"ITPSACTHT2";"S";"0060";"            PRES_VALID = ""N"""
"ITPSACTHT2";"S";"0061";"            *"
"ITPSACTHT2";"S";"0062";"            PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTHT2";"S";"0063";"            PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTHT2";"S";"0064";"            *"
"ITPSACTHT2";"S";"0065";"            SI PRES_MODE_TRV = "" """
"ITPSACTHT2";"S";"0066";"               PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT2";"S";"0067";"            FINSI"
"ITPSACTHT2";"S";"0068";"            *"
"ITPSACTHT2";"S";"0069";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT2";"S";"0070";"            *"
"ITPSACTHT2";"S";"0071";"            * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT2";"S";"0072";"            *                              (A décommenter si besoin)"
"ITPSACTHT2";"S";"0073";"            *"
"ITPSACTHT2";"S";"0074";"            * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT2";"S";"0075";"            * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT2";"S";"0076";"            * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT2";"S";"0077";"            * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT2";"S";"0078";"            *"
"ITPSACTHT2";"S";"0079";"            * SI HJOU_IJQBHORVAJ <> 0"
"ITPSACTHT2";"S";"0080";"                PRES_TPS_PRES = HJOU_IJQBHORVAJ"
"ITPSACTHT2";"S";"0081";"            * SINON"
"ITPSACTHT2";"S";"0082";"                * PRES_TPS_PRES = 0.01"
"ITPSACTHT2";"S";"0083";"            * FINSI"
"ITPSACTHT2";"S";"0084";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT2";"S";"0085";"            *"
"ITPSACTHT2";"S";"0086";"            *"
"ITPSACTHT2";"S";"0087";"            *"
"ITPSACTHT2";"S";"0088";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT2";"S";"0089";"            *"
"ITPSACTHT2";"S";"0090";"            * !!!                Pour gestion des temps de présence par consigne                !!!"
"ITPSACTHT2";"S";"0091";"            *                              (A décommenter si besoin)"
"ITPSACTHT2";"S";"0092";"            *"
"ITPSACTHT2";"S";"0093";"            * Si besoin de gérer les temps de présence par consigne, décommenter le"
"ITPSACTHT2";"S";"0094";"            * POUR ACTIVITES ci-dessous ainsi le test LOCA_DURABS <> 0"
"ITPSACTHT2";"S";"0095";"            *"
"ITPSACTHT2";"S";"0096";"            * récupération des temps de présence declaré par consigne"
"ITPSACTHT2";"S";"0097";"            * POUR ACTIVITES"
"ITPSACTHT2";"S";"0098";"                * SI HABS_MOTYPE = ""C"""
"ITPSACTHT2";"S";"0099";"                    * Motif participant au temps d'activité à justifier"
"ITPSACTHT2";"S";"0100";"                    * SI MOTI_MOTIF = ""XPRES"""
"ITPSACTHT2";"S";"0101";"                        * LOCA_DURABS = LOCA_DURABS + HABS_MOTIDUR"
"ITPSACTHT2";"S";"0102";"                    * FINSI"
"ITPSACTHT2";"S";"0103";"                * FINSI"
"ITPSACTHT2";"S";"0104";"            * FINPOUR"
"ITPSACTHT2";"S";"0105";"            *"
"ITPSACTHT2";"S";"0106";"            * SI LOCA_DURABS <> 0"
"ITPSACTHT2";"S";"0107";"                * PRES_TPS_PRES = LOCA_DURABS"
"ITPSACTHT2";"S";"0108";"            * FINSI"
"ITPSACTHT2";"S";"0109";"            * ----------------------------------------------------------------------------------"
"ITPSACTHT2";"S";"0110";"            *"
"ITPSACTHT2";"S";"0111";"            *"
"ITPSACTHT2";"S";"0112";"            PRES_TPS_IMPUTE = 0"
"ITPSACTHT2";"S";"0113";"            SI HJOU_IJIACTI = ""1"""
"ITPSACTHT2";"S";"0114";"            OU HJOU_IJIACTI = ""2"""
"ITPSACTHT2";"S";"0115";"            OU HJOU_IJIACTI = ""3"""
"ITPSACTHT2";"S";"0116";"                POUR EVENEMENTS"
"ITPSACTHT2";"S";"0117";"                    PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT2";"S";"0118";"                FINPOUR"
"ITPSACTHT2";"S";"0119";"            FINSI"
"ITPSACTHT2";"S";"0120";"            * Calcul de l'écart"
"ITPSACTHT2";"S";"0121";"            PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT2";"S";"0122";"        FINSI"
"ITPSACTHT2";"S";"0123";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT2";"S";"0124";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT2";"S";"0125";"            HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT2";"S";"0126";"        FINSI"
"ITPSACTHT2";"S";"0127";"    FINSI"
"ITPSACTHT2";"S";"0128";"FINSI"
"ITPSACTHT2";"S";"0129";"*"
"ITPSACTHT2";"S";"0130";"FIN"
"ITPSACTHT3";"S";"0001";"**********************************************************************"
"ITPSACTHT3";"S";"0002";"*"
"ITPSACTHT3";"S";"0003";"* Règle : ITPSACTHT3"
