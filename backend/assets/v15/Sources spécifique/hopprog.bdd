"IACQCPAN2";"S";"0076";"* Déclaration des donnees locales"
"IACQCPAN2";"S";"0077";"* Variables utilisées pour calculer la date de reference"
"IACQCPAN2";"S";"0078";"DEF LOCA_DATE D"
"IACQCPAN2";"S";"0079";"DEF LOCA_REF N2"
"IACQCPAN2";"S";"0080";"* Variables utilisées pour le calcul de l'ancienneté"
"IACQCPAN2";"S";"0081";"DEF LOCA_ANCIEN N6.1"
"IACQCPAN2";"S";"0082";"LOCA_ANCIEN = 0"
"IACQCPAN2";"S";"0083";"DEF LOCA_TRANS N6.1"
"IACQCPAN2";"S";"0084";"LOCA_TRANS = 0"
"IACQCPAN2";"S";"0085";"DEF LOCA_DROIT N6.1"
"IACQCPAN2";"S";"0086";"LOCA_DROIT = 0"
"IACQCPAN2";"S";"0087";"DEF LOCA_CA N1"
"IACQCPAN2";"S";"0088";"LOCA_CA = 0"
"IACQCPAN2";"S";"0089";"*"
"IACQCPAN2";"S";"0090";"* Récupération de la date d'anniversaire de l'ancienneté"
"IACQCPAN2";"S";"0091";"SI EMPS_E2DATEANC <> "" """
"IACQCPAN2";"S";"0092";"* Récupération de l'année du jour dans JOU"
"IACQCPAN2";"S";"0093";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IACQCPAN2";"S";"0094";"* Récupération du mois de la date d'ancienneté"
"IACQCPAN2";"S";"0095";"   LOCA_REF << EMPS_E2DATEANC(5:2)"
"IACQCPAN2";"S";"0096";"   LOCA_DATE(5:2) << LOCA_REF"
"IACQCPAN2";"S";"0097";"* Récupération du jour de la date d'ancienneté"
"IACQCPAN2";"S";"0098";"   LOCA_REF << EMPS_E2DATEANC(7:2)"
"IACQCPAN2";"S";"0099";"   LOCA_DATE(7:2) << LOCA_REF"
"IACQCPAN2";"S";"0100";"SINON"
"IACQCPAN2";"S";"0101";"   LOCA_DATE = "" """
"IACQCPAN2";"S";"0102";"FINSI"
"IACQCPAN2";"S";"0103";"*"
"IACQCPAN2";"S";"0104";"* GESTION DE L'ACQUISITION DES CONGES D'ANCIENNETE"
"IACQCPAN2";"S";"0105";"* Date de référence des congés d'ancienneté"
"IACQCPAN2";"S";"0106";"SI HJOU_DATE = LOCA_DATE"
"IACQCPAN2";"S";"0107";"* Cacul de l'ancienneté"
"IACQCPAN2";"S";"0108";"   DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"IACQCPAN2";"S";"0109";"   LOCA_ANCIEN = TEMP_NXANNEE"
"IACQCPAN2";"S";"0110";"*"
"IACQCPAN2";"S";"0111";"* Si ""régime 1"""
"IACQCPAN2";"S";"0112";"   SI HJOU_IJIREGCPAN = ""1"""
"IACQCPAN2";"S";"0113";"      SI PARD_IDISANC1 > 0"
"IACQCPAN2";"S";"0114";"* Acquisition selon les seuils"
"IACQCPAN2";"S";"0115";"         SI LOCA_ANCIEN >= PARD_IDISANC1"
"IACQCPAN2";"S";"0116";"            SI LOCA_ANCIEN < PARD_IDISANC2"
"IACQCPAN2";"S";"0117";"            OU PARD_IDISANC2 = 0"
"IACQCPAN2";"S";"0118";"               HJOU_IJRDCOANCI = PARD_IDIDCANC1"
"IACQCPAN2";"S";"0119";"            SINON"
"IACQCPAN2";"S";"0120";"               SI LOCA_ANCIEN < PARD_IDISANC3"
"IACQCPAN2";"S";"0121";"               OU PARD_IDISANC3 = 0"
"IACQCPAN2";"S";"0122";"                  HJOU_IJRDCOANCI = PARD_IDIDCANC2"
"IACQCPAN2";"S";"0123";"               SINON"
"IACQCPAN2";"S";"0124";"                  SI LOCA_ANCIEN < PARD_IDISANC4"
"IACQCPAN2";"S";"0125";"                  OU PARD_IDISANC4 = 0"
"IACQCPAN2";"S";"0126";"                     HJOU_IJRDCOANCI = PARD_IDIDCANC3"
"IACQCPAN2";"S";"0127";"                  SINON"
"IACQCPAN2";"S";"0128";"                     SI LOCA_ANCIEN < PARD_IDISANC5"
"IACQCPAN2";"S";"0129";"                     OU PARD_IDISANC5 = 0"
"IACQCPAN2";"S";"0130";"                        HJOU_IJRDCOANCI = PARD_IDIDCANC4"
"IACQCPAN2";"S";"0131";"                     SINON"
"IACQCPAN2";"S";"0132";"                        SI LOCA_ANCIEN < PARD_IDISANC6"
"IACQCPAN2";"S";"0133";"                        OU PARD_IDISANC6 = 0"
"IACQCPAN2";"S";"0134";"                           HJOU_IJRDCOANCI = PARD_IDIDCANC5"
"IACQCPAN2";"S";"0135";"                        SINON"
"IACQCPAN2";"S";"0136";"                           HJOU_IJRDCOANCI = PARD_IDIDCANC6"
"IACQCPAN2";"S";"0137";"                        FINSI"
"IACQCPAN2";"S";"0138";"                     FINSI"
"IACQCPAN2";"S";"0139";"                  FINSI"
"IACQCPAN2";"S";"0140";"               FINSI"
"IACQCPAN2";"S";"0141";"            FINSI"
"IACQCPAN2";"S";"0142";"         FINSI"
"IACQCPAN2";"S";"0143";"      FINSI"
"IACQCPAN2";"S";"0144";"   FINSI"
"IACQCPAN2";"S";"0145";"* Si ""régime 2"""
"IACQCPAN2";"S";"0146";"   SI HJOU_IJIREGCPAN = ""2"""
"IACQCPAN2";"S";"0147";"      SI PARD_IDISANNC1 > 0"
"IACQCPAN2";"S";"0148";"* Acquisition selon les seuils"
"IACQCPAN2";"S";"0149";"         SI LOCA_ANCIEN >= PARD_IDISANNC1"
"IACQCPAN2";"S";"0150";"            SI LOCA_ANCIEN < PARD_IDISANNC2"
"IACQCPAN2";"S";"0151";"            OU PARD_IDISANNC2 = 0"
"IACQCPAN2";"S";"0152";"               HJOU_IJRDCOANCI = PARD_IDIDCANNC1"
"IACQCPAN2";"S";"0153";"            SINON"
"IACQCPAN2";"S";"0154";"               SI LOCA_ANCIEN < PARD_IDISANNC3"
"IACQCPAN2";"S";"0155";"               OU PARD_IDISANNC3 = 0"
"IACQCPAN2";"S";"0156";"                  HJOU_IJRDCOANCI = PARD_IDIDCANNC2"
"IACQCPAN2";"S";"0157";"               SINON"
"IACQCPAN2";"S";"0158";"                  SI LOCA_ANCIEN < PARD_IDISANNC4"
"IACQCPAN2";"S";"0159";"                  OU PARD_IDISANNC4 = 0"
"IACQCPAN2";"S";"0160";"                     HJOU_IJRDCOANCI = PARD_IDIDCANNC3"
"IACQCPAN2";"S";"0161";"                  SINON"
"IACQCPAN2";"S";"0162";"                     SI LOCA_ANCIEN < PARD_IDISANNC5"
"IACQCPAN2";"S";"0163";"                     OU PARD_IDISANNC5 = 0"
"IACQCPAN2";"S";"0164";"                        HJOU_IJRDCOANCI = PARD_IDIDCANNC4"
"IACQCPAN2";"S";"0165";"                     SINON"
"IACQCPAN2";"S";"0166";"                        SI LOCA_ANCIEN < PARD_IDISANNC6"
"IACQCPAN2";"S";"0167";"                        OU PARD_IDISANNC6 = 0"
"IACQCPAN2";"S";"0168";"                           HJOU_IJRDCOANCI = PARD_IDIDCANNC5"
"IACQCPAN2";"S";"0169";"                        SINON"
"IACQCPAN2";"S";"0170";"                           HJOU_IJRDCOANCI = PARD_IDIDCANNC6"
"IACQCPAN2";"S";"0171";"                        FINSI"
"IACQCPAN2";"S";"0172";"                     FINSI"
"IACQCPAN2";"S";"0173";"                  FINSI"
"IACQCPAN2";"S";"0174";"               FINSI"
"IACQCPAN2";"S";"0175";"            FINSI"
"IACQCPAN2";"S";"0176";"         FINSI"
"IACQCPAN2";"S";"0177";"      FINSI"
"IACQCPAN2";"S";"0178";"   FINSI"
"IACQCPAN2";"S";"0179";"* Remise à zéro du pris"
"IACQCPAN2";"S";"0180";"   HJOU_IJRCCOANCI = 0"
"IACQCPAN2";"S";"0181";"   HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"IACQCPAN2";"S";"0182";"FINSI"
"IACQCPAN2";"S";"0183";"* GESTION CONSIGNES D'INIT. ET MAJ"
"IACQCPAN2";"S";"0184";"POUR ACTIVITES"
"IACQCPAN2";"S";"0185";"* consignes de MAJ du droit congés d'ancienneté"
"IACQCPAN2";"S";"0186";"   SI HABS_MOTIF = ""XDCA"""
"IACQCPAN2";"S";"0187";"      LOCA_CA = 1"
"IACQCPAN2";"S";"0188";"      LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCOANCI"
"IACQCPAN2";"S";"0189";"      LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCOANCI"
"IACQCPAN2";"S";"0190";"      *"
"IACQCPAN2";"S";"0191";"      HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + HABS_MOTINBR"
"IACQCPAN2";"S";"0192";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACQCPAN2";"S";"0193";"   FINSI"
"IACQCPAN2";"S";"0194";"* Droit congé d'ancienneté"
"IACQCPAN2";"S";"0195";"   SI HABS_MOTIF = ""ZDCA"""
"IACQCPAN2";"S";"0196";"      LOCA_CA = 1"
"IACQCPAN2";"S";"0197";"      LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCOANCI"
"IACQCPAN2";"S";"0198";"      *"
"IACQCPAN2";"S";"0199";"      HJOU_IJRDCOANCI = HABS_MOTINBR"
"IACQCPAN2";"S";"0200";"      HJOU_IJRSCOANCI = HJOU_IJRSCOANCI + LOCA_TRANS"
"IACQCPAN2";"S";"0201";"   FINSI"
"IACQCPAN2";"S";"0202";"FINPOUR"
"IACQCPAN2";"S";"0203";"*"
"IACQCPAN2";"S";"0204";"SI LOCA_CA = 1"
"IACQCPAN2";"S";"0205";"   SI HJOU_IJRSCOANCI < 0"
"IACQCPAN2";"S";"0206";"      ANOMALIE 168"
"IACQCPAN2";"S";"0207";"   FINSI"
"IACQCPAN2";"S";"0208";"FINSI"
"IACQCPAN2";"S";"0209";"*"
"IACQCPAN2";"S";"0210";"FIN"
