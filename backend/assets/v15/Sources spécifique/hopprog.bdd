"IDISPJA";"S";"0034";"*----------------------------------------------------------------------"
"IDISPJA";"S";"0035";"*"
"IDISPJA";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPJA";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPJA";"S";"0038";"* Objet        :"
"IDISPJA";"S";"0039";"*"
"IDISPJA";"S";"0040";"***********************************************************************"
"IDISPJA";"S";"0041";"*"
"IDISPJA";"S";"0042";"* Implémentation des données industrielles"
"IDISPJA";"S";"0043";"*"
"IDISPJA";"S";"0044";"DEBDICO"
"IDISPJA";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJA";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPJA";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPJA";"S";"0048";"   * en passant par la fonction PER"
"IDISPJA";"S";"0049";"   HJOU_IJRDJDISP1;N;N6,2;L;;;    56789;;IJRDJDISP1;V3;""Droit en jour disponible 1"";"
"IDISPJA";"S";"0050";"   HJOU_IJRCJDISP1;N;N6,2;L;;;    56789;;IJRCJDISP1;V3;""Pris en jour disponible 1"";"
"IDISPJA";"S";"0051";"   HJOU_IJRSJDISP1;N;N6,2;L;;;    56789;;IJRSJDISP1;V3;""Solde en jour disponible 1"";"
"IDISPJA";"S";"0052";"   EMPL_IEQSPDISP1;N;N6,2;L;;;     6789;;;V3;""Solde prévisionnel en jour disponible 1"";"
"IDISPJA";"S";"0053";"   PARD_IDIDRDISP1;O;D10;X;;;123456789;;;C3;""Date RAZ compteur jour disponible 1"";"
"IDISPJA";"S";"0054";"   PARD_IDIVDDISP1;O;N6,2;I;;;123456789;;;C3;""Valeur droit jour compteur disponible 1"";"
"IDISPJA";"S";"0055";"   PARD_IDIVMDISP1;O;A10;X;;;123456789;II;;C2;""Motif compteur en jour disponible 1"";"
"IDISPJA";"S";"0056";"FINDICO"
"IDISPJA";"S";"0057";"*"
"IDISPJA";"S";"0058";"* Déclaration des donnees locales"
"IDISPJA";"S";"0059";"*"
"IDISPJA";"S";"0060";"DEF LOCA_VAL N2.1"
"IDISPJA";"S";"0061";"DEF LOCA_DATE D"
"IDISPJA";"S";"0062";"LOCA_DATE = "" """
"IDISPJA";"S";"0063";"DEF LOCA_ACOURS N4"
"IDISPJA";"S";"0064";"LOCA_ACOURS = 0"
"IDISPJA";"S";"0065";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPJA";"S";"0066";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISP1,"
"IDISPJA";"S";"0067";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJA";"S";"0068";"* par la date souhaitée"
"IDISPJA";"S";"0069";"*"
"IDISPJA";"S";"0070";"** alimentation du droit à la date de référence"
"IDISPJA";"S";"0071";"** raz du consommé à la date de référence"
"IDISPJA";"S";"0072";"SI HJOU_DATE = PARD_IDIDRDISP1"
"IDISPJA";"S";"0073";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJA";"S";"0074";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPJA";"S";"0075";"   * par le nombre paramétré dans PARD_IDIVDDISP1,"
"IDISPJA";"S";"0076";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJA";"S";"0077";"   * par le nombre souhaité"
"IDISPJA";"S";"0078";"   HJOU_IJRDJDISP1 = PARD_IDIVDDISP1"
"IDISPJA";"S";"0079";"   HJOU_IJRCJDISP1 = 0"
"IDISPJA";"S";"0080";"FINSI"
"IDISPJA";"S";"0081";"** alimentation du pris"
"IDISPJA";"S";"0082";"POUR ACTIVITES"
"IDISPJA";"S";"0083";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJA";"S";"0084";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISP1,"
"IDISPJA";"S";"0085";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPJA";"S";"0086";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPJA";"S";"0087";"   * pas il devra être créé)"
"IDISPJA";"S";"0088";"   SI HABS_MOTIF = PARD_IDIVMDISP1"
"IDISPJA";"S";"0089";"      SI HABS_MOTIDUR > 0"
"IDISPJA";"S";"0090";"         SI HABS_VALORIS = ""J"""
"IDISPJA";"S";"0091";"            LOCA_VAL = 1"
"IDISPJA";"S";"0092";"         SINON"
"IDISPJA";"S";"0093";"            LOCA_VAL = 0.5"
"IDISPJA";"S";"0094";"         FINSI"
"IDISPJA";"S";"0095";"      FINSI"
"IDISPJA";"S";"0096";"      HJOU_IJRCJDISP1 = HJOU_IJRCJDISP1 + LOCA_VAL"
"IDISPJA";"S";"0097";"      LOCA_VAL = 0"
"IDISPJA";"S";"0098";"   FINSI"
"IDISPJA";"S";"0099";"FINPOUR"
"IDISPJA";"S";"0100";"** alimentation du droit/pris par consignes"
"IDISPJA";"S";"0101";"POUR ACTIVITES"
"IDISPJA";"S";"0102";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJA";"S";"0103";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPJA";"S";"0104";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPJA";"S";"0105";"   * en conséquence)"
"IDISPJA";"S";"0106";"   SI HABS_MOTIF = ""ZDDIS1"""
"IDISPJA";"S";"0107";"      HJOU_IJRDJDISP1 = HABS_MOTINBR"
"IDISPJA";"S";"0108";"   FINSI"
"IDISPJA";"S";"0109";"   SI HABS_MOTIF = ""XDDIS1"""
"IDISPJA";"S";"0110";"      HJOU_IJRDJDISP1 = HJOU_IJRDJDISP1 + HABS_MOTINBR"
"IDISPJA";"S";"0111";"   FINSI"
"IDISPJA";"S";"0112";"   SI HABS_MOTIF = ""ZCDIS1"""
"IDISPJA";"S";"0113";"      HJOU_IJRCJDISP1 = HABS_MOTINBR"
"IDISPJA";"S";"0114";"   FINSI"
"IDISPJA";"S";"0115";"   SI HABS_MOTIF = ""XCDIS1"""
"IDISPJA";"S";"0116";"      HJOU_IJRCJDISP1 = HJOU_IJRCJDISP1 + HABS_MOTINBR"
"IDISPJA";"S";"0117";"   FINSI"
"IDISPJA";"S";"0118";"FINPOUR"
"IDISPJA";"S";"0119";"** calcul du solde"
"IDISPJA";"S";"0120";"HJOU_IJRSJDISP1 = HJOU_IJRDJDISP1 - HJOU_IJRCJDISP1"
"IDISPJA";"S";"0121";"LOCA_ACOURS << PARD_IDIDRDISP1(1:4)"
"IDISPJA";"S";"0122";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPJA";"S";"0123";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPJA";"S";"0124";"LOCA_DATE(5:4) = PARD_IDIDRDISP1(5:4)"
"IDISPJA";"S";"0125";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPJA";"S";"0126";"   EMPL_IEQSPDISP1 = HJOU_IJRSJDISP1"
"IDISPJA";"S";"0127";"FINSI"
"IDISPJA";"S";"0128";"FIN"
"IDISPJB";"S";"0001";"***********************************************************************"
"IDISPJB";"S";"0002";"*"
"IDISPJB";"S";"0003";"* Règle : IDSPJB"
"IDISPJB";"S";"0004";"* Ordre : 7010"
"IDISPJB";"S";"0005";"* Titre : Compteurs disponible 2 en jour"
"IDISPJB";"S";"0006";"*"
"IDISPJB";"S";"0007";"*----------------------------------------------------------------------"
"IDISPJB";"S";"0008";"*"
"IDISPJB";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDISPJB";"S";"0010";"* Date     : 03/09/2009"
"IDISPJB";"S";"0011";"* Version  : 1"
"IDISPJB";"S";"0012";"*"
"IDISPJB";"S";"0013";"*---------------------------------------------------------------------"
"IDISPJB";"S";"0014";"*"
"IDISPJB";"S";"0015";"*"
"IDISPJB";"S";"0016";"* Rôle : Mettre à disposition une règle gérant des compteurs droit/pris/solde"
"IDISPJB";"S";"0017";"*         Mais également des compteurs afin de ne pas avoir à en"
"IDISPJB";"S";"0018";"*         créer de nouveaux et lancer une perso (ex: client en prod,...)"
"IDISPJB";"S";"0019";"*"
"IDISPJB";"S";"0020";"*         Par défaut les différents compteurs ne sont pas affichés"
"IDISPJB";"S";"0021";"*         s'il y a besoin cela devra être fait via la fonction PER"
"IDISPJB";"S";"0022";"*         Les consignes ainsi que le motif de consommation sont à"
"IDISPJB";"S";"0023";"*         créer via la fonction ACT"
"IDISPJB";"S";"0024";"*"
"IDISPJB";"S";"0025";"*"
"IDISPJB";"S";"0026";"* Gestion du Droit/Pris/solde d'un compteur en jour"
"IDISPJB";"S";"0027";"* Le droit est alimenté en début de période de référence définie"
"IDISPJB";"S";"0028";"* dans les données globales datées par une valeur définie dans les"
"IDISPJB";"S";"0029";"* données globales datées"
"IDISPJB";"S";"0030";"* le pris est alimenté par un motif alimenté dans les données globales"
"IDISPJB";"S";"0031";"* datées"
"IDISPJB";"S";"0032";"* Pas de gestion d'anomalie en cas de solde négatif (à créer si besoin)"
"IDISPJB";"S";"0033";"*"
"IDISPJB";"S";"0034";"*----------------------------------------------------------------------"
"IDISPJB";"S";"0035";"*"
"IDISPJB";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPJB";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPJB";"S";"0038";"* Objet        :"
"IDISPJB";"S";"0039";"*"
"IDISPJB";"S";"0040";"***********************************************************************"
"IDISPJB";"S";"0041";"*"
"IDISPJB";"S";"0042";"* Implémentation des données industrielles"
"IDISPJB";"S";"0043";"*"
"IDISPJB";"S";"0044";"DEBDICO"
"IDISPJB";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJB";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPJB";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPJB";"S";"0048";"   * en passant par la fonction PER"
"IDISPJB";"S";"0049";"   HJOU_IJRDJDISP2;N;N6,2;L;;;    56789;;IJRDJDISP2;V3;""Droit en jour disponible 2"";"
"IDISPJB";"S";"0050";"   HJOU_IJRCJDISP2;N;N6,2;L;;;    56789;;IJRCJDISP2;V3;""Pris en jour disponible 2"";"
"IDISPJB";"S";"0051";"   HJOU_IJRSJDISP2;N;N6,2;L;;;    56789;;IJRSJDISP2;V3;""Solde en jour disponible 2"";"
"IDISPJB";"S";"0052";"   EMPL_IEQSPDISP2;N;N6,2;L;;;     6789;;;V3;""Solde prévisionnel en jour disponible 2"";"
"IDISPJB";"S";"0053";"PARD_IDIDRDISP2;O;D10;X;;;123456789;;;C3;""Date RAZ compteur jour disponible 2"";"
"IDISPJB";"S";"0054";"PARD_IDIVDDISP2;O;N6,2;I;;;123456789;;;C3;""Valeur droit jour compteur disponible 2"";"
"IDISPJB";"S";"0055";"PARD_IDIVMDISP2;O;A10;X;;;123456789;II;;C2;""Motif compteur en jour disponible 2"";"
"IDISPJB";"S";"0056";"FINDICO"
"IDISPJB";"S";"0057";"*"
"IDISPJB";"S";"0058";"* Déclaration des donnees locales"
"IDISPJB";"S";"0059";"*"
"IDISPJB";"S";"0060";"DEF LOCA_VAL N2.1"
"IDISPJB";"S";"0061";"DEF LOCA_DATE D"
"IDISPJB";"S";"0062";"LOCA_DATE = "" """
"IDISPJB";"S";"0063";"DEF LOCA_ACOURS N4"
"IDISPJB";"S";"0064";"LOCA_ACOURS = 0"
"IDISPJB";"S";"0065";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPJB";"S";"0066";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISP2,"
"IDISPJB";"S";"0067";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJB";"S";"0068";"* par la date souhaitée"
"IDISPJB";"S";"0069";"*"
"IDISPJB";"S";"0070";"** alimentation du droit à la date de référence"
"IDISPJB";"S";"0071";"** raz du consommé à la date de référence"
"IDISPJB";"S";"0072";"SI HJOU_DATE = PARD_IDIDRDISP2"
"IDISPJB";"S";"0073";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJB";"S";"0074";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPJB";"S";"0075";"   * par le nombre paramétré dans PARD_IDIVDDISP2,"
"IDISPJB";"S";"0076";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJB";"S";"0077";"   * par le nombre souhaité"
"IDISPJB";"S";"0078";"   HJOU_IJRDJDISP2 = PARD_IDIVDDISP2"
"IDISPJB";"S";"0079";"   HJOU_IJRCJDISP2 = 0"
"IDISPJB";"S";"0080";"FINSI"
"IDISPJB";"S";"0081";"** alimentation du pris"
"IDISPJB";"S";"0082";"POUR ACTIVITES"
"IDISPJB";"S";"0083";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJB";"S";"0084";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISP2,"
"IDISPJB";"S";"0085";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPJB";"S";"0086";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPJB";"S";"0087";"   * pas il devra être créé)"
"IDISPJB";"S";"0088";"   SI HABS_MOTIF = PARD_IDIVMDISP2"
"IDISPJB";"S";"0089";"      SI HABS_MOTIDUR > 0"
"IDISPJB";"S";"0090";"         SI HABS_VALORIS = ""J"""
"IDISPJB";"S";"0091";"            LOCA_VAL = 1"
"IDISPJB";"S";"0092";"         SINON"
"IDISPJB";"S";"0093";"            LOCA_VAL = 0.5"
"IDISPJB";"S";"0094";"         FINSI"
"IDISPJB";"S";"0095";"      FINSI"
"IDISPJB";"S";"0096";"      HJOU_IJRCJDISP2 = HJOU_IJRCJDISP2 + LOCA_VAL"
"IDISPJB";"S";"0097";"      LOCA_VAL = 0"
"IDISPJB";"S";"0098";"   FINSI"
"IDISPJB";"S";"0099";"FINPOUR"
"IDISPJB";"S";"0100";"** alimentation du droit/pris par consignes"
"IDISPJB";"S";"0101";"POUR ACTIVITES"
"IDISPJB";"S";"0102";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJB";"S";"0103";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPJB";"S";"0104";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPJB";"S";"0105";"   * en conséquence)"
"IDISPJB";"S";"0106";"   SI HABS_MOTIF = ""ZDDIS2"""
"IDISPJB";"S";"0107";"      HJOU_IJRDJDISP2 = HABS_MOTINBR"
"IDISPJB";"S";"0108";"   FINSI"
"IDISPJB";"S";"0109";"   SI HABS_MOTIF = ""XDDIS2"""
"IDISPJB";"S";"0110";"      HJOU_IJRDJDISP2 = HJOU_IJRDJDISP2 + HABS_MOTINBR"
"IDISPJB";"S";"0111";"   FINSI"
"IDISPJB";"S";"0112";"   SI HABS_MOTIF = ""ZCDIS2"""
"IDISPJB";"S";"0113";"      HJOU_IJRCJDISP2 = HABS_MOTINBR"
"IDISPJB";"S";"0114";"   FINSI"
"IDISPJB";"S";"0115";"   SI HABS_MOTIF = ""XCDIS2"""
"IDISPJB";"S";"0116";"      HJOU_IJRCJDISP2 = HJOU_IJRCJDISP2 + HABS_MOTINBR"
"IDISPJB";"S";"0117";"   FINSI"
"IDISPJB";"S";"0118";"FINPOUR"
"IDISPJB";"S";"0119";"** calcul du solde"
"IDISPJB";"S";"0120";"HJOU_IJRSJDISP2 = HJOU_IJRDJDISP2 - HJOU_IJRCJDISP2"
"IDISPJB";"S";"0121";"LOCA_ACOURS << PARD_IDIDRDISP2(1:4)"
"IDISPJB";"S";"0122";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPJB";"S";"0123";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPJB";"S";"0124";"LOCA_DATE(5:4) = PARD_IDIDRDISP2(5:4)"
"IDISPJB";"S";"0125";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPJB";"S";"0126";"   EMPL_IEQSPDISP2 = HJOU_IJRSJDISP2"
"IDISPJB";"S";"0127";"FINSI"
"IDISPJB";"S";"0128";"FIN"
