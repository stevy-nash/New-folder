"SGRJF";"S";"0035";"   HJOU_SJRCRJFW;N;N6,2;I;;;     6789;;SJRCRJFW;V3;""Pris RJF en attente"";"
"SGRJF";"S";"0036";"   HJOU_SJRACQRJF;N;N9,5;L;;;     6789;;;V3;""Acquis RJF annuel intermédiaire"";"
"SGRJF";"S";"0037";"   HJOU_SJIGRJF;O;Z1;X;;;      789;L;;C2;""Droit au RJF"";"
