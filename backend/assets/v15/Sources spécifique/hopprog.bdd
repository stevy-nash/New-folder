"SDRCP";"S";"0066";"FINDICO"
"SDRCP";"S";"0067";"*"
"SDRCP";"S";"0068";"* Définition des données locales"
"SDRCP";"S";"0069";"*"
"SDRCP";"S";"0070";"DEF LOCA_DROIT N2"
"SDRCP";"S";"0071";"LOCA_DROIT = 0"
"SDRCP";"S";"0072";"DEF LOCA_DCP N6.1"
"SDRCP";"S";"0073";"LOCA_DCP = 0"
"SDRCP";"S";"0074";"*"
"SDRCP";"S";"0075";"SI HJOU_IJIACOPRIN = ""1"""
"SDRCP";"S";"0076";"   LOCA_DROIT = 1"
"SDRCP";"S";"0077";"FINSI"
"SDRCP";"S";"0078";"*"
"SDRCP";"S";"0079";"* Droit au CP ?"
"SDRCP";"S";"0080";"SI LOCA_DROIT = 1"
"SDRCP";"S";"0081";"*"
"SDRCP";"S";"0082";"* Par défaut on donne à minima un droit à 25 jours"
"SDRCP";"S";"0083";"   LOCA_DCP = 25"
"SDRCP";"S";"0084";"*"
"SDRCP";"S";"0085";"* On regarde si droit CP annuel forcé ?"
"SDRCP";"S";"0086";"   SI HJOU_SJIDRCPAN > 0"
"SDRCP";"S";"0087";"      LOCA_DCP = HJOU_SJIDRCPAN"
"SDRCP";"S";"0088";"   SINON"
"SDRCP";"S";"0089";"*"
