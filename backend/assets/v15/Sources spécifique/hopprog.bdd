"SANOM";"S";"0430";"*"
"SANOM";"S";"0431";"* Profil de nuit >>"
"SANOM";"S";"0432";"SI PROF_REDUIT = ""N"""
"SANOM";"S";"0433";"   LOCA_TRAV = ""AATRAVN"""
"SANOM";"S";"0434";"FINSI"
"SANOM";"S";"0435";"*"
"SANOM";"S";"0436";"* Si forfait jour"
"SANOM";"S";"0437";"SI HJOU_SJQFORFJR = ""1"""
"SANOM";"S";"0438";"   LOCA_TRAV = ""AATRAVF"""
"SANOM";"S";"0439";"FINSI"
"SANOM";"S";"0440";"*"
"SANOM";"S";"0441";"* Contrôle ABS"
"SANOM";"S";"0442";"POUR ACTIVITES"
"SANOM";"S";"0443";"   SI HABS_MOTYPE = ""A"""
"SANOM";"S";"0444";"      SI HABS_VALORIS = ""J"""
"SANOM";"S";"0445";"         LOCA_ABSJ = 1"
