"SSTC";"S";"0072";"*"
"SSTC";"S";"0073";"* Paiement des congés"
"SSTC";"S";"0074";"*"
"SSTC";"S";"0075";"* CP1 - en cours acquis"
"SSTC";"S";"0076";"   ENLEVER ""Y832"""
"SSTC";"S";"0077";"   AJOUTER ""Y832"" ""N"" HJOU_IJRSACQCP"
"SSTC";"S";"0078";"   HJOU_IJRPACQCP = HJOU_IJRPACQCP + HJOU_IJRSACQCP"
"SSTC";"S";"0079";"   HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"SSTC";"S";"0080";"*"
"SSTC";"S";"0081";"* CP2 - Acquis et autres congés CANC, CSUP, CMDF, CFRAC + Totalisation"
"SSTC";"S";"0082";"   ENLEVER ""Y833"""
"SSTC";"S";"0083";"   AJOUTER ""Y833"" ""N"" HJOU_IJRSGCONGE"
"SSTC";"S";"0084";"* RAZ des CP"
"SSTC";"S";"0085";"   HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + HJOU_IJRSCOPRIN"
"SSTC";"S";"0086";"   HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"SSTC";"S";"0087";"* RAZ des C. Anciennetés"
"SSTC";"S";"0088";"   HJOU_IJRCCOANCI = HJOU_IJRCCOANCI + HJOU_IJRSCOANCI"
"SSTC";"S";"0089";"   HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"SSTC";"S";"0090";"* RAZ des CSUP"
"SSTC";"S";"0091";"   HJOU_SJRCCSUP = HJOU_SJRCCSUP + HJOU_SJRSCSUP"
"SSTC";"S";"0092";"   HJOU_SJRSCSUP = HJOU_SJRDCSUP - HJOU_SJRCCSUP"
"SSTC";"S";"0093";"* RAZ des CMDF"
"SSTC";"S";"0094";"   HJOU_SJRCCMDF = HJOU_SJRCCMDF + HJOU_SJRSCMDF"
"SSTC";"S";"0095";"   HJOU_SJRSCMDF = HJOU_SJRDCMDF - HJOU_SJRCCMDF"
"SSTC";"S";"0096";"* RAZ des CFRAC"
"SSTC";"S";"0097";"   HJOU_IJRCCOFRAC = HJOU_IJRCCOFRAC + HJOU_IJRSCOFRAC"
"SSTC";"S";"0098";"   HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"SSTC";"S";"0099";"*"
"SSTC";"S";"0100";"****** Totalisation des Droits >>"
"SSTC";"S";"0101";"   HJOU_SJRDGCONGE = HJOU_IJRDCOPRIN"
"SSTC";"S";"0102";"   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_IJRDCOANCI"
"SSTC";"S";"0103";"   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_SJRDCSUP"
"SSTC";"S";"0104";"   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_SJRDCMDF"
"SSTC";"S";"0105";"   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_IJRDCOFRAC"
"SSTC";"S";"0106";"*   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_IJRDACQCP"
"SSTC";"S";"0107";"*"
"SSTC";"S";"0108";"****** Totalisation des Pris >>"
"SSTC";"S";"0109";"   HJOU_SJRCGCONGE = HJOU_IJRCCOPRIN"
"SSTC";"S";"0110";"   HJOU_SJRCGCONGE = HJOU_SJRCGCONGE + HJOU_IJRCCOANCI"
"SSTC";"S";"0111";"   HJOU_SJRCGCONGE = HJOU_SJRCGCONGE + HJOU_SJRCCSUP"
"SSTC";"S";"0112";"   HJOU_SJRCGCONGE = HJOU_SJRCGCONGE + HJOU_SJRCCMDF"
"SSTC";"S";"0113";"   HJOU_SJRCGCONGE = HJOU_SJRCGCONGE + HJOU_IJRCCOFRAC"
"SSTC";"S";"0114";"*   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_IJRDACQCP"
"SSTC";"S";"0115";"*"
"SSTC";"S";"0116";"****** Totalisation des Soldes >>"
"SSTC";"S";"0117";"   HJOU_IJRSGCONGE = HJOU_IJRSCOPRIN"
"SSTC";"S";"0118";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOANCI"
"SSTC";"S";"0119";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_SJRSCSUP"
"SSTC";"S";"0120";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_SJRSCMDF"
"SSTC";"S";"0121";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOFRAC"
"SSTC";"S";"0122";"*   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSACQCP"
"SSTC";"S";"0123";"*"
"SSTC";"S";"0124";"* RTT"
"SSTC";"S";"0125";"   ENLEVER ""Y830"""
"SSTC";"S";"0126";"   AJOUTER ""Y830"" ""N"" HJOU_IJRSNBJRTT"
"SSTC";"S";"0127";"   HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + HJOU_IJRSNBJRTT"
"SSTC";"S";"0128";"   HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"SSTC";"S";"0129";"*"
"SSTC";"S";"0130";"* CET"
"SSTC";"S";"0131";"   LOCA_SOLDECET = HJOU_IJRSOLDCET"
"SSTC";"S";"0132";"   ENLEVER ""7141"""
"SSTC";"S";"0133";"   AJOUTER ""7141"" ""N"" LOCA_SOLDECET"
"SSTC";"S";"0134";"   HJOU_SJRCOCET = HJOU_SJRCOCET + HJOU_IJRSOLDCET"
"SSTC";"S";"0135";"   HJOU_IJRSOLDCET = HJOU_SJRDRCET - HJOU_SJRCOCET"
"SSTC";"S";"0136";"*"
"SSTC";"S";"0137";"* CP reporté P1"
"SSTC";"S";"0138";"   ENLEVER ""YO63"""
"SSTC";"S";"0139";"   AJOUTER ""YO63"" ""N"" HJOU_SJRSPREP1"
"SSTC";"S";"0140";"   HJOU_SJRCPREP1 = HJOU_SJRCPREP1 + HJOU_SJRSPREP1"
"SSTC";"S";"0141";"   HJOU_SJRSPREP1 = HJOU_SJRDPREP1 - HJOU_SJRCPREP1"
"SSTC";"S";"0142";"   HJOU_SJRDAFREP1 = "" """
"SSTC";"S";"0143";"*"
"SSTC";"S";"0144";"* CP reporté P2"
"SSTC";"S";"0145";"   ENLEVER ""YO64"""
"SSTC";"S";"0146";"   AJOUTER ""YO64"" ""N"" HJOU_SJRSPREP2"
"SSTC";"S";"0147";"   HJOU_SJRCPREP2 = HJOU_SJRCPREP2 + HJOU_SJRSPREP2"
"SSTC";"S";"0148";"   HJOU_SJRSPREP2 = HJOU_SJRDPREP2 - HJOU_SJRCPREP2"
"SSTC";"S";"0149";"   HJOU_SJRDAFREP2 = "" """
"SSTC";"S";"0150";"*"
"SSTC";"S";"0151";"*"
"SSTC";"S";"0152";"* CP reporté P3"
"SSTC";"S";"0153";"   ENLEVER ""YO65"""
"SSTC";"S";"0154";"   AJOUTER ""YO65"" ""N"" HJOU_SJRSPREP3"
"SSTC";"S";"0155";"   HJOU_SJRCPREP3 = HJOU_SJRCPREP3 + HJOU_SJRSPREP3"
"SSTC";"S";"0156";"   HJOU_SJRSPREP3 = HJOU_SJRDPREP3 - HJOU_SJRCPREP3"
"SSTC";"S";"0157";"   HJOU_SJRDAFREP3 = "" """
"SSTC";"S";"0158";"*"
"SSTC";"S";"0159";"* CP reporté P4"
"SSTC";"S";"0160";"   ENLEVER ""YO66"""
"SSTC";"S";"0161";"   AJOUTER ""YO66"" ""N"" HJOU_SJRSPREP4"
"SSTC";"S";"0162";"   HJOU_SJRCPREP4 = HJOU_SJRCPREP4 + HJOU_SJRSPREP4"
"SSTC";"S";"0163";"   HJOU_SJRSPREP4 = HJOU_SJRDPREP4 - HJOU_SJRCPREP4"
"SSTC";"S";"0164";"   HJOU_SJRDAFREP4 = "" """
"SSTC";"S";"0165";"*"
"SSTC";"S";"0166";"* JJA - 08/02/2024 - RAZ de l'acquis mensuel"
"SSTC";"S";"0167";"   HJOU_SJRACQCPM = 0"
