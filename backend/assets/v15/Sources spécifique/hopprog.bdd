"SCONTR";"S";"0116";"   LOCA_IJRTTEFFEH = HJOU_IJRTTEFFEH"
"SCONTR";"S";"0117";"SINON"
"SCONTR";"S";"0118";"   SI HJOU_SJQEMPABS < 1"
"SCONTR";"S";"0119";"      LOCA_IJQTTEFFEJ = HJOU_IJQPRETHEJ"
"SCONTR";"S";"0120";"   FINSI"
"SCONTR";"S";"0121";"   LOCA_IJRTTEFFEH = HJOU_IJRPRETHEH"
"SCONTR";"S";"0122";"FINSI"
"SCONTR";"S";"0123";"*"
"SCONTR";"S";"0124";"SI HJOU_DATE <= TEMP_DATJOU"
"SCONTR";"S";"0125";"   LOCA_INBADG = HJOU_IJIGBADGEA"
"SCONTR";"S";"0126";"SINON"
"SCONTR";"S";"0127";"   LOCA_INBADG = ""0"""
"SCONTR";"S";"0128";"FINSI"
"SCONTR";"S";"0129";"*"
