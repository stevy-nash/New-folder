"SGCALJF";"S";"0164";"OU HJOU_SJQSOCIETE = ""VH"""
"SGCALJF";"S";"0165";"OU HJOU_SJQSOCIETE = ""HE"""
"SGCALJF";"S";"0166";"OU HJOU_SJQSOCIETE = ""YR"""
"SGCALJF";"S";"0167";"OU HJOU_SJQSOCIETE = ""IR"""
"SGCALJF";"S";"0168";"OU HJOU_SJQSOCIETE = ""ES"""
"SGCALJF";"S";"0169";"OU HJOU_SJQSOCIETE = ""BE"""
"SGCALJF";"S";"0170";"OU HJOU_SJQSOCIETE = ""RC"""
"SGCALJF";"S";"0171";"OU HJOU_SJQSOCIETE = ""PO"""
"SGCALJF";"S";"0172";"   CALENDRIER ""JSOL"""
"SGCALJF";"S";"0173";"   SI TEMP_CALEND = ""JSOL"""
"SGCALJF";"S";"0174";"      LOCA_JS = 1"
