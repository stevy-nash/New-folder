"STELETRAV";"S";"0028";"*"
"STELETRAV";"S";"0029";"* Implémentation des données industrielles"
"STELETRAV";"S";"0030";"*"
"STELETRAV";"S";"0031";"DEBDICO"
"STELETRAV";"S";"0032";"   HJOU_IJQTT;N;N4,1;I;;;    56789;;;V3;""Compteur télétravail"";"
"STELETRAV";"S";"0033";"   HJOU_SJRTTH;N;N4,1;I;;;    56789;;SJRTTH;V3;""Jour en télétravail hebdo"";"
"STELETRAV";"S";"0034";"   HJOU_SJRTTA;N;N5,1;I;;;    56789;;SJRTTA;V3;""Jour en télétravail annuel"";"
"STELETRAV";"S";"0035";"   PARD_SDIVMTT;O;A10;X;;;123456789;II;;C2;""Télétravail"";"
"STELETRAV";"S";"0036";"FINDICO"
"STELETRAV";"S";"0037";"*"
"STELETRAV";"S";"0038";"* Déclaration des donnees locales"
"STELETRAV";"S";"0039";"*"
"STELETRAV";"S";"0040";"DEF LOCA_ABS A3"
"STELETRAV";"S";"0041";"LOCA_ABS = "" """
"STELETRAV";"S";"0042";"DEF LOCA_TT A3"
"STELETRAV";"S";"0043";"LOCA_TT = "" """
"STELETRAV";"S";"0044";"DEF LOCA_PRIOABS Z1"
"STELETRAV";"S";"0045";"LOCA_PRIOABS = ""0"""
"STELETRAV";"S";"0046";"DEF LOCA_PRIOTT Z1"
"STELETRAV";"S";"0047";"LOCA_PRIOTT = ""0"""
"STELETRAV";"S";"0048";"DEF LOCA_MOTIF A10"
"STELETRAV";"S";"0049";"LOCA_MOTIF = "" """
"STELETRAV";"S";"0050";"DEF LOCA_ENLEVER N2"
"STELETRAV";"S";"0051";"LOCA_ENLEVER = 0"
"STELETRAV";"S";"0052";"*"
"STELETRAV";"S";"0053";"* JJA - 08/09/2025 - FFT025005816 : Annulation d'un télétravail si motif absence >>"
"STELETRAV";"S";"0054";"*"
"STELETRAV";"S";"0055";"DEF LOCA_VALORIS A2"
"STELETRAV";"S";"0056";"LOCA_VALORIS = "" """
"STELETRAV";"S";"0057";"DEF LOCA_VALOTT A2"
"STELETRAV";"S";"0058";"LOCA_VALOTT = "" """
"STELETRAV";"S";"0059";"DEF LOCA_ANNULTLT N2"
"STELETRAV";"S";"0060";"LOCA_ANNULTLT = 0"
"STELETRAV";"S";"0061";"DEF LOCA_ANNULKO N2"
"STELETRAV";"S";"0062";"LOCA_ANNULKO = 0"
"STELETRAV";"S";"0063";"*"
"STELETRAV";"S";"0064";"POUR ACTIVITES"
"STELETRAV";"S";"0065";"   SI HABS_MOTYPE = ""A"""
"STELETRAV";"S";"0066";"      SI MOTI_IMIGTTEFFE <> ""1"""
"STELETRAV";"S";"0067";"         LOCA_ANNULTLT = 1"
"STELETRAV";"S";"0068";"         LOCA_VALORIS = HABS_VALORIS"
"STELETRAV";"S";"0069";"      FINSI"
"STELETRAV";"S";"0070";"   FINSI"
"STELETRAV";"S";"0071";"   SI HABS_MOTIF = PARD_SDIVMTT"
"STELETRAV";"S";"0072";"      LOCA_VALOTT = HABS_VALORIS"
"STELETRAV";"S";"0073";"   FINSI"
"STELETRAV";"S";"0074";"FINPOUR"
"STELETRAV";"S";"0075";"*"
"STELETRAV";"S";"0076";"SI LOCA_ANNULTLT = 1"
"STELETRAV";"S";"0077";"* Supprime journée de télétravail"
"STELETRAV";"S";"0078";"   SI LOCA_VALORIS = ""J"""
"STELETRAV";"S";"0079";"      SI LOCA_VALOTT <> "" """
"STELETRAV";"S";"0080";"         ENLEVER PARD_SDIVMTT"
"STELETRAV";"S";"0081";"         ENLEVER PARD_SDIVMTT"
"STELETRAV";"S";"0082";"      SINON"
"STELETRAV";"S";"0083";"*         LOCA_ANNULKO = 1"
"STELETRAV";"S";"0084";"      FINSI"
"STELETRAV";"S";"0085";"   FINSI"
"STELETRAV";"S";"0086";"*"
"STELETRAV";"S";"0087";"* Supprime matin de télétravail"
"STELETRAV";"S";"0088";"   SI LOCA_VALORIS = ""M"""
"STELETRAV";"S";"0089";"      SI LOCA_VALOTT <> ""A"""
"STELETRAV";"S";"0090";"         ENLEVER PARD_SDIVMTT"
"STELETRAV";"S";"0091";"         ENLEVER PARD_SDIVMTT"
"STELETRAV";"S";"0092";"         SI LOCA_VALOTT = ""J"""
"STELETRAV";"S";"0093";"            ENLEVER PARD_SDIVMTT"
"STELETRAV";"S";"0094";"            AJOUTER PARD_SDIVMTT ""A"" PROF_ABSENS"
"STELETRAV";"S";"0095";"         FINSI"
"STELETRAV";"S";"0096";"      SINON"
"STELETRAV";"S";"0097";"         LOCA_ANNULKO = 1"
"STELETRAV";"S";"0098";"      FINSI"
"STELETRAV";"S";"0099";"   FINSI"
"STELETRAV";"S";"0100";"* Supprime après-midi de télétravail"
"STELETRAV";"S";"0101";"   SI LOCA_VALORIS = ""A"""
"STELETRAV";"S";"0102";"      SI LOCA_VALOTT <> ""M"""
"STELETRAV";"S";"0103";"         ENLEVER PARD_SDIVMTT"
"STELETRAV";"S";"0104";"         ENLEVER PARD_SDIVMTT"
"STELETRAV";"S";"0105";"         SI LOCA_VALOTT = ""J"""
"STELETRAV";"S";"0106";"            ENLEVER PARD_SDIVMTT"
"STELETRAV";"S";"0107";"            AJOUTER PARD_SDIVMTT ""M"" PROF_ABSENM"
"STELETRAV";"S";"0108";"         FINSI"
"STELETRAV";"S";"0109";"      SINON"
"STELETRAV";"S";"0110";"         LOCA_ANNULKO = 1"
"STELETRAV";"S";"0111";"      FINSI"
"STELETRAV";"S";"0112";"   FINSI"
"STELETRAV";"S";"0113";"FINSI"
"STELETRAV";"S";"0114";"*"
"STELETRAV";"S";"0115";"* JJA - 08/09/2025 - FFT025005816 <<"
"STELETRAV";"S";"0116";"*"
"STELETRAV";"S";"0117";"* RAZ >>"
"STELETRAV";"S";"0118";"SI HJOU_JOUR = ""1"""
"STELETRAV";"S";"0119";"   HJOU_SJRTTH = 0"
"STELETRAV";"S";"0120";"FINSI"
"STELETRAV";"S";"0121";"*"
"STELETRAV";"S";"0122";"SI HJOU_DATE(5:4) = ""0101"""
"STELETRAV";"S";"0123";"   HJOU_SJRTTA = 0"
"STELETRAV";"S";"0124";"FINSI"
"STELETRAV";"S";"0125";"*"
"STELETRAV";"S";"0126";"* Vérif si motif sur la journée"
"STELETRAV";"S";"0127";"POUR ACTIVITES"
"STELETRAV";"S";"0128";"   SI HABS_MOTYPE = ""A"""
"STELETRAV";"S";"0129";"      SI MOTI_IMIGTTEFFE <> ""1"""
"STELETRAV";"S";"0130";"         SI HABS_VALORIS <> ""H"""
"STELETRAV";"S";"0131";"            LOCA_ABS(1:2) = ""AB"""
"STELETRAV";"S";"0132";"            LOCA_ABS(3:1) = HABS_VALORIS"
"STELETRAV";"S";"0133";"            LOCA_PRIOABS = MOTI_PRIORITE"
"STELETRAV";"S";"0134";"         FINSI"
"STELETRAV";"S";"0135";"      FINSI"
"STELETRAV";"S";"0136";"   FINSI"
"STELETRAV";"S";"0137";"FINPOUR"
"STELETRAV";"S";"0138";"*"
"STELETRAV";"S";"0139";"*Le Motif/ consigne de la famille TT affiche le salarié en télétravail"
"STELETRAV";"S";"0140";"* sur la journée"
"STELETRAV";"S";"0141";"POUR ACTIVITES"
"STELETRAV";"S";"0142";"*   SI MOTI_FAMILLE = ""TT"""
"STELETRAV";"S";"0143";"   SI HABS_MOTIF = PARD_SDIVMTT"
"STELETRAV";"S";"0144";"      LOCA_MOTIF = HABS_MOTIF"
"STELETRAV";"S";"0145";"      SI HJOU_IJQPRETHEJ > 0"
"STELETRAV";"S";"0146";"         LOCA_TT(1:2) = ""TT"""
"STELETRAV";"S";"0147";"         LOCA_TT(3:1) = HABS_VALORIS"
"STELETRAV";"S";"0148";"         LOCA_PRIOTT = MOTI_PRIORITE"
"STELETRAV";"S";"0149";"      SINON"
"STELETRAV";"S";"0150";"         LOCA_ENLEVER = 1"
"STELETRAV";"S";"0151";"      FINSI"
"STELETRAV";"S";"0152";"   FINSI"
"STELETRAV";"S";"0153";"FINPOUR"
"STELETRAV";"S";"0154";"*"
"STELETRAV";"S";"0155";"* Cumul"
"STELETRAV";"S";"0156";"HJOU_SJRTTH = HJOU_SJRTTH + HJOU_IJQTT"
"STELETRAV";"S";"0157";"HJOU_SJRTTA = HJOU_SJRTTA + HJOU_IJQTT"
"STELETRAV";"S";"0158";"*"
"STELETRAV";"S";"0159";"* Suppression si repos"
"STELETRAV";"S";"0160";"SI LOCA_ENLEVER = 1"
"STELETRAV";"S";"0161";"   ENLEVER LOCA_MOTIF"
"STELETRAV";"S";"0162";"   ENLEVER LOCA_MOTIF"
"STELETRAV";"S";"0163";"FINSI"
"STELETRAV";"S";"0164";"*"
"STELETRAV";"S";"0165";"* Contrôle de la saisie avec absences >>"
"STELETRAV";"S";"0166";"SI LOCA_TT <> "" """
"STELETRAV";"S";"0167";"   SI LOCA_ABS <> "" """
"STELETRAV";"S";"0168";"* Même valorisation ?"
"STELETRAV";"S";"0169";"      SI LOCA_ABS(3:1) = LOCA_TT(3:1)"
"STELETRAV";"S";"0170";"      OU LOCA_ABS(3:1) = ""J"""
"STELETRAV";"S";"0171";"* Si priorité > prio TT"
"STELETRAV";"S";"0172";"         SI LOCA_PRIOABS > LOCA_PRIOTT"
"STELETRAV";"S";"0173";"            ANOMALIE 261"
"STELETRAV";"S";"0174";"            SI TEMP_CNMOTIF = PARD_SDIVMTT"
"STELETRAV";"S";"0175";"               TEMP_CNRETOUR = 2"
"STELETRAV";"S";"0176";"               TEMP_CNMESS = 261"
"STELETRAV";"S";"0177";"            FINSI"
"STELETRAV";"S";"0178";"            LOCA_TT = "" """
"STELETRAV";"S";"0179";"*            ENLEVER LOCA_MOTIF"
"STELETRAV";"S";"0180";"*            ENLEVER LOCA_MOTIF"
"STELETRAV";"S";"0181";"         SINON"
"STELETRAV";"S";"0182";"            ANOMALIE 261"
"STELETRAV";"S";"0183";"            SI TEMP_CNMOTIF = PARD_SDIVMTT"
"STELETRAV";"S";"0184";"               TEMP_CNRETOUR = 2"
"STELETRAV";"S";"0185";"               TEMP_CNMESS = 261"
"STELETRAV";"S";"0186";"            FINSI"
"STELETRAV";"S";"0187";"            LOCA_TT = "" """
"STELETRAV";"S";"0188";"         FINSI"
"STELETRAV";"S";"0189";"      SINON"
"STELETRAV";"S";"0190";"         SI LOCA_TT(3:1) = ""J"""
"STELETRAV";"S";"0191";"            ANOMALIE 261"
"STELETRAV";"S";"0192";"            SI TEMP_CNMOTIF = PARD_SDIVMTT"
"STELETRAV";"S";"0193";"               TEMP_CNRETOUR = 2"
"STELETRAV";"S";"0194";"               TEMP_CNMESS = 261"
"STELETRAV";"S";"0195";"            FINSI"
"STELETRAV";"S";"0196";"            LOCA_TT = "" """
"STELETRAV";"S";"0197";"         FINSI"
"STELETRAV";"S";"0198";"      FINSI"
"STELETRAV";"S";"0199";"   FINSI"
"STELETRAV";"S";"0200";"FINSI"
"STELETRAV";"S";"0201";"*"
"STELETRAV";"S";"0202";"SI LOCA_TT <> "" """
"STELETRAV";"S";"0203";"   SI LOCA_TT(3:1) = ""J"""
"STELETRAV";"S";"0204";"      SI PROF_ABSENM = 0"
"STELETRAV";"S";"0205";"      OU PROF_ABSENS = 0"
"STELETRAV";"S";"0206";"         HJOU_IJQTT = HJOU_IJQTT + 0.5"
"STELETRAV";"S";"0207";"      SINON"
"STELETRAV";"S";"0208";"         HJOU_IJQTT = HJOU_IJQTT + 1"
"STELETRAV";"S";"0209";"      FINSI"
"STELETRAV";"S";"0210";"   SINON"
"STELETRAV";"S";"0211";"      HJOU_IJQTT = HJOU_IJQTT + 0.5"
"STELETRAV";"S";"0212";"   FINSI"
"STELETRAV";"S";"0213";"FINSI"
"STELETRAV";"S";"0214";"*"
"STELETRAV";"S";"0215";"SI HJOU_IJQTT > 1"
"STELETRAV";"S";"0216";"   HJOU_IJQTT = 1"
"STELETRAV";"S";"0217";"FINSI"
"STELETRAV";"S";"0218";"*"
"STELETRAV";"S";"0219";"* Cumul"
"STELETRAV";"S";"0220";"HJOU_SJRTTH = HJOU_SJRTTH + HJOU_IJQTT"
"STELETRAV";"S";"0221";"HJOU_SJRTTA = HJOU_SJRTTA + HJOU_IJQTT"
"STELETRAV";"S";"0222";"*"
"STELETRAV";"S";"0223";"FIN"
"STELETRAV";"S";"0224";"*"
"STICKE";"S";"0001";"***********************************************************************"
"STICKE";"S";"0002";"*"
"STICKE";"S";"0003";"* Règle : STICKE"
