"SHSUPPDIM2";"S";"0852";"            FINSI"
"SHSUPPDIM2";"S";"0853";"            HJOU_SJQTHSHC = LOCA_HSUP"
"SHSUPPDIM2";"S";"0854";"         FINSI"
"SHSUPPDIM2";"S";"0855";"      SINON"
"SHSUPPDIM2";"S";"0856";"* Appréciation en fonction des HSUP saisies uniquement"
"SHSUPPDIM2";"S";"0857";"         LOCA_HSUP = HJOU_SJRHSPAIE + HJOU_SJRHSRECUP"
"SHSUPPDIM2";"S";"0858";"         HJOU_SJQTHSHC = LOCA_HSUP"
"SHSUPPDIM2";"S";"0859";"*"
"SHSUPPDIM2";"S";"0860";"      FINSI"
"SHSUPPDIM2";"S";"0861";"*"
"SHSUPPDIM2";"S";"0862";"* Cas de l'industrie >>"
"SHSUPPDIM2";"S";"0863";"      SI HJOU_SECTORI(1:3) = ""DIN"""
