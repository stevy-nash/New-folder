"SCALMAINT";"S";"0213";"*"
"SCALMAINT";"S";"0214";"* 1 à 4 ans"
"SCALMAINT";"S";"0215";"      SI LOCA_ANCA >= 0"
"SCALMAINT";"S";"0216";"         SI LOCA_ANCA < 5"
"SCALMAINT";"S";"0217";"            LOCA_NBJMAINT = 30"
"SCALMAINT";"S";"0218";"         FINSI"
"SCALMAINT";"S";"0219";"      FINSI"
"SCALMAINT";"S";"0220";"* 5 à 9 ans"
"SCALMAINT";"S";"0221";"      SI LOCA_ANCA >= 5"
"SCALMAINT";"S";"0222";"         SI LOCA_ANCA < 10"
"SCALMAINT";"S";"0223";"            LOCA_NBJMAINT = 45"
"SCALMAINT";"S";"0224";"         FINSI"
"SCALMAINT";"S";"0225";"      FINSI"
"SCALMAINT";"S";"0226";"* 10 à 19 ans"
"SCALMAINT";"S";"0227";"      SI LOCA_ANCA >= 10"
"SCALMAINT";"S";"0228";"         SI LOCA_ANCA < 20"
"SCALMAINT";"S";"0229";"            LOCA_NBJMAINT = 60"
"SCALMAINT";"S";"0230";"         FINSI"
"SCALMAINT";"S";"0231";"      FINSI"
"SCALMAINT";"S";"0232";"* Supérieur ou égal à 20 ans"
"SCALMAINT";"S";"0233";"      SI LOCA_ANCA >= 20"
"SCALMAINT";"S";"0234";"         LOCA_NBJMAINT = 90"
"SCALMAINT";"S";"0235";"      FINSI"
"SCALMAINT";"S";"0236";"*"
"SCALMAINT";"S";"0237";"   FINSI"
"SCALMAINT";"S";"0238";"*"
"SCALMAINT";"S";"0239";"FINSI"
