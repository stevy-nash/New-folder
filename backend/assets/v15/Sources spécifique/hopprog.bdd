"SHSUPPDIM2";"S";"0322";"*"
"SHSUPPDIM2";"S";"0323";"* Alimentation des données locales pour calcul soldes prévisionnels"
"SHSUPPDIM2";"S";"0324";"*"
"SHSUPPDIM2";"S";"0325";"SI PARD_IDIDDEBANN <> "" """
"SHSUPPDIM2";"S";"0326";"   LOCA_DATE(5:4) = PARD_IDIDDEBANN(5:4)"
"SHSUPPDIM2";"S";"0327";"SINON"
"SHSUPPDIM2";"S";"0328";"   LOCA_DATE(5:4) = ""0101"""
"SHSUPPDIM2";"S";"0329";"FINSI"
"SHSUPPDIM2";"S";"0330";"**"
"SHSUPPDIM2";"S";"0331";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"SHSUPPDIM2";"S";"0332";"LOCA_ACOURS2 = LOCA_ACOURS + 1"
"SHSUPPDIM2";"S";"0333";"*"
"SHSUPPDIM2";"S";"0334";"SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"SHSUPPDIM2";"S";"0335";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"SHSUPPDIM2";"S";"0336";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"SHSUPPDIM2";"S";"0337";"FINSI"
"SHSUPPDIM2";"S";"0338";"*"
"SHSUPPDIM2";"S";"0339";"LOCA_DATEFU(1:4) << LOCA_ACOURS"
"SHSUPPDIM2";"S";"0340";"LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"SHSUPPDIM2";"S";"0341";"LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"SHSUPPDIM2";"S";"0342";"LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"SHSUPPDIM2";"S";"0343";"*"
"SHSUPPDIM2";"S";"0344";"***** Init des données locales >> ******************************************************************"
"SHSUPPDIM2";"S";"0345";"*"
"SHSUPPDIM2";"S";"0346";"* LOCA_GESTHS = 1 Pas de calcul HS"
"SHSUPPDIM2";"S";"0347";"* LOCA_GESTHS = 2 Calcul des HS chaque dimanche"
"SHSUPPDIM2";"S";"0348";"* LOCA_GESTHS = 3 Calcul des HS le dernier dimanche du cycle"
"SHSUPPDIM2";"S";"0349";"* LOCA_GESTHS = 4 Calcul des HS jour par jour pour industrie"
"SHSUPPDIM2";"S";"0350";"*"
"SHSUPPDIM2";"S";"0351";"* Déduction du mode de gestion des HS ?"
"SHSUPPDIM2";"S";"0352";"SI HJOU_IJIGHSUPPM = ""0"""
"SHSUPPDIM2";"S";"0353";"   LOCA_GESTHS = HORC_SHIGHSUPPM"
"SHSUPPDIM2";"S";"0354";"* FFT025003825 >>"
"SHSUPPDIM2";"S";"0355";"   SI HJOU_SJITYPSERV = ""PFI"""
"SHSUPPDIM2";"S";"0356";"      LOCA_GESTHS = ""4"""
"SHSUPPDIM2";"S";"0357";"   FINSI"
"SHSUPPDIM2";"S";"0358";"SINON"
"SHSUPPDIM2";"S";"0359";"   LOCA_GESTHS = HJOU_IJIGHSUPPM"
"SHSUPPDIM2";"S";"0360";"FINSI"
"SHSUPPDIM2";"S";"0361";"*"
"SHSUPPDIM2";"S";"0362";"SI LOCA_GESTHS = ""0"""
"SHSUPPDIM2";"S";"0363";"OU LOCA_GESTHS = ""1"""
"SHSUPPDIM2";"S";"0364";"OU LOCA_GESTHS = ""4"""
"SHSUPPDIM2";"S";"0365";"   HJOU_SJRHSPRC = "" """
"SHSUPPDIM2";"S";"0366";"   HJOU_IJRBHSMPAH = 0"
"SHSUPPDIM2";"S";"0367";"   HJOU_IJRTHEOCYC = 0"
"SHSUPPDIM2";"S";"0368";"   HJOU_IJRBHPAYEE = 0"
"SHSUPPDIM2";"S";"0369";"   HJOU_SJRHSPAIE = 0"
"SHSUPPDIM2";"S";"0370";"   HJOU_SJRHSRECUP = 0"
"SHSUPPDIM2";"S";"0371";"FINSI"
"SHSUPPDIM2";"S";"0372";"*"
"SHSUPPDIM2";"S";"0373";"SI HJOU_JOUR = ""1"""
"SHSUPPDIM2";"S";"0374";"   SI LOCA_GESTHS = ""2"""
"SHSUPPDIM2";"S";"0375";"      HJOU_SJRHSPRC = "" """
"SHSUPPDIM2";"S";"0376";"      HJOU_SJRHSPAIE = 0"
"SHSUPPDIM2";"S";"0377";"      HJOU_SJRHSRECUP = 0"
"SHSUPPDIM2";"S";"0378";"   FINSI"
"SHSUPPDIM2";"S";"0379";"* Raz le premier lundi du cycle si LOCA_GESTHS = 3"
"SHSUPPDIM2";"S";"0380";"   SI LOCA_GESTHS = ""3"""
"SHSUPPDIM2";"S";"0381";"      SI HJOU_RANG = 1"
"SHSUPPDIM2";"S";"0382";"         HJOU_SJRHSPRC = "" """
"SHSUPPDIM2";"S";"0383";"         HJOU_SJRHSPAIE = 0"
"SHSUPPDIM2";"S";"0384";"         HJOU_SJRHSRECUP = 0"
