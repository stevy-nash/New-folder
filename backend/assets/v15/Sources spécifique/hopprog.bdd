"SGDH";"S";"0064";"LOCA_FERI = 0"
"SGDH";"S";"0065";"DEF LOCA_DDH N6.2"
"SGDH";"S";"0066";"LOCA_DDH = 0"
"SGDH";"S";"0067";"DEF LOCA_STOPACQ N2"
"SGDH";"S";"0068";"LOCA_STOPACQ = 0"
"SGDH";"S";"0069";"DEF LOCA_ABIS N2"
"SGDH";"S";"0070";"LOCA_ABIS = 0"
"SGDH";"S";"0071";"DEF LOCA_ACQ N8.6"
"SGDH";"S";"0072";"LOCA_ACQ = 0"
"SGDH";"S";"0073";"DEF LOCA_SEUILABAT N6.2"
"SGDH";"S";"0074";"LOCA_SEUILABAT = 0"
