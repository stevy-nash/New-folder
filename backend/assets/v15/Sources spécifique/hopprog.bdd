"IRCNUIT";"S";"0001";"**********************************************************************"
"IRCNUIT";"S";"0002";"*"
"IRCNUIT";"S";"0003";"* Règle : IRCNUIT"
"IRCNUIT";"S";"0004";"* Ordre : 8000"
"IRCNUIT";"S";"0005";"* Titre : Repos compensateur de nuit"
"IRCNUIT";"S";"0006";"*"
"IRCNUIT";"S";"0007";"*---------------------------------------------------------------------"
"IRCNUIT";"S";"0008";"*"
"IRCNUIT";"S";"0009";"* Créé par : Cellule Industrialisation"
"IRCNUIT";"S";"0010";"* Date     : 14/10/2015"
"IRCNUIT";"S";"0011";"* Version  : 1"
"IRCNUIT";"S";"0012";"*"
"IRCNUIT";"S";"0013";"*---------------------------------------------------------------------"
"IRCNUIT";"S";"0014";"*"
"IRCNUIT";"S";"0015";"*"
"IRCNUIT";"S";"0016";"* Rôle :"
"IRCNUIT";"S";"0017";"*"
"IRCNUIT";"S";"0018";"* Acquisition du RC de nuit"
"IRCNUIT";"S";"0019";"*"
"IRCNUIT";"S";"0020";"*"
"IRCNUIT";"S";"0021";"*----------------------------------------------------------------------"
"IRCNUIT";"S";"0022";"*"
"IRCNUIT";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"IRCNUIT";"S";"0024";"* Date         : JJ/MM/AAAA"
"IRCNUIT";"S";"0025";"* Objet        :"
"IRCNUIT";"S";"0026";"*"
"IRCNUIT";"S";"0027";"***********************************************************************"
"IRCNUIT";"S";"0028";"*"
"IRCNUIT";"S";"0029";"* Définition du travail de nuit selon l'accord national sur le travail de nuit"
"IRCNUIT";"S";"0030";"* dans la métallurgie du 3 janvier 2002"
"IRCNUIT";"S";"0031";"*"
"IRCNUIT";"S";"0032";"* Implémentation des données industrielles"
"IRCNUIT";"S";"0033";"*"
"IRCNUIT";"S";"0034";"DEBDICO"
"IRCNUIT";"S";"0035";"   PARD_IDIREFRCN;O;A4;X;;;123456789;;;C3;""Date de référence RC de nuit (JJMM)"";"
"IRCNUIT";"S";"0036";"   HJOU_IJRHNUITAN;N;T8,2;L;;;123456789;;IJRHNUITAN;V3;""Cumul heures de nuit annuel"";"
"IRCNUIT";"S";"0037";"   HJOU_IJRNBRSEMN;N;N2;I;;;123456789;;IJRNBRSEMN;V3;""Nombre de semaines de nuit"";"
"IRCNUIT";"S";"0038";"   HJOU_IJRNBRNUIT;N;N2;I;;;123456789;;IJRNBRNUIT;V3;""Nombre de nuits par semaine"";"
"IRCNUIT";"S";"0039";"   HJOU_IJRRCNUIT;N;T8,2;L;;;    56789;;IJRRCNUIT;V3;""Solde du RC de nuit"";"
"IRCNUIT";"S";"0040";"FINDICO"
"IRCNUIT";"S";"0041";"*"
"IRCNUIT";"S";"0042";"*"
"IRCNUIT";"S";"0043";"DEBANO"
"IRCNUIT";"S";"0044";"   182;9;""Solde RC nuit insuffisant"";"
"IRCNUIT";"S";"0045";"FINANO"
"IRCNUIT";"S";"0046";"*"
"IRCNUIT";"S";"0047";"* Définition des variables locales"
"IRCNUIT";"S";"0048";"DEF LOCA_DATE D"
"IRCNUIT";"S";"0049";"DEF LOCA_REF N2"
"IRCNUIT";"S";"0050";"DEF LOCA_RCNUIT T6.2"
"IRCNUIT";"S";"0051";"LOCA_RCNUIT = 0"
"IRCNUIT";"S";"0052";"*"
"IRCNUIT";"S";"0053";"* stockage du mois de reference"
"IRCNUIT";"S";"0054";"*"
"IRCNUIT";"S";"0055";"LOCA_REF << PARD_IDIREFRCN(3:2)"
"IRCNUIT";"S";"0056";"* stokage du mois de reference"
"IRCNUIT";"S";"0057";"*"
"IRCNUIT";"S";"0058";"LOCA_DATE(5:2) << LOCA_REF"
"IRCNUIT";"S";"0059";"* stockage du jour de reference"
"IRCNUIT";"S";"0060";"*"
"IRCNUIT";"S";"0061";"LOCA_REF << PARD_IDIREFRCN(1:2)"
"IRCNUIT";"S";"0062";"* loca_date contient maintenant l'année du jour de l'historique"
"IRCNUIT";"S";"0063";"* et le mois et le jour de reference"
"IRCNUIT";"S";"0064";"LOCA_DATE(7:2) << LOCA_REF"
"IRCNUIT";"S";"0065";"*"
"IRCNUIT";"S";"0066";"*"
"IRCNUIT";"S";"0067";"* RAZ Nbre de semaines de nuit / heures badgées de nuit"
"IRCNUIT";"S";"0068";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IRCNUIT";"S";"0069";"   HJOU_IJRNBRSEMN = 0"
"IRCNUIT";"S";"0070";"   HJOU_IJRHNUITAN = 0"
"IRCNUIT";"S";"0071";"FINSI"
"IRCNUIT";"S";"0072";"*"
"IRCNUIT";"S";"0073";"*"
"IRCNUIT";"S";"0074";"*"
"IRCNUIT";"S";"0075";"* totalisation annuel des heures de nuit"
"IRCNUIT";"S";"0076";"*"
"IRCNUIT";"S";"0077";"SI HJOU_DATE <= TEMP_DATJOU"
"IRCNUIT";"S";"0078";"   HJOU_IJRHNUITAN = HJOU_IJRHNUITAN + HJOU_IJQHNUITBA"
"IRCNUIT";"S";"0079";"** RAZ Nbre de nuits"
"IRCNUIT";"S";"0080";"   SI HJOU_JOUR = ""1"""
"IRCNUIT";"S";"0081";"   OU HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IRCNUIT";"S";"0082";"      HJOU_IJRNBRNUIT = 0"
"IRCNUIT";"S";"0083";"   FINSI"
"IRCNUIT";"S";"0084";"* Alimentation du compteur lorsque l'agent a fait au moins 3 heures de nuit"
"IRCNUIT";"S";"0085";"*"
"IRCNUIT";"S";"0086";"   SI HJOU_IJQHNUITBA >= 3.00"
"IRCNUIT";"S";"0087";"      HJOU_IJRNBRNUIT = HJOU_IJRNBRNUIT + 1"
"IRCNUIT";"S";"0088";"   FINSI"
"IRCNUIT";"S";"0089";"* en fin de semaine , si ce compteur >= 2 on decompte 1 semaine de nuit"
"IRCNUIT";"S";"0090";"   SI HJOU_JOUR = ""7"""
"IRCNUIT";"S";"0091";"      SI HJOU_IJRNBRNUIT >= 2"
"IRCNUIT";"S";"0092";"         HJOU_IJRNBRSEMN = HJOU_IJRNBRSEMN + 1"
"IRCNUIT";"S";"0093";"      FINSI"
"IRCNUIT";"S";"0094";"   FINSI"
"IRCNUIT";"S";"0095";"FINSI"
"IRCNUIT";"S";"0096";"** en fin de période de réference on compare le nombre d'heures de nuit Par rapport au seuil"
"IRCNUIT";"S";"0097";"SI TEMP_DATSUI(5:4) = LOCA_DATE(5:4)"
"IRCNUIT";"S";"0098";"   SI HJOU_IJRHNUITAN > PARD_IDISEUIRCN"
"IRCNUIT";"S";"0099";"      LOCA_RCNUIT = HJOU_IJRNBRSEMN * 0.20"
"IRCNUIT";"S";"0100";"      SI LOCA_RCNUIT >= 16.00"
"IRCNUIT";"S";"0101";"         LOCA_RCNUIT = 16"
"IRCNUIT";"S";"0102";"      FINSI"
"IRCNUIT";"S";"0103";"      HJOU_IJRRCNUIT = HJOU_IJRRCNUIT + LOCA_RCNUIT"
"IRCNUIT";"S";"0104";"   FINSI"
"IRCNUIT";"S";"0105";"FINSI"
"IRCNUIT";"S";"0106";"** consignes"
"IRCNUIT";"S";"0107";"POUR ACTIVITES"
"IRCNUIT";"S";"0108";"   SI HABS_MOTIF = ""ZRCNUIT"""
"IRCNUIT";"S";"0109";"      HJOU_IJRRCNUIT = HABS_MOTIDUR"
"IRCNUIT";"S";"0110";"   FINSI"
"IRCNUIT";"S";"0111";"   SI HABS_MOTIF = ""XRCNUIT"""
"IRCNUIT";"S";"0112";"      HJOU_IJRRCNUIT = HJOU_IJRRCNUIT + HABS_MOTIDUR"
"IRCNUIT";"S";"0113";"   FINSI"
"IRCNUIT";"S";"0114";"FINPOUR"
"IRCNUIT";"S";"0115";"** motif de récupération"
"IRCNUIT";"S";"0116";"POUR ACTIVITES"
"IRCNUIT";"S";"0117";"   SI HABS_MOTIF = ""RCNUIT"""
"IRCNUIT";"S";"0118";"      SI HJOU_IJRRCNUIT >= HABS_MOTIDUR"
"IRCNUIT";"S";"0119";"         HJOU_IJRRCNUIT = HJOU_IJRRCNUIT - HABS_MOTIDUR"
"IRCNUIT";"S";"0120";"      SINON"
"IRCNUIT";"S";"0121";"         ANOMALIE 182"
"IRCNUIT";"S";"0122";"      FINSI"
"IRCNUIT";"S";"0123";"   FINSI"
"IRCNUIT";"S";"0124";"FINPOUR"
"IRCNUIT";"S";"0125";"FIN"
"IREPQUORED";"S";"0001";"**********************************************************************"
"IREPQUORED";"S";"0002";"*"
"IREPQUORED";"S";"0003";"* Règle : IREPQUORED"
"IREPQUORED";"S";"0004";"* Ordre : 9030"
"IREPQUORED";"S";"0005";"* Titre : Repos quotidien réduit CCN Métallurgie"
"IREPQUORED";"S";"0006";"*"
"IREPQUORED";"S";"0007";"*----------------------------------------------------------------------"
"IREPQUORED";"S";"0008";"*"
"IREPQUORED";"S";"0009";"* Créé par : Méthodes & Outils"
"IREPQUORED";"S";"0010";"* Date     : 02/04/2023"
"IREPQUORED";"S";"0011";"* Version  : 1"
"IREPQUORED";"S";"0012";"*"
"IREPQUORED";"S";"0013";"*----------------------------------------------------------------------"
"IREPQUORED";"S";"0014";"*"
"IREPQUORED";"S";"0015";"*"
"IREPQUORED";"S";"0016";"* Rôle : CCN Métallurgie : gestion d'un RC alimenté par les"
"IREPQUORED";"S";"0017";"*        heures de réduction du repos quotidien de l'ensemble des salariés"
"IREPQUORED";"S";"0018";"*       dans le cas d'une dérogation au repos quotidien"
"IREPQUORED";"S";"0019";"***********************************************************************"
"IREPQUORED";"S";"0020";"* Création compteur"
"IREPQUORED";"S";"0021";"DEBDICO"
"IREPQUORED";"S";"0022";"   HJOU_IJRRQREDU;N;T8,2;L;;;     6789;;IJRRQREDU;V3;""Solde RC Repos réduit"";"
"IREPQUORED";"S";"0023";"   EMPL_IEQRQREDU;N;T8,2;L;;;     6789;;;V3;""Solde previsionnel RC repos réduit"";"
"IREPQUORED";"S";"0024";"   HORC_IHIDEREPOS;O;A1;X;0;1;123456789;C;;C2;""Dérogation repos quotidien"";"
"IREPQUORED";"S";"0025";"FINDICO"
"IREPQUORED";"S";"0026";"* Création anomalie"
"IREPQUORED";"S";"0027";"DEBANO"
"IREPQUORED";"S";"0028";"   163;7;""repos quotidien réduit : alimentation du RC repos quotiiden"";"
"IREPQUORED";"S";"0029";"   194;9;""Solde insuffisant"";"
"IREPQUORED";"S";"0030";"   195;5;""Repos quotidien inférieur à 9h"";"
"IREPQUORED";"S";"0031";"FINANO"
"IREPQUORED";"S";"0032";"*"
"IREPQUORED";"S";"0033";"* Déclaration des donnees locales"
"IREPQUORED";"S";"0034";"*"
"IREPQUORED";"S";"0035";"DEF LOCA_DERBADG T6.2"
"IREPQUORED";"S";"0036";"LOCA_DERBADG = 0"
"IREPQUORED";"S";"0037";"DEF LOCA_REPOS T6.2"
"IREPQUORED";"S";"0038";"LOCA_REPOS = 24.00"
"IREPQUORED";"S";"0039";"DEF LOCA_PREMBT T6.2"
"IREPQUORED";"S";"0040";"LOCA_PREMBT = 0"
"IREPQUORED";"S";"0041";"DEF LOCA_INBADG Z1"
"IREPQUORED";"S";"0042";"LOCA_INBADG = ""0"""
"IREPQUORED";"S";"0043";"DEF LOCA_PTTHEO1 N1"
"IREPQUORED";"S";"0044";"LOCA_PTTHEO1 = 0"
"IREPQUORED";"S";"0045";"DEF LOCA_PTTHEO4 N1"
"IREPQUORED";"S";"0046";"LOCA_PTTHEO4 = 0"
"IREPQUORED";"S";"0047";"DEF LOCA_DIFF T6.2"
"IREPQUORED";"S";"0048";"LOCA_DIFF = 0"
"IREPQUORED";"S";"0049";"DEF LOCA_11 T6.2"
"IREPQUORED";"S";"0050";"LOCA_11 = 11.00"
"IREPQUORED";"S";"0051";"*"
"IREPQUORED";"S";"0052";"*"
"IREPQUORED";"S";"0053";"* Gestion du compteur RC repos quotidien"
"IREPQUORED";"S";"0054";"*"
"IREPQUORED";"S";"0055";"* Mise à jour par consignes"
"IREPQUORED";"S";"0056";"POUR ACTIVITES"
"IREPQUORED";"S";"0057";"* Initialisation compteur"
"IREPQUORED";"S";"0058";"   SI HABS_MOTIF = ""ZRCRQ"""
"IREPQUORED";"S";"0059";"      HJOU_IJRRQREDU = HABS_MOTIDUR"
"IREPQUORED";"S";"0060";"   FINSI"
"IREPQUORED";"S";"0061";"* Mise à jour compteur"
"IREPQUORED";"S";"0062";"   SI HABS_MOTIF = ""XRCRQ"""
"IREPQUORED";"S";"0063";"      HJOU_IJRRQREDU = HJOU_IJRRQREDU + HABS_MOTIDUR"
"IREPQUORED";"S";"0064";"   FINSI"
"IREPQUORED";"S";"0065";"FINPOUR"
"IREPQUORED";"S";"0066";"*"
"IREPQUORED";"S";"0067";"*"
"IREPQUORED";"S";"0068";"SI HJOU_DATE <= TEMP_DATJOU"
"IREPQUORED";"S";"0069";"   LOCA_INBADG = HJOU_IJIGBADGEA"
"IREPQUORED";"S";"0070";"SINON"
"IREPQUORED";"S";"0071";"   LOCA_INBADG = ""0"""
"IREPQUORED";"S";"0072";"FINSI"
"IREPQUORED";"S";"0073";"*"
"IREPQUORED";"S";"0074";"* Calcul de la durée du repos quotidien"
"IREPQUORED";"S";"0075";"* dans le cas où il y a une dérogation légale :"
"IREPQUORED";"S";"0076";"*"
"IREPQUORED";"S";"0077";"SI HORC_IHIDEREPOS = ""1"""
"IREPQUORED";"S";"0078";"* Suppression de l'anomalie si générée dans règle 3400 ICONTR"
"IREPQUORED";"S";"0079";"   SUPANOM 132"
"IREPQUORED";"S";"0080";"   SI HJOU_IJQDEBADGV > 0"
"IREPQUORED";"S";"0081";"      SI HJOU_IJQPRBADGV > 0"
"IREPQUORED";"S";"0082";"         LOCA_REPOS = HJOU_IJQPRBADGV + 24.00"
"IREPQUORED";"S";"0083";"         LOCA_REPOS = LOCA_REPOS - HJOU_IJRSDBADGV"
"IREPQUORED";"S";"0084";"      FINSI"
"IREPQUORED";"S";"0085";"   FINSI"
"IREPQUORED";"S";"0086";"   SI LOCA_INBADG = ""0"""
"IREPQUORED";"S";"0087";"** Contrôle si la plage n'est pas à blanc"
"IREPQUORED";"S";"0088";"      SI PROF_PTTHEO1 > 0"
"IREPQUORED";"S";"0089";"         SI PROF_PTTHEO1 < 100"
"IREPQUORED";"S";"0090";"            LOCA_PTTHEO1 = 1"
"IREPQUORED";"S";"0091";"         FINSI"
"IREPQUORED";"S";"0092";"      FINSI"
"IREPQUORED";"S";"0093";"** Contrôle si la plage n'est pas à blanc"
"IREPQUORED";"S";"0094";"      SI PROF_PTTHEO4 > 0"
"IREPQUORED";"S";"0095";"         SI PROF_PTTHEO4 < 100"
"IREPQUORED";"S";"0096";"            LOCA_PTTHEO4 = 1"
"IREPQUORED";"S";"0097";"         FINSI"
"IREPQUORED";"S";"0098";"      FINSI"
"IREPQUORED";"S";"0099";"*"
"IREPQUORED";"S";"0100";"      SI LOCA_PTTHEO1 = 1"
"IREPQUORED";"S";"0101";"         LOCA_PREMBT = PROF_PTTHEO1"
"IREPQUORED";"S";"0102";"         SI LOCA_PTTHEO4 = 1"
"IREPQUORED";"S";"0103";"            HJOU_IJQDEBADGT = PROF_PTTHEO4"
"IREPQUORED";"S";"0104";"         SINON"
"IREPQUORED";"S";"0105";"            HJOU_IJQDEBADGT = PROF_PTTHEO2"
"IREPQUORED";"S";"0106";"         FINSI"
"IREPQUORED";"S";"0107";"         LOCA_REPOS = LOCA_PREMBT + 24.00"
"IREPQUORED";"S";"0108";"         LOCA_REPOS = LOCA_REPOS - HJOU_IJRDBADGTV"
"IREPQUORED";"S";"0109";"      SINON"
"IREPQUORED";"S";"0110";"         SI PROF_PTTHEO3 > 0"
"IREPQUORED";"S";"0111";"            SI PROF_PTTHEO3 < 100"
"IREPQUORED";"S";"0112";"               LOCA_PREMBT = PROF_PTTHEO3"
"IREPQUORED";"S";"0113";"               HJOU_IJQDEBADGT = PROF_PTTHEO4"
"IREPQUORED";"S";"0114";"               LOCA_REPOS = LOCA_PREMBT + 24.00"
"IREPQUORED";"S";"0115";"               LOCA_REPOS = LOCA_REPOS - HJOU_IJRDBADGTV"
"IREPQUORED";"S";"0116";"            FINSI"
"IREPQUORED";"S";"0117";"         FINSI"
"IREPQUORED";"S";"0118";"      FINSI"
"IREPQUORED";"S";"0119";"   FINSI"
"IREPQUORED";"S";"0120";"*"
"IREPQUORED";"S";"0121";"*"
"IREPQUORED";"S";"0122";"* Anomalie si repos quotidien < 9h"
"IREPQUORED";"S";"0123";"*"
"IREPQUORED";"S";"0124";"   SI LOCA_REPOS > 0"
"IREPQUORED";"S";"0125";"      SI LOCA_REPOS < 9.00"
"IREPQUORED";"S";"0126";"         ANOMALIE 195"
"IREPQUORED";"S";"0127";"      FINSI"
"IREPQUORED";"S";"0128";"*"
"IREPQUORED";"S";"0129";"* Alimentation du compteur RC pour repos réduit si repos quotidien"
"IREPQUORED";"S";"0130";"* est compris entre 9h et 11 heures"
"IREPQUORED";"S";"0131";"*"
"IREPQUORED";"S";"0132";"      SI LOCA_REPOS > 9.00"
"IREPQUORED";"S";"0133";"         SI LOCA_REPOS <= 11.00"
"IREPQUORED";"S";"0134";"            LOCA_DIFF = LOCA_11 - LOCA_REPOS"
"IREPQUORED";"S";"0135";"            HJOU_IJRRQREDU = HJOU_IJRRQREDU + LOCA_DIFF"
"IREPQUORED";"S";"0136";"            ANOMALIE 163"
"IREPQUORED";"S";"0137";"         FINSI"
"IREPQUORED";"S";"0138";"      FINSI"
"IREPQUORED";"S";"0139";"   FINSI"
"IREPQUORED";"S";"0140";"FINSI"
"IREPQUORED";"S";"0141";"*"
"IREPQUORED";"S";"0142";"* Récupération RC repos quotidien réduit"
"IREPQUORED";"S";"0143";"   POUR ACTIVITES"
"IREPQUORED";"S";"0144";"      SI HABS_MOTIF = ""RCRQ"""
"IREPQUORED";"S";"0145";"         SI HJOU_IJRRQREDU >= HABS_MOTIDUR"
"IREPQUORED";"S";"0146";"            HJOU_IJRRQREDU = HJOU_IJRRQREDU - HABS_MOTIDUR"
"IREPQUORED";"S";"0147";"         SINON"
"IREPQUORED";"S";"0148";"            ANOMALIE 194"
"IREPQUORED";"S";"0149";"         FINSI"
"IREPQUORED";"S";"0150";"      FINSI"
"IREPQUORED";"S";"0151";"* indemnisation du repos quotidien :"
"IREPQUORED";"S";"0152";"      SI HABS_MOTIF = ""YRCRQP"""
"IREPQUORED";"S";"0153";"         SI HJOU_IJRRQREDU >= HABS_MOTIDUR"
"IREPQUORED";"S";"0154";"            HJOU_IJRRQREDU = HJOU_IJRRQREDU - HABS_MOTIDUR"
"IREPQUORED";"S";"0155";"         SINON"
"IREPQUORED";"S";"0156";"            ANOMALIE 194"
"IREPQUORED";"S";"0157";"         FINSI"
"IREPQUORED";"S";"0158";"      FINSI"
"IREPQUORED";"S";"0159";"   FINPOUR"
"IREPQUORED";"S";"0160";"* Solde prévisionnel RC repos quotidien réduit"
"IREPQUORED";"S";"0161";"SI HJOU_DATE = EMPL_DATTRAI"
"IREPQUORED";"S";"0162";"   EMPL_IEQRQREDU = HJOU_IJRRQREDU"
"IREPQUORED";"S";"0163";"FINSI"
"IREPQUORED";"S";"0164";"FIN"
"IREPQUORED";"S";"0165";"*"
"ISOLDECP";"S";"0001";"***********************************************************************"
"ISOLDECP";"S";"0002";"*"
"ISOLDECP";"S";"0003";"* Règle : ISOLDECP"
"ISOLDECP";"S";"0004";"* Ordre : 3650"
"ISOLDECP";"S";"0005";"* Titre : Gestion du solde des congés payés"
"ISOLDECP";"S";"0006";"*"
"ISOLDECP";"S";"0007";"*----------------------------------------------------------------------"
"ISOLDECP";"S";"0008";"*"
"ISOLDECP";"S";"0009";"* Créé par : Méthodes et outils"
"ISOLDECP";"S";"0010";"* Date     : 06/05/2019"
"ISOLDECP";"S";"0011";"* Version  : 1"
"ISOLDECP";"S";"0012";"*"
"ISOLDECP";"S";"0013";"*----------------------------------------------------------------------"
"ISOLDECP";"S";"0014";"*"
"ISOLDECP";"S";"0015";"*"
"ISOLDECP";"S";"0016";"* Rôle : Gestion du solde des congés payés"
"ISOLDECP";"S";"0017";"*"
"ISOLDECP";"S";"0018";"*        Récupération de la partie calcul du solde des congés payés"
"ISOLDECP";"S";"0019";"*        de la règle ICONGE, ICONGEP et ICONGES du package indus V11 suite"
"ISOLDECP";"S";"0020";"*        à la division de la règle en droit / pris /solde"
"ISOLDECP";"S";"0021";"*"
"ISOLDECP";"S";"0022";"* Implémentation des données industrielles"
"ISOLDECP";"S";"0023";"*"
"ISOLDECP";"S";"0024";"*"
"ISOLDECP";"S";"0025";"*----------------------------------------------------------------------"
"ISOLDECP";"S";"0026";"*"
"ISOLDECP";"S";"0027";"* Modifiée par :"
"ISOLDECP";"S";"0028";"* Date         : JJ/MM/AAAA"
"ISOLDECP";"S";"0029";"* Objet        :"
"ISOLDECP";"S";"0030";"*"
"ISOLDECP";"S";"0031";"*"
"ISOLDECP";"S";"0032";"***********************************************************************"
"ISOLDECP";"S";"0033";"*"
"ISOLDECP";"S";"0034";"DEBDICO"
"ISOLDECP";"S";"0035";"   HJOU_IJRSCORELI;N;N6,1;I;;;    56789;;IJRSCORELI;V3;""Reliquat congé payé"";"
"ISOLDECP";"S";"0036";"   HJOU_IJRSCOPRIN;N;N6,1;I;;;    56789;;IJRSCOPRIN;V3;""Solde congé payé"";"
"ISOLDECP";"S";"0037";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"ISOLDECP";"S";"0038";"   HJOU_IJRSGCONGE;N;N6,2;I;;;    56789;;IJRSGCONGE;V3;""Solde global des congés"";"
"ISOLDECP";"S";"0039";"   EMPL_IEQSPGCONG;N;N6,1;I;;;    56789;;;V3;""Solde prévisionnel des congés"";"
"ISOLDECP";"S";"0040";"   EMPL_IEQSPGCON2;N;N6,1;I;;;    56789;;;V3;""Solde prév. global des congés période 2"";"
"ISOLDECP";"S";"0041";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"ISOLDECP";"S";"0042";"   HJOU_IJRCOVER;N;N5,2;I;;;    56789;;IJRCOVER;V3;""Jours de congés versés"";"
"ISOLDECP";"S";"0043";"   HORC_IHIMOACQCP;O;A1;X;;;123456789;L;;C3;""Mode d'acquisition des congés"";"
"ISOLDECP";"S";"0044";"   HJOU_IJRSACQCP;N;N6,2;I;;;    56789;;IJRSACQCP;V3;""Solde acquisition congé"";"
"ISOLDECP";"S";"0045";"   * CP sur jours travaillés"
"ISOLDECP";"S";"0046";"   HJOU_IJRSCPTRA;N;N5,1;I;;;    56789;;IJRSCPTRA;V3;""Solde CP travaillés"";"
"ISOLDECP";"S";"0047";"FINDICO"
"ISOLDECP";"S";"0048";"*"
"ISOLDECP";"S";"0049";"DEBANO"
"ISOLDECP";"S";"0050";"   156;9;""Solde CP insuffisant pour transfert en CET"";"
"ISOLDECP";"S";"0051";"   185;9;""Solde congés ancienneté insuffisant pour transfert en CET"";"
"ISOLDECP";"S";"0052";"   189;9;""Solde congés insuffisant pour transfert en don jours d'absence"";"
"ISOLDECP";"S";"0053";"FINANO"
"ISOLDECP";"S";"0054";"*"
"ISOLDECP";"S";"0055";"* Déclaration des donnees locales"
"ISOLDECP";"S";"0056";"* Variables utilisées pour calculer la date de reference"
"ISOLDECP";"S";"0057";"DEF LOCA_DATE D"
"ISOLDECP";"S";"0058";"DEF LOCA_DATEFU D"
"ISOLDECP";"S";"0059";"DEF LOCA_DATEFU2 D"
"ISOLDECP";"S";"0060";"DEF LOCA_ACOURS N4"
"ISOLDECP";"S";"0061";"DEF LOCA_ACOURS2 N4"
"ISOLDECP";"S";"0062";"DEF LOCA_REF N2"
"ISOLDECP";"S";"0063";"* stockage de l'année du jour de l'historique"
"ISOLDECP";"S";"0064";"LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"ISOLDECP";"S";"0065";"* stockage du mois de reference"
"ISOLDECP";"S";"0066";"LOCA_REF << CONF_ITIVMREFCP(3:2)"
"ISOLDECP";"S";"0067";"* stokage du mois de reference"
"ISOLDECP";"S";"0068";"LOCA_DATE(5:2) << LOCA_REF"
"ISOLDECP";"S";"0069";"* stockage du jour de reference"
"ISOLDECP";"S";"0070";"LOCA_REF << CONF_ITIVMREFCP(1:2)"
"ISOLDECP";"S";"0071";"* loca_date contient maintenant l'année du jour de l'historique"
"ISOLDECP";"S";"0072";"* et le mois et le jour de reference"
"ISOLDECP";"S";"0073";"LOCA_DATE(7:2) << LOCA_REF"
"ISOLDECP";"S";"0074";"* stockage de l'annee en cours"
"ISOLDECP";"S";"0075";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"ISOLDECP";"S";"0076";"LOCA_ACOURS2 = LOCA_ACOURS + 1"
"ISOLDECP";"S";"0077";"*"
"ISOLDECP";"S";"0078";"* calcul de la date de reference d'initialisation de cp"
"ISOLDECP";"S";"0079";"* et de date butoir  pour calculer le solde futur"
"ISOLDECP";"S";"0080";"SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"ISOLDECP";"S";"0081";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"ISOLDECP";"S";"0082";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"ISOLDECP";"S";"0083";"*"
"ISOLDECP";"S";"0084";"FINSI"
"ISOLDECP";"S";"0085";"LOCA_DATEFU(1:4) << LOCA_ACOURS"
"ISOLDECP";"S";"0086";"LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"ISOLDECP";"S";"0087";"LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"ISOLDECP";"S";"0088";"LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"ISOLDECP";"S";"0089";"*"
"ISOLDECP";"S";"0090";"* test si gestion des cp"
"ISOLDECP";"S";"0091";"SI HJOU_IJIACOPRIN = ""1"""
"ISOLDECP";"S";"0092";"   POUR ACTIVITES"
"ISOLDECP";"S";"0093";"** transfert de CP en CET"
"ISOLDECP";"S";"0094";"      SI HABS_MOTIF = ""YCPCET"""
"ISOLDECP";"S";"0095";"         SI HABS_MOTINBR <= HJOU_IJRSCOPRIN"
"ISOLDECP";"S";"0096";"            HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HABS_MOTINBR"
"ISOLDECP";"S";"0097";"*Jours de congés versés"
"ISOLDECP";"S";"0098";"            HJOU_IJRCOVER = HJOU_IJRCOVER + HABS_MOTINBR"
"ISOLDECP";"S";"0099";"            SI HORC_IHIDRNTRAV <> 0"
"ISOLDECP";"S";"0100";"               HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - HABS_MOTINBR"
"ISOLDECP";"S";"0101";"            FINSI"
"ISOLDECP";"S";"0102";"         SINON"
"ISOLDECP";"S";"0103";"* solde cp insuffisant pour transfert en CET"
"ISOLDECP";"S";"0104";"            ANOMALIE 156"
"ISOLDECP";"S";"0105";"            TEMP_ITQTRCPCET = 1"
"ISOLDECP";"S";"0106";"         FINSI"
"ISOLDECP";"S";"0107";"      FINSI"
"ISOLDECP";"S";"0108";"** transfert de CP ancienneté en CET"
"ISOLDECP";"S";"0109";"      SI HABS_MOTIF = ""YCACET"""
"ISOLDECP";"S";"0110";"         SI HABS_MOTINBR <= HJOU_IJRSCOANCI"
"ISOLDECP";"S";"0111";"            HJOU_IJRSCOANCI = HJOU_IJRSCOANCI - HABS_MOTINBR"
"ISOLDECP";"S";"0112";"         SINON"
"ISOLDECP";"S";"0113";"* solde cp ancienneté insuffisant pour transfert en CET"
"ISOLDECP";"S";"0114";"            ANOMALIE 185"
"ISOLDECP";"S";"0115";"            TEMP_ITQTRCACET = 1"
"ISOLDECP";"S";"0116";"         FINSI"
"ISOLDECP";"S";"0117";"      FINSI"
"ISOLDECP";"S";"0118";"** transfert de CP en don absence"
"ISOLDECP";"S";"0119";"      SI HABS_MOTIF = ""YCPDON"""
"ISOLDECP";"S";"0120";"         SI HABS_MOTINBR <= HJOU_IJRSCOPRIN"
"ISOLDECP";"S";"0121";"            HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - HABS_MOTINBR"
"ISOLDECP";"S";"0122";"*Jours de congés versés"
"ISOLDECP";"S";"0123";"            HJOU_IJRCOVER = HJOU_IJRCOVER + HABS_MOTINBR"
"ISOLDECP";"S";"0124";"            SI HORC_IHIDRNTRAV <> 0"
"ISOLDECP";"S";"0125";"               HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - HABS_MOTINBR"
"ISOLDECP";"S";"0126";"            FINSI"
"ISOLDECP";"S";"0127";"         SINON"
"ISOLDECP";"S";"0128";"* solde cp insuffisant pour transfert en don absence"
"ISOLDECP";"S";"0129";"            ANOMALIE 189"
"ISOLDECP";"S";"0130";"            TEMP_ITQTRCPDON = 1"
"ISOLDECP";"S";"0131";"         FINSI"
"ISOLDECP";"S";"0132";"      FINSI"
"ISOLDECP";"S";"0133";"   FINPOUR"
"ISOLDECP";"S";"0134";"*  totalisation des soldes***"
"ISOLDECP";"S";"0135";"   HJOU_IJRSGCONGE = HJOU_IJRSCORELI"
"ISOLDECP";"S";"0136";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOANCI"
"ISOLDECP";"S";"0137";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOPRIN"
"ISOLDECP";"S";"0138";"*   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSACQCP"
"ISOLDECP";"S";"0139";"*"
"ISOLDECP";"S";"0140";"   POUR ACTIVITES"
"ISOLDECP";"S";"0141";"      SI HABS_MOTIF = ""ZCJVER"""
"ISOLDECP";"S";"0142";"         HJOU_IJRCOVER = HABS_MOTINBR"
"ISOLDECP";"S";"0143";"      FINSI"
"ISOLDECP";"S";"0144";"      SI HABS_MOTIF = ""XCJVER"""
"ISOLDECP";"S";"0145";"         HJOU_IJRCOVER = HJOU_IJRCOVER + HABS_MOTINBR"
"ISOLDECP";"S";"0146";"      FINSI"
"ISOLDECP";"S";"0147";"   FINPOUR"
"ISOLDECP";"S";"0148";"*"
"ISOLDECP";"S";"0149";"* alimentation du solde prévisionnel"
"ISOLDECP";"S";"0150";"*"
"ISOLDECP";"S";"0151";"* ca ou l'employé a une date de fin de contrat ou date de cloture < loca_datefu"
"ISOLDECP";"S";"0152";"*"
"ISOLDECP";"S";"0153";"   SI CTRA_DATFIN > TEMP_DATJOU"
"ISOLDECP";"S";"0154";"      SI CTRA_DATFIN < LOCA_DATEFU"
"ISOLDECP";"S";"0155";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"ISOLDECP";"S";"0156";"         LOCA_DATEFU = TEMP_DXFINPER"
"ISOLDECP";"S";"0157";"      SINON"
"ISOLDECP";"S";"0158";"         SI CTRA_DATFIN < LOCA_DATEFU2"
"ISOLDECP";"S";"0159";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"ISOLDECP";"S";"0160";"            LOCA_DATEFU2 = TEMP_DXFINPER"
"ISOLDECP";"S";"0161";"         FINSI"
"ISOLDECP";"S";"0162";"      FINSI"
"ISOLDECP";"S";"0163";"   FINSI"
"ISOLDECP";"S";"0164";"***"
"ISOLDECP";"S";"0165";"   SI TEMP_DATSUI = LOCA_DATEFU"
"ISOLDECP";"S";"0166";"      EMPL_IEQSPGCONG = HJOU_IJRSGCONGE"
"ISOLDECP";"S";"0167";"   FINSI"
"ISOLDECP";"S";"0168";"   SI TEMP_DATSUI = LOCA_DATEFU2"
"ISOLDECP";"S";"0169";"      EMPL_IEQSPGCON2 = HJOU_IJRSGCONGE"
"ISOLDECP";"S";"0170";"   FINSI"
"ISOLDECP";"S";"0171";"FINSI"
"ISOLDECP";"S";"0172";"FIN"
