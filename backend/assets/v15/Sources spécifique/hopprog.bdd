"ITPSACTPTA";"S";"0043";"* FINANO"
"ITPSACTPTA";"S";"0044";"*"
"ITPSACTPTA";"S";"0045";"* Définition des variables locales"
"ITPSACTPTA";"S";"0046";"*"
"ITPSACTPTA";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTPTA";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTPTA";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTPTA";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTPTA";"S";"0051";"    FINSI"
"ITPSACTPTA";"S";"0052";"FINSI"
"ITPSACTPTA";"S";"0053";"* Employé géré en activité"
"ITPSACTPTA";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTPTA";"S";"0055";"   SI HJOU_IJIACTI <> ""0"""
"ITPSACTPTA";"S";"0056";"        * Calcul de la présence activité le dimanche"
"ITPSACTPTA";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTPTA";"S";"0058";"        SI HJOU_JOUR = ""7"""
"ITPSACTPTA";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTPTA";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTPTA";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTPTA";"S";"0062";"                * d'activité à justifier"
"ITPSACTPTA";"S";"0063";"                PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTPTA";"S";"0064";"                PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTPTA";"S";"0065";"                *"
"ITPSACTPTA";"S";"0066";"                SI PRES_MODE_TRV = "" """
"ITPSACTPTA";"S";"0067";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPTA";"S";"0068";"                FINSI"
"ITPSACTPTA";"S";"0069";"                *"
