"SGRTTJ";"S";"0166";"**"
"SGRTTJ";"S";"0167";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"SGRTTJ";"S";"0168";"LOCA_ACOURS2 = LOCA_ACOURS + 1"
"SGRTTJ";"S";"0169";"*"
"SGRTTJ";"S";"0170";"SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"SGRTTJ";"S";"0171";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"SGRTTJ";"S";"0172";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"SGRTTJ";"S";"0173";"*"
"SGRTTJ";"S";"0174";"FINSI"
