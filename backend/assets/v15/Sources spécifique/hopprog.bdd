"SROLE";"S";"0184";"* 2.4 SI Employé Industrie YR (EMPLINDYR)"
"SROLE";"S";"0185";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0186";"      SI EMPL_HORSECT(1:3) = ""DIN"""
"SROLE";"S";"0187";"         SI CTRA_SCISOCIETE = ""YR"""
"SROLE";"S";"0188";"            EMPL_SEQROLEC = ""EMPLINDYR"""
"SROLE";"S";"0189";"            LOCA_ROLE = 1"
"SROLE";"S";"0190";"         FINSI"
"SROLE";"S";"0191";"      FINSI"
"SROLE";"S";"0192";"   FINSI"
"SROLE";"S";"0193";"*"
"SROLE";"S";"0194";"* 2.5 SI Employé Rédaction RP (EMPLREDACR)"
"SROLE";"S";"0195";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0196";"      SI EMPL_HORSECT(1:3) = ""RED"""
"SROLE";"S";"0197";"         SI CTRA_SCISOCIETE = ""RC"""
"SROLE";"S";"0198";"            EMPL_SEQROLEC = ""EMPLREDACR"""
"SROLE";"S";"0199";"            LOCA_ROLE = 1"
"SROLE";"S";"0200";"         FINSI"
"SROLE";"S";"0201";"      FINSI"
"SROLE";"S";"0202";"   FINSI"
"SROLE";"S";"0203";"*"
"SROLE";"S";"0204";"* 2.6 SI Employé Rédaction (EMPLREDAC)"
"SROLE";"S";"0205";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0206";"      SI EMPL_HORSECT(1:3) = ""RED"""
"SROLE";"S";"0207";"*        SI CTRA_SCISOCIETE = ""RC"""
"SROLE";"S";"0208";"* BMO le 15/07/2025"
"SROLE";"S";"0209";"         SI CTRA_SCISTATUT <> ""E"""
"SROLE";"S";"0210";"            EMPL_SEQROLEC = ""EMPLREDAC"""
"SROLE";"S";"0211";"            LOCA_ROLE = 1"
"SROLE";"S";"0212";"         FINSI"
"SROLE";"S";"0213";"*         FINSI"
"SROLE";"S";"0214";"      FINSI"
"SROLE";"S";"0215";"   FINSI"
"SROLE";"S";"0216";"*"
"SROLE";"S";"0217";"* 2.7 SI Employé CFP (EMPLOYEPU)"
"SROLE";"S";"0218";"*"
"SROLE";"S";"0219";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0220";"      SI CTRA_SCISOCIETE = ""PU"""
"SROLE";"S";"0221";"         EMPL_SEQROLEC = ""EMPLOYEPU"""
"SROLE";"S";"0222";"         LOCA_ROLE = 1"
"SROLE";"S";"0223";"      FINSI"
"SROLE";"S";"0224";"   FINSI"
"SROLE";"S";"0225";"*"
"SROLE";"S";"0226";"* 2.8 SI Employé DSI (EMPLOYEDSI)"
"SROLE";"S";"0227";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0228";"      SI EMPL_HORSECT(1:3) = ""DSI"""
"SROLE";"S";"0229";"      OU EMPL_HORSECT(1:3) = ""TEC"""
"SROLE";"S";"0230";"         EMPL_SEQROLEC = ""EMPLOYEDSI"""
"SROLE";"S";"0231";"         LOCA_ROLE = 1"
"SROLE";"S";"0232";"      FINSI"
"SROLE";"S";"0233";"   FINSI"
"SROLE";"S";"0234";"*"
"SROLE";"S";"0235";"* 2.9 SI Employé EV/PE (EMPLOYEEV)"
"SROLE";"S";"0236";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0237";"      SI CTRA_SCISOCIETE = ""EV"""
"SROLE";"S";"0238";"      OU CTRA_SCISOCIETE = ""PE"""
"SROLE";"S";"0239";"         EMPL_SEQROLEC = ""EMPLOYEEV"""
"SROLE";"S";"0240";"         LOCA_ROLE = 1"
"SROLE";"S";"0241";"      FINSI"
"SROLE";"S";"0242";"   FINSI"
"SROLE";"S";"0243";"*"
"SROLE";"S";"0244";"* 2.10 Dans tous les autres cas : Employé Standard (EMPLOYE)"
"SROLE";"S";"0245";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0246";"      EMPL_SEQROLEC = ""EMPLOYE"""
"SROLE";"S";"0247";"      LOCA_ROLE = 1"
"SROLE";"S";"0248";"   FINSI"
"SROLE";"S";"0249";"*"
"SROLE";"S";"0250";"****************************************************************************************************"
"SROLE";"S";"0251";"* Définition du rôle à effecter"
"SROLE";"S";"0252";"****************************************************************************************************"
"SROLE";"S";"0253";"   SI EMPL_SEIROLEF = "" """
"SROLE";"S";"0254";"      EMPL_SEQROLES = EMPL_SEQROLEC"
"SROLE";"S";"0255";"   SINON"
"SROLE";"S";"0256";"      EMPL_SEQROLES = EMPL_SEIROLEF"
"SROLE";"S";"0257";"   FINSI"
"SROLE";"S";"0258";"*"
"SROLE";"S";"0259";"****************************************************************************************************"
"SROLE";"S";"0260";"* Gestion de la sélection de population pour les managers"
"SROLE";"S";"0261";"****************************************************************************************************"
"SROLE";"S";"0262";"   SI EMPL_SEIROLMA = ""1"""
"SROLE";"S";"0263";"      SI EMPL_SEIROLSR = ""1"""
"SROLE";"S";"0264";"         EMPL_SEIROLSC = "" """
"SROLE";"S";"0265";"      SINON"
"SROLE";"S";"0266";"* Sécurité: Si le groupeH n'est pas alimenter, il ne vera que lui alors par sécurité je n'affect pas"
"SROLE";"S";"0267";"* de sélection de population au role via le TRD > STXROLE."
"SROLE";"S";"0268";"         SI EMPL_GROUPH = "" """
"SROLE";"S";"0269";"            EMPL_SEIROLSC = "" """
"SROLE";"S";"0270";"         SINON"
"SROLE";"S";"0271";"            EMPL_SEIROLSC = HJOU_MATRI"
"SROLE";"S";"0272";"         FINSI"
"SROLE";"S";"0273";"      FINSI"
"SROLE";"S";"0274";"   SINON"
"SROLE";"S";"0275";"      EMPL_SEIROLSC = "" """
"SROLE";"S";"0276";"   FINSI"
"SROLE";"S";"0277";"*"
"SROLE";"S";"0278";"****************************************************************************************************"
"SROLE";"S";"0279";"FINSI"
"SROLE";"S";"0280";"*"
"SROLE";"S";"0281";"FIN"
"SSOLDECP";"S";"0001";"***********************************************************************"
"SSOLDECP";"S";"0002";"*"
"SSOLDECP";"S";"0003";"* Règle : SSOLDECP"
"SSOLDECP";"S";"0004";"* Ordre : 3665"
"SSOLDECP";"S";"0005";"* Titre : GCF : Gestion du solde des congés payés"
"SSOLDECP";"S";"0006";"*"
"SSOLDECP";"S";"0007";"*----------------------------------------------------------------------"
"SSOLDECP";"S";"0008";"*"
"SSOLDECP";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SSOLDECP";"S";"0010";"* Date     : 13/01/2025"
"SSOLDECP";"S";"0011";"* Version  : 1"
"SSOLDECP";"S";"0012";"*"
"SSOLDECP";"S";"0013";"*----------------------------------------------------------------------"
"SSOLDECP";"S";"0014";"*"
"SSOLDECP";"S";"0015";"*"
"SSOLDECP";"S";"0016";"* Rôle : Gestion du solde des congés payés"
"SSOLDECP";"S";"0017";"*"
"SSOLDECP";"S";"0018";"*        Récupération de la partie calcul du solde des congés payés"
"SSOLDECP";"S";"0019";"*        de la règle ICONGE, ICONGEP et ICONGES du package indus V11 suite"
"SSOLDECP";"S";"0020";"*        à la division de la règle en droit / pris /solde"
"SSOLDECP";"S";"0021";"*"
"SSOLDECP";"S";"0022";"* Implémentation des données industrielles"
"SSOLDECP";"S";"0023";"*"
"SSOLDECP";"S";"0024";"*"
"SSOLDECP";"S";"0025";"*----------------------------------------------------------------------"
"SSOLDECP";"S";"0026";"*"
"SSOLDECP";"S";"0027";"* Modifiée par :"
"SSOLDECP";"S";"0028";"* Date         : JJ/MM/AAAA"
"SSOLDECP";"S";"0029";"* Objet        :"
"SSOLDECP";"S";"0030";"*"
"SSOLDECP";"S";"0031";"*"
"SSOLDECP";"S";"0032";"***********************************************************************"
"SSOLDECP";"S";"0033";"*"
"SSOLDECP";"S";"0034";"DEBDICO"
"SSOLDECP";"S";"0035";"   HJOU_IJRSCORELI;N;N6,1;I;;;    56789;;IJRSCORELI;V3;""Reliquat congé payé"";"
"SSOLDECP";"S";"0036";"   HJOU_IJRSCOPRIN;N;N6,1;I;;;    56789;;IJRSCOPRIN;V3;""Solde congé payé"";"
"SSOLDECP";"S";"0037";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"SSOLDECP";"S";"0038";"   HJOU_IJRSGCONGE;N;N6,2;I;;;    56789;;IJRSGCONGE;V3;""Solde global des congés"";"
"SSOLDECP";"S";"0039";"   EMPL_IEQSPGCONG;N;N6,1;I;;;    56789;;;V3;""Solde prévisionnel des congés"";"
"SSOLDECP";"S";"0040";"   EMPL_IEQSPGCON2;N;N6,1;I;;;    56789;;;V3;""Solde prév. global des congés période 2"";"
"SSOLDECP";"S";"0041";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"SSOLDECP";"S";"0042";"   *   HJOU_IJRCOVER;N;N5,2;I;;;    56789;;IJRCOVER;V3;""Jours de congés versés"";"
"SSOLDECP";"S";"0043";"   HORC_IHIMOACQCP;O;A1;X;;;123456789;L;;C3;""Mode d'acquisition des congés"";"
"SSOLDECP";"S";"0044";"   HJOU_IJRSACQCP;N;N6,2;I;;;    56789;;IJRSACQCP;V3;""Solde acquisition congé"";"
"SSOLDECP";"S";"0045";"   *"
"SSOLDECP";"S";"0046";"   HJOU_SJRDGCONGE;N;N6,2;I;;;    56789;;SJRDGCONGE;V3;""Droit global des congés"";"
"SSOLDECP";"S";"0047";"   HJOU_SJRCGCONGE;N;N6,2;I;;;    56789;;SJRCGCONGE;V3;""Pris global des congés"";"
"SSOLDECP";"S";"0048";"   *"
"SSOLDECP";"S";"0049";"   EMPL_SEQSACQCPW;N;N6,1;I;;;    56789;;;V3;""Solde prév. CP en cours acquisition"";"
"SSOLDECP";"S";"0050";"   EMPL_SEQSCPREP1;N;N6,1;I;;;    56789;;;V3;""Solde prév. CP reporté P1"";"
"SSOLDECP";"S";"0051";"   EMPL_SEQSCPREP2;N;N6,1;I;;;    56789;;;V3;""Solde prév. CP reporté P2"";"
"SSOLDECP";"S";"0052";"   EMPL_SEQSCPREP3;N;N6,1;I;;;    56789;;;V3;""Solde prév. CP reporté P3"";"
"SSOLDECP";"S";"0053";"   EMPL_SEQSCPREP4;N;N6,1;I;;;    56789;;;V3;""Solde prév. CP reporté P4"";"
"SSOLDECP";"S";"0054";"   *"
"SSOLDECP";"S";"0055";"   EMPL_SEQCCP;N;N6,1;I;;;    56789;;;V3;""Pris prév. CP"";"
"SSOLDECP";"S";"0056";"   EMPL_SEQCCPA;N;N6,2;I;;;    56789;;;V3;""Pris prév. CP en cours acquis."";"
"SSOLDECP";"S";"0057";"FINDICO"
"SSOLDECP";"S";"0058";"*"
"SSOLDECP";"S";"0059";"DEBANO"
"SSOLDECP";"S";"0060";"   156;9;""Solde CP insuffisant pour transfert en CET"";"
"SSOLDECP";"S";"0061";"   185;9;""Solde congés ancienneté insuffisant pour transfert en CET"";"
"SSOLDECP";"S";"0062";"   189;9;""Solde congés insuffisant pour transfert en don jours d'absence"";"
"SSOLDECP";"S";"0063";"FINANO"
"SSOLDECP";"S";"0064";"*"
"SSOLDECP";"S";"0065";"* Déclaration des donnees locales"
"SSOLDECP";"S";"0066";"* Variables utilisées pour calculer la date de reference"
"SSOLDECP";"S";"0067";"DEF LOCA_DATE D"
"SSOLDECP";"S";"0068";"DEF LOCA_DATEFU D"
"SSOLDECP";"S";"0069";"DEF LOCA_DATEFU2 D"
"SSOLDECP";"S";"0070";"DEF LOCA_ACOURS N4"
"SSOLDECP";"S";"0071";"DEF LOCA_ACOURS2 N4"
"SSOLDECP";"S";"0072";"DEF LOCA_REF N2"
"SSOLDECP";"S";"0073";"* stockage de l'année du jour de l'historique"
"SSOLDECP";"S";"0074";"LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"SSOLDECP";"S";"0075";"* stockage du mois de reference"
"SSOLDECP";"S";"0076";"LOCA_REF << CONF_ITIVMREFCP(3:2)"
"SSOLDECP";"S";"0077";"* stokage du mois de reference"
"SSOLDECP";"S";"0078";"LOCA_DATE(5:2) << LOCA_REF"
"SSOLDECP";"S";"0079";"* stockage du jour de reference"
"SSOLDECP";"S";"0080";"LOCA_REF << CONF_ITIVMREFCP(1:2)"
"SSOLDECP";"S";"0081";"* loca_date contient maintenant l'année du jour de l'historique"
"SSOLDECP";"S";"0082";"* et le mois et le jour de reference"
"SSOLDECP";"S";"0083";"LOCA_DATE(7:2) << LOCA_REF"
"SSOLDECP";"S";"0084";"* stockage de l'annee en cours"
"SSOLDECP";"S";"0085";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"SSOLDECP";"S";"0086";"LOCA_ACOURS2 = LOCA_ACOURS + 1"
"SSOLDECP";"S";"0087";"*"
"SSOLDECP";"S";"0088";"* calcul de la date de reference d'initialisation de cp"
"SSOLDECP";"S";"0089";"* et de date butoir  pour calculer le solde futur"
"SSOLDECP";"S";"0090";"SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"SSOLDECP";"S";"0091";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"SSOLDECP";"S";"0092";"   LOCA_ACOURS2 = LOCA_ACOURS + 1"
"SSOLDECP";"S";"0093";"*"
"SSOLDECP";"S";"0094";"FINSI"
"SSOLDECP";"S";"0095";"LOCA_DATEFU(1:4) << LOCA_ACOURS"
"SSOLDECP";"S";"0096";"LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"SSOLDECP";"S";"0097";"LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"SSOLDECP";"S";"0098";"LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"SSOLDECP";"S";"0099";"*"
"SSOLDECP";"S";"0100";"* test si gestion des cp"
"SSOLDECP";"S";"0101";"SI HJOU_IJIACOPRIN = ""1"""
"SSOLDECP";"S";"0102";"*"
"SSOLDECP";"S";"0103";"****** Totalisation des Droits >>"
"SSOLDECP";"S";"0104";"   HJOU_SJRDGCONGE = HJOU_IJRDCOPRIN"
"SSOLDECP";"S";"0105";"   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_IJRDCOANCI"
"SSOLDECP";"S";"0106";"   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_SJRDCSUP"
"SSOLDECP";"S";"0107";"   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_SJRDCMDF"
"SSOLDECP";"S";"0108";"   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_IJRDCOFRAC"
"SSOLDECP";"S";"0109";"*   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_IJRDACQCP"
"SSOLDECP";"S";"0110";"*"
"SSOLDECP";"S";"0111";"****** Totalisation des Pris >>"
"SSOLDECP";"S";"0112";"   HJOU_SJRCGCONGE = HJOU_IJRCCOPRIN"
"SSOLDECP";"S";"0113";"   HJOU_SJRCGCONGE = HJOU_SJRCGCONGE + HJOU_IJRCCOANCI"
"SSOLDECP";"S";"0114";"   HJOU_SJRCGCONGE = HJOU_SJRCGCONGE + HJOU_SJRCCSUP"
"SSOLDECP";"S";"0115";"   HJOU_SJRCGCONGE = HJOU_SJRCGCONGE + HJOU_SJRCCMDF"
"SSOLDECP";"S";"0116";"   HJOU_SJRCGCONGE = HJOU_SJRCGCONGE + HJOU_IJRCCOFRAC"
"SSOLDECP";"S";"0117";"*   HJOU_SJRDGCONGE = HJOU_SJRDGCONGE + HJOU_IJRDACQCP"
"SSOLDECP";"S";"0118";"*"
"SSOLDECP";"S";"0119";"****** Totalisation des Soldes >>"
"SSOLDECP";"S";"0120";"   HJOU_IJRSGCONGE = HJOU_IJRSCOPRIN"
"SSOLDECP";"S";"0121";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOANCI"
"SSOLDECP";"S";"0122";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_SJRSCSUP"
"SSOLDECP";"S";"0123";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_SJRSCMDF"
"SSOLDECP";"S";"0124";"   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSCOFRAC"
"SSOLDECP";"S";"0125";"*   HJOU_IJRSGCONGE = HJOU_IJRSGCONGE + HJOU_IJRSACQCP"
"SSOLDECP";"S";"0126";"*"
"SSOLDECP";"S";"0127";"* alimentation du solde prévisionnel"
"SSOLDECP";"S";"0128";"*"
"SSOLDECP";"S";"0129";"* cas ou l'employé a une date de fin de contrat ou date de cloture < loca_datefu"
"SSOLDECP";"S";"0130";"*"
"SSOLDECP";"S";"0131";"   SI CTRA_DATFIN > TEMP_DATJOU"
"SSOLDECP";"S";"0132";"      SI HJOU_SJQFINC = 1"
"SSOLDECP";"S";"0133";"         SI CTRA_DATFIN < LOCA_DATEFU"
"SSOLDECP";"S";"0134";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"SSOLDECP";"S";"0135";"            LOCA_DATEFU = TEMP_DXFINPER"
"SSOLDECP";"S";"0136";"         FINSI"
"SSOLDECP";"S";"0137";"         SI CTRA_DATFIN > LOCA_DATEFU"
"SSOLDECP";"S";"0138";"            SI CTRA_DATFIN < LOCA_DATEFU2"
"SSOLDECP";"S";"0139";"               DATAJT CTRA_DATFIN 12 ""J"" 1"
"SSOLDECP";"S";"0140";"               LOCA_DATEFU2 = TEMP_DXFINPER"
"SSOLDECP";"S";"0141";"            FINSI"
"SSOLDECP";"S";"0142";"         FINSI"
"SSOLDECP";"S";"0143";"      FINSI"
"SSOLDECP";"S";"0144";"   FINSI"
"SSOLDECP";"S";"0145";"***"
"SSOLDECP";"S";"0146";"   SI TEMP_DATSUI = LOCA_DATEFU"
"SSOLDECP";"S";"0147";"* JJA - 13/06/2025 : Pris prév."
"SSOLDECP";"S";"0148";"      EMPL_SEQCCP = HJOU_SJRCGCONGE + HJOU_SJRCCPW"
"SSOLDECP";"S";"0149";"      EMPL_SEQCCPA = HJOU_IJRPACQCP + HJOU_SJRCCPAW"
"SSOLDECP";"S";"0150";"*"
"SSOLDECP";"S";"0151";"      EMPL_IEQSPGCONG = HJOU_IJRSGCONGE - HJOU_SJRCCPW"
"SSOLDECP";"S";"0152";"      EMPL_SEQSACQCPW = HJOU_IJRSACQCP - HJOU_SJRCCPAW"
"SSOLDECP";"S";"0153";"      HJOU_SJRCCPW = 0"
"SSOLDECP";"S";"0154";"   FINSI"
"SSOLDECP";"S";"0155";"*"
"SSOLDECP";"S";"0156";"   SI TEMP_DATSUI = LOCA_DATEFU2"
"SSOLDECP";"S";"0157";"      EMPL_IEQSPGCON2 = HJOU_IJRSGCONGE - HJOU_SJRCCPW"
"SSOLDECP";"S";"0158";"   SINON"
"SSOLDECP";"S";"0159";"      SI EMPL_DATTRAI < LOCA_DATEFU2"
"SSOLDECP";"S";"0160";"         SI HJOU_DATE = EMPL_DATTRAI"
"SSOLDECP";"S";"0161";"            EMPL_IEQSPGCON2 = HJOU_IJRSGCONGE - HJOU_SJRCCPW"
"SSOLDECP";"S";"0162";"         FINSI"
"SSOLDECP";"S";"0163";"      FINSI"
"SSOLDECP";"S";"0164";"   FINSI"
"SSOLDECP";"S";"0165";"*"
"SSOLDECP";"S";"0166";"* Solde prévisionnel CP reporté >>"
"SSOLDECP";"S";"0167";"*"
"SSOLDECP";"S";"0168";"   SI HJOU_DATE >= TEMP_DATJOU"
"SSOLDECP";"S";"0169";"      SI HJOU_DATE < LOCA_DATEFU"
"SSOLDECP";"S";"0170";"*"
"SSOLDECP";"S";"0171";"* Date de fin de report P1 >>"
"SSOLDECP";"S";"0172";"         SI HJOU_DATE = HJOU_SJRDAFREP1"
"SSOLDECP";"S";"0173";"            EMPL_SEQSCPREP1 = HJOU_SJRSPREP1"
"SSOLDECP";"S";"0174";"         FINSI"
"SSOLDECP";"S";"0175";"* Date de fin de report P2 >>"
"SSOLDECP";"S";"0176";"         SI HJOU_DATE = HJOU_SJRDAFREP2"
"SSOLDECP";"S";"0177";"            EMPL_SEQSCPREP2 = HJOU_SJRSPREP2"
"SSOLDECP";"S";"0178";"         FINSI"
"SSOLDECP";"S";"0179";"* Date de fin de report P3 >>"
"SSOLDECP";"S";"0180";"         SI HJOU_DATE = HJOU_SJRDAFREP3"
"SSOLDECP";"S";"0181";"            EMPL_SEQSCPREP3 = HJOU_SJRSPREP3"
"SSOLDECP";"S";"0182";"         FINSI"
"SSOLDECP";"S";"0183";"* Date de fin de report P4 >>"
"SSOLDECP";"S";"0184";"         SI HJOU_DATE = HJOU_SJRDAFREP4"
