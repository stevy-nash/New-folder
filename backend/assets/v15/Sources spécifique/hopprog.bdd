"SCOPIE3";"S";"0005";"* Titre : GCF : Copie des valeurs internes dans HJOU"
"SCOPIE3";"S";"0006";"*"
"SCOPIE3";"S";"0007";"*----------------------------------------------------------------------"
"SCOPIE3";"S";"0008";"*"
"SCOPIE3";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SCOPIE3";"S";"0010";"* Date     : 03/10/2024"
"SCOPIE3";"S";"0011";"*----------------------------------------------------------------------"
"SCOPIE3";"S";"0012";"*"
"SCOPIE3";"S";"0013";"*"
"SCOPIE3";"S";"0014";"* Rôle :"
"SCOPIE3";"S";"0015";"*"
"SCOPIE3";"S";"0016";"* Copie des valeurs internes dans HJOU + Alimentation indicateur PIXID"
"SCOPIE3";"S";"0017";"*"
"SCOPIE3";"S";"0018";"*----------------------------------------------------------------------"
"SCOPIE3";"S";"0019";"*"
"SCOPIE3";"S";"0020";"* Modifiée par : Méthodes et outils"
"SCOPIE3";"S";"0021";"* Date         : 30/06/2020"
"SCOPIE3";"S";"0022";"* Objet        : Le taux du temps travail étant dans CTR et dans JOU, celui"
"SCOPIE3";"S";"0023";"*                 de CTR est désormais copié dans celui de JOU"
"SCOPIE3";"S";"0024";"*"
"SCOPIE3";"S";"0025";"***********************************************************************"
"SCOPIE3";"S";"0026";"*"
"SCOPIE3";"S";"0027";"* Modifiée par : Méthodes et outils"
"SCOPIE3";"S";"0028";"* Date         : 27/11/2020"
"SCOPIE3";"S";"0029";"* Objet        : Alimentation du filtre Jour PIXID pour export RA (en commentaire)"
"SCOPIE3";"S";"0030";"*"
"SCOPIE3";"S";"0031";"***********************************************************************"
"SCOPIE3";"S";"0032";"* Implémentation des données industrielles"
"SCOPIE3";"S";"0033";"*"
"SCOPIE3";"S";"0034";"DEBDICO"
"SCOPIE3";"S";"0035";"   *"
"SCOPIE3";"S";"0036";"   * Spécifique"
"SCOPIE3";"S";"0037";"   CTRA_SCISOCIETE;O;A2;X;;;123456789;L;;C2;""Code société"";"
"SCOPIE3";"S";"0038";"   HJOU_SJQSOCIETE;N;A3;X;;;123456789;;;V3;""Code société"";"
"SCOPIE3";"S";"0039";"   HJOU_SJQCATEGOR;O;A4;X;;;         ;;;V3;""Catégorie"";"
"SCOPIE3";"S";"0040";"   HJOU_SJQOUVRABL;O;A2;X;;;         ;;;V3;""Gestion en ouvrable (N:Non,O: Oui)"";"
"SCOPIE3";"S";"0041";"   HJOU_SJQFORFJR;O;Z1;X;0;1;         ;;;V3;""Forfait jour(0: Non /1: Oui)"";"
"SCOPIE3";"S";"0042";"   HJOU_SJRDDEBCTR;N;D10;X;;;    56789;;SJRDDEBCTR;V3;""Date début 1° contrat"";"
"SCOPIE3";"S";"0043";"   HJOU_SJRJOUR1;N;N2;I;;;    56789;;SJRJOUR1;V3;""Nombres contrats consécutif"";"
"SCOPIE3";"S";"0044";"   HJOU_SJRJPRECAL;N;N4;I;;;    56789;;SJRJPRECAL;V3;""Jour de présence calendaire de l'année"";"
"SCOPIE3";"S";"0045";"   CTRA_SCQMATPAIE;O;A10;X;;;        9;;;V3;""Matricule paie ADP (calculé)"";"
"SCOPIE3";"S";"0046";"   HJOU_SJIMATPAIE;O;A10;X;;;        9;;;C2;""Matricule paie ADP (interfacé)"";"
"SCOPIE3";"S";"0047";"   *"
"SCOPIE3";"S";"0048";"  *"
"SCOPIE3";"S";"0049";"* 27/11/2025-SYA: pour identifier le personnel Rotative - MO"
"SCOPIE3";"S";"0050";"   HJOU_SJQROTATMO;O;Z1;X;0;1;         ;;;V3;""Rotative MO (0: Non /1: Oui)"";"
"SCOPIE3";"S";"0051";"FINDICO"
"SCOPIE3";"S";"0052";"*"
"SCOPIE3";"S";"0053";"* Déclaration des donnees locales"
"SCOPIE3";"S";"0054";"*"
"SCOPIE3";"S";"0055";"* recopie des valeurs internes dans le domaine HJOU"
"SCOPIE3";"S";"0056";"*"
"SCOPIE3";"S";"0057";"HJOU_SJQSOCIETE = CTRA_SCISOCIETE"
"SCOPIE3";"S";"0058";"*"
"SCOPIE3";"S";"0059";"SI HJOU_DATE = TEMP_DATJOU"
"SCOPIE3";"S";"0060";"   EMPL_SEQSOCIETE = HJOU_SJQSOCIETE"
"SCOPIE3";"S";"0061";"FINSI"
"SCOPIE3";"S";"0062";"*"
"SCOPIE3";"S";"0063";"SI CTRA_SCIFORFJ = ""1"""
"SCOPIE3";"S";"0064";"   HJOU_SJQFORFJR = ""1"""
"SCOPIE3";"S";"0065";"SINON"
"SCOPIE3";"S";"0066";"   HJOU_SJQFORFJR = ""0"""
"SCOPIE3";"S";"0067";"FINSI"
"SCOPIE3";"S";"0068";"*"
"SCOPIE3";"S";"0069";"* Déduction de la catégorie en fonction du statut du contrat >>"
"SCOPIE3";"S";"0070";"*"
"SCOPIE3";"S";"0071";"* C = CADRE"
"SCOPIE3";"S";"0072";"SI CTRA_SCISTATUT = ""1"""
"SCOPIE3";"S";"0073";"OU CTRA_SCISTATUT = ""2"""
"SCOPIE3";"S";"0074";"OU CTRA_SCISTATUT = ""C"""
"SCOPIE3";"S";"0075";"OU CTRA_SCISTATUT = ""D"""
"SCOPIE3";"S";"0076";"   HJOU_SJQCATEGOR = ""C"""
"SCOPIE3";"S";"0077";"FINSI"
"SCOPIE3";"S";"0078";"*"
"SCOPIE3";"S";"0079";"* AM = AGENT DE MAITRISE"
"SCOPIE3";"S";"0080";"SI CTRA_SCISTATUT = ""A"""
"SCOPIE3";"S";"0081";"OU CTRA_SCISTATUT = ""M"""
"SCOPIE3";"S";"0082";"OU CTRA_SCISTATUT = ""N"""
"SCOPIE3";"S";"0083";"   HJOU_SJQCATEGOR = ""AM"""
"SCOPIE3";"S";"0084";"FINSI"
"SCOPIE3";"S";"0085";"*"
"SCOPIE3";"S";"0086";"* J = Journaliste"
"SCOPIE3";"S";"0087";"SI CTRA_SCISTATUT = ""B"""
"SCOPIE3";"S";"0088";"OU CTRA_SCISTATUT = ""J"""
"SCOPIE3";"S";"0089";"OU CTRA_SCISTATUT = ""K"""
"SCOPIE3";"S";"0090";"   HJOU_SJQCATEGOR = ""J"""
"SCOPIE3";"S";"0091";"FINSI"
"SCOPIE3";"S";"0092";"*"
"SCOPIE3";"S";"0093";"* P = PORTEUR"
"SCOPIE3";"S";"0094";"SI CTRA_SCISTATUT = ""W"""
"SCOPIE3";"S";"0095";"OU CTRA_SCISTATUT = ""Z"""
"SCOPIE3";"S";"0096";"   HJOU_SJQCATEGOR = ""P"""
"SCOPIE3";"S";"0097";"FINSI"
"SCOPIE3";"S";"0098";"*"
"SCOPIE3";"S";"0099";"* E = EMPLOYE"
"SCOPIE3";"S";"0100";"SI CTRA_SCISTATUT = ""E"""
"SCOPIE3";"S";"0101";"OU CTRA_SCISTATUT = ""S"""
"SCOPIE3";"S";"0102";"   HJOU_SJQCATEGOR = ""E"""
"SCOPIE3";"S";"0103";"FINSI"
"SCOPIE3";"S";"0104";"*"
"SCOPIE3";"S";"0105";"* O = OUVRIER"
"SCOPIE3";"S";"0106";"SI CTRA_SCISTATUT = ""O"""
"SCOPIE3";"S";"0107";"   HJOU_SJQCATEGOR = ""O"""
"SCOPIE3";"S";"0108";"FINSI"
"SCOPIE3";"S";"0109";"*"
"SCOPIE3";"S";"0110";"* S = STAGIAIRE"
"SCOPIE3";"S";"0111";"SI CTRA_SCISTATUT = ""8"""
"SCOPIE3";"S";"0112";"   HJOU_SJQCATEGOR = ""S"""
"SCOPIE3";"S";"0113";"FINSI"
"SCOPIE3";"S";"0114";"*"
"SCOPIE3";"S";"0115";"* NC = NON CONCERNE"
"SCOPIE3";"S";"0116";"SI CTRA_SCISTATUT = ""9"""
"SCOPIE3";"S";"0117";"OU CTRA_SCISTATUT = ""P"""
"SCOPIE3";"S";"0118";"OU CTRA_SCISTATUT = ""X"""
"SCOPIE3";"S";"0119";"OU CTRA_SCISTATUT = ""Y"""
"SCOPIE3";"S";"0120";"   HJOU_SJQCATEGOR = ""NC"""
"SCOPIE3";"S";"0121";"FINSI"
"SCOPIE3";"S";"0122";"*"
"SCOPIE3";"S";"0123";"* Anomalie si pas de catégorie"
"SCOPIE3";"S";"0124";"* Exclu intérimaire"
"SCOPIE3";"S";"0125";"SI HJOU_MATRI(1:8) <> ""INTERIMR"""
"SCOPIE3";"S";"0126";"   SI HJOU_SJQCATEGOR = "" """
"SCOPIE3";"S";"0127";"      HJOU_SJQCATEGOR = ""XX"""
"SCOPIE3";"S";"0128";"      ANOMALIE 251"
"SCOPIE3";"S";"0129";"   FINSI"
"SCOPIE3";"S";"0130";"FINSI"
"SCOPIE3";"S";"0131";"*"
"SCOPIE3";"S";"0132";"* Population géré en ouvrable"
"SCOPIE3";"S";"0133";"SI HJOU_SJQSOCIETE = ""PO"""
"SCOPIE3";"S";"0134";"   HJOU_SJQOUVRABL = ""O"""
"SCOPIE3";"S";"0135";"SINON"
"SCOPIE3";"S";"0136";"   HJOU_SJQOUVRABL = ""N"""
"SCOPIE3";"S";"0137";"FINSI"
"SCOPIE3";"S";"0138";"*"
"SCOPIE3";"S";"0139";"***** Calcul date de début 1° contrat **************************************************************"
"SCOPIE3";"S";"0140";"*"
"SCOPIE3";"S";"0141";"POUR PERIODES"
"SCOPIE3";"S";"0142";"   SI HJOU_SJRDDEBCTR = "" """
"SCOPIE3";"S";"0143";"      HJOU_SJRDDEBCTR = CTRA_DATDEB"
"SCOPIE3";"S";"0144";"   SINON"
"SCOPIE3";"S";"0145";"      SI CTRA_DATDEB < HJOU_SJRDDEBCTR"
"SCOPIE3";"S";"0146";"         HJOU_SJRDDEBCTR = CTRA_DATDEB"
"SCOPIE3";"S";"0147";"      FINSI"
"SCOPIE3";"S";"0148";"   FINSI"
"SCOPIE3";"S";"0149";"FINPOUR"
"SCOPIE3";"S";"0150";"*"
"SCOPIE3";"S";"0151";"****** Calcul le nomnbre de jour calendaire"
"SCOPIE3";"S";"0152";"SI HJOU_SJQDEBC = 1"
"SCOPIE3";"S";"0153";"OU HJOU_DATE(5:4) = ""0101"""
"SCOPIE3";"S";"0154";"   HJOU_SJRJPRECAL = 0"
"SCOPIE3";"S";"0155";"FINSI"
"SCOPIE3";"S";"0156";"*"
"SCOPIE3";"S";"0157";"HJOU_SJRJPRECAL = HJOU_SJRJPRECAL + 1"
"SCOPIE3";"S";"0158";"*"
"SCOPIE3";"S";"0159";"* Copie matricule de paie ADP"
"SCOPIE3";"S";"0160";"*"
"SCOPIE3";"S";"0161";"SI HJOU_SJIMATPAIE = "" """
"SCOPIE3";"S";"0162";"   CTRA_SCQMATPAIE = HJOU_MATRI"
"SCOPIE3";"S";"0163";"SINON"
"SCOPIE3";"S";"0164";"   CTRA_SCQMATPAIE = HJOU_SJIMATPAIE"
"SCOPIE3";"S";"0165";"FINSI"
"SCOPIE3";"S";"0166";"*"
"SCOPIE3";"S";"0167";"* Gestion de matricule manager"
"SCOPIE3";"S";"0168";"EMPL_SEIMATN1S = EMPL_SEIMATMANA"
"SCOPIE3";"S";"0169";"SI EMPL_SEIMATMANF <> "" """
"SCOPIE3";"S";"0170";"   EMPL_SEIMATN1S = EMPL_SEIMATMANF"
"SCOPIE3";"S";"0171";"FINSI"
"SCOPIE3";"S";"0172";"*"
"SCOPIE3";"S";"0173";"* Définition du type de service >>"
"SCOPIE3";"S";"0174";"*"
"SCOPIE3";"S";"0175";"SI HJOU_SECTORI = ""DPR"""
"SCOPIE3";"S";"0176";"OU HJOU_SECTORI = ""DZP"""
"SCOPIE3";"S";"0177";"OU HJOU_SECTORI = ""EDT"""
"SCOPIE3";"S";"0178";"OU HJOU_SECTORI = ""EDT610"""
"SCOPIE3";"S";"0179";"OU HJOU_SECTORI = ""FOR"""
"SCOPIE3";"S";"0180";"OU HJOU_SECTORI = ""FOR300"""
"SCOPIE3";"S";"0181";"OU HJOU_SECTORI = ""FOR360"""
"SCOPIE3";"S";"0182";"OU HJOU_SECTORI = ""FOR361"""
"SCOPIE3";"S";"0183";"OU HJOU_SECTORI = ""FOR362"""
"SCOPIE3";"S";"0184";"OU HJOU_SECTORI = ""TVR"""
"SCOPIE3";"S";"0185";"OU HJOU_SECTORI = ""TVR080"""
"SCOPIE3";"S";"0186";"OU HJOU_SECTORI = ""TVR800"""
"SCOPIE3";"S";"0187";"OU HJOU_SECTORI = ""TVR801"""
"SCOPIE3";"S";"0188";"OU HJOU_SECTORI = ""TVR802"""
"SCOPIE3";"S";"0189";"OU HJOU_SECTORI = ""TVR803"""
"SCOPIE3";"S";"0190";"   HJOU_SJITYPSERV = ""NONDEFINI"""
"SCOPIE3";"S";"0191";"FINSI"
"SCOPIE3";"S";"0192";"SI HJOU_SECTORI = ""DINMON231"""
"SCOPIE3";"S";"0193";"OU HJOU_SECTORI = ""DINYRP231"""
"SCOPIE3";"S";"0194";"   HJOU_SJITYPSERV = ""CTP"""
"SCOPIE3";"S";"0195";"FINSI"
