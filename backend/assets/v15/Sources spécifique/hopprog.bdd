"IRAZCO";"S";"0169";"      HJOU_IJRDCOPRIN = 0"
"IRAZCO";"S";"0170";"      HJOU_IJRCCOPRIN = 0"
"IRAZCO";"S";"0171";"      HJOU_IJRSCOPRIN = 0"
"IRAZCO";"S";"0172";"      HJOU_IJRSGCONGE = 0"
"IRAZCO";"S";"0173";"      HJOU_IJRCCOANTI = 0"
"IRAZCO";"S";"0174";"      HJOU_IJRDCOFRAC = 0"
"IRAZCO";"S";"0175";"      HJOU_IJRCCOFRAC = 0"
"IRAZCO";"S";"0176";"      HJOU_IJRSCOFRAC = 0"
"IRAZCO";"S";"0177";"      HJOU_IJRNBCOFRA = 0"
"IRAZCO";"S";"0178";"      HJOU_IJRACRTTJM = 0"
"IRAZCO";"S";"0179";"      HJOU_IJRACRTTJM = 0"
"IRAZCO";"S";"0180";"      HJOU_IJRSNBJRTT = 0"
"IRAZCO";"S";"0181";"      HJOU_IJRBRCHSMH = 0"
"IRAZCO";"S";"0182";"* V9"
"IRAZCO";"S";"0183";"      HJOU_IJRNBRSEMN = 0"
"IRAZCO";"S";"0184";"      HJOU_IJRHNUITAN = 0"
"IRAZCO";"S";"0185";"      HJOU_IJRNBRNUIT = 0"
"IRAZCO";"S";"0186";"      HJOU_IJRRCNUIT = 0"
"IRAZCO";"S";"0187";"      HJOU_IJRBHPAYEE = 0"
"IRAZCO";"S";"0188";"      HJOU_IJRSCPCET = 0"
"IRAZCO";"S";"0189";"      HJOU_IJRSDONCP = 0"
"IRAZCO";"S";"0190";"      HJOU_IJRSDONABS = 0"
"IRAZCO";"S";"0191";"      HJOU_IJRSDONDIV = 0"
"IRAZCO";"S";"0192";"*Acquisition congés"
"IRAZCO";"S";"0193";"      HJOU_IJRDACQCP = 0"
"IRAZCO";"S";"0194";"      HJOU_IJRPACQCP = 0"
"IRAZCO";"S";"0195";"      HJOU_IJRSACQCP = 0"
"IRAZCO";"S";"0196";"*Jours de congés versés"
"IRAZCO";"S";"0197";"      HJOU_IJRCOVER = 0"
"IRAZCO";"S";"0198";"*Suivi jours travaillés"
"IRAZCO";"S";"0199";"      HJOU_IJRCPTJTRA = 0"
"IRAZCO";"S";"0200";"* Congés travaillés/non travaillés"
"IRAZCO";"S";"0201";"*      HJOU_IJRDCPTRA = 0"
