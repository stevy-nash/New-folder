"SHSUPPDIM";"S";"0478";"   SI HABS_MOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM";"S";"0479";"      LOCA_DURHS = LOCA_DURHS + HABS_MOTIDUR"
"SHSUPPDIM";"S";"0480";"      SI HJOU_SJRHSPRC = "" """
