"ITPSACTPT2";"S";"0030";"***********************************************************************"
"ITPSACTPT2";"S";"0031";"*"
"ITPSACTPT2";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTPT2";"S";"0033";"*"
"ITPSACTPT2";"S";"0034";"DEBDICO"
"ITPSACTPT2";"S";"0035";"EMPL_IEIACTI;O;A1;X;;;123456789;L;;C3;""Employé géré en activité"";"
"ITPSACTPT2";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTPT2";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTPT2";"S";"0038";"FINDICO"
"ITPSACTPT2";"S";"0039";"*"
"ITPSACTPT2";"S";"0040";"*"
"ITPSACTPT2";"S";"0041";"* DEBANO"
"ITPSACTPT2";"S";"0042";"*"
"ITPSACTPT2";"S";"0043";"* FINANO"
"ITPSACTPT2";"S";"0044";"*"
"ITPSACTPT2";"S";"0045";"* Définition des variables locales"
"ITPSACTPT2";"S";"0046";"DEF LOCA_DURABS T6.2"
"ITPSACTPT2";"S";"0047";"LOCA_DURABS = 0"
"ITPSACTPT2";"S";"0048";"*"
"ITPSACTPT2";"S";"0049";"* Gestion de l'indicateur activité"
"ITPSACTPT2";"S";"0050";"SI HJOU_IJIACTI = "" """
"ITPSACTPT2";"S";"0051";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTPT2";"S";"0052";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTPT2";"S";"0053";"    FINSI"
"ITPSACTPT2";"S";"0054";"FINSI"
"ITPSACTPT2";"S";"0055";"* Calcul de la présence activité"
"ITPSACTPT2";"S";"0056";"SI HJOU_IJIACTI <> "" """
"ITPSACTPT2";"S";"0057";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTPT2";"S";"0058";"        * Calcul de la présence activité"
"ITPSACTPT2";"S";"0059";"        SI PRES_VALID <> ""O"""
"ITPSACTPT2";"S";"0060";"            PRES_VALID = ""N"""
"ITPSACTPT2";"S";"0061";"            *"
"ITPSACTPT2";"S";"0062";"            PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTPT2";"S";"0063";"            PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTPT2";"S";"0064";"            *"
"ITPSACTPT2";"S";"0065";"            SI PRES_MODE_TRV = "" """
"ITPSACTPT2";"S";"0066";"               PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPT2";"S";"0067";"            FINSI"
"ITPSACTPT2";"S";"0068";"            *"
"ITPSACTPT2";"S";"0069";"            * ----------------------------------------------------------------------------------"
"ITPSACTPT2";"S";"0070";"            *"
"ITPSACTPT2";"S";"0071";"            * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTPT2";"S";"0072";"            *                              (A décommenter si besoin)"
"ITPSACTPT2";"S";"0073";"            *"
"ITPSACTPT2";"S";"0074";"            * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTPT2";"S";"0075";"            * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test de la"
"ITPSACTPT2";"S";"0076";"            * présence théorique différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTPT2";"S";"0077";"            * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTPT2";"S";"0078";"            *"
"ITPSACTPT2";"S";"0079";"            * SI HJOU_IJQPRETHEJ <> 0"
"ITPSACTPT2";"S";"0080";"                PRES_TPS_PRES = HJOU_IJQPRETHEJ"
"ITPSACTPT2";"S";"0081";"            * SINON"
"ITPSACTPT2";"S";"0082";"                * PRES_TPS_PRES = 0.01"
"ITPSACTPT2";"S";"0083";"            * FINSI"
"ITPSACTPT2";"S";"0084";"            * ----------------------------------------------------------------------------------"
"ITPSACTPT2";"S";"0085";"            *"
"ITPSACTPT2";"S";"0086";"            *"
"ITPSACTPT2";"S";"0087";"            *"
"ITPSACTPT2";"S";"0088";"            * ----------------------------------------------------------------------------------"
"ITPSACTPT2";"S";"0089";"            *"
"ITPSACTPT2";"S";"0090";"            * !!!                Pour gestion des temps de présence par consigne                !!!"
"ITPSACTPT2";"S";"0091";"            *                              (A décommenter si besoin)"
"ITPSACTPT2";"S";"0092";"            *"
"ITPSACTPT2";"S";"0093";"            * Si besoin de gérer les temps de présence par consigne, décommenter le"
"ITPSACTPT2";"S";"0094";"            * POUR ACTIVITES ci-dessous ainsi le test LOCA_DURABS <> 0"
"ITPSACTPT2";"S";"0095";"            *"
"ITPSACTPT2";"S";"0096";"            * récupération des temps de présence declaré par consigne"
"ITPSACTPT2";"S";"0097";"            * POUR ACTIVITES"
"ITPSACTPT2";"S";"0098";"                * SI HABS_MOTYPE = ""C"""
"ITPSACTPT2";"S";"0099";"                    * Motif participant au temps d'activité à justifier"
"ITPSACTPT2";"S";"0100";"                    * SI MOTI_MOTIF = ""XPRES"""
"ITPSACTPT2";"S";"0101";"                        * LOCA_DURABS = LOCA_DURABS + HABS_MOTIDUR"
"ITPSACTPT2";"S";"0102";"                    * FINSI"
"ITPSACTPT2";"S";"0103";"                * FINSI"
"ITPSACTPT2";"S";"0104";"            * FINPOUR"
"ITPSACTPT2";"S";"0105";"            *"
"ITPSACTPT2";"S";"0106";"            * SI LOCA_DURABS <> 0"
"ITPSACTPT2";"S";"0107";"                * PRES_TPS_PRES = LOCA_DURABS"
"ITPSACTPT2";"S";"0108";"            * FINSI"
"ITPSACTPT2";"S";"0109";"            * ----------------------------------------------------------------------------------"
"ITPSACTPT2";"S";"0110";"            *"
"ITPSACTPT2";"S";"0111";"            *"
"ITPSACTPT2";"S";"0112";"            PRES_TPS_IMPUTE = 0"
"ITPSACTPT2";"S";"0113";"            SI HJOU_IJIACTI = ""1"""
"ITPSACTPT2";"S";"0114";"            OU HJOU_IJIACTI = ""2"""
"ITPSACTPT2";"S";"0115";"            OU HJOU_IJIACTI = ""3"""
"ITPSACTPT2";"S";"0116";"                POUR EVENEMENTS"
"ITPSACTPT2";"S";"0117";"                    PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTPT2";"S";"0118";"                FINPOUR"
"ITPSACTPT2";"S";"0119";"            FINSI"
"ITPSACTPT2";"S";"0120";"            * Calcul de l'écart"
"ITPSACTPT2";"S";"0121";"            PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTPT2";"S";"0122";"        FINSI"
"ITPSACTPT2";"S";"0123";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTPT2";"S";"0124";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTPT2";"S";"0125";"            HJOU_IJQMODL = ""FMOD01"""
"ITPSACTPT2";"S";"0126";"        FINSI"
"ITPSACTPT2";"S";"0127";"    FINSI"
"ITPSACTPT2";"S";"0128";"FINSI"
"ITPSACTPT2";"S";"0129";"*"
"ITPSACTPT2";"S";"0130";"FIN"
