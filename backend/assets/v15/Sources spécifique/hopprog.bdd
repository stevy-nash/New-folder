"SACQCPAN";"S";"0104";"*"
"SACQCPAN";"S";"0105";"SI HJOU_SJRDDEBCTR = HJOU_DATE"
"SACQCPAN";"S";"0106";"   HJOU_SJRDATANCC = EMPS_E2DATEANC"
"SACQCPAN";"S";"0107";"FINSI"
