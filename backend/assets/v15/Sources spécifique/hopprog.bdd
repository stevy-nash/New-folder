"SHSUPPDIM";"S";"0301";"*"
"SHSUPPDIM";"S";"0302";"SI HJOU_JOUR = ""1"""
"SHSUPPDIM";"S";"0303";"   SI LOCA_GESTHS = ""2"""
"SHSUPPDIM";"S";"0304";"      HJOU_SJRHSPRC = "" """
"SHSUPPDIM";"S";"0305";"      HJOU_SJRHSPAIE = 0"
"SHSUPPDIM";"S";"0306";"      HJOU_SJRHSRECUP = 0"
"SHSUPPDIM";"S";"0307";"   FINSI"
"SHSUPPDIM";"S";"0308";"* Raz le premier lundi du cycle si LOCA_GESTHS = 3"
"SHSUPPDIM";"S";"0309";"   SI LOCA_GESTHS = ""3"""
"SHSUPPDIM";"S";"0310";"      SI HJOU_RANG = 1"
"SHSUPPDIM";"S";"0311";"         HJOU_SJRHSPRC = "" """
"SHSUPPDIM";"S";"0312";"         HJOU_SJRHSPAIE = 0"
