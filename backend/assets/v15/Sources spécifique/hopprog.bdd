"SGASTR";"S";"0450";"      HJOU_SJRJASTC = 0"
"SGASTR";"S";"0451";"   FINSI"
"SGASTR";"S";"0452";"*"
"SGASTR";"S";"0453";"* Gestion de l'astreinte WE"
"SGASTR";"S";"0454";"   SI HJOU_JOUR = ""7"""
"SGASTR";"S";"0455";"      SI LOCA_AST = 1"
"SGASTR";"S";"0456";"         SI HJOU_SJRJASTC = 2"
"SGASTR";"S";"0457";"            HJOU_SJQAST5294 = 1"
"SGASTR";"S";"0458";"         FINSI"
"SGASTR";"S";"0459";"      FINSI"
"SGASTR";"S";"0460";"   FINSI"
"SGASTR";"S";"0461";"*"
"SGASTR";"S";"0462";"* Gestion de l'intervention d'astreinte le weekend"
"SGASTR";"S";"0463";"   SI LOCA_INTER = 1"
"SGASTR";"S";"0464";"      SI HJOU_JOUR = ""6"""
"SGASTR";"S";"0465";"         HJOU_SJQAST5293 = 1"
"SGASTR";"S";"0466";"      FINSI"
"SGASTR";"S";"0467";"      SI HJOU_JOUR = ""7"""
"SGASTR";"S";"0468";"* On regarde qu'on a pas donné la prime la veille"
"SGASTR";"S";"0469";"         LIREVALPRE LOCA_SJQAST5293 HJOU_SJQAST5293"
"SGASTR";"S";"0470";"         SI LOCA_SJQAST5293 = 0"
"SGASTR";"S";"0471";"            HJOU_SJQAST5293 = 1"
"SGASTR";"S";"0472";"         FINSI"
"SGASTR";"S";"0473";"      FINSI"
"SGASTR";"S";"0474";"   FINSI"
"SGASTR";"S";"0475";"* Gestion de l'intervention en semaine"
"SGASTR";"S";"0476";"*"
"SGASTR";"S";"0477";"* Intervention alimente les heures de récupération >>"
"SGASTR";"S";"0478";"   SI HJOU_JOUR < ""6"""
"SGASTR";"S";"0479";"      HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + LOCA_DURINTER"
"SGASTR";"S";"0480";"   FINSI"
"SGASTR";"S";"0481";"*"
"SGASTR";"S";"0482";"FINSI"
"SGASTR";"S";"0483";"*"
"SGASTR";"S";"0484";"* Gestion anomalies >>"
"SGASTR";"S";"0485";"*"
"SGASTR";"S";"0486";"* Vérif si droit aux astreintes"
"SGASTR";"S";"0487";"SI LOCA_DROIT <> 1"
"SGASTR";"S";"0488";"   SI LOCA_AST = 1"
"SGASTR";"S";"0489";"   OU LOCA_INTER = 1"
"SGASTR";"S";"0490";"      ANOMALIE 257"
"SGASTR";"S";"0491";"   FINSI"
"SGASTR";"S";"0492";"FINSI"
"SGASTR";"S";"0493";"*"
"SGASTR";"S";"0494";"* Vérif si intervention avec astreinte"
"SGASTR";"S";"0495";"SI LOCA_INTER = 1"
"SGASTR";"S";"0496";"   SI LOCA_AST = 0"
"SGASTR";"S";"0497";"      ANOMALIE 259"
"SGASTR";"S";"0498";"   FINSI"
"SGASTR";"S";"0499";"FINSI"
"SGASTR";"S";"0500";"*"
"SGASTR";"S";"0501";"* Vérif si astreinte sur absence ?"
"SGASTR";"S";"0502";"SI LOCA_AST = 1"
"SGASTR";"S";"0503";"   POUR ACTIVITES"
"SGASTR";"S";"0504";"      SI HABS_MOTYPE <> ""C"""
"SGASTR";"S";"0505";"         SI HABS_MOTIF <> ""H"""
"SGASTR";"S";"0506";"            SI MOTI_IMIGTTEFFE <> ""1"""
