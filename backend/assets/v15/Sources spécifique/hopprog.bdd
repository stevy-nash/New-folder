"SRAZCO";"S";"0202";"            LOCA_RAZCPT = 0"
"SRAZCO";"S";"0203";"         FINSI"
"SRAZCO";"S";"0204";"      SINON"
"SRAZCO";"S";"0205";"         ANOMALIE 149"
"SRAZCO";"S";"0206";"      FINSI"
