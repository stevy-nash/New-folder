"IBADGWBA";"S";"0038";"*"
"IBADGWBA";"S";"0039";"* Données en entrée :"
"IBADGWBA";"S";"0040";"*"
"IBADGWBA";"S";"0041";"*"
"IBADGWBA";"S";"0042";"* --- Données élémentaires ---"
"IBADGWBA";"S";"0043";"*"
"IBADGWBA";"S";"0044";"*"
"IBADGWBA";"S";"0045";"* --- Données personnalisées ---"
"IBADGWBA";"S";"0046";"*"
"IBADGWBA";"S";"0047";"*"
"IBADGWBA";"S";"0048";"* Données en sortie :"
"IBADGWBA";"S";"0049";"*"
"IBADGWBA";"S";"0050";"* --- Données personnalisées ---"
"IBADGWBA";"S";"0051";"*"
"IBADGWBA";"S";"0052";"*"
"IBADGWBA";"S";"0053";"* --- Messages ---"
"IBADGWBA";"S";"0054";"*"
"IBADGWBA";"S";"0055";"* N° / msg / Gravité"
"IBADGWBA";"S";"0056";"*"
"IBADGWBA";"S";"0057";"*---------------------------------------------------------------------"
"IBADGWBA";"S";"0058";"*"
"IBADGWBA";"S";"0059";"* Implémentation des données industrielles"
"IBADGWBA";"S";"0060";"*"
"IBADGWBA";"S";"0061";"DEBDICO"
"IBADGWBA";"S";"0062";"   PARD_IDIDURWBA;O;T6,2;I;;;123456789;;;C2;""Durée ajoutée si pointage WBA"";"
"IBADGWBA";"S";"0063";"FINDICO"
"IBADGWBA";"S";"0064";"*"
"IBADGWBA";"S";"0065";"*---------------------------------------------------------------------"
"IBADGWBA";"S";"0066";"*"
"IBADGWBA";"S";"0067";"* Modifiée par : Prénom Nom"
"IBADGWBA";"S";"0068";"* Date         : JJ/MM/AAAA"
"IBADGWBA";"S";"0069";"* Objet        :"
"IBADGWBA";"S";"0070";"*"
"IBADGWBA";"S";"0071";"**********************************************************************"
"IBADGWBA";"S";"0072";"*"
"IBADGWBA";"S";"0073";"* Définition des consignes"
"IBADGWBA";"S";"0074";"*"
"IBADGWBA";"S";"0075";"*"
"IBADGWBA";"S";"0076";"* Définition des variables locales"
"IBADGWBA";"S";"0077";"*"
"IBADGWBA";"S";"0078";"DEF LOCA_NOB N2"
"IBADGWBA";"S";"0079";"LOCA_NOB = 0"
"IBADGWBA";"S";"0080";"DEF LOCA_RAJOUT N1"
"IBADGWBA";"S";"0081";"LOCA_RAJOUT = 0"
"IBADGWBA";"S";"0082";"*"
"IBADGWBA";"S";"0083";"SI PARD_IDIDURWBA > 0"
"IBADGWBA";"S";"0084";"   SI HJOU_DATE <= TEMP_DATJOU"
"IBADGWBA";"S";"0085";"      POUR POINTAGES"
"IBADGWBA";"S";"0086";"*        Comptabilisation du nombre de pointage"
"IBADGWBA";"S";"0087";"         LOCA_NOB = LOCA_NOB + 1"
"IBADGWBA";"S";"0088";"*        jai pointé depuis le pc : WBA"
"IBADGWBA";"S";"0089";"         SI POIN_LECTEUR = ""*WBA"""
"IBADGWBA";"S";"0090";"*           premier pointage de la journée"
"IBADGWBA";"S";"0091";"            SI LOCA_NOB = 1"
"IBADGWBA";"S";"0092";"               LOCA_RAJOUT = 1"
"IBADGWBA";"S";"0093";"            FINSI"
"IBADGWBA";"S";"0094";"         FINSI"
"IBADGWBA";"S";"0095";"      FINPOUR"
"IBADGWBA";"S";"0096";"*"
"IBADGWBA";"S";"0097";"*     je dois rajouter des heures. je prends celles definies dans PARD_IDIDURWBA"
"IBADGWBA";"S";"0098";"      SI LOCA_RAJOUT > 0"
"IBADGWBA";"S";"0099";"         HJOU_IJQPRESBAJ = HJOU_IJQPRESBAJ + PARD_IDIDURWBA"
"IBADGWBA";"S";"0100";"      FINSI"
"IBADGWBA";"S";"0101";"   FINSI"
"IBADGWBA";"S";"0102";"FINSI"
"IBADGWBA";"S";"0103";"*"
"IBADGWBA";"S";"0104";"*"
"IBADGWBA";"S";"0105";"FIN"
