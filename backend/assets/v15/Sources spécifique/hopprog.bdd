"IACQCP";"S";"0009";"* Créé par : Méthodes et outils"
"IACQCP";"S";"0010";"* Date     : 02/05/2019"
"IACQCP";"S";"0011";"* Version  : 1"
"IACQCP";"S";"0012";"*"
"IACQCP";"S";"0013";"*----------------------------------------------------------------------"
"IACQCP";"S";"0014";"*"
"IACQCP";"S";"0015";"*"
"IACQCP";"S";"0016";"* Rôle : BT 65154 : Gestion de l'acquisition des congés payés"
"IACQCP";"S";"0017";"*"
"IACQCP";"S";"0018";"*        Récupération de la partie acquisition des congés payés"
"IACQCP";"S";"0019";"*        de la règle ICONGE et ICONGEP du package indus V11"
"IACQCP";"S";"0020";"*"
"IACQCP";"S";"0021";"*"
"IACQCP";"S";"0022";"* Implémentation des données industrielles"
"IACQCP";"S";"0023";"*"
"IACQCP";"S";"0024";"*"
"IACQCP";"S";"0025";"*----------------------------------------------------------------------"
"IACQCP";"S";"0026";"*"
"IACQCP";"S";"0027";"* Modifiée par : Méthodes et outils"
"IACQCP";"S";"0028";"* Date         : 03/08/2020"
"IACQCP";"S";"0029";"* Objet        : Ajout de la gestion de CP supplémentaire pour les enfants"
"IACQCP";"S";"0030";"*                 à charge de moins de 15 ans avec une acquisition des CP"
"IACQCP";"S";"0031";"*                 mensuelle"
"IACQCP";"S";"0032";"*"
"IACQCP";"S";"0033";"***********************************************************************"
"IACQCP";"S";"0034";"*"
"IACQCP";"S";"0035";"DEBDICO"
"IACQCP";"S";"0036";"   HJOU_IJRSCORELI;N;N6,1;I;;;    56789;;IJRSCORELI;V3;""Reliquat congé payé"";"
"IACQCP";"S";"0037";"   HJOU_IJRSCOPRIN;N;N6,1;I;;;    56789;;IJRSCOPRIN;V3;""Solde congé payé"";"
"IACQCP";"S";"0038";"   HJOU_IJRDCOPRIN;N;N6,1;I;;;    56789;;IJRDCOPRIN;V3;""Droit congé payé"";"
"IACQCP";"S";"0039";"   HJOU_IJRCCOPRIN;N;N6,1;I;;;    56789;;IJRCCOPRIN;V3;""Congé payé pris"";"
"IACQCP";"S";"0040";"   HJOU_IJRCCOANTI;N;N6,1;I;;;     6789;;IJRCCOANTI;V3;""Congé anticipé"";"
"IACQCP";"S";"0041";"   MOTI_IMICONTCPS;O;Z1;X;;;123456789;L9;;C3;""Maintien congé"";"
"IACQCP";"S";"0042";"   HJOU_IJRNBCPSAM;N;N2;I;;;    56789;;IJRNBCPSAM;V3;""Nombre de congés samedi"";"
"IACQCP";"S";"0043";"   HJOU_IJRSAMEAPR;N;N2;I;;;    56789;;IJRSAMEAPR;V3;""Calcul interm nbr. samedi a prendre."";"
"IACQCP";"S";"0044";"   PARD_IDINBRSAMD;O;N2;I;0;;123456789;;;C3;""Nombre de congés samedi à prendre"";"
"IACQCP";"S";"0045";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"IACQCP";"S";"0046";"   * Acquisition des CP"
"IACQCP";"S";"0047";"   HJOU_IJRDACQCP;N;N5,2;I;;;    56789;;IJRDACQCP;V3;""Droit acquisition congé"";"
"IACQCP";"S";"0048";"   HJOU_IJRPACQCP;N;N5,2;I;;;    56789;;IJRPACQCP;V3;""Acquisition congé pris"";"
"IACQCP";"S";"0049";"   HJOU_IJRSACQCP;N;N6,2;I;;;    56789;;IJRSACQCP;V3;""Solde acquisition congé"";"
"IACQCP";"S";"0050";"   * Jours travaillés"
"IACQCP";"S";"0051";"   HJOU_IJRCPTJTRA;N;N2;I;;;    56789;;IJRCPTJTRA;V3;""Compteur de suivi des jours travaillés"";"
"IACQCP";"S";"0052";"   HORC_IHIMOACQCP;O;A1;X;;;123456789;L;;C3;""Mode d'acquisition des congés"";"
"IACQCP";"S";"0053";"   HORC_IHIDRNTRAV;O;N4,2;I;;;123456789;;;C3;""Acquis congé payé sur jour non travaillé"";"
"IACQCP";"S";"0054";"   * CP pris hebdo"
"IACQCP";"S";"0055";"   HJOU_IJRCPCOH;N;N5,1;I;;;    56789;;IJRCPCOH;V3;""Congés pris hebdo"";"
"IACQCP";"S";"0056";"   HORC_IHIGESRELI;O;Z1;X;0;1;123456789;C;;C3;""Gestion des reliquats"";"
"IACQCP";"S";"0057";"   * CP sur jours travaillés"
"IACQCP";"S";"0058";"   HJOU_IJRDCPTRA;N;N5,1;I;;;    56789;;IJRDCPTRA;V3;""Droit CP travaillés"";"
"IACQCP";"S";"0059";"   HJOU_IJRCCPTRA;N;N5,1;I;;;    56789;;IJRCCPTRA;V3;""Pris CP travaillés"";"
"IACQCP";"S";"0060";"   HJOU_IJRSCPTRA;N;N5,1;I;;;    56789;;IJRSCPTRA;V3;""Solde CP travaillés"";"
"IACQCP";"S";"0061";"   * CP sur jours non travaillés"
"IACQCP";"S";"0062";"   HJOU_IJRDCPNTRA;N;N5,1;I;;;    56789;;IJRDCPNTRA;V3;""Droit CP non travaillés"";"
"IACQCP";"S";"0063";"   HJOU_IJRCCPNTRA;N;N5,1;I;;;    56789;;IJRCCPNTRA;V3;""Pris CP non travaillés"";"
"IACQCP";"S";"0064";"   HJOU_IJRSCPNTRA;N;N5,1;I;;;    56789;;IJRSCPNTRA;V3;""Solde CP non travaillés"";"
"IACQCP";"S";"0065";"   * Jours de congés versés"
"IACQCP";"S";"0066";"   HJOU_IJRCOVER;N;N5,2;I;;;    56789;;IJRCOVER;V3;""Jours de congés versés"";"
"IACQCP";"S";"0067";"   HORC_IHIDRJTRAV;O;N5,2;I;;;123456789;;;C3;""Acquis congé payé"";"
"IACQCP";"S";"0068";"FINDICO"
"IACQCP";"S";"0069";"*"
"IACQCP";"S";"0070";"DEBANO"
"IACQCP";"S";"0071";"   177;8;""Congés samedi non pris reportés"";"
"IACQCP";"S";"0072";"   178;8;""Le nombre de congés samedi à prendre n'est pas respecté"";"
"IACQCP";"S";"0073";"   224;7;""Consigne de corrections des CP interdite"";"
"IACQCP";"S";"0074";"   197;8;""Solde acquisition congé insuffisant"";"
"IACQCP";"S";"0075";"   198;8;""Solde congé payé insuffisant"";"
"IACQCP";"S";"0076";"FINANO"
"IACQCP";"S";"0077";"*"
"IACQCP";"S";"0078";"* Déclaration des donnees locales"
"IACQCP";"S";"0079";"* Variables utilisées pour calculer la date de reference"
"IACQCP";"S";"0080";"DEF LOCA_DATE D"
"IACQCP";"S";"0081";"DEF LOCA_REF N2"
"IACQCP";"S";"0082";"* Variables utilisées pour le calcul de l'acquis mensuel"
"IACQCP";"S";"0083";"DEF LOCA_DATEACQ D"
"IACQCP";"S";"0084";"DEF LOCA_ENTIER N5.2"
"IACQCP";"S";"0085";"LOCA_ENTIER = 0"
"IACQCP";"S";"0086";"DEF LOCA_RESTE N5.2"
"IACQCP";"S";"0087";"LOCA_RESTE = 0"
"IACQCP";"S";"0088";"DEF LOCA_DIFFSAM N1"
"IACQCP";"S";"0089";"LOCA_DIFFSAM = 0"
"IACQCP";"S";"0090";"* Calcul de l'acquis mensuel"
"IACQCP";"S";"0091";"*"
"IACQCP";"S";"0092";"DEF LOCA_XJOUR N2"
"IACQCP";"S";"0093";"LOCA_XJOUR = 0"
"IACQCP";"S";"0094";"DEF LOCA_JOUR1 A1"
"IACQCP";"S";"0095";"LOCA_JOUR1 = "" """
"IACQCP";"S";"0096";"DEF LOCA_JOUR2 A1"
"IACQCP";"S";"0097";"LOCA_JOUR2 = "" """
"IACQCP";"S";"0098";"DEF LOCA_PLAFOND N2"
"IACQCP";"S";"0099";"LOCA_PLAFOND = 0"
"IACQCP";"S";"0100";"DEF LOCA_AGE N2"
"IACQCP";"S";"0101";"LOCA_AGE = 0"
"IACQCP";"S";"0102";"DEF LOCA_AGEENF N2"
"IACQCP";"S";"0103";"LOCA_AGEENF = 0"
"IACQCP";"S";"0104";"DEF LOCA_FERI N1"
"IACQCP";"S";"0105";"LOCA_FERI = 0"
"IACQCP";"S";"0106";"DEF LOCA_PRORA N2.2"
"IACQCP";"S";"0107";"LOCA_PRORA = 0"
"IACQCP";"S";"0108";"DEF LOCA_AVRIL D"
"IACQCP";"S";"0109";"LOCA_AVRIL = "" """
"IACQCP";"S";"0110";"*********"
"IACQCP";"S";"0111";"DEF LOCA_JRTRAV N1"
"IACQCP";"S";"0112";"LOCA_JRTRAV = 0"
"IACQCP";"S";"0113";"DEF LOCA_DRCP N6.3"
"IACQCP";"S";"0114";"LOCA_DRCP = 0"
"IACQCP";"S";"0115";"DEF LOCA_NBENFANT N2"
"IACQCP";"S";"0116";"LOCA_NBENFANT = 0"
"IACQCP";"S";"0117";"DEF LOCA_NBJENF N2"
"IACQCP";"S";"0118";"LOCA_NBJENF = 0"
"IACQCP";"S";"0119";"DEF LOCA_CPACQ N6.2"
"IACQCP";"S";"0120";"LOCA_CPACQ = 0"
"IACQCP";"S";"0121";"DEF LOCA_CAL N5.1"
"IACQCP";"S";"0122";"LOCA_CAL = 0"
"IACQCP";"S";"0123";"DEF LOCA_DRCPTRAV N5.2"
"IACQCP";"S";"0124";"LOCA_DRCPTRAV = 0"
"IACQCP";"S";"0125";"DEF LOCA_ACQUIS N4.2"
"IACQCP";"S";"0126";"LOCA_ACQUIS = 0"
"IACQCP";"S";"0127";"DEF LOCA_ACQTOTAL N4.2"
"IACQCP";"S";"0128";"LOCA_ACQTOTAL = 0"
"IACQCP";"S";"0129";"DEF LOCA_TRANS N6.1"
"IACQCP";"S";"0130";"LOCA_TRANS = 0"
"IACQCP";"S";"0131";"DEF LOCA_DROIT N6.1"
"IACQCP";"S";"0132";"LOCA_DROIT = 0"
"IACQCP";"S";"0133";"DEF LOCA_ACP N1"
"IACQCP";"S";"0134";"LOCA_ACP = 0"
"IACQCP";"S";"0135";"DEF LOCA_CP N1"
"IACQCP";"S";"0136";"LOCA_CP = 0"
"IACQCP";"S";"0137";"*"
"IACQCP";"S";"0138";"* Calcul de la date de référence CP"
"IACQCP";"S";"0139";"* stockage de l'année du jour de l'historique"
"IACQCP";"S";"0140";"LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IACQCP";"S";"0141";"* stockage du mois de reference"
"IACQCP";"S";"0142";"LOCA_REF << CONF_ITIVMREFCP(3:2)"
"IACQCP";"S";"0143";"* stokage du mois de reference"
"IACQCP";"S";"0144";"LOCA_DATE(5:2) << LOCA_REF"
"IACQCP";"S";"0145";"* stockage du jour de reference"
"IACQCP";"S";"0146";"LOCA_REF << CONF_ITIVMREFCP(1:2)"
"IACQCP";"S";"0147";"* loca_date contient maintenant l'année du jour de l'historique"
"IACQCP";"S";"0148";"* et le mois et le jour de reference"
"IACQCP";"S";"0149";"LOCA_DATE(7:2) << LOCA_REF"
"IACQCP";"S";"0150";"*"
"IACQCP";"S";"0151";"* test si gestion des cp"
"IACQCP";"S";"0152";"SI HJOU_IJIACOPRIN = ""1"""
"IACQCP";"S";"0153";"* Somme des acquis pour les temps partiel"
"IACQCP";"S";"0154";"   LOCA_ACQUIS = HORC_IHIDRJTRAV + HORC_IHIDRNTRAV"
"IACQCP";"S";"0155";"*************************************************************************************************"
"IACQCP";"S";"0156";"******************************************** ACQUISITION A LA PERIODE ***************************"
"IACQCP";"S";"0157";"*************************************************************************************************"
"IACQCP";"S";"0158";"   SI HORC_IHIMOACQCP = ""1"""
"IACQCP";"S";"0159";"   OU HORC_IHIMOACQCP = ""2"""
"IACQCP";"S";"0160";"*RAZ le lundi du compteur congés pris hebdo"
"IACQCP";"S";"0161";"      SI HJOU_JOUR = ""1"""
"IACQCP";"S";"0162";"         HJOU_IJRCPCOH = 0"
"IACQCP";"S";"0163";"      FINSI"
"IACQCP";"S";"0164";"***********************************************************************"
"IACQCP";"S";"0165";"********** DEFINITION DES VARIABLES SUIVANT LE CYCLE PARAMETRE ********"
"IACQCP";"S";"0166";"***********************************************************************"
"IACQCP";"S";"0167";"*Gestion si jour ouvrés/ouvrables"
"IACQCP";"S";"0168";"*Acquisition à la période sur un cycle de 24 jours"
"IACQCP";"S";"0169";"      SI HORC_IHIMOACQCP = ""1"""
"IACQCP";"S";"0170";"*Nb jours cycle"
"IACQCP";"S";"0171";"         LOCA_XJOUR = 24"
"IACQCP";"S";"0172";"*Plafond"
"IACQCP";"S";"0173";"         LOCA_PLAFOND = 30"
"IACQCP";"S";"0174";"*Lundi au samedi"
"IACQCP";"S";"0175";"         LOCA_JOUR1 = ""1"""
"IACQCP";"S";"0176";"         LOCA_JOUR2 = ""6"""
"IACQCP";"S";"0177";"      SINON"
"IACQCP";"S";"0178";"*Acquisition à la période sur un cycle de 20 jours"
"IACQCP";"S";"0179";"         SI HORC_IHIMOACQCP = ""2"""
"IACQCP";"S";"0180";"*Nb jours cycle"
"IACQCP";"S";"0181";"            LOCA_XJOUR = 20"
"IACQCP";"S";"0182";"*Plafond"
"IACQCP";"S";"0183";"            LOCA_PLAFOND = 25"
"IACQCP";"S";"0184";"*Lundi au vendredi"
"IACQCP";"S";"0185";"            LOCA_JOUR1 = ""1"""
"IACQCP";"S";"0186";"            LOCA_JOUR2 = ""5"""
"IACQCP";"S";"0187";"         FINSI"
"IACQCP";"S";"0188";"      FINSI"
"IACQCP";"S";"0189";"***********************************************************************"
"IACQCP";"S";"0190";"*************** GESTION DE L'ACQUISITION DES CONGES PAYES *************"
"IACQCP";"S";"0191";"***********************************************************************"
"IACQCP";"S";"0192";"* Date de reference"
"IACQCP";"S";"0193";"      SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IACQCP";"S";"0194";"*Si cycle de 24 jours incomplet"
"IACQCP";"S";"0195";"         SI HJOU_IJRCPTJTRA > 0"
"IACQCP";"S";"0196";"            SI LOCA_XJOUR > 0"
"IACQCP";"S";"0197";"               LOCA_DRCP = HJOU_IJRCPTJTRA / LOCA_XJOUR"
"IACQCP";"S";"0198";"            SINON"
"IACQCP";"S";"0199";"               LOCA_DRCP = 0"
"IACQCP";"S";"0200";"            FINSI"
"IACQCP";"S";"0201";"            LOCA_DRCP = LOCA_DRCP * LOCA_ACQUIS"
"IACQCP";"S";"0202";"*Alimenter acquis CP mensuel"
"IACQCP";"S";"0203";"            HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_DRCP"
"IACQCP";"S";"0204";"         FINSI"
"IACQCP";"S";"0205";"*Plafonné"
"IACQCP";"S";"0206";"         SI HJOU_IJRDACQCP >= LOCA_PLAFOND"
"IACQCP";"S";"0207";"            HJOU_IJRDACQCP = LOCA_PLAFOND"
"IACQCP";"S";"0208";"         SINON"
"IACQCP";"S";"0209";"** arrondi de l'acquis mensuel"
"IACQCP";"S";"0210";"            SI HJOU_IJRDACQCP > 0"
"IACQCP";"S";"0211";"               LOCA_RESTE = HJOU_IJRDACQCP % 1"
"IACQCP";"S";"0212";"               LOCA_ENTIER = HJOU_IJRDACQCP - LOCA_RESTE"
"IACQCP";"S";"0213";"               SI LOCA_RESTE > 0"
"IACQCP";"S";"0214";"                  LOCA_ENTIER = LOCA_ENTIER + 1"
"IACQCP";"S";"0215";"               FINSI"
"IACQCP";"S";"0216";"               HJOU_IJRDACQCP = LOCA_ENTIER"
"IACQCP";"S";"0217";"            FINSI"
"IACQCP";"S";"0218";"         FINSI"
"IACQCP";"S";"0219";"*Rajout des enfants"
"IACQCP";"S";"0220";"*Age de l'employé"
"IACQCP";"S";"0221";"         SI EMPS_E2DATENAI <> "" """
"IACQCP";"S";"0222";"*Age de l'employé"
"IACQCP";"S";"0223";"            DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"IACQCP";"S";"0224";"            LOCA_AGE = TEMP_NXANNEE"
"IACQCP";"S";"0225";"         SINON"
"IACQCP";"S";"0226";"*Si pas de date de naissance renseigné"
"IACQCP";"S";"0227";"*plus de 21 par défaut"
"IACQCP";"S";"0228";"            LOCA_AGE = 21"
"IACQCP";"S";"0229";"         FINSI"
"IACQCP";"S";"0230";"***"
"IACQCP";"S";"0231";"         LOCA_AVRIL(1:4) = HJOU_DATE(1:4)"
"IACQCP";"S";"0232";"         LOCA_AVRIL(5:4) = ""0401"""
"IACQCP";"S";"0233";"***"
"IACQCP";"S";"0234";"         POUR ENFANTS"
"IACQCP";"S";"0235";"*Age de l'enfant au 1er avril"
"IACQCP";"S";"0236";"            DATDIFF ENFT_ENFDATENAI 12 LOCA_AVRIL 12"
"IACQCP";"S";"0237";"            LOCA_AGEENF = TEMP_NXANNEE"
"IACQCP";"S";"0238";"******"
"IACQCP";"S";"0239";"            SI LOCA_AGEENF < 15"
"IACQCP";"S";"0240";"*Nb enfants de l'employé"
"IACQCP";"S";"0241";"               SI ENFT_ENFACHARGE = ""1"""
"IACQCP";"S";"0242";"                  LOCA_NBENFANT = LOCA_NBENFANT + 1"
"IACQCP";"S";"0243";"               FINSI"
"IACQCP";"S";"0244";"            FINSI"
"IACQCP";"S";"0245";"         FINPOUR"
"IACQCP";"S";"0246";"*"
"IACQCP";"S";"0247";"         SI LOCA_NBENFANT > 0"
"IACQCP";"S";"0248";"*Moins de 21 ans"
"IACQCP";"S";"0249";"            SI LOCA_AGE < 21"
"IACQCP";"S";"0250";"               SI HJOU_IJRDACQCP <= 6"
"IACQCP";"S";"0251";"*Ajout 1 jour par enfants à charge"
"IACQCP";"S";"0252";"                  LOCA_NBJENF = LOCA_NBENFANT"
"IACQCP";"S";"0253";"                  HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_NBJENF"
"IACQCP";"S";"0254";"               SINON"
"IACQCP";"S";"0255";"*Ajout 2 jours par enfants à charge"
"IACQCP";"S";"0256";"                  LOCA_NBJENF = LOCA_NBENFANT * 2"
"IACQCP";"S";"0257";"                  HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_NBJENF"
"IACQCP";"S";"0258";"                  SI HJOU_IJRDACQCP > LOCA_PLAFOND"
"IACQCP";"S";"0259";"                     HJOU_IJRDACQCP = LOCA_PLAFOND"
"IACQCP";"S";"0260";"                  FINSI"
"IACQCP";"S";"0261";"               FINSI"
"IACQCP";"S";"0262";"            SINON"
"IACQCP";"S";"0263";"*Plus de 21 ans"
"IACQCP";"S";"0264";"*Ajout 2 jours par enfants à charge"
"IACQCP";"S";"0265";"               LOCA_NBJENF = LOCA_NBENFANT * 2"
"IACQCP";"S";"0266";"               HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_NBJENF"
"IACQCP";"S";"0267";"               SI HJOU_IJRDACQCP > LOCA_PLAFOND"
"IACQCP";"S";"0268";"                  HJOU_IJRDACQCP = LOCA_PLAFOND"
"IACQCP";"S";"0269";"               FINSI"
"IACQCP";"S";"0270";"            FINSI"
"IACQCP";"S";"0271";"         FINSI"
"IACQCP";"S";"0272";"*Gestion reliquat"
"IACQCP";"S";"0273";"         SI HORC_IHIGESRELI = ""1"""
"IACQCP";"S";"0274";"*Reliquat congé"
"IACQCP";"S";"0275";"            HJOU_IJRSCORELI = HJOU_IJRSCOPRIN"
"IACQCP";"S";"0276";"         FINSI"
"IACQCP";"S";"0277";"* Droit CP = Droit acquisition - pris acquisition"
"IACQCP";"S";"0278";"         HJOU_IJRDCOPRIN = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0279";"* dans le cas ou on a du reliquat et que le compteur de nombre de samedi pris"
"IACQCP";"S";"0280";"* est < au nombre de samedi à prendre on conserve le reliquat du nombre de samedi à pren"
"IACQCP";"S";"0281";"         SI PARD_IDINBRSAMD > 0"
"IACQCP";"S";"0282";"**"
"IACQCP";"S";"0283";"* nombre de samedi à prendre"
"IACQCP";"S";"0284";"            HJOU_IJRSAMEAPR = PARD_IDINBRSAMD"
"IACQCP";"S";"0285";"            SI HJOU_IJRSCORELI > 0"
"IACQCP";"S";"0286";"               SI HJOU_IJRNBCPSAM < PARD_IDINBRSAMD"
"IACQCP";"S";"0287";"* on fait la difference entre le nombre de samedi à prendre et le nombre de sam"
"IACQCP";"S";"0288";"* pris"
"IACQCP";"S";"0289";"                  LOCA_DIFFSAM = PARD_IDINBRSAMD - HJOU_IJRNBCPSAM"
"IACQCP";"S";"0290";"                  HJOU_IJRSAMEAPR = HJOU_IJRSAMEAPR + LOCA_DIFFSAM"
"IACQCP";"S";"0291";"** mise en place d'une anomalie"
"IACQCP";"S";"0292";"                  ANOMALIE 177"
"IACQCP";"S";"0293";"               FINSI"
"IACQCP";"S";"0294";"            FINSI"
"IACQCP";"S";"0295";"** dans le cas ou le reliquat congé est à 0 et que le nombre de samedi pris < nombre"
"IACQCP";"S";"0296";"** de samedi à prendre mise en place d'une anomalie"
"IACQCP";"S";"0297";"            SI HJOU_IJRSCORELI = 0"
"IACQCP";"S";"0298";"               SI HJOU_IJRNBCPSAM < PARD_IDINBRSAMD"
"IACQCP";"S";"0299";"                  ANOMALIE 178"
"IACQCP";"S";"0300";"               FINSI"
"IACQCP";"S";"0301";"            FINSI"
"IACQCP";"S";"0302";"* raz du nombre de samedi pris"
"IACQCP";"S";"0303";"            HJOU_IJRNBCPSAM = 0"
"IACQCP";"S";"0304";"         FINSI"
"IACQCP";"S";"0305";"*"
"IACQCP";"S";"0306";"         HJOU_IJRCCOPRIN = HJOU_IJRCCOANTI"
"IACQCP";"S";"0307";"*Solde congés payés"
"IACQCP";"S";"0308";"         HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"IACQCP";"S";"0309";"*RAZ des CP sur jour travaillés et non travaillés"
"IACQCP";"S";"0310";"         HJOU_IJRDCPTRA = 0"
"IACQCP";"S";"0311";"         HJOU_IJRCCPTRA = 0"
"IACQCP";"S";"0312";"         HJOU_IJRSCPTRA = 0"
"IACQCP";"S";"0313";"*"
"IACQCP";"S";"0314";"         HJOU_IJRDCPNTRA = 0"
"IACQCP";"S";"0315";"         HJOU_IJRCCPNTRA = 0"
"IACQCP";"S";"0316";"         HJOU_IJRSCPNTRA = 0"
"IACQCP";"S";"0317";"* Si temps partiel (acquis sur jour non travaillé non renseigné)"
"IACQCP";"S";"0318";"         SI HORC_IHIDRNTRAV <> 0"
"IACQCP";"S";"0319";"*Solde acquisition congés"
"IACQCP";"S";"0320";"            HJOU_IJRDCPTRA = HJOU_IJRDACQCP"
"IACQCP";"S";"0321";"            HJOU_IJRDCPTRA = HJOU_IJRDCPTRA - HJOU_IJRPACQCP"
"IACQCP";"S";"0322";"*Droit congés payés sur jours travaillés"
"IACQCP";"S";"0323";"            SI LOCA_PLAFOND > 0"
"IACQCP";"S";"0324";"               LOCA_PRORA = HJOU_IJRDCPTRA / LOCA_PLAFOND"
"IACQCP";"S";"0325";"            SINON"
"IACQCP";"S";"0326";"               LOCA_PRORA = 0"
"IACQCP";"S";"0327";"            FINSI"
"IACQCP";"S";"0328";"            LOCA_DRCPTRAV = HORC_IHIDRJTRAV * 12"
"IACQCP";"S";"0329";"*"
"IACQCP";"S";"0330";"            HJOU_IJRDCPTRA = LOCA_PRORA * LOCA_DRCPTRAV"
"IACQCP";"S";"0331";"** arrondi cp travaillés"
"IACQCP";"S";"0332";"            SI HJOU_IJRDCPTRA > 0"
"IACQCP";"S";"0333";"               LOCA_RESTE = HJOU_IJRDCPTRA % 1"
"IACQCP";"S";"0334";"               LOCA_ENTIER = HJOU_IJRDCPTRA - LOCA_RESTE"
"IACQCP";"S";"0335";"               SI LOCA_RESTE >= 0.5"
"IACQCP";"S";"0336";"                  LOCA_ENTIER = LOCA_ENTIER + 1"
"IACQCP";"S";"0337";"               SINON"
"IACQCP";"S";"0338";"                  LOCA_ENTIER = LOCA_ENTIER + 0.5"
"IACQCP";"S";"0339";"               FINSI"
"IACQCP";"S";"0340";"               HJOU_IJRDCPTRA = LOCA_ENTIER"
"IACQCP";"S";"0341";"            FINSI"
"IACQCP";"S";"0342";"            HJOU_IJRDCPNTRA = HJOU_IJRDACQCP"
"IACQCP";"S";"0343";"            HJOU_IJRDCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRPACQCP"
"IACQCP";"S";"0344";"            HJOU_IJRDCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRDCPTRA"
"IACQCP";"S";"0345";"*Recalcul solde cp non travaillés"
"IACQCP";"S";"0346";"            HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"IACQCP";"S";"0347";"*Pris CP travaillés"
"IACQCP";"S";"0348";"            HJOU_IJRCCPTRA = HJOU_IJRCCOANTI"
"IACQCP";"S";"0349";"*Recalcul solde"
"IACQCP";"S";"0350";"            HJOU_IJRSCPTRA = HJOU_IJRDCPTRA - HJOU_IJRCCPTRA"
"IACQCP";"S";"0351";"            HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0352";"*Solde congés payés"
"IACQCP";"S";"0353";"            HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"IACQCP";"S";"0354";"         FINSI"
"IACQCP";"S";"0355";"*RAZ"
"IACQCP";"S";"0356";"*Congés en cours d'acquisition"
"IACQCP";"S";"0357";"         HJOU_IJRDACQCP = 0"
"IACQCP";"S";"0358";"         HJOU_IJRPACQCP = 0"
"IACQCP";"S";"0359";"         HJOU_IJRSACQCP = 0"
"IACQCP";"S";"0360";"*Congés anticipés"
"IACQCP";"S";"0361";"         HJOU_IJRCCOANTI = 0"
"IACQCP";"S";"0362";"*Suivi jours travaillés"
"IACQCP";"S";"0363";"         HJOU_IJRCPTJTRA = 0"
"IACQCP";"S";"0364";"*Jours de congés versés"
"IACQCP";"S";"0365";"         HJOU_IJRCOVER = 0"
"IACQCP";"S";"0366";"      FINSI"
"IACQCP";"S";"0367";"***********************************************************************"
"IACQCP";"S";"0368";"****** GESTION DE L'ACQUISITION DE L'ACQUIS CP SUIVANT LE CYCLE *******"
"IACQCP";"S";"0369";"***********************************************************************"
"IACQCP";"S";"0370";"*Calcul à la période de travail"
"IACQCP";"S";"0371";"      SI HJOU_JOUR >= LOCA_JOUR1"
"IACQCP";"S";"0372";"         SI HJOU_JOUR <= LOCA_JOUR2"
"IACQCP";"S";"0373";"*Si absence en jour sur la journée avec indicateur"
"IACQCP";"S";"0374";"*différent de 1 (supprime le droit aux congés)"
"IACQCP";"S";"0375";"            POUR ACTIVITES"
"IACQCP";"S";"0376";"               SI HABS_MOTYPE = ""A"""
"IACQCP";"S";"0377";"                  SI MOTI_IMICONTCPS <> ""2"""
"IACQCP";"S";"0378";"                     SI MOTI_IMICONTCPS <> ""3"""
"IACQCP";"S";"0379";"                        SI HABS_VALORIS = ""J"""
"IACQCP";"S";"0380";"                           LOCA_JRTRAV = 1"
"IACQCP";"S";"0381";"                        FINSI"
"IACQCP";"S";"0382";"                     FINSI"
"IACQCP";"S";"0383";"                  FINSI"
"IACQCP";"S";"0384";"               FINSI"
"IACQCP";"S";"0385";"            FINPOUR"
"IACQCP";"S";"0386";"*Ajouter 1 à chaque jours travaillés du lundi au samedi"
"IACQCP";"S";"0387";"            SI LOCA_JRTRAV <> 1"
"IACQCP";"S";"0388";"               HJOU_IJRCPTJTRA = HJOU_IJRCPTJTRA + 1"
"IACQCP";"S";"0389";"            FINSI"
"IACQCP";"S";"0390";"*Si X jours travaillés(24 jours ouvrables/20 jours ouvrés)"
"IACQCP";"S";"0391";"            SI HJOU_IJRCPTJTRA = LOCA_XJOUR"
"IACQCP";"S";"0392";"*Ajouter acquis mensuel"
"IACQCP";"S";"0393";"               HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_ACQUIS"
"IACQCP";"S";"0394";"               *"
"IACQCP";"S";"0395";"               SI HJOU_IJRDACQCP > LOCA_PLAFOND"
"IACQCP";"S";"0396";"                  HJOU_IJRDACQCP = LOCA_PLAFOND"
"IACQCP";"S";"0397";"               FINSI"
"IACQCP";"S";"0398";"               *"
"IACQCP";"S";"0399";"*RAZ nombre de jours travaillés"
"IACQCP";"S";"0400";"               HJOU_IJRCPTJTRA = 0"
"IACQCP";"S";"0401";"*Si il a pris des congés anticipés"
"IACQCP";"S";"0402";"               SI HJOU_IJRCCOANTI > 0"
"IACQCP";"S";"0403";"*Si droit acquisition >= congés anticipés"
"IACQCP";"S";"0404";"                  SI HJOU_IJRDACQCP >= HJOU_IJRCCOANTI"
"IACQCP";"S";"0405";"                     HJOU_IJRPACQCP = HJOU_IJRPACQCP + HJOU_IJRCCOANTI"
"IACQCP";"S";"0406";"                     HJOU_IJRCCOANTI = 0"
"IACQCP";"S";"0407";"                  SINON"
"IACQCP";"S";"0408";"                     LOCA_CPACQ = HJOU_IJRCCOANTI - HJOU_IJRDACQCP"
"IACQCP";"S";"0409";"** arrondi de l'acquis mensuel"
"IACQCP";"S";"0410";"                     SI LOCA_CPACQ > 0"
"IACQCP";"S";"0411";"                        LOCA_RESTE = LOCA_CPACQ % 1"
"IACQCP";"S";"0412";"                        LOCA_ENTIER = LOCA_CPACQ - LOCA_RESTE"
"IACQCP";"S";"0413";"                        SI LOCA_RESTE > 0"
"IACQCP";"S";"0414";"                           LOCA_ENTIER = LOCA_ENTIER + 1"
"IACQCP";"S";"0415";"                        FINSI"
"IACQCP";"S";"0416";"                        LOCA_CPACQ = LOCA_ENTIER"
"IACQCP";"S";"0417";"                     FINSI"
"IACQCP";"S";"0418";"****"
"IACQCP";"S";"0419";"                     LOCA_CAL = HJOU_IJRCCOANTI - LOCA_CPACQ"
"IACQCP";"S";"0420";"                     HJOU_IJRPACQCP = HJOU_IJRPACQCP + LOCA_CAL"
"IACQCP";"S";"0421";"                     HJOU_IJRCCOANTI = LOCA_CPACQ"
"IACQCP";"S";"0422";"                  FINSI"
"IACQCP";"S";"0423";"               FINSI"
"IACQCP";"S";"0424";"               HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0425";"            FINSI"
"IACQCP";"S";"0426";"         FINSI"
"IACQCP";"S";"0427";"      FINSI"
"IACQCP";"S";"0428";"***********************************************************************"
"IACQCP";"S";"0429";"****************** GESTION NOMBRE DE SAMEDI A PRENDRE *****************"
"IACQCP";"S";"0430";"***********************************************************************"
"IACQCP";"S";"0431";"      SI PARD_IDINBRSAMD > 0"
"IACQCP";"S";"0432";"         SI HJOU_IJRSAMEAPR = 0"
"IACQCP";"S";"0433";"            HJOU_IJRSAMEAPR = PARD_IDINBRSAMD"
"IACQCP";"S";"0434";"         FINSI"
"IACQCP";"S";"0435";"      FINSI"
"IACQCP";"S";"0436";"***********************************************************************"
"IACQCP";"S";"0437";"******************* GESTION CONSIGNES D'INIT. ET MAJ ******************"
"IACQCP";"S";"0438";"***********************************************************************"
"IACQCP";"S";"0439";"      POUR ACTIVITES"
"IACQCP";"S";"0440";"* consignes de MAJ"
"IACQCP";"S";"0441";"         SI HABS_MOTIF = ""XDACP"""
"IACQCP";"S";"0442";"            LOCA_ACP = 1"
"IACQCP";"S";"0443";"            HJOU_IJRDACQCP = HJOU_IJRDACQCP + HABS_MOTINBR"
"IACQCP";"S";"0444";"            HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0445";"         FINSI"
"IACQCP";"S";"0446";"* consignes d'initialisation"
"IACQCP";"S";"0447";"         SI HABS_MOTIF = ""ZDACP"""
"IACQCP";"S";"0448";"            LOCA_ACP = 1"
"IACQCP";"S";"0449";"            HJOU_IJRDACQCP = HABS_MOTINBR"
"IACQCP";"S";"0450";"            HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0451";"         FINSI"
"IACQCP";"S";"0452";"* Reliquat"
"IACQCP";"S";"0453";"         SI HORC_IHIGESRELI = ""1"""
"IACQCP";"S";"0454";"            SI HABS_MOTIF = ""XRCP"""
"IACQCP";"S";"0455";"               HJOU_IJRSCORELI = HJOU_IJRSCORELI + HABS_MOTINBR"
"IACQCP";"S";"0456";"            FINSI"
"IACQCP";"S";"0457";"            SI HABS_MOTIF = ""ZRCP"""
"IACQCP";"S";"0458";"               HJOU_IJRSCORELI = HABS_MOTINBR"
"IACQCP";"S";"0459";"            FINSI"
"IACQCP";"S";"0460";"         FINSI"
"IACQCP";"S";"0461";"* Gestion des consignes CP"
"IACQCP";"S";"0462";"         SI HORC_IHIDRNTRAV = 0"
"IACQCP";"S";"0463";"            SI HABS_MOTIF = ""XDCP"""
"IACQCP";"S";"0464";"               LOCA_CP = 1"
"IACQCP";"S";"0465";"               LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCOPRIN"
"IACQCP";"S";"0466";"               LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCOPRIN"
"IACQCP";"S";"0467";"               *"
"IACQCP";"S";"0468";"               HJOU_IJRDCOPRIN = HJOU_IJRDCOPRIN + HABS_MOTINBR"
"IACQCP";"S";"0469";"               HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN + LOCA_TRANS"
"IACQCP";"S";"0470";"            FINSI"
"IACQCP";"S";"0471";"            SI HABS_MOTIF = ""ZDCP"""
"IACQCP";"S";"0472";"               LOCA_CP = 1"
"IACQCP";"S";"0473";"               LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCOPRIN"
"IACQCP";"S";"0474";"               *"
"IACQCP";"S";"0475";"               HJOU_IJRDCOPRIN = HABS_MOTINBR"
"IACQCP";"S";"0476";"               HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN + LOCA_TRANS"
"IACQCP";"S";"0477";"            FINSI"
"IACQCP";"S";"0478";"         SINON"
"IACQCP";"S";"0479";"* Consignes CP travaillé"
"IACQCP";"S";"0480";"            SI HABS_MOTIF = ""XDCPT"""
"IACQCP";"S";"0481";"               LOCA_CP = 1"
"IACQCP";"S";"0482";"               LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCPTRA"
"IACQCP";"S";"0483";"               LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCPTRA"
"IACQCP";"S";"0484";"               *"
"IACQCP";"S";"0485";"               HJOU_IJRDCPTRA = HJOU_IJRDCPTRA + HABS_MOTINBR"
"IACQCP";"S";"0486";"               HJOU_IJRSCPTRA = HJOU_IJRSCPTRA + LOCA_TRANS"
"IACQCP";"S";"0487";"* Recalcul des compteurs congé payé"
"IACQCP";"S";"0488";"               HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0489";"               HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN + LOCA_TRANS"
"IACQCP";"S";"0490";"            FINSI"
"IACQCP";"S";"0491";"            SI HABS_MOTIF = ""ZDCPT"""
"IACQCP";"S";"0492";"               LOCA_CP = 1"
"IACQCP";"S";"0493";"               LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCPTRA"
"IACQCP";"S";"0494";"               *"
"IACQCP";"S";"0495";"               HJOU_IJRDCPTRA = HABS_MOTINBR"
"IACQCP";"S";"0496";"               HJOU_IJRSCPTRA = HJOU_IJRSCPTRA + LOCA_TRANS"
"IACQCP";"S";"0497";"* Recalcul des compteurs congé payé"
"IACQCP";"S";"0498";"               HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0499";"               HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN + LOCA_TRANS"
"IACQCP";"S";"0500";"            FINSI"
"IACQCP";"S";"0501";"* Consignes CP non travaillé"
"IACQCP";"S";"0502";"            SI HABS_MOTIF = ""XDCPNT"""
"IACQCP";"S";"0503";"               HJOU_IJRDCPNTRA = HJOU_IJRDCPNTRA + HABS_MOTINBR"
"IACQCP";"S";"0504";"               HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"IACQCP";"S";"0505";"* Recalcul des compteurs congé payé"
"IACQCP";"S";"0506";"               HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0507";"               HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"IACQCP";"S";"0508";"            FINSI"
"IACQCP";"S";"0509";"            SI HABS_MOTIF = ""ZDCPNT"""
"IACQCP";"S";"0510";"               HJOU_IJRDCPNTRA = HABS_MOTINBR"
"IACQCP";"S";"0511";"               HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"IACQCP";"S";"0512";"* Recalcul des compteurs congé payé"
"IACQCP";"S";"0513";"               HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0514";"               HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"IACQCP";"S";"0515";"            FINSI"
"IACQCP";"S";"0516";"         FINSI"
"IACQCP";"S";"0517";"      FINPOUR"
"IACQCP";"S";"0518";"      *"
"IACQCP";"S";"0519";"      * Gestion ano solde insuffisant"
"IACQCP";"S";"0520";"      SI LOCA_ACP = 1"
"IACQCP";"S";"0521";"         SI HJOU_IJRSACQCP < 0"
"IACQCP";"S";"0522";"            ANOMALIE 197"
"IACQCP";"S";"0523";"         FINSI"
"IACQCP";"S";"0524";"      FINSI"
"IACQCP";"S";"0525";"      *"
"IACQCP";"S";"0526";"      SI LOCA_CP = 1"
"IACQCP";"S";"0527";"         SI HORC_IHIDRNTRAV = 0"
"IACQCP";"S";"0528";"            SI HJOU_IJRSCOPRIN < 0"
"IACQCP";"S";"0529";"               ANOMALIE 198"
"IACQCP";"S";"0530";"            FINSI"
"IACQCP";"S";"0531";"         SINON"
"IACQCP";"S";"0532";"            SI HJOU_IJRSCPTRA < 0"
"IACQCP";"S";"0533";"               ANOMALIE 198"
"IACQCP";"S";"0534";"            FINSI"
"IACQCP";"S";"0535";"         FINSI"
"IACQCP";"S";"0536";"      FINSI"
"IACQCP";"S";"0537";"   SINON"
"IACQCP";"S";"0538";"**********************************************************************************************"
"IACQCP";"S";"0539";"********************************************** ACQUISITION MENSUEL ***************************"
"IACQCP";"S";"0540";"**********************************************************************************************"
"IACQCP";"S";"0541";"***********************************************************************"
"IACQCP";"S";"0542";"*********** GESTION DE L'ACQUISITION DE L'ACQUIS CP MENSUEL ***********"
"IACQCP";"S";"0543";"***********************************************************************"
"IACQCP";"S";"0544";"* RAZ du compteur de suivi des jours travaillés car non utilisé"
"IACQCP";"S";"0545";"* en acquisition mensuel"
"IACQCP";"S";"0546";"      HJOU_IJRCPTJTRA = 0"
"IACQCP";"S";"0547";"      LOCA_ACQTOTAL = HORC_IHIDRJTRAV + HORC_IHIDRNTRAV"
"IACQCP";"S";"0548";"* Jours ouvrés"
"IACQCP";"S";"0549";"      SI LOCA_ACQTOTAL = 2.08"
"IACQCP";"S";"0550";"        LOCA_PLAFOND = 25"
"IACQCP";"S";"0551";"      SINON"
"IACQCP";"S";"0552";"* Jours ouvrables"
"IACQCP";"S";"0553";"        SI LOCA_ACQTOTAL = 2.5"
"IACQCP";"S";"0554";"           LOCA_PLAFOND = 30"
"IACQCP";"S";"0555";"        FINSI"
"IACQCP";"S";"0556";"      FINSI"
"IACQCP";"S";"0557";"* l'acquis est calculé le dernier jour du mois"
"IACQCP";"S";"0558";"      SI TEMP_DATSUI(7:2) = ""01"""
"IACQCP";"S";"0559";"* l'employé à une date de début de contrat <= au 01 du mois d'acquisition"
"IACQCP";"S";"0560";"         LOCA_DATEACQ = HJOU_DATE"
"IACQCP";"S";"0561";"         LOCA_DATEACQ(7:2) = ""01"""
"IACQCP";"S";"0562";"         SI CTRA_DATDEB <= LOCA_DATEACQ"
"IACQCP";"S";"0563";"            HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_ACQUIS"
"IACQCP";"S";"0564";"            *"
"IACQCP";"S";"0565";"            SI HJOU_IJRDACQCP > LOCA_PLAFOND"
"IACQCP";"S";"0566";"                HJOU_IJRDACQCP = LOCA_PLAFOND"
"IACQCP";"S";"0567";"            FINSI"
"IACQCP";"S";"0568";"* Calcul solde"
"IACQCP";"S";"0569";"            HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0570";"         SINON"
"IACQCP";"S";"0571";"* cas ou l'employé est rentré en cours de mois"
"IACQCP";"S";"0572";"* il faut que le compteur de nombre de jours travaillés mensuel soit >= 20"
"IACQCP";"S";"0573";"            SI HJOU_IJRNJTRMCP >= 20"
"IACQCP";"S";"0574";"               HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_ACQUIS"
"IACQCP";"S";"0575";"               *"
"IACQCP";"S";"0576";"               SI HJOU_IJRDACQCP > LOCA_PLAFOND"
"IACQCP";"S";"0577";"                  HJOU_IJRDACQCP = LOCA_PLAFOND"
"IACQCP";"S";"0578";"               FINSI"
"IACQCP";"S";"0579";"* Calcul solde"
"IACQCP";"S";"0580";"               HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0581";"            FINSI"
"IACQCP";"S";"0582";"         FINSI"
"IACQCP";"S";"0583";"      FINSI"
"IACQCP";"S";"0584";"***********************************************************************"
"IACQCP";"S";"0585";"************** GESTION DE L'ACQUISITION DES CONGES PAYES **************"
"IACQCP";"S";"0586";"***********************************************************************"
"IACQCP";"S";"0587";"* traitement au mois de reference"
"IACQCP";"S";"0588";"      SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"IACQCP";"S";"0589";"** arrondi de l'acquis mensuel"
"IACQCP";"S";"0590";"         SI HJOU_IJRDACQCP > 0"
"IACQCP";"S";"0591";"            LOCA_RESTE = HJOU_IJRDACQCP % 1"
"IACQCP";"S";"0592";"            LOCA_ENTIER = HJOU_IJRDACQCP - LOCA_RESTE"
"IACQCP";"S";"0593";"            SI LOCA_RESTE > 0"
"IACQCP";"S";"0594";"               LOCA_ENTIER = LOCA_ENTIER + 1"
"IACQCP";"S";"0595";"            FINSI"
"IACQCP";"S";"0596";"            HJOU_IJRDACQCP = LOCA_ENTIER"
"IACQCP";"S";"0597";"         FINSI"
"IACQCP";"S";"0598";"*** Gestion des enfants"
"IACQCP";"S";"0599";"*"
"IACQCP";"S";"0600";"*Rajout des enfants"
"IACQCP";"S";"0601";"*Age de l'employé"
"IACQCP";"S";"0602";"         SI EMPS_E2DATENAI <> "" """
"IACQCP";"S";"0603";"*Age de l'employé"
"IACQCP";"S";"0604";"            DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"IACQCP";"S";"0605";"            LOCA_AGE = TEMP_NXANNEE"
"IACQCP";"S";"0606";"         SINON"
"IACQCP";"S";"0607";"*Si pas de date de naissance renseigné"
"IACQCP";"S";"0608";"*plus de 21 par défaut"
"IACQCP";"S";"0609";"            LOCA_AGE = 21"
"IACQCP";"S";"0610";"         FINSI"
"IACQCP";"S";"0611";"***"
"IACQCP";"S";"0612";"         LOCA_AVRIL(1:4) = HJOU_DATE(1:4)"
"IACQCP";"S";"0613";"         LOCA_AVRIL(5:4) = ""0401"""
"IACQCP";"S";"0614";"***"
"IACQCP";"S";"0615";"         POUR ENFANTS"
"IACQCP";"S";"0616";"*Age de l'enfant au 1er avril"
"IACQCP";"S";"0617";"            DATDIFF ENFT_ENFDATENAI 12 LOCA_AVRIL 12"
"IACQCP";"S";"0618";"            LOCA_AGEENF = TEMP_NXANNEE"
"IACQCP";"S";"0619";"******"
"IACQCP";"S";"0620";"            SI LOCA_AGEENF < 15"
"IACQCP";"S";"0621";"*Nb enfants de l'employé"
"IACQCP";"S";"0622";"               SI ENFT_ENFACHARGE = ""1"""
"IACQCP";"S";"0623";"                  LOCA_NBENFANT = LOCA_NBENFANT + 1"
"IACQCP";"S";"0624";"               FINSI"
"IACQCP";"S";"0625";"            FINSI"
"IACQCP";"S";"0626";"         FINPOUR"
"IACQCP";"S";"0627";"*"
"IACQCP";"S";"0628";"         SI LOCA_NBENFANT > 0"
"IACQCP";"S";"0629";"*Moins de 21 ans"
"IACQCP";"S";"0630";"            SI LOCA_AGE < 21"
"IACQCP";"S";"0631";"               SI HJOU_IJRDACQCP <= 6"
"IACQCP";"S";"0632";"*Ajout 1 jour par enfants à charge"
"IACQCP";"S";"0633";"                  LOCA_NBJENF = LOCA_NBENFANT"
"IACQCP";"S";"0634";"                  HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_NBJENF"
"IACQCP";"S";"0635";"               SINON"
"IACQCP";"S";"0636";"*Ajout 2 jours par enfants à charge"
"IACQCP";"S";"0637";"                  LOCA_NBJENF = LOCA_NBENFANT * 2"
"IACQCP";"S";"0638";"                  HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_NBJENF"
"IACQCP";"S";"0639";"                  SI HJOU_IJRDACQCP > LOCA_PLAFOND"
"IACQCP";"S";"0640";"                     HJOU_IJRDACQCP = LOCA_PLAFOND"
"IACQCP";"S";"0641";"                  FINSI"
"IACQCP";"S";"0642";"               FINSI"
"IACQCP";"S";"0643";"            SINON"
"IACQCP";"S";"0644";"*Plus de 21 ans"
"IACQCP";"S";"0645";"*Ajout 2 jours par enfants à charge"
"IACQCP";"S";"0646";"               LOCA_NBJENF = LOCA_NBENFANT * 2"
"IACQCP";"S";"0647";"               HJOU_IJRDACQCP = HJOU_IJRDACQCP + LOCA_NBJENF"
"IACQCP";"S";"0648";"               SI HJOU_IJRDACQCP > LOCA_PLAFOND"
"IACQCP";"S";"0649";"                  HJOU_IJRDACQCP = LOCA_PLAFOND"
"IACQCP";"S";"0650";"               FINSI"
"IACQCP";"S";"0651";"            FINSI"
"IACQCP";"S";"0652";"         FINSI"
"IACQCP";"S";"0653";"* Si gestion du reliquat"
"IACQCP";"S";"0654";"         SI HORC_IHIGESRELI = ""1"""
"IACQCP";"S";"0655";"            HJOU_IJRSCORELI = HJOU_IJRSCOPRIN"
"IACQCP";"S";"0656";"         FINSI"
"IACQCP";"S";"0657";"* dans le cas ou on a du reliquat et que le compteur de nombre de samedi pris"
"IACQCP";"S";"0658";"* est < au nombre de samedi à prendre on conserve le reliquat du nombre de samedi à pren"
"IACQCP";"S";"0659";"         SI PARD_IDINBRSAMD > 0"
"IACQCP";"S";"0660";"**"
"IACQCP";"S";"0661";"* nombre de samedi à prendre"
"IACQCP";"S";"0662";"            HJOU_IJRSAMEAPR = PARD_IDINBRSAMD"
"IACQCP";"S";"0663";"            SI HJOU_IJRSCORELI > 0"
"IACQCP";"S";"0664";"               SI HJOU_IJRNBCPSAM < PARD_IDINBRSAMD"
"IACQCP";"S";"0665";"* on fait la difference entre le nombre de samedi à prendre et le nombre de sam"
"IACQCP";"S";"0666";"* pris"
"IACQCP";"S";"0667";"                  LOCA_DIFFSAM = PARD_IDINBRSAMD - HJOU_IJRNBCPSAM"
"IACQCP";"S";"0668";"                  HJOU_IJRSAMEAPR = HJOU_IJRSAMEAPR + LOCA_DIFFSAM"
"IACQCP";"S";"0669";"** mise en place d'une anomalie"
"IACQCP";"S";"0670";"                  ANOMALIE 177"
"IACQCP";"S";"0671";"               FINSI"
"IACQCP";"S";"0672";"            FINSI"
"IACQCP";"S";"0673";"** dans le cas ou le reliquat congé est à 0 et que le nombre de samedi pris < nombre"
"IACQCP";"S";"0674";"** de samedi à prendre mise en place d'une anomalie"
"IACQCP";"S";"0675";"            SI HJOU_IJRSCORELI = 0"
"IACQCP";"S";"0676";"               SI HJOU_IJRNBCPSAM < PARD_IDINBRSAMD"
"IACQCP";"S";"0677";"                  ANOMALIE 178"
"IACQCP";"S";"0678";"               FINSI"
"IACQCP";"S";"0679";"            FINSI"
"IACQCP";"S";"0680";"* raz du nombre de samedi pris"
"IACQCP";"S";"0681";"            HJOU_IJRNBCPSAM = 0"
"IACQCP";"S";"0682";"         FINSI"
"IACQCP";"S";"0683";"**"
"IACQCP";"S";"0684";"**"
"IACQCP";"S";"0685";"         HJOU_IJRDCOPRIN = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0686";"         HJOU_IJRCCOPRIN = HJOU_IJRCCOANTI"
"IACQCP";"S";"0687";"         HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"IACQCP";"S";"0688";"*RAZ des CP sur jour travaillés et non travaillés"
"IACQCP";"S";"0689";"         HJOU_IJRDCPTRA = 0"
"IACQCP";"S";"0690";"         HJOU_IJRCCPTRA = 0"
"IACQCP";"S";"0691";"         HJOU_IJRSCPTRA = 0"
"IACQCP";"S";"0692";"*"
"IACQCP";"S";"0693";"         HJOU_IJRDCPNTRA = 0"
"IACQCP";"S";"0694";"         HJOU_IJRCCPNTRA = 0"
"IACQCP";"S";"0695";"         HJOU_IJRSCPNTRA = 0"
"IACQCP";"S";"0696";"* Si temps partiel (acquis sur jour non travaillé non renseigné)"
"IACQCP";"S";"0697";"         SI HORC_IHIDRNTRAV <> 0"
"IACQCP";"S";"0698";"*Solde acquisition congés"
"IACQCP";"S";"0699";"            HJOU_IJRDCPTRA = HJOU_IJRDACQCP"
"IACQCP";"S";"0700";"            HJOU_IJRDCPTRA = HJOU_IJRDCPTRA - HJOU_IJRPACQCP"
"IACQCP";"S";"0701";"*Droit congés payés sur jours travaillés"
"IACQCP";"S";"0702";"            SI LOCA_PLAFOND > 0"
"IACQCP";"S";"0703";"               LOCA_PRORA = HJOU_IJRDCPTRA / LOCA_PLAFOND"
"IACQCP";"S";"0704";"            SINON"
"IACQCP";"S";"0705";"               LOCA_PRORA = 0"
"IACQCP";"S";"0706";"            FINSI"
"IACQCP";"S";"0707";"*"
"IACQCP";"S";"0708";"            LOCA_DRCPTRAV = HORC_IHIDRJTRAV * 12"
"IACQCP";"S";"0709";"*"
"IACQCP";"S";"0710";"            HJOU_IJRDCPTRA = LOCA_PRORA * LOCA_DRCPTRAV"
"IACQCP";"S";"0711";"** arrondi cp travaillés"
"IACQCP";"S";"0712";"            SI HJOU_IJRDCPTRA > 0"
"IACQCP";"S";"0713";"               LOCA_RESTE = HJOU_IJRDCPTRA % 1"
"IACQCP";"S";"0714";"               LOCA_ENTIER = HJOU_IJRDCPTRA - LOCA_RESTE"
"IACQCP";"S";"0715";"               SI LOCA_RESTE >= 0.5"
"IACQCP";"S";"0716";"                  LOCA_ENTIER = LOCA_ENTIER + 1"
"IACQCP";"S";"0717";"               SINON"
"IACQCP";"S";"0718";"                  LOCA_ENTIER = LOCA_ENTIER + 0.5"
"IACQCP";"S";"0719";"               FINSI"
"IACQCP";"S";"0720";"               HJOU_IJRDCPTRA = LOCA_ENTIER"
"IACQCP";"S";"0721";"            FINSI"
"IACQCP";"S";"0722";"            HJOU_IJRDCPNTRA = HJOU_IJRDACQCP"
"IACQCP";"S";"0723";"            HJOU_IJRDCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRPACQCP"
"IACQCP";"S";"0724";"            HJOU_IJRDCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRDCPTRA"
"IACQCP";"S";"0725";"*Recalcul solde cp non travaillés"
"IACQCP";"S";"0726";"            HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"IACQCP";"S";"0727";"*Pris CP travaillés"
"IACQCP";"S";"0728";"            HJOU_IJRCCPTRA = HJOU_IJRCCOANTI"
"IACQCP";"S";"0729";"*Recalcul solde"
"IACQCP";"S";"0730";"            HJOU_IJRSCPTRA = HJOU_IJRDCPTRA - HJOU_IJRCCPTRA"
"IACQCP";"S";"0731";"            HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0732";"*Solde congés payés"
"IACQCP";"S";"0733";"            HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"IACQCP";"S";"0734";"         FINSI"
"IACQCP";"S";"0735";"         HJOU_IJRCCOANTI = 0"
"IACQCP";"S";"0736";"* Acquisition"
"IACQCP";"S";"0737";"         HJOU_IJRDACQCP = 0"
"IACQCP";"S";"0738";"         HJOU_IJRPACQCP = 0"
"IACQCP";"S";"0739";"         HJOU_IJRSACQCP = 0"
"IACQCP";"S";"0740";"      FINSI"
"IACQCP";"S";"0741";"***********************************************************************"
"IACQCP";"S";"0742";"****************** GESTION NOMBRE DE SAMEDI A PRENDRE *****************"
"IACQCP";"S";"0743";"***********************************************************************"
"IACQCP";"S";"0744";"      SI PARD_IDINBRSAMD > 0"
"IACQCP";"S";"0745";"         SI HJOU_IJRSAMEAPR = 0"
"IACQCP";"S";"0746";"            HJOU_IJRSAMEAPR = PARD_IDINBRSAMD"
"IACQCP";"S";"0747";"         FINSI"
"IACQCP";"S";"0748";"      FINSI"
"IACQCP";"S";"0749";"***********************************************************************"
"IACQCP";"S";"0750";"******************* GESTION CONSIGNES D'INIT. ET MAJ ******************"
"IACQCP";"S";"0751";"***********************************************************************"
"IACQCP";"S";"0752";"      POUR ACTIVITES"
"IACQCP";"S";"0753";"* consignes de MAJ"
"IACQCP";"S";"0754";"         SI HABS_MOTIF = ""XDACP"""
"IACQCP";"S";"0755";"            LOCA_ACP = 1"
"IACQCP";"S";"0756";"            HJOU_IJRDACQCP = HJOU_IJRDACQCP + HABS_MOTINBR"
"IACQCP";"S";"0757";"            HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0758";"         FINSI"
"IACQCP";"S";"0759";"* consignes d'initialisation"
"IACQCP";"S";"0760";"         SI HABS_MOTIF = ""ZDACP"""
"IACQCP";"S";"0761";"            LOCA_ACP = 1"
"IACQCP";"S";"0762";"            HJOU_IJRDACQCP = HABS_MOTINBR"
"IACQCP";"S";"0763";"            HJOU_IJRSACQCP = HJOU_IJRDACQCP - HJOU_IJRPACQCP"
"IACQCP";"S";"0764";"         FINSI"
"IACQCP";"S";"0765";"* Reliquat"
"IACQCP";"S";"0766";"         SI HORC_IHIGESRELI = ""1"""
"IACQCP";"S";"0767";"            SI HABS_MOTIF = ""XRCP"""
"IACQCP";"S";"0768";"               HJOU_IJRSCORELI = HJOU_IJRSCORELI + HABS_MOTINBR"
"IACQCP";"S";"0769";"            FINSI"
"IACQCP";"S";"0770";"            SI HABS_MOTIF = ""ZRCP"""
"IACQCP";"S";"0771";"               HJOU_IJRSCORELI = HABS_MOTINBR"
"IACQCP";"S";"0772";"            FINSI"
"IACQCP";"S";"0773";"         FINSI"
"IACQCP";"S";"0774";"* Gestion des consignes CP"
"IACQCP";"S";"0775";"         SI HORC_IHIDRNTRAV = 0"
"IACQCP";"S";"0776";"            SI HABS_MOTIF = ""XDCP"""
"IACQCP";"S";"0777";"               LOCA_CP = 1"
"IACQCP";"S";"0778";"               LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCOPRIN"
"IACQCP";"S";"0779";"               LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCOPRIN"
"IACQCP";"S";"0780";"               *"
"IACQCP";"S";"0781";"               HJOU_IJRDCOPRIN = HJOU_IJRDCOPRIN + HABS_MOTINBR"
"IACQCP";"S";"0782";"               HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN + LOCA_TRANS"
"IACQCP";"S";"0783";"            FINSI"
"IACQCP";"S";"0784";"            SI HABS_MOTIF = ""ZDCP"""
"IACQCP";"S";"0785";"               LOCA_CP = 1"
"IACQCP";"S";"0786";"               LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCOPRIN"
"IACQCP";"S";"0787";"               *"
"IACQCP";"S";"0788";"               HJOU_IJRDCOPRIN = HABS_MOTINBR"
"IACQCP";"S";"0789";"               HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN + LOCA_TRANS"
"IACQCP";"S";"0790";"            FINSI"
"IACQCP";"S";"0791";"         SINON"
"IACQCP";"S";"0792";"* Consignes CP travaillé"
"IACQCP";"S";"0793";"            SI HABS_MOTIF = ""XDCPT"""
"IACQCP";"S";"0794";"               LOCA_CP = 1"
"IACQCP";"S";"0795";"               LOCA_DROIT = HABS_MOTINBR + HJOU_IJRDCPTRA"
"IACQCP";"S";"0796";"               LOCA_TRANS = LOCA_DROIT - HJOU_IJRDCPTRA"
"IACQCP";"S";"0797";"               *"
"IACQCP";"S";"0798";"               HJOU_IJRDCPTRA = HJOU_IJRDCPTRA + HABS_MOTINBR"
"IACQCP";"S";"0799";"               HJOU_IJRSCPTRA = HJOU_IJRSCPTRA + LOCA_TRANS"
"IACQCP";"S";"0800";"* Recalcul des compteurs congé payé"
"IACQCP";"S";"0801";"               HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0802";"               HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN + LOCA_TRANS"
"IACQCP";"S";"0803";"            FINSI"
"IACQCP";"S";"0804";"            SI HABS_MOTIF = ""ZDCPT"""
"IACQCP";"S";"0805";"               LOCA_CP = 1"
"IACQCP";"S";"0806";"               LOCA_TRANS = HABS_MOTINBR - HJOU_IJRDCPTRA"
"IACQCP";"S";"0807";"               *"
"IACQCP";"S";"0808";"               HJOU_IJRDCPTRA = HABS_MOTINBR"
"IACQCP";"S";"0809";"               HJOU_IJRSCPTRA = HJOU_IJRSCPTRA + LOCA_TRANS"
"IACQCP";"S";"0810";"* Recalcul des compteurs congé payé"
"IACQCP";"S";"0811";"               HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0812";"               HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN + LOCA_TRANS"
"IACQCP";"S";"0813";"            FINSI"
"IACQCP";"S";"0814";"* Consignes CP non travaillé"
"IACQCP";"S";"0815";"            SI HABS_MOTIF = ""XDCPNT"""
"IACQCP";"S";"0816";"               HJOU_IJRDCPNTRA = HJOU_IJRDCPNTRA + HABS_MOTINBR"
"IACQCP";"S";"0817";"               HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"IACQCP";"S";"0818";"* Recalcul des compteurs congé payé"
"IACQCP";"S";"0819";"               HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0820";"               HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"IACQCP";"S";"0821";"            FINSI"
"IACQCP";"S";"0822";"            SI HABS_MOTIF = ""ZDCPNT"""
"IACQCP";"S";"0823";"               HJOU_IJRDCPNTRA = HABS_MOTINBR"
"IACQCP";"S";"0824";"               HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"IACQCP";"S";"0825";"* Recalcul des compteurs congé payé"
"IACQCP";"S";"0826";"               HJOU_IJRDCOPRIN = HJOU_IJRDCPTRA + HJOU_IJRDCPNTRA"
"IACQCP";"S";"0827";"               HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"IACQCP";"S";"0828";"            FINSI"
"IACQCP";"S";"0829";"         FINSI"
"IACQCP";"S";"0830";"      FINPOUR"
"IACQCP";"S";"0831";"      *"
"IACQCP";"S";"0832";"      * Gestion ano solde insuffisant"
"IACQCP";"S";"0833";"      SI LOCA_ACP = 1"
"IACQCP";"S";"0834";"         SI HJOU_IJRSACQCP < 0"
"IACQCP";"S";"0835";"            ANOMALIE 197"
"IACQCP";"S";"0836";"         FINSI"
"IACQCP";"S";"0837";"      FINSI"
"IACQCP";"S";"0838";"      *"
"IACQCP";"S";"0839";"      SI LOCA_CP = 1"
"IACQCP";"S";"0840";"         SI HORC_IHIDRNTRAV = 0"
"IACQCP";"S";"0841";"            SI HJOU_IJRSCOPRIN < 0"
"IACQCP";"S";"0842";"               ANOMALIE 198"
"IACQCP";"S";"0843";"            FINSI"
"IACQCP";"S";"0844";"         SINON"
"IACQCP";"S";"0845";"            SI HJOU_IJRSCPTRA < 0"
"IACQCP";"S";"0846";"               ANOMALIE 198"
"IACQCP";"S";"0847";"            FINSI"
"IACQCP";"S";"0848";"         FINSI"
"IACQCP";"S";"0849";"      FINSI"
"IACQCP";"S";"0850";"   FINSI"
"IACQCP";"S";"0851";"FINSI"
"IACQCP";"S";"0852";"FIN"
"IACQCPAN1";"S";"0001";"***********************************************************************"
"IACQCPAN1";"S";"0002";"*"
"IACQCPAN1";"S";"0003";"* Règle : IACQCPAN1"
"IACQCPAN1";"S";"0004";"* Ordre : 3580"
"IACQCPAN1";"S";"0005";"* Titre : Gestion de l'acquisition des congés payés d'acnienneté"
"IACQCPAN1";"S";"0006";"*         pour SITE UNIQUE et date de réf. = date de réf. des CP"
"IACQCPAN1";"S";"0007";"*"
"IACQCPAN1";"S";"0008";"*----------------------------------------------------------------------"
"IACQCPAN1";"S";"0009";"*"
"IACQCPAN1";"S";"0010";"* Créé par : Méthodes et outils"
"IACQCPAN1";"S";"0011";"* Date     : 02/05/2019"
"IACQCPAN1";"S";"0012";"* Version  : 1"
"IACQCPAN1";"S";"0013";"*"
"IACQCPAN1";"S";"0014";"*----------------------------------------------------------------------"
"IACQCPAN1";"S";"0015";"*"
"IACQCPAN1";"S";"0016";"*"
"IACQCPAN1";"S";"0017";"* Rôle : BT 65154 : Gestion acquisition des CP d'ancienneté SITE UNIQUE"
"IACQCPAN1";"S";"0018";"*                   et même date de référence que les CP"
"IACQCPAN1";"S";"0019";"*"
"IACQCPAN1";"S";"0020";"*        Récupération de la partie acquisition des congés d'ancienneté"
"IACQCPAN1";"S";"0021";"*        de la règle ICONGES du package indus V11"
"IACQCPAN1";"S";"0022";"*        Ajout de l'acquisition des congés d'ancienneté suivant différents"
"IACQCPAN1";"S";"0023";"*        seuils et droits à paramétrer dans PARD"
"IACQCPAN1";"S";"0024";"*        Date de réf. des congés d'ancienneté = Date de réf. des CP"
"IACQCPAN1";"S";"0025";"*"
"IACQCPAN1";"S";"0026";"*"
"IACQCPAN1";"S";"0027";"* Implémentation des données industrielles"
"IACQCPAN1";"S";"0028";"*"
"IACQCPAN1";"S";"0029";"*"
"IACQCPAN1";"S";"0030";"*----------------------------------------------------------------------"
"IACQCPAN1";"S";"0031";"*"
"IACQCPAN1";"S";"0032";"* Modifiée par :"
"IACQCPAN1";"S";"0033";"* Date         : JJ/MM/AAAA"
"IACQCPAN1";"S";"0034";"* Objet        :"
"IACQCPAN1";"S";"0035";"*"
"IACQCPAN1";"S";"0036";"*"
"IACQCPAN1";"S";"0037";"***********************************************************************"
"IACQCPAN1";"S";"0038";"*"
"IACQCPAN1";"S";"0039";"DEBDICO"
"IACQCPAN1";"S";"0040";"   HJOU_IJRDCOANCI;N;N5,1;I;;;    56789;;IJRDCOANCI;V3;""Droit congé ancienneté"";"
"IACQCPAN1";"S";"0041";"   HJOU_IJRCCOANCI;N;N5,1;I;;;    56789;;IJRCCOANCI;V3;""Congé ancienneté pris"";"
"IACQCPAN1";"S";"0042";"   HJOU_IJRSCOANCI;N;N6,1;I;;;    56789;;IJRSCOANCI;V3;""Solde congé ancienneté"";"
"IACQCPAN1";"S";"0043";"   CONF_ITIVMREFCP;O;A4;X;;;123456789;;;C3;""Date de référence congé payé (JJMM)"";"
"IACQCPAN1";"S";"0044";"   *********"
"IACQCPAN1";"S";"0045";"   HJOU_IJIREGCPAN;O;Z1;X;;;123456789;L;;C2;""Régime des congés d'ancienneté"";"
"IACQCPAN1";"S";"0046";"   PARD_IDISANC1;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 1 ""RÉGIME 1"""";"
