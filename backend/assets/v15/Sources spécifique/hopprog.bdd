"ITPSACTHT9";"S";"0031";"*"
"ITPSACTHT9";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTHT9";"S";"0033";"*"
"ITPSACTHT9";"S";"0034";"DEBDICO"
"ITPSACTHT9";"S";"0035";"SECH_ISIACTI;O;A1;X;;;123456789;L;;C3;""Section géré en activité"";"
"ITPSACTHT9";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTHT9";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTHT9";"S";"0038";"FINDICO"
