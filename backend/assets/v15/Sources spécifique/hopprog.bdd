"IANALJ";"S";"0028";"*"
"IANALJ";"S";"0029";"* Implémentation des données industrielles"
"IANALJ";"S";"0030";"*"
"IANALJ";"S";"0031";"DEBDICO"
"IANALJ";"S";"0032";"   HJOU_IJRPREVEIL;O;T6,2;I;;;        9;;IJQPRELEND;V3;""Présence de la veille"";"
"IANALJ";"S";"0033";"   HJOU_IJQPREJENC;O;T6,2;I;;;        9;;;V2;""Présence jour en cours"";"
"IANALJ";"S";"0034";"   HJOU_IJQPRELEND;O;T6,2;I;;;        9;;;V2;""Présence du lendemain"";"
"IANALJ";"S";"0035";"   HJOU_IJQDEBADGV;N;T6,2;I;;;     6789;;;V2;""Dernier badgeage validé"";"
"IANALJ";"S";"0036";"   HJOU_IJQPRBADGV;N;T6,2;I;;;     6789;;;V2;""Premier badgeage validé"";"
"IANALJ";"S";"0037";"FINDICO"
"IANALJ";"S";"0038";"*"
"IANALJ";"S";"0039";"* Déclaration des donnees locales"
"IANALJ";"S";"0040";"*"
"IANALJ";"S";"0041";"* Analyse de la veille"
"IANALJ";"S";"0042";"* Modifie le 13/10/97."
"IANALJ";"S";"0043";"* Les deux lignes  17 18 ont ete mises en remarque ."
"IANALJ";"S";"0044";"* Par defaut, dans le package HJVEILLE est le report de la donn?e"
"IANALJ";"S";"0045";"* HJREPORT."
"IANALJ";"S";"0046";"* Ceci permettra de calculer par exemple les heures travaill?es f?ri?e"
"IANALJ";"S";"0047";"* tenant compte des heures faites de 0 a 24h sur la veille."
"IANALJ";"S";"0048";"* Si vous avez un profil avec une borne sur la journee de la veille"
"IANALJ";"S";"0049";"* (exemple 21< - 5), vous pouvez r?activer les lignes pour calculer le"
"IANALJ";"S";"0050";"* temps de la veille (et mettre dans le dico de report de la donn?e"
"IANALJ";"S";"0051";"* HJREPORT a zero)"
"IANALJ";"S";"0052";"*"
"IANALJ";"S";"0053";"* ANALYSE -12 0"
"IANALJ";"S";"0054";"* HJOU_IJRPREVEIL = TEMP_HIPRE"
"IANALJ";"S";"0055";"*"
"IANALJ";"S";"0056";"* Analyse de la journee en cours"
"IANALJ";"S";"0057";"* Cette analyse permet de calculer dans le compteur hjou_hjenc"
"IANALJ";"S";"0058";"* les heures comprises entre 0 et 24 (exemple, sur un horaire 21h00 5h"
"IANALJ";"S";"0059";"* hjou_hjenc = 3.00 )"
"IANALJ";"S";"0060";"*"
"IANALJ";"S";"0061";"SI HJOU_DATE <= TEMP_DATJOU"
"IANALJ";"S";"0062";"   DEF LOCA_NUM N1"
"IANALJ";"S";"0063";"   LOCA_NUM = 0"
"IANALJ";"S";"0064";"   ANALYSE 0 24"
"IANALJ";"S";"0065";"   HJOU_IJQPREJENC = TEMP_HIPRE"
"IANALJ";"S";"0066";"*"
"IANALJ";"S";"0067";"*  Analyse apres minuit"
"IANALJ";"S";"0068";"*  Cette analyse permet de calculer dans le compteur hjou_hjreport"
"IANALJ";"S";"0069";"*  les heures apres minuit (exemple sur horaire 21h00 5h00,"
"IANALJ";"S";"0070";"*  hjou_hjreport = 5.00)"
"IANALJ";"S";"0071";"   ANALYSE 24 36"
"IANALJ";"S";"0072";"   HJOU_IJQPRELEND = TEMP_HIPRE"
"IANALJ";"S";"0073";"*  recuperation du premier et dernier badgeages"
"IANALJ";"S";"0074";"*  utilise dans le controle des contraintes l?gales"
"IANALJ";"S";"0075";"   POUR POINTAGES"
"IANALJ";"S";"0076";"*recuperation du dernier pointage"
"IANALJ";"S";"0077";"      HJOU_IJQDEBADGV = POIN_HRETRAI"
"IANALJ";"S";"0078";"*Recuperation du 1er pointage"
"IANALJ";"S";"0079";"      LOCA_NUM = LOCA_NUM + 1"
"IANALJ";"S";"0080";"      SI LOCA_NUM = 1"
"IANALJ";"S";"0081";"         HJOU_IJQPRBADGV = POIN_HRETRAI"
"IANALJ";"S";"0082";"      FINSI"
"IANALJ";"S";"0083";"   FINPOUR"
"IANALJ";"S";"0084";"FINSI"
"IANALJ";"S";"0085";"FIN"
"IANALP";"S";"0001";"**********************************************************************"
"IANALP";"S";"0002";"*"
"IANALP";"S";"0003";"* Règle : IANALP"
"IANALP";"S";"0004";"* Ordre : 2150"
"IANALP";"S";"0005";"* Titre : Analyse des journées (pour pénibilité)"
"IANALP";"S";"0006";"*"
"IANALP";"S";"0007";"*---------------------------------------------------------------------"
"IANALP";"S";"0008";"*"
"IANALP";"S";"0009";"* Créé par : Cellule Industrialisation"
"IANALP";"S";"0010";"* Date     : 04/12/2017"
"IANALP";"S";"0011";"* Version  : 1"
"IANALP";"S";"0012";"*"
"IANALP";"S";"0013";"*---------------------------------------------------------------------"
"IANALP";"S";"0014";"*"
"IANALP";"S";"0015";"*"
"IANALP";"S";"0016";"* Rôle :"
"IANALP";"S";"0017";"*"
"IANALP";"S";"0018";"* Calcul des heures de nuit réalisées entre minuit et 5h."
"IANALP";"S";"0019";"* Stockage des heures réalisées entre 24h et 5h dans un compteur."
"IANALP";"S";"0020";"* Prise en compte de la présence entre 0h et 5h. Si aucune présence entre 0h et 5h,"
"IANALP";"S";"0021";"* prise en compte de la présence entre 24h et 5h."
"IANALP";"S";"0022";"* Pour les non badgeants, prise en compte de la présence théorique entre 24h et 5h"
"IANALP";"S";"0023";"* en analysant les badgeages théoriques du profil."
"IANALP";"S";"0024";"* Prise en compte de la présence théorique entre 0h et 5h."
"IANALP";"S";"0025";"* Si aucune présence théorique entre 0h et 5h, prise en compte de la présence théorique"
"IANALP";"S";"0026";"* entre 24h et 5h."
"IANALP";"S";"0027";"* Le compteur obtenu est contrôlé dans le calcul de la pénibilité (règle IPENIB)."
"IANALP";"S";"0028";"*"
"IANALP";"S";"0029";"*---------------------------------------------------------------------"
"IANALP";"S";"0030";"*"
"IANALP";"S";"0031";"* Dates d'effet :"
"IANALP";"S";"0032";"*"
"IANALP";"S";"0033";"* Date début : ../../...., Date fin   : ../../...."
"IANALP";"S";"0034";"*"
"IANALP";"S";"0035";"*---------------------------------------------------------------------"
"IANALP";"S";"0036";"*"
"IANALP";"S";"0037";"* Portée du calcul : Passé / présent"
"IANALP";"S";"0038";"*"
"IANALP";"S";"0039";"*---------------------------------------------------------------------"
"IANALP";"S";"0040";"*"
"IANALP";"S";"0041";"* Portée du report : ..."
"IANALP";"S";"0042";"*"
"IANALP";"S";"0043";"*---------------------------------------------------------------------"
"IANALP";"S";"0044";"*"
"IANALP";"S";"0045";"* Données en entrée :"
"IANALP";"S";"0046";"*"
"IANALP";"S";"0047";"*"
"IANALP";"S";"0048";"* --- Données élémentaires ---"
"IANALP";"S";"0049";"* TEMP_DATJOU"
"IANALP";"S";"0050";"* TEMP_HIPRE"
"IANALP";"S";"0051";"* HJOU_DATE"
"IANALP";"S";"0052";"* PROF_PTTHEO1"
"IANALP";"S";"0053";"* PROF_PTTHEO2"
"IANALP";"S";"0054";"* PROF_PTTHEO3"
"IANALP";"S";"0055";"* PROF_PTTHEO4"
"IANALP";"S";"0056";"*"
"IANALP";"S";"0057";"* --- Données personnalisées ---"
"IANALP";"S";"0058";"* HJOU_IJIGBADGEA"
"IANALP";"S";"0059";"*"
"IANALP";"S";"0060";"*"
"IANALP";"S";"0061";"* Données en sortie :"
"IANALP";"S";"0062";"*"
"IANALP";"S";"0063";"* --- Données personnalisées ---"
"IANALP";"S";"0064";"* HJOU_IJQNUIPEN"
"IANALP";"S";"0065";"*"
"IANALP";"S";"0066";"* --- Messages ---"
"IANALP";"S";"0067";"*"
"IANALP";"S";"0068";"* N° / msg / Gravité"
"IANALP";"S";"0069";"*"
"IANALP";"S";"0070";"*---------------------------------------------------------------------"
"IANALP";"S";"0071";"*"
"IANALP";"S";"0072";"* Implémentation des données industrielles"
"IANALP";"S";"0073";"*"
"IANALP";"S";"0074";"DEBDICO"
"IANALP";"S";"0075";"   HJOU_IJQNUIPEN;N;T6,2;I;;;    56789;;;V2;""Heures de nuit pour pénibilité"";"
"IANALP";"S";"0076";"FINDICO"
"IANALP";"S";"0077";"*"
"IANALP";"S";"0078";"*---------------------------------------------------------------------"
"IANALP";"S";"0079";"*"
"IANALP";"S";"0080";"* Modifiée par : Prénom Nom"
"IANALP";"S";"0081";"* Date         : JJ/MM/AAAA"
"IANALP";"S";"0082";"* Objet        :"
"IANALP";"S";"0083";"*"
"IANALP";"S";"0084";"**********************************************************************"
"IANALP";"S";"0085";"*"
"IANALP";"S";"0086";"* Définition des variables locales"
"IANALP";"S";"0087";"*"
"IANALP";"S";"0088";"* Borne début et fin des heures de nuit pour pénibilité"
"IANALP";"S";"0089";"DEF LOCA_DEBN T6.2"
"IANALP";"S";"0090";"LOCA_DEBN = 0"
"IANALP";"S";"0091";"DEF LOCA_FINN T6.2"
"IANALP";"S";"0092";"LOCA_FINN = 5"
"IANALP";"S";"0093";"*"
"IANALP";"S";"0094";"* Pas de calcul dans le futur"
"IANALP";"S";"0095";"SI HJOU_DATE <= TEMP_DATJOU"
"IANALP";"S";"0096";"* Cas des employés badgeants"
"IANALP";"S";"0097";"   SI HJOU_IJIGBADGEA = ""1"""
"IANALP";"S";"0098";"* Calcul de la présence entre 0h et 5h"
"IANALP";"S";"0099";"      ANALYSE LOCA_DEBN LOCA_FINN"
"IANALP";"S";"0100";"      HJOU_IJQNUIPEN = TEMP_HIPRE"
"IANALP";"S";"0101";"      SI HJOU_IJQNUIPEN = 0"
"IANALP";"S";"0102";"         LOCA_DEBN = 24"
"IANALP";"S";"0103";"         LOCA_FINN = 29"
"IANALP";"S";"0104";"* Calcul de la présence entre 24h et 5h"
"IANALP";"S";"0105";"         ANALYSE LOCA_DEBN LOCA_FINN"
"IANALP";"S";"0106";"         HJOU_IJQNUIPEN = TEMP_HIPRE"
"IANALP";"S";"0107";"      FINSI"
"IANALP";"S";"0108";"   SINON"
"IANALP";"S";"0109";"* Cas des employés non badgeants"
"IANALP";"S";"0110";"* Calcul de la présence théorique entre 0h et 5h"
"IANALP";"S";"0111";"      FAIRE CALCNUI"
"IANALP";"S";"0112";"      SI HJOU_IJQNUIPEN = 0"
"IANALP";"S";"0113";"         LOCA_DEBN = 24"
"IANALP";"S";"0114";"         LOCA_FINN = 29"
"IANALP";"S";"0115";"* Calcul de la présence théorique entre 24h et 5h"
"IANALP";"S";"0116";"         FAIRE CALCNUI"
"IANALP";"S";"0117";"      FINSI"
"IANALP";"S";"0118";"   FINSI"
"IANALP";"S";"0119";"FINSI"
"IANALP";"S";"0120";"FIN"
"IANALP";"S";"0121";"*"
"IANALP";"S";"0122";"*"
"IANALP";"S";"0123";"* Procédure de calcul de la présence théorique entre loca_debn et loca_finn"
"IANALP";"S";"0124";"PROC CALCNUI"
"IANALP";"S";"0125";"* En fonction des badgeages théoriques entrée 1 et sortie 1"
"IANALP";"S";"0126";"   SI PROF_PTTHEO1 <> 32700"
"IANALP";"S";"0127";"      SI PROF_PTTHEO1 < LOCA_FINN"
"IANALP";"S";"0128";"         SI PROF_PTTHEO2 > LOCA_DEBN"
"IANALP";"S";"0129";"            SI PROF_PTTHEO2 <= LOCA_FINN"
"IANALP";"S";"0130";"               SI PROF_PTTHEO1 > LOCA_DEBN"
"IANALP";"S";"0131";"                  HJOU_IJQNUIPEN = PROF_PTTHEO2 - PROF_PTTHEO1"
"IANALP";"S";"0132";"               SINON"
"IANALP";"S";"0133";"                  HJOU_IJQNUIPEN = PROF_PTTHEO2 - LOCA_DEBN"
"IANALP";"S";"0134";"               FINSI"
"IANALP";"S";"0135";"            SINON"
"IANALP";"S";"0136";"               SI PROF_PTTHEO1 > LOCA_DEBN"
"IANALP";"S";"0137";"                  HJOU_IJQNUIPEN = LOCA_FINN - PROF_PTTHEO1"
"IANALP";"S";"0138";"               SINON"
"IANALP";"S";"0139";"                  HJOU_IJQNUIPEN = 5"
"IANALP";"S";"0140";"               FINSI"
"IANALP";"S";"0141";"            FINSI"
"IANALP";"S";"0142";"         FINSI"
"IANALP";"S";"0143";"      FINSI"
"IANALP";"S";"0144";"   FINSI"
"IANALP";"S";"0145";"* En fonction des badgeages théoriques entrée 2 et sortie 2"
"IANALP";"S";"0146";"   SI PROF_PTTHEO3 <> 32700"
"IANALP";"S";"0147";"      SI PROF_PTTHEO3 < LOCA_FINN"
"IANALP";"S";"0148";"         SI PROF_PTTHEO4 > LOCA_DEBN"
"IANALP";"S";"0149";"            SI PROF_PTTHEO4 <= LOCA_FINN"
"IANALP";"S";"0150";"               SI PROF_PTTHEO3 > LOCA_DEBN"
"IANALP";"S";"0151";"                  HJOU_IJQNUIPEN = HJOU_IJQNUIPEN + PROF_PTTHEO4"
"IANALP";"S";"0152";"                  HJOU_IJQNUIPEN = HJOU_IJQNUIPEN - PROF_PTTHEO3"
"IANALP";"S";"0153";"               SINON"
"IANALP";"S";"0154";"                  HJOU_IJQNUIPEN = HJOU_IJQNUIPEN + PROF_PTTHEO4"
"IANALP";"S";"0155";"                  HJOU_IJQNUIPEN = HJOU_IJQNUIPEN - LOCA_DEBN"
"IANALP";"S";"0156";"               FINSI"
"IANALP";"S";"0157";"            SINON"
"IANALP";"S";"0158";"               SI PROF_PTTHEO3 > LOCA_DEBN"
"IANALP";"S";"0159";"                  HJOU_IJQNUIPEN = HJOU_IJQNUIPEN + LOCA_FINN"
"IANALP";"S";"0160";"                  HJOU_IJQNUIPEN = HJOU_IJQNUIPEN - PROF_PTTHEO3"
"IANALP";"S";"0161";"               SINON"
"IANALP";"S";"0162";"                  HJOU_IJQNUIPEN = HJOU_IJQNUIPEN + 5"
"IANALP";"S";"0163";"               FINSI"
"IANALP";"S";"0164";"            FINSI"
"IANALP";"S";"0165";"         FINSI"
"IANALP";"S";"0166";"      FINSI"
"IANALP";"S";"0167";"   FINSI"
"IANALP";"S";"0168";"FINPROC"
"IANALP";"S";"0169";"*"
"IANNU";"S";"0001";"***********************************************************************"
"IANNU";"S";"0002";"*"
"IANNU";"S";"0003";"* Règle : IANNU"
"IANNU";"S";"0004";"* Ordre : 6130"
"IANNU";"S";"0005";"* Titre : Gestion de l'annualisation"
"IANNU";"S";"0006";"*"
"IANNU";"S";"0007";"*----------------------------------------------------------------------"
"IANNU";"S";"0008";"*"
"IANNU";"S";"0009";"* Créé par : Cellule Industrialisation"
"IANNU";"S";"0010";"* Date     : 03/09/2009"
"IANNU";"S";"0011";"* Version  : 1"
"IANNU";"S";"0012";"*"
"IANNU";"S";"0013";"*----------------------------------------------------------------------"
"IANNU";"S";"0014";"*"
"IANNU";"S";"0015";"*"
"IANNU";"S";"0016";"* Rôle : Gestion de l'annualisation"
"IANNU";"S";"0017";"*"
"IANNU";"S";"0018";"*"
"IANNU";"S";"0019";"*----------------------------------------------------------------------"
"IANNU";"S";"0020";"*"
"IANNU";"S";"0021";"* Modifiée par : Cellule Industrialisation"
"IANNU";"S";"0022";"* Date         : JJ/MM/AAAA"
"IANNU";"S";"0023";"* Objet        :"
"IANNU";"S";"0024";"*"
"IANNU";"S";"0025";"***********************************************************************"
"IANNU";"S";"0026";"*"
"IANNU";"S";"0027";"* Implémentation des données industrielles"
"IANNU";"S";"0028";"*"
"IANNU";"S";"0029";"DEBDICO"
"IANNU";"S";"0030";"   HJOU_IJRCTRPMOD;N;T8,2;L;;;     6789;;IJRCTRPMOD;V3;""Contrat théorique annuel"";"
"IANNU";"S";"0031";"   HJOU_IJRTTEPMOD;N;T8,2;L;;;     6789;;IJRTTEPMOD;V3;""Heures effectives annuelles"";"
"IANNU";"S";"0032";"   HJOU_IJQHSMAPAA;N;T6,2;L;;;    56789;;;V3;""Heures supplémentaires 25% annuelles"";"
"IANNU";"S";"0033";"   EMPL_IEQTTREFFA;N;T8,2;L;;;     6789;;;V3;""Temps de travail effectif annuel"";"
"IANNU";"S";"0034";"   EMPL_IEQECARANN;N;T8,2;L;;;     6789;;;V3;""Ecart annuel"";"
"IANNU";"S";"0035";"FINDICO"
"IANNU";"S";"0036";"*"
"IANNU";"S";"0037";"* Déclaration des donnees locales"
"IANNU";"S";"0038";"*"
"IANNU";"S";"0039";"DEF LOCA_DATANU D"
"IANNU";"S";"0040";"LOCA_DATANU = "" """
"IANNU";"S";"0041";"DEF LOCA_DATEFU D"
"IANNU";"S";"0042";"LOCA_DATEFU = "" """
"IANNU";"S";"0043";"DEF LOCA_ACOURS N4"
"IANNU";"S";"0044";"LOCA_ACOURS = 0"
"IANNU";"S";"0045";"** calcul des hs annuelles"
"IANNU";"S";"0046";"SI PARD_IDIDDEBANN <> "" """
"IANNU";"S";"0047";"   LOCA_DATANU = PARD_IDIDDEBANN"
"IANNU";"S";"0048";"   SI HJOU_DATE = PARD_IDIDDEBANN"
"IANNU";"S";"0049";"      HJOU_IJRCTRPMOD = PARD_IDIVOBJTHA"
"IANNU";"S";"0050";"      HJOU_IJRTTEPMOD = 0"
"IANNU";"S";"0051";"      HJOU_IJRECARANN = 0"
"IANNU";"S";"0052";"   FINSI"
"IANNU";"S";"0053";"SINON"
"IANNU";"S";"0054";"   LOCA_DATANU(1:4) = HJOU_DATE(1:4)"
"IANNU";"S";"0055";"   LOCA_DATANU(5:4) = ""0101"""
"IANNU";"S";"0056";"   SI HJOU_DATE(5:4) = ""0101"""
"IANNU";"S";"0057";"      HJOU_IJRCTRPMOD = PARD_IDIVOBJTHA"
"IANNU";"S";"0058";"      HJOU_IJRTTEPMOD = 0"
"IANNU";"S";"0059";"      HJOU_IJRECARANN = 0"
"IANNU";"S";"0060";"   FINSI"
"IANNU";"S";"0061";"FINSI"
"IANNU";"S";"0062";"* Calcul de la date de fin d'annualisation"
"IANNU";"S";"0063";"* pour le calcul des heures effectives annuelles previsionnelles"
"IANNU";"S";"0064";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IANNU";"S";"0065";"SI TEMP_DATJOU(5:4) >= LOCA_DATANU(5:4)"
"IANNU";"S";"0066";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"IANNU";"S";"0067";"FINSI"
"IANNU";"S";"0068";"LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IANNU";"S";"0069";"LOCA_DATEFU(5:4) = LOCA_DATANU(5:4)"
"IANNU";"S";"0070";"**"
"IANNU";"S";"0071";"*  initialisation du contigent par consignes"
"IANNU";"S";"0072";"POUR ACTIVITES"
"IANNU";"S";"0073";"   SI HABS_MOTIF = ""ZCON"""
"IANNU";"S";"0074";"      HJOU_IJRCTRPMOD = HABS_MOTIDUR"
"IANNU";"S";"0075";"   FINSI"
"IANNU";"S";"0076";"FINPOUR"
"IANNU";"S";"0077";"*"
"IANNU";"S";"0078";"HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD + HJOU_IJQTTEFFEJ"
"IANNU";"S";"0079";"*  initialisation par consigne"
"IANNU";"S";"0080";"POUR ACTIVITES"
"IANNU";"S";"0081";"   SI HABS_MOTIF = ""XEFA"""
"IANNU";"S";"0082";"      HJOU_IJRTTEPMOD = HJOU_IJRTTEPMOD + HABS_MOTIDUR"
"IANNU";"S";"0083";"   FINSI"
"IANNU";"S";"0084";"   SI HABS_MOTIF = ""ZEFA"""
"IANNU";"S";"0085";"      HJOU_IJRTTEPMOD = HABS_MOTIDUR"
"IANNU";"S";"0086";"   FINSI"
"IANNU";"S";"0087";"FINPOUR"
"IANNU";"S";"0088";"SI HJOU_IJRCTRPMOD > 0"
"IANNU";"S";"0089";"   HJOU_IJRECARANN = HJOU_IJRTTEPMOD - HJOU_IJRCTRPMOD"
"IANNU";"S";"0090";"FINSI"
"IANNU";"S";"0091";"** calcul des HS annuelles"
"IANNU";"S";"0092";"** ce sont les heures de travail effectif faites au-dela du contrat an"
"IANNU";"S";"0093";"** deduites des HS déja payés et récupérés ( il ne faut pas repayer"
"IANNU";"S";"0094";"** les heures récupérées)en cours d'année."
"IANNU";"S";"0095";"SI HJOU_IJIGHSUPPM = ""3"""
"IANNU";"S";"0096";"   SI TEMP_DATSUI(5:4) = LOCA_DATANU(5:4)"
"IANNU";"S";"0097";"      SI HJOU_IJRECARANN > 0"
"IANNU";"S";"0098";"* si l'ecat annuel est supérieur au cumul"
"IANNU";"S";"0099";"* des hs payees et recuperees l'ecart alimente"
"IANNU";"S";"0100";"* le compteur HS annuel"
"IANNU";"S";"0101";"         SI HJOU_IJRECARANN > HJOU_IJRHSMPAYA"
"IANNU";"S";"0102";"            HJOU_IJQHSMAPAA = HJOU_IJRECARANN - HJOU_IJRHSMPAYA"
"IANNU";"S";"0103";"         FINSI"
"IANNU";"S";"0104";"      FINSI"
"IANNU";"S";"0105";"   FINSI"
"IANNU";"S";"0106";"FINSI"
"IANNU";"S";"0107";"* Calul des heures effectives previsionnelles"
"IANNU";"S";"0108";"SI TEMP_DATSUI = LOCA_DATEFU"
"IANNU";"S";"0109";"   EMPL_IEQTTREFFA = HJOU_IJRTTEPMOD"
"IANNU";"S";"0110";"   EMPL_IEQECARANN = HJOU_IJRECARANN"
"IANNU";"S";"0111";"FINSI"
"IANNU";"S";"0112";"*"
"IANNU";"S";"0113";"* initialisation par consigne"
"IANNU";"S";"0114";"POUR ACTIVITES"
"IANNU";"S";"0115";"   SI HABS_MOTIF = ""XHS25A"""
"IANNU";"S";"0116";"      HJOU_IJQHSMAPAA = HJOU_IJQHSMAPAA + HABS_MOTIDUR"
"IANNU";"S";"0117";"   FINSI"
"IANNU";"S";"0118";"   SI HABS_MOTIF = ""ZHS25A"""
"IANNU";"S";"0119";"      HJOU_IJQHSMAPAA = HABS_MOTIDUR"
"IANNU";"S";"0120";"   FINSI"
"IANNU";"S";"0121";"FINPOUR"
"IANNU";"S";"0122";"FIN"
"IBADGWBA";"S";"0001";"**********************************************************************"
