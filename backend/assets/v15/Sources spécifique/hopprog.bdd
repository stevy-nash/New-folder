"SDURABS";"S";"0001";"***********************************************************************"
"SDURABS";"S";"0002";"*"
"SDURABS";"S";"0003";"* Règle : IDURABS"
"SDURABS";"S";"0004";"* Ordre : 3090"
"SDURABS";"S";"0005";"* Titre : Durée des absences"
"SDURABS";"S";"0006";"*"
"SDURABS";"S";"0007";"*----------------------------------------------------------------------"
"SDURABS";"S";"0008";"*"
"SDURABS";"S";"0009";"* Créé par : Cellule Industrialisation"
"SDURABS";"S";"0010";"* Date     : 10/08/2018"
"SDURABS";"S";"0011";"* Version  : 1"
"SDURABS";"S";"0012";"*"
"SDURABS";"S";"0013";"*----------------------------------------------------------------------"
"SDURABS";"S";"0014";"*"
"SDURABS";"S";"0015";"*"
"SDURABS";"S";"0016";"* Rôle : Calcul de la durée des absences"
"SDURABS";"S";"0017";"*"
"SDURABS";"S";"0018";"*"
"SDURABS";"S";"0019";"***********************************************************************"
"SDURABS";"S";"0020";"*"
"SDURABS";"S";"0021";"* Implémentation des données industrielles"
"SDURABS";"S";"0022";"*"
"SDURABS";"S";"0023";"DEBDICO"
"SDURABS";"S";"0024";"   HJOU_IJRNBMOTIH;N;N3;I;;;    56789;;IJRNBMOTIH;V3;""Nombre de motifs hebdomadaire"";"
"SDURABS";"S";"0025";"   HJOU_IJRDURMOTH;N;T6,2;I;;;    56789;;IJRDURMOTH;V3;""Durée des motifs hebdomadaire"";"
"SDURABS";"S";"0026";"FINDICO"
"SDURABS";"S";"0027";"*"
"SDURABS";"S";"0028";"* Déclaration des donnees locales"
"SDURABS";"S";"0029";"*"
"SDURABS";"S";"0030";"DEF LOCA_CTRBASE T6.2"
"SDURABS";"S";"0031";"LOCA_CTRBASE = 0"
"SDURABS";"S";"0032";"* à activer si la donnée est créée"
"SDURABS";"S";"0033";"*LOCA_CTRBASE = HJOU_IJQCTRBASE"
"SDURABS";"S";"0034";"DEF LOCA_CAL N1"
"SDURABS";"S";"0035";"LOCA_CAL = 0"
"SDURABS";"S";"0036";"*"
"SDURABS";"S";"0037";"*"
"SDURABS";"S";"0038";"* RAZ au lundi ou début de contrat du nombre de motifs dans la semaine"
"SDURABS";"S";"0039";"SI HJOU_JOUR = ""1"""
"SDURABS";"S";"0040";"OU CTRA_DATDEB = HJOU_DATE"
"SDURABS";"S";"0041";"   HJOU_IJRNBMOTIH = 0"
"SDURABS";"S";"0042";"   HJOU_IJRDURMOTH = 0"
"SDURABS";"S";"0043";"FINSI"
"SDURABS";"S";"0044";"*"
"SDURABS";"S";"0045";"POUR ACTIVITES"
"SDURABS";"S";"0046";"*"
"SDURABS";"S";"0047";"* durée fixe"
"SDURABS";"S";"0048";"   SI MOTI_IMIGDURABS = ""FIX"""
"SDURABS";"S";"0049";"      SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0050";"      OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0051";"         HABS_MOTIDUR = MOTI_VALDFT / 2"
"SDURABS";"S";"0052";"      FINSI"
"SDURABS";"S";"0053";"      SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0054";"      OU HABS_VALORIS = ""N"""
"SDURABS";"S";"0055";"         HABS_MOTIDUR = MOTI_VALDFT"
"SDURABS";"S";"0056";"      FINSI"
"SDURABS";"S";"0057";"   FINSI"
"SDURABS";"S";"0058";"*"
"SDURABS";"S";"0059";"* gestion des absences/présences"
"SDURABS";"S";"0060";"   SI PROF_PRETHEO > 0.02"
"SDURABS";"S";"0061";"      SI HABS_MOTYPE <> ""C"""
"SDURABS";"S";"0062";"* nombre de motifs dans la semaine"
"SDURABS";"S";"0063";"         SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0064";"         OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0065";"            HJOU_IJRNBMOTIH = HJOU_IJRNBMOTIH + 0.5"
"SDURABS";"S";"0066";"         SINON"
"SDURABS";"S";"0067";"            SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0068";"               HJOU_IJRNBMOTIH = HJOU_IJRNBMOTIH + 1"
"SDURABS";"S";"0069";"            FINSI"
"SDURABS";"S";"0070";"         FINSI"
"SDURABS";"S";"0071";"*"
"SDURABS";"S";"0072";"* GCF - Valorisation de paie particulière pour les journalistes >>"
"SDURABS";"S";"0073";"*"
"SDURABS";"S";"0074";"         SI HJOU_SJQCATEGOR = ""J"""
"SDURABS";"S";"0075";"            SI HJOU_SJQFORFJR <> ""1"""
"SDURABS";"S";"0076";"               SI HORC_SHIHOREF > 0.00"
"SDURABS";"S";"0077";"* Profil de la rédaction"
"SDURABS";"S";"0078";"                  SI HJOU_PROFIL(1:3) = ""RED"""
"SDURABS";"S";"0079";"                     SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0080";"                     OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0081";"                        HABS_MOTIDUR = HORC_SHIHOREF / 2"
"SDURABS";"S";"0082";"                     FINSI"
"SDURABS";"S";"0083";"                     SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0084";"* Demi-jounrée ?"
"SDURABS";"S";"0085";"                        SI PROF_ABSENM = 0"
"SDURABS";"S";"0086";"                        OU PROF_ABSENS = 0"
"SDURABS";"S";"0087";"                           HABS_MOTIDUR = HORC_SHIHOREF / 2"
"SDURABS";"S";"0088";"                        SINON"
"SDURABS";"S";"0089";"                           HABS_MOTIDUR = HORC_SHIHOREF"
"SDURABS";"S";"0090";"                        FINSI"
"SDURABS";"S";"0091";"                     FINSI"
"SDURABS";"S";"0092";"                  FINSI"
"SDURABS";"S";"0093";"               FINSI"
"SDURABS";"S";"0094";"            FINSI"
"SDURABS";"S";"0095";"         FINSI"
"SDURABS";"S";"0096";"*"
"SDURABS";"S";"0097";"* GCF - <<"
"SDURABS";"S";"0098";"*"
"SDURABS";"S";"0099";"* 1/5ième du contrat"
"SDURABS";"S";"0100";"         SI MOTI_IMIGDURABS = ""C5"""
"SDURABS";"S";"0101";"            SI HJOU_IJRNBMOTIH < 5"
"SDURABS";"S";"0102";"               SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0103";"                  HABS_MOTIDUR = CTRA_BASECONT / 5"
"SDURABS";"S";"0104";"               FINSI"
"SDURABS";"S";"0105";"               SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0106";"               OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0107";"                  HABS_MOTIDUR = CTRA_BASECONT / 5"
"SDURABS";"S";"0108";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"SDURABS";"S";"0109";"               FINSI"
"SDURABS";"S";"0110";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"SDURABS";"S";"0111";"            SINON"
"SDURABS";"S";"0112";"* reliquat de la semaine"
"SDURABS";"S";"0113";"               SI HJOU_IJRNBMOTIH = 5"
"SDURABS";"S";"0114";"                  HABS_MOTIDUR = CTRA_BASECONT - HJOU_IJRDURMOTH"
"SDURABS";"S";"0115";"               SINON"
"SDURABS";"S";"0116";"* maximum 5 jours valorisés dans la semaine"
"SDURABS";"S";"0117";"                  HABS_MOTIDUR = 0"
"SDURABS";"S";"0118";"               FINSI"
"SDURABS";"S";"0119";"            FINSI"
"SDURABS";"S";"0120";"         FINSI"
"SDURABS";"S";"0121";"*"
"SDURABS";"S";"0122";"* 1/6ième du contrat"
"SDURABS";"S";"0123";"         SI MOTI_IMIGDURABS = ""C6"""
"SDURABS";"S";"0124";"            SI HJOU_IJRNBMOTIH < 6"
"SDURABS";"S";"0125";"               SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0126";"                  HABS_MOTIDUR = CTRA_BASECONT / 6"
"SDURABS";"S";"0127";"               FINSI"
"SDURABS";"S";"0128";"               SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0129";"               OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0130";"                  HABS_MOTIDUR = CTRA_BASECONT / 6"
"SDURABS";"S";"0131";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"SDURABS";"S";"0132";"               FINSI"
"SDURABS";"S";"0133";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"SDURABS";"S";"0134";"            SINON"
"SDURABS";"S";"0135";"* reliquat de la semaine"
"SDURABS";"S";"0136";"               SI HJOU_IJRNBMOTIH = 6"
"SDURABS";"S";"0137";"                  HABS_MOTIDUR = CTRA_BASECONT - HJOU_IJRDURMOTH"
"SDURABS";"S";"0138";"               SINON"
"SDURABS";"S";"0139";"* maximum 6 jours valorisés dans la semaine"
"SDURABS";"S";"0140";"                  HABS_MOTIDUR = 0"
"SDURABS";"S";"0141";"               FINSI"
"SDURABS";"S";"0142";"            FINSI"
"SDURABS";"S";"0143";"         FINSI"
"SDURABS";"S";"0144";"*"
"SDURABS";"S";"0145";"* 1/7ième du contrat"
"SDURABS";"S";"0146";"         SI MOTI_IMIGDURABS = ""C7"""
"SDURABS";"S";"0147";"            SI HJOU_IJRNBMOTIH < 7"
"SDURABS";"S";"0148";"               SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0149";"                  HABS_MOTIDUR = CTRA_BASECONT / 7"
"SDURABS";"S";"0150";"               FINSI"
"SDURABS";"S";"0151";"               SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0152";"               OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0153";"                  HABS_MOTIDUR = CTRA_BASECONT / 7"
"SDURABS";"S";"0154";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"SDURABS";"S";"0155";"               FINSI"
"SDURABS";"S";"0156";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"SDURABS";"S";"0157";"            SINON"
"SDURABS";"S";"0158";"* reliquat de la semaine"
"SDURABS";"S";"0159";"               HABS_MOTIDUR = CTRA_BASECONT - HJOU_IJRDURMOTH"
"SDURABS";"S";"0160";"            FINSI"
"SDURABS";"S";"0161";"         FINSI"
"SDURABS";"S";"0162";"*"
"SDURABS";"S";"0163";"* présence théorique"
"SDURABS";"S";"0164";"         SI MOTI_IMIGDURABS = ""PLG"""
"SDURABS";"S";"0165";"            SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0166";"               HABS_MOTIDUR = HJOU_IJQPRETHEJ"
"SDURABS";"S";"0167";"            FINSI"
"SDURABS";"S";"0168";"            SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0169";"               HABS_MOTIDUR = HJOU_IJQPLGMAT"
"SDURABS";"S";"0170";"            FINSI"
"SDURABS";"S";"0171";"            SI HABS_VALORIS = ""A"""
"SDURABS";"S";"0172";"               HABS_MOTIDUR = HJOU_IJQPLGAPM"
"SDURABS";"S";"0173";"            FINSI"
"SDURABS";"S";"0174";"         FINSI"
"SDURABS";"S";"0175";"*"
"SDURABS";"S";"0176";"* 1/5ième du contrat hebdo"
"SDURABS";"S";"0177";"         SI MOTI_IMIGDURABS = ""H5"""
"SDURABS";"S";"0178";"            SI HJOU_IJRNBMOTIH < 5"
"SDURABS";"S";"0179";"               SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0180";"                  HABS_MOTIDUR = LOCA_CTRBASE / 5"
"SDURABS";"S";"0181";"               FINSI"
"SDURABS";"S";"0182";"               SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0183";"               OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0184";"                  HABS_MOTIDUR = LOCA_CTRBASE / 5"
"SDURABS";"S";"0185";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"SDURABS";"S";"0186";"               FINSI"
"SDURABS";"S";"0187";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"SDURABS";"S";"0188";"            SINON"
"SDURABS";"S";"0189";"* reliquat de la semaine"
"SDURABS";"S";"0190";"               SI HJOU_IJRNBMOTIH = 5"
"SDURABS";"S";"0191";"                  HABS_MOTIDUR = LOCA_CTRBASE - HJOU_IJRDURMOTH"
"SDURABS";"S";"0192";"               SINON"
"SDURABS";"S";"0193";"* maximum 5 jours valorisés dans la semaine"
"SDURABS";"S";"0194";"                  HABS_MOTIDUR = 0"
"SDURABS";"S";"0195";"               FINSI"
"SDURABS";"S";"0196";"            FINSI"
"SDURABS";"S";"0197";"         FINSI"
"SDURABS";"S";"0198";"*"
"SDURABS";"S";"0199";"* 1/6ième du contrat hebdo"
"SDURABS";"S";"0200";"         SI MOTI_IMIGDURABS = ""H6"""
"SDURABS";"S";"0201";"            SI HJOU_IJRNBMOTIH < 6"
"SDURABS";"S";"0202";"               SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0203";"                  HABS_MOTIDUR = LOCA_CTRBASE / 6"
"SDURABS";"S";"0204";"               FINSI"
"SDURABS";"S";"0205";"               SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0206";"               OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0207";"                  HABS_MOTIDUR = LOCA_CTRBASE / 6"
"SDURABS";"S";"0208";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"SDURABS";"S";"0209";"               FINSI"
"SDURABS";"S";"0210";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"SDURABS";"S";"0211";"            SINON"
"SDURABS";"S";"0212";"* reliquat de la semaine"
"SDURABS";"S";"0213";"               SI HJOU_IJRNBMOTIH = 6"
"SDURABS";"S";"0214";"                  HABS_MOTIDUR = LOCA_CTRBASE - HJOU_IJRDURMOTH"
"SDURABS";"S";"0215";"               SINON"
"SDURABS";"S";"0216";"* maximum 6 jours valorisés dans la semaine"
"SDURABS";"S";"0217";"                  HABS_MOTIDUR = 0"
"SDURABS";"S";"0218";"               FINSI"
"SDURABS";"S";"0219";"            FINSI"
"SDURABS";"S";"0220";"         FINSI"
"SDURABS";"S";"0221";"*"
"SDURABS";"S";"0222";"* 1/7ième du contrat hebdo"
"SDURABS";"S";"0223";"         SI MOTI_IMIGDURABS = ""H7"""
"SDURABS";"S";"0224";"            SI HJOU_IJRNBMOTIH < 7"
"SDURABS";"S";"0225";"               SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0226";"                  HABS_MOTIDUR = LOCA_CTRBASE / 7"
"SDURABS";"S";"0227";"               FINSI"
"SDURABS";"S";"0228";"               SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0229";"               OU HABS_VALORIS = ""A"""
"SDURABS";"S";"0230";"                  HABS_MOTIDUR = LOCA_CTRBASE / 7"
"SDURABS";"S";"0231";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"SDURABS";"S";"0232";"               FINSI"
"SDURABS";"S";"0233";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"SDURABS";"S";"0234";"            SINON"
"SDURABS";"S";"0235";"* reliquat de la semaine"
"SDURABS";"S";"0236";"               HABS_MOTIDUR = LOCA_CTRBASE - HJOU_IJRDURMOTH"
"SDURABS";"S";"0237";"            FINSI"
"SDURABS";"S";"0238";"         FINSI"
"SDURABS";"S";"0239";"*"
"SDURABS";"S";"0240";"* planning optimum non validé (absences/présences non planifiables)"
"SDURABS";"S";"0241";"         LOCA_CAL = 0"
"SDURABS";"S";"0242";"         SI CTRA_TYPEPLAN = ""1"""
"SDURABS";"S";"0243";"         OU CTRA_TYPEPLAN = ""6"""
"SDURABS";"S";"0244";"            SI HJOU_HJVALPLN = 0"
"SDURABS";"S";"0245";"            OU HJOU_HJVALPLN = 2"
"SDURABS";"S";"0246";"               SI MOTI_PLANIF <> ""1"""
"SDURABS";"S";"0247";"                  LOCA_CAL = 1"
"SDURABS";"S";"0248";"               FINSI"
"SDURABS";"S";"0249";"            FINSI"
"SDURABS";"S";"0250";"         FINSI"
"SDURABS";"S";"0251";"*"
"SDURABS";"S";"0252";"* modification de la théorie journalière pour planning optimum non validé"
"SDURABS";"S";"0253";"         SI LOCA_CAL = 1"
"SDURABS";"S";"0254";"* motifs matin"
"SDURABS";"S";"0255";"            SI HABS_VALORIS = ""M"""
"SDURABS";"S";"0256";"               HJOU_IJQPLGMAT = HABS_MOTIDUR"
"SDURABS";"S";"0257";"            FINSI"
"SDURABS";"S";"0258";"* motifs après-midi"
"SDURABS";"S";"0259";"            SI HABS_VALORIS = ""A"""
"SDURABS";"S";"0260";"               HJOU_IJQPLGAPM = HABS_MOTIDUR"
"SDURABS";"S";"0261";"            FINSI"
"SDURABS";"S";"0262";"* total plages"
"SDURABS";"S";"0263";"            HJOU_IJQPLGTOTJ = HJOU_IJQPLGMAT + HJOU_IJQPLGAPM"
"SDURABS";"S";"0264";"* motifs jour"
"SDURABS";"S";"0265";"            SI HABS_VALORIS = ""J"""
"SDURABS";"S";"0266";"               HJOU_IJQPLGMAT = 0"
"SDURABS";"S";"0267";"               HJOU_IJQPLGAPM = 0"
"SDURABS";"S";"0268";"               HJOU_IJQPLGTOTJ = HABS_MOTIDUR"
"SDURABS";"S";"0269";"            FINSI"
"SDURABS";"S";"0270";"* motifs en heures"
"SDURABS";"S";"0271";"            SI HABS_VALORIS = ""H"""
"SDURABS";"S";"0272";"               HJOU_IJQPLGTOTJ = HJOU_IJQPLGTOTJ + HABS_MOTIDUR"
"SDURABS";"S";"0273";"            FINSI"
"SDURABS";"S";"0274";"         FINSI"
"SDURABS";"S";"0275";"      FINSI"
"SDURABS";"S";"0276";"   FINSI"
"SDURABS";"S";"0277";"FINPOUR"
"SDURABS";"S";"0278";"*"
"SDURABS";"S";"0279";"FIN"
