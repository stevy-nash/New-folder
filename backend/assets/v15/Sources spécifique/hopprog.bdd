"SGDH";"S";"0053";"* Déclaration des donnees locales"
"SGDH";"S";"0054";"*"
"SGDH";"S";"0055";"DEF LOCA_DROIT N2"
"SGDH";"S";"0056";"LOCA_DROIT = 0"
