"IFERIE";"S";"0014";"*"
"IFERIE";"S";"0015";"*"
"IFERIE";"S";"0016";"* Rôle : Calcul des heures travaillees feriees"
"IFERIE";"S";"0017";"*"
"IFERIE";"S";"0018";"*"
"IFERIE";"S";"0019";"*"
"IFERIE";"S";"0020";"*"
"IFERIE";"S";"0021";"*"
"IFERIE";"S";"0022";"*----------------------------------------------------------------------"
"IFERIE";"S";"0023";"*"
"IFERIE";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IFERIE";"S";"0025";"* Date         : JJ/MM/AAAA"
"IFERIE";"S";"0026";"* Objet        :"
"IFERIE";"S";"0027";"*"
"IFERIE";"S";"0028";"***********************************************************************"
"IFERIE";"S";"0029";"*"
"IFERIE";"S";"0030";"* Implémentation des données industrielles"
"IFERIE";"S";"0031";"*"
"IFERIE";"S";"0032";"DEBDICO"
"IFERIE";"S";"0033";"   HJOU_IJQHJFTRAV;N;T6,2;I;;;    56789;;;V3;""Heures fériées"";"
"IFERIE";"S";"0034";"FINDICO"
"IFERIE";"S";"0035";"*"
"IFERIE";"S";"0036";"* Déclaration des donnees locales"
"IFERIE";"S";"0037";"*"
"IFERIE";"S";"0038";"* Stockage des heures ferié totales pour contrôle par"
"IFERIE";"S";"0039";"* rapport à l'écrêtage de la présence"
"IFERIE";"S";"0040";"*"
"IFERIE";"S";"0041";"DEF LOCA_FERI T6.2"
"IFERIE";"S";"0042";"LOCA_FERI = 0"
"IFERIE";"S";"0043";"*"
"IFERIE";"S";"0044";"SI HJOU_DATE <= TEMP_DATJOU"
"IFERIE";"S";"0045";"   POUR ACTIVITES"
"IFERIE";"S";"0046";"      SI HABS_MOTIF = ""JF"""
"IFERIE";"S";"0047";"         LOCA_FERI = HJOU_IJRPREVEIL"
"IFERIE";"S";"0048";"         LOCA_FERI = LOCA_FERI + HJOU_IJQPREJENC"
"IFERIE";"S";"0049";"         LOCA_FERI = LOCA_FERI - HJOU_IJQECPAUMI"
"IFERIE";"S";"0050";"* le 23/03"
"IFERIE";"S";"0051";"* pas de gestion du temps de pause"
"IFERIE";"S";"0052";"* LOCA_FERI = LOCA_FERI + HJOU_IJQPAUPPLA"
"IFERIE";"S";"0053";"* LOCA_FERI = LOCA_FERI + HJOU_IJQPAUSPLA"
"IFERIE";"S";"0054";"* Contrôle de l'écrêtage du profil horaire"
"IFERIE";"S";"0055";"         SI LOCA_FERI > PROF_ECRJOU"
"IFERIE";"S";"0056";"            LOCA_FERI = PROF_ECRJOU"
"IFERIE";"S";"0057";"         FINSI"
"IFERIE";"S";"0058";"      FINSI"
"IFERIE";"S";"0059";"      HJOU_IJQHJFTRAV = LOCA_FERI"
"IFERIE";"S";"0060";"   FINPOUR"
"IFERIE";"S";"0061";"*  analyse des consignes"
"IFERIE";"S";"0062";"   POUR ACTIVITES"
"IFERIE";"S";"0063";"      SI HABS_MOTIF = ""XFER"""
"IFERIE";"S";"0064";"         HJOU_IJQHJFTRAV = HJOU_IJQHJFTRAV + HABS_MOTIDUR"
"IFERIE";"S";"0065";"      FINSI"
"IFERIE";"S";"0066";"      SI HABS_MOTIF = ""ZFER"""
"IFERIE";"S";"0067";"         HJOU_IJQHJFTRAV = HABS_MOTIDUR"
"IFERIE";"S";"0068";"      FINSI"
"IFERIE";"S";"0069";"   FINPOUR"
"IFERIE";"S";"0070";"FINSI"
"IFERIE";"S";"0071";"FIN"
