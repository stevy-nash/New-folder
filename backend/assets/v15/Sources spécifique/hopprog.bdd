"IDISPJE";"S";"0049";"   HJOU_IJRDJDISP5;N;N6,2;L;;;    56789;;IJRDJDISP5;V3;""Droit en jour disponible 5"";"
"IDISPJE";"S";"0050";"   HJOU_IJRCJDISP5;N;N6,2;L;;;    56789;;IJRCJDISP5;V3;""Pris en jour disponible 5"";"
"IDISPJE";"S";"0051";"   HJOU_IJRSJDISP5;N;N6,2;L;;;    56789;;IJRSJDISP5;V3;""Solde en jour disponible 5"";"
"IDISPJE";"S";"0052";"   EMPL_IEQSPDISP5;N;N6,2;L;;;     6789;;;V3;""Solde prévisionnel en jour disponible 5"";"
"IDISPJE";"S";"0053";"PARD_IDIDRDISP5;O;D10;X;;;123456789;;;C3;""Date RAZ compteur jour disponible 5"";"
"IDISPJE";"S";"0054";"PARD_IDIVDDISP5;O;N6,2;I;;;123456789;;;C3;""Valeur droit jour compteur disponible  5"";"
