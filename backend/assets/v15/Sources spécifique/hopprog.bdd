"IACQCPAN2M";"S";"0081";"* Variables utilisées pour le calcul de l'ancienneté"
"IACQCPAN2M";"S";"0082";"DEF LOCA_ANCIEN N6.1"
"IACQCPAN2M";"S";"0083";"LOCA_ANCIEN = 0"
"IACQCPAN2M";"S";"0084";"DEF LOCA_TRANS N6.1"
"IACQCPAN2M";"S";"0085";"LOCA_TRANS = 0"
"IACQCPAN2M";"S";"0086";"DEF LOCA_DROIT N6.1"
"IACQCPAN2M";"S";"0087";"LOCA_DROIT = 0"
"IACQCPAN2M";"S";"0088";"DEF LOCA_CA N1"
"IACQCPAN2M";"S";"0089";"LOCA_CA = 0"
"IACQCPAN2M";"S";"0090";"*"
"IACQCPAN2M";"S";"0091";"* Récupération de la date d'anniversaire de l'ancienneté"
"IACQCPAN2M";"S";"0092";"SI EMPS_E2DATEANC <> "" """
"IACQCPAN2M";"S";"0093";"* Récupération de l'année du jour dans JOU"
"IACQCPAN2M";"S";"0094";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"IACQCPAN2M";"S";"0095";"* Récupération du mois de la date d'ancienneté"
