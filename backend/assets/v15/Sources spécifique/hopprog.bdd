"SHSUPPDIM";"S";"0274";"*"
"SHSUPPDIM";"S";"0275";"* LOCA_GESTHS = 1 Pas de calcul HS"
"SHSUPPDIM";"S";"0276";"* LOCA_GESTHS = 2 Calcul des HS chaque dimanche"
"SHSUPPDIM";"S";"0277";"* LOCA_GESTHS = 3 Calcul des HS le dernier dimanche du cycle"
"SHSUPPDIM";"S";"0278";"* LOCA_GESTHS = 4 Calcul des HS jour par jour pour industrie"
"SHSUPPDIM";"S";"0279";"*"
"SHSUPPDIM";"S";"0280";"* Déduction du mode de gestion des HS ?"
"SHSUPPDIM";"S";"0281";"SI HJOU_IJIGHSUPPM = ""0"""
"SHSUPPDIM";"S";"0282";"   LOCA_GESTHS = HORC_SHIGHSUPPM"
"SHSUPPDIM";"S";"0283";"* FFT025003825 >>"
"SHSUPPDIM";"S";"0284";"   SI HJOU_SJITYPSERV = ""PFI"""
"SHSUPPDIM";"S";"0285";"      LOCA_GESTHS = ""4"""
"SHSUPPDIM";"S";"0286";"   FINSI"
"SHSUPPDIM";"S";"0287";"SINON"
"SHSUPPDIM";"S";"0288";"   LOCA_GESTHS = HJOU_IJIGHSUPPM"
"SHSUPPDIM";"S";"0289";"FINSI"
"SHSUPPDIM";"S";"0290";"*"
"SHSUPPDIM";"S";"0291";"SI LOCA_GESTHS = ""0"""
"SHSUPPDIM";"S";"0292";"OU LOCA_GESTHS = ""1"""
"SHSUPPDIM";"S";"0293";"OU LOCA_GESTHS = ""4"""
"SHSUPPDIM";"S";"0294";"   HJOU_SJRHSPRC = "" """
"SHSUPPDIM";"S";"0295";"   HJOU_IJRBHSMPAH = 0"
