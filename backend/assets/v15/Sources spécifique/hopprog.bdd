"SCPTBASE";"S";"0145";"                           SI HJOU_SJQHTENT3 < LOCA_HRMIDI"
"SCPTBASE";"S";"0146";"                              HJOU_SJQHTENT3 = 0"
"SCPTBASE";"S";"0147";"                              HJOU_SJQHTSOR3 = 0"
"SCPTBASE";"S";"0148";"                           FINSI"
"SCPTBASE";"S";"0149";"                           SI HJOU_SJQHTENT4 < LOCA_HRMIDI"
"SCPTBASE";"S";"0150";"                              HJOU_SJQHTENT4 = 0"
"SCPTBASE";"S";"0151";"                              HJOU_SJQHTSOR4 = 0"
"SCPTBASE";"S";"0152";"                           FINSI"
"SCPTBASE";"S";"0153";"                           SI HJOU_SJQHTENT5 < LOCA_HRMIDI"
"SCPTBASE";"S";"0154";"                              HJOU_SJQHTENT5 = 0"
"SCPTBASE";"S";"0155";"                              HJOU_SJQHTSOR5 = 0"
"SCPTBASE";"S";"0156";"                           FINSI"
"SCPTBASE";"S";"0157";"                        SINON"
"SCPTBASE";"S";"0158";"                           HJOU_SJQHTENT1 = 0"
"SCPTBASE";"S";"0159";"                           HJOU_SJQHTSOR1 = 0"
"SCPTBASE";"S";"0160";"                        FINSI"
"SCPTBASE";"S";"0161";"                     SINON"
"SCPTBASE";"S";"0162";"                        SI HJOU_SJQHTSOR3 <> 0"
"SCPTBASE";"S";"0163";"                           SI HJOU_SJQHTSOR1 > LOCA_HRMIDI"
"SCPTBASE";"S";"0164";"                              HJOU_SJQHTENT1 = 0"
"SCPTBASE";"S";"0165";"                              HJOU_SJQHTSOR1 = 0"
"SCPTBASE";"S";"0166";"                           FINSI"
