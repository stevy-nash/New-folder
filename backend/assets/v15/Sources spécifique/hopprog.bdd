"IGRTTJ";"S";"0240";"* alimentation du compteur de droit"
"IGRTTJ";"S";"0241";"            HJOU_IJRARTTJOU = LOCA_ENTIER"
"IGRTTJ";"S";"0242";"*"
"IGRTTJ";"S";"0243";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
"IGRTTJ";"S";"0244";"         FINSI"
"IGRTTJ";"S";"0245";"      FINSI"
"IGRTTJ";"S";"0246";"**"
