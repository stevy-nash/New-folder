"SDONABS";"S";"0012";"*"
"SDONABS";"S";"0013";"*---------------------------------------------------------------------"
"SDONABS";"S";"0014";"*"
"SDONABS";"S";"0015";"*"
"SDONABS";"S";"0016";"* Rôle :"
"SDONABS";"S";"0017";"* - alimentation d'un compteur de don CP et contrôle d'une valeur maxib de 5"
"SDONABS";"S";"0018";"* - alimentation d'un compteur de don divers (RTT, REC)"
"SDONABS";"S";"0019";"* - alimentation du don de CP, RTT et REC"
"SDONABS";"S";"0020";"* - alimentation et gestion de de la prise d'un compteur Don jours d""absences"
"SDONABS";"S";"0021";"*"
"SDONABS";"S";"0022";"*----------------------------------------------------------------------"
"SDONABS";"S";"0023";"*"
"SDONABS";"S";"0024";"* Implémentation des données industrielles"
"SDONABS";"S";"0025";"*"
"SDONABS";"S";"0026";"*"
"SDONABS";"S";"0027";"DEBDICO"
"SDONABS";"S";"0028";"   PARD_IDIVMDONCP;O;A10;X;;;123456789;II;;C2;""Motif absence sur don"";"
"SDONABS";"S";"0029";"   HJOU_IJRSDONCP;N;N6,1;I;;;    56789;;IJRSDONCP;V3;""Don jours de CP versé annuel"";"
"SDONABS";"S";"0030";"   HJOU_IJRSDONDIV;N;N6,1;I;;;    56789;;IJRSDONDIV;V3;""Don jour versé global annuel;"
"SDONABS";"S";"0031";"   *"
"SDONABS";"S";"0032";"   HJOU_SJRDDONABS;N;N6,1;I;;;    56789;;SJRDDONABS;V3;""Droit jours d'absences sur don"";"
"SDONABS";"S";"0033";"   HJOU_SJRCDONABS;N;N6,1;I;;;    56789;;SJRCDONABS;V3;""Pris jours d'absences sur don"";"
"SDONABS";"S";"0034";"   HJOU_IJRSDONABS;N;N6,1;I;;;    56789;;IJRSDONABS;V3;""Solde jours d'absences sur don"";"
"SDONABS";"S";"0035";"FINDICO"
"SDONABS";"S";"0036";"*"
"SDONABS";"S";"0037";"DEBANO"
"SDONABS";"S";"0038";"   187;9;""Dons congés supérieur au maximum"";"
"SDONABS";"S";"0039";"   188;9;""Solde don jours d'absences insuffisant"";"
"SDONABS";"S";"0040";"FINANO"
"SDONABS";"S";"0041";"*"
"SDONABS";"S";"0042";"* Définition des variables locales"
"SDONABS";"S";"0043";"*"
"SDONABS";"S";"0044";"*"
"SDONABS";"S";"0045";"DEF LOCA_VAL N2.1"
"SDONABS";"S";"0046";"LOCA_VAL = 0"
"SDONABS";"S";"0047";"DEF LOCA_ABSDON N2"
"SDONABS";"S";"0048";"LOCA_ABSDON = 0"
"SDONABS";"S";"0049";"DEF LOCA_YDONCP N2"
"SDONABS";"S";"0050";"LOCA_YDONCP = 0"
"SDONABS";"S";"0051";"DEF LOCA_YDONCSUP N2"
"SDONABS";"S";"0052";"LOCA_YDONCSUP = 0"
"SDONABS";"S";"0053";"DEF LOCA_YDONRTT N2"
"SDONABS";"S";"0054";"LOCA_YDONRTT = 0"
"SDONABS";"S";"0055";"DEF LOCA_YDONREC N2"
"SDONABS";"S";"0056";"LOCA_YDONREC = 0"
"SDONABS";"S";"0057";"DEF LOCA_SEUILCP N4"
"SDONABS";"S";"0058";"LOCA_SEUILCP = 5"
"SDONABS";"S";"0059";"SI HJOU_SJQOUVRABL = ""O"""
"SDONABS";"S";"0060";"   LOCA_SEUILCP = 6"
"SDONABS";"S";"0061";"FINSI"
"SDONABS";"S";"0062";"*"
"SDONABS";"S";"0063";"DEF LOCA_REFCP N4"
"SDONABS";"S";"0064";"LOCA_REFCP = 0"
"SDONABS";"S";"0065";"DEF LOCA_DATREFDON D"
"SDONABS";"S";"0066";"LOCA_DATREFDON = "" """
"SDONABS";"S";"0067";"*"
"SDONABS";"S";"0068";"* RAZ du compteur Don cp en date de référence CP"
"SDONABS";"S";"0069";"*"
"SDONABS";"S";"0070";"LOCA_REFCP << CONF_ITIVMREFCP(3:2)"
"SDONABS";"S";"0071";"LOCA_DATREFDON(5:2) << LOCA_REFCP"
"SDONABS";"S";"0072";"*"
"SDONABS";"S";"0073";"LOCA_REFCP << CONF_ITIVMREFCP(1:2)"
"SDONABS";"S";"0074";"LOCA_DATREFDON(7:2) << LOCA_REFCP"
"SDONABS";"S";"0075";"*"
"SDONABS";"S";"0076";"SI HJOU_DATE(5:4) = ""0101"""
"SDONABS";"S";"0077";"   HJOU_IJRSDONDIV = 0"
"SDONABS";"S";"0078";"FINSI"
"SDONABS";"S";"0079";"*"
"SDONABS";"S";"0080";"SI HJOU_DATE(5:4) = LOCA_DATREFDON(5:4)"
"SDONABS";"S";"0081";"*   HJOU_IJRSDONDIV = HJOU_IJRSDONDIV - HJOU_IJRSDONCP"
"SDONABS";"S";"0082";"   HJOU_IJRSDONCP = 0"
"SDONABS";"S";"0083";"*"
"SDONABS";"S";"0084";"* Si solde = 0 on remet à zéro le droit et le pris"
"SDONABS";"S";"0085";"* Solde"
"SDONABS";"S";"0086";"   SI HJOU_IJRSDONABS = 0"
"SDONABS";"S";"0087";"      HJOU_SJRDDONABS = 0"
"SDONABS";"S";"0088";"      HJOU_SJRCDONABS = 0"
"SDONABS";"S";"0089";"      HJOU_IJRSDONABS = HJOU_SJRDDONABS - HJOU_SJRCDONABS"
"SDONABS";"S";"0090";"   FINSI"
"SDONABS";"S";"0091";"*"
"SDONABS";"S";"0092";"FINSI"
"SDONABS";"S";"0093";"*"
"SDONABS";"S";"0094";"* Alimentation du compteur du nbr de CP donnés"
"SDONABS";"S";"0095";"*"
"SDONABS";"S";"0096";"POUR ACTIVITES"
"SDONABS";"S";"0097";"* Don de CP"
"SDONABS";"S";"0098";"   SI HABS_MOTIF = ""YDONCP"""
"SDONABS";"S";"0099";"      LOCA_YDONCP = 1"
"SDONABS";"S";"0100";"      HJOU_IJRSDONCP = HJOU_IJRSDONCP + HABS_MOTINBR"
"SDONABS";"S";"0101";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HABS_MOTINBR"
"SDONABS";"S";"0102";"   FINSI"
"SDONABS";"S";"0103";"* Don de CSUP"
"SDONABS";"S";"0104";"   SI HABS_MOTIF = ""YDONCSUP"""
"SDONABS";"S";"0105";"      LOCA_YDONCSUP = 1"
"SDONABS";"S";"0106";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HABS_MOTINBR"
"SDONABS";"S";"0107";"   FINSI"
"SDONABS";"S";"0108";"* Don de RTT"
"SDONABS";"S";"0109";"   SI HABS_MOTIF = ""YDONRTT"""
"SDONABS";"S";"0110";"      LOCA_YDONRTT = 1"
"SDONABS";"S";"0111";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HABS_MOTINBR"
"SDONABS";"S";"0112";"   FINSI"
"SDONABS";"S";"0113";"* Don de REC"
"SDONABS";"S";"0114";"   SI HABS_MOTIF = ""YDONREC"""
"SDONABS";"S";"0115";"      LOCA_YDONREC = 1"
"SDONABS";"S";"0116";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HABS_MOTINBR"
"SDONABS";"S";"0117";"   FINSI"
"SDONABS";"S";"0118";"*"
"SDONABS";"S";"0119";"* Initialisation après consigne"
"SDONABS";"S";"0120";"   SI HABS_MOTIF = ""ZCPDON"""
"SDONABS";"S";"0121";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV - HJOU_IJRSDONCP"
"SDONABS";"S";"0122";"      HJOU_IJRSDONCP = HABS_MOTINBR"
"SDONABS";"S";"0123";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HJOU_IJRSDONCP"
"SDONABS";"S";"0124";"   FINSI"
"SDONABS";"S";"0125";"   SI HABS_MOTIF = ""ZDIVDON"""
"SDONABS";"S";"0126";"      HJOU_IJRSDONDIV = HABS_MOTINBR"
"SDONABS";"S";"0127";"   FINSI"
"SDONABS";"S";"0128";"*"
"SDONABS";"S";"0129";"FINPOUR"
"SDONABS";"S";"0130";"*"
"SDONABS";"S";"0131";"* Alimentation du droit par consignes"
"SDONABS";"S";"0132";"POUR ACTIVITES"
"SDONABS";"S";"0133";"*"
"SDONABS";"S";"0134";"   SI HABS_MOTIF = ""ZDONABS"""
"SDONABS";"S";"0135";"      HJOU_SJRDDONABS = HABS_MOTINBR"
"SDONABS";"S";"0136";"   FINSI"
"SDONABS";"S";"0137";"*"
"SDONABS";"S";"0138";"   SI HABS_MOTIF = ""XDONABS"""
"SDONABS";"S";"0139";"      HJOU_SJRDDONABS = HJOU_SJRDDONABS + HABS_MOTINBR"
"SDONABS";"S";"0140";"   FINSI"
"SDONABS";"S";"0141";"FINPOUR"
"SDONABS";"S";"0142";"*"
"SDONABS";"S";"0143";"* Solde"
"SDONABS";"S";"0144";"HJOU_IJRSDONABS = HJOU_SJRDDONABS - HJOU_SJRCDONABS"
"SDONABS";"S";"0145";"*"
"SDONABS";"S";"0146";"* calcul du pris"
"SDONABS";"S";"0147";"POUR ACTIVITES"
"SDONABS";"S";"0148";"   SI HABS_MOTIF = PARD_IDIVMDONCP"
"SDONABS";"S";"0149";"      LOCA_ABSDON = 1"
"SDONABS";"S";"0150";"      SI HJOU_IJQPRETHEJ > 0"
"SDONABS";"S";"0151";"         SI HABS_VALORIS = ""J"""
"SDONABS";"S";"0152";"            SI PROF_ABSENM = 0"
"SDONABS";"S";"0153";"            OU PROF_ABSENS = 0"
"SDONABS";"S";"0154";"               LOCA_VAL = LOCA_VAL + 0.5"
"SDONABS";"S";"0155";"            SINON"
"SDONABS";"S";"0156";"               LOCA_VAL = 1"
"SDONABS";"S";"0157";"            FINSI"
"SDONABS";"S";"0158";"         SINON"
"SDONABS";"S";"0159";"            LOCA_VAL = 0.5"
"SDONABS";"S";"0160";"         FINSI"
"SDONABS";"S";"0161";"      FINSI"
"SDONABS";"S";"0162";"   FINSI"
"SDONABS";"S";"0163";"FINPOUR"
"SDONABS";"S";"0164";"*"
"SDONABS";"S";"0165";"SI LOCA_VAL > 1"
"SDONABS";"S";"0166";"   LOCA_VAL = 1"
"SDONABS";"S";"0167";"FINSI"
"SDONABS";"S";"0168";"*"
"SDONABS";"S";"0169";"HJOU_SJRCDONABS = HJOU_SJRCDONABS + LOCA_VAL"
"SDONABS";"S";"0170";"*"
"SDONABS";"S";"0171";"* Solde"
"SDONABS";"S";"0172";"HJOU_IJRSDONABS = HJOU_SJRDDONABS - HJOU_SJRCDONABS"
"SDONABS";"S";"0173";"*"
"SDONABS";"S";"0174";"* Simulation des dons CP"
"SDONABS";"S";"0175";"*"
"SDONABS";"S";"0176";"* Solde insuffisant"
"SDONABS";"S";"0177";"SI LOCA_ABSDON = 1"
"SDONABS";"S";"0178";"   SI HJOU_IJRSDONABS < 0"
"SDONABS";"S";"0179";"      ANOMALIE 188"
"SDONABS";"S";"0180";"      SI TEMP_CNMOTIF = PARD_IDIVMDONCP"
"SDONABS";"S";"0181";"         TEMP_CNRETOUR = 2"
"SDONABS";"S";"0182";"         TEMP_CNMESS = 188"
"SDONABS";"S";"0183";"      FINSI"
"SDONABS";"S";"0184";"   FINSI"
"SDONABS";"S";"0185";"FINSI"
"SDONABS";"S";"0186";"*"
"SDONABS";"S";"0187";"* Blocage de la demande si le compteur don CP > 15"
"SDONABS";"S";"0188";"SI LOCA_YDONCP = 1"
"SDONABS";"S";"0189";"   SI HJOU_IJRSDONCP > LOCA_SEUILCP"
"SDONABS";"S";"0190";"      ANOMALIE 187"
"SDONABS";"S";"0191";"      SI TEMP_CNMOTIF = ""YDONCP"""
"SDONABS";"S";"0192";"         TEMP_CNRETOUR = 2"
"SDONABS";"S";"0193";"         TEMP_CNMESS = 187"
"SDONABS";"S";"0194";"      FINSI"
"SDONABS";"S";"0195";"   FINSI"
"SDONABS";"S";"0196";"FINSI"
"SDONABS";"S";"0197";"*"
"SDONABS";"S";"0198";"FIN"
"SDONREC";"S";"0001";"***********************************************************************"
"SDONREC";"S";"0002";"*"
"SDONREC";"S";"0003";"* Règle : SDONREC"
"SDONREC";"S";"0004";"* Ordre : 5500"
"SDONREC";"S";"0005";"* Titre : GCF : Chainage des dons de récup"
"SDONREC";"S";"0006";"*"
"SDONREC";"S";"0007";"*----------------------------------------------------------------------"
"SDONREC";"S";"0008";"*"
"SDONREC";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SDONREC";"S";"0010";"* Date     : 11/03/2025"
"SDONREC";"S";"0011";"* Version  : 1"
"SDONREC";"S";"0012";"*"
"SDONREC";"S";"0013";"*----------------------------------------------------------------------"
"SDONREC";"S";"0014";"*"
"SDONREC";"S";"0015";"*"
"SDONREC";"S";"0016";"* Rôle : Gestion du chainage de don sur réucpérations"
"SDONREC";"S";"0017";"*"
"SDONREC";"S";"0018";"*"
"SDONREC";"S";"0019";"*----------------------------------------------------------------------"
"SDONREC";"S";"0020";"*"
"SDONREC";"S";"0021";"* Modifiée par :"
"SDONREC";"S";"0022";"* Date         :"
"SDONREC";"S";"0023";"* Objet        :"
"SDONREC";"S";"0024";"*"
"SDONREC";"S";"0025";"***********************************************************************"
"SDONREC";"S";"0026";"*"
"SDONREC";"S";"0027";"* Implémentation des données industrielles"
"SDONREC";"S";"0028";"*"
"SDONREC";"S";"0029";"DEBDICO"
"SDONREC";"S";"0030";"FINDICO"
"SDONREC";"S";"0031";"*"
"SDONREC";"S";"0032";"*"
"SDONREC";"S";"0033";"DEF LOCA_DONREC N6.2"
"SDONREC";"S";"0034";"LOCA_DONREC = 0"
"SDONREC";"S";"0035";"*"
"SDONREC";"S";"0036";"DEF LOCA_DONREHS N6.2"
"SDONREC";"S";"0037";"LOCA_DONREHS = 0"
"SDONREC";"S";"0038";"DEF LOCA_DONRD N6.2"
"SDONREC";"S";"0039";"LOCA_DONRD = 0"
"SDONREC";"S";"0040";"DEF LOCA_DONRCI N6.2"
"SDONREC";"S";"0041";"LOCA_DONRCI = 0"
"SDONREC";"S";"0042";"DEF LOCA_DONPFI N6.2"
"SDONREC";"S";"0043";"LOCA_DONPFI = 0"
"SDONREC";"S";"0044";"DEF LOCA_DONRJF N6.2"
"SDONREC";"S";"0045";"LOCA_DONRJF = 0"
"SDONREC";"S";"0046";"*"
"SDONREC";"S";"0047";"DEF LOCA_7H T6.2"
"SDONREC";"S";"0048";"LOCA_7H = 7.00"
"SDONREC";"S";"0049";"DEF LOCA_RECUPJ N4"
"SDONREC";"S";"0050";"LOCA_RECUPJ = 0"
"SDONREC";"S";"0051";"*"
"SDONREC";"S";"0052";"ENLEVER ""YDONRHS"""
"SDONREC";"S";"0053";"ENLEVER ""YDONRHS"""
"SDONREC";"S";"0054";"ENLEVER ""YDONRD"""
"SDONREC";"S";"0055";"ENLEVER ""YDONRD"""
"SDONREC";"S";"0056";"ENLEVER ""YDONRCI"""
"SDONREC";"S";"0057";"ENLEVER ""YDONRCI"""
"SDONREC";"S";"0058";"ENLEVER ""YDONPFI"""
"SDONREC";"S";"0059";"ENLEVER ""YDONPFI"""
"SDONREC";"S";"0060";"ENLEVER ""YDONRJF"""
"SDONREC";"S";"0061";"ENLEVER ""YDONRJF"""
"SDONREC";"S";"0062";"*"
"SDONREC";"S";"0063";"POUR ACTIVITES"
"SDONREC";"S";"0064";"   SI HABS_MOTIF = ""YDONREC"""
"SDONREC";"S";"0065";"*"
"SDONREC";"S";"0066";"      LOCA_DONREC = HABS_MOTINBR"
"SDONREC";"S";"0067";"*"
"SDONREC";"S";"0068";"* Pr1 : Récup sur HS"
"SDONREC";"S";"0069";"      SI LOCA_DONREC > 0"
"SDONREC";"S";"0070";"* Solde en jour >>"
"SDONREC";"S";"0071";"         LOCA_RECUPJ = HJOU_IJRSHSMREH / LOCA_7H"
"SDONREC";"S";"0072";"         SI LOCA_RECUPJ >= LOCA_DONREC"
"SDONREC";"S";"0073";"            LOCA_DONREHS = LOCA_DONREC"
"SDONREC";"S";"0074";"            LOCA_DONREC = 0"
"SDONREC";"S";"0075";"         SINON"
"SDONREC";"S";"0076";"            SI LOCA_RECUPJ > 0"
"SDONREC";"S";"0077";"               LOCA_DONREHS = LOCA_RECUPJ"
"SDONREC";"S";"0078";"               LOCA_DONREC = LOCA_DONREC - LOCA_RECUPJ"
"SDONREC";"S";"0079";"            FINSI"
"SDONREC";"S";"0080";"         FINSI"
"SDONREC";"S";"0081";"      FINSI"
"SDONREC";"S";"0082";"*"
"SDONREC";"S";"0083";"* Pr2 : Récup RD"
"SDONREC";"S";"0084";"      SI LOCA_DONREC > 0"
"SDONREC";"S";"0085";"         SI HJOU_SJRSRD >= LOCA_DONREC"
"SDONREC";"S";"0086";"            LOCA_DONRD = LOCA_DONREC"
"SDONREC";"S";"0087";"            LOCA_DONREC = 0"
"SDONREC";"S";"0088";"         SINON"
"SDONREC";"S";"0089";"            SI HJOU_SJRSRD > 0"
"SDONREC";"S";"0090";"               LOCA_DONRD = HJOU_SJRSRD"
"SDONREC";"S";"0091";"               LOCA_DONREC = LOCA_DONREC - HJOU_SJRSRD"
"SDONREC";"S";"0092";"            FINSI"
"SDONREC";"S";"0093";"         FINSI"
"SDONREC";"S";"0094";"      FINSI"
"SDONREC";"S";"0095";"*"
"SDONREC";"S";"0096";"* Pr3 : Récup RCI"
"SDONREC";"S";"0097";"      SI LOCA_DONREC > 0"
"SDONREC";"S";"0098";"         SI HJOU_SJRSRCI >= LOCA_DONREC"
"SDONREC";"S";"0099";"            LOCA_DONRCI = LOCA_DONREC"
"SDONREC";"S";"0100";"            LOCA_DONREC = 0"
"SDONREC";"S";"0101";"         SINON"
"SDONREC";"S";"0102";"            SI HJOU_SJRSRCI > 0"
"SDONREC";"S";"0103";"               LOCA_DONRCI = HJOU_SJRSRCI"
"SDONREC";"S";"0104";"               LOCA_DONREC = LOCA_DONREC - HJOU_SJRSRCI"
"SDONREC";"S";"0105";"            FINSI"
"SDONREC";"S";"0106";"         FINSI"
"SDONREC";"S";"0107";"      FINSI"
"SDONREC";"S";"0108";"*"
"SDONREC";"S";"0109";"* Pr4 : Récup PFI"
"SDONREC";"S";"0110";"      SI LOCA_DONREC > 0"
"SDONREC";"S";"0111";"         SI HJOU_SJRSPFI >= LOCA_DONREC"
"SDONREC";"S";"0112";"            LOCA_DONPFI = LOCA_DONREC"
"SDONREC";"S";"0113";"            LOCA_DONREC = 0"
"SDONREC";"S";"0114";"         SINON"
"SDONREC";"S";"0115";"            SI HJOU_SJRSPFI > 0"
"SDONREC";"S";"0116";"               LOCA_DONPFI = HJOU_SJRSPFI"
"SDONREC";"S";"0117";"               LOCA_DONREC = LOCA_DONREC - HJOU_SJRSPFI"
"SDONREC";"S";"0118";"            FINSI"
"SDONREC";"S";"0119";"         FINSI"
"SDONREC";"S";"0120";"      FINSI"
"SDONREC";"S";"0121";"*"
"SDONREC";"S";"0122";"* Pr5 : Récup RJF"
"SDONREC";"S";"0123";"      SI LOCA_DONREC > 0"
"SDONREC";"S";"0124";"         SI HJOU_SJRSRJF >= LOCA_DONREC"
"SDONREC";"S";"0125";"            LOCA_DONRJF = LOCA_DONREC"
"SDONREC";"S";"0126";"            LOCA_DONREC = 0"
"SDONREC";"S";"0127";"         SINON"
"SDONREC";"S";"0128";"            SI HJOU_SJRSRJF > 0"
"SDONREC";"S";"0129";"               LOCA_DONRJF = HJOU_SJRSRJF"
"SDONREC";"S";"0130";"               LOCA_DONREC = LOCA_DONREC - HJOU_SJRSRJF"
"SDONREC";"S";"0131";"            FINSI"
"SDONREC";"S";"0132";"         FINSI"
"SDONREC";"S";"0133";"      FINSI"
"SDONREC";"S";"0134";"*"
"SDONREC";"S";"0135";"      SI LOCA_DONREC > 0"
"SDONREC";"S";"0136";"         ANOMALIE 293"
"SDONREC";"S";"0137";"         SI TEMP_CNMOTIF = ""YDONREC"""
"SDONREC";"S";"0138";"            TEMP_CNRETOUR = 2"
"SDONREC";"S";"0139";"            TEMP_CNMESS = 293"
"SDONREC";"S";"0140";"         FINSI"
"SDONREC";"S";"0141";"      FINSI"
"SDONREC";"S";"0142";"*"
"SDONREC";"S";"0143";"   FINSI"
"SDONREC";"S";"0144";"FINPOUR"
"SDONREC";"S";"0145";"*"
"SDONREC";"S";"0146";"* Ajout des consignes auto. >>"
"SDONREC";"S";"0147";"*"
"SDONREC";"S";"0148";"* Recup. HS"
"SDONREC";"S";"0149";"SI LOCA_DONREHS > 0"
"SDONREC";"S";"0150";"   ENLEVER ""YDONRHS"""
"SDONREC";"S";"0151";"   AJOUTER ""YDONRHS"" ""N"" LOCA_DONREHS"
"SDONREC";"S";"0152";"FINSI"
"SDONREC";"S";"0153";"* Récup RD"
"SDONREC";"S";"0154";"SI LOCA_DONRD > 0"
"SDONREC";"S";"0155";"   ENLEVER ""YDONRD"""
"SDONREC";"S";"0156";"   AJOUTER ""YDONRD"" ""N"" LOCA_DONRD"
"SDONREC";"S";"0157";"FINSI"
"SDONREC";"S";"0158";"* Récup RCI"
"SDONREC";"S";"0159";"SI LOCA_DONRCI > 0"
"SDONREC";"S";"0160";"   ENLEVER ""YDONRCI"""
"SDONREC";"S";"0161";"   AJOUTER ""YDONRCI"" ""N"" LOCA_DONRCI"
"SDONREC";"S";"0162";"FINSI"
"SDONREC";"S";"0163";"* Récup PFI"
"SDONREC";"S";"0164";"SI LOCA_DONPFI > 0"
"SDONREC";"S";"0165";"   ENLEVER ""YDONPFI"""
"SDONREC";"S";"0166";"   AJOUTER ""YDONPFI"" ""N"" LOCA_DONPFI"
"SDONREC";"S";"0167";"FINSI"
"SDONREC";"S";"0168";"* Récup RJF"
"SDONREC";"S";"0169";"SI LOCA_DONRJF > 0"
"SDONREC";"S";"0170";"   ENLEVER ""YDONRJF"""
"SDONREC";"S";"0171";"   AJOUTER ""YDONRJF"" ""N"" LOCA_DONRJF"
"SDONREC";"S";"0172";"FINSI"
"SDONREC";"S";"0173";"*"
"SDONREC";"S";"0174";"FIN"
