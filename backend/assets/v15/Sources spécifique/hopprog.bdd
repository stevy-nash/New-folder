"SCONTR";"S";"0226";"*"
"SCONTR";"S";"0227";"      FINSI"
"SCONTR";"S";"0228";"*"
"SCONTR";"S";"0229";"      SI LOCA_PREMBT <> HJOU_IJQDEBADGT"
"SCONTR";"S";"0230";"         LOCA_REPOS = LOCA_PREMBT + 24.00"
"SCONTR";"S";"0231";"         LOCA_REPOS = LOCA_REPOS - HJOU_IJRDBADGTV"
