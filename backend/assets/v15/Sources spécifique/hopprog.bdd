"SGJFF";"S";"0028";"*"
"SGJFF";"S";"0029";"* Implémentation des données industrielles"
"SGJFF";"S";"0030";"*"
"SGJFF";"S";"0031";"DEBDICO"
"SGJFF";"S";"0032";"   HJOU_SJRDJFF;N;N6,2;I;;;     6789;;SJRDJFF;V3;""Droit JFF"";"
"SGJFF";"S";"0033";"   HJOU_SJRCJFF;N;N6,2;I;;;     6789;;SJRCJFF;V3;""Pris JFF"";"
"SGJFF";"S";"0034";"   HJOU_SJRSJFF;N;N6,2;I;;;     6789;;SJRSJFF;V3;""Solde JFF"";"
"SGJFF";"S";"0035";"   HJOU_SJRCJFFW;N;N6,2;I;;;     6789;;SJRCJFFW;V3;""Pris JFF en attente"";"
"SGJFF";"S";"0036";"   EMPL_SEQSPJFF;N;N6,1;I;;;    56789;;;V3;""Solde prév. JFF"";"
"SGJFF";"S";"0037";"   PARD_SDIVMJFF;O;A10;X;;;123456789;II;;C2;""Motif JFF"";"
"SGJFF";"S";"0038";"   *"
"SGJFF";"S";"0039";"   EMPL_SEQCJFF;N;N6,1;I;;;    56789;;;V3;""Pris prév. JFF"";"
"SGJFF";"S";"0040";"FINDICO"
"SGJFF";"S";"0041";"*"
"SGJFF";"S";"0042";"DEBANO"
"SGJFF";"S";"0043";"   243;9;""Pas droit au motif JFF"";"
"SGJFF";"S";"0044";"   244;8;""Solde JFF insuffisant"";"
"SGJFF";"S";"0045";"FINANO"
"SGJFF";"S";"0046";"*"
"SGJFF";"S";"0047";"* Déclaration des donnees locales"
"SGJFF";"S";"0048";"*"
"SGJFF";"S";"0049";"DEF LOCA_DROIT N2"
"SGJFF";"S";"0050";"LOCA_DROIT = 0"
"SGJFF";"S";"0051";"DEF LOCA_MOT N2"
"SGJFF";"S";"0052";"LOCA_MOT = 0"
"SGJFF";"S";"0053";"DEF LOCA_PRIS N6.2"
"SGJFF";"S";"0054";"LOCA_PRIS = 0"
"SGJFF";"S";"0055";"DEF LOCA_PRISW N6.2"
"SGJFF";"S";"0056";"LOCA_PRISW = 0"
"SGJFF";"S";"0057";"DEF LOCA_FERI N2"
"SGJFF";"S";"0058";"LOCA_FERI = 0"
"SGJFF";"S";"0059";"DEF LOCA_DJFF N6.2"
"SGJFF";"S";"0060";"LOCA_DJFF = 0"
"SGJFF";"S";"0061";"DEF LOCA_COEFF N8.5"
"SGJFF";"S";"0062";"LOCA_COEFF = 0"
"SGJFF";"S";"0063";"DEF LOCA_SJRJPRECAL N4"
"SGJFF";"S";"0064";"LOCA_SJRJPRECAL = 0"
"SGJFF";"S";"0065";"*"
"SGJFF";"S";"0066";"DEF LOCA_DATE D"
"SGJFF";"S";"0067";"LOCA_DATE(5:4) = ""0101"""
"SGJFF";"S";"0068";"DEF LOCA_DATEFU D"
"SGJFF";"S";"0069";"LOCA_DATEFU(5:4) = ""0101"""
"SGJFF";"S";"0070";"DEF LOCA_ANNEE N4"
"SGJFF";"S";"0071";"LOCA_ANNEE << TEMP_DATJOU(1:4)"
"SGJFF";"S";"0072";"LOCA_DATE(1:4) << LOCA_ANNEE"
"SGJFF";"S";"0073";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SGJFF";"S";"0074";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SGJFF";"S";"0075";"*"
"SGJFF";"S";"0076";"DEF LOCA_VALAROND N6.2"
"SGJFF";"S";"0077";"LOCA_VALAROND = 0"
"SGJFF";"S";"0078";"DEF LOCA_RESTE N6.2"
"SGJFF";"S";"0079";"LOCA_RESTE = 0"
"SGJFF";"S";"0080";"DEF LOCA_ENTIER N6.2"
"SGJFF";"S";"0081";"LOCA_ENTIER = 0"
"SGJFF";"S";"0082";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGJFF";"S";"0083";"DEF LOCA_TYPARROND N2"
"SGJFF";"S";"0084";"LOCA_TYPARROND = 2"
"SGJFF";"S";"0085";"*"
"SGJFF";"S";"0086";"POUR ACTIVITES"
"SGJFF";"S";"0087";"   SI HABS_MOTIF = ""JF"""
"SGJFF";"S";"0088";"      LOCA_FERI = 1"
"SGJFF";"S";"0089";"   FINSI"
"SGJFF";"S";"0090";"FINPOUR"
"SGJFF";"S";"0091";"*"
"SGJFF";"S";"0092";"* Si service donne droit"
"SGJFF";"S";"0093";"SI HJOU_SECTORI = ""DSI573"""
"SGJFF";"S";"0094";"OU HJOU_SECTORI = ""DSI576"""
"SGJFF";"S";"0095";"   SI HJOU_SJRDRJF > 0"
"SGJFF";"S";"0096";"   LOCA_DROIT = 1"
"SGJFF";"S";"0097";"   FINSI"
"SGJFF";"S";"0098";"FINSI"
"SGJFF";"S";"0099";"*"
"SGJFF";"S";"0100";"*"
"SGJFF";"S";"0101";"***** DEB : Gestion de l'acquisition >>"
"SGJFF";"S";"0102";"*"
"SGJFF";"S";"0103";"* RAZ"
"SGJFF";"S";"0104";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGJFF";"S";"0105";"   HJOU_SJRDJFF = 0"
"SGJFF";"S";"0106";"   HJOU_SJRCJFF = 0"
"SGJFF";"S";"0107";"* Solde >>"
"SGJFF";"S";"0108";"   HJOU_SJRSJFF = HJOU_SJRDJFF - HJOU_SJRCJFF"
"SGJFF";"S";"0109";"FINSI"
"SGJFF";"S";"0110";"*"
"SGJFF";"S";"0111";"SI LOCA_DROIT = 1"
"SGJFF";"S";"0112";"   SI TEMP_STQJF = ""JJF"""
"SGJFF";"S";"0113";"      SI HJOU_IJQTTEFFEJ > 0"
"SGJFF";"S";"0114";"         HJOU_SJRDJFF = HJOU_SJRDJFF + 1"
"SGJFF";"S";"0115";"      FINSI"
"SGJFF";"S";"0116";"   FINSI"
"SGJFF";"S";"0117";"FINSI"
"SGJFF";"S";"0118";"*"
"SGJFF";"S";"0119";"* Init et MAJ du droit par consignes >>"
"SGJFF";"S";"0120";"POUR ACTIVITES"
"SGJFF";"S";"0121";"* MAJ"
"SGJFF";"S";"0122";"   SI HABS_MOTIF = ""XDJFF"""
"SGJFF";"S";"0123";"      HJOU_SJRDJFF = HJOU_SJRDJFF + HABS_MOTINBR"
"SGJFF";"S";"0124";"   FINSI"
"SGJFF";"S";"0125";"* Init"
"SGJFF";"S";"0126";"   SI HABS_MOTIF = ""ZDJFF"""
"SGJFF";"S";"0127";"      HJOU_SJRDJFF = HABS_MOTINBR"
"SGJFF";"S";"0128";"   FINSI"
"SGJFF";"S";"0129";"FINPOUR"
"SGJFF";"S";"0130";"*"
"SGJFF";"S";"0131";"* Solde >>"
"SGJFF";"S";"0132";"HJOU_SJRSJFF = HJOU_SJRDJFF - HJOU_SJRCJFF"
"SGJFF";"S";"0133";"*"
"SGJFF";"S";"0134";"***** DEB : Gestion de la consommation >>"
"SGJFF";"S";"0135";"POUR ACTIVITES"
"SGJFF";"S";"0136";"*"
"SGJFF";"S";"0137";"   SI HJOU_IJQPRETHEJ > 0"
"SGJFF";"S";"0138";"      SI HABS_MOTIF = PARD_SDIVMJFF"
"SGJFF";"S";"0139";"         LOCA_MOT = 1"
"SGJFF";"S";"0140";"*"
"SGJFF";"S";"0141";"         SI HABS_VALORIS = ""J"""
"SGJFF";"S";"0142";"            SI PROF_ABSENM = 0"
"SGJFF";"S";"0143";"            OU PROF_ABSENS = 0"
"SGJFF";"S";"0144";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SGJFF";"S";"0145";"            SINON"
"SGJFF";"S";"0146";"               LOCA_PRIS = LOCA_PRIS + 1"
"SGJFF";"S";"0147";"            FINSI"
"SGJFF";"S";"0148";"         SINON"
"SGJFF";"S";"0149";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SGJFF";"S";"0150";"         FINSI"
"SGJFF";"S";"0151";"*"
"SGJFF";"S";"0152";"      FINSI"
"SGJFF";"S";"0153";"   FINSI"
"SGJFF";"S";"0154";"FINPOUR"
"SGJFF";"S";"0155";"*"
"SGJFF";"S";"0156";"SI LOCA_PRIS > 1"
"SGJFF";"S";"0157";"   LOCA_PRIS = 1"
"SGJFF";"S";"0158";"FINSI"
"SGJFF";"S";"0159";"*"
"SGJFF";"S";"0160";"SI LOCA_PRIS > 0"
"SGJFF";"S";"0161";"   HJOU_SJRCJFF = HJOU_SJRCJFF + LOCA_PRIS"
"SGJFF";"S";"0162";"FINSI"
"SGJFF";"S";"0163";"*"
"SGJFF";"S";"0164";"* Init et MAJ du pris par consignes >>"
"SGJFF";"S";"0165";"POUR ACTIVITES"
"SGJFF";"S";"0166";"* MAJ"
"SGJFF";"S";"0167";"   SI HABS_MOTIF = ""XCJFF"""
"SGJFF";"S";"0168";"      HJOU_SJRCJFF = HJOU_SJRCJFF + HABS_MOTINBR"
"SGJFF";"S";"0169";"   FINSI"
"SGJFF";"S";"0170";"* Init"
"SGJFF";"S";"0171";"   SI HABS_MOTIF = ""ZCJFF"""
"SGJFF";"S";"0172";"      HJOU_SJRCJFF = HABS_MOTINBR"
"SGJFF";"S";"0173";"   FINSI"
"SGJFF";"S";"0174";"FINPOUR"
"SGJFF";"S";"0175";"*"
"SGJFF";"S";"0176";"* Solde >>"
"SGJFF";"S";"0177";"HJOU_SJRSJFF = HJOU_SJRDJFF - HJOU_SJRCJFF"
"SGJFF";"S";"0178";"*"
"SGJFF";"S";"0179";"***** DEB : Gestion du pris en attente >>"
"SGJFF";"S";"0180";"*"
"SGJFF";"S";"0181";"POUR WACTIVITES"
"SGJFF";"S";"0182";"   SI WABS_ANNUL = ""0"""
"SGJFF";"S";"0183";"      SI LOCA_FERI <> 1"
"SGJFF";"S";"0184";"         SI HJOU_IJQPRETHEJ > 0.00"
"SGJFF";"S";"0185";"*"
"SGJFF";"S";"0186";"            SI WABS_MOTIF = PARD_SDIVMJFF"
"SGJFF";"S";"0187";"* Gestion de la valorisation >>"
"SGJFF";"S";"0188";"               SI WABS_VALORIS = ""J"""
"SGJFF";"S";"0189";"                  SI PROF_ABSENM = 0"
"SGJFF";"S";"0190";"                  OU PROF_ABSENS = 0"
"SGJFF";"S";"0191";"                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SGJFF";"S";"0192";"                  SINON"
"SGJFF";"S";"0193";"                     LOCA_PRISW = 1"
"SGJFF";"S";"0194";"                  FINSI"
"SGJFF";"S";"0195";"               SINON"
"SGJFF";"S";"0196";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SGJFF";"S";"0197";"               FINSI"
"SGJFF";"S";"0198";"            FINSI"
"SGJFF";"S";"0199";"         FINSI"
"SGJFF";"S";"0200";"      FINSI"
"SGJFF";"S";"0201";"   FINSI"
"SGJFF";"S";"0202";"FINPOUR"
"SGJFF";"S";"0203";"*"
"SGJFF";"S";"0204";"SI LOCA_PRISW > 1"
"SGJFF";"S";"0205";"   LOCA_PRISW = 1"
"SGJFF";"S";"0206";"FINSI"
"SGJFF";"S";"0207";"*"
"SGJFF";"S";"0208";"SI LOCA_PRISW > 0"
"SGJFF";"S";"0209";"   HJOU_SJRCJFFW = HJOU_SJRCJFFW + LOCA_PRISW"
"SGJFF";"S";"0210";"FINSI"
"SGJFF";"S";"0211";"*"
"SGJFF";"S";"0212";"* Solde >>"
"SGJFF";"S";"0213";"HJOU_SJRSJFF = HJOU_SJRDJFF - HJOU_SJRCJFF"
"SGJFF";"S";"0214";"*"
"SGJFF";"S";"0215";"***** Gestion des anomalies >>"
"SGJFF";"S";"0216";"*"
"SGJFF";"S";"0217";"SI LOCA_MOT = 1"
"SGJFF";"S";"0218";"* Si droit ?"
"SGJFF";"S";"0219";"   SI LOCA_DROIT <> 1"
"SGJFF";"S";"0220";"      ANOMALIE 243"
"SGJFF";"S";"0221";"      SI TEMP_CNMOTIF = PARD_SDIVMJFF"
"SGJFF";"S";"0222";"         TEMP_CNRETOUR = 2"
"SGJFF";"S";"0223";"         TEMP_CNMESS = 243"
"SGJFF";"S";"0224";"      FINSI"
"SGJFF";"S";"0225";"   FINSI"
"SGJFF";"S";"0226";"* Si solde négatif ?"
"SGJFF";"S";"0227";"   SI HJOU_SJRSJFF < 0"
"SGJFF";"S";"0228";"      ANOMALIE 244"
"SGJFF";"S";"0229";"      SI TEMP_CNMOTIF = PARD_SDIVMJFF"
"SGJFF";"S";"0230";"      OU TEMP_CNMOTIF = ""YPERJFF"""
"SGJFF";"S";"0231";"         TEMP_CNRETOUR = 2"
"SGJFF";"S";"0232";"         TEMP_CNMESS = 244"
"SGJFF";"S";"0233";"      FINSI"
"SGJFF";"S";"0234";"   FINSI"
"SGJFF";"S";"0235";"*"
"SGJFF";"S";"0236";"FINSI"
"SGJFF";"S";"0237";"*"
"SGJFF";"S";"0238";"***** Solde prévisionnel >>"
"SGJFF";"S";"0239";"*"
"SGJFF";"S";"0240";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGJFF";"S";"0241";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SGJFF";"S";"0242";"      SI HJOU_SJQFINC = 1"
"SGJFF";"S";"0243";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGJFF";"S";"0244";"         LOCA_DATEFU = TEMP_DXFINPER"
"SGJFF";"S";"0245";"      FINSI"
"SGJFF";"S";"0246";"   FINSI"
"SGJFF";"S";"0247";"FINSI"
"SGJFF";"S";"0248";"*"
"SGJFF";"S";"0249";"SI TEMP_DATSUI = LOCA_DATEFU"
"SGJFF";"S";"0250";"* JJA - 13/06/2025 - Pris prèv."
"SGJFF";"S";"0251";"   EMPL_SEQCRJF = HJOU_SJRCJFF + HJOU_SJRCJFFW"
"SGJFF";"S";"0252";"   EMPL_SEQSPJFF = HJOU_SJRSJFF - HJOU_SJRCJFFW"
"SGJFF";"S";"0253";"FINSI"
"SGJFF";"S";"0254";"*"
"SGJFF";"S";"0255";"FIN"
"SGJFF";"S";"0256";"*"
"SGJFF";"S";"0257";"* Gestion arrondis"
"SGJFF";"S";"0258";"PROC ARRONDI"
"SGJFF";"S";"0259";"*"
"SGJFF";"S";"0260";"*DEF LOCA_VALAROND N6.2"
"SGJFF";"S";"0261";"*LOCA_VALAROND = 0"
"SGJFF";"S";"0262";"*DEF LOCA_RESTE N6.2"
"SGJFF";"S";"0263";"*LOCA_RESTE = 0"
"SGJFF";"S";"0264";"*DEF LOCA_ENTIER N6.2"
"SGJFF";"S";"0265";"*LOCA_ENTIER = 0"
"SGJFF";"S";"0266";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGJFF";"S";"0267";"*DEF LOCA_TYPARROND N2"
"SGJFF";"S";"0268";"*LOCA_TYPARROND = 0"
"SGJFF";"S";"0269";"*"
"SGJFF";"S";"0270";"* Arrondi à l'entier supérieur >>"
"SGJFF";"S";"0271";"   SI LOCA_TYPARROND = 1"
"SGJFF";"S";"0272";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGJFF";"S";"0273";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGJFF";"S";"0274";"      SI LOCA_RESTE > 0"
"SGJFF";"S";"0275";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGJFF";"S";"0276";"      FINSI"
"SGJFF";"S";"0277";"      LOCA_VALAROND = LOCA_ENTIER"
"SGJFF";"S";"0278";"   FINSI"
"SGJFF";"S";"0279";"*"
"SGJFF";"S";"0280";"* Arrondi à demi supérieur >>"
"SGJFF";"S";"0281";"   SI LOCA_TYPARROND = 2"
"SGJFF";"S";"0282";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGJFF";"S";"0283";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGJFF";"S";"0284";"      SI LOCA_RESTE > 0.5"
"SGJFF";"S";"0285";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGJFF";"S";"0286";"      SINON"
"SGJFF";"S";"0287";"         SI LOCA_RESTE > 0"
"SGJFF";"S";"0288";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGJFF";"S";"0289";"         FINSI"
"SGJFF";"S";"0290";"      FINSI"
"SGJFF";"S";"0291";"      LOCA_VALAROND = LOCA_ENTIER"
"SGJFF";"S";"0292";"   FINSI"
"SGJFF";"S";"0293";"*"
"SGJFF";"S";"0294";"* Arrondi à demi le plus proche >>"
"SGJFF";"S";"0295";"   SI LOCA_TYPARROND = 3"
"SGJFF";"S";"0296";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGJFF";"S";"0297";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGJFF";"S";"0298";"      SI LOCA_RESTE >= 0.75"
"SGJFF";"S";"0299";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGJFF";"S";"0300";"      SINON"
"SGJFF";"S";"0301";"         SI LOCA_RESTE >= 0.25"
"SGJFF";"S";"0302";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGJFF";"S";"0303";"         FINSI"
"SGJFF";"S";"0304";"      FINSI"
"SGJFF";"S";"0305";"      LOCA_VALAROND = LOCA_ENTIER"
"SGJFF";"S";"0306";"   FINSI"
"SGJFF";"S";"0307";"*"
"SGJFF";"S";"0308";"FINPROC"
"SGJFF";"S";"0309";"*"
"SGJTRIM";"S";"0001";"***********************************************************************"
"SGJTRIM";"S";"0002";"*"
"SGJTRIM";"S";"0003";"* Règle : SGJTRIM"
"SGJTRIM";"S";"0004";"* Ordre : 6230"
"SGJTRIM";"S";"0005";"* Titre : GCF : Journée trimestrielle"
"SGJTRIM";"S";"0006";"*"
"SGJTRIM";"S";"0007";"*----------------------------------------------------------------------"
"SGJTRIM";"S";"0008";"*"
"SGJTRIM";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SGJTRIM";"S";"0010";"* Date     : 22/01/2025"
"SGJTRIM";"S";"0011";"* Version  : 1"
"SGJTRIM";"S";"0012";"*"
"SGJTRIM";"S";"0013";"*----------------------------------------------------------------------"
"SGJTRIM";"S";"0014";"*"
"SGJTRIM";"S";"0015";"*"
"SGJTRIM";"S";"0016";"* Rôle : Cette récupération concerne uniquement la société PU sauf cadre dirigeant"
"SGJTRIM";"S";"0017";"*        JTR = Journée trimestrielle"
"SGJTRIM";"S";"0018";"*        Acquisition de 1 jour tout les trimestres"
"SGJTRIM";"S";"0019";"*"
"SGJTRIM";"S";"0020";"*"
"SGJTRIM";"S";"0021";"*----------------------------------------------------------------------"
"SGJTRIM";"S";"0022";"*"
"SGJTRIM";"S";"0023";"* Modifiée par :"
"SGJTRIM";"S";"0024";"* Date         :"
"SGJTRIM";"S";"0025";"* Objet        :"
"SGJTRIM";"S";"0026";"*"
"SGJTRIM";"S";"0027";"***********************************************************************"
"SGJTRIM";"S";"0028";"*"
"SGJTRIM";"S";"0029";"* Implémentation des données industrielles"
"SGJTRIM";"S";"0030";"*"
"SGJTRIM";"S";"0031";"DEBDICO"
"SGJTRIM";"S";"0032";"   HJOU_SJRDJTR;N;N6,2;I;;;     6789;;SJRDJTR;V3;""Droit J. Trimestrielle"";"
"SGJTRIM";"S";"0033";"   HJOU_SJRCJTR;N;N6,2;I;;;     6789;;SJRCJTR;V3;""Pris J. Trimestrielle"";"
"SGJTRIM";"S";"0034";"   HJOU_SJRSJTR;N;N6,2;I;;;     6789;;SJRSJTR;V3;""Solde J. Trimestrielle"";"
"SGJTRIM";"S";"0035";"   PARD_SDIVMJTR;O;A10;X;;;123456789;II;;C2;""Motif JTR"";"
"SGJTRIM";"S";"0036";"   HJOU_SJRABSJTR;N;N6,1;I;;;     6789;;SJRABSJTR;V3;""Nbres jours d'absences au trimestre"";"
"SGJTRIM";"S";"0037";"FINDICO"
"SGJTRIM";"S";"0038";"*"
"SGJTRIM";"S";"0039";"DEBANO"
"SGJTRIM";"S";"0040";"   236;9;""Pas droit au motif JTR"";"
"SGJTRIM";"S";"0041";"   237;8;""Solde JTR insuffisant"";"
"SGJTRIM";"S";"0042";"FINANO"
"SGJTRIM";"S";"0043";"*"
"SGJTRIM";"S";"0044";"* Déclaration des donnees locales"
"SGJTRIM";"S";"0045";"*"
"SGJTRIM";"S";"0046";"DEF LOCA_DROIT N2"
"SGJTRIM";"S";"0047";"LOCA_DROIT = 0"
"SGJTRIM";"S";"0048";"DEF LOCA_MOT N2"
"SGJTRIM";"S";"0049";"LOCA_MOT = 0"
"SGJTRIM";"S";"0050";"DEF LOCA_PRIS N6.2"
"SGJTRIM";"S";"0051";"LOCA_PRIS = 0"
"SGJTRIM";"S";"0052";"DEF LOCA_DJTR N6.2"
"SGJTRIM";"S";"0053";"LOCA_DJTR = 0"
"SGJTRIM";"S";"0054";"DEF LOCA_SEUIABS N6.1"
"SGJTRIM";"S";"0055";"LOCA_SEUIABS = 31.0"
"SGJTRIM";"S";"0056";"DEF LOCA_ANCM N4"
"SGJTRIM";"S";"0057";"LOCA_ANCM = 0"
"SGJTRIM";"S";"0058";"*"
"SGJTRIM";"S";"0059";"* Si société PU"
"SGJTRIM";"S";"0060";"SI HJOU_SJQSOCIETE = ""PU"""
"SGJTRIM";"S";"0061";"*"
"SGJTRIM";"S";"0062";"* Calcul de l'ancienneté"
"SGJTRIM";"S";"0063";"   SI EMPS_E2DATEANC <> "" """
"SGJTRIM";"S";"0064";"      DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"SGJTRIM";"S";"0065";"      LOCA_ANCM = TEMP_NXMOIS"
"SGJTRIM";"S";"0066";"   FINSI"
"SGJTRIM";"S";"0067";"*"
"SGJTRIM";"S";"0068";"* Au moins 3 mois"
"SGJTRIM";"S";"0069";"   SI LOCA_ANCM >= 3"
"SGJTRIM";"S";"0070";"      SI CTRA_SCISTATUT <> ""D"""
"SGJTRIM";"S";"0071";"         LOCA_DJTR = 1.00"
"SGJTRIM";"S";"0072";"         LOCA_DROIT = 1"
"SGJTRIM";"S";"0073";"      FINSI"
"SGJTRIM";"S";"0074";"   FINSI"
"SGJTRIM";"S";"0075";"FINSI"
"SGJTRIM";"S";"0076";"*"
"SGJTRIM";"S";"0077";"***** DEB : Gestion de l'acquisition >>"
"SGJTRIM";"S";"0078";"*"
"SGJTRIM";"S";"0079";"* Acquisition à période de référence >>"
"SGJTRIM";"S";"0080";"SI HJOU_DATE(5:4) = ""0101"""
"SGJTRIM";"S";"0081";"OU HJOU_DATE(5:4) = ""0401"""
"SGJTRIM";"S";"0082";"OU HJOU_DATE(5:4) = ""0701"""
"SGJTRIM";"S";"0083";"OU HJOU_DATE(5:4) = ""1001"""
"SGJTRIM";"S";"0084";"*"
"SGJTRIM";"S";"0085";"* Acquis si moins de 31J d'absences sur le trimestre précédant >>"
"SGJTRIM";"S";"0086";"   SI HJOU_SJRABSJTR < LOCA_SEUIABS"
"SGJTRIM";"S";"0087";"      HJOU_SJRDJTR = LOCA_DJTR"
"SGJTRIM";"S";"0088";"   SINON"
"SGJTRIM";"S";"0089";"      HJOU_SJRDJTR = 0"
"SGJTRIM";"S";"0090";"   FINSI"
"SGJTRIM";"S";"0091";"*"
"SGJTRIM";"S";"0092";"* RAZ"
"SGJTRIM";"S";"0093";"   HJOU_SJRABSJTR = 0"
"SGJTRIM";"S";"0094";"   HJOU_SJRCJTR = 0"
"SGJTRIM";"S";"0095";"   HJOU_SJRSJTR = HJOU_SJRDJTR - HJOU_SJRCJTR"
"SGJTRIM";"S";"0096";"*"
"SGJTRIM";"S";"0097";"FINSI"
"SGJTRIM";"S";"0098";"*"
"SGJTRIM";"S";"0099";"* Init et MAJ du droit par consignes >>"
"SGJTRIM";"S";"0100";"POUR ACTIVITES"
"SGJTRIM";"S";"0101";"* MAJ"
"SGJTRIM";"S";"0102";"   SI HABS_MOTIF = ""XDJTR"""
"SGJTRIM";"S";"0103";"      HJOU_SJRDJTR = HJOU_SJRDJTR + HABS_MOTINBR"
"SGJTRIM";"S";"0104";"   FINSI"
"SGJTRIM";"S";"0105";"* Init"
"SGJTRIM";"S";"0106";"   SI HABS_MOTIF = ""ZDJTR"""
"SGJTRIM";"S";"0107";"      HJOU_SJRDJTR = HABS_MOTINBR"
"SGJTRIM";"S";"0108";"   FINSI"
"SGJTRIM";"S";"0109";"*"
"SGJTRIM";"S";"0110";"* Calcul nombre de jour absence"
"SGJTRIM";"S";"0111";"   SI HABS_MOTYPE = ""A"""
"SGJTRIM";"S";"0112";"      SI MOTI_IMIGTTEFFE <> ""1"""
"SGJTRIM";"S";"0113";"         SI HABS_VALORIS = ""J"""
"SGJTRIM";"S";"0114";"            HJOU_SJRABSJTR = HJOU_SJRABSJTR + 1"
"SGJTRIM";"S";"0115";"         FINSI"
"SGJTRIM";"S";"0116";"         SI HABS_VALORIS = ""M"""
"SGJTRIM";"S";"0117";"         OU HABS_VALORIS = ""A"""
"SGJTRIM";"S";"0118";"            HJOU_SJRABSJTR = HJOU_SJRABSJTR + 0.5"
"SGJTRIM";"S";"0119";"         FINSI"
"SGJTRIM";"S";"0120";"      FINSI"
"SGJTRIM";"S";"0121";"   FINSI"
"SGJTRIM";"S";"0122";"FINPOUR"
"SGJTRIM";"S";"0123";"*"
"SGJTRIM";"S";"0124";"* Solde >>"
"SGJTRIM";"S";"0125";"HJOU_SJRSJTR = HJOU_SJRDJTR - HJOU_SJRCJTR"
"SGJTRIM";"S";"0126";"*"
"SGJTRIM";"S";"0127";"***** DEB : Gestion de la consommation >>"
"SGJTRIM";"S";"0128";"POUR ACTIVITES"
"SGJTRIM";"S";"0129";"*"
"SGJTRIM";"S";"0130";"   SI HJOU_IJQPRETHEJ > 0"
"SGJTRIM";"S";"0131";"      SI HABS_MOTIF = PARD_SDIVMJTR"
"SGJTRIM";"S";"0132";"         LOCA_MOT = 1"
"SGJTRIM";"S";"0133";"*"
"SGJTRIM";"S";"0134";"         SI HABS_VALORIS = ""J"""
"SGJTRIM";"S";"0135";"            SI PROF_ABSENM = 0"
"SGJTRIM";"S";"0136";"            OU PROF_ABSENS = 0"
"SGJTRIM";"S";"0137";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SGJTRIM";"S";"0138";"            SINON"
"SGJTRIM";"S";"0139";"               LOCA_PRIS = LOCA_PRIS + 1"
"SGJTRIM";"S";"0140";"            FINSI"
"SGJTRIM";"S";"0141";"         SINON"
"SGJTRIM";"S";"0142";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SGJTRIM";"S";"0143";"         FINSI"
"SGJTRIM";"S";"0144";"*"
"SGJTRIM";"S";"0145";"      FINSI"
"SGJTRIM";"S";"0146";"   FINSI"
"SGJTRIM";"S";"0147";"FINPOUR"
"SGJTRIM";"S";"0148";"*"
"SGJTRIM";"S";"0149";"SI LOCA_PRIS > 1"
"SGJTRIM";"S";"0150";"   LOCA_PRIS = 1"
"SGJTRIM";"S";"0151";"FINSI"
"SGJTRIM";"S";"0152";"*"
"SGJTRIM";"S";"0153";"SI LOCA_PRIS > 0"
"SGJTRIM";"S";"0154";"   HJOU_SJRCJTR = HJOU_SJRCJTR + LOCA_PRIS"
"SGJTRIM";"S";"0155";"FINSI"
"SGJTRIM";"S";"0156";"*"
"SGJTRIM";"S";"0157";"* Init et MAJ du pris par consignes >>"
"SGJTRIM";"S";"0158";"POUR ACTIVITES"
"SGJTRIM";"S";"0159";"* MAJ"
"SGJTRIM";"S";"0160";"   SI HABS_MOTIF = ""XCJTR"""
"SGJTRIM";"S";"0161";"      HJOU_SJRCJTR = HJOU_SJRCJTR + HABS_MOTINBR"
"SGJTRIM";"S";"0162";"   FINSI"
"SGJTRIM";"S";"0163";"* Init"
"SGJTRIM";"S";"0164";"   SI HABS_MOTIF = ""ZCJTR"""
"SGJTRIM";"S";"0165";"      HJOU_SJRCJTR = HABS_MOTINBR"
"SGJTRIM";"S";"0166";"   FINSI"
"SGJTRIM";"S";"0167";"FINPOUR"
"SGJTRIM";"S";"0168";"*"
"SGJTRIM";"S";"0169";"* Solde >>"
"SGJTRIM";"S";"0170";"HJOU_SJRSJTR = HJOU_SJRDJTR - HJOU_SJRCJTR"
"SGJTRIM";"S";"0171";"*"
"SGJTRIM";"S";"0172";"***** Gestion des anomalies >>"
"SGJTRIM";"S";"0173";"*"
"SGJTRIM";"S";"0174";"SI LOCA_MOT = 1"
"SGJTRIM";"S";"0175";"* Si droit ?"
"SGJTRIM";"S";"0176";"   SI LOCA_DROIT <> 1"
"SGJTRIM";"S";"0177";"      ANOMALIE 236"
"SGJTRIM";"S";"0178";"      SI TEMP_CNMOTIF = PARD_SDIVMJTR"
"SGJTRIM";"S";"0179";"         TEMP_CNRETOUR = 2"
"SGJTRIM";"S";"0180";"         TEMP_CNMESS = 236"
"SGJTRIM";"S";"0181";"      FINSI"
"SGJTRIM";"S";"0182";"   FINSI"
"SGJTRIM";"S";"0183";"* Si solde négatif ?"
"SGJTRIM";"S";"0184";"   SI HJOU_SJRSJTR < 0"
"SGJTRIM";"S";"0185";"      ANOMALIE 237"
"SGJTRIM";"S";"0186";"      SI TEMP_CNMOTIF = PARD_SDIVMJTR"
"SGJTRIM";"S";"0187";"         TEMP_CNRETOUR = 2"
"SGJTRIM";"S";"0188";"         TEMP_CNMESS = 237"
"SGJTRIM";"S";"0189";"      FINSI"
"SGJTRIM";"S";"0190";"   FINSI"
"SGJTRIM";"S";"0191";"*"
"SGJTRIM";"S";"0192";"FINSI"
"SGJTRIM";"S";"0193";"*"
"SGJTRIM";"S";"0194";"*"
"SGJTRIM";"S";"0195";"FIN"
"SGJTRIM";"S";"0196";"*"
"SGPERMA";"S";"0001";"***********************************************************************"
"SGPERMA";"S";"0002";"*"
"SGPERMA";"S";"0003";"* Règle : SGPERMA"
"SGPERMA";"S";"0004";"* Ordre : 6520"
"SGPERMA";"S";"0005";"* Titre : GCF : Gestion des permanences"
"SGPERMA";"S";"0006";"*"
"SGPERMA";"S";"0007";"*----------------------------------------------------------------------"
"SGPERMA";"S";"0008";"*"
"SGPERMA";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SGPERMA";"S";"0010";"* Date     : 25/02/2025"
"SGPERMA";"S";"0011";"* Version  : 1"
"SGPERMA";"S";"0012";"*"
"SGPERMA";"S";"0013";"*----------------------------------------------------------------------"
"SGPERMA";"S";"0014";"*"
"SGPERMA";"S";"0015";"*"
"SGPERMA";"S";"0016";"* Rôle : Gestion des permanences"
"SGPERMA";"S";"0017";"*        Société PU et Journaliste BE"
"SGPERMA";"S";"0018";"*"
"SGPERMA";"S";"0019";"*"
"SGPERMA";"S";"0020";"*----------------------------------------------------------------------"
"SGPERMA";"S";"0021";"*"
"SGPERMA";"S";"0022";"* Modifiée par :"
"SGPERMA";"S";"0023";"* Date         :"
"SGPERMA";"S";"0024";"* Objet        :"
"SGPERMA";"S";"0025";"*"
"SGPERMA";"S";"0026";"***********************************************************************"
"SGPERMA";"S";"0027";"*"
"SGPERMA";"S";"0028";"* Implémentation des données industrielles"
"SGPERMA";"S";"0029";"*"
"SGPERMA";"S";"0030";"DEBDICO"
"SGPERMA";"S";"0031";"   PARD_SDIVMPERM;O;A10;X;;;123456789;II;;C2;""Permanence"";"
"SGPERMA";"S";"0032";"   *"
"SGPERMA";"S";"0033";"   HJOU_SJRRECPERM;N;T6,2;I;;;     6789;;SJRRECPERM;V3;""PU : Dont récupération sur permanence"";"
"SGPERMA";"S";"0034";"   HJOU_SJQPRPERM;N;N2;I;;;    56789;;;V3;""BE : Prime permanence JL (5219)"";"
"SGPERMA";"S";"0035";"FINDICO"
"SGPERMA";"S";"0036";"*"
"SGPERMA";"S";"0037";"DEBANO"
"SGPERMA";"S";"0038";"FINANO"
"SGPERMA";"S";"0039";"*"
"SGPERMA";"S";"0040";"* Déclaration des donnees locales"
"SGPERMA";"S";"0041";"*"
"SGPERMA";"S";"0042";"DEF LOCA_DROIT N2"
"SGPERMA";"S";"0043";"LOCA_DROIT = 0"
"SGPERMA";"S";"0044";"DEF LOCA_PERMA N2"
"SGPERMA";"S";"0045";"LOCA_PERMA = 0"
"SGPERMA";"S";"0046";"DEF LOCA_7H T6.2"
"SGPERMA";"S";"0047";"LOCA_7H = 7.00"
"SGPERMA";"S";"0048";"DEF LOCA_DEMIJ T6.2"
"SGPERMA";"S";"0049";"*LOCA_DEMIJ = LOCA_7H / 2"
"SGPERMA";"S";"0050";"* FFT025006893 : valeur 4h par défaut"
"SGPERMA";"S";"0051";"LOCA_DEMIJ = 4.00"
"SGPERMA";"S";"0052";"*"
"SGPERMA";"S";"0053";"* Société PU"
"SGPERMA";"S";"0054";"SI HJOU_SJQSOCIETE = ""PU"""
"SGPERMA";"S";"0055";"   LOCA_DROIT = 1"
"SGPERMA";"S";"0056";"FINSI"
"SGPERMA";"S";"0057";"*"
"SGPERMA";"S";"0058";"* Journaliste société BE"
"SGPERMA";"S";"0059";"SI HJOU_SJQSOCIETE = ""BE"""
"SGPERMA";"S";"0060";"   SI HJOU_SJQCATEGOR = ""J"""
"SGPERMA";"S";"0061";"      LOCA_DROIT = 1"
"SGPERMA";"S";"0062";"   FINSI"
"SGPERMA";"S";"0063";"FINSI"
"SGPERMA";"S";"0064";"*"
"SGPERMA";"S";"0065";"POUR ACTIVITES"
"SGPERMA";"S";"0066";"   SI HABS_MOTIF = PARD_SDIVMPERM"
"SGPERMA";"S";"0067";"      LOCA_PERMA = 1"
"SGPERMA";"S";"0068";"   FINSI"
"SGPERMA";"S";"0069";"FINPOUR"
"SGPERMA";"S";"0070";"*"
"SGPERMA";"S";"0071";"SI LOCA_DROIT = 1"
"SGPERMA";"S";"0072";"   SI LOCA_PERMA = 1"
"SGPERMA";"S";"0073";"*"
"SGPERMA";"S";"0074";"* Pour la socité PU >> récupération d'une demi-journée"
"SGPERMA";"S";"0075";"      SI HJOU_SJQSOCIETE = ""PU"""
"SGPERMA";"S";"0076";"*"
"SGPERMA";"S";"0077";"         SI HJOU_JOUR = ""6"""
"SGPERMA";"S";"0078";"* FFT025006893 : que sur repos"
"SGPERMA";"S";"0079";"            SI HJOU_IJQPRETHEJ <= 0.02"
"SGPERMA";"S";"0080";"               HJOU_SJRRECPERM = HJOU_SJRRECPERM + LOCA_DEMIJ"
"SGPERMA";"S";"0081";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + LOCA_DEMIJ"
"SGPERMA";"S";"0082";"            FINSI"
"SGPERMA";"S";"0083";"         SINON"
"SGPERMA";"S";"0084";"* Uniquement le samedi"
"SGPERMA";"S";"0085";"            ANOMALIE 277"
"SGPERMA";"S";"0086";"            SI TEMP_CNMOTIF = PARD_SDIVMPERM"
"SGPERMA";"S";"0087";"               TEMP_CNRETOUR = 2"
"SGPERMA";"S";"0088";"               TEMP_CNMESS = 277"
"SGPERMA";"S";"0089";"            FINSI"
"SGPERMA";"S";"0090";"         FINSI"
"SGPERMA";"S";"0091";"* Société PU"
"SGPERMA";"S";"0092";"      FINSI"
"SGPERMA";"S";"0093";"*"
"SGPERMA";"S";"0094";"* Pour journaliste société BE - Prime permanence 5219"
"SGPERMA";"S";"0095";"      SI HJOU_SJQSOCIETE = ""BE"""
"SGPERMA";"S";"0096";"         HJOU_SJQPRPERM = 1"
"SGPERMA";"S";"0097";"* Société"
"SGPERMA";"S";"0098";"      FINSI"
"SGPERMA";"S";"0099";"*"
"SGPERMA";"S";"0100";"   FINSI"
"SGPERMA";"S";"0101";"FINSI"
"SGPERMA";"S";"0102";"*"
"SGPERMA";"S";"0103";"* Anomalie pas droit à la permanence"
"SGPERMA";"S";"0104";"SI LOCA_PERMA = 1"
"SGPERMA";"S";"0105";"   SI LOCA_DROIT <> 1"
"SGPERMA";"S";"0106";"      ANOMALIE 276"
"SGPERMA";"S";"0107";"      SI TEMP_CNMOTIF = PARD_SDIVMPERM"
"SGPERMA";"S";"0108";"         TEMP_CNRETOUR = 2"
"SGPERMA";"S";"0109";"         TEMP_CNMESS = 276"
"SGPERMA";"S";"0110";"      FINSI"
"SGPERMA";"S";"0111";"   FINSI"
"SGPERMA";"S";"0112";"FINSI"
"SGPERMA";"S";"0113";"*"
"SGPERMA";"S";"0114";"FIN"
