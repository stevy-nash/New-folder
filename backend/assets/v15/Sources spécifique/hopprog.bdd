"SGREP";"S";"0058";"DEF LOCA_PRISW N6.2"
"SGREP";"S";"0059";"LOCA_PRISW = 0"
"SGREP";"S";"0060";"DEF LOCA_PERCOW N6.2"
"SGREP";"S";"0061";"LOCA_PERCOW = 0"
"SGREP";"S";"0062";"DEF LOCA_FERI N2"
"SGREP";"S";"0063";"LOCA_FERI = 0"
"SGREP";"S";"0064";"DEF LOCA_DREP N6.2"
"SGREP";"S";"0065";"LOCA_DREP = 0"
"SGREP";"S";"0066";"DEF LOCA_ANCA N4"
"SGREP";"S";"0067";"LOCA_ANCA = 0"
"SGREP";"S";"0068";"DEF LOCA_SDIDJREPRC N4.1"
"SGREP";"S";"0069";"LOCA_SDIDJREPRC = PARD_SDIDJREPRC"
"SGREP";"S";"0070";"*"
"SGREP";"S";"0071";"DEF LOCA_DEB D"
"SGREP";"S";"0072";"LOCA_DEB(5:4) = ""0101"""
"SGREP";"S";"0073";"DEF LOCA_FIN D"
"SGREP";"S";"0074";"LOCA_FIN(5:4) = ""1231"""
"SGREP";"S";"0075";"DEF LOCA_NBJI N6.2"
"SGREP";"S";"0076";"LOCA_NBJI = 0"
"SGREP";"S";"0077";"DEF LOCA_NBJCAL N6.2"
"SGREP";"S";"0078";"LOCA_NBJCAL = 0"
"SGREP";"S";"0079";"*"
"SGREP";"S";"0080";"DEF LOCA_COEFF N8.5"
"SGREP";"S";"0081";"LOCA_COEFF = 0"
"SGREP";"S";"0082";"DEF LOCA_VALAROND N6.2"
"SGREP";"S";"0083";"LOCA_VALAROND = 0"
"SGREP";"S";"0084";"DEF LOCA_RESTE N6.2"
"SGREP";"S";"0085";"LOCA_RESTE = 0"
"SGREP";"S";"0086";"DEF LOCA_ENTIER N6.2"
"SGREP";"S";"0087";"LOCA_ENTIER = 0"
"SGREP";"S";"0088";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGREP";"S";"0089";"DEF LOCA_TYPARROND N2"
"SGREP";"S";"0090";"LOCA_TYPARROND = 2"
"SGREP";"S";"0091";"*"
"SGREP";"S";"0092";"DEF LOCA_DATE D"
"SGREP";"S";"0093";"LOCA_DATE(5:4) = ""0101"""
"SGREP";"S";"0094";"DEF LOCA_DATEFU D"
"SGREP";"S";"0095";"LOCA_DATEFU(5:4) = ""0101"""
"SGREP";"S";"0096";"DEF LOCA_ANNEE N4"
"SGREP";"S";"0097";"LOCA_ANNEE << TEMP_DATJOU(1:4)"
"SGREP";"S";"0098";"LOCA_DATE(1:4) << LOCA_ANNEE"
"SGREP";"S";"0099";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SGREP";"S";"0100";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SGREP";"S";"0101";"*"
"SGREP";"S";"0102";"POUR ACTIVITES"
"SGREP";"S";"0103";"   SI HABS_MOTIF = ""JF"""
"SGREP";"S";"0104";"      LOCA_FERI = 1"
"SGREP";"S";"0105";"   FINSI"
"SGREP";"S";"0106";"FINPOUR"
"SGREP";"S";"0107";"*"
"SGREP";"S";"0108";"SI HJOU_SJQSOCIETE = ""RC"""
"SGREP";"S";"0109";"*"
"SGREP";"S";"0110";"* Calcul de l'ancienneté"
"SGREP";"S";"0111";"   SI EMPS_E2DATEANC <> "" """
"SGREP";"S";"0112";"      DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"SGREP";"S";"0113";"      LOCA_ANCA = TEMP_NXANNEE"
"SGREP";"S";"0114";"   FINSI"
"SGREP";"S";"0115";"*"
"SGREP";"S";"0116";"* Ancienneté >= 1 an"
"SGREP";"S";"0117";"   SI LOCA_ANCA >= 1"
"SGREP";"S";"0118";"      LOCA_DROIT = 1"
"SGREP";"S";"0119";"* Droit REP de 6 par an"
"SGREP";"S";"0120";"      LOCA_DREP = LOCA_SDIDJREPRC"
"SGREP";"S";"0121";"   FINSI"
"SGREP";"S";"0122";"*"
"SGREP";"S";"0123";"FINSI"
"SGREP";"S";"0124";"*"
"SGREP";"S";"0125";"***** DEB : Gestion de l'acquisition >>"
"SGREP";"S";"0126";"*"
"SGREP";"S";"0127";"* Acquisition à période de référence >>"
"SGREP";"S";"0128";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGREP";"S";"0129";"*"
"SGREP";"S";"0130";"   LOCA_DEB(1:4) = HJOU_DATE(1:4)"
"SGREP";"S";"0131";"   LOCA_FIN(1:4) = HJOU_DATE(1:4)"
"SGREP";"S";"0132";"*"
"SGREP";"S";"0133";"* Proratise en fonction de la présence sur l'année en cours"
"SGREP";"S";"0134";"*"
"SGREP";"S";"0135";"   POUR PERIODES"
"SGREP";"S";"0136";"* On prend que les contrats en cours d'année"
"SGREP";"S";"0137";"      SI CTRA_DATDEB <= LOCA_FIN"
"SGREP";"S";"0138";"         SI CTRA_DATFIN >= LOCA_DEB"
"SGREP";"S";"0139";"            SI CTRA_SCISOCIETE = ""RC"""
"SGREP";"S";"0140";"* Calcul nombre du jour de présence en calendaire sur l'année"
"SGREP";"S";"0141";"               FAIRE NBJCAL"
"SGREP";"S";"0142";"               LOCA_NBJCAL = LOCA_NBJCAL + LOCA_NBJI"
"SGREP";"S";"0143";"            FINSI"
"SGREP";"S";"0144";"         FINSI"
"SGREP";"S";"0145";"      FINSI"
"SGREP";"S";"0146";"   FINPOUR"
"SGREP";"S";"0147";"*"
"SGREP";"S";"0148";"   LOCA_COEFF = LOCA_NBJCAL / 365"
"SGREP";"S";"0149";"   SI LOCA_COEFF > 1"
"SGREP";"S";"0150";"      LOCA_COEFF = 1"
"SGREP";"S";"0151";"   FINSI"
"SGREP";"S";"0152";"*"
"SGREP";"S";"0153";"   HJOU_SJRDREP = LOCA_DREP * LOCA_COEFF"
"SGREP";"S";"0154";"   LOCA_VALAROND = HJOU_SJRDREP"
"SGREP";"S";"0155";"   FAIRE ARRONDI"
"SGREP";"S";"0156";"   HJOU_SJRDREP = LOCA_VALAROND"
"SGREP";"S";"0157";"*"
"SGREP";"S";"0158";"* RAZ du pris"
"SGREP";"S";"0159";"   HJOU_SJRCREP = 0"
"SGREP";"S";"0160";"   HJOU_SJRSREP = HJOU_SJRDREP - HJOU_SJRCREP"
"SGREP";"S";"0161";"*"
"SGREP";"S";"0162";"FINSI"
"SGREP";"S";"0163";"*"
"SGREP";"S";"0164";"* Init et MAJ du droit par consignes >>"
"SGREP";"S";"0165";"POUR ACTIVITES"
"SGREP";"S";"0166";"* MAJ"
"SGREP";"S";"0167";"   SI HABS_MOTIF = ""XDREP"""
"SGREP";"S";"0168";"      HJOU_SJRDREP = HJOU_SJRDREP + HABS_MOTINBR"
"SGREP";"S";"0169";"   FINSI"
"SGREP";"S";"0170";"* Init"
"SGREP";"S";"0171";"   SI HABS_MOTIF = ""ZDREP"""
"SGREP";"S";"0172";"      HJOU_SJRDREP = HABS_MOTINBR"
"SGREP";"S";"0173";"   FINSI"
"SGREP";"S";"0174";"FINPOUR"
"SGREP";"S";"0175";"*"
"SGREP";"S";"0176";"* Solde >>"
"SGREP";"S";"0177";"HJOU_SJRSREP = HJOU_SJRDREP - HJOU_SJRCREP"
"SGREP";"S";"0178";"*"
"SGREP";"S";"0179";"***** DEB : Gestion de la consommation >>"
"SGREP";"S";"0180";"POUR ACTIVITES"
"SGREP";"S";"0181";"*"
"SGREP";"S";"0182";"* Gestion du PERCO >>"
"SGREP";"S";"0183";"   SI HABS_MOTIF = ""YPERREP"""
"SGREP";"S";"0184";"      LOCA_PERCO = LOCA_PERCO + HABS_MOTINBR"
"SGREP";"S";"0185";"   FINSI"
"SGREP";"S";"0186";"*"
"SGREP";"S";"0187";"   SI HJOU_IJQPRETHEJ > 0"
"SGREP";"S";"0188";"      SI HABS_MOTIF = PARD_SDIVMREP"
"SGREP";"S";"0189";"         LOCA_MOT = 1"
"SGREP";"S";"0190";"*"
"SGREP";"S";"0191";"         SI HABS_VALORIS = ""J"""
"SGREP";"S";"0192";"            SI PROF_ABSENM = 0"
"SGREP";"S";"0193";"            OU PROF_ABSENS = 0"
"SGREP";"S";"0194";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SGREP";"S";"0195";"            SINON"
"SGREP";"S";"0196";"               LOCA_PRIS = LOCA_PRIS + 1"
"SGREP";"S";"0197";"            FINSI"
"SGREP";"S";"0198";"         SINON"
"SGREP";"S";"0199";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SGREP";"S";"0200";"         FINSI"
"SGREP";"S";"0201";"*"
"SGREP";"S";"0202";"      FINSI"
"SGREP";"S";"0203";"   FINSI"
"SGREP";"S";"0204";"FINPOUR"
"SGREP";"S";"0205";"*"
"SGREP";"S";"0206";"SI LOCA_PRIS > 1"
"SGREP";"S";"0207";"   LOCA_PRIS = 1"
"SGREP";"S";"0208";"FINSI"
"SGREP";"S";"0209";"*"
"SGREP";"S";"0210";"SI LOCA_PRIS > 0"
"SGREP";"S";"0211";"   HJOU_SJRCREP = HJOU_SJRCREP + LOCA_PRIS"
"SGREP";"S";"0212";"FINSI"
"SGREP";"S";"0213";"*"
"SGREP";"S";"0214";"SI LOCA_PERCO > 0"
"SGREP";"S";"0215";"   HJOU_SJRCREP = HJOU_SJRCREP + LOCA_PERCO"
"SGREP";"S";"0216";"FINSI"
"SGREP";"S";"0217";"*"
"SGREP";"S";"0218";"* Init et MAJ du pris par consignes >>"
"SGREP";"S";"0219";"POUR ACTIVITES"
"SGREP";"S";"0220";"* MAJ"
"SGREP";"S";"0221";"   SI HABS_MOTIF = ""XCREP"""
"SGREP";"S";"0222";"      HJOU_SJRCREP = HJOU_SJRCREP + HABS_MOTINBR"
"SGREP";"S";"0223";"   FINSI"
"SGREP";"S";"0224";"* Init"
"SGREP";"S";"0225";"   SI HABS_MOTIF = ""ZCREP"""
"SGREP";"S";"0226";"      HJOU_SJRCREP = HABS_MOTINBR"
"SGREP";"S";"0227";"   FINSI"
"SGREP";"S";"0228";"FINPOUR"
"SGREP";"S";"0229";"*"
"SGREP";"S";"0230";"* Solde >>"
"SGREP";"S";"0231";"HJOU_SJRSREP = HJOU_SJRDREP - HJOU_SJRCREP"
"SGREP";"S";"0232";"*"
"SGREP";"S";"0233";"***** DEB : Gestion du pris en attente >>"
"SGREP";"S";"0234";"*"
"SGREP";"S";"0235";"POUR WACTIVITES"
"SGREP";"S";"0236";"   SI WABS_ANNUL = ""0"""
"SGREP";"S";"0237";"      SI LOCA_FERI <> 1"
"SGREP";"S";"0238";"         SI HJOU_IJQPRETHEJ > 0.00"
"SGREP";"S";"0239";"*"
"SGREP";"S";"0240";"* PERCO"
"SGREP";"S";"0241";"            SI WABS_MOTIF = ""YPERREP"""
"SGREP";"S";"0242";"               LOCA_PERCOW = LOCA_PERCOW + WABS_MOTINBR"
"SGREP";"S";"0243";"            FINSI"
"SGREP";"S";"0244";"*"
"SGREP";"S";"0245";"            SI WABS_MOTIF = PARD_SDIVMREP"
"SGREP";"S";"0246";"* Gestion de la valorisation >>"
"SGREP";"S";"0247";"               SI WABS_VALORIS = ""J"""
"SGREP";"S";"0248";"                  SI PROF_ABSENM = 0"
"SGREP";"S";"0249";"                  OU PROF_ABSENS = 0"
"SGREP";"S";"0250";"                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SGREP";"S";"0251";"                  SINON"
"SGREP";"S";"0252";"                     LOCA_PRISW = 1"
"SGREP";"S";"0253";"                  FINSI"
"SGREP";"S";"0254";"               SINON"
"SGREP";"S";"0255";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SGREP";"S";"0256";"               FINSI"
"SGREP";"S";"0257";"            FINSI"
"SGREP";"S";"0258";"         FINSI"
"SGREP";"S";"0259";"      FINSI"
"SGREP";"S";"0260";"   FINSI"
"SGREP";"S";"0261";"FINPOUR"
"SGREP";"S";"0262";"*"
"SGREP";"S";"0263";"SI LOCA_PRISW > 1"
"SGREP";"S";"0264";"   LOCA_PRISW = 1"
"SGREP";"S";"0265";"FINSI"
"SGREP";"S";"0266";"*"
"SGREP";"S";"0267";"SI LOCA_PRISW > 0"
"SGREP";"S";"0268";"   HJOU_SJRCREPW = HJOU_SJRCREPW + LOCA_PRISW"
"SGREP";"S";"0269";"FINSI"
"SGREP";"S";"0270";"SI LOCA_PERCOW > 0"
"SGREP";"S";"0271";"   HJOU_SJRCREPW = HJOU_SJRCREPW + LOCA_PERCOW"
"SGREP";"S";"0272";"FINSI"
"SGREP";"S";"0273";"*"
"SGREP";"S";"0274";"* Solde >>"
"SGREP";"S";"0275";"HJOU_SJRSREP = HJOU_SJRDREP - HJOU_SJRCREP"
"SGREP";"S";"0276";"*"
"SGREP";"S";"0277";"***** Gestion des anomalies >>"
"SGREP";"S";"0278";"*"
"SGREP";"S";"0279";"SI LOCA_MOT = 1"
"SGREP";"S";"0280";"* Si droit ?"
"SGREP";"S";"0281";"   SI LOCA_DROIT <> 1"
"SGREP";"S";"0282";"      ANOMALIE 232"
"SGREP";"S";"0283";"      SI TEMP_CNMOTIF = PARD_SDIVMREP"
"SGREP";"S";"0284";"         TEMP_CNRETOUR = 2"
"SGREP";"S";"0285";"         TEMP_CNMESS = 232"
"SGREP";"S";"0286";"      FINSI"
"SGREP";"S";"0287";"   FINSI"
"SGREP";"S";"0288";"* Si solde négatif ?"
"SGREP";"S";"0289";"   SI HJOU_SJRSREP < 0"
"SGREP";"S";"0290";"      ANOMALIE 233"
"SGREP";"S";"0291";"      SI TEMP_CNMOTIF = PARD_SDIVMREP"
"SGREP";"S";"0292";"      OU TEMP_CNMOTIF = ""YPERREP"""
"SGREP";"S";"0293";"         TEMP_CNRETOUR = 2"
"SGREP";"S";"0294";"         TEMP_CNMESS = 233"
"SGREP";"S";"0295";"      FINSI"
"SGREP";"S";"0296";"   FINSI"
"SGREP";"S";"0297";"*"
"SGREP";"S";"0298";"FINSI"
"SGREP";"S";"0299";"*"
"SGREP";"S";"0300";"SI LOCA_PERCO > 0"
"SGREP";"S";"0301";"* Si solde négatif ?"
"SGREP";"S";"0302";"   SI HJOU_SJRSREP < 0"
"SGREP";"S";"0303";"      ANOMALIE 233"
"SGREP";"S";"0304";"      SI TEMP_CNMOTIF = PARD_SDIVMREP"
"SGREP";"S";"0305";"      OU TEMP_CNMOTIF = ""YPERREP"""
"SGREP";"S";"0306";"         TEMP_CNRETOUR = 2"
"SGREP";"S";"0307";"         TEMP_CNMESS = 233"
"SGREP";"S";"0308";"      FINSI"
"SGREP";"S";"0309";"   FINSI"
"SGREP";"S";"0310";"FINSI"
"SGREP";"S";"0311";"*"
"SGREP";"S";"0312";"***** Solde prévisionnel >>"
"SGREP";"S";"0313";"*"
"SGREP";"S";"0314";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGREP";"S";"0315";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SGREP";"S";"0316";"      SI HJOU_SJQFINC = 1"
"SGREP";"S";"0317";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGREP";"S";"0318";"         LOCA_DATEFU = TEMP_DXFINPER"
"SGREP";"S";"0319";"      FINSI"
"SGREP";"S";"0320";"   FINSI"
"SGREP";"S";"0321";"FINSI"
"SGREP";"S";"0322";"*"
"SGREP";"S";"0323";"SI TEMP_DATSUI = LOCA_DATEFU"
"SGREP";"S";"0324";"* JJA - 13/06/2025 - Pris prèv."
"SGREP";"S";"0325";"   EMPL_SEQCREP = HJOU_SJRCREP + HJOU_SJRCREPW"
"SGREP";"S";"0326";"*"
"SGREP";"S";"0327";"   EMPL_SEQSPREP = HJOU_SJRSREP - HJOU_SJRCREPW"
"SGREP";"S";"0328";"FINSI"
"SGREP";"S";"0329";"*"
"SGREP";"S";"0330";"FIN"
"SGREP";"S";"0331";"*"
"SGREP";"S";"0332";"* Calcul nombre de jour de présence en calendaire sur l'année"
"SGREP";"S";"0333";"*"
"SGREP";"S";"0334";"PROC NBJCAL"
"SGREP";"S";"0335";"*"
"SGREP";"S";"0336";"   DEF LOCA_DEBX D"
"SGREP";"S";"0337";"   LOCA_DEBX = "" """
"SGREP";"S";"0338";"   DEF LOCA_FINX D"
"SGREP";"S";"0339";"   LOCA_FINX = "" """
"SGREP";"S";"0340";"*"
"SGREP";"S";"0341";"   LOCA_NBJI = 0"
"SGREP";"S";"0342";"*"
"SGREP";"S";"0343";"* Défini les dates d'analyses"
"SGREP";"S";"0344";"   SI CTRA_DATDEB < LOCA_DEB"
"SGREP";"S";"0345";"      LOCA_DEBX = LOCA_DEB"
"SGREP";"S";"0346";"   SINON"
"SGREP";"S";"0347";"      LOCA_DEBX = CTRA_DATDEB"
"SGREP";"S";"0348";"   FINSI"
"SGREP";"S";"0349";"   SI CTRA_DATFIN > LOCA_FIN"
"SGREP";"S";"0350";"      LOCA_FINX = LOCA_FIN"
"SGREP";"S";"0351";"   SINON"
"SGREP";"S";"0352";"      LOCA_FINX = CTRA_DATFIN"
"SGREP";"S";"0353";"   FINSI"
"SGREP";"S";"0354";"*"
"SGREP";"S";"0355";"   DATDIFF LOCA_DEBX 12 LOCA_FINX 12"
"SGREP";"S";"0356";"   LOCA_NBJI = TEMP_NXJOUR"
"SGREP";"S";"0357";"*"
"SGREP";"S";"0358";"FINPROC"
"SGREP";"S";"0359";"*"
"SGREP";"S";"0360";"* Gestion arrondis"
"SGREP";"S";"0361";"PROC ARRONDI"
"SGREP";"S";"0362";"*"
"SGREP";"S";"0363";"*DEF LOCA_VALAROND N6.2"
"SGREP";"S";"0364";"*LOCA_VALAROND = 0"
"SGREP";"S";"0365";"*DEF LOCA_RESTE N6.2"
"SGREP";"S";"0366";"*LOCA_RESTE = 0"
"SGREP";"S";"0367";"*DEF LOCA_ENTIER N6.2"
"SGREP";"S";"0368";"*LOCA_ENTIER = 0"
"SGREP";"S";"0369";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGREP";"S";"0370";"*DEF LOCA_TYPARROND N2"
"SGREP";"S";"0371";"*LOCA_TYPARROND = 0"
"SGREP";"S";"0372";"*"
"SGREP";"S";"0373";"* Arrondi à l'entier supérieur >>"
"SGREP";"S";"0374";"   SI LOCA_TYPARROND = 1"
"SGREP";"S";"0375";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGREP";"S";"0376";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGREP";"S";"0377";"      SI LOCA_RESTE > 0"
"SGREP";"S";"0378";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGREP";"S";"0379";"      FINSI"
"SGREP";"S";"0380";"      LOCA_VALAROND = LOCA_ENTIER"
"SGREP";"S";"0381";"   FINSI"
"SGREP";"S";"0382";"*"
"SGREP";"S";"0383";"* Arrondi à demi supérieur >>"
"SGREP";"S";"0384";"   SI LOCA_TYPARROND = 2"
"SGREP";"S";"0385";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGREP";"S";"0386";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGREP";"S";"0387";"      SI LOCA_RESTE > 0.5"
"SGREP";"S";"0388";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGREP";"S";"0389";"      SINON"
"SGREP";"S";"0390";"         SI LOCA_RESTE > 0"
"SGREP";"S";"0391";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGREP";"S";"0392";"         FINSI"
"SGREP";"S";"0393";"      FINSI"
"SGREP";"S";"0394";"      LOCA_VALAROND = LOCA_ENTIER"
"SGREP";"S";"0395";"   FINSI"
"SGREP";"S";"0396";"*"
"SGREP";"S";"0397";"* Arrondi à demi le plus proche >>"
"SGREP";"S";"0398";"   SI LOCA_TYPARROND = 3"
"SGREP";"S";"0399";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGREP";"S";"0400";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGREP";"S";"0401";"      SI LOCA_RESTE >= 0.75"
"SGREP";"S";"0402";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGREP";"S";"0403";"      SINON"
"SGREP";"S";"0404";"         SI LOCA_RESTE >= 0.25"
"SGREP";"S";"0405";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGREP";"S";"0406";"         FINSI"
"SGREP";"S";"0407";"      FINSI"
"SGREP";"S";"0408";"      LOCA_VALAROND = LOCA_ENTIER"
"SGREP";"S";"0409";"   FINSI"
"SGREP";"S";"0410";"*"
"SGREP";"S";"0411";"FINPROC"
"SGREP";"S";"0412";"*"
