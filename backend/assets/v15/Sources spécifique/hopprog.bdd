"SHSUPPDIM";"S";"0396";"   FINSI"
"SHSUPPDIM";"S";"0397";"FINSI"
"SHSUPPDIM";"S";"0398";"*"
"SHSUPPDIM";"S";"0399";"* Exclure porteur de TEVA"
"SHSUPPDIM";"S";"0400";"SI HJOU_SJIINTEVA = ""1"""
"SHSUPPDIM";"S";"0401";"   LOCA_DROIT = 0"
