"SACQCPAN";"S";"0133";"   SI HJOU_SJQCATEGOR = ""C"""
"SACQCPAN";"S";"0134";"   OU HJOU_SJQCATEGOR = ""E"""
"SACQCPAN";"S";"0135";"*"
