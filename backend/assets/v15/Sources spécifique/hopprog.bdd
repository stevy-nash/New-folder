"IEXCED";"S";"0008";"*"
"IEXCED";"S";"0009";"* Créé par : Cellule Industrialisation"
"IEXCED";"S";"0010";"* Date     : 03/09/2009"
"IEXCED";"S";"0011";"* Version  : 1"
"IEXCED";"S";"0012";"*"
"IEXCED";"S";"0013";"*----------------------------------------------------------------------"
"IEXCED";"S";"0014";"*"
"IEXCED";"S";"0015";"*"
"IEXCED";"S";"0016";"* Rôle : Heures jour excedentaires"
"IEXCED";"S";"0017";"*"
"IEXCED";"S";"0018";"*"
"IEXCED";"S";"0019";"*"
"IEXCED";"S";"0020";"*"
"IEXCED";"S";"0021";"* Implémentation des données industrielles"
"IEXCED";"S";"0022";"*"
"IEXCED";"S";"0023";"*----------------------------------------------------------------------"
"IEXCED";"S";"0024";"*"
"IEXCED";"S";"0025";"* Modifiée par : Cellule Industrialisation"
"IEXCED";"S";"0026";"* Date         : JJ/MM/AAAA"
"IEXCED";"S";"0027";"* Objet        :"
"IEXCED";"S";"0028";"*"
"IEXCED";"S";"0029";"***********************************************************************"
"IEXCED";"S";"0030";"*"
"IEXCED";"S";"0031";"DEBDICO"
"IEXCED";"S";"0032";"   HJOU_IJQHEXCED1;N;T6,2;I;;;    56789;;;V2;""Heures excédentaires entrée"";"
"IEXCED";"S";"0033";"   HJOU_IJQHEXCED2;N;T6,2;I;;;    56789;;;V2;""Heures excédentaires sortie"";"
"IEXCED";"S";"0034";"   HJOU_IJQDEBORDT;N;T6,2;I;;;    56789;;;V2;""Présence badgée hors plage totale"";"
"IEXCED";"S";"0035";"FINDICO"
"IEXCED";"S";"0036";"*"
"IEXCED";"S";"0037";"DEBANO"
"IEXCED";"S";"0038";"   110;5;""Heures excédentaires en entrée"";"
"IEXCED";"S";"0039";"   111;5;""Heures excédentaires en sortie"";"
"IEXCED";"S";"0040";"FINANO"
"IEXCED";"S";"0041";"*"
"IEXCED";"S";"0042";"* Déclaration des donnees locales"
"IEXCED";"S";"0043";"*"
"IEXCED";"S";"0044";"SI HJOU_DATE <= TEMP_DATJOU"
"IEXCED";"S";"0045";"   SI HJOU_IJQPRESBAJ > 0"
"IEXCED";"S";"0046";"* debordement en entree"
"IEXCED";"S";"0047";"      PLAGE ""01"""
"IEXCED";"S";"0048";"      SI TEMP_TYPPLA <> "" """
"IEXCED";"S";"0049";"         ANALYSE_R TEMP_VALTRT1 TEMP_VALTRT2"
"IEXCED";"S";"0050";"         SI TEMP_HIPRE >= PROF_IPIVDEBOR1"
"IEXCED";"S";"0051";"            HJOU_IJQHEXCED1 = TEMP_HIPRE"
"IEXCED";"S";"0052";"            ANOMALIE 110"
"IEXCED";"S";"0053";"         FINSI"
"IEXCED";"S";"0054";"      FINSI"
"IEXCED";"S";"0055";"* debordement en sortie"
"IEXCED";"S";"0056";"      PLAGE ""02"""
"IEXCED";"S";"0057";"      SI TEMP_TYPPLA <> "" """
"IEXCED";"S";"0058";"         ANALYSE_R TEMP_VALTRT1 TEMP_VALTRT2"
"IEXCED";"S";"0059";"         SI TEMP_HIPRE >= PROF_IPIVDEBOR2"
"IEXCED";"S";"0060";"            HJOU_IJQHEXCED2 = TEMP_HIPRE"
"IEXCED";"S";"0061";"            ANOMALIE 111"
"IEXCED";"S";"0062";"         FINSI"
"IEXCED";"S";"0063";"      FINSI"
"IEXCED";"S";"0064";"* totalisation du d?bordement"
"IEXCED";"S";"0065";"      HJOU_IJQDEBORDT = HJOU_IJQHEXCED1 + HJOU_IJQHEXCED2"
"IEXCED";"S";"0066";"   FINSI"
"IEXCED";"S";"0067";"FINSI"
"IEXCED";"S";"0068";"FIN"
