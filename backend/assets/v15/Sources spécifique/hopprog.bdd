"SHSUPPDIM";"S";"0374";"* Exclu journaliste"
"SHSUPPDIM";"S";"0375";"   SI HJOU_SJQCATEGOR <> ""J"""
"SHSUPPDIM";"S";"0376";"* Exclu metier de publicité"
"SHSUPPDIM";"S";"0377";"      SI HJOU_SJQSOCIETE <> ""PU"""
"SHSUPPDIM";"S";"0378";"         SI LOCA_GESTHS = ""2"""
"SHSUPPDIM";"S";"0379";"         OU LOCA_GESTHS = ""3"""
"SHSUPPDIM";"S";"0380";"         OU LOCA_GESTHS = ""4"""
"SHSUPPDIM";"S";"0381";"            LOCA_DROIT = 1"
