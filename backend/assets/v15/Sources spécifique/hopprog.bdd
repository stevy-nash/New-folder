"SACQCPAN";"S";"0089";"SI HJOU_SECTORI(1:3) <> ""DIN"""
"SACQCPAN";"S";"0090";"   SI HJOU_SECTORI(1:3) <> ""DRE"""
"SACQCPAN";"S";"0091";"      SI HJOU_SECTORI(1:3) <> ""RED"""
"SACQCPAN";"S";"0092";"         SI HJOU_SECTORI(1:3) <> ""TVR"""
"SACQCPAN";"S";"0093";"            LOCA_LOT = 2"
"SACQCPAN";"S";"0094";"         FINSI"
"SACQCPAN";"S";"0095";"      FINSI"
"SACQCPAN";"S";"0096";"   FINSI"
"SACQCPAN";"S";"0097";"FINSI"
"SACQCPAN";"S";"0098";"*"
"SACQCPAN";"S";"0099";"* Init"
"SACQCPAN";"S";"0100";"SI HJOU_DATE < CONF_SDIDATDEM"
"SACQCPAN";"S";"0101";"   HJOU_SJRDATANCC = "" """
