"SFERIE";"S";"0525";"*"
"SFERIE";"S";"0526";"****************************************************************************************************"
"SFERIE";"S";"0527";"***********                          PROCEDURE                                        **************"
"SFERIE";"S";"0528";"****************************************************************************************************"
"SFERIE";"S";"0529";"*"
"SFERIE";"S";"0530";"* Gestion des motifs en heures"
"SFERIE";"S";"0531";"PROC CALC1"
"SFERIE";"S";"0532";"*"
"SFERIE";"S";"0533";"   LOCA_ABSFER = 0"
"SFERIE";"S";"0534";"*"
"SFERIE";"S";"0535";"   SI LOCA_MOTE < LOCA_DEBFER"
"SFERIE";"S";"0536";"      SI LOCA_MOTS > LOCA_DEBFER"
"SFERIE";"S";"0537";"         LOCA_MOTE = LOCA_DEBFER"
"SFERIE";"S";"0538";"      FINSI"
"SFERIE";"S";"0539";"   FINSI"
"SFERIE";"S";"0540";"*"
"SFERIE";"S";"0541";"   SI LOCA_MOTS > LOCA_FINFER"
"SFERIE";"S";"0542";"      SI LOCA_MOTE < LOCA_FINFER"
"SFERIE";"S";"0543";"         LOCA_MOTS = LOCA_FINFER"
"SFERIE";"S";"0544";"      FINSI"
"SFERIE";"S";"0545";"   FINSI"
"SFERIE";"S";"0546";"*"
"SFERIE";"S";"0547";"   SI LOCA_MOTE >= LOCA_DEBFER"
"SFERIE";"S";"0548";"      SI LOCA_MOTS <= LOCA_FINFER"
"SFERIE";"S";"0549";"         LOCA_ABSFER = LOCA_MOTS - LOCA_MOTE"
"SFERIE";"S";"0550";"      FINSI"
"SFERIE";"S";"0551";"   FINSI"
"SFERIE";"S";"0552";"*"
"SFERIE";"S";"0553";"   HJOU_IJQHJFTRAV = HJOU_IJQHJFTRAV + LOCA_ABSFER"
"SFERIE";"S";"0554";"*"
"SFERIE";"S";"0555";"FINPROC"
"SFERIE";"S";"0556";"*"
"SFERIE";"S";"0557";"* Gestion des mouvements la veille/lendemain"
"SFERIE";"S";"0558";"PROC CALC2"
"SFERIE";"S";"0559";"*"
"SFERIE";"S";"0560";"   LOCA_FERIT = 0"
"SFERIE";"S";"0561";"* Init"
"SFERIE";"S";"0562";"   LOCA_DEBFER = 0"
"SFERIE";"S";"0563";"   LOCA_FINFER = 36.00"
"SFERIE";"S";"0564";"*"
"SFERIE";"S";"0565";"   SI LOCA_MVTE < LOCA_DEBFER"
"SFERIE";"S";"0566";"      SI LOCA_MVTS > LOCA_DEBFER"
"SFERIE";"S";"0567";"         LOCA_MVTE = LOCA_DEBFER"
"SFERIE";"S";"0568";"      FINSI"
"SFERIE";"S";"0569";"   FINSI"
"SFERIE";"S";"0570";"*"
"SFERIE";"S";"0571";"   SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0572";"      SI LOCA_MVTE < LOCA_FINFER"
"SFERIE";"S";"0573";"         LOCA_MVTS = LOCA_FINFER"
"SFERIE";"S";"0574";"      FINSI"
"SFERIE";"S";"0575";"   FINSI"
"SFERIE";"S";"0576";"*"
"SFERIE";"S";"0577";"   SI LOCA_MVTE >= LOCA_DEBFER"
"SFERIE";"S";"0578";"      SI LOCA_MVTS <= LOCA_FINFER"
"SFERIE";"S";"0579";"         LOCA_FERIT = LOCA_MVTS - LOCA_MVTE"
"SFERIE";"S";"0580";"      FINSI"
"SFERIE";"S";"0581";"   FINSI"
"SFERIE";"S";"0582";"*"
"SFERIE";"S";"0583";"   SI LOCA_RETIRE = 1"
"SFERIE";"S";"0584";"      LOCA_FERI = LOCA_FERI - LOCA_FERIT"
"SFERIE";"S";"0585";"   SINON"
"SFERIE";"S";"0586";"      LOCA_FERI = LOCA_FERI + LOCA_FERIT"
"SFERIE";"S";"0587";"   FINSI"
"SFERIE";"S";"0588";"*"
"SFERIE";"S";"0589";"* Ré-Init par défaut >>"
"SFERIE";"S";"0590";"   LOCA_DEBFER = 0"
"SFERIE";"S";"0591";"   LOCA_FINFER = 24.00"
"SFERIE";"S";"0592";"*"
"SFERIE";"S";"0593";"FINPROC"
