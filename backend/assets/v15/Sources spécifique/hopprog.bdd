"SCONSCPCH";"S";"1399";"*"
"SCONSCPCH";"S";"1400";"****** Gestion des anomalies ***********************************************************************"
"SCONSCPCH";"S";"1401";"*"
"SCONSCPCH";"S";"1402";"   SI LOCA_CPR > 0"
"SCONSCPCH";"S";"1403";"      SI HJOU_SJRSPREP1 < 0"
"SCONSCPCH";"S";"1404";"         ANOMALIE 275"
"SCONSCPCH";"S";"1405";"         SI TEMP_CNMOTIF = PARD_IDIVMCOREL"
"SCONSCPCH";"S";"1406";"            TEMP_CNRETOUR = 2"
"SCONSCPCH";"S";"1407";"            TEMP_CNMESS = 275"
"SCONSCPCH";"S";"1408";"         FINSI"
"SCONSCPCH";"S";"1409";"      FINSI"
"SCONSCPCH";"S";"1410";"   FINSI"
"SCONSCPCH";"S";"1411";"*"
"SCONSCPCH";"S";"1412";"   SI LOCA_CFRAC > 0"
"SCONSCPCH";"S";"1413";"   OU LOCA_CMDF > 0"
"SCONSCPCH";"S";"1414";"   OU LOCA_CSUP > 0"
"SCONSCPCH";"S";"1415";"   OU LOCA_CPANC > 0"
"SCONSCPCH";"S";"1416";"   OU LOCA_CP > 0"
"SCONSCPCH";"S";"1417";"*   OU LOCA_CPA > 0"
"SCONSCPCH";"S";"1418";"      SI HJOU_IJRSCOPRIN < 0"
"SCONSCPCH";"S";"1419";"         ANOMALIE 198"
"SCONSCPCH";"S";"1420";"         SI TEMP_CNMOTIF = PARD_SDIVMCOPRI"
"SCONSCPCH";"S";"1421";"            TEMP_CNRETOUR = 2"
"SCONSCPCH";"S";"1422";"            TEMP_CNMESS = 198"
"SCONSCPCH";"S";"1423";"         FINSI"
"SCONSCPCH";"S";"1424";"      FINSI"
"SCONSCPCH";"S";"1425";"   FINSI"
"SCONSCPCH";"S";"1426";"*"
"SCONSCPCH";"S";"1427";"   SI LOCA_CPA > 0"
"SCONSCPCH";"S";"1428";"* Alerte prise de CP anticipé"
"SCONSCPCH";"S";"1429";"      ANOMALIE 199"
"SCONSCPCH";"S";"1430";"      SI TEMP_CNMOTIF = PARD_IDIVMCOANT"
"SCONSCPCH";"S";"1431";"         TEMP_CNRETOUR = 1"
"SCONSCPCH";"S";"1432";"         TEMP_CNMESS = 199"
"SCONSCPCH";"S";"1433";"      FINSI"
"SCONSCPCH";"S";"1434";"* Solde insuffisant"
"SCONSCPCH";"S";"1435";"      SI HJOU_IJRSACQCP < 0"
"SCONSCPCH";"S";"1436";"         ANOMALIE 200"
"SCONSCPCH";"S";"1437";"         SI TEMP_CNMOTIF = PARD_IDIVMCOANT"
"SCONSCPCH";"S";"1438";"            TEMP_CNRETOUR = 2"
"SCONSCPCH";"S";"1439";"            TEMP_CNMESS = 200"
"SCONSCPCH";"S";"1440";"         FINSI"
"SCONSCPCH";"S";"1441";"      FINSI"
"SCONSCPCH";"S";"1442";"* Alerte prise de CPA alors que reste CP"
"SCONSCPCH";"S";"1443";"      SI HJOU_IJRSCOPRIN > 0"
"SCONSCPCH";"S";"1444";"         ANOMALIE 229"
"SCONSCPCH";"S";"1445";"         SI TEMP_CNMOTIF = PARD_IDIVMCOANT"
"SCONSCPCH";"S";"1446";"            TEMP_CNRETOUR = 2"
"SCONSCPCH";"S";"1447";"            TEMP_CNMESS = 229"
"SCONSCPCH";"S";"1448";"         FINSI"
"SCONSCPCH";"S";"1449";"      FINSI"
"SCONSCPCH";"S";"1450";"   FINSI"
