"SGTTFJ";"S";"0469";"   SI CTRA_SCISOCIETE = ""PE"""
"SGTTFJ";"S";"0470";"      LOCA_DRTTI = PARD_SDIRTFJPE"
"SGTTFJ";"S";"0471";"   FINSI"
"SGTTFJ";"S";"0472";"*"
"SGTTFJ";"S";"0473";"* Société PO >>"
"SGTTFJ";"S";"0474";"   SI CTRA_SCISOCIETE = ""PO"""
"SGTTFJ";"S";"0475";"      LOCA_DRTTI = PARD_SDIRTFJPO"
"SGTTFJ";"S";"0476";"   FINSI"
"SGTTFJ";"S";"0477";"*"
"SGTTFJ";"S";"0478";"* Société RC >>"
"SGTTFJ";"S";"0479";"   SI CTRA_SCISOCIETE = ""RC"""
"SGTTFJ";"S";"0480";"      LOCA_DRTTI = PARD_SDIRTFJRC"
"SGTTFJ";"S";"0481";"   FINSI"
"SGTTFJ";"S";"0482";"*"
"SGTTFJ";"S";"0483";"* Société VH >>"
"SGTTFJ";"S";"0484";"   SI CTRA_SCISOCIETE = ""VH"""
"SGTTFJ";"S";"0485";"      LOCA_DRTTI = PARD_SDIRTFJVH"
"SGTTFJ";"S";"0486";"      SI HJOU_SJQCATEGOR = ""J"""
"SGTTFJ";"S";"0487";"         LOCA_DRTTI = PARD_SDIRTFJVHJ"
"SGTTFJ";"S";"0488";"      FINSI"
"SGTTFJ";"S";"0489";"   FINSI"
"SGTTFJ";"S";"0490";"*"
"SGTTFJ";"S";"0491";"* Société YR >>"
"SGTTFJ";"S";"0492";"   SI CTRA_SCISOCIETE = ""YR"""
"SGTTFJ";"S";"0493";"      LOCA_DRTTI = PARD_SDIRTFJYR"
"SGTTFJ";"S";"0494";"   FINSI"
"SGTTFJ";"S";"0495";"*"
"SGTTFJ";"S";"0496";"* Défini les dates d'analyses"
"SGTTFJ";"S";"0497";"   SI CTRA_DATDEB < LOCA_DEB"
"SGTTFJ";"S";"0498";"      LOCA_DEBX = LOCA_DEB"
"SGTTFJ";"S";"0499";"   SINON"
"SGTTFJ";"S";"0500";"      LOCA_DEBX = CTRA_DATDEB"
"SGTTFJ";"S";"0501";"   FINSI"
"SGTTFJ";"S";"0502";"   SI CTRA_DATFIN > LOCA_FIN"
"SGTTFJ";"S";"0503";"      LOCA_FINX = LOCA_FIN"
"SGTTFJ";"S";"0504";"   SINON"
"SGTTFJ";"S";"0505";"      LOCA_FINX = CTRA_DATFIN"
"SGTTFJ";"S";"0506";"   FINSI"
"SGTTFJ";"S";"0507";"*"
"SGTTFJ";"S";"0508";"   DATDIFF LOCA_DEBX 12 LOCA_FINX 12"
"SGTTFJ";"S";"0509";"   LOCA_NBJI = TEMP_NXJOUR"
"SGTTFJ";"S";"0510";"*"
"SGTTFJ";"S";"0511";"   LOCA_COEFFI = LOCA_NBJI / 365"
"SGTTFJ";"S";"0512";"   SI LOCA_COEFFI > 1"
"SGTTFJ";"S";"0513";"      LOCA_COEFFI = 1"
"SGTTFJ";"S";"0514";"   FINSI"
"SGTTFJ";"S";"0515";"   LOCA_DRTTI = LOCA_DRTTI * LOCA_COEFFI"
"SGTTFJ";"S";"0516";"*"
"SGTTFJ";"S";"0517";"FINPROC"
