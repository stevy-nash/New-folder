"SGDH";"S";"0076";"LOCA_ABATJ = 0"
"SGDH";"S";"0077";"DEF LOCA_SEUIL N4"
"SGDH";"S";"0078";"LOCA_SEUIL = 0"
"SGDH";"S";"0079";"*"
"SGDH";"S";"0080";"DEF LOCA_VALAROND N6.2"
"SGDH";"S";"0081";"LOCA_VALAROND = 0"
"SGDH";"S";"0082";"DEF LOCA_RESTE N6.2"
"SGDH";"S";"0083";"LOCA_RESTE = 0"
"SGDH";"S";"0084";"DEF LOCA_ENTIER N6.2"
"SGDH";"S";"0085";"LOCA_ENTIER = 0"
"SGDH";"S";"0086";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGDH";"S";"0087";"DEF LOCA_TYPARROND N2"
"SGDH";"S";"0088";"LOCA_TYPARROND = 2"
"SGDH";"S";"0089";"*"
"SGDH";"S";"0090";"DEF LOCA_DATE D"
"SGDH";"S";"0091";"LOCA_DATE(5:4) = ""0101"""
"SGDH";"S";"0092";"DEF LOCA_DATEFU D"
"SGDH";"S";"0093";"LOCA_DATEFU(5:4) = ""0101"""
"SGDH";"S";"0094";"DEF LOCA_ANNEE N4"
"SGDH";"S";"0095";"LOCA_ANNEE << TEMP_DATJOU(1:4)"
"SGDH";"S";"0096";"LOCA_DATE(1:4) << LOCA_ANNEE"
"SGDH";"S";"0097";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SGDH";"S";"0098";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SGDH";"S";"0099";"*"
"SGDH";"S";"0100";"POUR ACTIVITES"
