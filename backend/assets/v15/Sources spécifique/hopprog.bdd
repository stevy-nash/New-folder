"SCONTR";"S";"0288";"*Si repos la veille"
"SCONTR";"S";"0289";"* LIREVALPRE LOCA_LENDREP HJOU_IJQNBADGEA"
"SCONTR";"S";"0290";"         LIREVALPRE LOCA_LENDREP2 HJOU_IJQTTEFFEJ"
"SCONTR";"S";"0291";"         SI LOCA_LENDREP2 = 0"
"SCONTR";"S";"0292";"* SI HJOU_IJQPRESBAJ > 0"
"SCONTR";"S";"0293";"            SI HJOU_IJQTTEFFEJ > 0.00"
"SCONTR";"S";"0294";"*"
"SCONTR";"S";"0295";"               HJOU_IJRREP35H = HJOU_IJRREP35H + LOCA_24"
"SCONTR";"S";"0296";"               HJOU_IJRREP35H = HJOU_IJRREP35H + HJOU_IJQPRBADGV"
"SCONTR";"S";"0297";"*"
"SCONTR";"S";"0298";"               SI HJOU_IJRREP35H < LOCA_35"
"SCONTR";"S";"0299";"                  HJOU_IJRINDANO = HJOU_IJRINDANO + 2"
"SCONTR";"S";"0300";"               SINON"
"SCONTR";"S";"0301";"                  HJOU_IJRINDANO = 1"
"SCONTR";"S";"0302";"               FINSI"
"SCONTR";"S";"0303";"            SINON"
"SCONTR";"S";"0304";"               HJOU_IJRREP35H = HJOU_IJRREP35H + LOCA_24"
"SCONTR";"S";"0305";"            FINSI"
"SCONTR";"S";"0306";"         SINON"
"SCONTR";"S";"0307";"* SI HJOU_IJQPRESBAJ = 0"
