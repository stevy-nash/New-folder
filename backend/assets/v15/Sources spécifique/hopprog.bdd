"SCONSCPCH";"S";"1361";"                     SI LOCA_SOLDCET > PARD_SDIPLCETES"
"SCONSCPCH";"S";"1362";"                        LOCA_SOLDCET = LOCA_SOLDCET - PARD_SDIPLCETES"
"SCONSCPCH";"S";"1363";"                        LOCA_YCETCP = LOCA_YCETCP - LOCA_SOLDCET"
"SCONSCPCH";"S";"1364";"                     FINSI"
"SCONSCPCH";"S";"1365";"                  FINSI"
"SCONSCPCH";"S";"1366";"               FINSI"
"SCONSCPCH";"S";"1367";"*"
"SCONSCPCH";"S";"1368";"               SI LOCA_YCETCP > 0"
"SCONSCPCH";"S";"1369";"                  HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + LOCA_YCETCP"
"SCONSCPCH";"S";"1370";"                  HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"SCONSCPCH";"S";"1371";"                  ENLEVER ""YCETCPA"""
"SCONSCPCH";"S";"1372";"                  AJOUTER ""YCETCPA"" ""N"" LOCA_YCETCP"
"SCONSCPCH";"S";"1373";"               FINSI"
