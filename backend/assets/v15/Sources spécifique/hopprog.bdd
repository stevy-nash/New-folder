"SHSUPPDIM2";"S";"1765";"      LOCA_FINNUIT = PROF_FINNUIT"
"SHSUPPDIM2";"S";"1766";"*"
"SHSUPPDIM2";"S";"1767";"      SI LOCA_MOTE < PROF_FINNUIT"
"SHSUPPDIM2";"S";"1768";"         LOCA_DEBNUIT = 0"
