"SGRTTJ";"S";"0606";"                  SI LOCA_SOLDCET > PARD_SDIPLCETES"
"SGRTTJ";"S";"0607";"                     LOCA_SOLDCET = LOCA_SOLDCET - PARD_SDIPLCETES"
"SGRTTJ";"S";"0608";"                     LOCA_YCETRT = LOCA_YCETRT - LOCA_SOLDCET"
"SGRTTJ";"S";"0609";"                  FINSI"
"SGRTTJ";"S";"0610";"               FINSI"
"SGRTTJ";"S";"0611";"            FINSI"
"SGRTTJ";"S";"0612";"*"
"SGRTTJ";"S";"0613";"            SI LOCA_YCETRT > 0"
"SGRTTJ";"S";"0614";"               HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + LOCA_YCETRT"
"SGRTTJ";"S";"0615";"               HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"SGRTTJ";"S";"0616";"               ENLEVER ""YCETRTA"""
"SGRTTJ";"S";"0617";"               AJOUTER ""YCETRTA"" ""N"" LOCA_YCETRT"
"SGRTTJ";"S";"0618";"            FINSI"
"SGRTTJ";"S";"0619";"*"
"SGRTTJ";"S";"0620";"         FINSI"
"SGRTTJ";"S";"0621";"      FINSI"
"SGRTTJ";"S";"0622";"   FINSI"
"SGRTTJ";"S";"0623";"FINSI"
"SGRTTJ";"S";"0624";"*"
"SGRTTJ";"S";"0625";"* Soldes previsionnels"
"SGRTTJ";"S";"0626";"* Calcul des soldes"
"SGRTTJ";"S";"0627";"HJOU_IJRSNBJRTT = HJOU_IJRARTTJOU - HJOU_IJRCRTTJOU"
"SGRTTJ";"S";"0628";"*"
"SGRTTJ";"S";"0629";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGRTTJ";"S";"0630";"   SI HJOU_SJQFINC = 1"
"SGRTTJ";"S";"0631";"      SI CTRA_DATFIN < LOCA_DATEFU"
"SGRTTJ";"S";"0632";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGRTTJ";"S";"0633";"         LOCA_DATEFU = TEMP_DXFINPER"
"SGRTTJ";"S";"0634";"      FINSI"
"SGRTTJ";"S";"0635";"   SINON"
"SGRTTJ";"S";"0636";"      SI HJOU_SJQFINC = 1"
"SGRTTJ";"S";"0637";"         SI CTRA_DATFIN < LOCA_DATEFU2"
"SGRTTJ";"S";"0638";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGRTTJ";"S";"0639";"            LOCA_DATEFU2 = TEMP_DXFINPER"
"SGRTTJ";"S";"0640";"         FINSI"
"SGRTTJ";"S";"0641";"      FINSI"
"SGRTTJ";"S";"0642";"   FINSI"
"SGRTTJ";"S";"0643";"FINSI"
"SGRTTJ";"S";"0644";"***"
"SGRTTJ";"S";"0645";"SI TEMP_DATSUI = LOCA_DATEFU"
"SGRTTJ";"S";"0646";"* JJA - 13/06/2025 - Pris RTT prèv."
"SGRTTJ";"S";"0647";"   EMPL_SEQCRTT = HJOU_IJRCRTTJOU + HJOU_SJRCRTTW"
"SGRTTJ";"S";"0648";"*"
"SGRTTJ";"S";"0649";"   EMPL_IEQSPRTTJO = HJOU_IJRSNBJRTT - HJOU_SJRCRTTW"
"SGRTTJ";"S";"0650";"   EMPL_IEQSPDISP1 = HJOU_IJRARTTJOU"
"SGRTTJ";"S";"0651";"*"
"SGRTTJ";"S";"0652";"* JJA - 13/10/2025 - Blocage self >>"
"SGRTTJ";"S";"0653";"   SI HJOU_IJRSNBJRTT < 0"
"SGRTTJ";"S";"0654";"      SI TEMP_CNMOTIF = LOCA_MOTIF"
"SGRTTJ";"S";"0655";"      OU TEMP_CNMOTIF = ""YPERRTT"""
"SGRTTJ";"S";"0656";"         ANOMALIE 135"
"SGRTTJ";"S";"0657";"         TEMP_CNRETOUR = 2"
"SGRTTJ";"S";"0658";"         TEMP_CNMESS = 135"
"SGRTTJ";"S";"0659";"      FINSI"
"SGRTTJ";"S";"0660";"   FINSI"
"SGRTTJ";"S";"0661";"* JJA - 13/10/2025 - Blocage self <<"
"SGRTTJ";"S";"0662";"*"
"SGRTTJ";"S";"0663";"FINSI"
"SGRTTJ";"S";"0664";"**"
