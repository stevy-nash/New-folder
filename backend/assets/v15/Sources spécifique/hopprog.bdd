"IDISPJE";"S";"0040";"***********************************************************************"
"IDISPJE";"S";"0041";"*"
"IDISPJE";"S";"0042";"* Implémentation des données industrielles"
"IDISPJE";"S";"0043";"*"
"IDISPJE";"S";"0044";"DEBDICO"
"IDISPJE";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
