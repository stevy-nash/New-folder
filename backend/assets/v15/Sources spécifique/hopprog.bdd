"SGASTR";"S";"0360";"   SI LOCA_AST = 1"
"SGASTR";"S";"0361";"      HJOU_SJRJASTC = HJOU_SJRJASTC + 1"
"SGASTR";"S";"0362";"   SINON"
"SGASTR";"S";"0363";"      HJOU_SJRJASTC = 0"
"SGASTR";"S";"0364";"   FINSI"
"SGASTR";"S";"0365";"*"
