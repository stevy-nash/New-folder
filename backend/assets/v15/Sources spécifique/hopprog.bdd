"IHCOMP";"S";"0003";"* Règle : IHCOMP"
"IHCOMP";"S";"0004";"* Ordre : 6060"
"IHCOMP";"S";"0005";"* Titre : Calcul des heures complémentaires pour les temps partiels"
"IHCOMP";"S";"0006";"*"
"IHCOMP";"S";"0007";"*----------------------------------------------------------------------"
"IHCOMP";"S";"0008";"*"
"IHCOMP";"S";"0009";"* Créé par : Méthodes et outils"
"IHCOMP";"S";"0010";"* Date     : 23/09/2019"
"IHCOMP";"S";"0011";"* Version  : 1"
"IHCOMP";"S";"0012";"*"
"IHCOMP";"S";"0013";"*----------------------------------------------------------------------"
"IHCOMP";"S";"0014";"*"
"IHCOMP";"S";"0015";"*"
"IHCOMP";"S";"0016";"* Rôle : Calcul des heures complémentaires pour les temps partiels du lundi"
"IHCOMP";"S";"0017";"*        au dimanche (si travailleur de nuit, les heures sont toutes comptabilisées"
"IHCOMP";"S";"0018";"*        sur le dimanche)"
"IHCOMP";"S";"0019";"*         Adaptation de la règle IHSUPP avec ajout suivant :"
"IHCOMP";"S";"0020";"*"
"IHCOMP";"S";"0021";"*         Ajout de l'anomalie 225 en cas de dépassement d'heures de 10%"
"IHCOMP";"S";"0022";"*         du contrat"
"IHCOMP";"S";"0023";"*         + séparation en deux des règles IHSUPP et IHSUPPDIM afin de"
"IHCOMP";"S";"0024";"*         différencier les HS et les HC"
"IHCOMP";"S";"0025";"*         + évolution des HC avec ajout d'un compteur heures payées non majorées,"
"IHCOMP";"S";"0026";"*         HC taux 2 pour les heures payées et les heures à récupérer"
"IHCOMP";"S";"0027";"*"
"IHCOMP";"S";"0028";"*----------------------------------------------------------------------"
"IHCOMP";"S";"0029";"*"
"IHCOMP";"S";"0030";"* Modifiée par : Méthodes et outils"
"IHCOMP";"S";"0031";"* Date         : 30/06/2020"
"IHCOMP";"S";"0032";"* Objet        : Le test de CTRA_ICITAUX est remplacé par HJOU_IJITYPCTRA"
"IHCOMP";"S";"0033";"*                 car le taux du contrat est désormais copié dans JOU"
"IHCOMP";"S";"0034";"*"
"IHCOMP";"S";"0035";"***********************************************************************"
"IHCOMP";"S";"0036";"*"
"IHCOMP";"S";"0037";"* Implémentation des données industrielles"
"IHCOMP";"S";"0038";"*"
"IHCOMP";"S";"0039";"DEBDICO"
"IHCOMP";"S";"0040";"   HJOU_IJIGHSUPPM;O;Z1;X;;;123456789;L;;C2;""Régime HS"";"
"IHCOMP";"S";"0041";"   HJOU_IJRBHSMPAH;N;T6,2;I;;;    56789;;IJRBHSMPAH;V3;""Base HS"";"
"IHCOMP";"S";"0042";"   HJOU_IJQHS1MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 1 à récup."";"
"IHCOMP";"S";"0043";"   HJOU_IJQHS2MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 2 à récup."";"
"IHCOMP";"S";"0044";"   HJOU_IJRSHSMREH;N;T8,2;L;;;     6789;;IJRSHSMREH;V3;""Récupération HS/HC"";"
"IHCOMP";"S";"0045";"   HJOU_IJQHSNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures complémentaires"";"
"IHCOMP";"S";"0046";"   HJOU_IJQHSNMARE;N;T6,2;I;;;     6789;;;V3;""Heures complémentaires récupérables"";"
"IHCOMP";"S";"0047";"   HJOU_IJRTHEOCYC;N;T6,2;I;;;    56789;;IJRTHEOCYC;V3;""Theorie du cycle"";"
"IHCOMP";"S";"0048";"   HJOU_IJQHPAYEES;N;T6,2;I;;;    56789;;;V3;""Heures payées"";"
"IHCOMP";"S";"0049";"   HJOU_IJRBHPAYEE;N;T6,2;I;;;    56789;;IJRBHPAYEE;V3;""Base des heures payées"";"
"IHCOMP";"S";"0050";"   MOTI_IMIGHRPAYE;O;Z1;X;0;1;123456789;C;;C2;""Participe aux heures payées"";"
"IHCOMP";"S";"0051";"   EMPL_IEQSHSMRE1;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 1 HS à recup."";"
"IHCOMP";"S";"0052";"   EMPL_IEQSHSMRE2;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 2 HS à recup."";"
"IHCOMP";"S";"0053";"   PARD_IDIHCTAUX1;O;N2;I;;;123456789;;;C3;""Heures compl. taux 1 (%)"";"
"IHCOMP";"S";"0054";"   PARD_IDIHCTAUX2;O;N2;I;;;123456789;;;C3;""Heures compl. à récup. taux 2 (%)"";"
"IHCOMP";"S";"0055";"   HJOU_IJQHCNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures comp. payées non majorées"";"
"IHCOMP";"S";"0056";"   HJOU_IJQHSNMAP2;N;T6,2;I;;;    56789;;;V3;""Heures complémentaires taux 2"";"
"IHCOMP";"S";"0057";"   HJOU_IJQHSNMAR2;N;T6,2;I;;;     6789;;;V3;""Heures complémentaires taux 2 à récup."";"
"IHCOMP";"S";"0058";"FINDICO"
"IHCOMP";"S";"0059";"DEBANO"
"IHCOMP";"S";"0060";"   171;8;""Dépassement de l'horaire hebdomadaire temps plein"";"
"IHCOMP";"S";"0061";"   192;9;""Heures non majorées payées négatives"";"
"IHCOMP";"S";"0062";"   225;6;""Nombre maxi d'heures complémentaires atteint pour ce contrat"";"
"IHCOMP";"S";"0063";"   226;9;""Solde récup HS/HC insuffisant"";"
"IHCOMP";"S";"0064";"FINANO"
"IHCOMP";"S";"0065";"*"
"IHCOMP";"S";"0066";"* Déclaration des donnees locales"
"IHCOMP";"S";"0067";"*"
"IHCOMP";"S";"0068";"DEF LOCA_NBCYCLE N2"
"IHCOMP";"S";"0069";"LOCA_NBCYCLE = 0"
"IHCOMP";"S";"0070";"DEF LOCA_CAL N1"
"IHCOMP";"S";"0071";"LOCA_CAL = 0"
"IHCOMP";"S";"0072";"DEF LOCA_HORHEB T6.2"
"IHCOMP";"S";"0073";"LOCA_HORHEB = 0"
"IHCOMP";"S";"0074";"DEF LOCA_HORCOH T6.2"
"IHCOMP";"S";"0075";"LOCA_HORCOH = 0"
"IHCOMP";"S";"0076";"DEF LOCA_10 T6.2"
"IHCOMP";"S";"0077";"LOCA_10 = 0"
"IHCOMP";"S";"0078";"DEF LOCA_HCOMP T6.2"
"IHCOMP";"S";"0079";"LOCA_HCOMP = 0"
"IHCOMP";"S";"0080";"DEF LOCA_DATE D"
"IHCOMP";"S";"0081";"LOCA_DATE = "" """
"IHCOMP";"S";"0082";"DEF LOCA_ACOURS N4"
"IHCOMP";"S";"0083";"LOCA_ACOURS = 0"
"IHCOMP";"S";"0084";"DEF LOCA_ACOURS2 N4"
"IHCOMP";"S";"0085";"LOCA_ACOURS2 = 0"
"IHCOMP";"S";"0086";"DEF LOCA_DATEFU D"
"IHCOMP";"S";"0087";"LOCA_DATEFU = "" """
"IHCOMP";"S";"0088";"DEF LOCA_DATEFU2 D"
"IHCOMP";"S";"0089";"LOCA_DATEFU2 = "" """
"IHCOMP";"S";"0090";"* Taux 1 pour récupération"
"IHCOMP";"S";"0091";"DEF LOCA_TAUXC N4.2"
"IHCOMP";"S";"0092";"LOCA_TAUXC = 0"
"IHCOMP";"S";"0093";"LOCA_TAUXC = PARD_IDIHCTAUX1 / 100"
"IHCOMP";"S";"0094";"LOCA_TAUXC = LOCA_TAUXC + 1"
"IHCOMP";"S";"0095";"* Taux 2 pour récupération"
"IHCOMP";"S";"0096";"DEF LOCA_TAUXC2 N4.2"
"IHCOMP";"S";"0097";"LOCA_TAUXC2 = 0"
"IHCOMP";"S";"0098";"LOCA_TAUXC2 = PARD_IDIHCTAUX2 / 100"
"IHCOMP";"S";"0099";"LOCA_TAUXC2 = LOCA_TAUXC2 + 1"
"IHCOMP";"S";"0100";"* Pour calcul de la différence entre Base HS"
"IHCOMP";"S";"0101";"* et théorie"
"IHCOMP";"S";"0102";"DEF LOCA_CAL2 T6.2"
"IHCOMP";"S";"0103";"LOCA_CAL2 = 0"
"IHCOMP";"S";"0104";"DEF LOCA_CONSO N1"
"IHCOMP";"S";"0105";"LOCA_CONSO = 0"
"IHCOMP";"S";"0106";"*"
"IHCOMP";"S";"0107";"* Si temps partiels"
"IHCOMP";"S";"0108";"SI HJOU_IJITYPCTRA > 0"
"IHCOMP";"S";"0109";"   SI HJOU_IJITYPCTRA < 100"
"IHCOMP";"S";"0110";"*"
"IHCOMP";"S";"0111";"* Alimentation des données locales pour calcul soldes prévisionnels"
"IHCOMP";"S";"0112";"*"
"IHCOMP";"S";"0113";"      SI PARD_IDIDDEBANN <> "" """
"IHCOMP";"S";"0114";"         LOCA_DATE(5:4) = PARD_IDIDDEBANN(5:4)"
"IHCOMP";"S";"0115";"      SINON"
"IHCOMP";"S";"0116";"         LOCA_DATE(5:4) = ""0101"""
"IHCOMP";"S";"0117";"      FINSI"
"IHCOMP";"S";"0118";"**"
"IHCOMP";"S";"0119";"      LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IHCOMP";"S";"0120";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHCOMP";"S";"0121";"*"
"IHCOMP";"S";"0122";"      SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IHCOMP";"S";"0123";"         LOCA_ACOURS = LOCA_ACOURS + 1"
"IHCOMP";"S";"0124";"         LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHCOMP";"S";"0125";"      FINSI"
"IHCOMP";"S";"0126";"*"
"IHCOMP";"S";"0127";"      LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IHCOMP";"S";"0128";"      LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IHCOMP";"S";"0129";"      LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IHCOMP";"S";"0130";"      LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IHCOMP";"S";"0131";"*"
"IHCOMP";"S";"0132";"* INRH = 1 calcul des HS chaque dimanche"
"IHCOMP";"S";"0133";"* INRH = 2 calcul des HS le dernier dimanche du cycle"
"IHCOMP";"S";"0134";"* INRH = 3 calcul des HS chaque dimanche et en fin d'annualisation"
"IHCOMP";"S";"0135";"* Raz de la base HS le lundi"
"IHCOMP";"S";"0136";"      SI HJOU_JOUR = ""1"""
"IHCOMP";"S";"0137";"* raz chaque lundi <> 2 (0/1/3)"
"IHCOMP";"S";"0138";"         SI HJOU_IJIGHSUPPM <> ""2"""
"IHCOMP";"S";"0139";"            HJOU_IJRBHSMPAH = 0"
"IHCOMP";"S";"0140";"            HJOU_IJRBHPAYEE = 0"
"IHCOMP";"S";"0141";"         FINSI"
"IHCOMP";"S";"0142";"* raz le premier lundi du cycle si INRH = 2"
"IHCOMP";"S";"0143";"         SI HJOU_IJIGHSUPPM = ""2"""
"IHCOMP";"S";"0144";"* stokage de la duree theorique du code horaire"
"IHCOMP";"S";"0145";"            SI HJOU_RANG = 1"
"IHCOMP";"S";"0146";"               HJOU_IJRBHSMPAH = 0"
"IHCOMP";"S";"0147";"* raz de la duree theorique du cycle"
"IHCOMP";"S";"0148";"               HJOU_IJRTHEOCYC = 0"
"IHCOMP";"S";"0149";"               HJOU_IJRBHPAYEE = 0"
"IHCOMP";"S";"0150";"            FINSI"
"IHCOMP";"S";"0151";"* cumul de la duree theorique du cycle"
"IHCOMP";"S";"0152";"            HJOU_IJRTHEOCYC = HJOU_IJRTHEOCYC + HJOU_HORHEB"
"IHCOMP";"S";"0153";"         FINSI"
"IHCOMP";"S";"0154";"      FINSI"
"IHCOMP";"S";"0155";"      SI HJOU_IJIGHSUPPM <> ""0"""
"IHCOMP";"S";"0156";"* on calcul également la base HS dans le cas ou on"
"IHCOMP";"S";"0157";"* calcul un acquis RTT hebdo"
"IHCOMP";"S";"0158";"      OU HJOU_IJIGRETETR = ""3"""
"IHCOMP";"S";"0159";"         HJOU_IJQHPAYEES = HJOU_IJQPRESBAV"
"IHCOMP";"S";"0160";"         POUR ACTIVITES"
"IHCOMP";"S";"0161";"            SI MOTI_MOTYPE <> ""C"""
"IHCOMP";"S";"0162";"               SI MOTI_IMIGHRSSUP = ""1"""
"IHCOMP";"S";"0163";"               OU MOTI_IMIGHRPAYE = ""1"""
"IHCOMP";"S";"0164";"                  HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHCOMP";"S";"0165";"               FINSI"
"IHCOMP";"S";"0166";"            FINSI"
"IHCOMP";"S";"0167";"** alimentation par consignes"
"IHCOMP";"S";"0168";"            SI HABS_MOTIF = ""ZHPA"""
"IHCOMP";"S";"0169";"               HJOU_IJQHPAYEES = HABS_MOTIDUR"
"IHCOMP";"S";"0170";"            FINSI"
"IHCOMP";"S";"0171";"*"
"IHCOMP";"S";"0172";"            SI HABS_MOTIF = ""XHPA"""
"IHCOMP";"S";"0173";"               HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHCOMP";"S";"0174";"            FINSI"
"IHCOMP";"S";"0175";"         FINPOUR"
"IHCOMP";"S";"0176";"** alimentation des bases hebdo"
"IHCOMP";"S";"0177";"         HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HJOU_IJQPRESBAV"
"IHCOMP";"S";"0178";"*"
"IHCOMP";"S";"0179";"         HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE + HJOU_IJQHPAYEES"
"IHCOMP";"S";"0180";"         POUR ACTIVITES"
"IHCOMP";"S";"0181";"            SI MOTI_MOTYPE <> ""C"""
"IHCOMP";"S";"0182";"               SI MOTI_IMIGHRSSUP = ""1"""
"IHCOMP";"S";"0183";"                  HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HABS_MOTIDUR"
"IHCOMP";"S";"0184";"               FINSI"
"IHCOMP";"S";"0185";"            FINSI"
"IHCOMP";"S";"0186";"         FINPOUR"
"IHCOMP";"S";"0187";"      FINSI"
"IHCOMP";"S";"0188";"*** initialisation de la base HS par consigne"
"IHCOMP";"S";"0189";"      POUR ACTIVITES"
"IHCOMP";"S";"0190";"         SI HABS_MOTIF = ""ZBHS"""
"IHCOMP";"S";"0191";"            HJOU_IJRBHSMPAH = HABS_MOTIDUR"
"IHCOMP";"S";"0192";"         FINSI"
"IHCOMP";"S";"0193";"         SI HABS_MOTIF = ""ZBPA"""
"IHCOMP";"S";"0194";"            HJOU_IJRBHPAYEE = HABS_MOTIDUR"
"IHCOMP";"S";"0195";"         FINSI"
"IHCOMP";"S";"0196";"      FINPOUR"
"IHCOMP";"S";"0197";"      SI HJOU_IJIGHSUPPM <> ""0"""
"IHCOMP";"S";"0198";"* calcul des HS"
"IHCOMP";"S";"0199";"         SI HJOU_JOUR = ""7"""
"IHCOMP";"S";"0200";"            SI HJOU_IJIGHSUPPM = ""1"""
"IHCOMP";"S";"0201";"            OU HJOU_IJIGHSUPPM = ""3"""
"IHCOMP";"S";"0202";"** pour les temps partiels"
"IHCOMP";"S";"0203";"**"
"IHCOMP";"S";"0204";"               LOCA_HORHEB = HJOU_HORHEB"
"IHCOMP";"S";"0205";"               LOCA_HORCOH = PARD_IDIVHORCOH"
"IHCOMP";"S";"0206";"* 10% du contrat pour les temps partiel"
"IHCOMP";"S";"0207";"               LOCA_10 = LOCA_HORHEB * 0.10"
"IHCOMP";"S";"0208";"               LOCA_CAL = 1"
"IHCOMP";"S";"0209";"            FINSI"
"IHCOMP";"S";"0210";"            SI HJOU_IJIGHSUPPM = ""2"""
"IHCOMP";"S";"0211";"* dans le cas ou les HS se calculent en fin de cycle"
"IHCOMP";"S";"0212";"* loca_nbcycle correspond au nombre de semaines"
"IHCOMP";"S";"0213";"               LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"IHCOMP";"S";"0214";"               SI HJOU_RANG = LOCA_NBCYCLE"
"IHCOMP";"S";"0215";"* recalcul des seuils par rapport au nombre de semaines"
"IHCOMP";"S";"0216";"** pour les temps partiels"
"IHCOMP";"S";"0217";"* LOCA_HORHEB = HJOU_HORHEB * LOCA_NBCYCLE"
"IHCOMP";"S";"0218";"                  LOCA_HORHEB = HJOU_IJRTHEOCYC"
"IHCOMP";"S";"0219";"                  LOCA_HORCOH = PARD_IDIVHORCOH * LOCA_NBCYCLE"
"IHCOMP";"S";"0220";"* 10% du contrat pour les temps partiel"
"IHCOMP";"S";"0221";"                  LOCA_10 = LOCA_HORHEB * 0.10"
"IHCOMP";"S";"0222";"                  LOCA_CAL = 1"
"IHCOMP";"S";"0223";"               FINSI"
"IHCOMP";"S";"0224";"            FINSI"
"IHCOMP";"S";"0225";"*  Calcul des heures suppl?mentaires ? 25% et 50%"
"IHCOMP";"S";"0226";"            SI LOCA_CAL = 1"
"IHCOMP";"S";"0227";"               SI LOCA_HORHEB < LOCA_HORCOH"
"IHCOMP";"S";"0228";"                  SI HJOU_IJRBHPAYEE > LOCA_HORHEB"
"IHCOMP";"S";"0229";"                     HJOU_IJQHCNMAPA = HJOU_IJRBHPAYEE - LOCA_HORHEB"
"IHCOMP";"S";"0230";"                  FINSI"
"IHCOMP";"S";"0231";"*"
"IHCOMP";"S";"0232";"                  SI HJOU_IJRBHSMPAH > LOCA_HORHEB"
"IHCOMP";"S";"0233";"                     LOCA_HCOMP = HJOU_IJRBHSMPAH - LOCA_HORHEB"
"IHCOMP";"S";"0234";"* cas ou LOCA_HCOMP > 10% du contrat"
"IHCOMP";"S";"0235";"                     SI LOCA_HCOMP >= LOCA_10"
"IHCOMP";"S";"0236";"** calcul HS25 % dans le cas ou les heures complementaires > 10% du contra"
"IHCOMP";"S";"0237";"                        HJOU_IJQHSNMAP2 = LOCA_HCOMP - LOCA_10"
"IHCOMP";"S";"0238";"                        LOCA_HCOMP = LOCA_10"
"IHCOMP";"S";"0239";"                     FINSI"
"IHCOMP";"S";"0240";"** calcul des heures complementaires taux 1"
"IHCOMP";"S";"0241";"                     HJOU_IJQHSNMAPA = LOCA_HCOMP"
"IHCOMP";"S";"0242";"*"
"IHCOMP";"S";"0243";"* Dépassement de l'horaire hebdo temps plein"
"IHCOMP";"S";"0244";"                     SI HJOU_IJRBHSMPAH > LOCA_HORCOH"
"IHCOMP";"S";"0245";"                        ANOMALIE 171"
"IHCOMP";"S";"0246";"                     FINSI"
"IHCOMP";"S";"0247";"* Anomalie en cas de dépassement de 10% du contrat"
"IHCOMP";"S";"0248";"                     LOCA_CAL2 = HJOU_IJRBHSMPAH - LOCA_HORHEB"
"IHCOMP";"S";"0249";"                     SI LOCA_CAL2 > LOCA_10"
"IHCOMP";"S";"0250";"                        ANOMALIE 225"
"IHCOMP";"S";"0251";"                     FINSI"
"IHCOMP";"S";"0252";"*"
"IHCOMP";"S";"0253";"                     POUR ACTIVITES"
"IHCOMP";"S";"0254";"* Taux 1"
"IHCOMP";"S";"0255";"                        SI HABS_MOTIF = ""XCOP"""
"IHCOMP";"S";"0256";"                           HJOU_IJQHSNMAPA = HJOU_IJQHSNMAPA + HABS_MOTIDUR"
"IHCOMP";"S";"0257";"                        FINSI"
"IHCOMP";"S";"0258";"                        SI HABS_MOTIF = ""ZCOP"""
"IHCOMP";"S";"0259";"                           HJOU_IJQHSNMAPA = HABS_MOTIDUR"
"IHCOMP";"S";"0260";"                        FINSI"
"IHCOMP";"S";"0261";"* Taux 2"
"IHCOMP";"S";"0262";"                        SI HABS_MOTIF = ""XCOP2"""
"IHCOMP";"S";"0263";"                           HJOU_IJQHSNMAP2 = HJOU_IJQHSNMAP2 + HABS_MOTIDUR"
"IHCOMP";"S";"0264";"                        FINSI"
"IHCOMP";"S";"0265";"                        SI HABS_MOTIF = ""ZCOP2"""
"IHCOMP";"S";"0266";"                           HJOU_IJQHSNMAP2 = HABS_MOTIDUR"
"IHCOMP";"S";"0267";"                        FINSI"
"IHCOMP";"S";"0268";"                     FINPOUR"
"IHCOMP";"S";"0269";"* Taux 1"
"IHCOMP";"S";"0270";"                     HJOU_IJQHCNMAPA = HJOU_IJQHCNMAPA - HJOU_IJQHSNMAPA"
"IHCOMP";"S";"0271";"* Taux 2"
"IHCOMP";"S";"0272";"                     HJOU_IJQHCNMAPA = HJOU_IJQHCNMAPA - HJOU_IJQHSNMAP2"
"IHCOMP";"S";"0273";"*"
"IHCOMP";"S";"0274";"** cas ou les heures complementaires sont a recuperer"
"IHCOMP";"S";"0275";"                     SI HJOU_IJIGHSUPPR = ""1"""
"IHCOMP";"S";"0276";"** a compter du 01/01/2014 elles sont majorées de 10%"
"IHCOMP";"S";"0277";"                        SI HJOU_DATE >= ""01012014"""
"IHCOMP";"S";"0278";"                           HJOU_IJQHSNMAPA = HJOU_IJQHSNMAPA * LOCA_TAUXC"
"IHCOMP";"S";"0279";"                        FINSI"
"IHCOMP";"S";"0280";"                        HJOU_IJQHSNMARE = HJOU_IJQHSNMAPA"
"IHCOMP";"S";"0281";"                        HJOU_IJQHSNMAPA = 0"
"IHCOMP";"S";"0282";"* Ajout de la majoration taux 2 pour les heures à récupérer"
"IHCOMP";"S";"0283";"                        HJOU_IJQHSNMAP2 = HJOU_IJQHSNMAP2 * LOCA_TAUXC2"
"IHCOMP";"S";"0284";"* HJOU_XXXX3 = HC à récup. taux 2"
"IHCOMP";"S";"0285";"                        HJOU_IJQHSNMAR2 = HJOU_IJQHSNMAP2"
"IHCOMP";"S";"0286";"                        HJOU_IJQHSNMAP2 = 0"
"IHCOMP";"S";"0287";"*"
"IHCOMP";"S";"0288";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMARE"
"IHCOMP";"S";"0289";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMAR2"
"IHCOMP";"S";"0290";"                     FINSI"
"IHCOMP";"S";"0291";"                  FINSI"
"IHCOMP";"S";"0292";"*"
"IHCOMP";"S";"0293";"                  SI HJOU_IJQHCNMAPA < 0"
"IHCOMP";"S";"0294";"                     ANOMALIE 192"
"IHCOMP";"S";"0295";"                  FINSI"
"IHCOMP";"S";"0296";"               FINSI"
"IHCOMP";"S";"0297";"            FINSI"
"IHCOMP";"S";"0298";"         FINSI"
"IHCOMP";"S";"0299";"*"
"IHCOMP";"S";"0300";"         POUR ACTIVITES"
"IHCOMP";"S";"0301";"            SI HABS_MOTIF = PARD_IDIVMOTHSR"
"IHCOMP";"S";"0302";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HABS_MOTIDUR"
"IHCOMP";"S";"0303";"               LOCA_CONSO = 1"
"IHCOMP";"S";"0304";"            FINSI"
"IHCOMP";"S";"0305";"            SI HABS_MOTIF = ""ZHCP"""
"IHCOMP";"S";"0306";"               HJOU_IJQHCNMAPA = HABS_MOTIDUR"
"IHCOMP";"S";"0307";"            FINSI"
"IHCOMP";"S";"0308";"* Taux 1"
"IHCOMP";"S";"0309";"            SI HABS_MOTIF = ""XCOR"""
"IHCOMP";"S";"0310";"            OU HABS_MOTIF = ""ZCOR"""
"IHCOMP";"S";"0311";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_IJQHSNMARE"
"IHCOMP";"S";"0312";"               SI HABS_MOTIF = ""XCOR"""
"IHCOMP";"S";"0313";"                  HJOU_IJQHSNMARE = HJOU_IJQHSNMARE + HABS_MOTIDUR"
"IHCOMP";"S";"0314";"               FINSI"
"IHCOMP";"S";"0315";"               SI HABS_MOTIF = ""ZCOR"""
"IHCOMP";"S";"0316";"                  HJOU_IJQHSNMARE = HABS_MOTIDUR"
"IHCOMP";"S";"0317";"               FINSI"
"IHCOMP";"S";"0318";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMARE"
"IHCOMP";"S";"0319";"            FINSI"
"IHCOMP";"S";"0320";"* Taux 2"
"IHCOMP";"S";"0321";"            SI HABS_MOTIF = ""XCOR2"""
"IHCOMP";"S";"0322";"            OU HABS_MOTIF = ""ZCOR2"""
"IHCOMP";"S";"0323";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_IJQHSNMAR2"
"IHCOMP";"S";"0324";"               SI HABS_MOTIF = ""XCOR2"""
"IHCOMP";"S";"0325";"                  HJOU_IJQHSNMAR2 = HJOU_IJQHSNMAR2 + HABS_MOTIDUR"
"IHCOMP";"S";"0326";"               FINSI"
"IHCOMP";"S";"0327";"               SI HABS_MOTIF = ""ZCOR2"""
"IHCOMP";"S";"0328";"                  HJOU_IJQHSNMAR2 = HABS_MOTIDUR"
"IHCOMP";"S";"0329";"               FINSI"
"IHCOMP";"S";"0330";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMAR2"
"IHCOMP";"S";"0331";"            FINSI"
"IHCOMP";"S";"0332";"         FINPOUR"
"IHCOMP";"S";"0333";"*"
"IHCOMP";"S";"0334";"         SI LOCA_CONSO = 1"
"IHCOMP";"S";"0335";"            SI HJOU_IJRSHSMREH < 0"
"IHCOMP";"S";"0336";"               ANOMALIE 226"
"IHCOMP";"S";"0337";"               TEMP_CNRETOUR = 2"
"IHCOMP";"S";"0338";"               TEMP_CNMESS = 226"
"IHCOMP";"S";"0339";"            FINSI"
"IHCOMP";"S";"0340";"         FINSI"
"IHCOMP";"S";"0341";"      FINSI"
"IHCOMP";"S";"0342";"**"
"IHCOMP";"S";"0343";"** Soldes previsionnels"
"IHCOMP";"S";"0344";"**"
"IHCOMP";"S";"0345";"      SI CTRA_DATFIN > TEMP_DATJOU"
"IHCOMP";"S";"0346";"         SI CTRA_DATFIN < LOCA_DATEFU"
"IHCOMP";"S";"0347";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHCOMP";"S";"0348";"            LOCA_DATEFU = TEMP_DXFINPER"
"IHCOMP";"S";"0349";"         SINON"
"IHCOMP";"S";"0350";"            SI CTRA_DATFIN < LOCA_DATEFU2"
"IHCOMP";"S";"0351";"               DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHCOMP";"S";"0352";"               LOCA_DATEFU2 = TEMP_DXFINPER"
"IHCOMP";"S";"0353";"            FINSI"
"IHCOMP";"S";"0354";"         FINSI"
"IHCOMP";"S";"0355";"      FINSI"
"IHCOMP";"S";"0356";"***"
"IHCOMP";"S";"0357";"      SI TEMP_DATSUI = LOCA_DATEFU"
"IHCOMP";"S";"0358";"         EMPL_IEQSHSMRE1 = HJOU_IJRSHSMREH"
"IHCOMP";"S";"0359";"      FINSI"
"IHCOMP";"S";"0360";"**"
"IHCOMP";"S";"0361";"      SI TEMP_DATSUI = LOCA_DATEFU2"
"IHCOMP";"S";"0362";"         EMPL_IEQSHSMRE2 = HJOU_IJRSHSMREH"
"IHCOMP";"S";"0363";"      FINSI"
"IHCOMP";"S";"0364";"   FINSI"
"IHCOMP";"S";"0365";"FINSI"
"IHCOMP";"S";"0366";"*"
"IHCOMP";"S";"0367";"FIN"
"IHCOMPDIM";"S";"0001";"************************************************************************"
"IHCOMPDIM";"S";"0002";"*"
"IHCOMPDIM";"S";"0003";"* Règle : IHCOMPDIM"
"IHCOMPDIM";"S";"0004";"* Ordre : 6080"
"IHCOMPDIM";"S";"0005";"* Titre : Calcul des heures complémentaires pour les temps partiels"
"IHCOMPDIM";"S";"0006";"*          lundi 0h au dimanche 24h"
"IHCOMPDIM";"S";"0007";"*"
"IHCOMPDIM";"S";"0008";"*----------------------------------------------------------------------"
"IHCOMPDIM";"S";"0009";"*"
"IHCOMPDIM";"S";"0010";"* Créé par : Méthodes et outils"
"IHCOMPDIM";"S";"0011";"* Date     : 25/09/2019"
"IHCOMPDIM";"S";"0012";"* Version  : 1"
"IHCOMPDIM";"S";"0013";"*"
"IHCOMPDIM";"S";"0014";"*----------------------------------------------------------------------"
"IHCOMPDIM";"S";"0015";"*"
"IHCOMPDIM";"S";"0016";"*"
"IHCOMPDIM";"S";"0017";"* Rôle : Calcul des heures complémentaires pour les temps partiels"
"IHCOMPDIM";"S";"0018";"*"
"IHCOMPDIM";"S";"0019";"*"
"IHCOMPDIM";"S";"0020";"*         Adaptation de la règle IHSUPPDIM avec ajout suivant :"
"IHCOMPDIM";"S";"0021";"*"
"IHCOMPDIM";"S";"0022";"*         Ajout de l'anomalie 225 en cas de dépassement d'heures de 10%"
"IHCOMPDIM";"S";"0023";"*         du contrat"
"IHCOMPDIM";"S";"0024";"*         + séparation en deux des règles IHSUPP et IHSUPPDIM afin de"
"IHCOMPDIM";"S";"0025";"*         différencier les HS et les HC"
"IHCOMPDIM";"S";"0026";"*         + évolution des HC avec ajout d'un compteur heures payées non majorées,"
"IHCOMPDIM";"S";"0027";"*         HC taux 2 pour les heures payées et les heures à récupérer"
"IHCOMPDIM";"S";"0028";"*"
"IHCOMPDIM";"S";"0029";"*----------------------------------------------------------------------"
"IHCOMPDIM";"S";"0030";"*"
"IHCOMPDIM";"S";"0031";"* Modifiée par : Méthodes et outils"
"IHCOMPDIM";"S";"0032";"* Date         : 30/06/2020"
"IHCOMPDIM";"S";"0033";"* Objet        : Le test de CTRA_ICITAUX est remplacé par HJOU_IJITYPCTRA"
"IHCOMPDIM";"S";"0034";"*                 car le taux du contrat est désormais copié dans JOU"
"IHCOMPDIM";"S";"0035";"*"
"IHCOMPDIM";"S";"0036";"***********************************************************************"
"IHCOMPDIM";"S";"0037";"*"
"IHCOMPDIM";"S";"0038";"* Implémentation des données industrielles"
"IHCOMPDIM";"S";"0039";"*"
"IHCOMPDIM";"S";"0040";"DEBDICO"
"IHCOMPDIM";"S";"0041";"   HJOU_IJIGHSUPPM;O;Z1;X;;;123456789;L;;C2;""Régime HS"";"
"IHCOMPDIM";"S";"0042";"   HJOU_IJRBHSMPAH;N;T6,2;I;;;    56789;;IJRBHSMPAH;V3;""Base HS"";"
"IHCOMPDIM";"S";"0043";"   HJOU_IJQHS1MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 1 à récup."";"
"IHCOMPDIM";"S";"0044";"   HJOU_IJQHS2MARE;N;T6,2;I;;;     6789;;;V3;""Heures sup taux 2 à récup."";"
"IHCOMPDIM";"S";"0045";"   HJOU_IJRSHSMREH;N;T8,2;L;;;     6789;;IJRSHSMREH;V3;""Récupération HS/HC"";"
"IHCOMPDIM";"S";"0046";"   HJOU_IJQHSNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures complémentaires"";"
"IHCOMPDIM";"S";"0047";"   HJOU_IJQHSNMARE;N;T6,2;I;;;     6789;;;V3;""Heures complémentaires récupérables"";"
"IHCOMPDIM";"S";"0048";"   HJOU_IJRTHEOCYC;N;T6,2;I;;;    56789;;IJRTHEOCYC;V3;""Theorie du cycle"";"
"IHCOMPDIM";"S";"0049";"   HJOU_IJQHPAYEES;N;T6,2;I;;;    56789;;;V3;""Heures payées"";"
"IHCOMPDIM";"S";"0050";"   HJOU_IJRBHPAYEE;N;T6,2;I;;;    56789;;IJRBHPAYEE;V3;""Base des heures payées"";"
"IHCOMPDIM";"S";"0051";"   MOTI_IMIGHRPAYE;O;Z1;X;0;1;123456789;C;;C2;""Participe aux heures payées"";"
"IHCOMPDIM";"S";"0052";"   EMPL_IEQSHSMRE1;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 1 HS à recup."";"
"IHCOMPDIM";"S";"0053";"   EMPL_IEQSHSMRE2;N;T8,2;L;;;   456789;;;V3;""Solde prévisionnel 2 HS à recup."";"
"IHCOMPDIM";"S";"0054";"   PARD_IDIHCTAUX1;O;N2;I;;;123456789;;;C3;""Heures compl. taux 1 (%)"";"
"IHCOMPDIM";"S";"0055";"   PARD_IDIHCTAUX2;O;N2;I;;;123456789;;;C3;""Heures compl. à récup. taux 2 (%)"";"
"IHCOMPDIM";"S";"0056";"   HJOU_IJQHCNMAPA;N;T6,2;I;;;    56789;;;V3;""Heures comp. payées non majorées"";"
"IHCOMPDIM";"S";"0057";"   HJOU_IJQHSNMAP2;N;T6,2;I;;;    56789;;;V3;""Heures complémentaires taux 2"";"
"IHCOMPDIM";"S";"0058";"   HJOU_IJQHSNMAR2;N;T6,2;I;;;     6789;;;V3;""Heures complémentaires taux 2 à récup."";"
"IHCOMPDIM";"S";"0059";"FINDICO"
"IHCOMPDIM";"S";"0060";"DEBANO"
"IHCOMPDIM";"S";"0061";"   171;8;""Dépassement de l'horaire hebdomadaire temps plein"";"
"IHCOMPDIM";"S";"0062";"   192;9;""Heures non majorées payées négatives"";"
"IHCOMPDIM";"S";"0063";"   225;6;""Nombre maxi d'heures complémentaires atteint pour ce contrat"";"
"IHCOMPDIM";"S";"0064";"   226;9;""Solde récup HS/HC insuffisant"";"
"IHCOMPDIM";"S";"0065";"FINANO"
"IHCOMPDIM";"S";"0066";"*"
"IHCOMPDIM";"S";"0067";"* Déclaration des donnees locales"
"IHCOMPDIM";"S";"0068";"*"
"IHCOMPDIM";"S";"0069";"DEF LOCA_NBCYCLE N2"
"IHCOMPDIM";"S";"0070";"LOCA_NBCYCLE = 0"
"IHCOMPDIM";"S";"0071";"DEF LOCA_CAL N1"
"IHCOMPDIM";"S";"0072";"LOCA_CAL = 0"
"IHCOMPDIM";"S";"0073";"DEF LOCA_HORHEB T6.2"
"IHCOMPDIM";"S";"0074";"LOCA_HORHEB = 0"
"IHCOMPDIM";"S";"0075";"DEF LOCA_HORCOH T6.2"
"IHCOMPDIM";"S";"0076";"LOCA_HORCOH = 0"
"IHCOMPDIM";"S";"0077";"DEF LOCA_10 T6.2"
"IHCOMPDIM";"S";"0078";"LOCA_10 = 0"
"IHCOMPDIM";"S";"0079";"DEF LOCA_HCOMP T6.2"
"IHCOMPDIM";"S";"0080";"LOCA_HCOMP = 0"
"IHCOMPDIM";"S";"0081";"DEF LOCA_BASEHS T6.2"
"IHCOMPDIM";"S";"0082";"LOCA_BASEHS = 0"
"IHCOMPDIM";"S";"0083";"DEF LOCA_DATE D"
"IHCOMPDIM";"S";"0084";"LOCA_DATE = "" """
"IHCOMPDIM";"S";"0085";"DEF LOCA_ACOURS N4"
"IHCOMPDIM";"S";"0086";"LOCA_ACOURS = 0"
"IHCOMPDIM";"S";"0087";"DEF LOCA_ACOURS2 N4"
"IHCOMPDIM";"S";"0088";"LOCA_ACOURS2 = 0"
"IHCOMPDIM";"S";"0089";"DEF LOCA_DATEFU D"
"IHCOMPDIM";"S";"0090";"LOCA_DATEFU = "" """
"IHCOMPDIM";"S";"0091";"DEF LOCA_DATEFU2 D"
"IHCOMPDIM";"S";"0092";"LOCA_DATEFU2 = "" """
"IHCOMPDIM";"S";"0093";"* Taux 1 pour récupération"
"IHCOMPDIM";"S";"0094";"DEF LOCA_TAUXC N4.2"
"IHCOMPDIM";"S";"0095";"LOCA_TAUXC = 0"
"IHCOMPDIM";"S";"0096";"LOCA_TAUXC = PARD_IDIHCTAUX1 / 100"
"IHCOMPDIM";"S";"0097";"LOCA_TAUXC = LOCA_TAUXC + 1"
"IHCOMPDIM";"S";"0098";"* Taux 2 pour récupération"
"IHCOMPDIM";"S";"0099";"DEF LOCA_TAUXC2 N4.2"
"IHCOMPDIM";"S";"0100";"LOCA_TAUXC2 = 0"
"IHCOMPDIM";"S";"0101";"LOCA_TAUXC2 = PARD_IDIHCTAUX2 / 100"
"IHCOMPDIM";"S";"0102";"LOCA_TAUXC2 = LOCA_TAUXC2 + 1"
"IHCOMPDIM";"S";"0103";"* Pour calcul de la différence entre Base HS"
"IHCOMPDIM";"S";"0104";"* et théorie"
"IHCOMPDIM";"S";"0105";"DEF LOCA_CAL2 T6.2"
"IHCOMPDIM";"S";"0106";"LOCA_CAL2 = 0"
"IHCOMPDIM";"S";"0107";"DEF LOCA_CONSO N1"
"IHCOMPDIM";"S";"0108";"LOCA_CONSO = 0"
"IHCOMPDIM";"S";"0109";"*"
"IHCOMPDIM";"S";"0110";"* Si temps partiels"
"IHCOMPDIM";"S";"0111";"SI HJOU_IJITYPCTRA > 0"
"IHCOMPDIM";"S";"0112";"   SI HJOU_IJITYPCTRA < 100"
"IHCOMPDIM";"S";"0113";"*"
"IHCOMPDIM";"S";"0114";"* Alimentation des données locales pour calcul soldes prévisionnels"
"IHCOMPDIM";"S";"0115";"*"
"IHCOMPDIM";"S";"0116";"      SI PARD_IDIDDEBANN <> "" """
"IHCOMPDIM";"S";"0117";"         LOCA_DATE(5:4) = PARD_IDIDDEBANN(5:4)"
"IHCOMPDIM";"S";"0118";"      SINON"
"IHCOMPDIM";"S";"0119";"         LOCA_DATE(5:4) = ""0101"""
"IHCOMPDIM";"S";"0120";"      FINSI"
"IHCOMPDIM";"S";"0121";"**"
"IHCOMPDIM";"S";"0122";"      LOCA_ACOURS << TEMP_DATJOU(1:4)"
"IHCOMPDIM";"S";"0123";"      LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHCOMPDIM";"S";"0124";"*"
"IHCOMPDIM";"S";"0125";"      SI TEMP_DATJOU(5:4) >= LOCA_DATE(5:4)"
"IHCOMPDIM";"S";"0126";"         LOCA_ACOURS = LOCA_ACOURS + 1"
"IHCOMPDIM";"S";"0127";"         LOCA_ACOURS2 = LOCA_ACOURS + 1"
"IHCOMPDIM";"S";"0128";"      FINSI"
"IHCOMPDIM";"S";"0129";"*"
"IHCOMPDIM";"S";"0130";"      LOCA_DATEFU(1:4) << LOCA_ACOURS"
"IHCOMPDIM";"S";"0131";"      LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"IHCOMPDIM";"S";"0132";"      LOCA_DATEFU2(1:4) << LOCA_ACOURS2"
"IHCOMPDIM";"S";"0133";"      LOCA_DATEFU2(5:4) = LOCA_DATE(5:4)"
"IHCOMPDIM";"S";"0134";"*"
"IHCOMPDIM";"S";"0135";"* INRH = 1 calcul des HS chaque dimanche"
"IHCOMPDIM";"S";"0136";"* INRH = 2 calcul des HS le dernier dimanche du cycle"
"IHCOMPDIM";"S";"0137";"* INRH = 3 calcul des HS chaque dimanche et en fin d'annualisation"
"IHCOMPDIM";"S";"0138";"* Raz de la base HS le lundi"
"IHCOMPDIM";"S";"0139";"      SI HJOU_JOUR = ""1"""
"IHCOMPDIM";"S";"0140";"* raz chaque lundi <> 2 (0/1/3)"
"IHCOMPDIM";"S";"0141";"         SI HJOU_IJIGHSUPPM <> ""2"""
"IHCOMPDIM";"S";"0142";"            HJOU_IJRBHSMPAH = 0"
"IHCOMPDIM";"S";"0143";"            HJOU_IJRBHPAYEE = 0"
"IHCOMPDIM";"S";"0144";"         FINSI"
"IHCOMPDIM";"S";"0145";"* raz le premier lundi du cycle si INRH = 2"
"IHCOMPDIM";"S";"0146";"         SI HJOU_IJIGHSUPPM = ""2"""
"IHCOMPDIM";"S";"0147";"* stokage de la duree theorique du code horaire"
"IHCOMPDIM";"S";"0148";"            SI HJOU_RANG = 1"
"IHCOMPDIM";"S";"0149";"               HJOU_IJRBHSMPAH = 0"
"IHCOMPDIM";"S";"0150";"* raz de la duree theorique du cycle"
"IHCOMPDIM";"S";"0151";"               HJOU_IJRTHEOCYC = 0"
"IHCOMPDIM";"S";"0152";"               HJOU_IJRBHPAYEE = 0"
"IHCOMPDIM";"S";"0153";"            FINSI"
"IHCOMPDIM";"S";"0154";"* cumul de la duree theorique du cycle"
"IHCOMPDIM";"S";"0155";"            HJOU_IJRTHEOCYC = HJOU_IJRTHEOCYC + HJOU_HORHEB"
"IHCOMPDIM";"S";"0156";"         FINSI"
"IHCOMPDIM";"S";"0157";"      FINSI"
"IHCOMPDIM";"S";"0158";"      SI HJOU_IJIGHSUPPM <> ""0"""
"IHCOMPDIM";"S";"0159";"* on calcul également la base HS dans le cas ou on"
"IHCOMPDIM";"S";"0160";"* calcul un acquis RTT hebdo"
"IHCOMPDIM";"S";"0161";"      OU HJOU_IJIGRETETR = ""3"""
"IHCOMPDIM";"S";"0162";"* Calcul de la base des HS"
"IHCOMPDIM";"S";"0163";"         LOCA_BASEHS = HJOU_IJQPRESBAV"
"IHCOMPDIM";"S";"0164";"* le dimanche on ne prend que les heures jour en cours"
"IHCOMPDIM";"S";"0165";"         SI HJOU_JOUR = ""7"""
"IHCOMPDIM";"S";"0166";"            LOCA_BASEHS = HJOU_IJQPREJENC"
"IHCOMPDIM";"S";"0167";"         FINSI"
"IHCOMPDIM";"S";"0168";"*"
"IHCOMPDIM";"S";"0169";"* le lundi , dans le cas ou l'agent a commençé à 21h00 le dimanche"
"IHCOMPDIM";"S";"0170";"* on prend les heures faites le dimanche apres minuit"
"IHCOMPDIM";"S";"0171";"*"
"IHCOMPDIM";"S";"0172";"         SI HJOU_JOUR = ""1"""
"IHCOMPDIM";"S";"0173";"            LOCA_BASEHS = LOCA_BASEHS + HJOU_IJRPREVEIL"
"IHCOMPDIM";"S";"0174";"         FINSI"
"IHCOMPDIM";"S";"0175";"**"
"IHCOMPDIM";"S";"0176";"         HJOU_IJQHPAYEES = LOCA_BASEHS"
"IHCOMPDIM";"S";"0177";"         POUR ACTIVITES"
"IHCOMPDIM";"S";"0178";"            SI MOTI_MOTYPE <> ""C"""
"IHCOMPDIM";"S";"0179";"               SI MOTI_IMIGHRSSUP = ""1"""
"IHCOMPDIM";"S";"0180";"               OU MOTI_IMIGHRPAYE = ""1"""
"IHCOMPDIM";"S";"0181";"                  HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0182";"               FINSI"
"IHCOMPDIM";"S";"0183";"            FINSI"
"IHCOMPDIM";"S";"0184";"** alimentation par consignes"
"IHCOMPDIM";"S";"0185";"            SI HABS_MOTIF = ""ZHPA"""
"IHCOMPDIM";"S";"0186";"               HJOU_IJQHPAYEES = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0187";"            FINSI"
"IHCOMPDIM";"S";"0188";"*"
"IHCOMPDIM";"S";"0189";"            SI HABS_MOTIF = ""XHPA"""
"IHCOMPDIM";"S";"0190";"               HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0191";"            FINSI"
"IHCOMPDIM";"S";"0192";"         FINPOUR"
"IHCOMPDIM";"S";"0193";"** alimentation des bases hebdo"
"IHCOMPDIM";"S";"0194";"         HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + LOCA_BASEHS"
"IHCOMPDIM";"S";"0195";"*"
"IHCOMPDIM";"S";"0196";"         HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE + HJOU_IJQHPAYEES"
"IHCOMPDIM";"S";"0197";"         POUR ACTIVITES"
"IHCOMPDIM";"S";"0198";"            SI MOTI_MOTYPE <> ""C"""
"IHCOMPDIM";"S";"0199";"               SI MOTI_IMIGHRSSUP = ""1"""
"IHCOMPDIM";"S";"0200";"                  HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0201";"               FINSI"
"IHCOMPDIM";"S";"0202";"            FINSI"
"IHCOMPDIM";"S";"0203";"         FINPOUR"
"IHCOMPDIM";"S";"0204";"      FINSI"
"IHCOMPDIM";"S";"0205";"*** initialisation de la base HS par consigne"
"IHCOMPDIM";"S";"0206";"      POUR ACTIVITES"
"IHCOMPDIM";"S";"0207";"         SI HABS_MOTIF = ""ZBHS"""
"IHCOMPDIM";"S";"0208";"            HJOU_IJRBHSMPAH = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0209";"         FINSI"
"IHCOMPDIM";"S";"0210";"         SI HABS_MOTIF = ""ZBPA"""
"IHCOMPDIM";"S";"0211";"            HJOU_IJRBHPAYEE = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0212";"         FINSI"
"IHCOMPDIM";"S";"0213";"      FINPOUR"
"IHCOMPDIM";"S";"0214";"      SI HJOU_IJIGHSUPPM <> ""0"""
"IHCOMPDIM";"S";"0215";"* calcul des HS"
"IHCOMPDIM";"S";"0216";"         SI HJOU_JOUR = ""7"""
"IHCOMPDIM";"S";"0217";"            SI HJOU_IJIGHSUPPM = ""1"""
"IHCOMPDIM";"S";"0218";"            OU HJOU_IJIGHSUPPM = ""3"""
"IHCOMPDIM";"S";"0219";"** pour les temps partiels"
"IHCOMPDIM";"S";"0220";"**"
"IHCOMPDIM";"S";"0221";"               LOCA_HORHEB = HJOU_HORHEB"
"IHCOMPDIM";"S";"0222";"               LOCA_HORCOH = PARD_IDIVHORCOH"
"IHCOMPDIM";"S";"0223";"* 10% du contrat pour les temps partiel"
"IHCOMPDIM";"S";"0224";"               LOCA_10 = LOCA_HORHEB * 0.10"
"IHCOMPDIM";"S";"0225";"               LOCA_CAL = 1"
"IHCOMPDIM";"S";"0226";"            FINSI"
"IHCOMPDIM";"S";"0227";"            SI HJOU_IJIGHSUPPM = ""2"""
"IHCOMPDIM";"S";"0228";"* dans le cas ou les HS se calculent en fin de cycle"
"IHCOMPDIM";"S";"0229";"* loca_nbcycle correspond au nombre de semaines"
"IHCOMPDIM";"S";"0230";"               LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"IHCOMPDIM";"S";"0231";"               SI HJOU_RANG = LOCA_NBCYCLE"
"IHCOMPDIM";"S";"0232";"* recalcul des seuils par rapport au nombre de semaines"
"IHCOMPDIM";"S";"0233";"** pour les temps partiels"
"IHCOMPDIM";"S";"0234";"* LOCA_HORHEB = HJOU_HORHEB * LOCA_NBCYCLE"
"IHCOMPDIM";"S";"0235";"                  LOCA_HORHEB = HJOU_IJRTHEOCYC"
"IHCOMPDIM";"S";"0236";"                  LOCA_HORCOH = PARD_IDIVHORCOH * LOCA_NBCYCLE"
"IHCOMPDIM";"S";"0237";"* 10% du contrat pour les temps partiel"
"IHCOMPDIM";"S";"0238";"                  LOCA_10 = LOCA_HORHEB * 0.10"
"IHCOMPDIM";"S";"0239";"                  LOCA_CAL = 1"
"IHCOMPDIM";"S";"0240";"               FINSI"
"IHCOMPDIM";"S";"0241";"            FINSI"
"IHCOMPDIM";"S";"0242";"*  Calcul des heures complémentaires à 10 % et 25%"
"IHCOMPDIM";"S";"0243";"            SI LOCA_CAL = 1"
"IHCOMPDIM";"S";"0244";"               SI LOCA_HORHEB < LOCA_HORCOH"
"IHCOMPDIM";"S";"0245";"                  SI HJOU_IJRBHPAYEE > LOCA_HORHEB"
"IHCOMPDIM";"S";"0246";"                     HJOU_IJQHCNMAPA = HJOU_IJRBHPAYEE - LOCA_HORHEB"
"IHCOMPDIM";"S";"0247";"                  FINSI"
"IHCOMPDIM";"S";"0248";"*"
"IHCOMPDIM";"S";"0249";"                  SI HJOU_IJRBHSMPAH > LOCA_HORHEB"
"IHCOMPDIM";"S";"0250";"                     LOCA_HCOMP = HJOU_IJRBHSMPAH - LOCA_HORHEB"
"IHCOMPDIM";"S";"0251";"* cas ou LOCA_HCOMP > 10% du contrat"
"IHCOMPDIM";"S";"0252";"                     SI LOCA_HCOMP >= LOCA_10"
"IHCOMPDIM";"S";"0253";"** calcul HC25 % dans le cas ou les heures complementaires > 10% du contra"
"IHCOMPDIM";"S";"0254";"                        HJOU_IJQHSNMAP2 = LOCA_HCOMP - LOCA_10"
"IHCOMPDIM";"S";"0255";"                        LOCA_HCOMP = LOCA_10"
"IHCOMPDIM";"S";"0256";"                     FINSI"
"IHCOMPDIM";"S";"0257";"** calcul des heures complementaires taux 1"
"IHCOMPDIM";"S";"0258";"                     HJOU_IJQHSNMAPA = LOCA_HCOMP"
"IHCOMPDIM";"S";"0259";"*"
"IHCOMPDIM";"S";"0260";"* Dépassement de l'horaire hebdo temps plein"
"IHCOMPDIM";"S";"0261";"                     SI HJOU_IJRBHSMPAH > LOCA_HORCOH"
"IHCOMPDIM";"S";"0262";"                        ANOMALIE 171"
"IHCOMPDIM";"S";"0263";"                     FINSI"
"IHCOMPDIM";"S";"0264";"* Anomalie en cas de dépassement de 10% du contrat"
"IHCOMPDIM";"S";"0265";"                     LOCA_CAL2 = HJOU_IJRBHSMPAH - LOCA_HORHEB"
"IHCOMPDIM";"S";"0266";"                     SI LOCA_CAL2 > LOCA_10"
"IHCOMPDIM";"S";"0267";"                        ANOMALIE 225"
"IHCOMPDIM";"S";"0268";"                     FINSI"
"IHCOMPDIM";"S";"0269";"*"
"IHCOMPDIM";"S";"0270";"                     POUR ACTIVITES"
"IHCOMPDIM";"S";"0271";"* Taux 1"
"IHCOMPDIM";"S";"0272";"                        SI HABS_MOTIF = ""XCOP"""
"IHCOMPDIM";"S";"0273";"                           HJOU_IJQHSNMAPA = HJOU_IJQHSNMAPA + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0274";"                        FINSI"
"IHCOMPDIM";"S";"0275";"                        SI HABS_MOTIF = ""ZCOP"""
"IHCOMPDIM";"S";"0276";"                           HJOU_IJQHSNMAPA = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0277";"                        FINSI"
"IHCOMPDIM";"S";"0278";"* Taux 2"
"IHCOMPDIM";"S";"0279";"                        SI HABS_MOTIF = ""XCOP2"""
"IHCOMPDIM";"S";"0280";"                           HJOU_IJQHSNMAP2 = HJOU_IJQHSNMAP2 + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0281";"                        FINSI"
"IHCOMPDIM";"S";"0282";"                        SI HABS_MOTIF = ""ZCOP2"""
"IHCOMPDIM";"S";"0283";"                           HJOU_IJQHSNMAP2 = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0284";"                        FINSI"
"IHCOMPDIM";"S";"0285";"                     FINPOUR"
"IHCOMPDIM";"S";"0286";"* Taux 1"
"IHCOMPDIM";"S";"0287";"                     HJOU_IJQHCNMAPA = HJOU_IJQHCNMAPA - HJOU_IJQHSNMAPA"
"IHCOMPDIM";"S";"0288";"* Taux 2"
"IHCOMPDIM";"S";"0289";"                     HJOU_IJQHCNMAPA = HJOU_IJQHCNMAPA - HJOU_IJQHSNMAP2"
"IHCOMPDIM";"S";"0290";"*"
"IHCOMPDIM";"S";"0291";"** cas ou les heures complementaires sont à recuperer"
"IHCOMPDIM";"S";"0292";"                     SI HJOU_IJIGHSUPPR = ""1"""
"IHCOMPDIM";"S";"0293";"** à compter du 01/01/2014 elles sont majorées de 10%"
"IHCOMPDIM";"S";"0294";"                        SI HJOU_DATE >= ""01012014"""
"IHCOMPDIM";"S";"0295";"                           HJOU_IJQHSNMAPA = HJOU_IJQHSNMAPA * LOCA_TAUXC"
"IHCOMPDIM";"S";"0296";"                        FINSI"
"IHCOMPDIM";"S";"0297";"                        HJOU_IJQHSNMARE = HJOU_IJQHSNMAPA"
"IHCOMPDIM";"S";"0298";"                        HJOU_IJQHSNMAPA = 0"
"IHCOMPDIM";"S";"0299";"* Ajout de la majoration taux 2 pour les heures à récupérer"
"IHCOMPDIM";"S";"0300";"                        HJOU_IJQHSNMAP2 = HJOU_IJQHSNMAP2 * LOCA_TAUXC2"
"IHCOMPDIM";"S";"0301";"* HJOU_XXXX3 = HC à récup. taux 2"
"IHCOMPDIM";"S";"0302";"                        HJOU_IJQHSNMAR2 = HJOU_IJQHSNMAP2"
"IHCOMPDIM";"S";"0303";"                        HJOU_IJQHSNMAP2 = 0"
"IHCOMPDIM";"S";"0304";"*"
"IHCOMPDIM";"S";"0305";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMARE"
"IHCOMPDIM";"S";"0306";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMAR2"
"IHCOMPDIM";"S";"0307";"                     FINSI"
"IHCOMPDIM";"S";"0308";"                  FINSI"
"IHCOMPDIM";"S";"0309";"*"
"IHCOMPDIM";"S";"0310";"                  SI HJOU_IJQHCNMAPA < 0"
"IHCOMPDIM";"S";"0311";"                     ANOMALIE 192"
"IHCOMPDIM";"S";"0312";"                  FINSI"
"IHCOMPDIM";"S";"0313";"               FINSI"
"IHCOMPDIM";"S";"0314";"            FINSI"
"IHCOMPDIM";"S";"0315";"         FINSI"
"IHCOMPDIM";"S";"0316";"*"
"IHCOMPDIM";"S";"0317";"         POUR ACTIVITES"
"IHCOMPDIM";"S";"0318";"            SI HABS_MOTIF = PARD_IDIVMOTHSR"
"IHCOMPDIM";"S";"0319";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HABS_MOTIDUR"
"IHCOMPDIM";"S";"0320";"               LOCA_CONSO = 1"
"IHCOMPDIM";"S";"0321";"            FINSI"
"IHCOMPDIM";"S";"0322";"            SI HABS_MOTIF = ""ZHCP"""
"IHCOMPDIM";"S";"0323";"               HJOU_IJQHCNMAPA = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0324";"            FINSI"
"IHCOMPDIM";"S";"0325";"* Taux 1"
"IHCOMPDIM";"S";"0326";"            SI HABS_MOTIF = ""XCOR"""
"IHCOMPDIM";"S";"0327";"            OU HABS_MOTIF = ""ZCOR"""
"IHCOMPDIM";"S";"0328";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_IJQHSNMARE"
"IHCOMPDIM";"S";"0329";"               SI HABS_MOTIF = ""XCOR"""
"IHCOMPDIM";"S";"0330";"                  HJOU_IJQHSNMARE = HJOU_IJQHSNMARE + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0331";"               FINSI"
"IHCOMPDIM";"S";"0332";"               SI HABS_MOTIF = ""ZCOR"""
"IHCOMPDIM";"S";"0333";"                  HJOU_IJQHSNMARE = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0334";"               FINSI"
"IHCOMPDIM";"S";"0335";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMARE"
"IHCOMPDIM";"S";"0336";"            FINSI"
"IHCOMPDIM";"S";"0337";"* Taux 2"
"IHCOMPDIM";"S";"0338";"            SI HABS_MOTIF = ""XCOR2"""
"IHCOMPDIM";"S";"0339";"            OU HABS_MOTIF = ""ZCOR2"""
"IHCOMPDIM";"S";"0340";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_IJQHSNMAR2"
"IHCOMPDIM";"S";"0341";"               SI HABS_MOTIF = ""XCOR2"""
"IHCOMPDIM";"S";"0342";"                  HJOU_IJQHSNMAR2 = HJOU_IJQHSNMAR2 + HABS_MOTIDUR"
"IHCOMPDIM";"S";"0343";"               FINSI"
"IHCOMPDIM";"S";"0344";"               SI HABS_MOTIF = ""ZCOR2"""
"IHCOMPDIM";"S";"0345";"                  HJOU_IJQHSNMAR2 = HABS_MOTIDUR"
"IHCOMPDIM";"S";"0346";"               FINSI"
"IHCOMPDIM";"S";"0347";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHSNMAR2"
"IHCOMPDIM";"S";"0348";"            FINSI"
"IHCOMPDIM";"S";"0349";"         FINPOUR"
"IHCOMPDIM";"S";"0350";"*"
"IHCOMPDIM";"S";"0351";"         SI LOCA_CONSO = 1"
"IHCOMPDIM";"S";"0352";"            SI HJOU_IJRSHSMREH < 0"
"IHCOMPDIM";"S";"0353";"               ANOMALIE 226"
"IHCOMPDIM";"S";"0354";"               TEMP_CNRETOUR = 2"
"IHCOMPDIM";"S";"0355";"               TEMP_CNMESS = 226"
"IHCOMPDIM";"S";"0356";"            FINSI"
"IHCOMPDIM";"S";"0357";"         FINSI"
"IHCOMPDIM";"S";"0358";"      FINSI"
"IHCOMPDIM";"S";"0359";"**"
"IHCOMPDIM";"S";"0360";"** Soldes previsionnels"
"IHCOMPDIM";"S";"0361";"**"
"IHCOMPDIM";"S";"0362";"      SI CTRA_DATFIN > TEMP_DATJOU"
"IHCOMPDIM";"S";"0363";"         SI CTRA_DATFIN < LOCA_DATEFU"
"IHCOMPDIM";"S";"0364";"            DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHCOMPDIM";"S";"0365";"            LOCA_DATEFU = TEMP_DXFINPER"
"IHCOMPDIM";"S";"0366";"         SINON"
"IHCOMPDIM";"S";"0367";"            SI CTRA_DATFIN < LOCA_DATEFU2"
"IHCOMPDIM";"S";"0368";"               DATAJT CTRA_DATFIN 12 ""J"" 1"
"IHCOMPDIM";"S";"0369";"               LOCA_DATEFU2 = TEMP_DXFINPER"
"IHCOMPDIM";"S";"0370";"            FINSI"
"IHCOMPDIM";"S";"0371";"         FINSI"
"IHCOMPDIM";"S";"0372";"      FINSI"
"IHCOMPDIM";"S";"0373";"***"
"IHCOMPDIM";"S";"0374";"      SI TEMP_DATSUI = LOCA_DATEFU"
"IHCOMPDIM";"S";"0375";"         EMPL_IEQSHSMRE1 = HJOU_IJRSHSMREH"
"IHCOMPDIM";"S";"0376";"      FINSI"
"IHCOMPDIM";"S";"0377";"**"
"IHCOMPDIM";"S";"0378";"      SI TEMP_DATSUI = LOCA_DATEFU2"
"IHCOMPDIM";"S";"0379";"         EMPL_IEQSHSMRE2 = HJOU_IJRSHSMREH"
"IHCOMPDIM";"S";"0380";"      FINSI"
"IHCOMPDIM";"S";"0381";"   FINSI"
"IHCOMPDIM";"S";"0382";"FINSI"
"IHCOMPDIM";"S";"0383";"*"
"IHCOMPDIM";"S";"0384";"FIN"
"IHNUIT";"S";"0001";"***********************************************************************"
"IHNUIT";"S";"0002";"*"
"IHNUIT";"S";"0003";"* Règle : IHNUIT"
"IHNUIT";"S";"0004";"* Ordre : 6000"
"IHNUIT";"S";"0005";"* Titre : Calcul des heures de nuit"
"IHNUIT";"S";"0006";"*"
"IHNUIT";"S";"0007";"*----------------------------------------------------------------------"
"IHNUIT";"S";"0008";"*"
"IHNUIT";"S";"0009";"* Créé par : Cellule Industrialisation"
"IHNUIT";"S";"0010";"* Date     : 03/09/2009"
"IHNUIT";"S";"0011";"* Version  : 1"
"IHNUIT";"S";"0012";"*"
"IHNUIT";"S";"0013";"*----------------------------------------------------------------------"
"IHNUIT";"S";"0014";"*"
"IHNUIT";"S";"0015";"*"
"IHNUIT";"S";"0016";"* Rôle : Calcul des heures de nuit"
"IHNUIT";"S";"0017";"*"
"IHNUIT";"S";"0018";"*"
"IHNUIT";"S";"0019";"*"
"IHNUIT";"S";"0020";"*"
"IHNUIT";"S";"0021";"*"
"IHNUIT";"S";"0022";"*----------------------------------------------------------------------"
"IHNUIT";"S";"0023";"*"
"IHNUIT";"S";"0024";"* Modifiée par : Méthodes et outils"
"IHNUIT";"S";"0025";"* Date         : 08/04/2019"
"IHNUIT";"S";"0026";"* Objet        : Lorsque l'heure de début et de fin de nuit étaient"
"IHNUIT";"S";"0027";"*                renseignées dans le profil,"
"IHNUIT";"S";"0028";"*                le compteur ""Heures de nuit payées"" (HJOU_IJQHNUITTO)"
"IHNUIT";"S";"0029";"*                s'alimentait de la présence badgée validée (pour les"
"IHNUIT";"S";"0030";"*                non badgeants et dans le futur pour tous le monde)"
"IHNUIT";"S";"0031";"*"
"IHNUIT";"S";"0032";"***********************************************************************"
"IHNUIT";"S";"0033";"*"
"IHNUIT";"S";"0034";"* Implémentation des données industrielles"
"IHNUIT";"S";"0035";"*"
"IHNUIT";"S";"0036";"DEBDICO"
"IHNUIT";"S";"0037";"   HJOU_IJQHNUITTO;N;T6,2;I;;;     6789;;;V3;""Heures de nuit payées"";"
"IHNUIT";"S";"0038";"   TEMP_ITQNUITMOT;N;T6,2;I;;;      789;;;V3;""Heures de nuit maintenues par motif"";"
"IHNUIT";"S";"0039";"FINDICO"
"IHNUIT";"S";"0040";"*"
"IHNUIT";"S";"0041";"* Déclaration des donnees locales"
"IHNUIT";"S";"0042";"*"
"IHNUIT";"S";"0043";"DEF LOCA_INBADG Z1"
"IHNUIT";"S";"0044";"LOCA_INBADG = ""0"""
"IHNUIT";"S";"0045";"DEF LOCA_NUIT T6.2"
"IHNUIT";"S";"0046";"LOCA_NUIT = 0"
"IHNUIT";"S";"0047";"DEF LOCA_FINNUIT T6.2"
"IHNUIT";"S";"0048";"LOCA_FINNUIT = 0"
"IHNUIT";"S";"0049";"DEF LOCA_NUITM T6.2"
"IHNUIT";"S";"0050";"LOCA_NUITM = 0"
"IHNUIT";"S";"0051";"DEF LOCA_NUITT T6.2"
"IHNUIT";"S";"0052";"LOCA_NUITT = 0"
"IHNUIT";"S";"0053";"*"
"IHNUIT";"S";"0054";"SI HJOU_DATE <= TEMP_DATJOU"
"IHNUIT";"S";"0055";"   LOCA_INBADG = HJOU_IJIGBADGEA"
"IHNUIT";"S";"0056";"SINON"
"IHNUIT";"S";"0057";"   LOCA_INBADG = ""0"""
"IHNUIT";"S";"0058";"FINSI"
"IHNUIT";"S";"0059";"* pour les badgeants, jusqu'à la date du jour"
"IHNUIT";"S";"0060";"* les heures de nuit correspondent aux heures de nuit réelles"
"IHNUIT";"S";"0061";"HJOU_IJQHNUITTO = HJOU_IJQHNUITBA"
"IHNUIT";"S";"0062";"* pour les non badgeants et les badgeants si la date est dans le futur"
"IHNUIT";"S";"0063";"* les heures de nuit sont calculées d'apres les bornes de nuit définie"
"IHNUIT";"S";"0064";"* dans le profil horaire mais limitée à HJPOINV"
"IHNUIT";"S";"0065";"* SI LOCA_INBADG = ""0"""
"IHNUIT";"S";"0066";"* SI PROF_DEBNUIT > PROF_FINNUIT"
"IHNUIT";"S";"0067";"* LOCA_FINNUIT = PROF_FINNUIT + 24.00"
"IHNUIT";"S";"0068";"* LOCA_NUIT = LOCA_FINNUIT - PROF_DEBNUIT"
"IHNUIT";"S";"0069";"* SINON"
"IHNUIT";"S";"0070";"* LOCA_NUIT = PROF_FINNUIT - PROF_DEBNUIT"
"IHNUIT";"S";"0071";"* FINSI"
"IHNUIT";"S";"0072";"* SI LOCA_NUIT >= HJOU_IJQPRESBAV"
"IHNUIT";"S";"0073";"* LOCA_NUIT = HJOU_IJQPRESBAV"
"IHNUIT";"S";"0074";"* FINSI"
"IHNUIT";"S";"0075";"* HJOU_IJQHNUITTO = LOCA_NUIT"
"IHNUIT";"S";"0076";"* FINSI"
"IHNUIT";"S";"0077";"**"
"IHNUIT";"S";"0078";"** Ajout de la valeur des motifs qui maintiennent les heures de nuit"
"IHNUIT";"S";"0079";"**"
"IHNUIT";"S";"0080";"POUR ACTIVITES"
"IHNUIT";"S";"0081";"   SI MOTI_MOTYPE <> ""C"""
"IHNUIT";"S";"0082";"      SI MOTI_IMIGHNUITT = ""1"""
"IHNUIT";"S";"0083";"         SI PROF_IPIGHNUIMA > 0"
"IHNUIT";"S";"0084";"            SI HJOU_IJQHNUITTO <= PROF_IPIGHNUIMA"
"IHNUIT";"S";"0085";"               LOCA_NUITT = HJOU_IJQHNUITTO + HABS_MOTIDUR"
"IHNUIT";"S";"0086";"               SI LOCA_NUITT >= PROF_IPIGHNUIMA"
"IHNUIT";"S";"0087";"                  LOCA_NUITT = PROF_IPIGHNUIMA"
"IHNUIT";"S";"0088";"               FINSI"
"IHNUIT";"S";"0089";"               LOCA_NUITM = LOCA_NUITT - HJOU_IJQHNUITTO"
"IHNUIT";"S";"0090";"               TEMP_ITQNUITMOT = TEMP_ITQNUITMOT + LOCA_NUITM"
"IHNUIT";"S";"0091";"               HJOU_IJQHNUITTO = HJOU_IJQHNUITTO + LOCA_NUITM"
"IHNUIT";"S";"0092";"            FINSI"
"IHNUIT";"S";"0093";"         FINSI"
"IHNUIT";"S";"0094";"      FINSI"
"IHNUIT";"S";"0095";"   FINSI"
"IHNUIT";"S";"0096";"FINPOUR"
"IHNUIT";"S";"0097";"*"
"IHNUIT";"S";"0098";"*  analyse des consignes d'init et de MAJ"
"IHNUIT";"S";"0099";"*"
"IHNUIT";"S";"0100";"POUR ACTIVITES"
"IHNUIT";"S";"0101";"   SI HABS_MOTIF = ""XNUI"""
"IHNUIT";"S";"0102";"      HJOU_IJQHNUITTO = HJOU_IJQHNUITTO + HABS_MOTIDUR"
"IHNUIT";"S";"0103";"   FINSI"
"IHNUIT";"S";"0104";"   SI HABS_MOTIF = ""ZNUI"""
"IHNUIT";"S";"0105";"      HJOU_IJQHNUITTO = HABS_MOTIDUR"
"IHNUIT";"S";"0106";"   FINSI"
"IHNUIT";"S";"0107";"FINPOUR"
"IHNUIT";"S";"0108";"FIN"
"IHREFF";"S";"0001";"***********************************************************************"
"IHREFF";"S";"0002";"*"
"IHREFF";"S";"0003";"* Règle : IHREFF"
"IHREFF";"S";"0004";"* Ordre : 3320"
"IHREFF";"S";"0005";"* Titre : Heures effectives"
"IHREFF";"S";"0006";"*"
"IHREFF";"S";"0007";"*----------------------------------------------------------------------"
