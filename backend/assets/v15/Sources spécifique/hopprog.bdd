"SGASTR";"S";"0396";"SI LOCA_TYPAST = ""JLS"""
"SGASTR";"S";"0397";"*"
"SGASTR";"S";"0398";"   SI LOCA_AST = 1"
"SGASTR";"S";"0399";"* Cas particulier service REDMON140"
"SGASTR";"S";"0400";"      SI HJOU_SECTORI = ""REDMON140"""
"SGASTR";"S";"0401";"         HJOU_SJQAST5239 = LOCA_COUNTAST"
"SGASTR";"S";"0402";"         SI HJOU_SJQAST5239 > 2"
"SGASTR";"S";"0403";"            HJOU_SJQAST5239 = 2"
"SGASTR";"S";"0404";"         FINSI"
"SGASTR";"S";"0405";"      SINON"
"SGASTR";"S";"0406";"         HJOU_SJQAST5239 = 1"
"SGASTR";"S";"0407";"      FINSI"
"SGASTR";"S";"0408";"*"
"SGASTR";"S";"0409";"* Spécificité pour la société BE"
"SGASTR";"S";"0410";"      SI HJOU_SJQSOCIETE = ""BE"""
"SGASTR";"S";"0411";"         HJOU_SJQPRAST = 1"
"SGASTR";"S";"0412";"         HJOU_SJQAST5239 = 0"
"SGASTR";"S";"0413";"      FINSI"
"SGASTR";"S";"0414";"*"
"SGASTR";"S";"0415";"* Spécificité pour la société EC"
