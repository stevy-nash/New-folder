"AADECL2";"C";"0091";"/*  Le domaine DEBG est-il utilise         */"
"AADECL2";"C";"0092";"       CMPBLAP(B) TEMP_CNORIG,""DEBG"",' '/NEQ(.UTIL_DOM_DEBG);"
"AADECL2";"C";"0093";"       CPYNV TEMP_CNRETOUR,<DEBG>;"
"AADECL2";"C";"0094";"       B .END;"
"AADECL2";"C";"0095";".UTIL_DOM_DEBG:;"
"AADECL2";"C";"0096";"/*  Le domaine SECH est-il utilise         */"
"AADECL2";"C";"0097";"       CMPBLAP(B) TEMP_CNORIG,""SECH"",' '/NEQ(.UTIL_DOM_SECH);"
"AADECL2";"C";"0098";"       CPYNV TEMP_CNRETOUR,<SECH>;"
"AADECL2";"C";"0099";"       B .END;"
"AADECL2";"C";"0100";".UTIL_DOM_SECH:;"
"AADECL2";"C";"0101";"/*  Le domaine POST est-il utilise         */"
"AADECL2";"C";"0102";"       CMPBLAP(B) TEMP_CNORIG,""POST"",' '/NEQ(.UTIL_DOM_POST);"
"AADECL2";"C";"0103";"       CPYNV TEMP_CNRETOUR,<POST>;"
"AADECL2";"C";"0104";"       B .END;"
"AADECL2";"C";"0105";".UTIL_DOM_POST:;"
"AADECL2";"C";"0106";"/*  Le domaine CRPL est-il utilise         */"
"AADECL2";"C";"0107";"       CMPBLAP(B) TEMP_CNORIG,""CRPL"",' '/NEQ(.UTIL_DOM_CRPL);"
"AADECL2";"C";"0108";"       CPYNV TEMP_CNRETOUR,<CRPL>;"
"AADECL2";"C";"0109";"       B .END;"
"AADECL2";"C";"0110";".UTIL_DOM_CRPL:;"
"AADECL2";"C";"0111";"/*  Le domaine ENFT est-il utilise         */"
"AADECL2";"C";"0112";"       CMPBLAP(B) TEMP_CNORIG,""ENFT"",' '/NEQ(.UTIL_DOM_ENFT);"
"AADECL2";"C";"0113";"       CPYNV TEMP_CNRETOUR,<ENFT>;"
"AADECL2";"C";"0114";"       B .END;"
"AADECL2";"C";"0115";".UTIL_DOM_ENFT:;"
"AADECL2";"C";"0116";"/*  Le domaine WABS est-il utilise         */"
"AADECL2";"C";"0117";"       CMPBLAP(B) TEMP_CNORIG,""WABS"",' '/NEQ(.UTIL_DOM_WABS);"
"AADECL2";"C";"0118";"       CPYNV TEMP_CNRETOUR,<WABS>;"
"AADECL2";"C";"0119";"       B .END;"
"AADECL2";"C";"0120";".UTIL_DOM_WABS:;"
"AADECL2";"C";"0121";"/*  Le domaine SECA est-il utilise         */"
"AADECL2";"C";"0122";"       CMPBLAP(B) TEMP_CNORIG,""SECA"",' '/NEQ(.UTIL_DOM_SECA);"
"AADECL2";"C";"0123";"       CPYNV TEMP_CNRETOUR,<SECA>;"
"AADECL2";"C";"0124";"       B .END;"
"AADECL2";"C";"0125";".UTIL_DOM_SECA:;"
"AADECL2";"C";"0126";"/*  Le domaine TAUX est-il utilise         */"
"AADECL2";"C";"0127";"       CMPBLAP(B) TEMP_CNORIG,""TAUX"",' '/NEQ(.UTIL_DOM_TAUX);"
"AADECL2";"C";"0128";"       CPYNV TEMP_CNRETOUR,<TAUX>;"
"AADECL2";"C";"0129";"       B .END;"
"AADECL2";"C";"0130";".UTIL_DOM_TAUX:;"
"AADECL2";"C";"0131";"       CMPNV(B) TEMP_NIVEAU,2/LO(&NIVEAU.1);"
"AADECL2";"C";"0132";"       CMPNV(B) TEMP_NIVEAU,3/LO(&NIVEAU.2);"
"AADECL2";"C";"0133";"       B        &NIVEAU.3;"
