"SACQCPAN";"S";"0504";"*"
"SACQCPAN";"S";"0505";"SI HJOU_SJIDATANCF <> "" """
"SACQCPAN";"S";"0506";"   HJOU_SJRDATANCC = HJOU_SJIDATANCF"
"SACQCPAN";"S";"0507";"FINSI"
"SACQCPAN";"S";"0508";"*"
"SACQCPAN";"S";"0509";"****** Acquisition à date de référence des congés d'ancienneté >> **********************************"
"SACQCPAN";"S";"0510";"*"
"SACQCPAN";"S";"0511";"SI HJOU_DATE = LOCA_DATE"
"SACQCPAN";"S";"0512";"*"
"SACQCPAN";"S";"0513";"* Gestion des acquis temporaire au 01/01/2025 >>"
"SACQCPAN";"S";"0514";"   LOCA_DRANCT = HJOU_SJRACQANCT"
"SACQCPAN";"S";"0515";"   HJOU_SJRACQANCT = 0"
"SACQCPAN";"S";"0516";"*"
"SACQCPAN";"S";"0517";"   LOCA_DRANC = LOCA_DRANC + LOCA_DRANCT"
"SACQCPAN";"S";"0518";"   LOCA_DRANC = LOCA_DRANC + HJOU_SJRDANCACQ"
"SACQCPAN";"S";"0519";"*"
"SACQCPAN";"S";"0520";"   SI LOCA_LOT = 1"
"SACQCPAN";"S";"0521";"      SI HJOU_DATE > CONF_SDIDATDEM"
"SACQCPAN";"S";"0522";"         HJOU_IJRDCOANCI = LOCA_DRANC"
"SACQCPAN";"S";"0523";"      FINSI"
"SACQCPAN";"S";"0524";"   FINSI"
"SACQCPAN";"S";"0525";"*"
"SACQCPAN";"S";"0526";"   SI LOCA_LOT = 2"
"SACQCPAN";"S";"0527";"* JJA - 29/09/2025 - FFT025006393 : Calcul après démarrage du LOT 2 >>"
"SACQCPAN";"S";"0528";"      SI HJOU_DATE(1:8) >= ""20251001"""
"SACQCPAN";"S";"0529";"         HJOU_IJRDCOANCI = LOCA_DRANC"
"SACQCPAN";"S";"0530";"      SINON"
"SACQCPAN";"S";"0531";"         HJOU_IJRDCOANCI = 0"
"SACQCPAN";"S";"0532";"      FINSI"
"SACQCPAN";"S";"0533";"   FINSI"
"SACQCPAN";"S";"0534";"*"
"SACQCPAN";"S";"0535";"* Remise à zéro du pris"
"SACQCPAN";"S";"0536";"   HJOU_IJRCCOANCI = 0"
"SACQCPAN";"S";"0537";"   HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"SACQCPAN";"S";"0538";"*"
"SACQCPAN";"S";"0539";"FINSI"
"SACQCPAN";"S";"0540";"*"
"SACQCPAN";"S";"0541";"* GESTION CONSIGNES D'INIT. ET MAJ"
"SACQCPAN";"S";"0542";"POUR ACTIVITES"
"SACQCPAN";"S";"0543";"* consignes de MAJ du droit congés d'ancienneté"
"SACQCPAN";"S";"0544";"   SI HABS_MOTIF = ""XDCA"""
"SACQCPAN";"S";"0545";"      LOCA_CA = 1"
"SACQCPAN";"S";"0546";"      HJOU_IJRDCOANCI = HJOU_IJRDCOANCI + HABS_MOTINBR"
"SACQCPAN";"S";"0547";"   FINSI"
"SACQCPAN";"S";"0548";"* Droit congé d'ancienneté"
"SACQCPAN";"S";"0549";"   SI HABS_MOTIF = ""ZDCA"""
"SACQCPAN";"S";"0550";"      LOCA_CA = 1"
"SACQCPAN";"S";"0551";"      HJOU_IJRDCOANCI = HABS_MOTINBR"
"SACQCPAN";"S";"0552";"   FINSI"
"SACQCPAN";"S";"0553";"FINPOUR"
"SACQCPAN";"S";"0554";"*"
"SACQCPAN";"S";"0555";"* Solde"
"SACQCPAN";"S";"0556";"HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"SACQCPAN";"S";"0557";"*"
"SACQCPAN";"S";"0558";"SI LOCA_CA = 1"
"SACQCPAN";"S";"0559";"   SI HJOU_IJRSCOANCI < 0"
"SACQCPAN";"S";"0560";"      ANOMALIE 168"
"SACQCPAN";"S";"0561";"   FINSI"
"SACQCPAN";"S";"0562";"FINSI"
"SACQCPAN";"S";"0563";"*"
"SACQCPAN";"S";"0564";"FIN"
"SACQCPAN";"S";"0565";"*"
"SACQCPAN";"S";"0566";"****** PROCDURE >> ******"
"SACQCPAN";"S";"0567";"PROC CHANGE"
"SACQCPAN";"S";"0568";"*"
"SACQCPAN";"S";"0569";"* Init local"
"SACQCPAN";"S";"0570";"   DEF LOCA_SJQMODANC A3"
"SACQCPAN";"S";"0571";"   LOCA_SJQMODANC = "" """
"SACQCPAN";"S";"0572";"*"
"SACQCPAN";"S";"0573";"* Vérif si changement >>"
"SACQCPAN";"S";"0574";"   SI HJOU_SJRDDEBCTR <> HJOU_DATE"
"SACQCPAN";"S";"0575";"      LIREVALPRE LOCA_SJQMODANC HJOU_SJQMODANC"
"SACQCPAN";"S";"0576";"      SI LOCA_SJQMODANC <> "" """
"SACQCPAN";"S";"0577";"         SI LOCA_SJQMODANC <> HJOU_SJQMODANC"
"SACQCPAN";"S";"0578";"* Si changement => nouveau calcul de date ancienneté"
"SACQCPAN";"S";"0579";"            HJOU_SJRDATANCC = HJOU_DATE"
"SACQCPAN";"S";"0580";"            SI HJOU_SJRACQANCT > 0"
"SACQCPAN";"S";"0581";"               HJOU_SJRDANCACQ = HJOU_SJRACQANCT"
"SACQCPAN";"S";"0582";"               HJOU_SJRACQANCT = 0"
"SACQCPAN";"S";"0583";"            SINON"
"SACQCPAN";"S";"0584";"               HJOU_SJRDANCACQ = HJOU_IJRDCOANCI"
"SACQCPAN";"S";"0585";"            FINSI"
"SACQCPAN";"S";"0586";"         FINSI"
"SACQCPAN";"S";"0587";"      FINSI"
"SACQCPAN";"S";"0588";"   FINSI"
"SACQCPAN";"S";"0589";"*"
"SACQCPAN";"S";"0590";"FINPROC"
