"SACQCP";"S";"0011";"* Version  : 1"
"SACQCP";"S";"0012";"*"
"SACQCP";"S";"0013";"*----------------------------------------------------------------------"
"SACQCP";"S";"0014";"*"
"SACQCP";"S";"0015";"*"
"SACQCP";"S";"0016";"* Rôle : Gestion de l'acquisition des congés payés avec maintiens"
"SACQCP";"S";"0017";"*        Pas de gestion de reliquat"
"SACQCP";"S";"0018";"*        + règle des reports en cas d'arrêt maladie"
"SACQCP";"S";"0019";"*"
"SACQCP";"S";"0020";"*        On intègre l'init ou mise à jour des droits CFRAC par consigne"
"SACQCP";"S";"0021";"*"
"SACQCP";"S";"0022";"*"
"SACQCP";"S";"0023";"*----------------------------------------------------------------------"
"SACQCP";"S";"0024";"*"
"SACQCP";"S";"0025";"* Modifiée par :"
"SACQCP";"S";"0026";"* Date         :"
"SACQCP";"S";"0027";"* Objet        :"
"SACQCP";"S";"0028";"*"
"SACQCP";"S";"0029";"***********************************************************************"
"SACQCP";"S";"0030";"*"
"SACQCP";"S";"0031";"DEBDICO"
"SACQCP";"S";"0032";"   HJOU_IJRSCORELI;N;N6,1;I;;;    56789;;IJRSCORELI;V3;""Reliquat congé payé"";"
