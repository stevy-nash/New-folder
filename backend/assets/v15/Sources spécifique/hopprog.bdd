"ITPSACTPT3";"S";"0058";"        * Calcul de la présence activité"
"ITPSACTPT3";"S";"0059";"        SI PRES_VALID <> ""O"""
"ITPSACTPT3";"S";"0060";"            PRES_VALID = ""N"""
"ITPSACTPT3";"S";"0061";"            PRES_CLE_POP = HJOU_SECTORI"
