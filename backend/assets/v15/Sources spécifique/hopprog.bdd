"IMISSB";"S";"0058";"LOCA_ABS = 0"
"IMISSB";"S";"0059";"DEF LOCA_ACTM N1"
"IMISSB";"S";"0060";"LOCA_ACTM = 0"
"IMISSB";"S";"0061";"*"
"IMISSB";"S";"0062";"SI HJOU_IJRF3PRBHS = ""1"""
"IMISSB";"S";"0063";"   LOCA_TOTMISS = HJOU_IJQMISSRET"
"IMISSB";"S";"0064";"FINSI"
"IMISSB";"S";"0065";"LOCA_TOTMISS = LOCA_TOTMISS + HJOU_IJQMISBADG"
"IMISSB";"S";"0066";"SI PARD_IDIVMOMIBL = "" """
"IMISSB";"S";"0067";"   LOCA_MISSBADL = ""MISS"""
"IMISSB";"S";"0068";"SINON"
"IMISSB";"S";"0069";"   LOCA_MISSBADL = PARD_IDIVMOMIBL"
"IMISSB";"S";"0070";"FINSI"
"IMISSB";"S";"0071";"SI PARD_IDIVMOMISB = "" """
"IMISSB";"S";"0072";"   LOCA_MISSBAD = ""MISS"""
"IMISSB";"S";"0073";"SINON"
"IMISSB";"S";"0074";"   LOCA_MISSBAD = PARD_IDIVMOMISB"
"IMISSB";"S";"0075";"FINSI"
"IMISSB";"S";"0076";"ENLEVER LOCA_MISSBAD"
"IMISSB";"S";"0077";"ENLEVER LOCA_MISSBADL"
"IMISSB";"S";"0078";"SI HJOU_DATE <= TEMP_DATJOU"
"IMISSB";"S";"0079";"* si le compteur HJECREPL > 0 cela indique"
"IMISSB";"S";"0080";"* que le premier mouvement de la journée"
"IMISSB";"S";"0081";"* est une entree dans la plage DJ"
"IMISSB";"S";"0082";"* et qu'il n'y a pas d'autres mvts dans la plage DJ"
"IMISSB";"S";"0083";"* si HJMISSR = 1 cela veut dire que c'est un retour"
"IMISSB";"S";"0084";"* mission sur un depart fait la veille et dans ce cas"
"IMISSB";"S";"0085";"* l'ecart pause repas doit être alimenté avaec la valeur de"
"IMISSB";"S";"0086";"* la coupure minimum"
"IMISSB";"S";"0087";"   SI HJOU_IJRF3PRBHS = ""1"""
"IMISSB";"S";"0088";"      SI HJOU_IJQECPAUML > 0"
"IMISSB";"S";"0089";"* test si pas d'absence matin"
"IMISSB";"S";"0090";"         POUR ACTIVITES"
"IMISSB";"S";"0091";"            SI HABS_VALORIS = ""M"""
"IMISSB";"S";"0092";"               LOCA_ACTM = 1"
"IMISSB";"S";"0093";"            FINSI"
"IMISSB";"S";"0094";"         FINPOUR"
"IMISSB";"S";"0095";"         SI LOCA_ACTM = 0"
"IMISSB";"S";"0096";"            HJOU_IJQPAUMERI = 0"
"IMISSB";"S";"0097";"            HJOU_IJQECPAUSM = HJOU_IJQECPAUML"
"IMISSB";"S";"0098";"            HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQECPAUSM"
"IMISSB";"S";"0099";"            HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQECPAUSM"
"IMISSB";"S";"0100";"            ANOMALIE 114"
"IMISSB";"S";"0101";"         FINSI"
"IMISSB";"S";"0102";"      FINSI"
"IMISSB";"S";"0103";"   FINSI"
"IMISSB";"S";"0104";"** alimentation de la donnée reportable HJMISSR"
"IMISSB";"S";"0105";"** avec la valeur de la donnée HJMISS"
"IMISSB";"S";"0106";"** on test avant si hjnpoin > 0 pour recuperer la"
"IMISSB";"S";"0107";"** valeur de HJMISS car il ne faut pas stocker la"
"IMISSB";"S";"0108";"** valeur de HJMISS sur le jour ou on a pas de badgeage"
"IMISSB";"S";"0109";"** car même si la veille elle etait initialisée à 1"
"IMISSB";"S";"0110";"** le lendemain, comme la valeur du report n'est pas alimentée, on"
"IMISSB";"S";"0111";"** stockerai 0 dans HJMISSR"
"IMISSB";"S";"0112";"   SI HJOU_IJQNBADGEA > 0"
"IMISSB";"S";"0113";"      HJOU_IJRF3PRBHS = HJOU_IJRF2PRBHS"
"IMISSB";"S";"0114";"   FINSI"
"IMISSB";"S";"0115";"   SI HJOU_INMISS = ""2"""
"IMISSB";"S";"0116";"   OU HJOU_INMISS = ""3"""
"IMISSB";"S";"0117";"      SI HJOU_IJRF3PRBHS = ""1"""
"IMISSB";"S";"0118";"         SI HJOU_IJQNBADGEA = 0"
"IMISSB";"S";"0119";"            LOCA_TOTMISS = HJOU_IJQPRETHEJ"
"IMISSB";"S";"0120";"            LOCA_ABS = 1"
"IMISSB";"S";"0121";"         FINSI"
"IMISSB";"S";"0122";"      FINSI"
"IMISSB";"S";"0123";"   FINSI"
"IMISSB";"S";"0124";"*  si l'indicateur INMISSBA = 1 cela indique"
"IMISSB";"S";"0125";"*  qu'il y a eu un depart mission sans retour sur la journee"
"IMISSB";"S";"0126";"*  et que le temps mission doit etre complete par rapport"
"IMISSB";"S";"0127";"*  a la theorie  en tenant compte de HJJOU"
"IMISSB";"S";"0128";"   SI HJOU_IJQFMISBAD = 1"
"IMISSB";"S";"0129";"      SI HJOU_IJQBHORVAJ < HJOU_IJQPRETHEJ"
"IMISSB";"S";"0130";"         LOCA_TOTMISS = HJOU_IJQPRETHEJ - HJOU_IJQBHORVAJ"
"IMISSB";"S";"0131";"      SINON"
"IMISSB";"S";"0132";"         LOCA_TOTMISS = 0"
"IMISSB";"S";"0133";"      FINSI"
"IMISSB";"S";"0134";"   FINSI"
"IMISSB";"S";"0135";"*  test si un motif est present"
"IMISSB";"S";"0136";"* il faut remettre HJMISSR à 0 car dans le cas ou il y un depart"
"IMISSB";"S";"0137";"* mission le lundi, qu'un motif est positionné le mardi"
"IMISSB";"S";"0138";"* il ne faut pas que le motif MISS se mette en place le mercredi"
"IMISSB";"S";"0139";"* si HJNPOIN = 0 par ce qu'on peut avoir un motif sur la journee ou"
"IMISSB";"S";"0140";"* on fait un depart mission"
"IMISSB";"S";"0141";"   POUR ACTIVITES"
"IMISSB";"S";"0142";"      SI HABS_MOTYPE <> ""C"""
"IMISSB";"S";"0143";"         SI HJOU_IJQNBADGEA = 0"
"IMISSB";"S";"0144";"            HJOU_IJRF3PRBHS = ""0"""
"IMISSB";"S";"0145";"            LOCA_MOTJOUR = 1"
"IMISSB";"S";"0146";"         FINSI"
"IMISSB";"S";"0147";"      FINSI"
"IMISSB";"S";"0148";"   FINPOUR"
"IMISSB";"S";"0149";"*  mise en place du motif"
"IMISSB";"S";"0150";"   SI LOCA_TOTMISS <> 0"
"IMISSB";"S";"0151";"* le motif est mis en place s'il n'existe pas de motifs"
"IMISSB";"S";"0152";"* qu'ils soient en H/M/A/J"
"IMISSB";"S";"0153";"      SI LOCA_MOTJOUR = 0"
"IMISSB";"S";"0154";"         HJOU_IJQHMISSJE = LOCA_TOTMISS"
"IMISSB";"S";"0155";"* alimentation du compteur HJNABS pour ne pas déclencher"
"IMISSB";"S";"0156";"* l'anomalie 103/106"
"IMISSB";"S";"0157";"         SI LOCA_ABS = 1"
"IMISSB";"S";"0158";"            HJOU_IJQNABSENT = 1"
"IMISSB";"S";"0159";"            HJOU_IJQNACTIVJ = 1"
"IMISSB";"S";"0160";"         FINSI"
"IMISSB";"S";"0161";"** le 27/06/2013"
"IMISSB";"S";"0162";"** alimentation des compteurs IJQNABSEN1 et IJQNABSEN2 pour ne pas declencher"
"IMISSB";"S";"0163";"** les anomalies 125 et 126"
"IMISSB";"S";"0164";"*"
"IMISSB";"S";"0165";"         HJOU_IJQNABSEN1 = HJOU_IJQNABSEN1 + 1"
"IMISSB";"S";"0166";"         HJOU_IJQNABSEN2 = HJOU_IJQNABSEN2 + 1"
"IMISSB";"S";"0167";"**"
"IMISSB";"S";"0168";"      FINSI"
"IMISSB";"S";"0169";"   FINSI"
"IMISSB";"S";"0170";"FINSI"
"IMISSB";"S";"0171";"FIN"
"IMISSD";"S";"0001";"***********************************************************************"
"IMISSD";"S";"0002";"*"
"IMISSD";"S";"0003";"* Règle : IMISSD"
"IMISSD";"S";"0004";"* Ordre : 3220"
"IMISSD";"S";"0005";"* Titre : Durée mission du lendemain"
"IMISSD";"S";"0006";"*"
"IMISSD";"S";"0007";"*----------------------------------------------------------------------"
"IMISSD";"S";"0008";"*"
"IMISSD";"S";"0009";"* Créé par : Cellule Industrialisation"
"IMISSD";"S";"0010";"* Date     : 03/09/2009"
"IMISSD";"S";"0011";"* Version  : 1"
"IMISSD";"S";"0012";"*"
"IMISSD";"S";"0013";"*----------------------------------------------------------------------"
"IMISSD";"S";"0014";"*"
"IMISSD";"S";"0015";"*"
"IMISSD";"S";"0016";"* Rôle : Durée mission du lendemain"
"IMISSD";"S";"0017";"*"
"IMISSD";"S";"0018";"*"
"IMISSD";"S";"0019";"*"
"IMISSD";"S";"0020";"*"
"IMISSD";"S";"0021";"*"
"IMISSD";"S";"0022";"*----------------------------------------------------------------------"
"IMISSD";"S";"0023";"*"
"IMISSD";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IMISSD";"S";"0025";"* Date         : JJ/MM/AAAA"
"IMISSD";"S";"0026";"* Objet        :"
"IMISSD";"S";"0027";"*"
"IMISSD";"S";"0028";"*----------------------------------------------------------------------"
"IMISSD";"S";"0029";"*"
"IMISSD";"S";"0030";"* Modifiée par : Méthodes et outils"
"IMISSD";"S";"0031";"* Date         : 28/08/2018"
"IMISSD";"S";"0032";"* Objet        : passage à 10 caractères des champs contenant des motifs BT43982"
"IMISSD";"S";"0033";"***********************************************************************"
"IMISSD";"S";"0034";"*"
"IMISSD";"S";"0035";"* Implémentation des données industrielles"
"IMISSD";"S";"0036";"*"
"IMISSD";"S";"0037";"DEBDICO"
"IMISSD";"S";"0038";"   HJOU_IJRF3PBHSL;N;Z1;X;0;9;    56789;;IJRF3PBHSL;V3;""Flag prés. b.h.s. du lendemain (N3)"";"
"IMISSD";"S";"0039";"   HJOU_IJQPAUMERI;N;T6,2;I;;;     6789;;;V3;""Pause déjeuner"";"
"IMISSD";"S";"0040";"   HJOU_IJQECPAUSM;N;T6,2;I;;;     6789;;;V3;""Ecart pause déjeuner"";"
"IMISSD";"S";"0041";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"IMISSD";"S";"0042";"   HJOU_IJQPRESBAV;N;T6,2;I;;;    56789;;;V3;""Présence badgée validée"";"
"IMISSD";"S";"0043";"   HJOU_IJQHMISSLE;N;T6,2;I;;;    56789;;;V3;""Durée mission du lendemain"";"
"IMISSD";"S";"0044";"   HJOU_IJQNABSENT;N;N2;I;;;    56789;;;V3;""Nombre d absences totales"";"
"IMISSD";"S";"0045";"   HJOU_IJQNACTIVJ;N;N2;I;;;    56789;;;V3;""Nombre d activités"";"
"IMISSD";"S";"0046";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"IMISSD";"S";"0047";"FINDICO"
"IMISSD";"S";"0048";"* Déclaration des donnees locales"
"IMISSD";"S";"0049";"*"
"IMISSD";"S";"0050";"DEF LOCA_MOTJOUR N1"
"IMISSD";"S";"0051";"LOCA_MOTJOUR = 0"
"IMISSD";"S";"0052";"DEF LOCA_TOTMISS T6.2"
"IMISSD";"S";"0053";"LOCA_TOTMISS = 0"
"IMISSD";"S";"0054";"DEF LOCA_ABS N1"
"IMISSD";"S";"0055";"LOCA_ABS = 0"
"IMISSD";"S";"0056";"DEF LOCA_MISSBAD A10"
"IMISSD";"S";"0057";"LOCA_MISSBAD = "" """
"IMISSD";"S";"0058";"DEF LOCA_MISSBADL A10"
"IMISSD";"S";"0059";"LOCA_MISSBADL = "" """
"IMISSD";"S";"0060";"DEF LOCA_ACTM N1"
"IMISSD";"S";"0061";"LOCA_ACTM = 0"
"IMISSD";"S";"0062";"*"
"IMISSD";"S";"0063";"* Suppression des motifs missions"
"IMISSD";"S";"0064";"*"
"IMISSD";"S";"0065";"SI PARD_IDIVMOMIBL = "" """
"IMISSD";"S";"0066";"   LOCA_MISSBADL = ""MISS"""
"IMISSD";"S";"0067";"SINON"
"IMISSD";"S";"0068";"   LOCA_MISSBADL = PARD_IDIVMOMIBL"
"IMISSD";"S";"0069";"FINSI"
"IMISSD";"S";"0070";"SI PARD_IDIVMOMISB = "" """
"IMISSD";"S";"0071";"   LOCA_MISSBAD = ""MISS"""
"IMISSD";"S";"0072";"SINON"
"IMISSD";"S";"0073";"   LOCA_MISSBAD = PARD_IDIVMOMISB"
"IMISSD";"S";"0074";"FINSI"
"IMISSD";"S";"0075";"ENLEVER LOCA_MISSBAD"
"IMISSD";"S";"0076";"ENLEVER LOCA_MISSBADL"
"IMISSD";"S";"0077";"*"
"IMISSD";"S";"0078";"* recuperation du temps mission entre le"
"IMISSD";"S";"0079";"* mouvement d'entree et la borne debut mission sur depart la veille"
"IMISSD";"S";"0080";"*"
"IMISSD";"S";"0081";"SI HJOU_IJRF3PBHSL = ""1"""
"IMISSD";"S";"0082";"   LOCA_TOTMISS = HJOU_IJQMISBADV"
"IMISSD";"S";"0083";"FINSI"
"IMISSD";"S";"0084";"SI HJOU_DATE <= TEMP_DATJOU"
"IMISSD";"S";"0085";"* si le compteur HJECREPL > 0 cela indique"
"IMISSD";"S";"0086";"* que le premier mouvement de la journée"
"IMISSD";"S";"0087";"* est une entree dans la plage DJ"
"IMISSD";"S";"0088";"* et qu'il n'y a pas d'autres mvts dans la plage DJ"
"IMISSD";"S";"0089";"* si HJMISSR = 1 cela veut dire que c'est un retour"
"IMISSD";"S";"0090";"* mission sur un depart fait la veille et dans ce cas"
"IMISSD";"S";"0091";"* l'ecart pause repas doit être alimenté avaec la valeur de"
"IMISSD";"S";"0092";"* la coupure minimum"
"IMISSD";"S";"0093";"   SI HJOU_IJRF3PBHSL = ""1"""
"IMISSD";"S";"0094";"      SI HJOU_IJQECPAUML > 0"
"IMISSD";"S";"0095";"* test si pas d'absence matin"
"IMISSD";"S";"0096";"         POUR ACTIVITES"
"IMISSD";"S";"0097";"            SI HABS_VALORIS = ""M"""
"IMISSD";"S";"0098";"               LOCA_ACTM = 1"
"IMISSD";"S";"0099";"            FINSI"
"IMISSD";"S";"0100";"         FINPOUR"
"IMISSD";"S";"0101";"         SI LOCA_ACTM = 0"
"IMISSD";"S";"0102";"            HJOU_IJQPAUMERI = 0"
"IMISSD";"S";"0103";"            HJOU_IJQECPAUSM = HJOU_IJQECPAUML"
"IMISSD";"S";"0104";"            HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQECPAUSM"
"IMISSD";"S";"0105";"            HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQECPAUSM"
"IMISSD";"S";"0106";"            ANOMALIE 114"
"IMISSD";"S";"0107";"         FINSI"
"IMISSD";"S";"0108";"      FINSI"
"IMISSD";"S";"0109";"   FINSI"
"IMISSD";"S";"0110";"** alimentation de la donnée reportable HJMISSR"
"IMISSD";"S";"0111";"** avec la valeur de la donnée HJMISS"
"IMISSD";"S";"0112";"** on test avant si hjnpoin > 0 pour recuperer la"
"IMISSD";"S";"0113";"** valeur de HJMISS car il ne faut pas stocker la"
"IMISSD";"S";"0114";"** valeur de HJMISS sur le jour ou on a pas de badgeage"
"IMISSD";"S";"0115";"** car même si la veille elle etait initialisée à 1"
"IMISSD";"S";"0116";"** le lendemain, comme la valeur du report n'est pas alimentée, on"
"IMISSD";"S";"0117";"** stockerai 0 dans HJMISSR"
"IMISSD";"S";"0118";"   SI HJOU_IJQNBADGEA > 0"
"IMISSD";"S";"0119";"      HJOU_IJRF3PBHSL = HJOU_IJRF2PBHSL"
"IMISSD";"S";"0120";"   FINSI"
"IMISSD";"S";"0121";"** calcul de la durée mission avec la duree théorique"
"IMISSD";"S";"0122";"** si pas de badgeages"
"IMISSD";"S";"0123";"   SI HJOU_INMISS = ""3"""
"IMISSD";"S";"0124";"      SI HJOU_IJRF3PBHSL = ""1"""
"IMISSD";"S";"0125";"         SI HJOU_IJQNBADGEA = 0"
"IMISSD";"S";"0126";"            LOCA_TOTMISS = HJOU_IJQPRETHEJ"
"IMISSD";"S";"0127";"            LOCA_ABS = 1"
"IMISSD";"S";"0128";"         FINSI"
"IMISSD";"S";"0129";"      FINSI"
"IMISSD";"S";"0130";"   FINSI"
"IMISSD";"S";"0131";"*  test si un motif est present"
"IMISSD";"S";"0132";"   POUR ACTIVITES"
"IMISSD";"S";"0133";"      SI HABS_MOTYPE <> ""C"""
"IMISSD";"S";"0134";"         SI HJOU_IJQNBADGEA = 0"
"IMISSD";"S";"0135";"            HJOU_IJRF3PBHSL = ""0"""
"IMISSD";"S";"0136";"            LOCA_MOTJOUR = 1"
"IMISSD";"S";"0137";"         FINSI"
"IMISSD";"S";"0138";"      FINSI"
"IMISSD";"S";"0139";"   FINPOUR"
"IMISSD";"S";"0140";"*  mise en place du motif"
"IMISSD";"S";"0141";"   SI LOCA_TOTMISS <> 0"
"IMISSD";"S";"0142";"*  La durée mission est calculée s'il n'y a"
"IMISSD";"S";"0143";"*  pas de motifs en place"
"IMISSD";"S";"0144";"      SI LOCA_MOTJOUR = 0"
"IMISSD";"S";"0145";"         HJOU_IJQHMISSLE = LOCA_TOTMISS"
"IMISSD";"S";"0146";"* Alimentation des compteurs pour ne pas declencher"
"IMISSD";"S";"0147";"* les anomalies 103/106"
"IMISSD";"S";"0148";"         SI LOCA_ABS = 1"
"IMISSD";"S";"0149";"            HJOU_IJQNABSENT = 1"
"IMISSD";"S";"0150";"            HJOU_IJQNACTIVJ = 1"
"IMISSD";"S";"0151";"         FINSI"
"IMISSD";"S";"0152";"      FINSI"
"IMISSD";"S";"0153";"   FINSI"
"IMISSD";"S";"0154";"FINSI"
"IMISSD";"S";"0155";"FIN"
