"ITPSACTPTA";"S";"0086";"                *"
"ITPSACTPTA";"S";"0087";"                PRES_TPS_IMPUTE = 0"
"ITPSACTPTA";"S";"0088";"                SI HJOU_IJIACTI = ""1"""
