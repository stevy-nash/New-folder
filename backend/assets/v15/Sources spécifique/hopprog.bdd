"SHSUPPDIM";"S";"0317";"*"
"SHSUPPDIM";"S";"0318";"* LOCA_MODALITE = 1 HS uniquement récupérées"
"SHSUPPDIM";"S";"0319";"* LOCA_MODALITE = 2 HS uniquement payées"
"SHSUPPDIM";"S";"0320";"* LOCA_MODALITE = 3 HS payées ou récupérées"
"SHSUPPDIM";"S";"0321";"* LOCA_MODALITE = 4 HS uniquement récupérées sans majoration"
"SHSUPPDIM";"S";"0322";"*"
"SHSUPPDIM";"S";"0323";"* Déduit par le réglementaire >>"
"SHSUPPDIM";"S";"0324";"SI LOCA_MODALITE = ""0"""
"SHSUPPDIM";"S";"0325";"* Par défaut les 2"
"SHSUPPDIM";"S";"0326";"   LOCA_MODALITE = ""3"""
"SHSUPPDIM";"S";"0327";"*"
"SHSUPPDIM";"S";"0328";"* Société EV ou PE - métier de l'évènementiel >>"
"SHSUPPDIM";"S";"0329";"   SI HJOU_SJQSOCIETE = ""EV"""
"SHSUPPDIM";"S";"0330";"   OU HJOU_SJQSOCIETE = ""PE"""
"SHSUPPDIM";"S";"0331";"* HS uniquement récupéré"
"SHSUPPDIM";"S";"0332";"      LOCA_MODALITE = ""1"""
"SHSUPPDIM";"S";"0333";"      LOCA_SPEC = ""EVEN"""
"SHSUPPDIM";"S";"0334";"   FINSI"
"SHSUPPDIM";"S";"0335";"*"
"SHSUPPDIM";"S";"0336";"* Société LI - métier de l'édition"
"SHSUPPDIM";"S";"0337";"   SI HJOU_SJQSOCIETE = ""LI"""
"SHSUPPDIM";"S";"0338";"* HS uniquement récupéré sans majo."
"SHSUPPDIM";"S";"0339";"      LOCA_MODALITE = ""4"""
"SHSUPPDIM";"S";"0340";"      LOCA_SPEC = ""EDIT"""
"SHSUPPDIM";"S";"0341";"   FINSI"
"SHSUPPDIM";"S";"0342";"*"
"SHSUPPDIM";"S";"0343";"* Service de la diffusion exclure les HS du dimance"
"SHSUPPDIM";"S";"0344";"   SI HJOU_SJITYPSERV = ""DIFFUSION"""
"SHSUPPDIM";"S";"0345";"   OU HJOU_SECTORI(1:3) = ""DVM"""
"SHSUPPDIM";"S";"0346";"* HS uniquement récupéré sans majo."
"SHSUPPDIM";"S";"0347";"      LOCA_MODALITE = ""4"""
"SHSUPPDIM";"S";"0348";"      LOCA_SPEC = ""DIFF"""
"SHSUPPDIM";"S";"0349";"   FINSI"
"SHSUPPDIM";"S";"0350";"*"
"SHSUPPDIM";"S";"0351";"* Si service hors industrie et gestion jour par jour => recup sans majo"
"SHSUPPDIM";"S";"0352";"   SI HJOU_SECTORI(1:3) <> ""DIN"""
"SHSUPPDIM";"S";"0353";"      SI LOCA_GESTHS = ""4"""
"SHSUPPDIM";"S";"0354";"         LOCA_MODALITE = ""4"""
"SHSUPPDIM";"S";"0355";"      FINSI"
"SHSUPPDIM";"S";"0356";"*"
"SHSUPPDIM";"S";"0357";"* FFT025003825 >>"
"SHSUPPDIM";"S";"0358";"      SI HJOU_SJITYPSERV = ""PFI"""
"SHSUPPDIM";"S";"0359";"* HS uniquement récupéré"
