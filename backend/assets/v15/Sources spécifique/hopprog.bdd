"SCALMAINT";"S";"0014";"*"
"SCALMAINT";"S";"0015";"*"
"SCALMAINT";"S";"0016";"* Rôle : Calcul du nombre de jour de maintiens selon société/statut"
"SCALMAINT";"S";"0017";"*        Selon ancienneté"
"SCALMAINT";"S";"0018";"*"
"SCALMAINT";"S";"0019";"*"
"SCALMAINT";"S";"0020";"*----------------------------------------------------------------------"
"SCALMAINT";"S";"0021";"*"
"SCALMAINT";"S";"0022";"* Modifiée par :"
"SCALMAINT";"S";"0023";"* Date         :"
"SCALMAINT";"S";"0024";"* Objet        :"
"SCALMAINT";"S";"0025";"*"
"SCALMAINT";"S";"0026";"***********************************************************************"
"SCALMAINT";"S";"0027";"*"
"SCALMAINT";"S";"0028";"* Implémentation des données industrielles"
"SCALMAINT";"S";"0029";"*"
"SCALMAINT";"S";"0030";"DEBDICO"
"SCALMAINT";"S";"0031";"   *"
"SCALMAINT";"S";"0032";"   HJOU_SJRNBJMAIN;N;N4;L;;;    56789;;SJRNBJMAIN;V3;""Nombres de jour de maintiens"";"
"SCALMAINT";"S";"0033";"FINDICO"
"SCALMAINT";"S";"0034";"*"
"SCALMAINT";"S";"0035";"* Définition des données locales"
"SCALMAINT";"S";"0036";"*"
"SCALMAINT";"S";"0037";"DEF LOCA_DROIT N2"
"SCALMAINT";"S";"0038";"LOCA_DROIT = 0"
"SCALMAINT";"S";"0039";"DEF LOCA_NBJMAINT N4"
"SCALMAINT";"S";"0040";"LOCA_NBJMAINT = 0"
"SCALMAINT";"S";"0041";"DEF LOCA_ANCJ N4"
"SCALMAINT";"S";"0042";"LOCA_ANCJ = 0"
"SCALMAINT";"S";"0043";"DEF LOCA_ANCA N4"
"SCALMAINT";"S";"0044";"LOCA_ANCA = 0"
"SCALMAINT";"S";"0045";"*"
"SCALMAINT";"S";"0046";"SI HJOU_IJIACOPRIN = ""1"""
"SCALMAINT";"S";"0047";"   LOCA_DROIT = 1"
"SCALMAINT";"S";"0048";"FINSI"
"SCALMAINT";"S";"0049";"*"
"SCALMAINT";"S";"0050";"* Droit au CP ?"
"SCALMAINT";"S";"0051";"SI LOCA_DROIT = 1"
"SCALMAINT";"S";"0052";"*"
"SCALMAINT";"S";"0053";"* Cacul de l'ancienneté"
"SCALMAINT";"S";"0054";"   SI EMPS_E2DATEANC <> "" """
"SCALMAINT";"S";"0055";"      DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"SCALMAINT";"S";"0056";"      LOCA_ANCJ = TEMP_NXJOUR"
"SCALMAINT";"S";"0057";"      LOCA_ANCA = TEMP_NXANNEE"
"SCALMAINT";"S";"0058";"   FINSI"
"SCALMAINT";"S";"0059";"*"
"SCALMAINT";"S";"0060";"****** Calcul du nombres de jours de maintient >>"
"SCALMAINT";"S";"0061";"*"
"SCALMAINT";"S";"0062";"* Société MA, HE hors journaliste >>"
"SCALMAINT";"S";"0063";"   SI HJOU_SJQCATEGOR <> ""J"""
"SCALMAINT";"S";"0064";"      SI HJOU_SJQSOCIETE = ""MA"""
"SCALMAINT";"S";"0065";"      OU HJOU_SJQSOCIETE = ""HE"""
"SCALMAINT";"S";"0066";"         SI LOCA_ANCJ > 180"
"SCALMAINT";"S";"0067";"* FFT025003848 : 180 au lieu de 90"
"SCALMAINT";"S";"0068";"            LOCA_NBJMAINT = 180"
"SCALMAINT";"S";"0069";"         FINSI"
"SCALMAINT";"S";"0070";"      FINSI"
"SCALMAINT";"S";"0071";"   FINSI"
"SCALMAINT";"S";"0072";"*"
"SCALMAINT";"S";"0073";"* Société LI >>"
"SCALMAINT";"S";"0074";"   SI HJOU_SJQSOCIETE = ""LI"""
"SCALMAINT";"S";"0075";"*"
"SCALMAINT";"S";"0076";"* 1 à 4 ans"
"SCALMAINT";"S";"0077";"      SI LOCA_ANCA >= 1"
"SCALMAINT";"S";"0078";"         SI LOCA_ANCA < 5"
"SCALMAINT";"S";"0079";"            LOCA_NBJMAINT = 180"
"SCALMAINT";"S";"0080";"         FINSI"
"SCALMAINT";"S";"0081";"      FINSI"
"SCALMAINT";"S";"0082";"* 5 à 9 ans"
"SCALMAINT";"S";"0083";"      SI LOCA_ANCA >= 5"
"SCALMAINT";"S";"0084";"         SI LOCA_ANCA < 10"
"SCALMAINT";"S";"0085";"            LOCA_NBJMAINT = 195"
"SCALMAINT";"S";"0086";"         FINSI"
"SCALMAINT";"S";"0087";"      FINSI"
"SCALMAINT";"S";"0088";"* 10 à 14 ans"
"SCALMAINT";"S";"0089";"      SI LOCA_ANCA >= 10"
"SCALMAINT";"S";"0090";"         SI LOCA_ANCA < 15"
"SCALMAINT";"S";"0091";"            LOCA_NBJMAINT = 210"
"SCALMAINT";"S";"0092";"         FINSI"
"SCALMAINT";"S";"0093";"      FINSI"
"SCALMAINT";"S";"0094";"* 15 à 19 ans"
"SCALMAINT";"S";"0095";"      SI LOCA_ANCA >= 15"
"SCALMAINT";"S";"0096";"         SI LOCA_ANCA < 20"
"SCALMAINT";"S";"0097";"            LOCA_NBJMAINT = 225"
"SCALMAINT";"S";"0098";"         FINSI"
"SCALMAINT";"S";"0099";"      FINSI"
"SCALMAINT";"S";"0100";"* 20 à 24 ans"
"SCALMAINT";"S";"0101";"      SI LOCA_ANCA >= 20"
"SCALMAINT";"S";"0102";"         SI LOCA_ANCA < 25"
"SCALMAINT";"S";"0103";"            LOCA_NBJMAINT = 240"
"SCALMAINT";"S";"0104";"         FINSI"
"SCALMAINT";"S";"0105";"      FINSI"
"SCALMAINT";"S";"0106";"* 25 à 29 ans"
"SCALMAINT";"S";"0107";"      SI LOCA_ANCA >= 25"
"SCALMAINT";"S";"0108";"         SI LOCA_ANCA < 30"
"SCALMAINT";"S";"0109";"            LOCA_NBJMAINT = 255"
"SCALMAINT";"S";"0110";"         FINSI"
"SCALMAINT";"S";"0111";"      FINSI"
"SCALMAINT";"S";"0112";"* 30 à 34 ans"
"SCALMAINT";"S";"0113";"      SI LOCA_ANCA >= 30"
"SCALMAINT";"S";"0114";"         SI LOCA_ANCA < 35"
"SCALMAINT";"S";"0115";"            LOCA_NBJMAINT = 270"
"SCALMAINT";"S";"0116";"         FINSI"
"SCALMAINT";"S";"0117";"      FINSI"
"SCALMAINT";"S";"0118";"* 35 à 39 ans"
"SCALMAINT";"S";"0119";"      SI LOCA_ANCA >= 35"
"SCALMAINT";"S";"0120";"         SI LOCA_ANCA < 40"
"SCALMAINT";"S";"0121";"            LOCA_NBJMAINT = 285"
"SCALMAINT";"S";"0122";"         FINSI"
"SCALMAINT";"S";"0123";"      FINSI"
"SCALMAINT";"S";"0124";"* 40 à 44 ans"
"SCALMAINT";"S";"0125";"      SI LOCA_ANCA >= 40"
"SCALMAINT";"S";"0126";"         SI LOCA_ANCA < 45"
"SCALMAINT";"S";"0127";"            LOCA_NBJMAINT = 300"
"SCALMAINT";"S";"0128";"         FINSI"
"SCALMAINT";"S";"0129";"      FINSI"
"SCALMAINT";"S";"0130";"* supérieur à 45 abs"
"SCALMAINT";"S";"0131";"      SI LOCA_ANCA >= 45"
"SCALMAINT";"S";"0132";"         LOCA_NBJMAINT = 315"
"SCALMAINT";"S";"0133";"      FINSI"
"SCALMAINT";"S";"0134";"*"
"SCALMAINT";"S";"0135";"   FINSI"
"SCALMAINT";"S";"0136";"*"
"SCALMAINT";"S";"0137";"* Maintient pour les journalistes >>"
"SCALMAINT";"S";"0138";"   SI HJOU_SJQCATEGOR = ""J"""
"SCALMAINT";"S";"0139";"      SI HJOU_SJQSOCIETE = ""BE"""
"SCALMAINT";"S";"0140";"      OU HJOU_SJQSOCIETE = ""EC"""
"SCALMAINT";"S";"0141";"      OU HJOU_SJQSOCIETE = ""MA"""
"SCALMAINT";"S";"0142";"      OU HJOU_SJQSOCIETE = ""HE"""
"SCALMAINT";"S";"0143";"      OU HJOU_SJQSOCIETE = ""JC"""
"SCALMAINT";"S";"0144";"      OU HJOU_SJQSOCIETE = ""MO"""
"SCALMAINT";"S";"0145";"      OU HJOU_SJQSOCIETE = ""PC"""
"SCALMAINT";"S";"0146";"      OU HJOU_SJQSOCIETE = ""RC"""
"SCALMAINT";"S";"0147";"      OU HJOU_SJQSOCIETE = ""VH"""
"SCALMAINT";"S";"0148";"      OU HJOU_SJQSOCIETE = ""YR"""
"SCALMAINT";"S";"0149";"      OU HJOU_SJQSOCIETE = ""IR"""
"SCALMAINT";"S";"0150";"         SI LOCA_ANCJ > 180"
"SCALMAINT";"S";"0151";"* Journaliste Cadre >>"
