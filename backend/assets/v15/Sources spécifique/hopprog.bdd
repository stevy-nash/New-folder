"SCPJOU";"S";"0001";"***********************************************************************"
"SCPJOU";"S";"0002";"*"
"SCPJOU";"S";"0003";"* Règle : SCPJOU"
"SCPJOU";"S";"0004";"* Ordre : 3195"
"SCPJOU";"S";"0005";"* Titre : GCF : Calcul des compteurs journaliers"
"SCPJOU";"S";"0006";"*"
"SCPJOU";"S";"0007";"*----------------------------------------------------------------------"
"SCPJOU";"S";"0008";"*"
"SCPJOU";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SCPJOU";"S";"0010";"* Date     : 03/02/2025"
"SCPJOU";"S";"0011";"* Version  : 1"
"SCPJOU";"S";"0012";"*"
"SCPJOU";"S";"0013";"*----------------------------------------------------------------------"
"SCPJOU";"S";"0014";"*"
"SCPJOU";"S";"0015";"*"
"SCPJOU";"S";"0016";"* Rôle : Calcul des compteurs journaliers"
"SCPJOU";"S";"0017";"*"
"SCPJOU";"S";"0018";"*"
"SCPJOU";"S";"0019";"*----------------------------------------------------------------------"
"SCPJOU";"S";"0020";"*"
"SCPJOU";"S";"0021";"* Modifiée par :"
"SCPJOU";"S";"0022";"* Date         :"
"SCPJOU";"S";"0023";"* Objet        :"
"SCPJOU";"S";"0024";"*"
"SCPJOU";"S";"0025";"***********************************************************************"
"SCPJOU";"S";"0026";"*"
"SCPJOU";"S";"0027";"*"
"SCPJOU";"S";"0028";"* Implémentation des données industrielles"
"SCPJOU";"S";"0029";"*"
"SCPJOU";"S";"0030";"DEBDICO"
"SCPJOU";"S";"0031";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"SCPJOU";"S";"0032";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"SCPJOU";"S";"0033";"   HJOU_IJQPRESBAV;N;T6,2;I;;;    56789;;;V3;""Présence badgée validée"";"
"SCPJOU";"S";"0034";"FINDICO"
"SCPJOU";"S";"0035";"*"
"SCPJOU";"S";"0036";"* Déclaration des donnees locales"
"SCPJOU";"S";"0037";"*"
"SCPJOU";"S";"0038";"DEF LOCA_INBADG Z1"
"SCPJOU";"S";"0039";"LOCA_INBADG = ""0"""
"SCPJOU";"S";"0040";"DEF LOCA_DUR T6.2"
"SCPJOU";"S";"0041";"LOCA_DUR = 0"
"SCPJOU";"S";"0042";"*"
"SCPJOU";"S";"0043";"LOCA_DUR = HJOU_SJQHTSOR1 - HJOU_SJQHTENT1"
"SCPJOU";"S";"0044";"LOCA_DUR = LOCA_DUR + HJOU_SJQHTSOR2"
"SCPJOU";"S";"0045";"LOCA_DUR = LOCA_DUR - HJOU_SJQHTENT2"
"SCPJOU";"S";"0046";"LOCA_DUR = LOCA_DUR + HJOU_SJQHTSOR3"
"SCPJOU";"S";"0047";"LOCA_DUR = LOCA_DUR - HJOU_SJQHTENT3"
"SCPJOU";"S";"0048";"LOCA_DUR = LOCA_DUR + HJOU_SJQHTSOR4"
"SCPJOU";"S";"0049";"LOCA_DUR = LOCA_DUR - HJOU_SJQHTENT4"
"SCPJOU";"S";"0050";"LOCA_DUR = LOCA_DUR + HJOU_SJQHTSOR5"
"SCPJOU";"S";"0051";"LOCA_DUR = LOCA_DUR - HJOU_SJQHTENT5"
"SCPJOU";"S";"0052";"*"
"SCPJOU";"S";"0053";"* si on est dans le futur"
"SCPJOU";"S";"0054";"* on positionne la variable INBADG à 0"
"SCPJOU";"S";"0055";"* ce qui permet de traiter les badgeants comme des non badgeants"
"SCPJOU";"S";"0056";"* afin d'alimenter une présence badgéé fictive (HJPOINV)qui correspond"
"SCPJOU";"S";"0057";"* à la théorie - les motifs d'absences non créditeur"
"SCPJOU";"S";"0058";"SI HJOU_DATE <= TEMP_DATJOU"
"SCPJOU";"S";"0059";"   LOCA_INBADG = HJOU_IJIGBADGEA"
"SCPJOU";"S";"0060";"* Modif le 21/03/07"
"SCPJOU";"S";"0061";"* pour les badgeants qui declarent leur présence"
"SCPJOU";"S";"0062";"* par la consigne XPRES , ils sont gérés comme des non-badgeant"
"SCPJOU";"S";"0063";"   POUR ACTIVITES"
"SCPJOU";"S";"0064";"      SI HABS_MOTIF = ""XPRES"""
"SCPJOU";"S";"0065";"         LOCA_INBADG = ""0"""
"SCPJOU";"S";"0066";"      FINSI"
"SCPJOU";"S";"0067";"   FINPOUR"
"SCPJOU";"S";"0068";"* Modif le 29/03/07 pour les badgeants qui declarent leur presence"
"SCPJOU";"S";"0069";"* en faisant 1 seul mouvement , il faut que dans le profil horaire"
"SCPJOU";"S";"0070";"* le nombre minimum de badgeage = 1"
"SCPJOU";"S";"0071";"   SI PROF_IPIVMINBAD = 1"
"SCPJOU";"S";"0072";"      SI HJOU_IJQNBADGEA = 1"
"SCPJOU";"S";"0073";"         LOCA_INBADG = ""0"""
"SCPJOU";"S";"0074";"      FINSI"
"SCPJOU";"S";"0075";"   FINSI"
"SCPJOU";"S";"0076";"SINON"
"SCPJOU";"S";"0077";"   LOCA_INBADG = ""0"""
"SCPJOU";"S";"0078";"FINSI"
"SCPJOU";"S";"0079";"*** calcul de la presence jour le 16/05/2010"
"SCPJOU";"S";"0080";"SI LOCA_INBADG = ""1"""
"SCPJOU";"S";"0081";"   TEMP_ITQPRESJOU = HJOU_IJQPRESBAJ"
"SCPJOU";"S";"0082";"   POUR ACTIVITES"
"SCPJOU";"S";"0083";"      SI HABS_MOTYPE = ""P"""
"SCPJOU";"S";"0084";"         TEMP_ITQPRESJOU = TEMP_ITQPRESJOU + HABS_MOTIDUR"
"SCPJOU";"S";"0085";"      FINSI"
"SCPJOU";"S";"0086";"   FINPOUR"
"SCPJOU";"S";"0087";"SINON"
"SCPJOU";"S";"0088";"   SI LOCA_DUR > 0"
"SCPJOU";"S";"0089";"      TEMP_ITQPRESJOU = LOCA_DUR"
"SCPJOU";"S";"0090";"   SINON"
"SCPJOU";"S";"0091";"      TEMP_ITQPRESJOU = HJOU_IJQPRETHEJ"
"SCPJOU";"S";"0092";"   FINSI"
"SCPJOU";"S";"0093";"   POUR ACTIVITES"
"SCPJOU";"S";"0094";"      SI HABS_MOTYPE = ""A"""
"SCPJOU";"S";"0095";"         TEMP_ITQPRESJOU = TEMP_ITQPRESJOU - HABS_MOTIDUR"
"SCPJOU";"S";"0096";"      FINSI"
"SCPJOU";"S";"0097";"   FINPOUR"
"SCPJOU";"S";"0098";"FINSI"
"SCPJOU";"S";"0099";"*  heures totales avant écrétement"
"SCPJOU";"S";"0100";"HJOU_IJQBHORVAJ = HJOU_IJQPRESBAJ"
"SCPJOU";"S";"0101";"*  déduction écart pause DJ"
"SCPJOU";"S";"0102";"HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HJOU_IJQECPAUMI"
"SCPJOU";"S";"0103";"*  rajout du débordement"
"SCPJOU";"S";"0104";"SI PROF_IPIGDEBORD = ""1"""
"SCPJOU";"S";"0105";"*   HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQHEXCEDJ"
"SCPJOU";"S";"0106";"FINSI"
"SCPJOU";"S";"0107";"*  alimentation d'un compteur avec la presence point?e valid?e"
"SCPJOU";"S";"0108";"HJOU_IJQPRESBAV = HJOU_IJQBHORVAJ"
"SCPJOU";"S";"0109";"*  Alimentation des heures totales par les"
"SCPJOU";"S";"0110";"*  le compteur des heures non badg?es cr?dit?es"
"SCPJOU";"S";"0111";"HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ + HJOU_IJQPRESNBJ"
"SCPJOU";"S";"0112";"*  gestion des non-badgeant : affectation de la th?orie"
"SCPJOU";"S";"0113";"*  - absences ne participant pas aux heures totales"
"SCPJOU";"S";"0114";"SI LOCA_INBADG = ""0"""
"SCPJOU";"S";"0115";"* Si plage >>"
"SCPJOU";"S";"0116";"   SI HJOU_IJQMVTENT1 <> HJOU_IJQMVTSOR1"
"SCPJOU";"S";"0117";"      HJOU_IJQBHORVAJ = LOCA_DUR"
"SCPJOU";"S";"0118";"      HJOU_IJQPRESBAV = LOCA_DUR"
"SCPJOU";"S";"0119";"   SINON"
"SCPJOU";"S";"0120";"* Pas de plage >>"
"SCPJOU";"S";"0121";"      HJOU_IJQBHORVAJ = HJOU_IJQPRETHEJ + LOCA_DUR"
"SCPJOU";"S";"0122";"      HJOU_IJQPRESBAV = HJOU_IJQPRETHEJ + LOCA_DUR"
"SCPJOU";"S";"0123";"   FINSI"
"SCPJOU";"S";"0124";"*   POUR ACTIVITES"
"SCPJOU";"S";"0125";"*      SI MOTI_MOTYPE <> ""C"""
"SCPJOU";"S";"0126";"*         SI MOTI_IMIGDEBCRE = ""0"""
"SCPJOU";"S";"0127";"*            HJOU_IJQBHORVAJ = HJOU_IJQBHORVAJ - HABS_MOTIDUR"
"SCPJOU";"S";"0128";"*         FINSI"
"SCPJOU";"S";"0129";"*"
"SCPJOU";"S";"0130";"*         SI MOTI_IMIGCREDNB <> ""1"""
"SCPJOU";"S";"0131";"*            HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HABS_MOTIDUR"
"SCPJOU";"S";"0132";"*         FINSI"
"SCPJOU";"S";"0133";"*      FINSI"
"SCPJOU";"S";"0134";"*   FINPOUR"
"SCPJOU";"S";"0135";"*"
"SCPJOU";"S";"0136";"* JJA - 03/11/2025"
"SCPJOU";"S";"0137";"*"
"SCPJOU";"S";"0138";"   SI HJOU_SJQSOCIETE = ""EV"""
"SCPJOU";"S";"0139";"   OU HJOU_SJQSOCIETE = ""PE"""
"SCPJOU";"S";"0140";"      SI HJOU_SJQFORFJR <> ""1"""
"SCPJOU";"S";"0141";"         HJOU_IJQPLGTOTJ = LOCA_DUR"
"SCPJOU";"S";"0142";"      FINSI"
"SCPJOU";"S";"0143";"   FINSI"
"SCPJOU";"S";"0144";"*"
"SCPJOU";"S";"0145";"FINSI"
"SCPJOU";"S";"0146";"FIN"
