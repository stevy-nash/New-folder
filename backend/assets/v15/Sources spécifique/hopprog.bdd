"SPAIECPT";"S";"0079";"   *"
"SPAIECPT";"S";"0080";"FINDICO"
"SPAIECPT";"S";"0081";"***************************************************************************************************"
"SPAIECPT";"S";"0082";"DEF LOCA_FER N1"
"SPAIECPT";"S";"0083";"LOCA_FER = 0"
"SPAIECPT";"S";"0084";"DEF LOCA_VALORIS A1"
"SPAIECPT";"S";"0085";"DEF LOCA_DUR T6.2"
"SPAIECPT";"S";"0086";"DEF LOCA_DCA N6.1"
"SPAIECPT";"S";"0087";"DEF LOCA_PCA N6.1"
"SPAIECPT";"S";"0088";"DEF LOCA_PRTT N6.2"
"SPAIECPT";"S";"0089";"DEF LOCA_DRTT N6.1"
"SPAIECPT";"S";"0090";"DEF LOCA_DCSUP N6.2"
"SPAIECPT";"S";"0091";"DEF LOCA_PCSUP N6.2"
"SPAIECPT";"S";"0092";"DEF LOCA_PCP1 N6.2"
"SPAIECPT";"S";"0093";"DEF LOCA_PCP2 N6.2"
"SPAIECPT";"S";"0094";"DEF LOCA_PCP3 N6.1"
"SPAIECPT";"S";"0095";"DEF LOCA_THEOH T6.2"
"SPAIECPT";"S";"0096";"LOCA_THEOH = 0"
"SPAIECPT";"S";"0097";"DEF LOCA_RAZ N1"
"SPAIECPT";"S";"0098";"LOCA_RAZ = 1"
"SPAIECPT";"S";"0099";"*"
"SPAIECPT";"S";"0100";"DEF LOCA_STC N2"
"SPAIECPT";"S";"0101";"LOCA_STC = 0"
"SPAIECPT";"S";"0102";"SI HJOU_DATE = CTRA_SCIDATSTC"
"SPAIECPT";"S";"0103";"   SI CTRA_SCIDATSTC = CTRA_DATFIN"
"SPAIECPT";"S";"0104";"      LOCA_STC = 1"
"SPAIECPT";"S";"0105";"   FINSI"
"SPAIECPT";"S";"0106";"FINSI"
"SPAIECPT";"S";"0107";"*"
"SPAIECPT";"S";"0108";"***** RAZ compteur mensuel >> **********************************************************************"
"SPAIECPT";"S";"0109";"*"
"SPAIECPT";"S";"0110";"SI HJOU_DATE(7:2) = ""01"""
"SPAIECPT";"S";"0111";"* Pas de RAZ si sortie sur le mois"
"SPAIECPT";"S";"0112";"   SI CTRA_SCIDATSTC(1:6) <> HJOU_DATE(1:6)"
"SPAIECPT";"S";"0113";"      HJOU_SJRY598 = 0"
"SPAIECPT";"S";"0114";"      HJOU_SJRY599 = 0"
"SPAIECPT";"S";"0115";"      HJOU_SJRYA15 = 0"
"SPAIECPT";"S";"0116";"   FINSI"
"SPAIECPT";"S";"0117";"FINSI"
"SPAIECPT";"S";"0118";"*"
"SPAIECPT";"S";"0119";"* Init droit >>"
"SPAIECPT";"S";"0120";"HJOU_SJRI001 = HJOU_IJRDACQCP"
"SPAIECPT";"S";"0121";"HJOU_SJRJ001 = HJOU_IJRDCOPRIN"
"SPAIECPT";"S";"0122";"*"
"SPAIECPT";"S";"0123";"***** Gestion des conso de CP et RTT - Cas normal >> ***********************************************"
"SPAIECPT";"S";"0124";"*"
"SPAIECPT";"S";"0125";"POUR ACTIVITES"
"SPAIECPT";"S";"0126";"* Conso CP1 mensuel >>"
"SPAIECPT";"S";"0127";"   SI HABS_MOTIF = PARD_SDIVMCOANT"
"SPAIECPT";"S";"0128";"      HJOU_SJRY598 = HJOU_SJRY598 + HABS_MOTINBR"
"SPAIECPT";"S";"0129";"   FINSI"
"SPAIECPT";"S";"0130";"* Conso CP2 mensuel"
"SPAIECPT";"S";"0131";"   SI HABS_MOTIF = PARD_IDIVMCOFRA"
"SPAIECPT";"S";"0132";"   OU HABS_MOTIF = PARD_SDIVMCMDF"
"SPAIECPT";"S";"0133";"   OU HABS_MOTIF = PARD_SDIVMCSUP"
"SPAIECPT";"S";"0134";"   OU HABS_MOTIF = PARD_IDIVMCOANC"
"SPAIECPT";"S";"0135";"   OU HABS_MOTIF = PARD_IDIVMCOPRI"
"SPAIECPT";"S";"0136";"      HJOU_SJRY599 = HJOU_SJRY599 + HABS_MOTINBR"
"SPAIECPT";"S";"0137";"   FINSI"
"SPAIECPT";"S";"0138";"* Conso RTT mensuel"
"SPAIECPT";"S";"0139";"   SI HABS_MOTIF = ""RTT"""
"SPAIECPT";"S";"0140";"      SI HJOU_IJQPRETHEJ > 0"
"SPAIECPT";"S";"0141";"         SI HABS_VALORIS = ""J"""
"SPAIECPT";"S";"0142";"            HJOU_SJRYA15 = HJOU_SJRYA15 + 1"
"SPAIECPT";"S";"0143";"         SINON"
"SPAIECPT";"S";"0144";"            HJOU_SJRYA15 = HJOU_SJRYA15 + 0.5"
"SPAIECPT";"S";"0145";"         FINSI"
"SPAIECPT";"S";"0146";"      FINSI"
"SPAIECPT";"S";"0147";"   FINSI"
"SPAIECPT";"S";"0148";"*"
"SPAIECPT";"S";"0149";"FINPOUR"
"SPAIECPT";"S";"0150";"*"
"SPAIECPT";"S";"0151";"****** Gestion des consos CP - Cas de bascule >> ***************************************************"
"SPAIECPT";"S";"0152";"*"
"SPAIECPT";"S";"0153";"* Pour GCF mois de bascule = Mai/Juin"
"SPAIECPT";"S";"0154";"*"
"SPAIECPT";"S";"0155";"SI HJOU_DATE(5:2) = ""05"""
"SPAIECPT";"S";"0156";"   HJOU_SJRY595 = HJOU_SJRY598"
"SPAIECPT";"S";"0157";"   HJOU_SJRY596 = HJOU_SJRY599"
"SPAIECPT";"S";"0158";"*"
"SPAIECPT";"S";"0159";"   HJOU_SJRY603 = HJOU_IJRDACQCP"
"SPAIECPT";"S";"0160";"   HJOU_SJRY605 = HJOU_IJRDCOPRIN"
"SPAIECPT";"S";"0161";"*"
"SPAIECPT";"S";"0162";"   SI HJOU_DATE(5:4) = ""0531"""
"SPAIECPT";"S";"0163";"*OU LOCA_STC = 1"""
"SPAIECPT";"S";"0164";"      HJOU_SJRY599 = 0"
"SPAIECPT";"S";"0165";"      HJOU_SJRY598 = 0"
"SPAIECPT";"S";"0166";"   FINSI"
"SPAIECPT";"S";"0167";"SINON"
"SPAIECPT";"S";"0168";"*"
"SPAIECPT";"S";"0169";"* RAZ des compteurs dédiés à la bascule en dehors du mois de bascule"
"SPAIECPT";"S";"0170";"*"
"SPAIECPT";"S";"0171";"* Pas de remise à Zéro des compteurs si sortie en juin"
"SPAIECPT";"S";"0172";"* Interface est excuter du 01/06 à la date de sortie sur juin"
"SPAIECPT";"S";"0173";"   SI CTRA_SCIDATSTC(5:2) = ""06"""
"SPAIECPT";"S";"0174";"      SI CTRA_SCIDATSTC(1:4) = HJOU_DATE(1:4)"
"SPAIECPT";"S";"0175";"         LOCA_RAZ = 0"
"SPAIECPT";"S";"0176";"      FINSI"
"SPAIECPT";"S";"0177";"   FINSI"
"SPAIECPT";"S";"0178";"*"
"SPAIECPT";"S";"0179";"   SI LOCA_RAZ = 1"
"SPAIECPT";"S";"0180";"* Pris mensuel - bascule"
"SPAIECPT";"S";"0181";"      HJOU_SJRY595 = 0"
"SPAIECPT";"S";"0182";"      HJOU_SJRY596 = 0"
"SPAIECPT";"S";"0183";"* Droit bascule"
"SPAIECPT";"S";"0184";"      HJOU_SJRY603 = 0"
"SPAIECPT";"S";"0185";"      HJOU_SJRY605 = 0"
"SPAIECPT";"S";"0186";"   FINSI"
"SPAIECPT";"S";"0187";"*"
"SPAIECPT";"S";"0188";"FINSI"
"SPAIECPT";"S";"0189";"*"
"SPAIECPT";"S";"0190";"****** Calcul des soldes de paie ADP >> ************************************************************"
"SPAIECPT";"S";"0191";"*"
"SPAIECPT";"S";"0192";"* Pour GCF mois de bascule = Mai/Juin"
"SPAIECPT";"S";"0193";"*"
"SPAIECPT";"S";"0194";"* Cas soldes des CP bascule en Juin"
"SPAIECPT";"S";"0195";"SI HJOU_DATE(5:2) = ""06"""
"SPAIECPT";"S";"0196";"*"
"SPAIECPT";"S";"0197";"   SI HJOU_DATE(7:2) = ""01"""
"SPAIECPT";"S";"0198";"      LIREVALPRE LOCA_PCP1 HJOU_IJRPACQCP"
"SPAIECPT";"S";"0199";"      HJOU_SJRJ005 = LOCA_PCP1"
"SPAIECPT";"S";"0200";"   FINSI"
"SPAIECPT";"S";"0201";"*"
"SPAIECPT";"S";"0202";"* Solde"
"SPAIECPT";"S";"0203";"*"
"SPAIECPT";"S";"0204";"* CP1"
"SPAIECPT";"S";"0205";"   HJOU_SJRI005 = 0"
"SPAIECPT";"S";"0206";"   HJOU_SJRI012 = HJOU_SJRI001 - HJOU_SJRI005"
"SPAIECPT";"S";"0207";"* CP2"
"SPAIECPT";"S";"0208";"   HJOU_SJRJ012 = HJOU_SJRDGCONGE - HJOU_SJRJ005"
"SPAIECPT";"S";"0209";"*"
"SPAIECPT";"S";"0210";"FINSI"
"SPAIECPT";"S";"0211";"*"
"SPAIECPT";"S";"0212";"* Cas soldes CP hors bascule"
"SPAIECPT";"S";"0213";"SI HJOU_DATE(5:2) <> ""06"""
"SPAIECPT";"S";"0214";"   SI HJOU_DATE(7:2) = ""01"""
"SPAIECPT";"S";"0215";"* Pris CP1"
"SPAIECPT";"S";"0216";"      LIREVALPRE LOCA_PCP1 HJOU_IJRPACQCP"
"SPAIECPT";"S";"0217";"      HJOU_SJRI005 = LOCA_PCP1"
"SPAIECPT";"S";"0218";"* Pris CP2"
"SPAIECPT";"S";"0219";"      LIREVALPRE LOCA_PCP2 HJOU_SJRCGCONGE"
"SPAIECPT";"S";"0220";"      HJOU_SJRJ005 = LOCA_PCP2"
"SPAIECPT";"S";"0221";"   FINSI"
"SPAIECPT";"S";"0222";"*"
"SPAIECPT";"S";"0223";"* CP1"
"SPAIECPT";"S";"0224";"   HJOU_SJRI012 = HJOU_SJRI001 - HJOU_SJRI005"
"SPAIECPT";"S";"0225";"* CP2"
"SPAIECPT";"S";"0226";"   HJOU_SJRJ012 = HJOU_SJRDGCONGE - HJOU_SJRJ005"
"SPAIECPT";"S";"0227";"*"
"SPAIECPT";"S";"0228";"***** Cas de la sortie et du solde tout compte >>  *************************************************"
"SPAIECPT";"S";"0229";"*"
"SPAIECPT";"S";"0230";"   SI HJOU_DATE(1:6) = CTRA_SCIDATSTC(1:6)"
"SPAIECPT";"S";"0231";"* CP1"
"SPAIECPT";"S";"0232";"      HJOU_SJRI005 = HJOU_IJRPACQCP"
"SPAIECPT";"S";"0233";"* CP2"
"SPAIECPT";"S";"0234";"      HJOU_SJRJ005 = HJOU_SJRCGCONGE"
"SPAIECPT";"S";"0235";"*"
"SPAIECPT";"S";"0236";"***** les solde sont à 0 normalement et sont égaux au solde de sortie"
"SPAIECPT";"S";"0237";"* CP1"
"SPAIECPT";"S";"0238";"      HJOU_SJRI012 = HJOU_SJRI001 - HJOU_SJRI005"
"SPAIECPT";"S";"0239";"* CP2"
"SPAIECPT";"S";"0240";"      HJOU_SJRJ012 = HJOU_SJRDGCONGE - HJOU_SJRJ005"
"SPAIECPT";"S";"0241";"   FINSI"
"SPAIECPT";"S";"0242";"*"
"SPAIECPT";"S";"0243";"FINSI"
"SPAIECPT";"S";"0244";"*"
"SPAIECPT";"S";"0245";"***********************************************************"
"SPAIECPT";"S";"0246";"*"
"SPAIECPT";"S";"0247";"* Heures de stagiaires"
"SPAIECPT";"S";"0248";"*"
"SPAIECPT";"S";"0249";"SI CTRA_TYPCTRA = ""STG"""
"SPAIECPT";"S";"0250";"   HJOU_SJQTTESTG = HJOU_IJQTTEFFEJ"
"SPAIECPT";"S";"0251";"   POUR ACTIVITES"
"SPAIECPT";"S";"0252";"      SI HABS_MOTYPE <> ""C"""
"SPAIECPT";"S";"0253";"         SI MOTI_IMIGTTEFFE <> ""1"""
"SPAIECPT";"S";"0254";"            HJOU_SJQABSSTG = HJOU_SJQABSSTG + HABS_MOTIDUR"
"SPAIECPT";"S";"0255";"         FINSI"
"SPAIECPT";"S";"0256";"      FINSI"
"SPAIECPT";"S";"0257";"   FINPOUR"
"SPAIECPT";"S";"0258";"FINSI"
"SPAIECPT";"S";"0259";"*"
"SPAIECPT";"S";"0260";"***********************************************************"
"SPAIECPT";"S";"0261";"* en cas de sortie on force les soldes envoyés en paie à 0"
"SPAIECPT";"S";"0262";"SI CTRA_SCIDATSTC(1:6) = HJOU_DATE(1:6)"
"SPAIECPT";"S";"0263";"   HJOU_SJRI012 = 0"
"SPAIECPT";"S";"0264";"   HJOU_SJRJ012 = 0"
"SPAIECPT";"S";"0265";"FINSI"
"SPAIECPT";"S";"0266";"***********************************************************"
"SPAIECPT";"S";"0267";"*"
"SPAIECPT";"S";"0268";"FIN"
