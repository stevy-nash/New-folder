"SDACQ2";"S";"0325";"* Date fin de contrat dans l'année N-1"
"SDACQ2";"S";"0326";"      SI CTRA_DATFIN(1:4) = LOCA_DATEP1(1:4)"
"SDACQ2";"S";"0327";"         SI EMPL_SEIDATFCN1 = "" """
"SDACQ2";"S";"0328";"            EMPL_SEIDATFCN1 = CTRA_DATFIN"
"SDACQ2";"S";"0329";"         SINON"
"SDACQ2";"S";"0330";"            SI EMPL_SEIDATFCN1 < CTRA_DATFIN"
"SDACQ2";"S";"0331";"               EMPL_SEIDATFCN1 = CTRA_DATFIN"
"SDACQ2";"S";"0332";"            FINSI"
"SDACQ2";"S";"0333";"         FINSI"
"SDACQ2";"S";"0334";"      FINSI"
"SDACQ2";"S";"0335";"* Contrat débute avant N-1"
"SDACQ2";"S";"0336";"      SI CTRA_DATDEB < LOCA_DATEP1"
"SDACQ2";"S";"0337";"         SI CTRA_DATFIN > LOCA_DATEP1"
"SDACQ2";"S";"0338";"            EMPL_SEIDATACQ1 = LOCA_DATEP1"
"SDACQ2";"S";"0339";"         FINSI"
"SDACQ2";"S";"0340";"      FINSI"
"SDACQ2";"S";"0341";"* Contrat fini après N-1"
"SDACQ2";"S";"0342";"      SI CTRA_DATDEB < LOCA_DATEAC"
"SDACQ2";"S";"0343";"         SI CTRA_DATFIN > LOCA_DATEAC"
"SDACQ2";"S";"0344";"            DATAJT LOCA_DATEAC 12 ""J"" -1"
"SDACQ2";"S";"0345";"            EMPL_SEIDATFCN1 = TEMP_DXFINPER"
"SDACQ2";"S";"0346";"         FINSI"
"SDACQ2";"S";"0347";"      FINSI"
"SDACQ2";"S";"0348";"*"
"SDACQ2";"S";"0349";"* Année N >>"
"SDACQ2";"S";"0350";"* Date début de contrat dans l'année N"
"SDACQ2";"S";"0351";"      SI CTRA_DATDEB(1:4) = LOCA_DATEAC(1:4)"
"SDACQ2";"S";"0352";"         SI EMPL_SEIDATACQN = "" """
"SDACQ2";"S";"0353";"            EMPL_SEIDATACQN = CTRA_DATDEB"
"SDACQ2";"S";"0354";"         SINON"
"SDACQ2";"S";"0355";"            SI CTRA_DATDEB < EMPL_SEIDATACQN"
"SDACQ2";"S";"0356";"               EMPL_SEIDATACQN = CTRA_DATDEB"
"SDACQ2";"S";"0357";"            FINSI"
"SDACQ2";"S";"0358";"         FINSI"
"SDACQ2";"S";"0359";"      FINSI"
"SDACQ2";"S";"0360";"* Date fin de contrat dans l'année N"
"SDACQ2";"S";"0361";"      SI CTRA_DATFIN(1:4) = LOCA_DATEAC(1:4)"
"SDACQ2";"S";"0362";"         SI EMPL_SEIDATFCN = "" """
"SDACQ2";"S";"0363";"            EMPL_SEIDATFCN = CTRA_DATFIN"
"SDACQ2";"S";"0364";"         SINON"
"SDACQ2";"S";"0365";"            SI EMPL_SEIDATFCN < CTRA_DATFIN"
"SDACQ2";"S";"0366";"               EMPL_SEIDATFCN = CTRA_DATFIN"
"SDACQ2";"S";"0367";"            FINSI"
"SDACQ2";"S";"0368";"         FINSI"
"SDACQ2";"S";"0369";"      FINSI"
"SDACQ2";"S";"0370";"* Contrat débute avant N"
"SDACQ2";"S";"0371";"      SI CTRA_DATDEB < LOCA_DATEAC"
"SDACQ2";"S";"0372";"         SI CTRA_DATFIN > LOCA_DATEAC"
"SDACQ2";"S";"0373";"            EMPL_SEIDATACQN = LOCA_DATEAC"
"SDACQ2";"S";"0374";"         FINSI"
"SDACQ2";"S";"0375";"      FINSI"
"SDACQ2";"S";"0376";"* Contrat fini après N"
"SDACQ2";"S";"0377";"      SI CTRA_DATDEB < LOCA_DATEP9"
"SDACQ2";"S";"0378";"         SI CTRA_DATFIN > LOCA_DATEP9"
"SDACQ2";"S";"0379";"            DATAJT LOCA_DATEP9 12 ""J"" -1"
"SDACQ2";"S";"0380";"            EMPL_SEIDATFCN = TEMP_DXFINPER"
"SDACQ2";"S";"0381";"         FINSI"
"SDACQ2";"S";"0382";"      FINSI"
"SDACQ2";"S";"0383";"*"
"SDACQ2";"S";"0384";"* Année N+1 >>"
"SDACQ2";"S";"0385";"* Date début de contrat dans l'année N+1"
"SDACQ2";"S";"0386";"      SI CTRA_DATDEB(1:4) = LOCA_DATEP9(1:4)"
"SDACQ2";"S";"0387";"         SI EMPL_SEIDATACQ9 = "" """
"SDACQ2";"S";"0388";"            EMPL_SEIDATACQ9 = CTRA_DATDEB"
"SDACQ2";"S";"0389";"         SINON"
"SDACQ2";"S";"0390";"            SI CTRA_DATDEB < EMPL_SEIDATACQ9"
"SDACQ2";"S";"0391";"               EMPL_SEIDATACQ9 = CTRA_DATDEB"
"SDACQ2";"S";"0392";"            FINSI"
"SDACQ2";"S";"0393";"         FINSI"
"SDACQ2";"S";"0394";"      FINSI"
"SDACQ2";"S";"0395";"* Date fin de contrat dans l'année N+1"
"SDACQ2";"S";"0396";"      SI CTRA_DATFIN(1:4) = LOCA_DATEP9(1:4)"
"SDACQ2";"S";"0397";"         SI EMPL_SEIDATFCN9 = "" """
"SDACQ2";"S";"0398";"            EMPL_SEIDATFCN9 = CTRA_DATFIN"
"SDACQ2";"S";"0399";"         SINON"
"SDACQ2";"S";"0400";"            SI EMPL_SEIDATFCN9 < CTRA_DATFIN"
"SDACQ2";"S";"0401";"               EMPL_SEIDATFCN9 = CTRA_DATFIN"
"SDACQ2";"S";"0402";"            FINSI"
"SDACQ2";"S";"0403";"         FINSI"
"SDACQ2";"S";"0404";"      FINSI"
"SDACQ2";"S";"0405";"* Contrat débute avant N+1"
"SDACQ2";"S";"0406";"      SI CTRA_DATDEB < LOCA_DATEP9"
"SDACQ2";"S";"0407";"         SI CTRA_DATFIN > LOCA_DATEP9"
"SDACQ2";"S";"0408";"            EMPL_SEIDATACQ9 = LOCA_DATEP9"
"SDACQ2";"S";"0409";"         FINSI"
"SDACQ2";"S";"0410";"      FINSI"
"SDACQ2";"S";"0411";"* Contrat fini après N+1"
"SDACQ2";"S";"0412";"      SI CTRA_DATDEB(1:4) <= LOCA_DATEP9(1:4)"
"SDACQ2";"S";"0413";"         SI CTRA_DATFIN(1:4) > LOCA_DATEP9(1:4)"
"SDACQ2";"S";"0414";"* Si date de fin de traitement supérieur à N+1"
"SDACQ2";"S";"0415";"            SI EMPL_SEIDATFIN(1:4) > LOCA_DATEP9(1:4)"
"SDACQ2";"S";"0416";"               EMPL_SEIDATFCN9(1:4) = LOCA_DATEP9(1:4)"
"SDACQ2";"S";"0417";"               EMPL_SEIDATFCN9(5:4) = ""1231"""
"SDACQ2";"S";"0418";"            SINON"
"SDACQ2";"S";"0419";"               EMPL_SEIDATFCN9 = EMPL_SEIDATFIN"
"SDACQ2";"S";"0420";"            FINSI"
"SDACQ2";"S";"0421";"         FINSI"
"SDACQ2";"S";"0422";"      FINSI"
"SDACQ2";"S";"0423";"*"
"SDACQ2";"S";"0424";"   FINPOUR"
"SDACQ2";"S";"0425";"FINSI"
"SDACQ2";"S";"0426";"*"
"SDACQ2";"S";"0427";"FIN"
"SDELEG";"S";"0001";"***********************************************************************"
"SDELEG";"S";"0002";"*"
"SDELEG";"S";"0003";"* Règle : SDELEG"
"SDELEG";"S";"0004";"* Ordre : 3340"
"SDELEG";"S";"0005";"* Titre : GCF : Autres Délégations (DS/RSCE/CCIJP)"
"SDELEG";"S";"0006";"*"
"SDELEG";"S";"0007";"*----------------------------------------------------------------------"
"SDELEG";"S";"0008";"*"
"SDELEG";"S";"0009";"* Créé par : Jérémy Jacquot"
"SDELEG";"S";"0010";"* Date     : 04/03/2025"
"SDELEG";"S";"0011";"* Version  : 1"
"SDELEG";"S";"0012";"*"
"SDELEG";"S";"0013";"*----------------------------------------------------------------------"
"SDELEG";"S";"0014";"*"
"SDELEG";"S";"0015";"*"
"SDELEG";"S";"0016";"* Rôle : Gestion des délégations (DS/RSCE/CCIJP)"
"SDELEG";"S";"0017";"*"
"SDELEG";"S";"0018";"*"
"SDELEG";"S";"0019";"*"
"SDELEG";"S";"0020";"*----------------------------------------------------------------------"
"SDELEG";"S";"0021";"*"
"SDELEG";"S";"0022";"* Modifiée par :"
"SDELEG";"S";"0023";"* Date         :"
"SDELEG";"S";"0024";"* Objet        :"
"SDELEG";"S";"0025";"*"
"SDELEG";"S";"0026";"***********************************************************************"
"SDELEG";"S";"0027";"*"
"SDELEG";"S";"0028";"* Implémentation des données industrielles"
"SDELEG";"S";"0029";"*"
"SDELEG";"S";"0030";"DEBDICO"
"SDELEG";"S";"0031";"   * Compteurs délégations DS"
"SDELEG";"S";"0032";"   HJOU_IJIDDELEDS;O;T6,2;I;;;123456789;;;C3;""Droit délégation DS"";"
"SDELEG";"S";"0033";"   HJOU_IJIDATFDDS;O;D10;X;;;123456789;;;C3;""Fin de mandat délégation DS"";"
"SDELEG";"S";"0034";"   HJOU_IJRDDELEDS;N;T6,2;I;;;     6789;;IJRDDELEDS;V3;""Droit délégation DS"";"
"SDELEG";"S";"0035";"   HJOU_IJRCDELEDS;N;T6,2;I;;;     6789;;IJRCDELEDS;V3;""Pris délégation DS"";"
"SDELEG";"S";"0036";"   HJOU_IJRSDELEDS;N;T6,2;I;;;     6789;;;V3;""Solde délégation DS"";"
"SDELEG";"S";"0037";"   * Compteurs délégations RSCE"
"SDELEG";"S";"0038";"   HJOU_SJIDRSCE;O;T6,2;I;;;123456789;;;C3;""Droit mensuel délégation RSCE"";"
"SDELEG";"S";"0039";"   HJOU_SJIDFRSCE;O;D10;X;;;123456789;;;C3;""Fin de mandat délégation RSCE"";"
"SDELEG";"S";"0040";"   HJOU_IJRDDELDFS;N;T6,2;I;;;     6789;;IJRDDELDFS;V3;""Droit délégation RSCE"";"
"SDELEG";"S";"0041";"   HJOU_IJRCDELDFS;N;T6,2;I;;;     6789;;IJRCDELDFS;V3;""Pris délégation RSCE"";"
"SDELEG";"S";"0042";"   HJOU_IJRSDELDFS;N;T6,2;I;;;     6789;;;V3;""Solde délégation RSCE"";"
"SDELEG";"S";"0043";"   * Compteurs délégations CCIJP"
"SDELEG";"S";"0044";"   HJOU_SJIDCIJP;O;T6,2;I;;;123456789;;;C3;""Droit mensuel délégation CCIJP"";"
"SDELEG";"S";"0045";"   HJOU_SJIDFCIJP;O;D10;X;;;123456789;;;C3;""Fin de mandat délégation CCIJP"";"
"SDELEG";"S";"0046";"   HJOU_SJRDDECIJP;N;T6,2;I;;;     6789;;SJRDDECIJP;V3;""Droit délégation CCIJP"";"
"SDELEG";"S";"0047";"   HJOU_SJRCDECIJP;N;T6,2;I;;;     6789;;SJRCDECIJP;V3;""Pris délégation CCIJP"";"
"SDELEG";"S";"0048";"   HJOU_SJRSDECIJP;N;T6,2;I;;;     6789;;;V3;""Solde délégation CCIJP"";"
"SDELEG";"S";"0049";"FINDICO"
"SDELEG";"S";"0050";"*"
"SDELEG";"S";"0051";"DEBANO"
"SDELEG";"S";"0052";"   205;8;""La date de fin de mandat DS inférieure à la date de début"";"
"SDELEG";"S";"0053";"   206;8;""Date de fin de mandat DS non renseignée"";"
"SDELEG";"S";"0054";"   207;8;""Date de début de mandat DS non renseignée"";"
"SDELEG";"S";"0055";"   208;8;""Pas de mandat délégation DS"";"
"SDELEG";"S";"0056";"   209;8;""Solde délégation DS insuffisant"";"
"SDELEG";"S";"0057";"   *"
"SDELEG";"S";"0058";"   210;8;""La date de fin de mandat RCSE est inférieure à la date de début"";"
"SDELEG";"S";"0059";"   211;8;""Date de fin de mandat RCSE non renseignée"";"
"SDELEG";"S";"0060";"   212;8;""Date de début de mandat RCSE non renseignée"";"
"SDELEG";"S";"0061";"   213;8;""Pas de mandat délégation RCSE"";"
"SDELEG";"S";"0062";"   214;8;""Solde délégation RCSE insuffisant"";"
"SDELEG";"S";"0063";"   *"
"SDELEG";"S";"0064";"   286;8;""Date de fin de mandat CCIJP non renseignée"";"
"SDELEG";"S";"0065";"   287;8;""Pas de mandat délégation CCIJP"";"
"SDELEG";"S";"0066";"   288;8;""Solde délégation CCIJP insuffisant"";"
"SDELEG";"S";"0067";"FINANO"
"SDELEG";"S";"0068";"* Déclaration des donnees locales"
"SDELEG";"S";"0069";"*"
"SDELEG";"S";"0070";"DEF LOCA_MOTDS N2"
"SDELEG";"S";"0071";"LOCA_MOTDS = 0"
"SDELEG";"S";"0072";"DEF LOCA_MOTDFS N2"
"SDELEG";"S";"0073";"LOCA_MOTDFS = 0"
"SDELEG";"S";"0074";"DEF LOCA_MOTCIJ N1"
"SDELEG";"S";"0075";"LOCA_MOTCIJ = 0"
"SDELEG";"S";"0076";"*"
"SDELEG";"S";"0077";"* Raz des compteurs droit/pris si la date de début de délégation est à blanc"
"SDELEG";"S";"0078";"*"
"SDELEG";"S";"0079";"* RAZ DS"
"SDELEG";"S";"0080";"SI HJOU_IJIDATFDDS = "" """
"SDELEG";"S";"0081";"OU HJOU_DATE > HJOU_IJIDATFDDS"
"SDELEG";"S";"0082";"   HJOU_IJRDDELEDS = 0"
"SDELEG";"S";"0083";"   HJOU_IJRCDELEDS = 0"
"SDELEG";"S";"0084";"FINSI"
"SDELEG";"S";"0085";"* RAZ RSCE"
"SDELEG";"S";"0086";"SI HJOU_SJIDFRSCE = "" """
"SDELEG";"S";"0087";"OU HJOU_DATE > HJOU_SJIDFRSCE"
"SDELEG";"S";"0088";"   HJOU_IJRDDELDFS = 0"
"SDELEG";"S";"0089";"   HJOU_IJRCDELDFS = 0"
"SDELEG";"S";"0090";"FINSI"
"SDELEG";"S";"0091";"* RAZ CCIJP"
"SDELEG";"S";"0092";"SI HJOU_SJIDFCIJP = "" """
"SDELEG";"S";"0093";"OU HJOU_DATE > HJOU_SJIDFCIJP"
"SDELEG";"S";"0094";"   HJOU_SJRDDECIJP = 0"
"SDELEG";"S";"0095";"   HJOU_SJRCDECIJP = 0"
"SDELEG";"S";"0096";"FINSI"
"SDELEG";"S";"0097";"*"
"SDELEG";"S";"0098";"* RAZ du pris le 1° jour du mois"
"SDELEG";"S";"0099";"SI HJOU_DATE(7:2) = ""01"""
"SDELEG";"S";"0100";"   HJOU_IJRCDELEDS = 0"
"SDELEG";"S";"0101";"   HJOU_IJRCDELDFS = 0"
"SDELEG";"S";"0102";"   HJOU_SJRCDECIJP = 0"
"SDELEG";"S";"0103";"FINSI"
"SDELEG";"S";"0104";"*"
"SDELEG";"S";"0105";"*********************************************************************************"
"SDELEG";"S";"0106";"** Acquisition mensuel Délégation DS >>"
"SDELEG";"S";"0107";"*********************************************************************************"
"SDELEG";"S";"0108";"*"
"SDELEG";"S";"0109";"* Modif la veille"
"SDELEG";"S";"0110";"DEF LOCA_IJIDDELEDS T6.2"
"SDELEG";"S";"0111";"LOCA_IJIDDELEDS = 0.00"
"SDELEG";"S";"0112";"*"
"SDELEG";"S";"0113";"LIREVALPRE LOCA_IJIDDELEDS HJOU_IJIDDELEDS"
"SDELEG";"S";"0114";"*"
"SDELEG";"S";"0115";"SI HJOU_IJIDDELEDS > 0"
"SDELEG";"S";"0116";"* Test si fin de mandant ?"
"SDELEG";"S";"0117";"   SI HJOU_IJIDATFDDS <> "" """
"SDELEG";"S";"0118";"      SI HJOU_DATE(7:2) = ""01"""
"SDELEG";"S";"0119";"      OU LOCA_IJIDDELEDS <> HJOU_IJIDDELEDS"
"SDELEG";"S";"0120";"         SI HJOU_DATE <= HJOU_IJIDATFDDS"
"SDELEG";"S";"0121";"            HJOU_IJRDDELEDS = HJOU_IJIDDELEDS"
"SDELEG";"S";"0122";"         SINON"
"SDELEG";"S";"0123";"* La date de fin de mandat est dépassée => le compteur est remis à 0"
"SDELEG";"S";"0124";"            HJOU_IJRDDELEDS = 0"
"SDELEG";"S";"0125";"         FINSI"
"SDELEG";"S";"0126";"      FINSI"
"SDELEG";"S";"0127";"   SINON"
"SDELEG";"S";"0128";"* La date de fin de mandat DS n'est pas renseignée"
"SDELEG";"S";"0129";"      ANOMALIE 206"
"SDELEG";"S";"0130";"   FINSI"
"SDELEG";"S";"0131";"FINSI"
"SDELEG";"S";"0132";"*********************************************************************************"
"SDELEG";"S";"0133";"** Acquisition mensuel Délégation RCSE >>"
"SDELEG";"S";"0134";"*********************************************************************************"
"SDELEG";"S";"0135";"SI HJOU_SJIDRSCE > 0"
"SDELEG";"S";"0136";"* Test si la date de début de mandat est renseignée"
"SDELEG";"S";"0137";"   SI HJOU_SJIDFRSCE <> "" """
"SDELEG";"S";"0138";"      SI HJOU_DATE(7:2) = ""01"""
"SDELEG";"S";"0139";"         SI HJOU_DATE <= HJOU_SJIDFRSCE"
"SDELEG";"S";"0140";"            HJOU_IJRDDELDFS = HJOU_SJIDRSCE"
"SDELEG";"S";"0141";"         SINON"
"SDELEG";"S";"0142";"* La date de fin de mandat est dépassée => le compteur est remis à 0"
"SDELEG";"S";"0143";"            HJOU_IJRDDELDFS = 0"
"SDELEG";"S";"0144";"         FINSI"
"SDELEG";"S";"0145";"      FINSI"
"SDELEG";"S";"0146";"   SINON"
"SDELEG";"S";"0147";"* La date de fin de mandat RCSE n'est pas renseignée"
"SDELEG";"S";"0148";"      ANOMALIE 211"
"SDELEG";"S";"0149";"   FINSI"
"SDELEG";"S";"0150";"FINSI"
"SDELEG";"S";"0151";"*********************************************************************************"
"SDELEG";"S";"0152";"** Acquisition mensuel Délégation CCIJP >>"
"SDELEG";"S";"0153";"*********************************************************************************"
"SDELEG";"S";"0154";"SI HJOU_SJIDCIJP > 0"
"SDELEG";"S";"0155";"* Test si fin de mandant ?"
"SDELEG";"S";"0156";"   SI HJOU_SJIDFCIJP <> "" """
"SDELEG";"S";"0157";"      SI HJOU_DATE(7:2) = ""01"""
"SDELEG";"S";"0158";"         SI HJOU_DATE <= HJOU_SJIDFCIJP"
"SDELEG";"S";"0159";"            HJOU_SJRDDECIJP = HJOU_SJIDCIJP"
"SDELEG";"S";"0160";"         SINON"
"SDELEG";"S";"0161";"* La date de fin de mandat est dépassée => le compteur est remis à 0"
"SDELEG";"S";"0162";"            HJOU_SJRDDECIJP = 0"
"SDELEG";"S";"0163";"         FINSI"
"SDELEG";"S";"0164";"      FINSI"
"SDELEG";"S";"0165";"   SINON"
"SDELEG";"S";"0166";"* La date de fin de mandat CCIJP n'est pas renseignée"
"SDELEG";"S";"0167";"      ANOMALIE 286"
"SDELEG";"S";"0168";"   FINSI"
"SDELEG";"S";"0169";"FINSI"
"SDELEG";"S";"0170";"*"
"SDELEG";"S";"0171";"*********************************************************************************"
"SDELEG";"S";"0172";"** Alimentation du pris >>"
"SDELEG";"S";"0173";"*********************************************************************************"
"SDELEG";"S";"0174";"POUR ACTIVITES"
"SDELEG";"S";"0175";"* Délégation DS >>"
"SDELEG";"S";"0176";"   SI HABS_MOTIF = PARD_SDIVMDS"
"SDELEG";"S";"0177";"* contrôle si le droit est alimenté"
"SDELEG";"S";"0178";"      SI HJOU_IJRDDELEDS > 0"
"SDELEG";"S";"0179";"         HJOU_IJRCDELEDS = HJOU_IJRCDELEDS + HABS_MOTIDUR"
"SDELEG";"S";"0180";"         HJOU_IJRSDELEDS = HJOU_IJRDDELEDS - HJOU_IJRCDELEDS"
"SDELEG";"S";"0181";"         LOCA_MOTDS = 1"
"SDELEG";"S";"0182";"      SINON"
"SDELEG";"S";"0183";"* pas de droit"
"SDELEG";"S";"0184";"         ANOMALIE 208"
"SDELEG";"S";"0185";"         SI TEMP_CNMOTIF = PARD_SDIVMDS"
"SDELEG";"S";"0186";"            TEMP_CNRETOUR = 2"
"SDELEG";"S";"0187";"            TEMP_CNMESS = 208"
"SDELEG";"S";"0188";"         FINSI"
"SDELEG";"S";"0189";"      FINSI"
"SDELEG";"S";"0190";"   FINSI"
"SDELEG";"S";"0191";"* Délégation RCSE >>"
"SDELEG";"S";"0192";"   SI HABS_MOTIF = PARD_SDIVMRSCE"
"SDELEG";"S";"0193";"* contrôle si le droit est alimenté"
"SDELEG";"S";"0194";"      SI HJOU_IJRDDELDFS > 0"
"SDELEG";"S";"0195";"         HJOU_IJRCDELDFS = HJOU_IJRCDELDFS + HABS_MOTIDUR"
"SDELEG";"S";"0196";"         HJOU_IJRSDELDFS = HJOU_IJRDDELDFS - HJOU_IJRCDELDFS"
"SDELEG";"S";"0197";"         LOCA_MOTDFS = 1"
"SDELEG";"S";"0198";"      SINON"
"SDELEG";"S";"0199";"* pas de droit"
"SDELEG";"S";"0200";"         ANOMALIE 213"
"SDELEG";"S";"0201";"         SI TEMP_CNMOTIF = PARD_SDIVMRSCE"
"SDELEG";"S";"0202";"            TEMP_CNRETOUR = 2"
"SDELEG";"S";"0203";"            TEMP_CNMESS = 213"
"SDELEG";"S";"0204";"         FINSI"
"SDELEG";"S";"0205";"      FINSI"
"SDELEG";"S";"0206";"   FINSI"
"SDELEG";"S";"0207";"* Délégation CCIJP >>"
"SDELEG";"S";"0208";"   SI HABS_MOTIF = PARD_SDIVMCCIJP"
"SDELEG";"S";"0209";"* contrôle si le droit est alimenté"
"SDELEG";"S";"0210";"      SI HJOU_SJRDDECIJP > 0"
"SDELEG";"S";"0211";"         HJOU_SJRCDECIJP = HJOU_SJRCDECIJP + HABS_MOTIDUR"
"SDELEG";"S";"0212";"         HJOU_SJRSDECIJP = HJOU_SJRDDECIJP - HJOU_SJRCDECIJP"
"SDELEG";"S";"0213";"         LOCA_MOTCIJ = 1"
"SDELEG";"S";"0214";"      SINON"
"SDELEG";"S";"0215";"* pas de droit"
"SDELEG";"S";"0216";"         ANOMALIE 287"
"SDELEG";"S";"0217";"         SI TEMP_CNMOTIF = PARD_SDIVMCCIJP"
"SDELEG";"S";"0218";"            TEMP_CNRETOUR = 2"
"SDELEG";"S";"0219";"            TEMP_CNMESS = 287"
"SDELEG";"S";"0220";"         FINSI"
"SDELEG";"S";"0221";"      FINSI"
"SDELEG";"S";"0222";"   FINSI"
"SDELEG";"S";"0223";"FINPOUR"
"SDELEG";"S";"0224";"*************************************************************************"
"SDELEG";"S";"0225";"** Initialisation du pris par consigne"
"SDELEG";"S";"0226";"*************************************************************************"
"SDELEG";"S";"0227";"POUR ACTIVITES"
"SDELEG";"S";"0228";"   SI HABS_MOTIF = ""XCDEDS"""
"SDELEG";"S";"0229";"      HJOU_IJRCDELEDS = HJOU_IJRCDELEDS + HABS_MOTIDUR"
"SDELEG";"S";"0230";"   FINSI"
"SDELEG";"S";"0231";"   SI HABS_MOTIF = ""ZCDEDS"""
"SDELEG";"S";"0232";"      HJOU_IJRCDELEDS = HABS_MOTIDUR"
"SDELEG";"S";"0233";"   FINSI"
"SDELEG";"S";"0234";"   SI HABS_MOTIF = ""XCDRSCE"""
"SDELEG";"S";"0235";"      HJOU_IJRCDELDFS = HJOU_IJRCDELDFS + HABS_MOTIDUR"
"SDELEG";"S";"0236";"   FINSI"
"SDELEG";"S";"0237";"   SI HABS_MOTIF = ""ZCDRSCE"""
"SDELEG";"S";"0238";"      HJOU_IJRCDELDFS = HABS_MOTIDUR"
"SDELEG";"S";"0239";"   FINSI"
"SDELEG";"S";"0240";"   SI HABS_MOTIF = ""XCDCIJ"""
"SDELEG";"S";"0241";"      HJOU_SJRCDECIJP = HJOU_IJRCDELDFS + HABS_MOTIDUR"
"SDELEG";"S";"0242";"   FINSI"
"SDELEG";"S";"0243";"   SI HABS_MOTIF = ""ZCDCIJ"""
"SDELEG";"S";"0244";"      HJOU_SJRCDECIJP = HABS_MOTIDUR"
"SDELEG";"S";"0245";"   FINSI"
"SDELEG";"S";"0246";"FINPOUR"
"SDELEG";"S";"0247";"*************************************************************************"
"SDELEG";"S";"0248";"** Gestion des soldes et anomalies >>"
"SDELEG";"S";"0249";"*************************************************************************"
"SDELEG";"S";"0250";"*"
"SDELEG";"S";"0251";"* DS"
"SDELEG";"S";"0252";"HJOU_IJRSDELEDS = HJOU_IJRDDELEDS - HJOU_IJRCDELEDS"
"SDELEG";"S";"0253";"SI HJOU_IJRSDELEDS < 0"
"SDELEG";"S";"0254";"   SI LOCA_MOTDS = 1"
"SDELEG";"S";"0255";"      ANOMALIE 209"
"SDELEG";"S";"0256";"      SI TEMP_CNMOTIF = PARD_SDIVMDS"
"SDELEG";"S";"0257";"         TEMP_CNRETOUR = 2"
"SDELEG";"S";"0258";"         TEMP_CNMESS = 209"
"SDELEG";"S";"0259";"      FINSI"
"SDELEG";"S";"0260";"   FINSI"
"SDELEG";"S";"0261";"FINSI"
"SDELEG";"S";"0262";"*"
"SDELEG";"S";"0263";"* RCSE"
"SDELEG";"S";"0264";"HJOU_IJRSDELDFS = HJOU_IJRDDELDFS - HJOU_IJRCDELDFS"
"SDELEG";"S";"0265";"SI HJOU_IJRSDELDFS < 0"
"SDELEG";"S";"0266";"   SI LOCA_MOTDFS = 1"
"SDELEG";"S";"0267";"      ANOMALIE 214"
"SDELEG";"S";"0268";"      SI TEMP_CNMOTIF = PARD_SDIVMRSCE"
"SDELEG";"S";"0269";"         TEMP_CNRETOUR = 2"
"SDELEG";"S";"0270";"         TEMP_CNMESS = 214"
"SDELEG";"S";"0271";"      FINSI"
"SDELEG";"S";"0272";"   FINSI"
"SDELEG";"S";"0273";"FINSI"
"SDELEG";"S";"0274";"*"
"SDELEG";"S";"0275";"* CCIJP"
"SDELEG";"S";"0276";"HJOU_SJRSDECIJP = HJOU_SJRDDECIJP - HJOU_SJRCDECIJP"
"SDELEG";"S";"0277";"SI HJOU_SJRSDECIJP < 0"
"SDELEG";"S";"0278";"   SI LOCA_MOTCIJ = 1"
"SDELEG";"S";"0279";"      ANOMALIE 288"
"SDELEG";"S";"0280";"      SI TEMP_CNMOTIF = PARD_SDIVMCCIJP"
"SDELEG";"S";"0281";"         TEMP_CNRETOUR = 2"
"SDELEG";"S";"0282";"         TEMP_CNMESS = 288"
"SDELEG";"S";"0283";"      FINSI"
"SDELEG";"S";"0284";"   FINSI"
"SDELEG";"S";"0285";"FINSI"
"SDELEG";"S";"0286";"*"
"SDELEG";"S";"0287";"FIN"
"SDIMAN";"S";"0001";"***********************************************************************"
"SDIMAN";"S";"0002";"*"
"SDIMAN";"S";"0003";"* Règle : SDIMAN"
"SDIMAN";"S";"0004";"* Ordre : 6025"
"SDIMAN";"S";"0005";"* Titre : GCF : Calcul des heures de dimanche"
"SDIMAN";"S";"0006";"*"
"SDIMAN";"S";"0007";"*----------------------------------------------------------------------"
"SDIMAN";"S";"0008";"*"
"SDIMAN";"S";"0009";"* Créé par : Jérémy Jacquot"
"SDIMAN";"S";"0010";"* Date     : 03/02/2025"
"SDIMAN";"S";"0011";"* Version  : 1"
"SDIMAN";"S";"0012";"*"
"SDIMAN";"S";"0013";"*----------------------------------------------------------------------"
"SDIMAN";"S";"0014";"*"
"SDIMAN";"S";"0015";"*"
"SDIMAN";"S";"0016";"* Rôle : Calcul des heures de dimanche"
"SDIMAN";"S";"0017";"*"
"SDIMAN";"S";"0018";"*"
"SDIMAN";"S";"0019";"*----------------------------------------------------------------------"
"SDIMAN";"S";"0020";"*"
"SDIMAN";"S";"0021";"* Modifiée par :"
"SDIMAN";"S";"0022";"* Date         :"
"SDIMAN";"S";"0023";"* Objet        :"
"SDIMAN";"S";"0024";"*"
"SDIMAN";"S";"0025";"***********************************************************************"
"SDIMAN";"S";"0026";"*"
"SDIMAN";"S";"0027";"* Implémentation des données industrielles"
"SDIMAN";"S";"0028";"*"
"SDIMAN";"S";"0029";"DEBDICO"
"SDIMAN";"S";"0030";"   HJOU_IJQHDIMTRA;N;T6,2;I;;;    56789;;;V3;""Dimanche travaillé"";"
"SDIMAN";"S";"0031";"   HJOU_SJQHDIF100;N;T6,2;I;;;     6789;;;V3;""Majo. hrs diman/Férié à 100% (7408)"";"
"SDIMAN";"S";"0032";"   HJOU_SJQHSP125;N;T6,2;I;;;     6789;;;V3;""HS payées à 125% (7085)"";"
"SDIMAN";"S";"0033";"   HJOU_SJQHSP200;N;T6,2;I;;;     6789;;;V3;""HS payées à 200% (0348)"";"
"SDIMAN";"S";"0034";"   HJOU_IJRCHDISP3;N;T8,2;L;;;    56789;;;V3;""PO : Heures de dimanche (0359)"";"
"SDIMAN";"S";"0035";"   HJOU_SJRHDIF100;N;T6,2;I;;;     6789;;SJRHDIF100;V3;""EV/PE : Cumul majo. hrs diman/Férié"";"
"SDIMAN";"S";"0036";"   *"
"SDIMAN";"S";"0037";"   SECH_SSITYPSERV;O;A15;X;;;        9;L9;;C2;""Type de service"";"
"SDIMAN";"S";"0038";"FINDICO"
"SDIMAN";"S";"0039";"* Déclaration des donnees locales"
"SDIMAN";"S";"0040";"*"
"SDIMAN";"S";"0041";"* Stockage du total des heures dimanches pour"
"SDIMAN";"S";"0042";"* contrôle par rapport à l'écrêtage de la presence"
"SDIMAN";"S";"0043";"DEF LOCA_DIM T6.2"
"SDIMAN";"S";"0044";"LOCA_DIM = 0"
"SDIMAN";"S";"0045";"*"
"SDIMAN";"S";"0046";"DEF LOCA_MOTE T6.2"
"SDIMAN";"S";"0047";"LOCA_MOTE = 0"
"SDIMAN";"S";"0048";"DEF LOCA_MOTS T6.2"
"SDIMAN";"S";"0049";"LOCA_MOTS = 0"
"SDIMAN";"S";"0050";"DEF LOCA_ABSDIM T6.2"
"SDIMAN";"S";"0051";"LOCA_ABSDIM = 0"
"SDIMAN";"S";"0052";"DEF LOCA_DEBDIM T6.2"
"SDIMAN";"S";"0053";"LOCA_DEBDIM = 0.00"
"SDIMAN";"S";"0054";"DEF LOCA_FINDIM T6.2"
"SDIMAN";"S";"0055";"LOCA_FINDIM = 24.00"
"SDIMAN";"S";"0056";"*"
"SDIMAN";"S";"0057";"DEF LOCA_HDIM T6.2"
"SDIMAN";"S";"0058";"LOCA_HDIM = 0"
"SDIMAN";"S";"0059";"*"
"SDIMAN";"S";"0060";"DEF LOCA_MVE T6.2"
"SDIMAN";"S";"0061";"LOCA_MVE = 0"
"SDIMAN";"S";"0062";"DEF LOCA_MVS T6.2"
"SDIMAN";"S";"0063";"LOCA_MVS = 0"
"SDIMAN";"S";"0064";"DEF LOCA_DURDIM T6.2"
"SDIMAN";"S";"0065";"LOCA_DURDIM = 0"
"SDIMAN";"S";"0066";"* Seuil HS dimanche pour la diffusion"
"SDIMAN";"S";"0067";"DEF LOCA_SEUILDIF T6.2"
"SDIMAN";"S";"0068";"LOCA_SEUILDIF = 4.00"
"SDIMAN";"S";"0069";"*"
"SDIMAN";"S";"0070";"DEF LOCA_DROIT N2"
"SDIMAN";"S";"0071";"LOCA_DROIT = 0"
"SDIMAN";"S";"0072";"*"
"SDIMAN";"S";"0073";"DEF LOCA_JF N2"
"SDIMAN";"S";"0074";"LOCA_JF = 0"
"SDIMAN";"S";"0075";"*"
"SDIMAN";"S";"0076";"DEF LOCA_CALCPRIM N2"
"SDIMAN";"S";"0077";"LOCA_CALCPRIM = 0"
"SDIMAN";"S";"0078";"DEF LOCA_HORNUIT N2"
"SDIMAN";"S";"0079";"LOCA_HORNUIT = 0"
"SDIMAN";"S";"0080";"*"
"SDIMAN";"S";"0081";"DEF LOCA_5411 N2"
"SDIMAN";"S";"0082";"LOCA_5411 = 0"
"SDIMAN";"S";"0083";"DEF LOCA_0411 N2"
"SDIMAN";"S";"0084";"LOCA_0411 = 0"
"SDIMAN";"S";"0085";"*"
"SDIMAN";"S";"0086";"DEF LOCA_CALC N2"
"SDIMAN";"S";"0087";"LOCA_CALC = 0"
"SDIMAN";"S";"0088";"*"
"SDIMAN";"S";"0089";"SI HJOU_DATE <= TEMP_DATJOU"
"SDIMAN";"S";"0090";"   LOCA_CALC = 1"
"SDIMAN";"S";"0091";"FINSI"
"SDIMAN";"S";"0092";"*"
"SDIMAN";"S";"0093";"SI CTRA_SCISOCIETE = ""EV"""
"SDIMAN";"S";"0094";"OU CTRA_SCISOCIETE = ""PE"""
"SDIMAN";"S";"0095";"   SI CTRA_SCIFORFJ <> ""1"""
"SDIMAN";"S";"0096";"      LOCA_CALC = 1"
"SDIMAN";"S";"0097";"   FINSI"
"SDIMAN";"S";"0098";"FINSI"
"SDIMAN";"S";"0099";"*"
"SDIMAN";"S";"0100";"* 21/04/2026-Salim: pas d'exclusion des cadres"
"SDIMAN";"S";"0101";"*"
"SDIMAN";"S";"0102";"SI HJOU_DATE >= ""05/01/2026"""
"SDIMAN";"S";"0103";"   SI CTRA_SCISOCIETE = ""EV"""
"SDIMAN";"S";"0104";"   OU CTRA_SCISOCIETE = ""PE"""
"SDIMAN";"S";"0105";"      LOCA_CALC = 1"
"SDIMAN";"S";"0106";"   FINSI"
"SDIMAN";"S";"0107";"FINSI"
"SDIMAN";"S";"0108";"* RAZ"
"SDIMAN";"S";"0109";"SI HJOU_JOUR = ""1"""
"SDIMAN";"S";"0110";"   SI HJOU_RANG = 1"
"SDIMAN";"S";"0111";"      HJOU_SJRHDIF100 = 0"
"SDIMAN";"S";"0112";"   FINSI"
"SDIMAN";"S";"0113";"FINSI"
"SDIMAN";"S";"0114";"*"
"SDIMAN";"S";"0115";"SI HJOU_SJQDEBC = 1"
"SDIMAN";"S";"0116";"   HJOU_SJRHDIF100 = 0"
"SDIMAN";"S";"0117";"FINSI"
"SDIMAN";"S";"0118";"*"
"SDIMAN";"S";"0119";"* Exclut cadre et FJ >>"
"SDIMAN";"S";"0120";"SI HJOU_SJQFORFJR <> ""1"""
"SDIMAN";"S";"0121";"   SI HJOU_SJQCATEGOR <> ""C"""
"SDIMAN";"S";"0122";"      LOCA_DROIT = 1"
"SDIMAN";"S";"0123";"   FINSI"
"SDIMAN";"S";"0124";"FINSI"
"SDIMAN";"S";"0125";"*"
"SDIMAN";"S";"0126";"*"
"SDIMAN";"S";"0127";"* 21/04/2026-Salim: pas d'exclusion des cadres"
"SDIMAN";"S";"0128";"*"
"SDIMAN";"S";"0129";"SI HJOU_DATE >= ""05/01/2026"""
"SDIMAN";"S";"0130";"   LOCA_DROIT = 1"
"SDIMAN";"S";"0131";"FINSI"
"SDIMAN";"S";"0132";"*"
"SDIMAN";"S";"0133";"* Travaille sur horaire de nuit ?"
"SDIMAN";"S";"0134";"SI HJOU_SJQHTSOR1 > 24.00"
"SDIMAN";"S";"0135";"OU HJOU_SJQHTSOR2 > 24.00"
"SDIMAN";"S";"0136";"OU HJOU_SJQHTSOR3 > 24.00"
"SDIMAN";"S";"0137";"OU HJOU_SJQHTSOR4 > 24.00"
"SDIMAN";"S";"0138";"OU HJOU_SJQHTSOR5 > 24.00"
"SDIMAN";"S";"0139";"   LOCA_HORNUIT = 1"
"SDIMAN";"S";"0140";"FINSI"
"SDIMAN";"S";"0141";"*"
"SDIMAN";"S";"0142";"***** Identification des heures de dimanche de minuit à minuit >> **********************************"
"SDIMAN";"S";"0143";"*"
"SDIMAN";"S";"0144";"*SI HJOU_DATE <= TEMP_DATJOU"
"SDIMAN";"S";"0145";"SI LOCA_CALC = 1"
"SDIMAN";"S";"0146";"   SI HJOU_JOUR = ""7"""
"SDIMAN";"S";"0147";"      SI LOCA_JF <> 1"
"SDIMAN";"S";"0148";"*      SI HJOU_IJIGBADGEA <> ""1"""
"SDIMAN";"S";"0149";"*"
"SDIMAN";"S";"0150";"* Mouvement 1"
"SDIMAN";"S";"0151";"         LOCA_MVE = HJOU_SJQHTENT1"
"SDIMAN";"S";"0152";"         LOCA_MVS = HJOU_SJQHTSOR1"
"SDIMAN";"S";"0153";"         FAIRE CALC1"
"SDIMAN";"S";"0154";"* Mouvement 2"
"SDIMAN";"S";"0155";"         LOCA_MVE = HJOU_SJQHTENT2"
"SDIMAN";"S";"0156";"         LOCA_MVS = HJOU_SJQHTSOR2"
"SDIMAN";"S";"0157";"         FAIRE CALC1"
"SDIMAN";"S";"0158";"* Mouvement 3"
"SDIMAN";"S";"0159";"         LOCA_MVE = HJOU_SJQHTENT3"
"SDIMAN";"S";"0160";"         LOCA_MVS = HJOU_SJQHTSOR3"
"SDIMAN";"S";"0161";"         FAIRE CALC1"
"SDIMAN";"S";"0162";"* Mouvement 4"
"SDIMAN";"S";"0163";"         LOCA_MVE = HJOU_SJQHTENT4"
"SDIMAN";"S";"0164";"         LOCA_MVS = HJOU_SJQHTSOR4"
"SDIMAN";"S";"0165";"         FAIRE CALC1"
"SDIMAN";"S";"0166";"* Mouvement 5"
"SDIMAN";"S";"0167";"         LOCA_MVE = HJOU_SJQHTENT5"
"SDIMAN";"S";"0168";"         LOCA_MVS = HJOU_SJQHTSOR5"
"SDIMAN";"S";"0169";"         FAIRE CALC1"
"SDIMAN";"S";"0170";"*"
"SDIMAN";"S";"0171";"         HJOU_IJQHDIMTRA = HJOU_IJQHDIMTRA + HJOU_IJRPREVEIL"
"SDIMAN";"S";"0172";"*"
"SDIMAN";"S";"0173";"*      SINON"
"SDIMAN";"S";"0174";"*         HJOU_IJQHDIMTRA = HJOU_IJQPRESBAV"
"SDIMAN";"S";"0175";"      FINSI"
"SDIMAN";"S";"0176";"   FINSI"
"SDIMAN";"S";"0177";"FINSI"
"SDIMAN";"S";"0178";"*"
"SDIMAN";"S";"0179";"* Vérif si négatif ?"
"SDIMAN";"S";"0180";"SI HJOU_IJQHDIMTRA < 0"
"SDIMAN";"S";"0181";"   HJOU_IJQHDIMTRA = 0"
"SDIMAN";"S";"0182";"FINSI"
"SDIMAN";"S";"0183";"*"
"SDIMAN";"S";"0184";"*  analyse des consignes"
"SDIMAN";"S";"0185";"*"
"SDIMAN";"S";"0186";"POUR ACTIVITES"
"SDIMAN";"S";"0187";"   SI HABS_MOTIF = ""XDIM"""
"SDIMAN";"S";"0188";"      HJOU_IJQHDIMTRA = HJOU_IJQHDIMTRA + HABS_MOTIDUR"
"SDIMAN";"S";"0189";"   FINSI"
"SDIMAN";"S";"0190";"   SI HABS_MOTIF = ""ZDIM"""
"SDIMAN";"S";"0191";"      HJOU_IJQHDIMTRA = HABS_MOTIDUR"
"SDIMAN";"S";"0192";"   FINSI"
"SDIMAN";"S";"0193";"FINPOUR"
"SDIMAN";"S";"0194";"*"
"SDIMAN";"S";"0195";"***** Alimentation des rubriques de paiement Heures de dimanche >> *********************************"
"SDIMAN";"S";"0196";"*"
"SDIMAN";"S";"0197";"SI LOCA_DROIT = 1"
"SDIMAN";"S";"0198";"   SI HJOU_IJQHDIMTRA > 0"
"SDIMAN";"S";"0199";"*"
"SDIMAN";"S";"0200";"* 1. Evenementiel >>"
"SDIMAN";"S";"0201";"*"
"SDIMAN";"S";"0202";"      SI HJOU_SJQSOCIETE = ""PE"""
"SDIMAN";"S";"0203";"      OU HJOU_SJQSOCIETE = ""EV"""
"SDIMAN";"S";"0204";"         HJOU_SJRHDIF100 = HJOU_SJRHDIF100 + HJOU_IJQHDIMTRA"
"SDIMAN";"S";"0205";"      SINON"
"SDIMAN";"S";"0206";"*"
"SDIMAN";"S";"0207";"* 2. Diffusion >>"
"SDIMAN";"S";"0208";"*"
"SDIMAN";"S";"0209";"         SI HJOU_SJITYPSERV = ""DIFFUSION"""
"SDIMAN";"S";"0210";"         OU HJOU_SECTORI(1:3) = ""DVM"""
"SDIMAN";"S";"0211";"* Les 4 premières heures sont payées à 125% puis 200%"
"SDIMAN";"S";"0212";"            SI HJOU_IJQHDIMTRA > LOCA_SEUILDIF"
"SDIMAN";"S";"0213";"               HJOU_SJQHSP125 = LOCA_SEUILDIF"
"SDIMAN";"S";"0214";"               HJOU_SJQHSP200 = HJOU_IJQHDIMTRA - LOCA_SEUILDIF"
"SDIMAN";"S";"0215";"            SINON"
"SDIMAN";"S";"0216";"               HJOU_SJQHSP125 = HJOU_IJQHDIMTRA"
"SDIMAN";"S";"0217";"            FINSI"
"SDIMAN";"S";"0218";"         FINSI"
"SDIMAN";"S";"0219";"      FINSI"
"SDIMAN";"S";"0220";"*"
"SDIMAN";"S";"0221";"* 2. Portage >>"
"SDIMAN";"S";"0222";"      SI HJOU_SJQSOCIETE = ""PO"""
"SDIMAN";"S";"0223";"         HJOU_IJRCHDISP3 = HJOU_IJQHDIMTRA"
"SDIMAN";"S";"0224";"      FINSI"
"SDIMAN";"S";"0225";"*"
"SDIMAN";"S";"0226";"   FINSI"
"SDIMAN";"S";"0227";"FINSI"
"SDIMAN";"S";"0228";"*"
"SDIMAN";"S";"0229";"* Les autres métiers ne sont pas concernés par des majorations d'heures de nuit*"
"SDIMAN";"S";"0230";"*"
"SDIMAN";"S";"0231";"* Gestion des primes dimanches pour les CDD de l'industrie >>"
"SDIMAN";"S";"0232";"*"
"SDIMAN";"S";"0233";"* FFT025003799 - Si horaire de nuit ou repos, on regarde si travaille de samedi à dimanche"
"SDIMAN";"S";"0234";"*"
"SDIMAN";"S";"0235";"* Horaire de nuit ou repos ?"
"SDIMAN";"S";"0236";"*"
"SDIMAN";"S";"0237";"SI HJOU_JOUR = ""6"""
"SDIMAN";"S";"0238";"   SI LOCA_HORNUIT = 1"
"SDIMAN";"S";"0239";"      SI HJOU_IJQTTEFFEJ > 0.02"
"SDIMAN";"S";"0240";"         LOCA_CALCPRIM = 1"
"SDIMAN";"S";"0241";"      FINSI"
"SDIMAN";"S";"0242";"   FINSI"
"SDIMAN";"S";"0243";"FINSI"
"SDIMAN";"S";"0244";"*"
"SDIMAN";"S";"0245";"SI HJOU_JOUR = ""7"""
"SDIMAN";"S";"0246";"   SI HJOU_IJQHDIMTRA > 0"
"SDIMAN";"S";"0247";"      SI LOCA_HORNUIT <> 1"
"SDIMAN";"S";"0248";"         LOCA_CALCPRIM = 1"
"SDIMAN";"S";"0249";"      FINSI"
"SDIMAN";"S";"0250";"   FINSI"
"SDIMAN";"S";"0251";"FINSI"
"SDIMAN";"S";"0252";"*"
"SDIMAN";"S";"0253";"* Si heures de dimanches"
"SDIMAN";"S";"0254";"SI LOCA_CALCPRIM = 1"
"SDIMAN";"S";"0255";"* SI HJOU_IJQHDIMTRA > 0"
"SDIMAN";"S";"0256";"* Si CDD industrie hors FJ"
"SDIMAN";"S";"0257";"   SI HJOU_SECTORI(1:3) = ""DIN"""
"SDIMAN";"S";"0258";"      SI HJOU_SJQSOCIETE = ""MO"""
"SDIMAN";"S";"0259";"         SI HJOU_SJQFORFJR <> ""1"""
"SDIMAN";"S";"0260";"*"
"SDIMAN";"S";"0261";"            SI CTRA_TYPCTRA = ""CDD"""
"SDIMAN";"S";"0262";"* Si service de la roto >>"
"SDIMAN";"S";"0263";"               SI HJOU_SJITYPSERV = ""ROTATIVE"""
"SDIMAN";"S";"0264";"* Vérif si prime la veille"
"SDIMAN";"S";"0265";"                  LIREVALPRE LOCA_0411 HJOU_SJQPDI0411"
"SDIMAN";"S";"0266";"                  SI LOCA_0411 = 0"
"SDIMAN";"S";"0267";"                     HJOU_SJQPDI0411 = 1"
"SDIMAN";"S";"0268";"                  FINSI"
"SDIMAN";"S";"0269";"               FINSI"
"SDIMAN";"S";"0270";"* Si service de la expéd. >>"
"SDIMAN";"S";"0271";"               SI HJOU_SJITYPSERV = ""EXPEDITION"""
"SDIMAN";"S";"0272";"* Vérif si prime la veille"
"SDIMAN";"S";"0273";"                  LIREVALPRE LOCA_5411 HJOU_SJQPDI0411"
"SDIMAN";"S";"0274";"                  SI LOCA_5411 = 0"
"SDIMAN";"S";"0275";"                     HJOU_SJQPDI5411 = 1"
"SDIMAN";"S";"0276";"                  FINSI"
"SDIMAN";"S";"0277";"               FINSI"
"SDIMAN";"S";"0278";"            FINSI"
"SDIMAN";"S";"0279";"*"
"SDIMAN";"S";"0280";"         FINSI"
"SDIMAN";"S";"0281";"      FINSI"
"SDIMAN";"S";"0282";"   FINSI"
"SDIMAN";"S";"0283";"FINSI"
"SDIMAN";"S";"0284";"*"
"SDIMAN";"S";"0285";"* Gestion de la récup pour les CDI des services généraux à temps plein alim. récup si eff dim."
"SDIMAN";"S";"0286";"*"
"SDIMAN";"S";"0287";"* Si heures de dimanches"
"SDIMAN";"S";"0288";"SI HJOU_IJQHDIMTRA > 0"
"SDIMAN";"S";"0289";"* Si CDD industrie hors FJ"
"SDIMAN";"S";"0290";"   SI HJOU_SECTORI(1:3) = ""DIN"""
"SDIMAN";"S";"0291";"      SI HJOU_SJQSOCIETE = ""MO"""
"SDIMAN";"S";"0292";"         SI HJOU_SJQFORFJR <> ""1"""
"SDIMAN";"S";"0293";"*"
"SDIMAN";"S";"0294";"            SI CTRA_TYPCTRA = ""CDI"""
"SDIMAN";"S";"0295";"               SI HJOU_IJITYPCTRA = 100"
"SDIMAN";"S";"0296";"               OU HJOU_IJITYPCTRA = 0"
"SDIMAN";"S";"0297";"* Si service de la roto >>"
"SDIMAN";"S";"0298";"                  SI HJOU_SJITYPSERV = ""MOYGENERAUX"""
"SDIMAN";"S";"0299";"                     HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHDIMTRA"
"SDIMAN";"S";"0300";"                  FINSI"
"SDIMAN";"S";"0301";"               FINSI"
"SDIMAN";"S";"0302";"            FINSI"
"SDIMAN";"S";"0303";"*"
"SDIMAN";"S";"0304";"         FINSI"
"SDIMAN";"S";"0305";"      FINSI"
"SDIMAN";"S";"0306";"   FINSI"
"SDIMAN";"S";"0307";"FINSI"
"SDIMAN";"S";"0308";"*"
"SDIMAN";"S";"0309";"* Init consignes dimanche >>"
"SDIMAN";"S";"0310";"POUR ACTIVITES"
"SDIMAN";"S";"0311";"   SI HABS_MOTIF = ""ZHP7085"""
"SDIMAN";"S";"0312";"      HJOU_SJQHSP125 = HABS_MOTIDUR"
"SDIMAN";"S";"0313";"   FINSI"
"SDIMAN";"S";"0314";"   SI HABS_MOTIF = ""ZP0411"""
"SDIMAN";"S";"0315";"      HJOU_SJQPDI0411 = HABS_MOTINBR"
"SDIMAN";"S";"0316";"   FINSI"
"SDIMAN";"S";"0317";"   SI HABS_MOTIF = ""ZP5411"""
"SDIMAN";"S";"0318";"      HJOU_SJQPDI5411 = HABS_MOTINBR"
"SDIMAN";"S";"0319";"   FINSI"
"SDIMAN";"S";"0320";"   SI HABS_MOTIF = ""ZP0359"""
"SDIMAN";"S";"0321";"      HJOU_IJRCHDISP3 = HABS_MOTIDUR"
"SDIMAN";"S";"0322";"   FINSI"
"SDIMAN";"S";"0323";"FINPOUR"
"SDIMAN";"S";"0324";"*"
"SDIMAN";"S";"0325";"FIN"
"SDIMAN";"S";"0326";"*"
"SDIMAN";"S";"0327";"****************************************************************************************************"
"SDIMAN";"S";"0328";"***********                          PROCEDURE                                        **************"
"SDIMAN";"S";"0329";"****************************************************************************************************"
"SDIMAN";"S";"0330";"*"
"SDIMAN";"S";"0331";"* Gestion des plages"
"SDIMAN";"S";"0332";"PROC CALC1"
"SDIMAN";"S";"0333";"*"
"SDIMAN";"S";"0334";"   LOCA_DURDIM = 0"
"SDIMAN";"S";"0335";"   LOCA_DEBDIM = 0.00"
"SDIMAN";"S";"0336";"   LOCA_FINDIM = 24.00"
"SDIMAN";"S";"0337";"*"
"SDIMAN";"S";"0338";"   SI LOCA_MVE < LOCA_DEBDIM"
"SDIMAN";"S";"0339";"      SI LOCA_MVS > LOCA_DEBDIM"
"SDIMAN";"S";"0340";"         LOCA_MVE = LOCA_DEBDIM"
"SDIMAN";"S";"0341";"      FINSI"
"SDIMAN";"S";"0342";"   FINSI"
"SDIMAN";"S";"0343";"*"
"SDIMAN";"S";"0344";"   SI LOCA_MVS > LOCA_FINDIM"
"SDIMAN";"S";"0345";"      SI LOCA_MVE < LOCA_FINDIM"
"SDIMAN";"S";"0346";"         LOCA_MVS = LOCA_FINDIM"
"SDIMAN";"S";"0347";"      FINSI"
"SDIMAN";"S";"0348";"   FINSI"
"SDIMAN";"S";"0349";"*"
"SDIMAN";"S";"0350";"   SI LOCA_MVE >= LOCA_DEBDIM"
"SDIMAN";"S";"0351";"      SI LOCA_MVS <= LOCA_FINDIM"
"SDIMAN";"S";"0352";"         LOCA_DURDIM = LOCA_MVS - LOCA_MVE"
"SDIMAN";"S";"0353";"      FINSI"
"SDIMAN";"S";"0354";"   FINSI"
"SDIMAN";"S";"0355";"*"
"SDIMAN";"S";"0356";"   HJOU_IJQHDIMTRA = HJOU_IJQHDIMTRA + LOCA_DURDIM"
"SDIMAN";"S";"0357";"*"
"SDIMAN";"S";"0358";"FINPROC"
"SDIMAN";"S";"0359";"*"
"SDIMAN";"S";"0360";"* Gestion des motifs et HPLUS"
"SDIMAN";"S";"0361";"PROC CALC2"
"SDIMAN";"S";"0362";"*"
"SDIMAN";"S";"0363";"   LOCA_ABSDIM = 0"
"SDIMAN";"S";"0364";"   LOCA_DEBDIM = 0.00"
"SDIMAN";"S";"0365";"   LOCA_FINDIM = 24.00"
"SDIMAN";"S";"0366";"*"
"SDIMAN";"S";"0367";"   SI LOCA_MOTE < LOCA_DEBDIM"
"SDIMAN";"S";"0368";"      SI LOCA_MOTS > LOCA_DEBDIM"
"SDIMAN";"S";"0369";"         LOCA_MOTE = LOCA_DEBDIM"
"SDIMAN";"S";"0370";"      FINSI"
"SDIMAN";"S";"0371";"   FINSI"
"SDIMAN";"S";"0372";"*"
"SDIMAN";"S";"0373";"   SI LOCA_MOTS > LOCA_FINDIM"
"SDIMAN";"S";"0374";"      SI LOCA_MOTE < LOCA_FINDIM"
"SDIMAN";"S";"0375";"         LOCA_MOTS = LOCA_FINDIM"
"SDIMAN";"S";"0376";"      FINSI"
"SDIMAN";"S";"0377";"   FINSI"
"SDIMAN";"S";"0378";"*"
"SDIMAN";"S";"0379";"   SI LOCA_MOTE >= LOCA_DEBDIM"
"SDIMAN";"S";"0380";"      SI LOCA_MOTS <= LOCA_FINDIM"
"SDIMAN";"S";"0381";"         LOCA_ABSDIM = LOCA_MOTS - LOCA_MOTE"
"SDIMAN";"S";"0382";"      FINSI"
"SDIMAN";"S";"0383";"   FINSI"
"SDIMAN";"S";"0384";"*"
"SDIMAN";"S";"0385";"   HJOU_IJQHDIMTRA = HJOU_IJQHDIMTRA + LOCA_ABSDIM"
"SDIMAN";"S";"0386";"*"
"SDIMAN";"S";"0387";"FINPROC"
"SDONABS";"S";"0001";"**********************************************************************"
"SDONABS";"S";"0002";"*"
"SDONABS";"S";"0003";"* Règle : SDONABS"
"SDONABS";"S";"0004";"* Ordre : 8035"
"SDONABS";"S";"0005";"* Titre : GCF : Gestions des dons d'absence"
"SDONABS";"S";"0006";"*"
"SDONABS";"S";"0007";"*---------------------------------------------------------------------"
"SDONABS";"S";"0008";"*"
"SDONABS";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SDONABS";"S";"0010";"* Date     : 11/03/2025"
