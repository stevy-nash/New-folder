"IDISPJE";"S";"0056";"FINDICO"
"IDISPJE";"S";"0057";"*"
"IDISPJE";"S";"0058";"* Déclaration des donnees locales"
"IDISPJE";"S";"0059";"*"
"IDISPJE";"S";"0060";"DEF LOCA_VAL N2.1"
"IDISPJE";"S";"0061";"DEF LOCA_DATE D"
"IDISPJE";"S";"0062";"LOCA_DATE = "" """
"IDISPJE";"S";"0063";"DEF LOCA_ACOURS N4"
"IDISPJE";"S";"0064";"LOCA_ACOURS = 0"
"IDISPJE";"S";"0065";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPJE";"S";"0066";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISP5,"
"IDISPJE";"S";"0067";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJE";"S";"0068";"* par la date souhaitée"
"IDISPJE";"S";"0069";"*"
"IDISPJE";"S";"0070";"** alimentation du droit à la date de référence"
"IDISPJE";"S";"0071";"** raz du consommé à la date de référence"
"IDISPJE";"S";"0072";"SI HJOU_DATE = PARD_IDIDRDISP5"
"IDISPJE";"S";"0073";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJE";"S";"0074";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPJE";"S";"0075";"   * par le nombre paramétré dans PARD_IDIVDDISP5,"
"IDISPJE";"S";"0076";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJE";"S";"0077";"   * par le nombre souhaité"
"IDISPJE";"S";"0078";"   HJOU_IJRDJDISP5 = PARD_IDIVDDISP5"
"IDISPJE";"S";"0079";"   HJOU_IJRCJDISP5 = 0"
"IDISPJE";"S";"0080";"FINSI"
"IDISPJE";"S";"0081";"** alimentation du pris"
"IDISPJE";"S";"0082";"POUR ACTIVITES"
"IDISPJE";"S";"0083";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJE";"S";"0084";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISP5,"
"IDISPJE";"S";"0085";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPJE";"S";"0086";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPJE";"S";"0087";"   * pas il devra être créé)"
"IDISPJE";"S";"0088";"   SI HABS_MOTIF = PARD_IDIVMDISP5"
"IDISPJE";"S";"0089";"      SI HABS_MOTIDUR > 0"
"IDISPJE";"S";"0090";"         SI HABS_VALORIS = ""J"""
"IDISPJE";"S";"0091";"            LOCA_VAL = 1"
"IDISPJE";"S";"0092";"         SINON"
"IDISPJE";"S";"0093";"            LOCA_VAL = 0.5"
"IDISPJE";"S";"0094";"         FINSI"
"IDISPJE";"S";"0095";"      FINSI"
"IDISPJE";"S";"0096";"      HJOU_IJRCJDISP5 = HJOU_IJRCJDISP5 + LOCA_VAL"
"IDISPJE";"S";"0097";"      LOCA_VAL = 0"
"IDISPJE";"S";"0098";"   FINSI"
"IDISPJE";"S";"0099";"FINPOUR"
"IDISPJE";"S";"0100";"** alimentation du droit/pris par consignes"
"IDISPJE";"S";"0101";"POUR ACTIVITES"
"IDISPJE";"S";"0102";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJE";"S";"0103";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPJE";"S";"0104";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPJE";"S";"0105";"   * en conséquence)"
"IDISPJE";"S";"0106";"   SI HABS_MOTIF = ""ZDDIS5"""
"IDISPJE";"S";"0107";"      HJOU_IJRDJDISP5 = HABS_MOTINBR"
"IDISPJE";"S";"0108";"   FINSI"
"IDISPJE";"S";"0109";"   SI HABS_MOTIF = ""XDDIS5"""
"IDISPJE";"S";"0110";"      HJOU_IJRDJDISP5 = HJOU_IJRDJDISP5 + HABS_MOTINBR"
"IDISPJE";"S";"0111";"   FINSI"
"IDISPJE";"S";"0112";"   SI HABS_MOTIF = ""ZCDIS5"""
"IDISPJE";"S";"0113";"      HJOU_IJRCJDISP5 = HABS_MOTINBR"
"IDISPJE";"S";"0114";"   FINSI"
"IDISPJE";"S";"0115";"   SI HABS_MOTIF = ""XCDIS5"""
"IDISPJE";"S";"0116";"      HJOU_IJRCJDISP5 = HJOU_IJRCJDISP5 + HABS_MOTINBR"
"IDISPJE";"S";"0117";"   FINSI"
"IDISPJE";"S";"0118";"FINPOUR"
"IDISPJE";"S";"0119";"** calcul du solde"
"IDISPJE";"S";"0120";"HJOU_IJRSJDISP5 = HJOU_IJRDJDISP5 - HJOU_IJRCJDISP5"
"IDISPJE";"S";"0121";"LOCA_ACOURS << PARD_IDIDRDISP5(1:4)"
"IDISPJE";"S";"0122";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPJE";"S";"0123";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPJE";"S";"0124";"LOCA_DATE(5:4) = PARD_IDIDRDISP5(5:4)"
"IDISPJE";"S";"0125";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPJE";"S";"0126";"   EMPL_IEQSPDISP5 = HJOU_IJRSJDISP5"
"IDISPJE";"S";"0127";"FINSI"
"IDISPJE";"S";"0128";"FIN"
"IDISPJF";"S";"0001";"***********************************************************************"
"IDISPJF";"S";"0002";"*"
"IDISPJF";"S";"0003";"* Règle : IDISPJF"
"IDISPJF";"S";"0004";"* Ordre : 7050"
"IDISPJF";"S";"0005";"* Titre : Compteurs disponible 6 en jour"
"IDISPJF";"S";"0006";"*"
"IDISPJF";"S";"0007";"*----------------------------------------------------------------------"
"IDISPJF";"S";"0008";"*"
"IDISPJF";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDISPJF";"S";"0010";"* Date     : 03/09/2009"
"IDISPJF";"S";"0011";"* Version  : 1"
"IDISPJF";"S";"0012";"*"
"IDISPJF";"S";"0013";"*---------------------------------------------------------------------"
"IDISPJF";"S";"0014";"*"
"IDISPJF";"S";"0015";"*"
"IDISPJF";"S";"0016";"* Rôle : Mettre à disposition une règle gérant des compteurs droit/pris/solde"
"IDISPJF";"S";"0017";"*         Mais également des compteurs afin de ne pas avoir à en"
"IDISPJF";"S";"0018";"*         créer de nouveaux et lancer une perso (ex: client en prod,...)"
"IDISPJF";"S";"0019";"*"
"IDISPJF";"S";"0020";"*         Par défaut les différents compteurs ne sont pas affichés"
"IDISPJF";"S";"0021";"*         s'il y a besoin cela devra être fait via la fonction PER"
"IDISPJF";"S";"0022";"*         Les consignes ainsi que le motif de consommation sont à"
"IDISPJF";"S";"0023";"*         créer via la fonction ACT"
"IDISPJF";"S";"0024";"*"
"IDISPJF";"S";"0025";"*"
"IDISPJF";"S";"0026";"* Gestion du Droit/Pris/solde d'un compteur en jour"
"IDISPJF";"S";"0027";"* Le droit est alimenté en début de période de référence définie"
"IDISPJF";"S";"0028";"* dans les données globales datées par une valeur définie dans les"
"IDISPJF";"S";"0029";"* données globales datées"
"IDISPJF";"S";"0030";"* le pris est alimenté par un motif alimenté dans les données globales"
"IDISPJF";"S";"0031";"* datées"
"IDISPJF";"S";"0032";"* Pas de gestion d'anomalie en cas de solde négatif (à créer si besoin)"
"IDISPJF";"S";"0033";"*"
"IDISPJF";"S";"0034";"*----------------------------------------------------------------------"
"IDISPJF";"S";"0035";"*"
"IDISPJF";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPJF";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPJF";"S";"0038";"* Objet        :"
"IDISPJF";"S";"0039";"*"
"IDISPJF";"S";"0040";"***********************************************************************"
"IDISPJF";"S";"0041";"*"
"IDISPJF";"S";"0042";"* Implémentation des données industrielles"
"IDISPJF";"S";"0043";"*"
"IDISPJF";"S";"0044";"DEBDICO"
"IDISPJF";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJF";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPJF";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPJF";"S";"0048";"   * en passant par la fonction PER"
"IDISPJF";"S";"0049";"   HJOU_IJRDJDISP6;N;N6,2;L;;;    56789;;IJRDJDISP6;V3;""Droit en jour disponible 6"";"
"IDISPJF";"S";"0050";"   HJOU_IJRCJDISP6;N;N6,2;L;;;    56789;;IJRCJDISP6;V3;""Pris en jour disponible 6"";"
"IDISPJF";"S";"0051";"   HJOU_IJRSJDISP6;N;N6,2;L;;;    56789;;IJRSJDISP6;V3;""Solde en jour disponible 6"";"
"IDISPJF";"S";"0052";"   EMPL_IEQSPDISP6;N;N6,2;L;;;     6789;;;V3;""Solde prévisionnel en jour disponible 6"";"
"IDISPJF";"S";"0053";"PARD_IDIDRDISP6;O;D10;X;;;123456789;;;C3;""Date RAZ compteur jour disponible 6"";"
"IDISPJF";"S";"0054";"PARD_IDIVDDISP6;O;N6,2;I;;;123456789;;;C3;""Valeur droit jour compteur disponible  6"";"
"IDISPJF";"S";"0055";"PARD_IDIVMDISP6;O;A10;X;;;123456789;II;;C2;""Motif compteur en jour disponible 6"";"
"IDISPJF";"S";"0056";"FINDICO"
"IDISPJF";"S";"0057";"*"
"IDISPJF";"S";"0058";"* Déclaration des donnees locales"
"IDISPJF";"S";"0059";"*"
"IDISPJF";"S";"0060";"DEF LOCA_VAL N2.1"
"IDISPJF";"S";"0061";"DEF LOCA_DATE D"
"IDISPJF";"S";"0062";"LOCA_DATE = "" """
"IDISPJF";"S";"0063";"DEF LOCA_ACOURS N4"
"IDISPJF";"S";"0064";"LOCA_ACOURS = 0"
"IDISPJF";"S";"0065";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPJF";"S";"0066";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISP6,"
"IDISPJF";"S";"0067";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJF";"S";"0068";"* par la date souhaitée"
"IDISPJF";"S";"0069";"*"
"IDISPJF";"S";"0070";"** alimentation du droit à la date de référence"
"IDISPJF";"S";"0071";"** raz du consommé à la date de référence"
"IDISPJF";"S";"0072";"SI HJOU_DATE = PARD_IDIDRDISP6"
"IDISPJF";"S";"0073";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJF";"S";"0074";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPJF";"S";"0075";"   * par le nombre paramétré dans PARD_IDIVDDISP6,"
"IDISPJF";"S";"0076";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJF";"S";"0077";"   * par le nombre souhaité"
"IDISPJF";"S";"0078";"   HJOU_IJRDJDISP6 = PARD_IDIVDDISP6"
"IDISPJF";"S";"0079";"   HJOU_IJRCJDISP6 = 0"
"IDISPJF";"S";"0080";"FINSI"
"IDISPJF";"S";"0081";"** alimentation du pris"
"IDISPJF";"S";"0082";"POUR ACTIVITES"
"IDISPJF";"S";"0083";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJF";"S";"0084";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISP6,"
"IDISPJF";"S";"0085";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPJF";"S";"0086";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPJF";"S";"0087";"   * pas il devra être créé)"
"IDISPJF";"S";"0088";"   SI HABS_MOTIF = PARD_IDIVMDISP6"
"IDISPJF";"S";"0089";"      SI HABS_MOTIDUR > 0"
"IDISPJF";"S";"0090";"         SI HABS_VALORIS = ""J"""
"IDISPJF";"S";"0091";"            LOCA_VAL = 1"
"IDISPJF";"S";"0092";"         SINON"
"IDISPJF";"S";"0093";"            LOCA_VAL = 0.5"
"IDISPJF";"S";"0094";"         FINSI"
"IDISPJF";"S";"0095";"      FINSI"
"IDISPJF";"S";"0096";"      HJOU_IJRCJDISP6 = HJOU_IJRCJDISP6 + LOCA_VAL"
"IDISPJF";"S";"0097";"      LOCA_VAL = 0"
"IDISPJF";"S";"0098";"   FINSI"
"IDISPJF";"S";"0099";"FINPOUR"
"IDISPJF";"S";"0100";"** alimentation du droit/pris par consignes"
"IDISPJF";"S";"0101";"POUR ACTIVITES"
"IDISPJF";"S";"0102";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJF";"S";"0103";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPJF";"S";"0104";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPJF";"S";"0105";"   * en conséquence)"
"IDISPJF";"S";"0106";"   SI HABS_MOTIF = ""ZDDIS6"""
"IDISPJF";"S";"0107";"      HJOU_IJRDJDISP6 = HABS_MOTINBR"
"IDISPJF";"S";"0108";"   FINSI"
"IDISPJF";"S";"0109";"   SI HABS_MOTIF = ""XDDIS6"""
"IDISPJF";"S";"0110";"      HJOU_IJRDJDISP6 = HJOU_IJRDJDISP6 + HABS_MOTINBR"
"IDISPJF";"S";"0111";"   FINSI"
"IDISPJF";"S";"0112";"   SI HABS_MOTIF = ""ZCDIS6"""
"IDISPJF";"S";"0113";"      HJOU_IJRCJDISP6 = HABS_MOTINBR"
"IDISPJF";"S";"0114";"   FINSI"
"IDISPJF";"S";"0115";"   SI HABS_MOTIF = ""XCDIS6"""
"IDISPJF";"S";"0116";"      HJOU_IJRCJDISP6 = HJOU_IJRCJDISP6 + HABS_MOTINBR"
"IDISPJF";"S";"0117";"   FINSI"
"IDISPJF";"S";"0118";"FINPOUR"
"IDISPJF";"S";"0119";"** calcul du solde"
"IDISPJF";"S";"0120";"HJOU_IJRSJDISP6 = HJOU_IJRDJDISP6 - HJOU_IJRCJDISP6"
"IDISPJF";"S";"0121";"LOCA_ACOURS << PARD_IDIDRDISP6(1:4)"
"IDISPJF";"S";"0122";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPJF";"S";"0123";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPJF";"S";"0124";"LOCA_DATE(5:4) = PARD_IDIDRDISP6(5:4)"
"IDISPJF";"S";"0125";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPJF";"S";"0126";"   EMPL_IEQSPDISP6 = HJOU_IJRSJDISP6"
"IDISPJF";"S";"0127";"FINSI"
"IDISPJF";"S";"0128";"FIN"
"IDONABS";"S";"0001";"**********************************************************************"
"IDONABS";"S";"0002";"*"
"IDONABS";"S";"0003";"* Règle : IDONABS"
"IDONABS";"S";"0004";"* Ordre : 8030"
"IDONABS";"S";"0005";"* Titre : Gestion des dons de congés"
"IDONABS";"S";"0006";"*"
"IDONABS";"S";"0007";"*---------------------------------------------------------------------"
"IDONABS";"S";"0008";"*"
"IDONABS";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDONABS";"S";"0010";"* Date     : 28/07/2015"
"IDONABS";"S";"0011";"* Version  : 1"
"IDONABS";"S";"0012";"*"
"IDONABS";"S";"0013";"*---------------------------------------------------------------------"
"IDONABS";"S";"0014";"*"
"IDONABS";"S";"0015";"*"
"IDONABS";"S";"0016";"* Rôle :"
"IDONABS";"S";"0017";"* - alimentation d'un compteur de don CP et contrôle d'une valeur maxib de 5"
"IDONABS";"S";"0018";"* - alimentation d'un compteur de don divers CP / RTT /CET"
"IDONABS";"S";"0019";"* - alimentation et gestion de de la prise d'un compteur Don jours d""absences"
"IDONABS";"S";"0020";"*"
"IDONABS";"S";"0021";"*----------------------------------------------------------------------"
"IDONABS";"S";"0022";"*"
"IDONABS";"S";"0023";"* Implémentation des données industrielles"
"IDONABS";"S";"0024";"*"
"IDONABS";"S";"0025";"*"
"IDONABS";"S";"0026";"DEBDICO"
"IDONABS";"S";"0027";"   HJOU_IJRSDONCP;N;N6,1;I;;;    56789;;IJRSDONCP;V3;""Don jours de congés"";"
"IDONABS";"S";"0028";"   HJOU_IJRSDONDIV;N;N6,1;I;;;    56789;;IJRSDONDIV;V3;""Don absences global"";"
"IDONABS";"S";"0029";"   HJOU_IJRSDONABS;N;N6,1;I;;;    56789;;IJRSDONABS;V3;""Solde jours d'absences sur don"";"
"IDONABS";"S";"0030";"   PARD_IDIVMDONCP;O;A10;X;;;123456789;II;;C2;""Motif absence sur don"";"
"IDONABS";"S";"0031";"FINDICO"
"IDONABS";"S";"0032";"*"
"IDONABS";"S";"0033";"DEBANO"
"IDONABS";"S";"0034";"   187;9;""Dons congés supérieur au maximum"";"
"IDONABS";"S";"0035";"   188;9;""Solde don jours d'absences insuffisant"";"
"IDONABS";"S";"0036";"FINANO"
"IDONABS";"S";"0037";"*"
"IDONABS";"S";"0038";"* Définition des variables locales"
"IDONABS";"S";"0039";"*"
"IDONABS";"S";"0040";"*"
"IDONABS";"S";"0041";"DEF LOCA_VAL N2.1"
"IDONABS";"S";"0042";"LOCA_VAL = 0"
"IDONABS";"S";"0043";"*"
"IDONABS";"S";"0044";"DEF LOCA_REFCP N4"
"IDONABS";"S";"0045";"LOCA_REFCP = 0"
"IDONABS";"S";"0046";"DEF LOCA_DATREFDON D"
"IDONABS";"S";"0047";"LOCA_DATREFDON = "" """
"IDONABS";"S";"0048";"*"
"IDONABS";"S";"0049";"*DEF CPTG_DONCP N3"
"IDONABS";"S";"0050";"*PERGLISS CPTG_DONCP ""366J01"""
"IDONABS";"S";"0051";"*"
"IDONABS";"S";"0052";"* RAZ du compteur Don cp en date de référence CP"
"IDONABS";"S";"0053";"*"
"IDONABS";"S";"0054";"LOCA_REFCP << CONF_ITIVMREFCP(3:2)"
"IDONABS";"S";"0055";"LOCA_DATREFDON(5:2) << LOCA_REFCP"
"IDONABS";"S";"0056";"*"
"IDONABS";"S";"0057";"LOCA_REFCP << CONF_ITIVMREFCP(1:2)"
"IDONABS";"S";"0058";"LOCA_DATREFDON(7:2) << LOCA_REFCP"
"IDONABS";"S";"0059";"*"
"IDONABS";"S";"0060";"SI HJOU_DATE(5:4) = LOCA_DATREFDON(5:4)"
"IDONABS";"S";"0061";"   HJOU_IJRSDONDIV = HJOU_IJRSDONDIV - HJOU_IJRSDONCP"
"IDONABS";"S";"0062";"   HJOU_IJRSDONCP = 0"
"IDONABS";"S";"0063";"FINSI"
"IDONABS";"S";"0064";"*"
"IDONABS";"S";"0065";"*"
"IDONABS";"S";"0066";"* Alimentation du compteur du nbr de CP donnés"
"IDONABS";"S";"0067";"*"
"IDONABS";"S";"0068";"POUR ACTIVITES"
"IDONABS";"S";"0069";"* don cp"
"IDONABS";"S";"0070";"   SI HABS_MOTIF = ""YCPDON"""
"IDONABS";"S";"0071";"      SI TEMP_ITQTRCPDON <> 1"
"IDONABS";"S";"0072";"         HJOU_IJRSDONCP = HJOU_IJRSDONCP + HABS_MOTINBR"
"IDONABS";"S";"0073";"         HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HABS_MOTINBR"
"IDONABS";"S";"0074";"      FINSI"
"IDONABS";"S";"0075";"   FINSI"
"IDONABS";"S";"0076";"* don CET"
"IDONABS";"S";"0077";"   SI HABS_MOTIF = ""YCETDON"""
"IDONABS";"S";"0078";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HABS_MOTINBR"
"IDONABS";"S";"0079";"   FINSI"
"IDONABS";"S";"0080";"* don RTT"
"IDONABS";"S";"0081";"   SI HABS_MOTIF = ""YRTTDON"""
"IDONABS";"S";"0082";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HABS_MOTINBR"
"IDONABS";"S";"0083";"   FINSI"
"IDONABS";"S";"0084";"*"
"IDONABS";"S";"0085";"* initialisation après consigne"
"IDONABS";"S";"0086";"   SI HABS_MOTIF = ""ZCPDON"""
"IDONABS";"S";"0087";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV - HJOU_IJRSDONCP"
"IDONABS";"S";"0088";"      HJOU_IJRSDONCP = HABS_MOTINBR"
"IDONABS";"S";"0089";"      HJOU_IJRSDONDIV = HJOU_IJRSDONDIV + HJOU_IJRSDONCP"
"IDONABS";"S";"0090";"   FINSI"
"IDONABS";"S";"0091";"   SI HABS_MOTIF = ""ZDIVDON"""
"IDONABS";"S";"0092";"      HJOU_IJRSDONDIV = HABS_MOTINBR"
"IDONABS";"S";"0093";"   FINSI"
"IDONABS";"S";"0094";"*"
"IDONABS";"S";"0095";"FINPOUR"
"IDONABS";"S";"0096";"*"
"IDONABS";"S";"0097";"SI HJOU_IJRSDONCP > 5"
"IDONABS";"S";"0098";"   ANOMALIE 187"
"IDONABS";"S";"0099";"FINSI"
"IDONABS";"S";"0100";"*"
"IDONABS";"S";"0101";"*"
"IDONABS";"S";"0102";"* Alimentation du compteur par consignes"
"IDONABS";"S";"0103";"POUR ACTIVITES"
"IDONABS";"S";"0104";"*"
"IDONABS";"S";"0105";"   SI HABS_MOTIF = ""ZDONABS"""
"IDONABS";"S";"0106";"      HJOU_IJRSDONABS = HABS_MOTINBR"
"IDONABS";"S";"0107";"   FINSI"
"IDONABS";"S";"0108";"*"
"IDONABS";"S";"0109";"   SI HABS_MOTIF = ""XDONABS"""
"IDONABS";"S";"0110";"      HJOU_IJRSDONABS = HJOU_IJRSDONABS + HABS_MOTINBR"
"IDONABS";"S";"0111";"   FINSI"
"IDONABS";"S";"0112";"FINPOUR"
"IDONABS";"S";"0113";"*"
"IDONABS";"S";"0114";"* calcul du pris"
"IDONABS";"S";"0115";"POUR ACTIVITES"
"IDONABS";"S";"0116";"*"
"IDONABS";"S";"0117";"   SI HABS_MOTIF = PARD_IDIVMDONCP"
"IDONABS";"S";"0118";"      SI HABS_VALORIS = ""J"""
"IDONABS";"S";"0119";"         LOCA_VAL = 1"
"IDONABS";"S";"0120";"      SINON"
"IDONABS";"S";"0121";"         LOCA_VAL = 0.5"
"IDONABS";"S";"0122";"      FINSI"
"IDONABS";"S";"0123";"   FINSI"
"IDONABS";"S";"0124";"FINPOUR"
"IDONABS";"S";"0125";"*"
"IDONABS";"S";"0126";"SI HJOU_IJRSDONABS >= LOCA_VAL"
"IDONABS";"S";"0127";"   HJOU_IJRSDONABS = HJOU_IJRSDONABS - LOCA_VAL"
"IDONABS";"S";"0128";"SINON"
"IDONABS";"S";"0129";"   ANOMALIE 188"
"IDONABS";"S";"0130";"FINSI"
"IDONABS";"S";"0131";"*"
"IDONABS";"S";"0132";"* Simulation des dons CP"
"IDONABS";"S";"0133";"*"
"IDONABS";"S";"0134";"* Blocage de la demande si le compteur don CP > 5"
"IDONABS";"S";"0135";"*"
"IDONABS";"S";"0136";"SI TEMP_REGLESIMU = ""IDONABS"""
"IDONABS";"S";"0137";"   SI TEMP_CNMOTIF = ""YCPDON"""
"IDONABS";"S";"0138";"      SI HJOU_IJRSDONCP > 5"
"IDONABS";"S";"0139";"         TEMP_CNRETOUR = 2"
"IDONABS";"S";"0140";"         TEMP_CNMESS = 187"
"IDONABS";"S";"0141";"      FINSI"
"IDONABS";"S";"0142";"   FINSI"
"IDONABS";"S";"0143";"FINSI"
"IDONABS";"S";"0144";"FIN"
"IDURABS";"S";"0001";"***********************************************************************"
"IDURABS";"S";"0002";"*"
"IDURABS";"S";"0003";"* Règle : IDURABS"
"IDURABS";"S";"0004";"* Ordre : 3090"
"IDURABS";"S";"0005";"* Titre : Durée des absences"
"IDURABS";"S";"0006";"*"
"IDURABS";"S";"0007";"*----------------------------------------------------------------------"
"IDURABS";"S";"0008";"*"
"IDURABS";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDURABS";"S";"0010";"* Date     : 10/08/2018"
"IDURABS";"S";"0011";"* Version  : 1"
"IDURABS";"S";"0012";"*"
"IDURABS";"S";"0013";"*----------------------------------------------------------------------"
"IDURABS";"S";"0014";"*"
"IDURABS";"S";"0015";"*"
"IDURABS";"S";"0016";"* Rôle : Calcul de la durée des absences"
"IDURABS";"S";"0017";"*"
"IDURABS";"S";"0018";"*"
"IDURABS";"S";"0019";"***********************************************************************"
"IDURABS";"S";"0020";"*"
"IDURABS";"S";"0021";"* Implémentation des données industrielles"
"IDURABS";"S";"0022";"*"
"IDURABS";"S";"0023";"DEBDICO"
"IDURABS";"S";"0024";"   HJOU_IJRNBMOTIH;N;N3;I;;;    56789;;IJRNBMOTIH;V3;""Nombre de motifs hebdomadaire"";"
"IDURABS";"S";"0025";"   HJOU_IJRDURMOTH;N;T6,2;I;;;    56789;;IJRDURMOTH;V3;""Durée des motifs hebdomadaire"";"
"IDURABS";"S";"0026";"FINDICO"
"IDURABS";"S";"0027";"*"
"IDURABS";"S";"0028";"* Déclaration des donnees locales"
"IDURABS";"S";"0029";"*"
"IDURABS";"S";"0030";"DEF LOCA_CTRBASE T6.2"
"IDURABS";"S";"0031";"LOCA_CTRBASE = 0"
"IDURABS";"S";"0032";"* à activer si la donnée est créée"
"IDURABS";"S";"0033";"*LOCA_CTRBASE = HJOU_IJQCTRBASE"
"IDURABS";"S";"0034";"DEF LOCA_CAL N1"
"IDURABS";"S";"0035";"LOCA_CAL = 0"
"IDURABS";"S";"0036";"*"
"IDURABS";"S";"0037";"*"
"IDURABS";"S";"0038";"* RAZ au lundi ou début de contrat du nombre de motifs dans la semaine"
"IDURABS";"S";"0039";"SI HJOU_JOUR = ""1"""
"IDURABS";"S";"0040";"OU CTRA_DATDEB = HJOU_DATE"
"IDURABS";"S";"0041";"   HJOU_IJRNBMOTIH = 0"
"IDURABS";"S";"0042";"   HJOU_IJRDURMOTH = 0"
"IDURABS";"S";"0043";"FINSI"
"IDURABS";"S";"0044";"*"
"IDURABS";"S";"0045";"POUR ACTIVITES"
"IDURABS";"S";"0046";"*"
"IDURABS";"S";"0047";"* durée fixe"
"IDURABS";"S";"0048";"   SI MOTI_IMIGDURABS = ""FIX"""
"IDURABS";"S";"0049";"      SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0050";"      OU HABS_VALORIS = ""A"""
"IDURABS";"S";"0051";"         HABS_MOTIDUR = MOTI_VALDFT / 2"
"IDURABS";"S";"0052";"      FINSI"
"IDURABS";"S";"0053";"      SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0054";"      OU HABS_VALORIS = ""N"""
"IDURABS";"S";"0055";"         HABS_MOTIDUR = MOTI_VALDFT"
"IDURABS";"S";"0056";"      FINSI"
"IDURABS";"S";"0057";"   FINSI"
"IDURABS";"S";"0058";"*"
"IDURABS";"S";"0059";"* gestion des absences/présences"
"IDURABS";"S";"0060";"   SI PROF_PRETHEO > 0"
"IDURABS";"S";"0061";"      SI HABS_MOTYPE <> ""C"""
"IDURABS";"S";"0062";"* nombre de motifs dans la semaine"
"IDURABS";"S";"0063";"         SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0064";"         OU HABS_VALORIS = ""A"""
"IDURABS";"S";"0065";"            HJOU_IJRNBMOTIH = HJOU_IJRNBMOTIH + 0.5"
"IDURABS";"S";"0066";"         SINON"
"IDURABS";"S";"0067";"            SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0068";"               HJOU_IJRNBMOTIH = HJOU_IJRNBMOTIH + 1"
"IDURABS";"S";"0069";"            FINSI"
"IDURABS";"S";"0070";"         FINSI"
"IDURABS";"S";"0071";"*"
"IDURABS";"S";"0072";"* 1/5ième du contrat"
"IDURABS";"S";"0073";"         SI MOTI_IMIGDURABS = ""C5"""
"IDURABS";"S";"0074";"            SI HJOU_IJRNBMOTIH < 5"
"IDURABS";"S";"0075";"               SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0076";"                  HABS_MOTIDUR = CTRA_BASECONT / 5"
"IDURABS";"S";"0077";"               FINSI"
"IDURABS";"S";"0078";"               SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0079";"               OU HABS_VALORIS = ""A"""
"IDURABS";"S";"0080";"                  HABS_MOTIDUR = CTRA_BASECONT / 5"
"IDURABS";"S";"0081";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"IDURABS";"S";"0082";"               FINSI"
"IDURABS";"S";"0083";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"IDURABS";"S";"0084";"            SINON"
"IDURABS";"S";"0085";"* reliquat de la semaine"
"IDURABS";"S";"0086";"               SI HJOU_IJRNBMOTIH = 5"
"IDURABS";"S";"0087";"                  HABS_MOTIDUR = CTRA_BASECONT - HJOU_IJRDURMOTH"
"IDURABS";"S";"0088";"               SINON"
"IDURABS";"S";"0089";"* maximum 5 jours valorisés dans la semaine"
"IDURABS";"S";"0090";"                  HABS_MOTIDUR = 0"
"IDURABS";"S";"0091";"               FINSI"
"IDURABS";"S";"0092";"            FINSI"
"IDURABS";"S";"0093";"         FINSI"
"IDURABS";"S";"0094";"*"
"IDURABS";"S";"0095";"* 1/6ième du contrat"
"IDURABS";"S";"0096";"         SI MOTI_IMIGDURABS = ""C6"""
"IDURABS";"S";"0097";"            SI HJOU_IJRNBMOTIH < 6"
"IDURABS";"S";"0098";"               SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0099";"                  HABS_MOTIDUR = CTRA_BASECONT / 6"
"IDURABS";"S";"0100";"               FINSI"
"IDURABS";"S";"0101";"               SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0102";"               OU HABS_VALORIS = ""A"""
"IDURABS";"S";"0103";"                  HABS_MOTIDUR = CTRA_BASECONT / 6"
"IDURABS";"S";"0104";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"IDURABS";"S";"0105";"               FINSI"
"IDURABS";"S";"0106";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"IDURABS";"S";"0107";"            SINON"
"IDURABS";"S";"0108";"* reliquat de la semaine"
"IDURABS";"S";"0109";"               SI HJOU_IJRNBMOTIH = 6"
"IDURABS";"S";"0110";"                  HABS_MOTIDUR = CTRA_BASECONT - HJOU_IJRDURMOTH"
"IDURABS";"S";"0111";"               SINON"
"IDURABS";"S";"0112";"* maximum 6 jours valorisés dans la semaine"
"IDURABS";"S";"0113";"                  HABS_MOTIDUR = 0"
"IDURABS";"S";"0114";"               FINSI"
"IDURABS";"S";"0115";"            FINSI"
"IDURABS";"S";"0116";"         FINSI"
"IDURABS";"S";"0117";"*"
"IDURABS";"S";"0118";"* 1/7ième du contrat"
"IDURABS";"S";"0119";"         SI MOTI_IMIGDURABS = ""C7"""
"IDURABS";"S";"0120";"            SI HJOU_IJRNBMOTIH < 7"
"IDURABS";"S";"0121";"               SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0122";"                  HABS_MOTIDUR = CTRA_BASECONT / 7"
"IDURABS";"S";"0123";"               FINSI"
"IDURABS";"S";"0124";"               SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0125";"               OU HABS_VALORIS = ""A"""
"IDURABS";"S";"0126";"                  HABS_MOTIDUR = CTRA_BASECONT / 7"
"IDURABS";"S";"0127";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"IDURABS";"S";"0128";"               FINSI"
"IDURABS";"S";"0129";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"IDURABS";"S";"0130";"            SINON"
"IDURABS";"S";"0131";"* reliquat de la semaine"
"IDURABS";"S";"0132";"               HABS_MOTIDUR = CTRA_BASECONT - HJOU_IJRDURMOTH"
"IDURABS";"S";"0133";"            FINSI"
"IDURABS";"S";"0134";"         FINSI"
"IDURABS";"S";"0135";"*"
"IDURABS";"S";"0136";"* présence théorique"
"IDURABS";"S";"0137";"         SI MOTI_IMIGDURABS = ""PLG"""
"IDURABS";"S";"0138";"            SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0139";"               HABS_MOTIDUR = HJOU_IJQPRETHEJ"
"IDURABS";"S";"0140";"            FINSI"
"IDURABS";"S";"0141";"            SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0142";"               HABS_MOTIDUR = HJOU_IJQPLGMAT"
"IDURABS";"S";"0143";"            FINSI"
"IDURABS";"S";"0144";"            SI HABS_VALORIS = ""A"""
"IDURABS";"S";"0145";"               HABS_MOTIDUR = HJOU_IJQPLGAPM"
"IDURABS";"S";"0146";"            FINSI"
"IDURABS";"S";"0147";"         FINSI"
"IDURABS";"S";"0148";"*"
"IDURABS";"S";"0149";"* 1/5ième du contrat hebdo"
"IDURABS";"S";"0150";"         SI MOTI_IMIGDURABS = ""H5"""
"IDURABS";"S";"0151";"            SI HJOU_IJRNBMOTIH < 5"
"IDURABS";"S";"0152";"               SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0153";"                  HABS_MOTIDUR = LOCA_CTRBASE / 5"
"IDURABS";"S";"0154";"               FINSI"
"IDURABS";"S";"0155";"               SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0156";"               OU HABS_VALORIS = ""A"""
"IDURABS";"S";"0157";"                  HABS_MOTIDUR = LOCA_CTRBASE / 5"
"IDURABS";"S";"0158";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"IDURABS";"S";"0159";"               FINSI"
"IDURABS";"S";"0160";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"IDURABS";"S";"0161";"            SINON"
"IDURABS";"S";"0162";"* reliquat de la semaine"
"IDURABS";"S";"0163";"               SI HJOU_IJRNBMOTIH = 5"
"IDURABS";"S";"0164";"                  HABS_MOTIDUR = LOCA_CTRBASE - HJOU_IJRDURMOTH"
"IDURABS";"S";"0165";"               SINON"
"IDURABS";"S";"0166";"* maximum 5 jours valorisés dans la semaine"
"IDURABS";"S";"0167";"                  HABS_MOTIDUR = 0"
"IDURABS";"S";"0168";"               FINSI"
"IDURABS";"S";"0169";"            FINSI"
"IDURABS";"S";"0170";"         FINSI"
"IDURABS";"S";"0171";"*"
"IDURABS";"S";"0172";"* 1/6ième du contrat hebdo"
"IDURABS";"S";"0173";"         SI MOTI_IMIGDURABS = ""H6"""
"IDURABS";"S";"0174";"            SI HJOU_IJRNBMOTIH < 6"
"IDURABS";"S";"0175";"               SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0176";"                  HABS_MOTIDUR = LOCA_CTRBASE / 6"
"IDURABS";"S";"0177";"               FINSI"
"IDURABS";"S";"0178";"               SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0179";"               OU HABS_VALORIS = ""A"""
"IDURABS";"S";"0180";"                  HABS_MOTIDUR = LOCA_CTRBASE / 6"
"IDURABS";"S";"0181";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"IDURABS";"S";"0182";"               FINSI"
"IDURABS";"S";"0183";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"IDURABS";"S";"0184";"            SINON"
"IDURABS";"S";"0185";"* reliquat de la semaine"
"IDURABS";"S";"0186";"               SI HJOU_IJRNBMOTIH = 6"
"IDURABS";"S";"0187";"                  HABS_MOTIDUR = LOCA_CTRBASE - HJOU_IJRDURMOTH"
"IDURABS";"S";"0188";"               SINON"
"IDURABS";"S";"0189";"* maximum 6 jours valorisés dans la semaine"
"IDURABS";"S";"0190";"                  HABS_MOTIDUR = 0"
"IDURABS";"S";"0191";"               FINSI"
"IDURABS";"S";"0192";"            FINSI"
"IDURABS";"S";"0193";"         FINSI"
"IDURABS";"S";"0194";"*"
"IDURABS";"S";"0195";"* 1/7ième du contrat hebdo"
"IDURABS";"S";"0196";"         SI MOTI_IMIGDURABS = ""H7"""
"IDURABS";"S";"0197";"            SI HJOU_IJRNBMOTIH < 7"
"IDURABS";"S";"0198";"               SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0199";"                  HABS_MOTIDUR = LOCA_CTRBASE / 7"
"IDURABS";"S";"0200";"               FINSI"
"IDURABS";"S";"0201";"               SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0202";"               OU HABS_VALORIS = ""A"""
"IDURABS";"S";"0203";"                  HABS_MOTIDUR = LOCA_CTRBASE / 7"
"IDURABS";"S";"0204";"                  HABS_MOTIDUR = HABS_MOTIDUR / 2"
"IDURABS";"S";"0205";"               FINSI"
"IDURABS";"S";"0206";"               HJOU_IJRDURMOTH = HJOU_IJRDURMOTH + HABS_MOTIDUR"
"IDURABS";"S";"0207";"            SINON"
"IDURABS";"S";"0208";"* reliquat de la semaine"
"IDURABS";"S";"0209";"               HABS_MOTIDUR = LOCA_CTRBASE - HJOU_IJRDURMOTH"
"IDURABS";"S";"0210";"            FINSI"
"IDURABS";"S";"0211";"         FINSI"
"IDURABS";"S";"0212";"*"
"IDURABS";"S";"0213";"* planning optimum non validé (absences/présences non planifiables)"
"IDURABS";"S";"0214";"         LOCA_CAL = 0"
"IDURABS";"S";"0215";"         SI CTRA_TYPEPLAN = ""1"""
"IDURABS";"S";"0216";"         OU CTRA_TYPEPLAN = ""6"""
"IDURABS";"S";"0217";"            SI HJOU_HJVALPLN = 0"
"IDURABS";"S";"0218";"            OU HJOU_HJVALPLN = 2"
"IDURABS";"S";"0219";"               SI MOTI_PLANIF <> ""1"""
"IDURABS";"S";"0220";"                  LOCA_CAL = 1"
"IDURABS";"S";"0221";"               FINSI"
"IDURABS";"S";"0222";"            FINSI"
"IDURABS";"S";"0223";"         FINSI"
"IDURABS";"S";"0224";"*"
"IDURABS";"S";"0225";"* modification de la théorie journalière pour planning optimum non validé"
"IDURABS";"S";"0226";"         SI LOCA_CAL = 1"
"IDURABS";"S";"0227";"* motifs matin"
"IDURABS";"S";"0228";"            SI HABS_VALORIS = ""M"""
"IDURABS";"S";"0229";"               HJOU_IJQPLGMAT = HABS_MOTIDUR"
"IDURABS";"S";"0230";"            FINSI"
"IDURABS";"S";"0231";"* motifs après-midi"
"IDURABS";"S";"0232";"            SI HABS_VALORIS = ""A"""
"IDURABS";"S";"0233";"               HJOU_IJQPLGAPM = HABS_MOTIDUR"
"IDURABS";"S";"0234";"            FINSI"
"IDURABS";"S";"0235";"* total plages"
"IDURABS";"S";"0236";"            HJOU_IJQPLGTOTJ = HJOU_IJQPLGMAT + HJOU_IJQPLGAPM"
"IDURABS";"S";"0237";"* motifs jour"
"IDURABS";"S";"0238";"            SI HABS_VALORIS = ""J"""
"IDURABS";"S";"0239";"               HJOU_IJQPLGMAT = 0"
"IDURABS";"S";"0240";"               HJOU_IJQPLGAPM = 0"
"IDURABS";"S";"0241";"               HJOU_IJQPLGTOTJ = HABS_MOTIDUR"
"IDURABS";"S";"0242";"            FINSI"
"IDURABS";"S";"0243";"* motifs en heures"
"IDURABS";"S";"0244";"            SI HABS_VALORIS = ""H"""
"IDURABS";"S";"0245";"               HJOU_IJQPLGTOTJ = HJOU_IJQPLGTOTJ + HABS_MOTIDUR"
"IDURABS";"S";"0246";"            FINSI"
"IDURABS";"S";"0247";"         FINSI"
"IDURABS";"S";"0248";"      FINSI"
"IDURABS";"S";"0249";"   FINSI"
"IDURABS";"S";"0250";"FINPOUR"
"IDURABS";"S";"0251";"*"
"IDURABS";"S";"0252";"FIN"
