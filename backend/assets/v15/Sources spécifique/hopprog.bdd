"IMISSJ";"S";"0030";"DEBDICO"
"IMISSJ";"S";"0031";"   HJOU_INMISS;O;Z1;X;;;123456789;L;;C2;""Mission autorisée"";"
"IMISSJ";"S";"0032";"   HJOU_IJRF2PRBHS;N;Z1;X;0;9;    56789;;IJRF2PRBHS;V2;""Flag prés. b. h.s. sur x jours (N2)"";"
"IMISSJ";"S";"0033";"   HJOU_IJQPRESBA1;N;T6,2;I;;;    56789;;;V2;""Présence badgée matin"";"
"IMISSJ";"S";"0034";"   HJOU_IJQPRESBA2;N;T6,2;I;;;    56789;;;V2;""Présence badgée après-midi"";"
"IMISSJ";"S";"0035";"   HJOU_IJQFMISPDJ;N;N2;I;;;     6789;;;V2;""Flag pause médienne mission"";"
"IMISSJ";"S";"0036";"   HJOU_IJQFMISBAD;O;N2;I;;;    56789;;;V2;""Flag présence hors site badgée"";"
"IMISSJ";"S";"0037";"   HJOU_IJQMISBADG;N;T6,2;I;;;    56789;;;V2;""Présence hors site badgée"";"
"IMISSJ";"S";"0038";"   HJOU_IJQMISSRET;N;T6,2;I;;;    56789;;;V2;""Présence h. s.borne déb. et 1er pointage"";"
"IMISSJ";"S";"0039";"   TEMP_RETOUR;N;T6,2;I;;;    56789;;;V2;""Retour mission"";"
"IMISSJ";"S";"0040";"   TEMP_TEMISS;O;Z1;X;0;1;    56789;;;V2;""Indicateur pour repas mission"";"
"IMISSJ";"S";"0041";"FINDICO"
"IMISSJ";"S";"0042";"*"
"IMISSJ";"S";"0043";"* Déclaration des donnees locales"
"IMISSJ";"S";"0044";"*"
"IMISSJ";"S";"0045";"DEF LOCA_PRESM N1"
"IMISSJ";"S";"0046";"LOCA_PRESM = 0"
"IMISSJ";"S";"0047";"DEF LOCA_PRESA N1"
"IMISSJ";"S";"0048";"LOCA_PRESA = 0"
"IMISSJ";"S";"0049";"DEF LOCA_TEST N1"
"IMISSJ";"S";"0050";"LOCA_TEST = 0"
"IMISSJ";"S";"0051";"DEF LOCA_DEJDEB T6.2"
"IMISSJ";"S";"0052";"LOCA_DEJDEB = 0"
"IMISSJ";"S";"0053";"DEF LOCA_DEJFIN T6.2"
"IMISSJ";"S";"0054";"LOCA_DEJFIN = 0"
"IMISSJ";"S";"0055";"DEF LOCA_DEJLIM T6.2"
"IMISSJ";"S";"0056";"LOCA_DEJLIM = 0"
"IMISSJ";"S";"0057";"DEF LOCA_SUP T6.2"
"IMISSJ";"S";"0058";"LOCA_SUP = 0"
"IMISSJ";"S";"0059";"DEF LOCA_INF T6.2"
"IMISSJ";"S";"0060";"LOCA_INF = 0"
"IMISSJ";"S";"0061";"DEF LOCA_DIF T6.2"
"IMISSJ";"S";"0062";"LOCA_DIF = 0"
"IMISSJ";"S";"0063";"DEF LOCA_IMPUT A6"
"IMISSJ";"S";"0064";"LOCA_IMPUT = "" """
"IMISSJ";"S";"0065";"DEF LOCA_MISS T6.2"
"IMISSJ";"S";"0066";"LOCA_MISS = 0"
"IMISSJ";"S";"0067";"DEF LOCA_DUREE T6.2"
"IMISSJ";"S";"0068";"LOCA_DUREE = 0"
"IMISSJ";"S";"0069";"DEF LOCA_PTMISS N1"
"IMISSJ";"S";"0070";"LOCA_PTMISS = 0"
"IMISSJ";"S";"0071";"DEF LOCA_DURDEJ T6.2"
"IMISSJ";"S";"0072";"LOCA_DURDEJ = 0"
"IMISSJ";"S";"0073";"DEF LOCA_DURDEJL T6.2"
"IMISSJ";"S";"0074";"LOCA_DURDEJL = 0"
"IMISSJ";"S";"0075";"DEF LOCA_SORTIE T6.2"
"IMISSJ";"S";"0076";"LOCA_SORTIE = 0"
"IMISSJ";"S";"0077";"DEF LOCA_RETMIS T6.2"
"IMISSJ";"S";"0078";"LOCA_RETMIS = 0"
"IMISSJ";"S";"0079";"DEF LOCA_MISSL T6.2"
"IMISSJ";"S";"0080";"LOCA_MISSL = 0"
"IMISSJ";"S";"0081";"SI HJOU_DATE <= TEMP_DATJOU"
"IMISSJ";"S";"0082";"   SI HJOU_INMISS <> ""0"""
"IMISSJ";"S";"0083";"      PLAGE ""DJ"""
"IMISSJ";"S";"0084";"      SI TEMP_TYPPLA <> "" """
"IMISSJ";"S";"0085";"         LOCA_DEJDEB = TEMP_VALTRT1"
"IMISSJ";"S";"0086";"         LOCA_DEJFIN = TEMP_VALTRT2"
"IMISSJ";"S";"0087";"      FINSI"
"IMISSJ";"S";"0088";"      POUR POINTAGES"
"IMISSJ";"S";"0089";"* Recuperation de l'heure de badgeage"
"IMISSJ";"S";"0090";"* si c'est un mouvement de sortie mission"
"IMISSJ";"S";"0091";"         SI POIN_SENS = ""1"""
"IMISSJ";"S";"0092";"            SI POIN_IMPUT = ""MISS"""
"IMISSJ";"S";"0093";"               LOCA_PTMISS = 1"
"IMISSJ";"S";"0094";"               LOCA_IMPUT = POIN_IMPUT"
"IMISSJ";"S";"0095";"               LOCA_SORTIE = POIN_HRETRAI"
"IMISSJ";"S";"0096";"               HJOU_IJRF2PRBHS = ""1"""
"IMISSJ";"S";"0097";"               LOCA_TEST = 0"
"IMISSJ";"S";"0098";"** test si on a un depart mission"
"IMISSJ";"S";"0099";"**  < badgeage theorique sortie 1"
"IMISSJ";"S";"0100";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0101";"** absent matin"
"IMISSJ";"S";"0102";"               SI PROF_PTTHEO1 > 0"
"IMISSJ";"S";"0103";"                  SI PROF_PTTHEO1 <= 36.00"
"IMISSJ";"S";"0104";"                     SI LOCA_SORTIE < PROF_PTTHEO2"
"IMISSJ";"S";"0105";"                        LOCA_PRESM = 1"
"IMISSJ";"S";"0106";"                     FINSI"
"IMISSJ";"S";"0107";"                  FINSI"
"IMISSJ";"S";"0108";"               FINSI"
"IMISSJ";"S";"0109";"** test si on a un depart mission"
"IMISSJ";"S";"0110";"**  < badgeage theorique sortie 1"
"IMISSJ";"S";"0111";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0112";"** absent matin"
"IMISSJ";"S";"0113";"               SI PROF_PTTHEO3 > 0"
"IMISSJ";"S";"0114";"                  SI PROF_PTTHEO3 <= 36.00"
"IMISSJ";"S";"0115";"                     SI LOCA_SORTIE < PROF_PTTHEO4"
"IMISSJ";"S";"0116";"                        LOCA_PRESA = 1"
"IMISSJ";"S";"0117";"                     FINSI"
"IMISSJ";"S";"0118";"                  FINSI"
"IMISSJ";"S";"0119";"               FINSI"
"IMISSJ";"S";"0120";"            FINSI"
"IMISSJ";"S";"0121";"         FINSI"
"IMISSJ";"S";"0122";"         SI POIN_SENS = ""0"""
"IMISSJ";"S";"0123";"            LOCA_PTMISS = 0"
"IMISSJ";"S";"0124";"* si le badgeage en entree est un retour mission"
"IMISSJ";"S";"0125";"            SI LOCA_IMPUT = ""MISS"""
"IMISSJ";"S";"0126";"               LOCA_RETMIS = POIN_HRETRAI"
"IMISSJ";"S";"0127";"               LOCA_IMPUT = "" """
"IMISSJ";"S";"0128";"               HJOU_IJRF2PRBHS = ""0"""
"IMISSJ";"S";"0129";"               LOCA_TEST = 0"
"IMISSJ";"S";"0130";"** test si on a un retour mission"
"IMISSJ";"S";"0131";"**  > badgeage theorique entree 1"
"IMISSJ";"S";"0132";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0133";"** absent matin"
"IMISSJ";"S";"0134";"               SI LOCA_PRESM = 1"
"IMISSJ";"S";"0135";"                  SI LOCA_RETMIS > PROF_PTTHEO1"
"IMISSJ";"S";"0136";"                     HJOU_IJQPRESBA1 = 2"
"IMISSJ";"S";"0137";"                  FINSI"
"IMISSJ";"S";"0138";"               FINSI"
"IMISSJ";"S";"0139";"** test si on a un retour mission"
"IMISSJ";"S";"0140";"**  > badgeage theorique entree 2"
"IMISSJ";"S";"0141";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0142";"** absent apres-midi"
"IMISSJ";"S";"0143";"               SI LOCA_PRESA = 1"
"IMISSJ";"S";"0144";"                  SI LOCA_RETMIS > PROF_PTTHEO3"
"IMISSJ";"S";"0145";"                     HJOU_IJQPRESBA2 = 2"
"IMISSJ";"S";"0146";"                  FINSI"
"IMISSJ";"S";"0147";"               FINSI"
"IMISSJ";"S";"0148";"               FAIRE CALMISS"
"IMISSJ";"S";"0149";"            FINSI"
"IMISSJ";"S";"0150";"* si retour mission sans depart dans la m?me journe"
"IMISSJ";"S";"0151";"            SI LOCA_IMPUT = "" """
"IMISSJ";"S";"0152";"* calcul de la duree par rapport ? la borne de"
"IMISSJ";"S";"0153";"* debut du profil"
"IMISSJ";"S";"0154";"* Attention calcul systematique du temps mission"
"IMISSJ";"S";"0155";"* entre le premier mouv. et l'heure de debut missio"
"IMISSJ";"S";"0156";"* du profil, ce temps est stocké dans HJMISSBL"
"IMISSJ";"S";"0157";"* Ce compteur est utilisé pour calculé la mission sur"
"IMISSJ";"S";"0158";"* un depart fait la veille"
"IMISSJ";"S";"0159";"               SI LOCA_RETMIS = 0"
"IMISSJ";"S";"0160";"                  SI HJOU_INMISS = ""2"""
"IMISSJ";"S";"0161";"                  OU HJOU_INMISS = ""3"""
"IMISSJ";"S";"0162";"                     SI PROF_IPIVMISSDV > 0"
"IMISSJ";"S";"0163";"                        LOCA_RETMIS = POIN_HRETRAI"
"IMISSJ";"S";"0164";"                        SI HJOU_IJRF2PRBHS = ""1"""
"IMISSJ";"S";"0165";"                           SI PROF_PTTHEO1 > 0"
"IMISSJ";"S";"0166";"                              SI PROF_PTTHEO1 <= 36.00"
"IMISSJ";"S";"0167";"                                 SI LOCA_RETMIS > PROF_PTTHEO1"
"IMISSJ";"S";"0168";"                                    HJOU_IJQPRESBA1 = 2"
"IMISSJ";"S";"0169";"                                 FINSI"
"IMISSJ";"S";"0170";"                              FINSI"
"IMISSJ";"S";"0171";"                           FINSI"
"IMISSJ";"S";"0172";"** test si on a un retour mission"
"IMISSJ";"S";"0173";"**  > badgeage theorique entree 2"
"IMISSJ";"S";"0174";"** pour ne pas declencher l'anomalie"
"IMISSJ";"S";"0175";"** absent apres-midi"
"IMISSJ";"S";"0176";"                           SI PROF_PTTHEO3 > 0"
"IMISSJ";"S";"0177";"                              SI PROF_PTTHEO3 <= 36.00"
"IMISSJ";"S";"0178";"                                 SI LOCA_RETMIS > PROF_PTTHEO3"
"IMISSJ";"S";"0179";"                                    HJOU_IJQPRESBA2 = 2"
"IMISSJ";"S";"0180";"                                 FINSI"
"IMISSJ";"S";"0181";"                              FINSI"
"IMISSJ";"S";"0182";"                           FINSI"
"IMISSJ";"S";"0183";"                        FINSI"
"IMISSJ";"S";"0184";"                        HJOU_IJRF2PRBHS = ""0"""
"IMISSJ";"S";"0185";"                        LOCA_SORTIE = PROF_IPIVMISSDV"
"IMISSJ";"S";"0186";"                        LOCA_TEST = 1"
"IMISSJ";"S";"0187";"                        FAIRE CALMISS"
"IMISSJ";"S";"0188";"                     SINON"
"IMISSJ";"S";"0189";"                        HJOU_IJRF2PRBHS = ""0"""
"IMISSJ";"S";"0190";"                     FINSI"
"IMISSJ";"S";"0191";"                  FINSI"
"IMISSJ";"S";"0192";"               FINSI"
"IMISSJ";"S";"0193";"            FINSI"
"IMISSJ";"S";"0194";"         FINSI"
"IMISSJ";"S";"0195";"      FINPOUR"
"IMISSJ";"S";"0196";"* depart mission sans retour dans la meme journne"
"IMISSJ";"S";"0197";"      SI LOCA_IMPUT = ""MISS"""
"IMISSJ";"S";"0198";"         SI LOCA_PTMISS = 1"
"IMISSJ";"S";"0199";"            SI LOCA_SORTIE <= LOCA_DEJDEB"
"IMISSJ";"S";"0200";"               LOCA_DURDEJ = PROF_IPIGPAMMIS"
"IMISSJ";"S";"0201";"               HJOU_IJQFMISPDJ = 1"
"IMISSJ";"S";"0202";"* ce compteur est utilis? dans la regle REPAS"
"IMISSJ";"S";"0203";"* pour ne pas decompter de pause d?jeuner sur"
"IMISSJ";"S";"0204";"* un depart mission fait avant la borne de debut"
"IMISSJ";"S";"0205";"* dejeuner et sans retour dans la journee"
"IMISSJ";"S";"0206";"            FINSI"
"IMISSJ";"S";"0207";"* complement par rapport ? la borne de fin mission du"
"IMISSJ";"S";"0208";"* profil"
"IMISSJ";"S";"0209";"            SI PROF_IPIGMISSTH <> ""1"""
"IMISSJ";"S";"0210";"               SI PROF_IPIVHFISRM > 0"
"IMISSJ";"S";"0211";"                  SI LOCA_SORTIE < PROF_IPIVHFISRM"
"IMISSJ";"S";"0212";"*ecretage si depart mission < borne debut mission"
"IMISSJ";"S";"0213";"* autorisee"
"IMISSJ";"S";"0214";"                     SI LOCA_SORTIE < PROF_IPIHDPRBHS"
"IMISSJ";"S";"0215";"                        LOCA_INF = LOCA_SORTIE"
"IMISSJ";"S";"0216";"                        LOCA_SUP = PROF_IPIHDPRBHS"
"IMISSJ";"S";"0217";"* calcul de la valeur ecretee"
"IMISSJ";"S";"0218";"                        SI LOCA_SUP > LOCA_INF"
"IMISSJ";"S";"0219";"                           LOCA_DIF = LOCA_SUP - LOCA_INF"
"IMISSJ";"S";"0220";"                        FINSI"
"IMISSJ";"S";"0221";"                        LOCA_SORTIE = PROF_IPIHDPRBHS"
"IMISSJ";"S";"0222";"                     FINSI"
"IMISSJ";"S";"0223";"* calcul de la duree mission"
"IMISSJ";"S";"0224";"                     LOCA_DUREE = PROF_IPIVHFISRM - LOCA_SORTIE"
"IMISSJ";"S";"0225";"                     LOCA_MISS = LOCA_MISS + LOCA_DUREE"
"IMISSJ";"S";"0226";"                  FINSI"
"IMISSJ";"S";"0227";"               FINSI"
"IMISSJ";"S";"0228";"            FINSI"
"IMISSJ";"S";"0229";"* complement par rapport ? la theorie"
"IMISSJ";"S";"0230";"            SI PROF_IPIGMISSTH = ""1"""
"IMISSJ";"S";"0231";"               LOCA_MISS = 0"
"IMISSJ";"S";"0232";"               LOCA_DURDEJ = 0"
"IMISSJ";"S";"0233";"* initialisation du compteur INMISSBA"
"IMISSJ";"S";"0234";"* pour calculer le complement dans la regle"
"IMISSJ";"S";"0235";"* MOTMISS par rapport aux autres motifs"
"IMISSJ";"S";"0236";"               HJOU_IJQFMISBAD = 1"
"IMISSJ";"S";"0237";"            FINSI"
"IMISSJ";"S";"0238";"         FINSI"
"IMISSJ";"S";"0239";"         SI HJOU_INMISS = ""1"""
"IMISSJ";"S";"0240";"            HJOU_IJRF2PRBHS = ""0"""
"IMISSJ";"S";"0241";"         FINSI"
"IMISSJ";"S";"0242";"      FINSI"
"IMISSJ";"S";"0243";"      LOCA_MISS = LOCA_MISS - LOCA_DURDEJ"
"IMISSJ";"S";"0244";"      SI LOCA_MISS > 0"
"IMISSJ";"S";"0245";"         SI LOCA_TEST = 0"
"IMISSJ";"S";"0246";"            HJOU_IJQMISBADG = LOCA_MISS"
"IMISSJ";"S";"0247";"         FINSI"
"IMISSJ";"S";"0248";"      FINSI"
"IMISSJ";"S";"0249";"      SI LOCA_MISSL > 0"
"IMISSJ";"S";"0250";"         HJOU_IJQMISSRET = LOCA_MISSL"
"IMISSJ";"S";"0251";"      FINSI"
"IMISSJ";"S";"0252";"   FINSI"
"IMISSJ";"S";"0253";"FINSI"
"IMISSJ";"S";"0254";"FIN"
"IMISSJ";"S";"0255";"***********************************************************"
"IMISSJ";"S";"0256";"*** Procedure CALMISS"
"IMISSJ";"S";"0257";"***********************************************************"
"IMISSJ";"S";"0258";"PROC CALMISS"
"IMISSJ";"S";"0259";"* retour mission apres l'heure autorisee"
"IMISSJ";"S";"0260";"   SI LOCA_RETMIS > PROF_IPIHFPRBHS"
"IMISSJ";"S";"0261";"      LOCA_INF = PROF_IPIHFPRBHS"
"IMISSJ";"S";"0262";"      SI LOCA_SORTIE > PROF_IPIHFPRBHS"
"IMISSJ";"S";"0263";"         LOCA_INF = LOCA_SORTIE"
"IMISSJ";"S";"0264";"      FINSI"
"IMISSJ";"S";"0265";"      LOCA_SUP = LOCA_RETMIS"
"IMISSJ";"S";"0266";"      LOCA_DIF = 0"
"IMISSJ";"S";"0267";"      SI LOCA_SUP > LOCA_INF"
"IMISSJ";"S";"0268";"         LOCA_DIF = LOCA_SUP - LOCA_INF"
"IMISSJ";"S";"0269";"      FINSI"
"IMISSJ";"S";"0270";"      LOCA_RETMIS = PROF_IPIHFPRBHS"
"IMISSJ";"S";"0271";"   FINSI"
"IMISSJ";"S";"0272";"* depart mission avant l'heure autorisee"
"IMISSJ";"S";"0273";"   SI LOCA_SORTIE < PROF_IPIHDPRBHS"
"IMISSJ";"S";"0274";"      LOCA_INF = LOCA_SORTIE"
"IMISSJ";"S";"0275";"      LOCA_SUP = PROF_IPIHDPRBHS"
"IMISSJ";"S";"0276";"      SI LOCA_RETMIS < PROF_IPIHDPRBHS"
"IMISSJ";"S";"0277";"         LOCA_SUP = LOCA_RETMIS"
"IMISSJ";"S";"0278";"      FINSI"
"IMISSJ";"S";"0279";"      SI LOCA_SUP > LOCA_INF"
"IMISSJ";"S";"0280";"         LOCA_DIF = LOCA_SUP - LOCA_INF"
"IMISSJ";"S";"0281";"      FINSI"
"IMISSJ";"S";"0282";"      LOCA_SORTIE = PROF_IPIHDPRBHS"
"IMISSJ";"S";"0283";"   FINSI"
"IMISSJ";"S";"0284";"** 02/07/2013 anomalie dans le cas ou le depart et le retour"
"IMISSJ";"S";"0285";"** sont faits apres l'heure de fin mission autorisée"
"IMISSJ";"S";"0286";"   SI LOCA_SORTIE > PROF_IPIHFPRBHS"
"IMISSJ";"S";"0287";"      ANOMALIE 181"
"IMISSJ";"S";"0288";"   FINSI"
"IMISSJ";"S";"0289";"*"
"IMISSJ";"S";"0290";"*"
"IMISSJ";"S";"0291";"   LOCA_DUREE = 0"
"IMISSJ";"S";"0292";"   SI LOCA_RETMIS > LOCA_SORTIE"
"IMISSJ";"S";"0293";"      LOCA_DUREE = LOCA_RETMIS - LOCA_SORTIE"
"IMISSJ";"S";"0294";"   FINSI"
"IMISSJ";"S";"0295";"   SI LOCA_RETMIS < LOCA_DEJFIN"
"IMISSJ";"S";"0296";"      SI LOCA_RETMIS > LOCA_DEJDEB"
"IMISSJ";"S";"0297";"         TEMP_RETOUR = LOCA_RETMIS"
"IMISSJ";"S";"0298";"         SI LOCA_TEST = 0"
"IMISSJ";"S";"0299";"            TEMP_TEMISS = ""2"""
"IMISSJ";"S";"0300";"         FINSI"
"IMISSJ";"S";"0301";"      FINSI"
"IMISSJ";"S";"0302";"   FINSI"
"IMISSJ";"S";"0303";"* le repas est decompte de la mission dans le cas"
"IMISSJ";"S";"0304";"* ou le depart est fait avant la borne debut dejeuner"
"IMISSJ";"S";"0305";"* et le retour apres la borne fin dejeuner"
"IMISSJ";"S";"0306";"   SI LOCA_RETMIS >= LOCA_DEJFIN"
"IMISSJ";"S";"0307";"      SI LOCA_SORTIE <= LOCA_DEJDEB"
"IMISSJ";"S";"0308";"         SI LOCA_TEST = 0"
"IMISSJ";"S";"0309";"            LOCA_DURDEJ = PROF_IPIGPAMMIS"
"IMISSJ";"S";"0310";"         SINON"
"IMISSJ";"S";"0311";"            LOCA_DURDEJL = PROF_IPIGPAMMIS"
"IMISSJ";"S";"0312";"         FINSI"
"IMISSJ";"S";"0313";"         HJOU_IJQFMISPDJ = 1"
"IMISSJ";"S";"0314";"* ce compteur est utilisé dans la regle REPAS"
"IMISSJ";"S";"0315";"* pour ne pas decompter de pause déjeuner sur"
"IMISSJ";"S";"0316";"* La presence badgee puisqu'elle est decomptee de la mission"
"IMISSJ";"S";"0317";"      FINSI"
"IMISSJ";"S";"0318";"   FINSI"
"IMISSJ";"S";"0319";"   SI LOCA_TEST = 0"
"IMISSJ";"S";"0320";"      LOCA_MISS = LOCA_MISS + LOCA_DUREE"
"IMISSJ";"S";"0321";"   SINON"
"IMISSJ";"S";"0322";"      LOCA_MISSL = LOCA_DUREE"
"IMISSJ";"S";"0323";"      LOCA_MISSL = LOCA_MISSL - LOCA_DURDEJL"
"IMISSJ";"S";"0324";"   FINSI"
"IMISSJ";"S";"0325";"FINPROC"
