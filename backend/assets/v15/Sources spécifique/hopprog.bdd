"IABSGAEV";"S";"0064";"LOCA_MOT10 = "" """
"IABSGAEV";"S";"0065";"* Valorisations"
"IABSGAEV";"S";"0066";"DEF LOCA_VALO1 A1"
"IABSGAEV";"S";"0067";"LOCA_VALO1 = "" """
"IABSGAEV";"S";"0068";"DEF LOCA_VALO2 A1"
"IABSGAEV";"S";"0069";"LOCA_VALO2 = "" """
"IABSGAEV";"S";"0070";"DEF LOCA_VALO3 A1"
"IABSGAEV";"S";"0071";"LOCA_VALO3 = "" """
"IABSGAEV";"S";"0072";"DEF LOCA_VALO4 A1"
"IABSGAEV";"S";"0073";"LOCA_VALO4 = "" """
"IABSGAEV";"S";"0074";"DEF LOCA_VALO5 A1"
"IABSGAEV";"S";"0075";"LOCA_VALO5 = "" """
"IABSGAEV";"S";"0076";"DEF LOCA_VALO6 A1"
"IABSGAEV";"S";"0077";"LOCA_VALO6 = "" """
"IABSGAEV";"S";"0078";"DEF LOCA_VALO7 A1"
"IABSGAEV";"S";"0079";"LOCA_VALO7 = "" """
"IABSGAEV";"S";"0080";"DEF LOCA_VALO8 A1"
"IABSGAEV";"S";"0081";"LOCA_VALO8 = "" """
"IABSGAEV";"S";"0082";"DEF LOCA_VALO9 A1"
"IABSGAEV";"S";"0083";"LOCA_VALO9 = "" """
"IABSGAEV";"S";"0084";"DEF LOCA_VALO10 A1"
"IABSGAEV";"S";"0085";"LOCA_VALO10 = "" """
"IABSGAEV";"S";"0086";"*"
"IABSGAEV";"S";"0087";"* Employé géré en activité"
"IABSGAEV";"S";"0088";"SI HJOU_IJIACTI <> "" """
"IABSGAEV";"S";"0089";"    SI HJOU_IJIACTI <> ""0"""
"IABSGAEV";"S";"0090";"        * Si motif alimenté par l'activité,"
"IABSGAEV";"S";"0091";"        * on enlève pour le recréer"
"IABSGAEV";"S";"0092";"        * si il y a un évènement ABSD ou ABSH"
"IABSGAEV";"S";"0093";"        POUR ACTIVITES"
"IABSGAEV";"S";"0094";"            SI MOTI_IMIALIGA = ""1"""
"IABSGAEV";"S";"0095";"                * Un motif"
"IABSGAEV";"S";"0096";"                SI LOCA_MOT1 = "" """
"IABSGAEV";"S";"0097";"                    LOCA_MOT1 = HABS_MOTIF"
"IABSGAEV";"S";"0098";"                    LOCA_VALO1 = HABS_VALORIS"
"IABSGAEV";"S";"0099";"                SINON"
"IABSGAEV";"S";"0100";"                    * Deux motifs"
"IABSGAEV";"S";"0101";"                    SI LOCA_MOT2 = "" """
"IABSGAEV";"S";"0102";"                        LOCA_MOT2 = HABS_MOTIF"
"IABSGAEV";"S";"0103";"                        LOCA_VALO2 = HABS_VALORIS"
"IABSGAEV";"S";"0104";"                    SINON"
"IABSGAEV";"S";"0105";"                        * Trois motifs"
"IABSGAEV";"S";"0106";"                        SI LOCA_MOT3 = "" """
"IABSGAEV";"S";"0107";"                            LOCA_MOT3 = HABS_MOTIF"
"IABSGAEV";"S";"0108";"                            LOCA_VALO3 = HABS_VALORIS"
"IABSGAEV";"S";"0109";"                        SINON"
"IABSGAEV";"S";"0110";"                            * Quatre motifs"
"IABSGAEV";"S";"0111";"                            SI LOCA_MOT4 = "" """
"IABSGAEV";"S";"0112";"                                LOCA_MOT4 = HABS_MOTIF"
"IABSGAEV";"S";"0113";"                                LOCA_VALO4 = HABS_VALORIS"
"IABSGAEV";"S";"0114";"                            SINON"
"IABSGAEV";"S";"0115";"                                * Cinq motifs"
"IABSGAEV";"S";"0116";"                                SI LOCA_MOT5 = "" """
"IABSGAEV";"S";"0117";"                                    LOCA_MOT5 = HABS_MOTIF"
"IABSGAEV";"S";"0118";"                                    LOCA_VALO5 = HABS_VALORIS"
"IABSGAEV";"S";"0119";"                                SINON"
"IABSGAEV";"S";"0120";"                                    LOCA_MOT = 1"
"IABSGAEV";"S";"0121";"                                FINSI"
"IABSGAEV";"S";"0122";"                            FINSI"
"IABSGAEV";"S";"0123";"                        FINSI"
"IABSGAEV";"S";"0124";"                    FINSI"
"IABSGAEV";"S";"0125";"                FINSI"
"IABSGAEV";"S";"0126";"                *"
"IABSGAEV";"S";"0127";"                SI LOCA_MOT = 1"
"IABSGAEV";"S";"0128";"                    * Six motifs"
"IABSGAEV";"S";"0129";"                    SI LOCA_MOT6 = "" """
"IABSGAEV";"S";"0130";"                        LOCA_MOT6 = HABS_MOTIF"
"IABSGAEV";"S";"0131";"                        LOCA_VALO6 = HABS_VALORIS"
"IABSGAEV";"S";"0132";"                    SINON"
"IABSGAEV";"S";"0133";"                        * Sept motifs"
"IABSGAEV";"S";"0134";"                        SI LOCA_MOT7 = "" """
"IABSGAEV";"S";"0135";"                            LOCA_MOT7 = HABS_MOTIF"
"IABSGAEV";"S";"0136";"                            LOCA_VALO7 = HABS_VALORIS"
"IABSGAEV";"S";"0137";"                        SINON"
"IABSGAEV";"S";"0138";"                            * Huit motifs"
"IABSGAEV";"S";"0139";"                            SI LOCA_MOT8 = "" """
"IABSGAEV";"S";"0140";"                                LOCA_MOT8 = HABS_MOTIF"
"IABSGAEV";"S";"0141";"                                LOCA_VALO8 = HABS_VALORIS"
"IABSGAEV";"S";"0142";"                            SINON"
"IABSGAEV";"S";"0143";"                                * Neuf motifs"
"IABSGAEV";"S";"0144";"                                SI LOCA_MOT9 = "" """
"IABSGAEV";"S";"0145";"                                    LOCA_MOT9 = HABS_MOTIF"
"IABSGAEV";"S";"0146";"                                    LOCA_VALO9 = HABS_VALORIS"
"IABSGAEV";"S";"0147";"                                SINON"
"IABSGAEV";"S";"0148";"                                    * Dix motifs"
"IABSGAEV";"S";"0149";"                                    SI LOCA_MOT10 = "" """
"IABSGAEV";"S";"0150";"                                        LOCA_MOT10 = HABS_MOTIF"
"IABSGAEV";"S";"0151";"                                        LOCA_VALO10 = HABS_VALORIS"
"IABSGAEV";"S";"0152";"                                    FINSI"
"IABSGAEV";"S";"0153";"                                FINSI"
"IABSGAEV";"S";"0154";"                            FINSI"
"IABSGAEV";"S";"0155";"                        FINSI"
"IABSGAEV";"S";"0156";"                    FINSI"
"IABSGAEV";"S";"0157";"                FINSI"
"IABSGAEV";"S";"0158";"            FINSI"
"IABSGAEV";"S";"0159";"        FINPOUR"
"IABSGAEV";"S";"0160";"        *"
"IABSGAEV";"S";"0161";"        SI LOCA_MOT1 <> "" """
"IABSGAEV";"S";"0162";"            ENLEVER LOCA_MOT1 LOCA_VALO1"
"IABSGAEV";"S";"0163";"        FINSI"
"IABSGAEV";"S";"0164";"        SI LOCA_MOT2 <> "" """
"IABSGAEV";"S";"0165";"            ENLEVER LOCA_MOT2 LOCA_VALO2"
"IABSGAEV";"S";"0166";"        FINSI"
"IABSGAEV";"S";"0167";"        SI LOCA_MOT3 <> "" """
"IABSGAEV";"S";"0168";"            ENLEVER LOCA_MOT3 LOCA_VALO3"
"IABSGAEV";"S";"0169";"        FINSI"
"IABSGAEV";"S";"0170";"        SI LOCA_MOT4 <> "" """
"IABSGAEV";"S";"0171";"            ENLEVER LOCA_MOT4 LOCA_VALO4"
"IABSGAEV";"S";"0172";"        FINSI"
"IABSGAEV";"S";"0173";"        SI LOCA_MOT5 <> "" """
"IABSGAEV";"S";"0174";"            ENLEVER LOCA_MOT5 LOCA_VALO5"
"IABSGAEV";"S";"0175";"        FINSI"
"IABSGAEV";"S";"0176";"        SI LOCA_MOT6 <> "" """
"IABSGAEV";"S";"0177";"            ENLEVER LOCA_MOT6 LOCA_VALO6"
"IABSGAEV";"S";"0178";"        FINSI"
"IABSGAEV";"S";"0179";"        SI LOCA_MOT7 <> "" """
"IABSGAEV";"S";"0180";"            ENLEVER LOCA_MOT7 LOCA_VALO7"
"IABSGAEV";"S";"0181";"        FINSI"
"IABSGAEV";"S";"0182";"        SI LOCA_MOT8 <> "" """
"IABSGAEV";"S";"0183";"            ENLEVER LOCA_MOT8 LOCA_VALO8"
"IABSGAEV";"S";"0184";"        FINSI"
"IABSGAEV";"S";"0185";"        SI LOCA_MOT9 <> "" """
"IABSGAEV";"S";"0186";"            ENLEVER LOCA_MOT9 LOCA_VALO9"
"IABSGAEV";"S";"0187";"        FINSI"
"IABSGAEV";"S";"0188";"        SI LOCA_MOT10 <> "" """
"IABSGAEV";"S";"0189";"            ENLEVER LOCA_MOT10 LOCA_VALO10"
"IABSGAEV";"S";"0190";"        FINSI"
"IABSGAEV";"S";"0191";"        *"
"IABSGAEV";"S";"0192";"        POUR EVENEMENTS"
"IABSGAEV";"S";"0193";"            * Absence déclarative"
"IABSGAEV";"S";"0194";"            SI EVEN_EVENEMENT = ""ABSD"""
"IABSGAEV";"S";"0195";"                AJOUTER EVEN_VALEUR01 EVEN_VALEUR02 EVEN_DUREE_EVE"
"IABSGAEV";"S";"0196";"            FINSI"
"IABSGAEV";"S";"0197";"            * Absence horodaté"
"IABSGAEV";"S";"0198";"            SI EVEN_EVENEMENT = ""ABSH"""
"IABSGAEV";"S";"0199";"                AJOUTER EVEN_VALEUR01 ""H"" EVEN_DUREE_EVE EVEN_HEURE_DEB EVEN_HEURE_FIN"
"IABSGAEV";"S";"0200";"            FINSI"
"IABSGAEV";"S";"0201";"        FINPOUR"
"IABSGAEV";"S";"0202";"    FINSI"
"IABSGAEV";"S";"0203";"FINSI"
"IABSGAEV";"S";"0204";"*"
"IABSGAEV";"S";"0205";"FIN"
"IABSPL";"S";"0001";"***********************************************************************"
"IABSPL";"S";"0002";"*"
"IABSPL";"S";"0003";"* Règle : IABSPL"
"IABSPL";"S";"0004";"* Ordre : 2070"
"IABSPL";"S";"0005";"* Titre : Absences plage obligatoire"
"IABSPL";"S";"0006";"*"
"IABSPL";"S";"0007";"*----------------------------------------------------------------------"
"IABSPL";"S";"0008";"*"
"IABSPL";"S";"0009";"* Créé par : Cellule Industrialisation"
"IABSPL";"S";"0010";"* Date     : 03/09/2009"
"IABSPL";"S";"0011";"* Version  : 1"
"IABSPL";"S";"0012";"*"
"IABSPL";"S";"0013";"*----------------------------------------------------------------------"
"IABSPL";"S";"0014";"*"
"IABSPL";"S";"0015";"*"
"IABSPL";"S";"0016";"* Rôle : Absences plage obligatoire"
"IABSPL";"S";"0017";"*"
"IABSPL";"S";"0018";"*"
"IABSPL";"S";"0019";"*"
"IABSPL";"S";"0020";"*"
"IABSPL";"S";"0021";"*----------------------------------------------------------------------"
"IABSPL";"S";"0022";"*"
"IABSPL";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"IABSPL";"S";"0024";"* Date         : JJ/MM/AAAA"
"IABSPL";"S";"0025";"* Objet        :"
"IABSPL";"S";"0026";"*"
"IABSPL";"S";"0027";"***********************************************************************"
"IABSPL";"S";"0028";"*"
"IABSPL";"S";"0029";"* Implémentation des données industrielles"
"IABSPL";"S";"0030";"*"
"IABSPL";"S";"0031";"DEBDICO"
"IABSPL";"S";"0032";"   HJOU_IJQABSPLF1;N;T6,2;I;;;    56789;;;V2;""Absence 1ère plage"";"
"IABSPL";"S";"0033";"   *   HJOU_IJQNABSPFI;N;N2;I;;;     6789;;;V2;""Nombre de retards jour"";"
"IABSPL";"S";"0034";"   HJOU_IJQABSPLF2;N;T6,2;I;;;    56789;;;V2;""Absence 2ème plage"";"
"IABSPL";"S";"0035";"   HJOU_IJQABSPLFT;N;T6,2;I;;;    56789;;;V2;""Absence plages fixes jour"";"
"IABSPL";"S";"0036";"FINDICO"
"IABSPL";"S";"0037";"*"
"IABSPL";"S";"0038";"*"
"IABSPL";"S";"0039";"* Déclaration des donnees locales"
"IABSPL";"S";"0040";"*"
"IABSPL";"S";"0041";"DEF LOCA_RET T6.2"
"IABSPL";"S";"0042";"LOCA_RET = 0"
"IABSPL";"S";"0043";"*"
"IABSPL";"S";"0044";"* Absences premiere plage"
"IABSPL";"S";"0045";"*"
"IABSPL";"S";"0046";"SI HJOU_DATE <= TEMP_DATJOU"
"IABSPL";"S";"0047";"   SI PROF_IPIGABSPLF <> ""0"""
"IABSPL";"S";"0048";"      SI PROF_PTTHEO1 > 0"
"IABSPL";"S";"0049";"         ANALYSE PROF_PTTHEO1 PROF_PTTHEO2"
"IABSPL";"S";"0050";"         SI TEMP_HIPOIN > 0"
"IABSPL";"S";"0051";"            SI PROF_IPIGABSPLF = ""1"""
"IABSPL";"S";"0052";"               SI TEMP_HIABS > PROF_IPISABSPLF"
"IABSPL";"S";"0053";"                  HJOU_IJQABSPLF1 = TEMP_HIABS"
"IABSPL";"S";"0054";"               FINSI"
"IABSPL";"S";"0055";"            FINSI"
"IABSPL";"S";"0056";"            SI PROF_IPIGABSPLF = ""2"""
"IABSPL";"S";"0057";"               SI TEMP_HIPOIN > 0"
"IABSPL";"S";"0058";"                  SI TEMP_HISENS = 0"
"IABSPL";"S";"0059";"                     LOCA_RET = TEMP_HIPTPR - PROF_PTTHEO1"
"IABSPL";"S";"0060";"                     SI LOCA_RET > PROF_IPISABSPLF"
"IABSPL";"S";"0061";"                        HJOU_IJQABSPLF1 = LOCA_RET"
"IABSPL";"S";"0062";"*                        HJOU_IJQNABSPFI = HJOU_IJQNABSPFI + 1"
"IABSPL";"S";"0063";"                     FINSI"
"IABSPL";"S";"0064";"                  FINSI"
"IABSPL";"S";"0065";"               FINSI"
"IABSPL";"S";"0066";"            FINSI"
"IABSPL";"S";"0067";"         FINSI"
"IABSPL";"S";"0068";"      FINSI"
"IABSPL";"S";"0069";"*"
"IABSPL";"S";"0070";"* Absence seconde plage"
"IABSPL";"S";"0071";"*"
"IABSPL";"S";"0072";"      SI PROF_PTTHEO3 > 0"
"IABSPL";"S";"0073";"         ANALYSE PROF_PTTHEO3 PROF_PTTHEO4"
"IABSPL";"S";"0074";"         SI TEMP_HIPOIN > 0"
"IABSPL";"S";"0075";"            SI PROF_IPIGABSPLF = ""1"""
"IABSPL";"S";"0076";"               SI TEMP_HIABS > PROF_IPISABSPLF"
"IABSPL";"S";"0077";"                  HJOU_IJQABSPLF2 = HJOU_IJQABSPLF2 + TEMP_HIABS"
"IABSPL";"S";"0078";"               FINSI"
"IABSPL";"S";"0079";"            FINSI"
"IABSPL";"S";"0080";"            SI PROF_IPIGABSPLF = ""2"""
"IABSPL";"S";"0081";"               SI TEMP_HIPOIN > 0"
"IABSPL";"S";"0082";"                  SI TEMP_HISENS = 0"
"IABSPL";"S";"0083";"                     LOCA_RET = TEMP_HIPTPR - PROF_PTTHEO3"
"IABSPL";"S";"0084";"                     SI LOCA_RET > PROF_IPISABSPLF"
"IABSPL";"S";"0085";"                        HJOU_IJQABSPLF2 = HJOU_IJQABSPLF2 + LOCA_RET"
"IABSPL";"S";"0086";"*                        HJOU_IJQNABSPFI = HJOU_IJQNABSPFI + 1"
"IABSPL";"S";"0087";"                     FINSI"
"IABSPL";"S";"0088";"                  FINSI"
"IABSPL";"S";"0089";"               FINSI"
"IABSPL";"S";"0090";"            FINSI"
"IABSPL";"S";"0091";"         FINSI"
"IABSPL";"S";"0092";"      FINSI"
"IABSPL";"S";"0093";"   FINSI"
"IABSPL";"S";"0094";"** totalisation"
"IABSPL";"S";"0095";"   HJOU_IJQABSPLFT = HJOU_IJQABSPLF1 + HJOU_IJQABSPLF2"
"IABSPL";"S";"0096";"FINSI"
"IABSPL";"S";"0097";"FIN"
"IACQCP";"S";"0001";"***********************************************************************"
