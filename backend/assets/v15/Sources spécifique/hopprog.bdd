"ITPSACTHT8";"S";"0030";"***********************************************************************"
"ITPSACTHT8";"S";"0031";"*"
"ITPSACTHT8";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTHT8";"S";"0033";"*"
"ITPSACTHT8";"S";"0034";"DEBDICO"
"ITPSACTHT8";"S";"0035";"EMPL_IEIACTI;O;A1;X;;;123456789;L;;C3;""Employé géré en activité"";"
"ITPSACTHT8";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTHT8";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTHT8";"S";"0038";"FINDICO"
"ITPSACTHT8";"S";"0039";"*"
"ITPSACTHT8";"S";"0040";"*"
"ITPSACTHT8";"S";"0041";"* DEBANO"
"ITPSACTHT8";"S";"0042";"*"
"ITPSACTHT8";"S";"0043";"* FINANO"
"ITPSACTHT8";"S";"0044";"*"
"ITPSACTHT8";"S";"0045";"* Définition des variables locales"
"ITPSACTHT8";"S";"0046";"*"
"ITPSACTHT8";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTHT8";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTHT8";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHT8";"S";"0050";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTHT8";"S";"0051";"    FINSI"
"ITPSACTHT8";"S";"0052";"FINSI"
"ITPSACTHT8";"S";"0053";"* Employé géré en activité"
"ITPSACTHT8";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTHT8";"S";"0055";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHT8";"S";"0056";"        * Calcul de la présence activité le dernier jour du mois"
"ITPSACTHT8";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTHT8";"S";"0058";"        SI TEMP_DATSUI(7:2) = ""01"""
"ITPSACTHT8";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTHT8";"S";"0060";"            * Calcul de la présence activité"
"ITPSACTHT8";"S";"0061";"            SI PRES_VALID <> ""O"""
"ITPSACTHT8";"S";"0062";"                PRES_VALID = ""N"""
"ITPSACTHT8";"S";"0063";"                * d'activité à justifier"
"ITPSACTHT8";"S";"0064";"                PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTHT8";"S";"0065";"                PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTHT8";"S";"0066";"                *"
"ITPSACTHT8";"S";"0067";"                SI PRES_MODE_TRV = "" """
"ITPSACTHT8";"S";"0068";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT8";"S";"0069";"                FINSI"
"ITPSACTHT8";"S";"0070";"                *"
"ITPSACTHT8";"S";"0071";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT8";"S";"0072";"                *"
"ITPSACTHT8";"S";"0073";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHT8";"S";"0074";"                *                              (A décommenter si besoin)"
"ITPSACTHT8";"S";"0075";"                *"
"ITPSACTHT8";"S";"0076";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHT8";"S";"0077";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHT8";"S";"0078";"                * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHT8";"S";"0079";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHT8";"S";"0080";"                *"
"ITPSACTHT8";"S";"0081";"                * SI HJOU_IJRTTREFFM <> 0"
"ITPSACTHT8";"S";"0082";"                    PRES_TPS_PRES = HJOU_IJRTTREFFM"
"ITPSACTHT8";"S";"0083";"                * SINON"
"ITPSACTHT8";"S";"0084";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTHT8";"S";"0085";"                * FINSI"
"ITPSACTHT8";"S";"0086";"                * ----------------------------------------------------------------------------------"
"ITPSACTHT8";"S";"0087";"                *"
"ITPSACTHT8";"S";"0088";"                PRES_TPS_IMPUTE = 0"
"ITPSACTHT8";"S";"0089";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTHT8";"S";"0090";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTHT8";"S";"0091";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHT8";"S";"0092";"                    POUR EVENEMENTS"
"ITPSACTHT8";"S";"0093";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHT8";"S";"0094";"                    FINPOUR"
"ITPSACTHT8";"S";"0095";"                FINSI"
"ITPSACTHT8";"S";"0096";"                * Calcul de l'écart"
"ITPSACTHT8";"S";"0097";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHT8";"S";"0098";"            FINSI"
"ITPSACTHT8";"S";"0099";"        FINSI"
"ITPSACTHT8";"S";"0100";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHT8";"S";"0101";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHT8";"S";"0102";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHT8";"S";"0103";"        FINSI"
"ITPSACTHT8";"S";"0104";"    FINSI"
"ITPSACTHT8";"S";"0105";"FINSI"
"ITPSACTHT8";"S";"0106";"*"
"ITPSACTHT8";"S";"0107";"FIN"
