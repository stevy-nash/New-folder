"SCONTR";"S";"0179";"SI EMPS_E2DATENAI = "" """
"SCONTR";"S";"0180";"OU LOCA_AGE >= 18"
"SCONTR";"S";"0181";"   SI HJOU_IJQDEBADGV > 0"
"SCONTR";"S";"0182";"      SI HJOU_IJQPRBADGV > 0"
"SCONTR";"S";"0183";"         LOCA_REPOS = HJOU_IJQPRBADGV + 24.00"
"SCONTR";"S";"0184";"         LOCA_REPOS = LOCA_REPOS - HJOU_IJRSDBADGV"
