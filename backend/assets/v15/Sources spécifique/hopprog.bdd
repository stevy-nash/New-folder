"SGTTFJ";"S";"0123";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"SGTTFJ";"S";"0124";"*"
"SGTTFJ";"S";"0125";"   SI CONF_IGIREFRTT <> "" """
"SGTTFJ";"S";"0126";"      LOCA_REF << CONF_IGIREFRTT(1:2)"
"SGTTFJ";"S";"0127";"      LOCA_DATE(7:2) << LOCA_REF"
