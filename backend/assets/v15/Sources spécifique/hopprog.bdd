"IGRTTJ";"S";"0259";"            LOCA_DROIT = HABS_MOTINBR + HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0260";"            LOCA_TRANS = LOCA_DROIT - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0261";"* alimentation du compteur de droit"
"IGRTTJ";"S";"0262";"            HJOU_IJRARTTJOU = LOCA_ENTIER"
"IGRTTJ";"S";"0263";"*"
"IGRTTJ";"S";"0264";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
"IGRTTJ";"S";"0265";"         FINSI"
"IGRTTJ";"S";"0266";"      FINSI"
"IGRTTJ";"S";"0267";"**"
"IGRTTJ";"S";"0268";"      SI HJOU_IJIGRETETR = ""2"""
"IGRTTJ";"S";"0269";"         LOCA_MOT = 1"
"IGRTTJ";"S";"0270";"         SI HABS_MOTIF = ""ZRTJ"""
"IGRTTJ";"S";"0271";"            LOCA_TRANS = HABS_MOTINBR - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0272";"*"
"IGRTTJ";"S";"0273";"            HJOU_IJRARTTJOU = HABS_MOTINBR"
"IGRTTJ";"S";"0274";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
"IGRTTJ";"S";"0275";"         FINSI"
"IGRTTJ";"S";"0276";"         SI HABS_MOTIF = ""XRTJ"""
"IGRTTJ";"S";"0277";"            LOCA_MOT = 1"
"IGRTTJ";"S";"0278";"            LOCA_DROIT = HABS_MOTINBR + HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0279";"            LOCA_TRANS = LOCA_DROIT - HJOU_IJRARTTJOU"
"IGRTTJ";"S";"0280";"*"
"IGRTTJ";"S";"0281";"            HJOU_IJRARTTJOU = HJOU_IJRARTTJOU + HABS_MOTINBR"
"IGRTTJ";"S";"0282";"            HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT + LOCA_TRANS"
