"STICKE";"S";"0024";"*"
"STICKE";"S";"0025";"***********************************************************************"
"STICKE";"S";"0026";"*"
"STICKE";"S";"0027";"* Implémentation des données industrielles"
"STICKE";"S";"0028";"*"
"STICKE";"S";"0029";"DEBDICO"
"STICKE";"S";"0030";"   HJOU_IJQNTICKRE;N;N2;I;;;    56789;;;V3;""Ticket restaurant"";"
"STICKE";"S";"0031";"   HJOU_SJRNTICKRE;N;N2;I;;;    56789;;SJRNTICKRE;V3;""Nbres Ticket restaurant mois"";"
"STICKE";"S";"0032";"   HJOU_SJRNNDF;N;N4;I;;;    56789;;SJRNNDF;V3;""Nbres de NDF reporté"";"
"STICKE";"S";"0033";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"STICKE";"S";"0034";"   HJOU_SJIREFTR;O;Z1;X;;;      789;L9;;C2;""Refus de ticket restaurant"";"
"STICKE";"S";"0035";"FINDICO"
"STICKE";"S";"0036";"*"
"STICKE";"S";"0037";"* Déclaration des donnees locales"
"STICKE";"S";"0038";"*"
"STICKE";"S";"0039";"DEF LOCA_DROIT N2"
"STICKE";"S";"0040";"LOCA_DROIT = 0"
"STICKE";"S";"0041";"*"
"STICKE";"S";"0042";"DEF LOCA_TR N2"
"STICKE";"S";"0043";"LOCA_TR = 0"
"STICKE";"S";"0044";"*"
"STICKE";"S";"0045";"DEF LOCA_DURVAC1 T6.2"
"STICKE";"S";"0046";"LOCA_DURVAC1 = 0"
"STICKE";"S";"0047";"DEF LOCA_DURVAC2 T6.2"
"STICKE";"S";"0048";"LOCA_DURVAC2 = 0"
"STICKE";"S";"0049";"DEF LOCA_NBPLAGE N2"
"STICKE";"S";"0050";"LOCA_NBPLAGE = 0"
"STICKE";"S";"0051";"*"
"STICKE";"S";"0052";"DEF LOCA_DEBMIDI T6.2"
"STICKE";"S";"0053";"LOCA_DEBMIDI = 12.00"
"STICKE";"S";"0054";"DEF LOCA_FINMIDI T6.2"
"STICKE";"S";"0055";"LOCA_FINMIDI = 14.00"
"STICKE";"S";"0056";"DEF LOCA_VALO A2"
"STICKE";"S";"0057";"LOCA_VALO = "" """
"STICKE";"S";"0058";"DEF LOCA_JF N2"
"STICKE";"S";"0059";"LOCA_JF = 0"
"STICKE";"S";"0060";"*"
"STICKE";"S";"0061";"DEF LOCA_NDF N4"
"STICKE";"S";"0062";"LOCA_NDF = 0"
"STICKE";"S";"0063";"DEF LOCA_NTRMOIS N6.2"
"STICKE";"S";"0064";"LOCA_NTRMOIS = 0"
"STICKE";"S";"0065";"*"
"STICKE";"S";"0066";"DEF LOCA_SEUIL T6.2"
"STICKE";"S";"0067";"LOCA_SEUIL = 5.30"
"STICKE";"S";"0068";"DEF LOCA_ANCJ N6"
"STICKE";"S";"0069";"LOCA_ANCJ = 0"
"STICKE";"S";"0070";"*"
"STICKE";"S";"0071";"ENLEVER ""TRPAIE"""
"STICKE";"S";"0072";"ENLEVER ""TRPAIE"""
"STICKE";"S";"0073";"ENLEVER ""TRPAIE"""
"STICKE";"S";"0074";"ENLEVER ""TRPAIE"""
"STICKE";"S";"0075";"ENLEVER ""TRPAIECDD"""
"STICKE";"S";"0076";"ENLEVER ""TRPAIECDD"""
"STICKE";"S";"0077";"ENLEVER ""TRPAIECDD"""
"STICKE";"S";"0078";"ENLEVER ""TRPAIECDD"""
"STICKE";"S";"0079";"*"
"STICKE";"S";"0080";"POUR ACTIVITES"
"STICKE";"S";"0081";"   SI HABS_MOTIF = ""JF"""
"STICKE";"S";"0082";"      LOCA_JF = 1"
"STICKE";"S";"0083";"   FINSI"
"STICKE";"S";"0084";"FINPOUR"
"STICKE";"S";"0085";"*"
"STICKE";"S";"0086";"* Cacul de l'ancienneté"
"STICKE";"S";"0087";"SI EMPS_E2DATEANC <> "" """
"STICKE";"S";"0088";"   DATDIFF EMPS_E2DATEANC 12 HJOU_DATE 12"
"STICKE";"S";"0089";"   LOCA_ANCJ = TEMP_NXMOIS"
"STICKE";"S";"0090";"FINSI"
"STICKE";"S";"0091";"*"
"STICKE";"S";"0092";"SI LOCA_ANCJ >= 3"
"STICKE";"S";"0093";"* Refus du TR ?"
"STICKE";"S";"0094";"   SI HJOU_SJIREFTR <> ""1"""
"STICKE";"S";"0095";"* Différent Porteur TEVA ?"
"STICKE";"S";"0096";"      SI HJOU_SJIINTEVA <> ""1"""
"STICKE";"S";"0097";"         LOCA_DROIT = 1"
"STICKE";"S";"0098";"      FINSI"
"STICKE";"S";"0099";"   FINSI"
"STICKE";"S";"0100";"FINSI"
"STICKE";"S";"0101";"*"
"STICKE";"S";"0102";"* RAZ mensuel"
"STICKE";"S";"0103";"SI HJOU_DATE(7:2) = ""01"""
"STICKE";"S";"0104";"   HJOU_SJRNTICKRE = 0"
"STICKE";"S";"0105";"FINSI"
"STICKE";"S";"0106";"*"
"STICKE";"S";"0107";"* Si droit au TR"
"STICKE";"S";"0108";"SI LOCA_DROIT = 1"
"STICKE";"S";"0109";"* On traite les TR jusqu'à la fin du mois en cours"
"STICKE";"S";"0110";"   SI HJOU_DATE(1:6) <= TEMP_DATJOU(1:6)"
"STICKE";"S";"0111";"*"
"STICKE";"S";"0112";"***** Analyse de la présence >> ********************************************************************"
"STICKE";"S";"0113";"*"
"STICKE";"S";"0114";"* Vérification nombre de plage"
"STICKE";"S";"0115";"*"
"STICKE";"S";"0116";"      SI HJOU_IJQMVTENT1 < HJOU_IJQMVTSOR1"
"STICKE";"S";"0117";"         LOCA_DURVAC1 = HJOU_IJQMVTSOR1 - HJOU_IJQMVTENT1"
"STICKE";"S";"0118";"         LOCA_NBPLAGE = LOCA_NBPLAGE + 1"
"STICKE";"S";"0119";"      FINSI"
"STICKE";"S";"0120";"      SI HJOU_IJQMVTENT2 < HJOU_IJQMVTSOR2"
"STICKE";"S";"0121";"         LOCA_DURVAC2 = HJOU_IJQMVTSOR2 - HJOU_IJQMVTENT2"
"STICKE";"S";"0122";"         LOCA_NBPLAGE = LOCA_NBPLAGE + 1"
"STICKE";"S";"0123";"      FINSI"
"STICKE";"S";"0124";"*"
"STICKE";"S";"0125";"* Si au moins 2 plage"
"STICKE";"S";"0126";"      SI LOCA_NBPLAGE = 2"
"STICKE";"S";"0127";"         LOCA_TR = 1"
"STICKE";"S";"0128";"      SINON"
"STICKE";"S";"0129";"* On vérifie le temps de travail supérieur à seuil"
"STICKE";"S";"0130";"         SI HJOU_IJQTTEFFEJ >= LOCA_SEUIL"
"STICKE";"S";"0131";"            LOCA_TR = 1"
"STICKE";"S";"0132";"         FINSI"
"STICKE";"S";"0133";"      FINSI"
"STICKE";"S";"0134";"*"
"STICKE";"S";"0135";"* En cas de travail sur repos on regarde si couvre la plage déjeuner"
"STICKE";"S";"0136";"      SI HJOU_IJQPRETHEJ = 0"
"STICKE";"S";"0137";"* Analyse motif HS et inter astreinte"
"STICKE";"S";"0138";"         POUR ACTIVITES"
"STICKE";"S";"0139";"            SI HABS_MOTIF = PARD_SDIVMINTA"
"STICKE";"S";"0140";"            OU HABS_MOTIF = PARD_SDIVMHSUP"
"STICKE";"S";"0141";"            OU HABS_MOTIF = PARD_SDIVMHSUPR"
"STICKE";"S";"0142";"* Test 1"
"STICKE";"S";"0143";"               SI LOCA_TR <> 1"
"STICKE";"S";"0144";"                  SI HABS_HRADEB <= LOCA_DEBMIDI"
"STICKE";"S";"0145";"                     SI HABS_HRAFIN >= LOCA_FINMIDI"
"STICKE";"S";"0146";"                        LOCA_TR = 1"
"STICKE";"S";"0147";"                     FINSI"
"STICKE";"S";"0148";"                  FINSI"
"STICKE";"S";"0149";"               FINSI"
"STICKE";"S";"0150";"* Test 2"
"STICKE";"S";"0151";"               SI LOCA_TR <> 1"
"STICKE";"S";"0152";"                  SI HABS_HRADEB < LOCA_DEBMIDI"
"STICKE";"S";"0153";"                     SI LOCA_VALO(1:1) = "" """
"STICKE";"S";"0154";"                        LOCA_VALO(1:1) = ""M"""
"STICKE";"S";"0155";"                     FINSI"
"STICKE";"S";"0156";"                  FINSI"
"STICKE";"S";"0157";"                  SI HABS_HRAFIN > LOCA_FINMIDI"
"STICKE";"S";"0158";"                     SI LOCA_VALO(2:1) = "" """
"STICKE";"S";"0159";"                        LOCA_VALO(2:1) = ""A"""
"STICKE";"S";"0160";"                     FINSI"
"STICKE";"S";"0161";"                  FINSI"
"STICKE";"S";"0162";"                  SI LOCA_VALO = ""MA"""
"STICKE";"S";"0163";"                     LOCA_TR = 1"
"STICKE";"S";"0164";"                  FINSI"
"STICKE";"S";"0165";"*"
"STICKE";"S";"0166";"               FINSI"
"STICKE";"S";"0167";"FINSI"
"STICKE";"S";"0168";"*"
"STICKE";"S";"0169";"* 27/01/2026-Salim-FFT025007493-D 6N donne un TR"
"STICKE";"S";"0170";"            SI HJOU_DATE >= ""01/01/2026"""
"STICKE";"S";"0171";"               SI HJOU_IJQPRETHEJ = 0"
"STICKE";"S";"0172";"                  SI HABS_MOTIF = ""6N"""
"STICKE";"S";"0173";"                     LOCA_TR = 1"
"STICKE";"S";"0174";"                  FINSI"
"STICKE";"S";"0175";"               FINSI"
"STICKE";"S";"0176";"            FINSI"
"STICKE";"S";"0177";"* 27/01/2026-Salim-FFT025007493-F"
"STICKE";"S";"0178";"         FINPOUR"
"STICKE";"S";"0179";"      FINSI"
"STICKE";"S";"0180";"*"
"STICKE";"S";"0181";"***** Contrôle des absences ne maintenant pas le ticket restaurant >> ******************************"
"STICKE";"S";"0182";"*"
"STICKE";"S";"0183";"      POUR ACTIVITES"
"STICKE";"S";"0184";"         SI HABS_MOTYPE <> ""C"""
"STICKE";"S";"0185";"* Ne maintient pas ?"
"STICKE";"S";"0186";"            SI MOTI_IMIGTICKRE <> ""1"""
"STICKE";"S";"0187";"               LOCA_TR = 0"
"STICKE";"S";"0188";"            FINSI"
"STICKE";"S";"0189";"         FINSI"
"STICKE";"S";"0190";"*"
"STICKE";"S";"0191";"* Si délca de présence sur repos en demi-jour pas de TR"
"STICKE";"S";"0192";"         SI HJOU_IJQPRETHEJ = 0"
"STICKE";"S";"0193";"            SI HABS_MOTIF = PARD_SDIVPRES"
"STICKE";"S";"0194";"               SI HABS_VALORIS <> ""J"""
"STICKE";"S";"0195";"                  LOCA_TR = 0"
"STICKE";"S";"0196";"               FINSI"
"STICKE";"S";"0197";"            FINSI"
"STICKE";"S";"0198";"         FINSI"
"STICKE";"S";"0199";"*"
"STICKE";"S";"0200";"      FINPOUR"
"STICKE";"S";"0201";"*"
"STICKE";"S";"0202";"* Si férié et déclaration de présence"
"STICKE";"S";"0203";"      SI LOCA_JF = 1"
"STICKE";"S";"0204";"         POUR ACTIVITES"
"STICKE";"S";"0205";"            SI HABS_MOTIF = PARD_SDIVPRES"
"STICKE";"S";"0206";"               SI HABS_VALORIS = ""J"""
"STICKE";"S";"0207";"                  LOCA_TR = 1"
"STICKE";"S";"0208";"               FINSI"
"STICKE";"S";"0209";"            FINSI"
"STICKE";"S";"0210";"         FINPOUR"
"STICKE";"S";"0211";"      FINSI"
"STICKE";"S";"0212";"*"
"STICKE";"S";"0213";"* Si 6° service => Droit à 1 TR"
"STICKE";"S";"0214";"      SI HJOU_SJQP6SERV = 1"
"STICKE";"S";"0215";"      OU HJOU_SJQP6SERVD = 1"
"STICKE";"S";"0216";"         LOCA_TR = 1"
"STICKE";"S";"0217";"      FINSI"
"STICKE";"S";"0218";"*"
"STICKE";"S";"0219";"***** Attribution d'un ticket si presence matin et apres-midi >> ***********************************"
"STICKE";"S";"0220";"*"
"STICKE";"S";"0221";"      SI LOCA_TR > 0"
"STICKE";"S";"0222";"         HJOU_IJQNTICKRE = 1"
"STICKE";"S";"0223";"      FINSI"
"STICKE";"S";"0224";"*"
"STICKE";"S";"0225";"* Initialisation par consigne TR jour"
"STICKE";"S";"0226";"      POUR ACTIVITES"
"STICKE";"S";"0227";"         SI HABS_MOTIF = ""ZTCKR"""
"STICKE";"S";"0228";"            HJOU_IJQNTICKRE = HABS_MOTINBR"
"STICKE";"S";"0229";"         FINSI"
"STICKE";"S";"0230";"      FINPOUR"
"STICKE";"S";"0231";"*"
"STICKE";"S";"0232";"* Cumul mensuel"
"STICKE";"S";"0233";"      HJOU_SJRNTICKRE = HJOU_SJRNTICKRE + HJOU_IJQNTICKRE"
"STICKE";"S";"0234";"*"
"STICKE";"S";"0235";"* Initialisation par consigne TR mois"
"STICKE";"S";"0236";"      POUR ACTIVITES"
"STICKE";"S";"0237";"         SI HABS_MOTIF = ""ZTCKRM"""
"STICKE";"S";"0238";"            HJOU_SJRNTICKRE = HABS_MOTINBR"
"STICKE";"S";"0239";"         FINSI"
"STICKE";"S";"0240";"      FINPOUR"
"STICKE";"S";"0241";"*"
"STICKE";"S";"0242";"   FINSI"
"STICKE";"S";"0243";"FINSI"
"STICKE";"S";"0244";"*"
"STICKE";"S";"0245";"***** Generation envoie en paie >> *****************************************************************"
"STICKE";"S";"0246";"*"
"STICKE";"S";"0247";"* Dernier jour du mois"
"STICKE";"S";"0248";"SI TEMP_DATSUI(7:2) = ""01"""
"STICKE";"S";"0249";"OU HJOU_SJQFINC = 1"
"STICKE";"S";"0250";"OU CTRA_SCIDATSTC = HJOU_DATE"
"STICKE";"S";"0251";"*OU HJOU_SJQINSTC = ""1"""
"STICKE";"S";"0252";"*"
"STICKE";"S";"0253";"   POUR ACTIVITES"
"STICKE";"S";"0254";"      SI HABS_MOTIF = ""NDF"""
"STICKE";"S";"0255";"         SI LOCA_NDF = 0"
"STICKE";"S";"0256";"            SI HABS_MOTINBR > 0"
"STICKE";"S";"0257";"               LOCA_NDF = HABS_MOTINBR"
"STICKE";"S";"0258";"            SINON"
"STICKE";"S";"0259";"               ANOMALIE 264"
"STICKE";"S";"0260";"            FINSI"
"STICKE";"S";"0261";"         SINON"
"STICKE";"S";"0262";"            ANOMALIE 264"
"STICKE";"S";"0263";"            LOCA_NDF = -1"
"STICKE";"S";"0264";"         FINSI"
"STICKE";"S";"0265";"      FINSI"
"STICKE";"S";"0266";"   FINPOUR"
"STICKE";"S";"0267";"*"
"STICKE";"S";"0268";"* Contrôle si erreur ?"
"STICKE";"S";"0269";"   SI LOCA_NDF <> -1"
"STICKE";"S";"0270";"*"
"STICKE";"S";"0271";"      LOCA_NDF = LOCA_NDF + HJOU_SJRNNDF"
"STICKE";"S";"0272";"      HJOU_SJRNNDF = 0"
"STICKE";"S";"0273";"      LOCA_NTRMOIS = HJOU_SJRNTICKRE"
"STICKE";"S";"0274";"*"
"STICKE";"S";"0275";"      SI LOCA_NDF > 0"
"STICKE";"S";"0276";"         LOCA_NTRMOIS = LOCA_NTRMOIS - LOCA_NDF"
"STICKE";"S";"0277";"         SI LOCA_NTRMOIS < 0"
"STICKE";"S";"0278";"            HJOU_SJRNNDF = LOCA_NTRMOIS * -1"
"STICKE";"S";"0279";"            LOCA_NTRMOIS = 0"
"STICKE";"S";"0280";"         FINSI"
"STICKE";"S";"0281";"      FINSI"
"STICKE";"S";"0282";"*"
"STICKE";"S";"0283";"* Cas particulier des CDD de l'industrie, paiement des TR sur le mois M"
"STICKE";"S";"0284";"      SI HJOU_SECTORI(1:3) = ""DIN"""
"STICKE";"S";"0285";"         SI HJOU_SJQSOCIETE = ""MO"""
"STICKE";"S";"0286";"            SI CTRA_TYPCTRA = ""CDD"""
"STICKE";"S";"0287";"               SI LOCA_NTRMOIS > 0"
"STICKE";"S";"0288";"                  ENLEVER ""TRPAIECDD"""
"STICKE";"S";"0289";"                  AJOUTER ""TRPAIECDD"" ""N"" LOCA_NTRMOIS"
"STICKE";"S";"0290";"                  LOCA_NTRMOIS = 0"
"STICKE";"S";"0291";"               FINSI"
"STICKE";"S";"0292";"            FINSI"
"STICKE";"S";"0293";"         FINSI"
"STICKE";"S";"0294";"      FINSI"
"STICKE";"S";"0295";"*"
"STICKE";"S";"0296";"* Ajout élément envoyé en paie"
"STICKE";"S";"0297";"* Ajoute que dans le passé >>"
"STICKE";"S";"0298";"      SI HJOU_DATE <= TEMP_DATJOU"
"STICKE";"S";"0299";"         SI LOCA_NTRMOIS > 0"
"STICKE";"S";"0300";"            ENLEVER ""TRPAIE"""
"STICKE";"S";"0301";"            AJOUTER ""TRPAIE"" ""N"" LOCA_NTRMOIS"
"STICKE";"S";"0302";"         FINSI"
"STICKE";"S";"0303";"      FINSI"
"STICKE";"S";"0304";"*"
"STICKE";"S";"0305";"   FINSI"
"STICKE";"S";"0306";"*"
"STICKE";"S";"0307";"FINSI"
"STICKE";"S";"0308";"*"
"STICKE";"S";"0309";"FIN"
"SUIVFJ";"S";"0001";"************************************************************************"
"SUIVFJ";"S";"0002";"*"
"SUIVFJ";"S";"0003";"* Règle : SUIVFJ"
"SUIVFJ";"S";"0004";"* Ordre : 6750"
"SUIVFJ";"S";"0005";"* Titre : GCF : Suivis des forfaits jours"
"SUIVFJ";"S";"0006";"*"
"SUIVFJ";"S";"0007";"*----------------------------------------------------------------------"
"SUIVFJ";"S";"0008";"*"
"SUIVFJ";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SUIVFJ";"S";"0010";"* Date     : 28/01/2025"
"SUIVFJ";"S";"0011";"* Version  : 1"
"SUIVFJ";"S";"0012";"*"
"SUIVFJ";"S";"0013";"*---------------------------------------------------------------------"
"SUIVFJ";"S";"0014";"*"
"SUIVFJ";"S";"0015";"*"
"SUIVFJ";"S";"0016";"* Rôle : Gestion du suivis des forfaits jours, calcul de cible par société"
"SUIVFJ";"S";"0017";"*        Paramétrage dans CFG de la cible annuel / société"
"SUIVFJ";"S";"0018";"*"
"SUIVFJ";"S";"0019";"*"
"SUIVFJ";"S";"0020";"*----------------------------------------------------------------------"
"SUIVFJ";"S";"0021";"*"
"SUIVFJ";"S";"0022";"* Modifiée par : Cellule Industrialisation"
"SUIVFJ";"S";"0023";"* Date         : JJ/MM/AAAA"
"SUIVFJ";"S";"0024";"* Objet        :"
"SUIVFJ";"S";"0025";"*"
"SUIVFJ";"S";"0026";"***********************************************************************"
"SUIVFJ";"S";"0027";"*"
"SUIVFJ";"S";"0028";"* Implémentation des données industrielles"
"SUIVFJ";"S";"0029";"*"
"SUIVFJ";"S";"0030";"DEBDICO"
"SUIVFJ";"S";"0031";"   PARD_SDIVPRES;O;A10;X;;;123456789;II;;C2;""Déclaration présence jour"";"
"SUIVFJ";"S";"0032";"   PARD_SDIHREFFJ;O;T6,2;I;;;123456789;;;C2;""Heures références d'un forfait jour"";"
"SUIVFJ";"S";"0033";"   *"
"SUIVFJ";"S";"0034";"   HJOU_SJRNTRAVC;N;N5,1;I;;;    56789;;SJRNTRAVC;V3;""Nbre jours travaillés réel annuel"";"
"SUIVFJ";"S";"0035";"  *   HJOU_SJRJTRAVT;N;N5,1;I;;;    56789;;SJRJTRAVT;V3;""Nbre jours travaillés théoriques annuel"";"
"SUIVFJ";"S";"0036";"   *"
"SUIVFJ";"S";"0037";"   HJOU_SJROBJFJA;N;N8,3;L;;;    56789;;SJROBJFJA;V3;""Cible jour à travailler théo FJ annuel"";"
"SUIVFJ";"S";"0038";"   HJOU_SJRECARFJA;N;N8,2;L;;;    56789;;SJRECARFJA;V3;""Ecart annuel forfait jour (J)"";"
"SUIVFJ";"S";"0039";"   *"
"SUIVFJ";"S";"0040";"   HJOU_SJRTRAREP;N;N6,2;I;;;     6789;;SJRTRAREP;V3;""Nbres jours trav. sur Repos"";"
"SUIVFJ";"S";"0041";"   HJOU_SJRCCPAN;N;N6,2;I;;;     6789;;SJRCCPAN;V3;""Nbres CP pris annuels"";"
"SUIVFJ";"S";"0042";"   HJOU_SJRTCPRTFJ;N;N6,2;I;;;     6789;;SJRTCPRTFJ;V3;""Nbr jours de CP/RTT alimentant PERCO/CET"";"
"SUIVFJ";"S";"0043";"   *"
"SUIVFJ";"S";"0044";"   HJOU_SJRFDECLNF;N;N2;I;;;     6789;;SJRFDECLNF;V3;""Flag déclaration non validé/faite"";"
"SUIVFJ";"S";"0045";"   *"
"SUIVFJ";"S";"0046";"   EMPL_SEQOBJFJA;N;N6,1;I;;;    56789;;;V3;""Cible de jour travaillé FJ annuel"";"
"SUIVFJ";"S";"0047";"   *   EMPL_SEQJTRAVT;N;N6,1;I;;;    56789;;;V3;""Nbre jours trav. théo. annuel prév. (J)"";"
"SUIVFJ";"S";"0048";"   EMPL_SEQECARFJA;N;N6,2;I;;;     6789;;;V3;""Ecart annuel forfait jour prév. (J)"";"
"SUIVFJ";"S";"0049";"   EMPL_SEQCCPFJ;N;N6,1;L;;;     6789;;;V3;""CP pris sur l'année pour FJ"";"
"SUIVFJ";"S";"0050";"   EMPL_SEQCRTTFJ;N;N6,1;L;;;     6789;;;V3;""RTT pris sur l'année pour FJ"";"
"SUIVFJ";"S";"0051";"   *   EMPL_SEQJTREPFJ;N;N6,1;L;;;     6789;;;V3;""Nbr J. trav. sur repos ou JF sur l'année"";"
"SUIVFJ";"S";"0052";"   EMPL_SEQTCPRTFJ;O;N6,1;I;;;     6789;;;V3;""Nbr jours de CP/RTT alimentant PERCO/CET"";"
"SUIVFJ";"S";"0053";"FINDICO"
"SUIVFJ";"S";"0054";"*"
"SUIVFJ";"S";"0055";"* Déclaration des données locales"
"SUIVFJ";"S";"0056";"*"
"SUIVFJ";"S";"0057";"DEF LOCA_DROIT N2"
"SUIVFJ";"S";"0058";"LOCA_DROIT = 0"
"SUIVFJ";"S";"0059";"*"
"SUIVFJ";"S";"0060";"DEF LOCA_OBJFJ N6.1"
"SUIVFJ";"S";"0061";"LOCA_OBJFJ = 218"
"SUIVFJ";"S";"0062";"DEF LOCA_OBJJR N8.3"
"SUIVFJ";"S";"0063";"LOCA_OBJJR = 0"
"SUIVFJ";"S";"0064";"DEF LOCA_ETP N6.2"
"SUIVFJ";"S";"0065";"LOCA_ETP = 1"
"SUIVFJ";"S";"0066";"DEF LOCA_FERI N2"
"SUIVFJ";"S";"0067";"LOCA_FERI = 0"
"SUIVFJ";"S";"0068";"DEF LOCA_AJOUTJ N6.2"
"SUIVFJ";"S";"0069";"LOCA_AJOUTJ = 0"
"SUIVFJ";"S";"0070";"DEF LOCA_PRES N4.1"
"SUIVFJ";"S";"0071";"LOCA_PRES = 0"
"SUIVFJ";"S";"0072";"DEF LOCA_XPRES N4.1"
"SUIVFJ";"S";"0073";"LOCA_XPRES = 0"
"SUIVFJ";"S";"0074";"DEF LOCA_INTVALO A2"
"SUIVFJ";"S";"0075";"LOCA_INTVALO = "" """
"SUIVFJ";"S";"0076";"DEF LOCA_PRESVALO A1"
"SUIVFJ";"S";"0077";"LOCA_PRESVALO = "" """
"SUIVFJ";"S";"0078";"DEF LOCA_ABS N4.1"
"SUIVFJ";"S";"0079";"LOCA_ABS = 0"
"SUIVFJ";"S";"0080";"DEF LOCA_ABSVALO A1"
"SUIVFJ";"S";"0081";"LOCA_ABSVALO = "" """
"SUIVFJ";"S";"0082";"DEF LOCA_DROICP N6.2"
"SUIVFJ";"S";"0083";"LOCA_DROICP = HJOU_IJRDCOPRIN"
"SUIVFJ";"S";"0084";"DEF LOCA_SOLDCP N6.2"
"SUIVFJ";"S";"0085";"LOCA_SOLDCP = 0"
"SUIVFJ";"S";"0086";"DEF LOCA_PAIEJF N6.2"
"SUIVFJ";"S";"0087";"LOCA_PAIEJF = 0"
"SUIVFJ";"S";"0088";"DEF LOCA_SJRFDECLNF N2"
"SUIVFJ";"S";"0089";"LOCA_SJRFDECLNF = 0"
"SUIVFJ";"S";"0090";"DEF LOCA_INTAST T6.2"
"SUIVFJ";"S";"0091";"LOCA_INTAST = 0"
"SUIVFJ";"S";"0092";"DEF LOCA_HFJ T6.2"
"SUIVFJ";"S";"0093";"LOCA_HFJ = PARD_SDIHREFFJ"
"SUIVFJ";"S";"0094";"DEF LOCA_HFJ2 T6.2"
"SUIVFJ";"S";"0095";"LOCA_HFJ2 = LOCA_HFJ / 2"
"SUIVFJ";"S";"0096";"DEF LOCA_RECFJ N6.2"
"SUIVFJ";"S";"0097";"LOCA_RECFJ = 0"
"SUIVFJ";"S";"0098";"DEF LOCA_JSOL N2"
"SUIVFJ";"S";"0099";"LOCA_JSOL = 0"
"SUIVFJ";"S";"0100";"DEF LOCA_JFT N2"
"SUIVFJ";"S";"0101";"LOCA_JFT = 0"
"SUIVFJ";"S";"0102";"*"
"SUIVFJ";"S";"0103";"* Theorie demi-journée"
"SUIVFJ";"S";"0104";"DEF LOCA_DEMIJ T6.2"
"SUIVFJ";"S";"0105";"SI PROF_ABSENM = 0"
"SUIVFJ";"S";"0106";"OU PROF_ABSENS = 0"
"SUIVFJ";"S";"0107";"   LOCA_DEMIJ = LOCA_HFJ2 + 0.45"
"SUIVFJ";"S";"0108";"SINON"
"SUIVFJ";"S";"0109";"   LOCA_DEMIJ = HJOU_IJQPRETHEJ / 2"
"SUIVFJ";"S";"0110";"   LOCA_DEMIJ = LOCA_DEMIJ + 1.30"
"SUIVFJ";"S";"0111";"FINSI"
"SUIVFJ";"S";"0112";"*"
"SUIVFJ";"S";"0113";"* Calcul de la date de référence des forfaits jours"
"SUIVFJ";"S";"0114";"DEF LOCA_DATE D"
"SUIVFJ";"S";"0115";"LOCA_DATE(1:4) = TEMP_DATJOU(1:4)"
"SUIVFJ";"S";"0116";"LOCA_DATE(5:4) = ""0101"""
"SUIVFJ";"S";"0117";"*"
"SUIVFJ";"S";"0118";"DEF LOCA_DATEFU D"
"SUIVFJ";"S";"0119";"LOCA_DATEFU(5:4) = LOCA_DATE(5:4)"
"SUIVFJ";"S";"0120";"DEF LOCA_ANNEE N4"
"SUIVFJ";"S";"0121";"LOCA_ANNEE << LOCA_DATE(1:4)"
"SUIVFJ";"S";"0122";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SUIVFJ";"S";"0123";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SUIVFJ";"S";"0124";"*"
"SUIVFJ";"S";"0125";"* Définition année bisextille"
"SUIVFJ";"S";"0126";"DEF LOCA_ABIS N2"
"SUIVFJ";"S";"0127";"LOCA_ABIS = 0"
"SUIVFJ";"S";"0128";"*"
"SUIVFJ";"S";"0129";"SI HJOU_DATE(1:4) = ""2024"""
"SUIVFJ";"S";"0130";"OU HJOU_DATE(1:4) = ""2028"""
"SUIVFJ";"S";"0131";"OU HJOU_DATE(1:4) = ""2032"""
"SUIVFJ";"S";"0132";"OU HJOU_DATE(1:4) = ""2034"""
"SUIVFJ";"S";"0133";"OU HJOU_DATE(1:4) = ""2038"""
"SUIVFJ";"S";"0134";"OU HJOU_DATE(1:4) = ""2042"""
"SUIVFJ";"S";"0135";"OU HJOU_DATE(1:4) = ""2046"""
"SUIVFJ";"S";"0136";"OU HJOU_DATE(1:4) = ""2050"""
"SUIVFJ";"S";"0137";"   LOCA_ABIS = 1"
"SUIVFJ";"S";"0138";"FINSI"
"SUIVFJ";"S";"0139";"*"
"SUIVFJ";"S";"0140";"POUR ACTIVITES"
"SUIVFJ";"S";"0141";"   SI HABS_MOTIF = ""JF"""
"SUIVFJ";"S";"0142";"      LOCA_FERI = 1"
"SUIVFJ";"S";"0143";"   FINSI"
"SUIVFJ";"S";"0144";"   SI HABS_MOTIF = ""JSOL"""
"SUIVFJ";"S";"0145";"      LOCA_JSOL = 1"
"SUIVFJ";"S";"0146";"   FINSI"
"SUIVFJ";"S";"0147";"   SI HABS_MOTIF = ""JFT"""
"SUIVFJ";"S";"0148";"   OU HABS_MOTIF = ""JFT2"""
"SUIVFJ";"S";"0149";"      LOCA_JFT = 1"
"SUIVFJ";"S";"0150";"   FINSI"
"SUIVFJ";"S";"0151";"FINPOUR"
"SUIVFJ";"S";"0152";"*"
"SUIVFJ";"S";"0153";"SI HJOU_SJQFORFJR = ""1"""
"SUIVFJ";"S";"0154";"   LOCA_DROIT = 1"
"SUIVFJ";"S";"0155";"FINSI"
"SUIVFJ";"S";"0156";"*"
"SUIVFJ";"S";"0157";"* RAZ compteur si pas concerné"
"SUIVFJ";"S";"0158";"SI LOCA_DROIT <> 1"
"SUIVFJ";"S";"0159";"   HJOU_SJRFDECLNF = 0"
"SUIVFJ";"S";"0160";"FINSI"
"SUIVFJ";"S";"0161";"*"
"SUIVFJ";"S";"0162";"****** Définition de la cible annuel en fonction des sociétés >> ***********************************"
"SUIVFJ";"S";"0163";"*"
"SUIVFJ";"S";"0164";"* Société EC >>"
"SUIVFJ";"S";"0165";"SI HJOU_SJQSOCIETE = ""EC"""
"SUIVFJ";"S";"0166";"   LOCA_OBJFJ = PARD_SDICFJEC"
"SUIVFJ";"S";"0167";"FINSI"
"SUIVFJ";"S";"0168";"*"
"SUIVFJ";"S";"0169";"* Société ES >>"
"SUIVFJ";"S";"0170";"SI HJOU_SJQSOCIETE = ""ES"""
"SUIVFJ";"S";"0171";"   LOCA_OBJFJ = PARD_SDICFJES"
"SUIVFJ";"S";"0172";"FINSI"
"SUIVFJ";"S";"0173";"*"
"SUIVFJ";"S";"0174";"* Société HE >>"
"SUIVFJ";"S";"0175";"SI HJOU_SJQSOCIETE = ""HE"""
"SUIVFJ";"S";"0176";"   LOCA_OBJFJ = PARD_SDICFJHE"
"SUIVFJ";"S";"0177";"FINSI"
"SUIVFJ";"S";"0178";"*"
"SUIVFJ";"S";"0179";"* Société MO >>"
"SUIVFJ";"S";"0180";"SI HJOU_SJQSOCIETE = ""IR"""
"SUIVFJ";"S";"0181";"   LOCA_OBJFJ = PARD_SDICFJIR"
"SUIVFJ";"S";"0182";"FINSI"
"SUIVFJ";"S";"0183";"*"
"SUIVFJ";"S";"0184";"* Société MO >>"
"SUIVFJ";"S";"0185";"SI HJOU_SJQSOCIETE = ""MO"""
"SUIVFJ";"S";"0186";"   LOCA_OBJFJ = PARD_SDICFJMO"
"SUIVFJ";"S";"0187";"   SI HJOU_SJQCATEGOR = ""AM"""
"SUIVFJ";"S";"0188";"      LOCA_OBJFJ = PARD_SDICFJMOA"
"SUIVFJ";"S";"0189";"   FINSI"
"SUIVFJ";"S";"0190";"FINSI"
"SUIVFJ";"S";"0191";"*"
"SUIVFJ";"S";"0192";"* Société PC >>"
"SUIVFJ";"S";"0193";"SI HJOU_SJQSOCIETE = ""PC"""
"SUIVFJ";"S";"0194";"   LOCA_OBJFJ = PARD_SDICFJPC"
"SUIVFJ";"S";"0195";"   SI HJOU_SJQCATEGOR = ""AM"""
"SUIVFJ";"S";"0196";"      LOCA_OBJFJ = PARD_SDICFJPCA"
"SUIVFJ";"S";"0197";"   FINSI"
"SUIVFJ";"S";"0198";"FINSI"
"SUIVFJ";"S";"0199";"*"
"SUIVFJ";"S";"0200";"* Société PE >>"
"SUIVFJ";"S";"0201";"SI HJOU_SJQSOCIETE = ""PE"""
"SUIVFJ";"S";"0202";"   LOCA_OBJFJ = PARD_SDICFJPE"
"SUIVFJ";"S";"0203";"FINSI"
"SUIVFJ";"S";"0204";"*"
"SUIVFJ";"S";"0205";"* Société PO >>"
"SUIVFJ";"S";"0206";"SI HJOU_SJQSOCIETE = ""PO"""
"SUIVFJ";"S";"0207";"   LOCA_OBJFJ = PARD_SDICFJPO"
"SUIVFJ";"S";"0208";"FINSI"
"SUIVFJ";"S";"0209";"*"
"SUIVFJ";"S";"0210";"* Société RC >>"
"SUIVFJ";"S";"0211";"SI HJOU_SJQSOCIETE = ""RC"""
"SUIVFJ";"S";"0212";"   LOCA_OBJFJ = PARD_SDICFJRC"
"SUIVFJ";"S";"0213";"FINSI"
"SUIVFJ";"S";"0214";"*"
"SUIVFJ";"S";"0215";"* Société VH >>"
"SUIVFJ";"S";"0216";"SI HJOU_SJQSOCIETE = ""VH"""
"SUIVFJ";"S";"0217";"   LOCA_OBJFJ = PARD_SDICFJVH"
"SUIVFJ";"S";"0218";"   SI HJOU_SJQCATEGOR = ""J"""
"SUIVFJ";"S";"0219";"      LOCA_OBJFJ = PARD_SDICFJVHJ"
"SUIVFJ";"S";"0220";"   FINSI"
"SUIVFJ";"S";"0221";"FINSI"
"SUIVFJ";"S";"0222";"*"
"SUIVFJ";"S";"0223";"* Société YR >>"
"SUIVFJ";"S";"0224";"SI HJOU_SJQSOCIETE = ""YR"""
"SUIVFJ";"S";"0225";"   LOCA_OBJFJ = PARD_SDICFJYR"
"SUIVFJ";"S";"0226";"   SI HJOU_SJQCATEGOR = ""J"""
"SUIVFJ";"S";"0227";"      LOCA_OBJFJ = PARD_IDIVDDISP1"
"SUIVFJ";"S";"0228";"   FINSI"
"SUIVFJ";"S";"0229";"FINSI"
"SUIVFJ";"S";"0230";"*"
"SUIVFJ";"S";"0231";"* RAZ annuel"
"SUIVFJ";"S";"0232";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SUIVFJ";"S";"0233";"   HJOU_SJROBJFJA = 0"
"SUIVFJ";"S";"0234";"   HJOU_SJRNTRAVC = 0"
"SUIVFJ";"S";"0235";"   HJOU_SJRJTRAVT = 0"
"SUIVFJ";"S";"0236";"   HJOU_SJRTRAREP = 0"
"SUIVFJ";"S";"0237";"   HJOU_SJRCCPAN = 0"
"SUIVFJ";"S";"0238";"FINSI"
"SUIVFJ";"S";"0239";"*"
"SUIVFJ";"S";"0240";"SI LOCA_DROIT = 1"
"SUIVFJ";"S";"0241";"*"
"SUIVFJ";"S";"0242";"***** Calcul de la cible annuel jour par jour >> ***************************************************"
"SUIVFJ";"S";"0243";"*"
"SUIVFJ";"S";"0244";"   SI LOCA_ABIS = 1"
"SUIVFJ";"S";"0245";"      LOCA_OBJJR = LOCA_OBJFJ / 366"
"SUIVFJ";"S";"0246";"   SINON"
"SUIVFJ";"S";"0247";"      LOCA_OBJJR = LOCA_OBJFJ / 365"
"SUIVFJ";"S";"0248";"   FINSI"
"SUIVFJ";"S";"0249";"   LOCA_OBJJR = LOCA_OBJJR * LOCA_ETP"
"SUIVFJ";"S";"0250";"   HJOU_SJROBJFJA = HJOU_SJROBJFJA + LOCA_OBJJR"
"SUIVFJ";"S";"0251";"*"
"SUIVFJ";"S";"0252";"***** Analyse des présences et absences >> ******************************************************"
"SUIVFJ";"S";"0253";"*"
"SUIVFJ";"S";"0254";"   POUR ACTIVITES"
"SUIVFJ";"S";"0255";"* Contrôle si saisie de la présence >>"
"SUIVFJ";"S";"0256";"      SI HABS_MOTIF = PARD_SDIVPRES"
"SUIVFJ";"S";"0257";"         SI HABS_VALORIS = ""J"""
"SUIVFJ";"S";"0258";"            LOCA_PRES = LOCA_PRES + 1"
"SUIVFJ";"S";"0259";"            LOCA_PRESVALO = HABS_VALORIS"
"SUIVFJ";"S";"0260";"         FINSI"
"SUIVFJ";"S";"0261";"         SI HABS_VALORIS = ""M"""
"SUIVFJ";"S";"0262";"         OU HABS_VALORIS = ""A"""
"SUIVFJ";"S";"0263";"            LOCA_PRES = LOCA_PRES + 0.5"
"SUIVFJ";"S";"0264";"            LOCA_PRESVALO = HABS_VALORIS"
"SUIVFJ";"S";"0265";"         FINSI"
"SUIVFJ";"S";"0266";"      FINSI"
"SUIVFJ";"S";"0267";"* Inter. Astreinte ?"
"SUIVFJ";"S";"0268";"      SI HABS_MOTIF = PARD_SDIVMINTA"
"SUIVFJ";"S";"0269";"         LOCA_INTAST = LOCA_INTAST + HABS_MOTIDUR"
"SUIVFJ";"S";"0270";"*"
"SUIVFJ";"S";"0271";"* Définition de la valorisation déduite >>"
"SUIVFJ";"S";"0272";"         SI LOCA_INTVALO <> ""JJ"""
"SUIVFJ";"S";"0273";"* Valorisation jour"
"SUIVFJ";"S";"0274";"            SI LOCA_INTAST >= LOCA_HFJ2"
"SUIVFJ";"S";"0275";"               LOCA_INTVALO = ""JJ"""
"SUIVFJ";"S";"0276";"            SINON"
"SUIVFJ";"S";"0277";"* Valo matin"
"SUIVFJ";"S";"0278";"               SI HABS_HRADEB < 13.00"
"SUIVFJ";"S";"0279";"                  SI LOCA_INTVALO(1:1) = "" """
"SUIVFJ";"S";"0280";"                     LOCA_INTVALO(1:1) = ""M"""
"SUIVFJ";"S";"0281";"                  SINON"
"SUIVFJ";"S";"0282";"                     LOCA_INTVALO(2:1) = ""M"""
"SUIVFJ";"S";"0283";"                  FINSI"
"SUIVFJ";"S";"0284";"               SINON"
"SUIVFJ";"S";"0285";"* Valo après-midi"
"SUIVFJ";"S";"0286";"                  SI LOCA_INTVALO(1:1) = "" """
"SUIVFJ";"S";"0287";"                     LOCA_INTVALO = ""A"""
"SUIVFJ";"S";"0288";"                  SINON"
"SUIVFJ";"S";"0289";"                     LOCA_INTVALO(2:1) = ""A"""
"SUIVFJ";"S";"0290";"                  FINSI"
"SUIVFJ";"S";"0291";"               FINSI"
"SUIVFJ";"S";"0292";"*"
"SUIVFJ";"S";"0293";"               SI LOCA_INTVALO = ""MA"""
"SUIVFJ";"S";"0294";"               OU LOCA_INTVALO = ""AM"""
"SUIVFJ";"S";"0295";"                  LOCA_INTVALO = ""JJ"""
"SUIVFJ";"S";"0296";"               FINSI"
"SUIVFJ";"S";"0297";"*"
"SUIVFJ";"S";"0298";"               SI LOCA_INTVALO = ""MM"""
"SUIVFJ";"S";"0299";"                  LOCA_INTVALO = ""M"""
"SUIVFJ";"S";"0300";"               FINSI"
"SUIVFJ";"S";"0301";"               SI LOCA_INTVALO = ""AA"""
"SUIVFJ";"S";"0302";"                  LOCA_INTVALO = ""A"""
"SUIVFJ";"S";"0303";"               FINSI"
"SUIVFJ";"S";"0304";"*"
"SUIVFJ";"S";"0305";"            FINSI"
"SUIVFJ";"S";"0306";"         FINSI"
"SUIVFJ";"S";"0307";"      FINSI"
"SUIVFJ";"S";"0308";"* Contrôle si Absence ne participant pas au TTE >>"
"SUIVFJ";"S";"0309";"      SI HABS_MOTYPE <> ""C"""
"SUIVFJ";"S";"0310";"         SI LOCA_FERI <> 1"
"SUIVFJ";"S";"0311";"            SI MOTI_IMIGTTEFFE <> ""1"""
"SUIVFJ";"S";"0312";"               SI HABS_VALORIS = ""J"""
"SUIVFJ";"S";"0313";"                  LOCA_ABS = LOCA_ABS + 1"
"SUIVFJ";"S";"0314";"                  LOCA_ABSVALO = HABS_VALORIS"
"SUIVFJ";"S";"0315";"               FINSI"
"SUIVFJ";"S";"0316";"               SI HABS_VALORIS = ""M"""
"SUIVFJ";"S";"0317";"               OU HABS_VALORIS = ""A"""
"SUIVFJ";"S";"0318";"                  LOCA_ABS = LOCA_ABS + 0.5"
"SUIVFJ";"S";"0319";"                  LOCA_ABSVALO = HABS_VALORIS"
"SUIVFJ";"S";"0320";"               FINSI"
"SUIVFJ";"S";"0321";"            FINSI"
"SUIVFJ";"S";"0322";"         FINSI"
"SUIVFJ";"S";"0323";"      FINSI"
"SUIVFJ";"S";"0324";"*"
"SUIVFJ";"S";"0325";"   FINPOUR"
"SUIVFJ";"S";"0326";"*"
"SUIVFJ";"S";"0327";"   SI LOCA_INTAST > 0"
"SUIVFJ";"S";"0328";"      SI LOCA_INTAST >= LOCA_HFJ2"
"SUIVFJ";"S";"0329";"         LOCA_PRES = LOCA_PRES + 1"
"SUIVFJ";"S";"0330";"      SINON"
"SUIVFJ";"S";"0331";"         SI LOCA_INTVALO <> LOCA_PRESVALO"
"SUIVFJ";"S";"0332";"            LOCA_PRES = LOCA_PRES + 0.5"
"SUIVFJ";"S";"0333";"         FINSI"
"SUIVFJ";"S";"0334";"      FINSI"
"SUIVFJ";"S";"0335";"   FINSI"
"SUIVFJ";"S";"0336";"*"
"SUIVFJ";"S";"0337";"   SI LOCA_PRES > 1"
"SUIVFJ";"S";"0338";"      LOCA_PRES = 1"
"SUIVFJ";"S";"0339";"      LOCA_PRESVALO = ""J"""
"SUIVFJ";"S";"0340";"   FINSI"
"SUIVFJ";"S";"0341";"*"
"SUIVFJ";"S";"0342";"   SI LOCA_ABS >= 1"
"SUIVFJ";"S";"0343";"      LOCA_ABS = 1"
"SUIVFJ";"S";"0344";"      LOCA_ABSVALO = ""J"""
"SUIVFJ";"S";"0345";"   FINSI"
"SUIVFJ";"S";"0346";"*"
"SUIVFJ";"S";"0347";"   LOCA_XPRES = LOCA_PRES"
"SUIVFJ";"S";"0348";"*"
"SUIVFJ";"S";"0349";"***** Calcul des jours travaillés FJ REEL >> ******************************************************"
"SUIVFJ";"S";"0350";"*"
"SUIVFJ";"S";"0351";"* Calcul nombre de jours travaillés si TTE > 0"
"SUIVFJ";"S";"0352";"   SI HJOU_IJQTTEFFEJ > 0.02"
"SUIVFJ";"S";"0353";"* Si pas de saisie de XPRES on déduit"
"SUIVFJ";"S";"0354";"      SI LOCA_PRES <= 0.5"
"SUIVFJ";"S";"0355";"         SI HJOU_IJQPRETHEJ > 0"
"SUIVFJ";"S";"0356";"            SI HJOU_IJQTTEFFEJ >= LOCA_DEMIJ"
"SUIVFJ";"S";"0357";"               LOCA_PRES = 1"
"SUIVFJ";"S";"0358";"            SINON"
"SUIVFJ";"S";"0359";"               LOCA_PRES = 0.5"
"SUIVFJ";"S";"0360";"            FINSI"
"SUIVFJ";"S";"0361";"         FINSI"
"SUIVFJ";"S";"0362";"      FINSI"
"SUIVFJ";"S";"0363";"      HJOU_IJQNJTRAVJ = LOCA_PRES"
"SUIVFJ";"S";"0364";"      HJOU_IJRNJTRAVA = HJOU_IJRNJTRAVA + HJOU_IJQNJTRAVJ"
"SUIVFJ";"S";"0365";"      HJOU_IJRNJTRAVH = HJOU_IJRNJTRAVH + HJOU_IJQNJTRAVJ"
"SUIVFJ";"S";"0366";"      HJOU_IJRNJTRAVM = HJOU_IJRNJTRAVM + HJOU_IJQNJTRAVJ"
"SUIVFJ";"S";"0367";"      HJOU_IJRNJTRMCP = HJOU_IJRNJTRMCP + HJOU_IJQNJTRAVJ"
"SUIVFJ";"S";"0368";"*"
"SUIVFJ";"S";"0369";"      HJOU_SJRNTRAVC = HJOU_SJRNTRAVC + LOCA_PRES"
"SUIVFJ";"S";"0370";"      HJOU_SJRJTRAVT = HJOU_SJRJTRAVT + LOCA_PRES"
"SUIVFJ";"S";"0371";"* Calcul Jour travaillé sur repos"
"SUIVFJ";"S";"0372";"      SI HJOU_IJQPRETHEJ = 0"
"SUIVFJ";"S";"0373";"         HJOU_SJRTRAREP = HJOU_SJRTRAREP + LOCA_PRES"
"SUIVFJ";"S";"0374";"         HJOU_SJRSRDEC = HJOU_SJRSRDEC + LOCA_PRES"
"SUIVFJ";"S";"0375";"      FINSI"
"SUIVFJ";"S";"0376";"* JJA - 01/09/2025 - FFT025005565 : Calcul Jour travaillé sur férié"
"SUIVFJ";"S";"0377";"*"
"SUIVFJ";"S";"0378";"      SI TEMP_STQJF = ""JJF"""
"SUIVFJ";"S";"0379";"         SI LOCA_JSOL <> 1"
"SUIVFJ";"S";"0380";"            SI HJOU_IJQPRETHEJ <> 0"
"SUIVFJ";"S";"0381";"               SI LOCA_FERI = 1"
"SUIVFJ";"S";"0382";"               OU LOCA_JFT = 1"
"SUIVFJ";"S";"0383";"                  HJOU_SJRTRAREP = HJOU_SJRTRAREP + LOCA_PRES"
"SUIVFJ";"S";"0384";"                  HJOU_SJRSRDEC = HJOU_SJRSRDEC + LOCA_PRES"
"SUIVFJ";"S";"0385";"               FINSI"
"SUIVFJ";"S";"0386";"            FINSI"
"SUIVFJ";"S";"0387";"         FINSI"
"SUIVFJ";"S";"0388";"      FINSI"
"SUIVFJ";"S";"0389";"*"
"SUIVFJ";"S";"0390";"   FINSI"
"SUIVFJ";"S";"0391";"*"
"SUIVFJ";"S";"0392";"   POUR ACTIVITES"
"SUIVFJ";"S";"0393";"      SI HABS_MOTIF = ""ZTFJ"""
"SUIVFJ";"S";"0394";"         HJOU_SJRTRAREP = HABS_MOTINBR"
"SUIVFJ";"S";"0395";"      FINSI"
"SUIVFJ";"S";"0396";"   FINPOUR"
"SUIVFJ";"S";"0397";"*"
"SUIVFJ";"S";"0398";"***** Calcul des jours travaillés FJ futur théorique >> ********************************************"
"SUIVFJ";"S";"0399";"*"
"SUIVFJ";"S";"0400";"   SI HJOU_DATE > TEMP_DATJOU"
"SUIVFJ";"S";"0401";"*"
"SUIVFJ";"S";"0402";"****** Calcul de la présence théorique >>"
"SUIVFJ";"S";"0403";"*"
"SUIVFJ";"S";"0404";"* Analyse des présences théoriques selon le planifié >>"
"SUIVFJ";"S";"0405";"*"
"SUIVFJ";"S";"0406";"* Si jour travaillé ? >>"
"SUIVFJ";"S";"0407";"      SI HJOU_IJQPRETHEJ = 0"
"SUIVFJ";"S";"0408";"      OU LOCA_FERI = 1"
"SUIVFJ";"S";"0409";"* Si Repos >>"
"SUIVFJ";"S";"0410";"         LOCA_AJOUTJ = LOCA_AJOUTJ + LOCA_PRES"
"SUIVFJ";"S";"0411";"      SINON"
"SUIVFJ";"S";"0412";"* Si demi-jour"
"SUIVFJ";"S";"0413";"         SI PROF_ABSENM = 0"
"SUIVFJ";"S";"0414";"         OU PROF_ABSENS = 0"
"SUIVFJ";"S";"0415";"            LOCA_AJOUTJ = 0.5"
"SUIVFJ";"S";"0416";"         SINON"
"SUIVFJ";"S";"0417";"            LOCA_AJOUTJ = 1"
"SUIVFJ";"S";"0418";"         FINSI"
"SUIVFJ";"S";"0419";"      FINSI"
"SUIVFJ";"S";"0420";"*"
"SUIVFJ";"S";"0421";"* Prise en compte des absences >>"
"SUIVFJ";"S";"0422";"*"
"SUIVFJ";"S";"0423";"* Gestion des absences ne participant pas au TTE dans le futur"
"SUIVFJ";"S";"0424";"      POUR ACTIVITES"
"SUIVFJ";"S";"0425";"         SI HABS_MOTYPE <> ""C"""
"SUIVFJ";"S";"0426";"            SI LOCA_FERI <> 1"
"SUIVFJ";"S";"0427";"               SI MOTI_IMIGTTEFFE <> ""1"""
"SUIVFJ";"S";"0428";"* Jour"
"SUIVFJ";"S";"0429";"                  SI HABS_VALORIS = ""J"""
"SUIVFJ";"S";"0430";"                     LOCA_AJOUTJ = 0"
"SUIVFJ";"S";"0431";"                  FINSI"
"SUIVFJ";"S";"0432";"* Matin/Après-midi"
"SUIVFJ";"S";"0433";"                  SI HABS_VALORIS = ""A"""
"SUIVFJ";"S";"0434";"                  OU HABS_VALORIS = ""M"""
"SUIVFJ";"S";"0435";"                     LOCA_AJOUTJ = LOCA_AJOUTJ - 0.5"
"SUIVFJ";"S";"0436";"                  FINSI"
"SUIVFJ";"S";"0437";"* Heure"
"SUIVFJ";"S";"0438";"                  SI HABS_VALORIS = ""H"""
"SUIVFJ";"S";"0439";"                     SI HABS_MOTIDUR >= LOCA_DEMIJ"
"SUIVFJ";"S";"0440";"                        LOCA_AJOUTJ = 0"
"SUIVFJ";"S";"0441";"                     SINON"
"SUIVFJ";"S";"0442";"                        LOCA_AJOUTJ = LOCA_AJOUTJ - 0.5"
"SUIVFJ";"S";"0443";"                     FINSI"
"SUIVFJ";"S";"0444";"                  FINSI"
"SUIVFJ";"S";"0445";"               FINSI"
"SUIVFJ";"S";"0446";"            FINSI"
"SUIVFJ";"S";"0447";"         FINSI"
"SUIVFJ";"S";"0448";"      FINPOUR"
"SUIVFJ";"S";"0449";"*"
"SUIVFJ";"S";"0450";"      SI LOCA_AJOUTJ > 0"
"SUIVFJ";"S";"0451";"         SI LOCA_AJOUTJ > 1"
"SUIVFJ";"S";"0452";"            LOCA_AJOUTJ = 1"
"SUIVFJ";"S";"0453";"         FINSI"
"SUIVFJ";"S";"0454";"         HJOU_SJRJTRAVT = HJOU_SJRJTRAVT + LOCA_AJOUTJ"
"SUIVFJ";"S";"0455";"      FINSI"
"SUIVFJ";"S";"0456";"*"
"SUIVFJ";"S";"0457";"* Futur ?"
"SUIVFJ";"S";"0458";"   FINSI"
"SUIVFJ";"S";"0459";"*"
"SUIVFJ";"S";"0460";"*"
"SUIVFJ";"S";"0461";"* Init par consignes"
"SUIVFJ";"S";"0462";"   POUR ACTIVITES"
"SUIVFJ";"S";"0463";"      SI HABS_MOTIF = ""ZTRFJ"""
"SUIVFJ";"S";"0464";"         HJOU_SJRNTRAVC = HABS_MOTINBR"
"SUIVFJ";"S";"0465";"         HJOU_IJRNJTRAVA = HABS_MOTINBR"
"SUIVFJ";"S";"0466";"         HJOU_SJRJTRAVT = HABS_MOTINBR"
"SUIVFJ";"S";"0467";"      FINSI"
"SUIVFJ";"S";"0468";"      SI HABS_MOTIF = ""ZCIBFJ"""
"SUIVFJ";"S";"0469";"         HJOU_SJROBJFJA = HABS_MOTINBR"
"SUIVFJ";"S";"0470";"      FINSI"
"SUIVFJ";"S";"0471";"   FINPOUR"
"SUIVFJ";"S";"0472";"*"
"SUIVFJ";"S";"0473";"* Calcul nombre de CP pris sur l'année"
"SUIVFJ";"S";"0474";"   POUR ACTIVITES"
"SUIVFJ";"S";"0475";"      SI HABS_MOTIF = PARD_IDIVMCOPRI"
"SUIVFJ";"S";"0476";"      OU HABS_MOTIF = ""YPERCP"""
"SUIVFJ";"S";"0477";"      OU HABS_MOTIF = ""YCETCPA"""
"SUIVFJ";"S";"0478";"*OU HABS_MOTIF = PARD_IDIVMCOANC"
"SUIVFJ";"S";"0479";"*OU HABS_MOTIF = PARD_SDIVMCMDF"
"SUIVFJ";"S";"0480";"*OU HABS_MOTIF = PARD_SDIVMCSUP"
"SUIVFJ";"S";"0481";"*OU HABS_MOTIF = PARD_IDIVMCOFRA"
"SUIVFJ";"S";"0482";"         HJOU_SJRCCPAN = HJOU_SJRCCPAN + HABS_MOTINBR"
"SUIVFJ";"S";"0483";"      FINSI"
"SUIVFJ";"S";"0484";"* Suivs jour PERCO et CET"
"SUIVFJ";"S";"0485";"      SI HABS_MOTIF = ""YPERCP"""
"SUIVFJ";"S";"0486";"      OU HABS_MOTIF = ""YCETCPA"""
"SUIVFJ";"S";"0487";"      OU HABS_MOTIF = ""YPERRTT"""
"SUIVFJ";"S";"0488";"      OU HABS_MOTIF = ""YCETRTA"""
"SUIVFJ";"S";"0489";"         HJOU_SJRTCPRTFJ = HJOU_SJRTCPRTFJ + HABS_MOTINBR"
"SUIVFJ";"S";"0490";"      FINSI"
"SUIVFJ";"S";"0491";"* Init par consigne"
"SUIVFJ";"S";"0492";"      SI HABS_MOTIF = ""ZCCPFJ"""
"SUIVFJ";"S";"0493";"         HJOU_SJRCCPAN = HABS_MOTINBR"
"SUIVFJ";"S";"0494";"      FINSI"
"SUIVFJ";"S";"0495";"   FINPOUR"
"SUIVFJ";"S";"0496";"*"
"SUIVFJ";"S";"0497";"* Calcul Ecart jounalier"
"SUIVFJ";"S";"0498";"   HJOU_SJRECARFJA = HJOU_SJRJTRAVT - HJOU_SJROBJFJA"
"SUIVFJ";"S";"0499";"*   HJOU_SJRECARFJA = HJOU_SJRNTRAVC - HJOU_SJRJTRAVT"
"SUIVFJ";"S";"0500";"*"
"SUIVFJ";"S";"0501";"* Gestion du flag de rappel si déclaration non faites"
"SUIVFJ";"S";"0502";"*"
"SUIVFJ";"S";"0503";"* RAZ le 1° jour du mois"
"SUIVFJ";"S";"0504";"   SI HJOU_DATE(7:2) = ""01"""
"SUIVFJ";"S";"0505";"      HJOU_SJRFDECLNF = 0"
"SUIVFJ";"S";"0506";"   FINSI"
"SUIVFJ";"S";"0507";"*"
"SUIVFJ";"S";"0508";"* Vérification que sur le mois on est pas une journée sans XPRES et sans ab"
"SUIVFJ";"S";"0509";"   SI HJOU_DATE < TEMP_DATJOU"
"SUIVFJ";"S";"0510";"      SI HJOU_IJQPRETHEJ > 0"
"SUIVFJ";"S";"0511";"         SI LOCA_FERI <> 1"
"SUIVFJ";"S";"0512";"            SI LOCA_XPRES = 0"
"SUIVFJ";"S";"0513";"               SI LOCA_ABS = 0"
"SUIVFJ";"S";"0514";"                  HJOU_SJRFDECLNF = HJOU_SJRFDECLNF + 1"
"SUIVFJ";"S";"0515";"               FINSI"
"SUIVFJ";"S";"0516";"            FINSI"
"SUIVFJ";"S";"0517";"         FINSI"
"SUIVFJ";"S";"0518";"      FINSI"
"SUIVFJ";"S";"0519";"   FINSI"
"SUIVFJ";"S";"0520";"*"
"SUIVFJ";"S";"0521";"   SI HJOU_DATE < TEMP_DATJOU"
"SUIVFJ";"S";"0522";"      SI HJOU_DATE(7:2) = ""01"""
"SUIVFJ";"S";"0523";"         LIREVALPRE LOCA_SJRFDECLNF HJOU_SJRFDECLNF"
"SUIVFJ";"S";"0524";"         SI LOCA_SJRFDECLNF > 0"
"SUIVFJ";"S";"0525";"            SI HJOU_DATE > CONF_SDIDATDEM"
"SUIVFJ";"S";"0526";"               ANOMALIE 263"
"SUIVFJ";"S";"0527";"            FINSI"
"SUIVFJ";"S";"0528";"         FINSI"
"SUIVFJ";"S";"0529";"      FINSI"
"SUIVFJ";"S";"0530";"   FINSI"
"SUIVFJ";"S";"0531";"*"
"SUIVFJ";"S";"0532";"***** Gestion des anomalies >>"
"SUIVFJ";"S";"0533";"*"
"SUIVFJ";"S";"0534";"* Nombre de jours travaillés réel > 235 >>"
"SUIVFJ";"S";"0535";"   SI HJOU_DATE <= TEMP_DATJOU"
"SUIVFJ";"S";"0536";"      SI HJOU_SJRNTRAVC > 235.00"
"SUIVFJ";"S";"0537";"         ANOMALIE 240"
"SUIVFJ";"S";"0538";"      FINSI"
"SUIVFJ";"S";"0539";"   FINSI"
"SUIVFJ";"S";"0540";"*"
"SUIVFJ";"S";"0541";"* Saisie d'une absences qui couvre une consigne XPRES"
"SUIVFJ";"S";"0542";"   SI LOCA_PRES > 0"
"SUIVFJ";"S";"0543";"      SI LOCA_ABS > 0"
"SUIVFJ";"S";"0544";"         SI LOCA_ABSVALO = ""J"""
"SUIVFJ";"S";"0545";"         OU LOCA_PRESVALO = ""J"""
"SUIVFJ";"S";"0546";"            ANOMALIE 262"
"SUIVFJ";"S";"0547";"         FINSI"
"SUIVFJ";"S";"0548";"         SI LOCA_PRESVALO = LOCA_ABSVALO"
"SUIVFJ";"S";"0549";"            ANOMALIE 262"
"SUIVFJ";"S";"0550";"         FINSI"
"SUIVFJ";"S";"0551";"      FINSI"
"SUIVFJ";"S";"0552";"   FINSI"
"SUIVFJ";"S";"0553";"*"
"SUIVFJ";"S";"0554";"FINSI"
"SUIVFJ";"S";"0555";"*"
"SUIVFJ";"S";"0556";"* Consommation des la récup forfait jour >>"
"SUIVFJ";"S";"0557";"*POUR ACTIVITES"
"SUIVFJ";"S";"0558";"* Conso repos FJ"
"SUIVFJ";"S";"0559";"*   SI HABS_MOTIF = ""RECFJ"""
"SUIVFJ";"S";"0560";"*      SI HJOU_IJQPRETHEJ > 0"
"SUIVFJ";"S";"0561";"*         SI HABS_VALORIS = ""J"""
"SUIVFJ";"S";"0562";"*            SI PROF_ABSENM = 0"
"SUIVFJ";"S";"0563";"*            OU PROF_ABSENS = 0"
"SUIVFJ";"S";"0564";"*               LOCA_RECFJ = LOCA_RECFJ + 0.5"
"SUIVFJ";"S";"0565";"*            SINON"
"SUIVFJ";"S";"0566";"*               LOCA_RECFJ = 1"
"SUIVFJ";"S";"0567";"*            FINSI"
"SUIVFJ";"S";"0568";"*         SINON"
"SUIVFJ";"S";"0569";"*            LOCA_RECFJ = LOCA_RECFJ + 0.5"
"SUIVFJ";"S";"0570";"*         FINSI"
"SUIVFJ";"S";"0571";"*      FINSI"
"SUIVFJ";"S";"0572";"*   FINSI"
"SUIVFJ";"S";"0573";"*FINPOUR"
"SUIVFJ";"S";"0574";"*"
"SUIVFJ";"S";"0575";"*SI LOCA_RECFJ > 1"
"SUIVFJ";"S";"0576";"*   LOCA_RECFJ = 1"
"SUIVFJ";"S";"0577";"*FINSI"
"SUIVFJ";"S";"0578";"*"
"SUIVFJ";"S";"0579";"*HJOU_SJRTRAREP = HJOU_SJRTRAREP - LOCA_RECFJ"
"SUIVFJ";"S";"0580";"*"
"SUIVFJ";"S";"0581";"*SI LOCA_RECFJ > 0"
"SUIVFJ";"S";"0582";"*"
"SUIVFJ";"S";"0583";"* Anomalie si solde insufisant"
"SUIVFJ";"S";"0584";"*   SI HJOU_SJRTRAREP < 0"
"SUIVFJ";"S";"0585";"*      ANOMALIE 315"
"SUIVFJ";"S";"0586";"*      SI TEMP_CNMOTIF = ""RECFJ"""
"SUIVFJ";"S";"0587";"*         TEMP_CNRETOUR = 2"
"SUIVFJ";"S";"0588";"*         TEMP_CNMESS = 315"
"SUIVFJ";"S";"0589";"*      FINSI"
"SUIVFJ";"S";"0590";"*   FINSI"
"SUIVFJ";"S";"0591";"*"
"SUIVFJ";"S";"0592";"* Anomalie si pas droit"
"SUIVFJ";"S";"0593";"*   SI LOCA_DROIT <> 1"
"SUIVFJ";"S";"0594";"*      ANOMALIE 316"
"SUIVFJ";"S";"0595";"*      SI TEMP_CNMOTIF = ""RECFJ"""
"SUIVFJ";"S";"0596";"*         TEMP_CNRETOUR = 2"
"SUIVFJ";"S";"0597";"*         TEMP_CNMESS = 316"
"SUIVFJ";"S";"0598";"*      FINSI"
"SUIVFJ";"S";"0599";"*   FINSI"
"SUIVFJ";"S";"0600";"*"
"SUIVFJ";"S";"0601";"*FINSI"
"SUIVFJ";"S";"0602";"*"
"SUIVFJ";"S";"0603";"* Solde global >>"
"SUIVFJ";"S";"0604";"HJOU_SJRSRDECG = HJOU_SJRSRDEC + HJOU_SJRSRDECR"
"SUIVFJ";"S";"0605";"*"
"SUIVFJ";"S";"0606";"***** Gestion des compteurs prévisionnels >>"
"SUIVFJ";"S";"0607";"*"
"SUIVFJ";"S";"0608";"SI CTRA_DATFIN > TEMP_DATJOU"
"SUIVFJ";"S";"0609";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SUIVFJ";"S";"0610";"      SI HJOU_SJQFINC = 1"
"SUIVFJ";"S";"0611";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SUIVFJ";"S";"0612";"         LOCA_DATEFU = TEMP_DXFINPER"
"SUIVFJ";"S";"0613";"      FINSI"
"SUIVFJ";"S";"0614";"   FINSI"
"SUIVFJ";"S";"0615";"FINSI"
"SUIVFJ";"S";"0616";"*"
"SUIVFJ";"S";"0617";"*"
"SUIVFJ";"S";"0618";"* Paiement des jours dépassant la cible"
"SUIVFJ";"S";"0619";"POUR ACTIVITES"
"SUIVFJ";"S";"0620";"   SI HABS_MOTIF = ""YPAIEFJ"""
"SUIVFJ";"S";"0621";"      LOCA_PAIEJF = LOCA_PAIEJF + HABS_MOTINBR"
"SUIVFJ";"S";"0622";"   FINSI"
"SUIVFJ";"S";"0623";"FINPOUR"
"SUIVFJ";"S";"0624";"*"
"SUIVFJ";"S";"0625";"* Droit ?"
"SUIVFJ";"S";"0626";"SI LOCA_PAIEJF > 0"
"SUIVFJ";"S";"0627";"   SI LOCA_DROIT <> 1"
"SUIVFJ";"S";"0628";"      ENLEVER ""YPAIEFJ"""
"SUIVFJ";"S";"0629";"      ENLEVER ""YPAIEFJ"""
"SUIVFJ";"S";"0630";"      LOCA_PAIEJF = 0"
"SUIVFJ";"S";"0631";"   FINSI"
"SUIVFJ";"S";"0632";"FINSI"
"SUIVFJ";"S";"0633";"*"
"SUIVFJ";"S";"0634";"SI LOCA_PAIEJF > 0"
"SUIVFJ";"S";"0635";"   SI HJOU_SJQINSTC <> ""1"""
"SUIVFJ";"S";"0636";"      ANOMALIE 304"
"SUIVFJ";"S";"0637";"      LOCA_PAIEJF = 0"
"SUIVFJ";"S";"0638";"   FINSI"
"SUIVFJ";"S";"0639";"   SI HJOU_DATE(5:4) <> ""1231"""
"SUIVFJ";"S";"0640";"      LOCA_PAIEJF = 0"
"SUIVFJ";"S";"0641";"      ANOMALIE 304"
"SUIVFJ";"S";"0642";"   FINSI"
"SUIVFJ";"S";"0643";"FINSI"
"SUIVFJ";"S";"0644";"*"
"SUIVFJ";"S";"0645";"SI TEMP_DATSUI = LOCA_DATEFU"
"SUIVFJ";"S";"0646";"OU HJOU_SJQFINC = 1"
"SUIVFJ";"S";"0647";"*"
"SUIVFJ";"S";"0648";"   FAIRE ARRONDI"
"SUIVFJ";"S";"0649";"   SI HJOU_SJROBJFJA < 0"
"SUIVFJ";"S";"0650";"      HJOU_SJROBJFJA = 0"
"SUIVFJ";"S";"0651";"   FINSI"
"SUIVFJ";"S";"0652";"*"
"SUIVFJ";"S";"0653";"*"
"SUIVFJ";"S";"0654";"* 27/01/2026-Salim-PBR026003232-D selon pourcentage Temps travail"
"SUIVFJ";"S";"0655";"   DEF LOCA_SJROBJFJA N8.2"
"SUIVFJ";"S";"0656";"   LOCA_SJROBJFJA = HJOU_SJROBJFJA"
"SUIVFJ";"S";"0657";"   SI HJOU_IJITYPCTRA = 0"
"SUIVFJ";"S";"0658";"   OU HJOU_IJITYPCTRA = 100"
"SUIVFJ";"S";"0659";"      HJOU_SJRECARFJA = HJOU_SJRJTRAVT - HJOU_SJROBJFJA"
"SUIVFJ";"S";"0660";"   SINON"
"SUIVFJ";"S";"0661";"      LOCA_SJROBJFJA = LOCA_SJROBJFJA * HJOU_IJITYPCTRA"
"SUIVFJ";"S";"0662";"      LOCA_SJROBJFJA = LOCA_SJROBJFJA / 100"
"SUIVFJ";"S";"0663";"      HJOU_SJROBJFJA = LOCA_SJROBJFJA"
"SUIVFJ";"S";"0664";"     FAIRE ARRONDI"
"SUIVFJ";"S";"0665";"LOCA_SJROBJFJA = HJOU_SJROBJFJA"
"SUIVFJ";"S";"0666";"*"
"SUIVFJ";"S";"0667";"*"
"SUIVFJ";"S";"0668";"      HJOU_SJRECARFJA = HJOU_SJRJTRAVT - LOCA_SJROBJFJA"
"SUIVFJ";"S";"0669";"   FINSI"
"SUIVFJ";"S";"0670";"* 27/01/2026-Salim-PBR026003232-F"
"SUIVFJ";"S";"0671";"*"
"SUIVFJ";"S";"0672";"   HJOU_SJRECARFJA = HJOU_SJRJTRAVT - HJOU_SJROBJFJA"
"SUIVFJ";"S";"0673";"*   HJOU_SJRECARFJA = HJOU_SJRNTRAVC - HJOU_SJRJTRAVT"
"SUIVFJ";"S";"0674";"*"
"SUIVFJ";"S";"0675";"   SI LOCA_PAIEJF > 0"
"SUIVFJ";"S";"0676";"*      SI HJOU_SJQINSTC = ""1"""
"SUIVFJ";"S";"0677";"      SI CTRA_SCIDATSTC = HJOU_DATE"
"SUIVFJ";"S";"0678";"      OU HJOU_DATE(5:4) = ""1231"""
"SUIVFJ";"S";"0679";"         SI LOCA_PAIEJF <= HJOU_SJRECARFJA"
"SUIVFJ";"S";"0680";"            HJOU_SJRECARFJA = HJOU_SJRECARFJA - LOCA_PAIEJF"
"SUIVFJ";"S";"0681";"         SINON"
"SUIVFJ";"S";"0682";"            ANOMALIE 303"
"SUIVFJ";"S";"0683";"         FINSI"
"SUIVFJ";"S";"0684";"      SINON"
"SUIVFJ";"S";"0685";"         ANOMALIE 304"
"SUIVFJ";"S";"0686";"      FINSI"
"SUIVFJ";"S";"0687";"   FINSI"
"SUIVFJ";"S";"0688";"*"
"SUIVFJ";"S";"0689";"   SI HJOU_DATE(1:4) = TEMP_DATJOU(1:4)"
"SUIVFJ";"S";"0690";"*"
"SUIVFJ";"S";"0691";"      EMPL_SEQOBJFJA = HJOU_SJROBJFJA"
"SUIVFJ";"S";"0692";"* 27/01/2026-Salim-PBR026003232-D"
"SUIVFJ";"S";"0693";"      EMPL_SEQOBJFJA = LOCA_SJROBJFJA"
"SUIVFJ";"S";"0694";"* 27/01/2026-Salim-PBR026003232-F"
"SUIVFJ";"S";"0695";"      EMPL_SEQJTRAVT = HJOU_SJRJTRAVT"
"SUIVFJ";"S";"0696";"      EMPL_SEQECARFJA = HJOU_SJRECARFJA"
"SUIVFJ";"S";"0697";"      EMPL_SEQJTREPFJ = HJOU_SJRTRAREP"
"SUIVFJ";"S";"0698";"      EMPL_SEQTCPRTFJ = HJOU_SJRTCPRTFJ"
"SUIVFJ";"S";"0699";"      SI LOCA_DROIT = 1"
"SUIVFJ";"S";"0700";"         SI LOCA_DROICP >= HJOU_SJRCCPAN"
"SUIVFJ";"S";"0701";"            LOCA_SOLDCP = LOCA_DROICP - HJOU_SJRCCPAN"
"SUIVFJ";"S";"0702";"         FINSI"
"SUIVFJ";"S";"0703";"*         SI HJOU_SJQSTC = 1"
"SUIVFJ";"S";"0704";"*            EMPL_SEQCCPFJ = 0"
"SUIVFJ";"S";"0705";"*            EMPL_SEQCRTTFJ = 0"
"SUIVFJ";"S";"0706";"*         SINON"
"SUIVFJ";"S";"0707";"         EMPL_SEQCCPFJ = LOCA_SOLDCP"
"SUIVFJ";"S";"0708";"         EMPL_SEQCRTTFJ = HJOU_IJRSNBJRTT"
"SUIVFJ";"S";"0709";"*         FINSI"
"SUIVFJ";"S";"0710";"         EMPL_SEQECARFJT = EMPL_SEQECARFJA - EMPL_SEQCCPFJ"
"SUIVFJ";"S";"0711";"         EMPL_SEQECARFJT = EMPL_SEQECARFJT - EMPL_SEQCRTTFJ"
"SUIVFJ";"S";"0712";"      SINON"
"SUIVFJ";"S";"0713";"         EMPL_SEQECARFJT = EMPL_SEQECARFJA"
"SUIVFJ";"S";"0714";"      FINSI"
"SUIVFJ";"S";"0715";"*"
"SUIVFJ";"S";"0716";"   FINSI"
"SUIVFJ";"S";"0717";"*"
"SUIVFJ";"S";"0718";"FINSI"
"SUIVFJ";"S";"0719";"*"
"SUIVFJ";"S";"0720";"HJOU_IJRCJDISP1 = EMPL_SEQECARFJA"
"SUIVFJ";"S";"0721";"HJOU_IJRCJDISP2 = EMPL_SEQECARFJT"
"SUIVFJ";"S";"0722";"*"
"SUIVFJ";"S";"0723";"FIN"
"SUIVFJ";"S";"0724";"*"
"SUIVFJ";"S";"0725";"* Arrondi à l'entier le plus proche >>"
"SUIVFJ";"S";"0726";"*"
"SUIVFJ";"S";"0727";"PROC ARRONDI"
"SUIVFJ";"S";"0728";"*"
"SUIVFJ";"S";"0729";"   DEF LOCA_DECIMALE N6.2"
"SUIVFJ";"S";"0730";"   LOCA_DECIMALE = 0"
"SUIVFJ";"S";"0731";"   DEF LOCA_ENTIER N6.2"
"SUIVFJ";"S";"0732";"   LOCA_ENTIER = 0"
"SUIVFJ";"S";"0733";"*"
"SUIVFJ";"S";"0734";"   LOCA_DECIMALE = HJOU_SJROBJFJA % 1"
"SUIVFJ";"S";"0735";"   LOCA_ENTIER = HJOU_SJROBJFJA - LOCA_DECIMALE"
"SUIVFJ";"S";"0736";"   SI LOCA_DECIMALE >= 0.5"
"SUIVFJ";"S";"0737";"      LOCA_ENTIER = LOCA_ENTIER + 1"
"SUIVFJ";"S";"0738";"   FINSI"
"SUIVFJ";"S";"0739";"   HJOU_SJROBJFJA = LOCA_ENTIER"
"SUIVFJ";"S";"0740";"FINPROC"
