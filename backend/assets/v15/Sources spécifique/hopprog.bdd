"SGCALJF";"S";"0026";"*"
"SGCALJF";"S";"0027";"* Implémentation des données industrielles"
"SGCALJF";"S";"0028";"*"
"SGCALJF";"S";"0029";"DEBDICO"
"SGCALJF";"S";"0030";"   TEMP_STQJF;O;A4;X;;;789;;;V3;""Jour férié"";"
"SGCALJF";"S";"0031";"   HJOU_SJITRJF;O;Z1;X;;;        9;L9;;C2;""Travaille sur JF (Portage)"";"
"SGCALJF";"S";"0032";"FINDICO"
"SGCALJF";"S";"0033";"*"
"SGCALJF";"S";"0034";"* Définition des variables locales"
"SGCALJF";"S";"0035";"DEF LOCA_FERIE N2"
"SGCALJF";"S";"0036";"LOCA_FERIE = 0"
"SGCALJF";"S";"0037";"DEF LOCA_JFT N2"
"SGCALJF";"S";"0038";"LOCA_JFT = 0"
"SGCALJF";"S";"0039";"DEF LOCA_JS N2"
"SGCALJF";"S";"0040";"LOCA_JS = 0"
"SGCALJF";"S";"0041";"DEF LOCA_JSL N2"
"SGCALJF";"S";"0042";"LOCA_JSL = 0"
"SGCALJF";"S";"0043";"DEF LOCA_CALEND A6"
"SGCALJF";"S";"0044";"LOCA_CALEND = "" """
"SGCALJF";"S";"0045";"DEF LOCA_JFNUIT N2"
"SGCALJF";"S";"0046";"LOCA_JFNUIT = 0"
"SGCALJF";"S";"0047";"DEF LOCA_HFINPLG T6.2"
"SGCALJF";"S";"0048";"LOCA_HFINPLG = 0"
"SGCALJF";"S";"0049";"DEF LOCA_MJFV N2"
"SGCALJF";"S";"0050";"LOCA_MJFV = 0"
"SGCALJF";"S";"0051";"*"
"SGCALJF";"S";"0052";"*on retire les motifs avant création"
"SGCALJF";"S";"0053";"ENLEVER ""WJF"""
"SGCALJF";"S";"0054";"ENLEVER ""WJF"""
"SGCALJF";"S";"0055";"ENLEVER ""JF"""
"SGCALJF";"S";"0056";"ENLEVER ""JF"""
"SGCALJF";"S";"0057";"ENLEVER ""WJFT"""
"SGCALJF";"S";"0058";"ENLEVER ""WJFT"""
"SGCALJF";"S";"0059";"ENLEVER ""JSOL"""
"SGCALJF";"S";"0060";"ENLEVER ""JSOL"""
"SGCALJF";"S";"0061";"*"
"SGCALJF";"S";"0062";"DEF LOCA_ABSENCEJ N2"
"SGCALJF";"S";"0063";"LOCA_ABSENCEJ = 0"
"SGCALJF";"S";"0064";"*"
"SGCALJF";"S";"0065";"DEF LOCA_ABSENJ T6.2"
"SGCALJF";"S";"0066";"LOCA_ABSENJ = PROF_ABSENJ"
"SGCALJF";"S";"0067";"DEF LOCA_ABSENM T6.2"
"SGCALJF";"S";"0068";"LOCA_ABSENM = PROF_ABSENM"
"SGCALJF";"S";"0069";"DEF LOCA_ABSENS T6.2"
"SGCALJF";"S";"0070";"LOCA_ABSENS = PROF_ABSENS"
"SGCALJF";"S";"0071";"*"
"SGCALJF";"S";"0072";"* On regarde si absence en jour ?"
"SGCALJF";"S";"0073";"POUR ACTIVITES"
"SGCALJF";"S";"0074";"   SI HABS_MOTYPE <> ""C"""
"SGCALJF";"S";"0075";"      SI HABS_VALORIS = ""J"""
"SGCALJF";"S";"0076";"         LOCA_ABSENCEJ = 1"
"SGCALJF";"S";"0077";"      FINSI"
"SGCALJF";"S";"0078";"   FINSI"
"SGCALJF";"S";"0079";"FINPOUR"
"SGCALJF";"S";"0080";"*"
"SGCALJF";"S";"0081";"SI PROF_PRETHEO < 0.02"
"SGCALJF";"S";"0082";"   LOCA_ABSENCEJ = 1"
"SGCALJF";"S";"0083";"FINSI"
"SGCALJF";"S";"0084";"*"
"SGCALJF";"S";"0085";"* GCF - Valorisation de paie particulière pour les journalistes >>"
"SGCALJF";"S";"0086";"*"
"SGCALJF";"S";"0087";"SI PROF_PRETHEO > 0.02"
"SGCALJF";"S";"0088";"   SI HJOU_SJQCATEGOR = ""J"""
"SGCALJF";"S";"0089";"      SI HJOU_SJQFORFJR <> ""1"""
"SGCALJF";"S";"0090";"         SI HORC_SHIHOREF > 0.00"
"SGCALJF";"S";"0091";"* Profil de la rédaction"
"SGCALJF";"S";"0092";"            SI HJOU_PROFIL(1:3) = ""RED"""
"SGCALJF";"S";"0093";"               LOCA_ABSENM = HORC_SHIHOREF / 2"
"SGCALJF";"S";"0094";"               LOCA_ABSENS = HORC_SHIHOREF / 2"
"SGCALJF";"S";"0095";"               LOCA_ABSENJ = HORC_SHIHOREF"
"SGCALJF";"S";"0096";"            FINSI"
"SGCALJF";"S";"0097";"         FINSI"
"SGCALJF";"S";"0098";"      FINSI"
"SGCALJF";"S";"0099";"   FINSI"
"SGCALJF";"S";"0100";"FINSI"
"SGCALJF";"S";"0101";"*"
"SGCALJF";"S";"0102";"* GCF - <<"
"SGCALJF";"S";"0103";"*"
"SGCALJF";"S";"0104";"* on génère le férié par réglementaire"
"SGCALJF";"S";"0105";"* les jours Français pour tout le monde"
"SGCALJF";"S";"0106";"CALENDRIER ""JF"""
"SGCALJF";"S";"0107";"SI TEMP_CALEND = ""JF"""
"SGCALJF";"S";"0108";"   LOCA_FERIE = 1"
"SGCALJF";"S";"0109";"   TEMP_STQJF = ""JJF"""
"SGCALJF";"S";"0110";"FINSI"
"SGCALJF";"S";"0111";"* Veille de JF"
"SGCALJF";"S";"0112";"SI TEMP_CALENDSUI = ""JF"""
"SGCALJF";"S";"0113";"   SI TEMP_STQJF <> ""JJF"""
"SGCALJF";"S";"0114";"      TEMP_STQJF = ""VJF"""
"SGCALJF";"S";"0115";"   FINSI"
"SGCALJF";"S";"0116";"FINSI"
"SGCALJF";"S";"0117";"* Lendemain de JF"
