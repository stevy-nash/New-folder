"IECART";"S";"0028";"*"
"IECART";"S";"0029";"DEBDICO"
"IECART";"S";"0030";"   HJOU_IJQECARTHE;N;T6,2;I;;;    56789;;;V3;""Ecart hebdo / horaire de référence"";"
"IECART";"S";"0031";"   PARD_IDIVHORCOH;O;T6,2;I;;;123456789;;;C2;""Horaire hebdo temps plein"";"
"IECART";"S";"0032";"FINDICO"
"IECART";"S";"0033";"*"
"IECART";"S";"0034";"**********************************************************************"
"IECART";"S";"0035";"*"
"IECART";"S";"0036";"* Déclaration des donnees locales"
"IECART";"S";"0037";"*"
"IECART";"S";"0038";"SI HJOU_JOUR = ""7"""
"IECART";"S";"0039";"   HJOU_IJQECARTHE = HJOU_IJRTTEFFEH - PARD_IDIVHORCOH"
"IECART";"S";"0040";"FINSI"
"IECART";"S";"0041";"FIN"
