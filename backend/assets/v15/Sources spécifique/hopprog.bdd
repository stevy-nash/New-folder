"SECRET";"S";"0007";"*----------------------------------------------------------------------"
"SECRET";"S";"0008";"*"
"SECRET";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SECRET";"S";"0010";"* Date     : 03/09/2009"
"SECRET";"S";"0011";"* Version  : 1"
"SECRET";"S";"0012";"*"
"SECRET";"S";"0013";"*----------------------------------------------------------------------"
"SECRET";"S";"0014";"*"
"SECRET";"S";"0015";"*"
"SECRET";"S";"0016";"* Rôle : Ecretement journalier"
"SECRET";"S";"0017";"*"
"SECRET";"S";"0018";"*"
"SECRET";"S";"0019";"*"
"SECRET";"S";"0020";"*"
"SECRET";"S";"0021";"*----------------------------------------------------------------------"
"SECRET";"S";"0022";"*"
"SECRET";"S";"0023";"* Modifiée par :"
"SECRET";"S";"0024";"* Date         : JJ/MM/AAAA"
"SECRET";"S";"0025";"* Objet        :"
"SECRET";"S";"0026";"*"
"SECRET";"S";"0027";"***********************************************************************"
"SECRET";"S";"0028";"*"
"SECRET";"S";"0029";"* Implémentation des données industrielles"
"SECRET";"S";"0030";"*"
"SECRET";"S";"0031";"DEBDICO"
"SECRET";"S";"0032";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"SECRET";"S";"0033";"   HJOU_IJQPRESBAV;N;T6,2;I;;;    56789;;;V3;""Présence badgée validée"";"
"SECRET";"S";"0034";"   *   HJOU_IJQHECRETJ;N;T6,2;I;;;    56789;;;V3;""Heures écrêtées"";"
"SECRET";"S";"0035";"FINDICO"
"SECRET";"S";"0036";"*"
"SECRET";"S";"0037";"DEBANO"
"SECRET";"S";"0038";"   105;4;""Ecrétage de la présence du jour"";"
"SECRET";"S";"0039";"   117;6;""Présence inférieure au minimum"";"
"SECRET";"S";"0040";"FINANO"
"SECRET";"S";"0041";"* Déclaration des donnees locales"
"SECRET";"S";"0042";"*"
"SECRET";"S";"0043";"DEF LOCA_ANO N1"
"SECRET";"S";"0044";"LOCA_ANO = 0"
"SECRET";"S";"0045";"*"
"SECRET";"S";"0046";"DEF LOCA_PREMAXI T6.2"
"SECRET";"S";"0047";"LOCA_PREMAXI = PROF_PREMAXI"
"SECRET";"S";"0048";"*"
"SECRET";"S";"0049";"* Gestion exception pour PORTAGE"
"SECRET";"S";"0050";"SI HJOU_SJQSOCIETE = ""PO"""
"SECRET";"S";"0051";"   LOCA_PREMAXI = 8.00"
"SECRET";"S";"0052";"FINSI"
"SECRET";"S";"0053";"*"
"SECRET";"S";"0054";"*  Presence > au maximum"
"SECRET";"S";"0055";"*  Ecretage uniquement sur la pr?sence journali?re"
"SECRET";"S";"0056";"SI LOCA_PREMAXI > 0"
"SECRET";"S";"0057";"   SI HJOU_IJQBHORVAJ > LOCA_PREMAXI"
"SECRET";"S";"0058";"      ANOMALIE 116"
"SECRET";"S";"0059";"   FINSI"
"SECRET";"S";"0060";"FINSI"
"SECRET";"S";"0061";"*  Presence < au minimum"
"SECRET";"S";"0062";"SI PROF_PREMINI > 0"
"SECRET";"S";"0063";"   SI HJOU_IJQBHORVAJ < PROF_PREMINI"
"SECRET";"S";"0064";"      POUR ACTIVITES"
"SECRET";"S";"0065";"         SI HABS_MOTYPE <> ""C"""
"SECRET";"S";"0066";"            SI HABS_VALORIS = ""J"""
"SECRET";"S";"0067";"               LOCA_ANO = 1"
"SECRET";"S";"0068";"            FINSI"
"SECRET";"S";"0069";"         FINSI"
"SECRET";"S";"0070";"      FINPOUR"
"SECRET";"S";"0071";"      SI LOCA_ANO = 0"
"SECRET";"S";"0072";"         ANOMALIE 117"
"SECRET";"S";"0073";"      FINSI"
"SECRET";"S";"0074";"   FINSI"
"SECRET";"S";"0075";"FINSI"
"SECRET";"S";"0076";"*  ecretement de la presence point?e valid?e"
"SECRET";"S";"0077";"SI HJOU_IJQPRESBAV > PROF_ECRJOU"
"SECRET";"S";"0078";"   HJOU_IJQPRESBAV = PROF_ECRJOU"
"SECRET";"S";"0079";"FINSI"
"SECRET";"S";"0080";"*  Ecretement des heures totales"
"SECRET";"S";"0081";"SI HJOU_IJQBHORVAJ > PROF_ECRJOU"
"SECRET";"S";"0082";"*   HJOU_IJQHECRETJ = HJOU_IJQBHORVAJ - PROF_ECRJOU"
"SECRET";"S";"0083";"   HJOU_IJQBHORVAJ = PROF_ECRJOU"
"SECRET";"S";"0084";"   ANOMALIE 105"
"SECRET";"S";"0085";"FINSI"
"SECRET";"S";"0086";"FIN"
"SENFMALADE";"S";"0001";"**********************************************************************"
"SENFMALADE";"S";"0002";"*"
"SENFMALADE";"S";"0003";"* Règle : SENFMALADE"
"SENFMALADE";"S";"0004";"* Ordre : 8025"
"SENFMALADE";"S";"0005";"* Titre : GCF : Congés enfant malade"
"SENFMALADE";"S";"0006";"*"
"SENFMALADE";"S";"0007";"*----------------------------------------------------------------------"
"SENFMALADE";"S";"0008";"*"
"SENFMALADE";"S";"0009";"* Créé par : Jérémy Jacquot"
"SENFMALADE";"S";"0010";"* Date     : 19/05/2025"
"SENFMALADE";"S";"0011";"*----------------------------------------------------------------------"
"SENFMALADE";"S";"0012";"*"
"SENFMALADE";"S";"0013";"*"
"SENFMALADE";"S";"0014";"* Rôle :"
"SENFMALADE";"S";"0015";"*"
"SENFMALADE";"S";"0016";"* Attribution de congés pour enfant malade"
"SENFMALADE";"S";"0017";"*"
"SENFMALADE";"S";"0018";"DEBDICO"
"SENFMALADE";"S";"0019";"   HJOU_IJRSCENFMA;N;N6,1;I;;;    56789;;IJRSCENFMA;V3;""Solde congé enfant malade"";"
"SENFMALADE";"S";"0020";"   PARD_IDISENFMA1;O;N2;I;;;123456789;;;C2;""Seuil 1 âge enfant malade"";"
"SENFMALADE";"S";"0021";"   *   PARD_IDISENFMA3;O;N2;I;;;123456789;;;C2;""Seuil 2 âge enfant malade"";"
"SENFMALADE";"S";"0022";"   PARD_IDIENFMAL1;O;N3,1;I;;;123456789;;;C2;""Droit enfant malade"";"
"SENFMALADE";"S";"0023";"   PARD_IDIENFMAL2;O;N3,1;I;;;123456789;;;C2;""Droit enfant malade 2 enfant et plus"";"
"SENFMALADE";"S";"0024";"FINDICO"
"SENFMALADE";"S";"0025";"*"
"SENFMALADE";"S";"0026";"DEBANO"
"SENFMALADE";"S";"0027";"   184;9;""Solde congés enfant malade insuffisant"";"
"SENFMALADE";"S";"0028";"   193;9;""Droit enfant malade supérieur au maximum"";"
"SENFMALADE";"S";"0029";"FINANO"
"SENFMALADE";"S";"0030";"*"
"SENFMALADE";"S";"0031";"* Déclaration des donnees locales"
"SENFMALADE";"S";"0032";"*"
"SENFMALADE";"S";"0033";"*"
"SENFMALADE";"S";"0034";"*"
"SENFMALADE";"S";"0035";"DEF LOCA_NBENF N2"
"SENFMALADE";"S";"0036";"LOCA_NBENF = 0"
"SENFMALADE";"S";"0037";"DEF LOCA_DROIT N2"
"SENFMALADE";"S";"0038";"LOCA_DROIT = 0"
"SENFMALADE";"S";"0039";"DEF LOCA_VAL N2.1"
"SENFMALADE";"S";"0040";"LOCA_VAL = 0"
"SENFMALADE";"S";"0041";"*"
"SENFMALADE";"S";"0042";"* Attribution du droit au 01/01"
"SENFMALADE";"S";"0043";"*"
"SENFMALADE";"S";"0044";"SI HJOU_DATE(5:4) = ""0101"""
"SENFMALADE";"S";"0045";"OU HJOU_DATE(1:8) = ""20250601"""
"SENFMALADE";"S";"0046";"*"
"SENFMALADE";"S";"0047";"* Nombre d'enfants"
"SENFMALADE";"S";"0048";"   POUR ENFANTS"
"SENFMALADE";"S";"0049";"      SI ENFT_ENFACHARGE = ""1"""
"SENFMALADE";"S";"0050";"         DATDIFF ENFT_ENFDATENAI 12 HJOU_DATE 12"
"SENFMALADE";"S";"0051";"* Nombres enfants à charge de moins de 12 ans"
"SENFMALADE";"S";"0052";"         SI TEMP_NXANNEE < PARD_IDISENFMA1"
"SENFMALADE";"S";"0053";"            LOCA_NBENF = LOCA_NBENF + 1"
"SENFMALADE";"S";"0054";"         FINSI"
"SENFMALADE";"S";"0055";"      FINSI"
"SENFMALADE";"S";"0056";"   FINPOUR"
"SENFMALADE";"S";"0057";"*"
"SENFMALADE";"S";"0058";"   SI LOCA_NBENF > 0"
"SENFMALADE";"S";"0059";"      SI LOCA_NBENF >= 2"
"SENFMALADE";"S";"0060";"         LOCA_DROIT = PARD_IDIENFMAL2"
"SENFMALADE";"S";"0061";"      SINON"
"SENFMALADE";"S";"0062";"         LOCA_DROIT = PARD_IDIENFMAL1"
"SENFMALADE";"S";"0063";"      FINSI"
"SENFMALADE";"S";"0064";"   FINSI"
"SENFMALADE";"S";"0065";"*"
"SENFMALADE";"S";"0066";"* Alimentation du compteur"
"SENFMALADE";"S";"0067";"   HJOU_IJRSCENFMA = LOCA_DROIT"
"SENFMALADE";"S";"0068";"FINSI"
"SENFMALADE";"S";"0069";"*"
"SENFMALADE";"S";"0070";"* alimentation par consignes"
"SENFMALADE";"S";"0071";"POUR ACTIVITES"
"SENFMALADE";"S";"0072";"   SI HABS_MOTIF = ""ZCENF"""
"SENFMALADE";"S";"0073";"      HJOU_IJRSCENFMA = HABS_MOTINBR"
"SENFMALADE";"S";"0074";"   FINSI"
"SENFMALADE";"S";"0075";"   SI HABS_MOTIF = ""XCENF"""
"SENFMALADE";"S";"0076";"      HJOU_IJRSCENFMA = HJOU_IJRSCENFMA + HABS_MOTINBR"
"SENFMALADE";"S";"0077";"   FINSI"
"SENFMALADE";"S";"0078";"FINPOUR"
"SENFMALADE";"S";"0079";"*"
"SENFMALADE";"S";"0080";"* Contrôle du droit maximum"
"SENFMALADE";"S";"0081";"*"
"SENFMALADE";"S";"0082";"SI HJOU_IJRSCENFMA > PARD_IDIENFMAL2"
"SENFMALADE";"S";"0083";"   ANOMALIE 193"
"SENFMALADE";"S";"0084";"FINSI"
"SENFMALADE";"S";"0085";"*"
"SENFMALADE";"S";"0086";"* Gestion du pris"
"SENFMALADE";"S";"0087";"POUR ACTIVITES"
"SENFMALADE";"S";"0088";"   SI HJOU_IJQPRETHEJ > 0"
"SENFMALADE";"S";"0089";"      SI HABS_MOTIF = ""JEM"""
"SENFMALADE";"S";"0090";"         SI HABS_VALORIS = ""J"""
"SENFMALADE";"S";"0091";"            SI PROF_ABSENM = 0"
"SENFMALADE";"S";"0092";"            OU PROF_ABSENS = 0"
"SENFMALADE";"S";"0093";"               LOCA_VAL = LOCA_VAL + 0.5"
"SENFMALADE";"S";"0094";"            SINON"
"SENFMALADE";"S";"0095";"               LOCA_VAL = LOCA_VAL + 1"
"SENFMALADE";"S";"0096";"            FINSI"
"SENFMALADE";"S";"0097";"         SINON"
"SENFMALADE";"S";"0098";"            LOCA_VAL = LOCA_VAL + 0.5"
"SENFMALADE";"S";"0099";"         FINSI"
"SENFMALADE";"S";"0100";"      FINSI"
"SENFMALADE";"S";"0101";"   FINSI"
"SENFMALADE";"S";"0102";"FINPOUR"
"SENFMALADE";"S";"0103";"*"
"SENFMALADE";"S";"0104";"SI LOCA_VAL > 1"
"SENFMALADE";"S";"0105";"   LOCA_VAL = 1"
"SENFMALADE";"S";"0106";"FINSI"
"SENFMALADE";"S";"0107";"*"
"SENFMALADE";"S";"0108";"HJOU_IJRSCENFMA = HJOU_IJRSCENFMA - LOCA_VAL"
"SENFMALADE";"S";"0109";"*"
"SENFMALADE";"S";"0110";"* Gestion anomalie >>"
"SENFMALADE";"S";"0111";"*"
"SENFMALADE";"S";"0112";"SI LOCA_VAL > 0"
"SENFMALADE";"S";"0113";"   SI HJOU_IJRSCENFMA < 0"
"SENFMALADE";"S";"0114";"      ANOMALIE 184"
"SENFMALADE";"S";"0115";"      SI TEMP_CNMOTIF = ""JEM"""
"SENFMALADE";"S";"0116";"         TEMP_CNRETOUR = 2"
"SENFMALADE";"S";"0117";"         TEMP_CNMESS = 184"
"SENFMALADE";"S";"0118";"      FINSI"
"SENFMALADE";"S";"0119";"   FINSI"
"SENFMALADE";"S";"0120";"FINSI"
"SENFMALADE";"S";"0121";"*"
"SENFMALADE";"S";"0122";"FIN"
"SFERIE";"S";"0001";"***********************************************************************"
"SFERIE";"S";"0002";"*"
"SFERIE";"S";"0003";"* Règle : SFERIE"
"SFERIE";"S";"0004";"* Ordre : 6045"
"SFERIE";"S";"0005";"* Titre : GCF : Calcul des hrs travaillées fériées"
"SFERIE";"S";"0006";"*"
"SFERIE";"S";"0007";"*----------------------------------------------------------------------"
"SFERIE";"S";"0008";"*"
"SFERIE";"S";"0009";"* Créé par : Jérémy Jacquot"
"SFERIE";"S";"0010";"* Date     : 04/02/2025"
"SFERIE";"S";"0011";"* Version  : 1"
"SFERIE";"S";"0012";"*"
"SFERIE";"S";"0013";"*----------------------------------------------------------------------"
"SFERIE";"S";"0014";"*"
"SFERIE";"S";"0015";"*"
"SFERIE";"S";"0016";"* Rôle : Calcul des heures travaillees feriees"
"SFERIE";"S";"0017";"*"
"SFERIE";"S";"0018";"*"
"SFERIE";"S";"0019";"*----------------------------------------------------------------------"
"SFERIE";"S";"0020";"*"
"SFERIE";"S";"0021";"* Modifiée par :"
"SFERIE";"S";"0022";"* Date         :"
"SFERIE";"S";"0023";"* Objet        :"
"SFERIE";"S";"0024";"*"
"SFERIE";"S";"0025";"*"
"SFERIE";"S";"0026";"***********************************************************************"
"SFERIE";"S";"0027";"*"
"SFERIE";"S";"0028";"* Implémentation des données industrielles"
"SFERIE";"S";"0029";"*"
"SFERIE";"S";"0030";"DEBDICO"
"SFERIE";"S";"0031";"   HJOU_IJQHJFTRAV;N;T6,2;I;;;    56789;;;V3;""Jour férié travaillé"";"
"SFERIE";"S";"0032";"   *"
"SFERIE";"S";"0033";"   HJOU_SJQJJF;N;N2;I;;;     6789;;;V3;""MO : Maint -Jour férié trav. (5335)"";"
"SFERIE";"S";"0034";"   HJOU_SJQHJF;N;T6,2;I;;;     6789;;;V3;""Heures de fériés (0356)"";"
"SFERIE";"S";"0035";"   HJOU_SJQHJF1;N;T6,2;I;;;     6789;;;V3;""Heures de fériés 1° mai (0357)"";"
"SFERIE";"S";"0036";"   HJOU_SJRHDIF100;N;T6,2;I;;;     6789;;SJRHDIF100;V3;""EV/PE : Cumul majo. hrs diman/Férié"";"
"SFERIE";"S";"0037";"FINDICO"
"SFERIE";"S";"0038";"*"
"SFERIE";"S";"0039";"* Déclaration des donnees locales"
"SFERIE";"S";"0040";"*"
"SFERIE";"S";"0041";"* Stockage des heures ferié totales pour contrôle par"
"SFERIE";"S";"0042";"* rapport à l'écrêtage de la présence"
"SFERIE";"S";"0043";"*"
"SFERIE";"S";"0044";"* Motif JF"
"SFERIE";"S";"0045";"DEF LOCA_MJF N2"
"SFERIE";"S";"0046";"LOCA_MJF = 0"
"SFERIE";"S";"0047";"DEF LOCA_FERI T6.2"
"SFERIE";"S";"0048";"LOCA_FERI = 0"
"SFERIE";"S";"0049";"DEF LOCA_JSOL N2"
"SFERIE";"S";"0050";"LOCA_JSOL = 0"
"SFERIE";"S";"0051";"* Temporaire"
"SFERIE";"S";"0052";"DEF LOCA_FERIT T6.2"
"SFERIE";"S";"0053";"LOCA_FERIT = 0"
"SFERIE";"S";"0054";"DEF LOCA_RETIRE N2"
"SFERIE";"S";"0055";"LOCA_RETIRE = 0"
"SFERIE";"S";"0056";"DEF LOCA_JF N2"
"SFERIE";"S";"0057";"LOCA_JF = 0"
"SFERIE";"S";"0058";"DEF LOCA_VEILLEJF N2"
"SFERIE";"S";"0059";"LOCA_VEILLEJF = 0"
"SFERIE";"S";"0060";"DEF LOCA_HFCAP T6.2"
"SFERIE";"S";"0061";"LOCA_HFCAP = 0"
"SFERIE";"S";"0062";"DEF LOCA_HFMAX T6.2"
"SFERIE";"S";"0063";"LOCA_HFMAX = 6.30"
"SFERIE";"S";"0064";"DEF LOCA_NBCYCLE N2"
"SFERIE";"S";"0065";"LOCA_NBCYCLE = 0"
"SFERIE";"S";"0066";"*"
"SFERIE";"S";"0067";"DEF LOCA_INTAST T6.2"
"SFERIE";"S";"0068";"LOCA_INTAST = 0"
"SFERIE";"S";"0069";"*"
"SFERIE";"S";"0070";"* Mode ce calcul des hrs de JF par défaut valeur à 1"
"SFERIE";"S";"0071";"* 1 = minuit à minuit / 2 = début de poste sur JF / 3 = fin de poste sur JF"
"SFERIE";"S";"0072";"DEF LOCA_MODECALC N2"
"SFERIE";"S";"0073";"LOCA_MODECALC = 1"
"SFERIE";"S";"0074";"*"
"SFERIE";"S";"0075";"DEF LOCA_MVTE T6.2"
"SFERIE";"S";"0076";"LOCA_MVTE = 0"
"SFERIE";"S";"0077";"DEF LOCA_MVTS T6.2"
"SFERIE";"S";"0078";"LOCA_MVTS = 0"
"SFERIE";"S";"0079";"DEF LOCA_MVTEV T6.2"
"SFERIE";"S";"0080";"LOCA_MVTEV = 0"
"SFERIE";"S";"0081";"DEF LOCA_MVTSV T6.2"
"SFERIE";"S";"0082";"LOCA_MVTSV = 0"
"SFERIE";"S";"0083";"DEF LOCA_MOTE T6.2"
"SFERIE";"S";"0084";"LOCA_MOTE = 0"
"SFERIE";"S";"0085";"DEF LOCA_MOTS T6.2"
"SFERIE";"S";"0086";"LOCA_MOTS = 0"
"SFERIE";"S";"0087";"DEF LOCA_ABSFER T6.2"
"SFERIE";"S";"0088";"LOCA_ABSFER = 0"
"SFERIE";"S";"0089";"DEF LOCA_DEBFER T6.2"
"SFERIE";"S";"0090";"LOCA_DEBFER = 0"
"SFERIE";"S";"0091";"DEF LOCA_FINFER T6.2"
"SFERIE";"S";"0092";"LOCA_FINFER = 24.00"
"SFERIE";"S";"0093";"* Permet d'éviter plusieurs calculs d'heures de JF en cas de problème de param."
"SFERIE";"S";"0094";"DEF LOCA_CALC N2"
"SFERIE";"S";"0095";"LOCA_CALC = 0"
"SFERIE";"S";"0096";"*"
"SFERIE";"S";"0097";"DEF LOCA_DROIT N2"
"SFERIE";"S";"0098";"LOCA_DROIT = 0"
"SFERIE";"S";"0099";"*"
"SFERIE";"S";"0100";"* Autorise calcul dans le futur"
"SFERIE";"S";"0101";"DEF LOCA_CALCF N2"
"SFERIE";"S";"0102";"LOCA_CALCF = 0"
"SFERIE";"S";"0103";"*"
"SFERIE";"S";"0104";"SI HJOU_DATE <= TEMP_DATJOU"
"SFERIE";"S";"0105";"   LOCA_CALCF = 1"
"SFERIE";"S";"0106";"FINSI"
"SFERIE";"S";"0107";"*"
"SFERIE";"S";"0108";"SI CTRA_SCISOCIETE = ""EV"""
"SFERIE";"S";"0109";"OU CTRA_SCISOCIETE = ""PE"""
"SFERIE";"S";"0110";"   SI CTRA_SCIFORFJ <> ""1"""
"SFERIE";"S";"0111";"      LOCA_CALCF = 1"
"SFERIE";"S";"0112";"   FINSI"
"SFERIE";"S";"0113";"FINSI"
"SFERIE";"S";"0114";"*"
"SFERIE";"S";"0115";"* Exclut cadre et FJ >>"
"SFERIE";"S";"0116";"SI HJOU_SJQFORFJR <> ""1"""
"SFERIE";"S";"0117";"*   SI HJOU_SJQCATEGOR <> ""C"""
"SFERIE";"S";"0118";"   LOCA_DROIT = 1"
"SFERIE";"S";"0119";"*   FINSI"
"SFERIE";"S";"0120";"FINSI"
"SFERIE";"S";"0121";"*"
"SFERIE";"S";"0122";"* Inclut les journalistes"
"SFERIE";"S";"0123";"SI HJOU_SJQCATEGOR = ""J"""
"SFERIE";"S";"0124";"   LOCA_DROIT = 1"
"SFERIE";"S";"0125";"FINSI"
"SFERIE";"S";"0126";"*"
"SFERIE";"S";"0127";"* Temps intervention Astreintes >>"
"SFERIE";"S";"0128";"*"
"SFERIE";"S";"0129";"POUR ACTIVITES"
"SFERIE";"S";"0130";"   SI HABS_MOTIF = PARD_SDIVMINTA"
"SFERIE";"S";"0131";"      LOCA_INTAST = LOCA_INTAST + HABS_MOTIDUR"
"SFERIE";"S";"0132";"   FINSI"
"SFERIE";"S";"0133";"FINPOUR"
"SFERIE";"S";"0134";"*"
"SFERIE";"S";"0135";"* Supprime chevauchement"
"SFERIE";"S";"0136";"LOCA_INTAST = LOCA_INTAST - TEMP_STCHEVTTE"
"SFERIE";"S";"0137";"*"
"SFERIE";"S";"0138";"***** Init variable locale >> **********************************************************************"
"SFERIE";"S";"0139";"*"
"SFERIE";"S";"0140";"* Jour férié ?"
"SFERIE";"S";"0141";"SI TEMP_STQJF = ""JJF"""
"SFERIE";"S";"0142";"   LOCA_JF = 1"
"SFERIE";"S";"0143";"FINSI"
"SFERIE";"S";"0144";"* Veille de jour férié ?"
"SFERIE";"S";"0145";"SI TEMP_STQJF = ""VJF"""
"SFERIE";"S";"0146";"   LOCA_VEILLEJF = 1"
"SFERIE";"S";"0147";"FINSI"
"SFERIE";"S";"0148";"* Motif JF ?"
"SFERIE";"S";"0149";"POUR ACTIVITES"
"SFERIE";"S";"0150";"   SI HABS_MOTIF = ""JF"""
"SFERIE";"S";"0151";"      LOCA_MJF = 1"
"SFERIE";"S";"0152";"   FINSI"
"SFERIE";"S";"0153";"   SI HABS_MOTIF = ""JSOL"""
"SFERIE";"S";"0154";"      LOCA_JSOL = 1"
"SFERIE";"S";"0155";"   FINSI"
"SFERIE";"S";"0156";"FINPOUR"
"SFERIE";"S";"0157";"*"
"SFERIE";"S";"0158";"* Gestion de l'appreciation des heures de fériées spécifiques différant par défaut (minuit à minuit)"
"SFERIE";"S";"0159";"*"
"SFERIE";"S";"0160";"* Si Journaliste"
"SFERIE";"S";"0161";"SI HJOU_SJQCATEGOR = ""J"""
"SFERIE";"S";"0162";"* Gestion début de poste"
"SFERIE";"S";"0163";"   LOCA_MODECALC = 2"
"SFERIE";"S";"0164";"FINSI"
"SFERIE";"S";"0165";"*"
"SFERIE";"S";"0166";"* Si Industrie"
"SFERIE";"S";"0167";"SI HJOU_SECTORI(1:3) = ""DIN"""
"SFERIE";"S";"0168";"   SI HJOU_SJQSOCIETE = ""MO"""
"SFERIE";"S";"0169";"   OU HJOU_SJQSOCIETE = ""YR"""
"SFERIE";"S";"0170";"* Gestion à fin de poste"
"SFERIE";"S";"0171";"      LOCA_MODECALC = 3"
"SFERIE";"S";"0172";"   FINSI"
"SFERIE";"S";"0173";"FINSI"
"SFERIE";"S";"0174";"*"
"SFERIE";"S";"0175";"***** Calcul des heures de fériées >> **************************************************************"
"SFERIE";"S";"0176";"*"
"SFERIE";"S";"0177";"* SI HJOU_DATE <= TEMP_DATJOU"
"SFERIE";"S";"0178";"SI LOCA_CALCF = 1"
"SFERIE";"S";"0179";"   SI LOCA_JF = 1"
"SFERIE";"S";"0180";"*"
"SFERIE";"S";"0181";"* Cas 1 : Calcul de minuit à minuit >> *************************************************************"
"SFERIE";"S";"0182";"      SI LOCA_MODECALC = 1"
"SFERIE";"S";"0183";"         LOCA_FERI = HJOU_IJRPREVEIL"
"SFERIE";"S";"0184";"         LOCA_FERI = LOCA_FERI + HJOU_SJQPREJENC"
"SFERIE";"S";"0185";"      FINSI"
"SFERIE";"S";"0186";"*"
"SFERIE";"S";"0187";"* Cas 2 : Calcul en début de poste >> **************************************************************"
"SFERIE";"S";"0188";"      SI LOCA_MODECALC = 2"
"SFERIE";"S";"0189";"         LOCA_FERI = HJOU_IJQTTEFFEJ"
"SFERIE";"S";"0190";"         SI HJOU_DATE > TEMP_DATJOU"
"SFERIE";"S";"0191";"            LOCA_FERI = HJOU_IJQPLGTOTJ"
"SFERIE";"S";"0192";"         FINSI"
"SFERIE";"S";"0193";"      FINSI"
"SFERIE";"S";"0194";"*"
"SFERIE";"S";"0195";"* Cas 3 : Calcul en fin de poste >> ****************************************************************"
"SFERIE";"S";"0196";"      SI LOCA_MODECALC = 3"
"SFERIE";"S";"0197";"*"
"SFERIE";"S";"0198";"* Travail la veille ?"
"SFERIE";"S";"0199";"         SI HJOU_IJRPREVEIL > 0"
"SFERIE";"S";"0200";"*"
"SFERIE";"S";"0201";"* Ajoutes les heures à cheval sur le JF et la veille"
"SFERIE";"S";"0202";"*"
"SFERIE";"S";"0203";"* Mouvement de la veille 1"
"SFERIE";"S";"0204";"            LIREVALPRE LOCA_MVTEV HJOU_SJQHTENT1"
"SFERIE";"S";"0205";"            LOCA_MVTE = LOCA_MVTEV"
"SFERIE";"S";"0206";"            LIREVALPRE LOCA_MVTSV HJOU_SJQHTSOR1"
"SFERIE";"S";"0207";"            LOCA_MVTS = LOCA_MVTSV"
"SFERIE";"S";"0208";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0209";"               LOCA_RETIRE = 0"
"SFERIE";"S";"0210";"               FAIRE CALC2"
"SFERIE";"S";"0211";"            FINSI"
"SFERIE";"S";"0212";"* Mouvement de la veille 2"
"SFERIE";"S";"0213";"            LIREVALPRE LOCA_MVTEV HJOU_SJQHTENT2"
"SFERIE";"S";"0214";"            LOCA_MVTE = LOCA_MVTEV"
"SFERIE";"S";"0215";"            LIREVALPRE LOCA_MVTSV HJOU_SJQHTSOR2"
"SFERIE";"S";"0216";"            LOCA_MVTS = LOCA_MVTSV"
"SFERIE";"S";"0217";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0218";"               LOCA_RETIRE = 0"
"SFERIE";"S";"0219";"               FAIRE CALC2"
"SFERIE";"S";"0220";"            FINSI"
"SFERIE";"S";"0221";"* Mouvement de la veille 3"
"SFERIE";"S";"0222";"            LIREVALPRE LOCA_MVTEV HJOU_SJQHTENT3"
"SFERIE";"S";"0223";"            LOCA_MVTE = LOCA_MVTEV"
"SFERIE";"S";"0224";"            LIREVALPRE LOCA_MVTSV HJOU_SJQHTSOR3"
"SFERIE";"S";"0225";"            LOCA_MVTS = LOCA_MVTSV"
"SFERIE";"S";"0226";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0227";"               LOCA_RETIRE = 0"
"SFERIE";"S";"0228";"               FAIRE CALC2"
"SFERIE";"S";"0229";"            FINSI"
"SFERIE";"S";"0230";"* Mouvement de la veille 4"
"SFERIE";"S";"0231";"            LIREVALPRE LOCA_MVTEV HJOU_SJQHTENT4"
"SFERIE";"S";"0232";"            LOCA_MVTE = LOCA_MVTEV"
"SFERIE";"S";"0233";"            LIREVALPRE LOCA_MVTSV HJOU_SJQHTSOR4"
"SFERIE";"S";"0234";"            LOCA_MVTS = LOCA_MVTSV"
"SFERIE";"S";"0235";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0236";"               LOCA_RETIRE = 0"
"SFERIE";"S";"0237";"               FAIRE CALC2"
"SFERIE";"S";"0238";"            FINSI"
"SFERIE";"S";"0239";"* Mouvement de la veille 5"
"SFERIE";"S";"0240";"            LIREVALPRE LOCA_MVTEV HJOU_SJQHTENT5"
"SFERIE";"S";"0241";"            LOCA_MVTE = LOCA_MVTEV"
"SFERIE";"S";"0242";"            LIREVALPRE LOCA_MVTSV HJOU_SJQHTSOR5"
"SFERIE";"S";"0243";"            LOCA_MVTS = LOCA_MVTSV"
"SFERIE";"S";"0244";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0245";"               LOCA_RETIRE = 0"
"SFERIE";"S";"0246";"               FAIRE CALC2"
"SFERIE";"S";"0247";"            FINSI"
"SFERIE";"S";"0248";"*"
"SFERIE";"S";"0249";"         FINSI"
"SFERIE";"S";"0250";"         LOCA_FERI = LOCA_FERI + HJOU_IJQTTEFFEJ"
"SFERIE";"S";"0251";"*"
"SFERIE";"S";"0252";"* Si travail le lendemain ?"
"SFERIE";"S";"0253";"         SI HJOU_SJQPRELEND > 0"
"SFERIE";"S";"0254";"*"
"SFERIE";"S";"0255";"* On enlève les heures à cheval entre le JF et le lendemain"
"SFERIE";"S";"0256";"*"
"SFERIE";"S";"0257";"* Mouvement 1"
"SFERIE";"S";"0258";"            LOCA_MVTE = HJOU_SJQHTENT1"
"SFERIE";"S";"0259";"            LOCA_MVTS = HJOU_SJQHTSOR1"
"SFERIE";"S";"0260";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0261";"               LOCA_RETIRE = 1"
"SFERIE";"S";"0262";"               FAIRE CALC2"
"SFERIE";"S";"0263";"            FINSI"
"SFERIE";"S";"0264";"* Mouvement 2"
"SFERIE";"S";"0265";"            LOCA_MVTE = HJOU_SJQHTENT2"
"SFERIE";"S";"0266";"            LOCA_MVTS = HJOU_SJQHTSOR2"
"SFERIE";"S";"0267";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0268";"               LOCA_RETIRE = 1"
"SFERIE";"S";"0269";"               FAIRE CALC2"
"SFERIE";"S";"0270";"            FINSI"
"SFERIE";"S";"0271";"* Mouvement 3"
"SFERIE";"S";"0272";"            LOCA_MVTE = HJOU_SJQHTENT3"
"SFERIE";"S";"0273";"            LOCA_MVTS = HJOU_SJQHTSOR3"
"SFERIE";"S";"0274";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0275";"               LOCA_RETIRE = 1"
"SFERIE";"S";"0276";"               FAIRE CALC2"
"SFERIE";"S";"0277";"            FINSI"
"SFERIE";"S";"0278";"* Mouvement 4"
"SFERIE";"S";"0279";"            LOCA_MVTE = HJOU_SJQHTENT4"
"SFERIE";"S";"0280";"            LOCA_MVTS = HJOU_SJQHTSOR4"
"SFERIE";"S";"0281";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0282";"               LOCA_RETIRE = 1"
"SFERIE";"S";"0283";"               FAIRE CALC2"
"SFERIE";"S";"0284";"            FINSI"
"SFERIE";"S";"0285";"* Mouvement 5"
"SFERIE";"S";"0286";"            LOCA_MVTE = HJOU_SJQHTENT5"
"SFERIE";"S";"0287";"            LOCA_MVTS = HJOU_SJQHTSOR5"
"SFERIE";"S";"0288";"            SI LOCA_MVTS > LOCA_FINFER"
"SFERIE";"S";"0289";"               LOCA_RETIRE = 1"
"SFERIE";"S";"0290";"               FAIRE CALC2"
"SFERIE";"S";"0291";"            FINSI"
"SFERIE";"S";"0292";"*"
"SFERIE";"S";"0293";"* 31/07/2025 - JJA - FFT025005368 : Retire la pause >>"
"SFERIE";"S";"0294";"            LOCA_FERI = LOCA_FERI - PROF_SPIPAUSPAI"
"SFERIE";"S";"0295";"*"
"SFERIE";"S";"0296";"         FINSI"
"SFERIE";"S";"0297";"      FINSI"
"SFERIE";"S";"0298";"      SI LOCA_FERI > PROF_ECRJOU"
"SFERIE";"S";"0299";"         LOCA_FERI = PROF_ECRJOU"
"SFERIE";"S";"0300";"      FINSI"
"SFERIE";"S";"0301";"*"
"SFERIE";"S";"0302";"* Valeur négative ?"
"SFERIE";"S";"0303";"      SI LOCA_FERI < 0"
"SFERIE";"S";"0304";"         LOCA_FERI = 0"
"SFERIE";"S";"0305";"      FINSI"
"SFERIE";"S";"0306";"*"
"SFERIE";"S";"0307";"      HJOU_IJQHJFTRAV = LOCA_FERI"
"SFERIE";"S";"0308";"*"
"SFERIE";"S";"0309";"   FINSI"
"SFERIE";"S";"0310";"FINSI"
"SFERIE";"S";"0311";"*"
"SFERIE";"S";"0312";"*"
"SFERIE";"S";"0313";"*  Analyse des consignes"
"SFERIE";"S";"0314";"POUR ACTIVITES"
"SFERIE";"S";"0315";"   SI HABS_MOTIF = ""XFER"""
"SFERIE";"S";"0316";"      HJOU_IJQHJFTRAV = HJOU_IJQHJFTRAV + HABS_MOTIDUR"
"SFERIE";"S";"0317";"   FINSI"
"SFERIE";"S";"0318";"   SI HABS_MOTIF = ""ZFER"""
"SFERIE";"S";"0319";"      HJOU_IJQHJFTRAV = HABS_MOTIDUR"
"SFERIE";"S";"0320";"   FINSI"
"SFERIE";"S";"0321";"FINPOUR"
"SFERIE";"S";"0322";"*"
"SFERIE";"S";"0323";"***** Alimentatin des rubriques de paiements >> ****************************************************"
"SFERIE";"S";"0324";"*"
"SFERIE";"S";"0325";"SI LOCA_DROIT = 1"
"SFERIE";"S";"0326";"   SI HJOU_IJQHJFTRAV > 0"
"SFERIE";"S";"0327";"*"
"SFERIE";"S";"0328";"* 1. Journaliste >>"
"SFERIE";"S";"0329";"      SI LOCA_CALC <> 1"
"SFERIE";"S";"0330";"         SI HJOU_SJQCATEGOR = ""J"""
"SFERIE";"S";"0331";"* 1° mai ?"
"SFERIE";"S";"0332";"            SI HJOU_DATE(5:4) = ""0501"""
"SFERIE";"S";"0333";"               HJOU_SJQHJF1 = HJOU_IJQHJFTRAV - LOCA_INTAST"
"SFERIE";"S";"0334";"               SI HJOU_SJQHJF1 < 0"
"SFERIE";"S";"0335";"                  HJOU_SJQHJF1 = 0"
"SFERIE";"S";"0336";"               FINSI"
"SFERIE";"S";"0337";"            FINSI"
"SFERIE";"S";"0338";"            LOCA_CALC = 1"
"SFERIE";"S";"0339";"         FINSI"
"SFERIE";"S";"0340";"      FINSI"
"SFERIE";"S";"0341";"*"
"SFERIE";"S";"0342";"* 2. Métier de l""industrie >>"
"SFERIE";"S";"0343";"      SI LOCA_CALC <> 1"
"SFERIE";"S";"0344";"         SI HJOU_SECTORI(1:3) = ""DIN"""
"SFERIE";"S";"0345";"*"
"SFERIE";"S";"0346";"* Industrie YR"
"SFERIE";"S";"0347";"            SI HJOU_SJQSOCIETE = ""YR"""
"SFERIE";"S";"0348";"               SI HJOU_DATE(5:4) = ""0501"""
"SFERIE";"S";"0349";"                  HJOU_SJQHJF1 = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0350";"               SINON"
"SFERIE";"S";"0351";"                  HJOU_SJQHJF = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0352";"               FINSI"
"SFERIE";"S";"0353";"               LOCA_CALC = 1"
"SFERIE";"S";"0354";"            FINSI"
"SFERIE";"S";"0355";"*"
"SFERIE";"S";"0356";"* Industrie MO"
"SFERIE";"S";"0357";"            SI HJOU_SJQSOCIETE = ""MO"""
"SFERIE";"S";"0358";"*"
"SFERIE";"S";"0359";"* Cas particulier service expédition / maintenance (hors AM) / CDD de la ROTO >> *******************"
"SFERIE";"S";"0360";"               SI HJOU_SJITYPSERV = ""EXPEDITION"""
"SFERIE";"S";"0361";"                  SI HJOU_SJQCATEGOR <> ""C"""
"SFERIE";"S";"0362";"                     SI HJOU_SJQCATEGOR <> ""AM"""
"SFERIE";"S";"0363";"                        LOCA_HFCAP = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0364";"                     FINSI"
"SFERIE";"S";"0365";"                  FINSI"
"SFERIE";"S";"0366";"               FINSI"
"SFERIE";"S";"0367";"               SI HJOU_SJITYPSERV = ""MAINTENANCE"""
"SFERIE";"S";"0368";"                  SI HJOU_SJQCATEGOR <> ""AM"""
"SFERIE";"S";"0369";"                     LOCA_HFCAP = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0370";"                  FINSI"
"SFERIE";"S";"0371";"               FINSI"
"SFERIE";"S";"0372";"               SI HJOU_SJITYPSERV = ""ROTATIVE"""
"SFERIE";"S";"0373";"                  SI CTRA_TYPCTRA = ""CDD"""
"SFERIE";"S";"0374";"                     LOCA_HFCAP = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0375";"                  FINSI"
"SFERIE";"S";"0376";"               FINSI"
"SFERIE";"S";"0377";"*"
"SFERIE";"S";"0378";"               SI LOCA_HFCAP > 0"
"SFERIE";"S";"0379";"*"
"SFERIE";"S";"0380";"* 27/01/2026-Salim pour CDI, Statut Employé de la section DINMON240, on ne cappe pas les H. JF"
"SFERIE";"S";"0381";"                  DEF LOCA_NOCAPPE N1"
"SFERIE";"S";"0382";"                  LOCA_NOCAPPE = 0"
"SFERIE";"S";"0383";"*"
"SFERIE";"S";"0384";"                  SI HJOU_DATE >= ""25/12/2025"""
"SFERIE";"S";"0385";"                     SI HJOU_SECTORI = ""DINMON240"""
"SFERIE";"S";"0386";"                        SI CTRA_TYPCTRA = ""CDI"""
"SFERIE";"S";"0387";"                           SI HJOU_SJQCATEGOR = ""E"""
"SFERIE";"S";"0388";"                              LOCA_NOCAPPE = 1"
"SFERIE";"S";"0389";"                           FINSI"
"SFERIE";"S";"0390";"                        FINSI"
"SFERIE";"S";"0391";"                     FINSI"
"SFERIE";"S";"0392";"                  FINSI"
"SFERIE";"S";"0393";"*"
"SFERIE";"S";"0394";"                  SI LOCA_NOCAPPE = 0"
"SFERIE";"S";"0395";"* Capper les heures fériés"
"SFERIE";"S";"0396";"* FFT025003703 - on cappe à 6.30 quelques soit le TTE sur JF"
"SFERIE";"S";"0397";"*                  SI LOCA_HFCAP > LOCA_HFMAX"
"SFERIE";"S";"0398";"                     LOCA_HFCAP = LOCA_HFMAX"
"SFERIE";"S";"0399";"*                  FINSI"
"SFERIE";"S";"0400";"*"
"SFERIE";"S";"0401";"                  FINSI"
"SFERIE";"S";"0402";"*"
"SFERIE";"S";"0403";"                  SI HJOU_DATE(5:4) = ""0501"""
"SFERIE";"S";"0404";"                     HJOU_SJQHJF1 = LOCA_HFCAP"
"SFERIE";"S";"0405";"                  SINON"
"SFERIE";"S";"0406";"                     HJOU_SJQHJF = LOCA_HFCAP"
"SFERIE";"S";"0407";"                  FINSI"
"SFERIE";"S";"0408";"                  LOCA_CALC = 1"
"SFERIE";"S";"0409";"               FINSI"
"SFERIE";"S";"0410";"*"
"SFERIE";"S";"0411";"* Cas particulier AM de la maintenance >>"
"SFERIE";"S";"0412";"               SI LOCA_CALC <> 1"
"SFERIE";"S";"0413";"                  SI HJOU_SJITYPSERV = ""MAINTENANCE"""
"SFERIE";"S";"0414";"                     SI HJOU_SJQCATEGOR = ""AM"""
"SFERIE";"S";"0415";"                        HJOU_SJQJJF = 1"
"SFERIE";"S";"0416";"                        LOCA_CALC = 1"
"SFERIE";"S";"0417";"                     FINSI"
"SFERIE";"S";"0418";"                  FINSI"
"SFERIE";"S";"0419";"               FINSI"
"SFERIE";"S";"0420";"*"
"SFERIE";"S";"0421";"* 30/07/2025 - JJA - FFT025005315 : Cas particulier C et AM de expédition >>"
"SFERIE";"S";"0422";"               SI LOCA_CALC <> 1"
"SFERIE";"S";"0423";"                  SI HJOU_SJITYPSERV = ""EXPEDITION"""
"SFERIE";"S";"0424";"                     SI HJOU_SJQCATEGOR = ""C"""
"SFERIE";"S";"0425";"                     OU HJOU_SJQCATEGOR = ""AM"""
"SFERIE";"S";"0426";"                        HJOU_SJQJJF = 1"
"SFERIE";"S";"0427";"                        LOCA_CALC = 1"
"SFERIE";"S";"0428";"                     FINSI"
"SFERIE";"S";"0429";"                  FINSI"
"SFERIE";"S";"0430";"               FINSI"
"SFERIE";"S";"0431";"*"
"SFERIE";"S";"0432";"            FINSI"
"SFERIE";"S";"0433";"*"
"SFERIE";"S";"0434";"         FINSI"
"SFERIE";"S";"0435";"      FINSI"
"SFERIE";"S";"0436";"*"
"SFERIE";"S";"0437";"* 3. Métier du support >>"
"SFERIE";"S";"0438";"      SI LOCA_CALC <> 1"
"SFERIE";"S";"0439";"         SI HJOU_SJITYPSERV = ""SUPPORT"""
"SFERIE";"S";"0440";"         OU HJOU_SJQSOCIETE = ""PO"""
"SFERIE";"S";"0441";"* Exclu collab de TEVA >>"
"SFERIE";"S";"0442";"            SI HJOU_SJIINTEVA <> ""1"""
"SFERIE";"S";"0443";"* Vérif si droit au RJF"
"SFERIE";"S";"0444";"               SI HJOU_SJRDRJF = 0"
"SFERIE";"S";"0445";"* 1° mai ?"
"SFERIE";"S";"0446";"                  SI HJOU_DATE(5:4) = ""0501"""
"SFERIE";"S";"0447";"                     HJOU_SJQHJF1 = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0448";"                  SINON"
"SFERIE";"S";"0449";"                     HJOU_SJQHJF = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0450";"                  FINSI"
"SFERIE";"S";"0451";"                  LOCA_CALC = 1"
"SFERIE";"S";"0452";"               FINSI"
"SFERIE";"S";"0453";"            FINSI"
"SFERIE";"S";"0454";"         FINSI"
"SFERIE";"S";"0455";"      FINSI"
"SFERIE";"S";"0456";"*"
"SFERIE";"S";"0457";"* 4. Métier de l'évènementiel >>"
"SFERIE";"S";"0458";"      SI LOCA_CALC <> 1"
"SFERIE";"S";"0459";"         SI HJOU_SJQSOCIETE = ""PE"""
"SFERIE";"S";"0460";"         OU HJOU_SJQSOCIETE = ""EV"""
"SFERIE";"S";"0461";"            SI LOCA_JSOL <> 1"
"SFERIE";"S";"0462";"               SI HJOU_JOUR <> ""7"""
"SFERIE";"S";"0463";"                  HJOU_SJRHDIF100 = HJOU_SJRHDIF100 + HJOU_IJQHJFTRAV"
"SFERIE";"S";"0464";"               FINSI"
"SFERIE";"S";"0465";"            FINSI"
"SFERIE";"S";"0466";"            LOCA_CALC = 1"
"SFERIE";"S";"0467";"         FINSI"
"SFERIE";"S";"0468";"      FINSI"
"SFERIE";"S";"0469";"*"
"SFERIE";"S";"0470";"* 5. Métier de la publicité >>"
"SFERIE";"S";"0471";"      SI LOCA_CALC <> 1"
"SFERIE";"S";"0472";"         SI HJOU_SJQSOCIETE = ""PU"""
"SFERIE";"S";"0473";"            SI HJOU_SECTORI = ""DPU347"""
"SFERIE";"S";"0474";"* 1° mai ?"
"SFERIE";"S";"0475";"               SI HJOU_DATE(5:4) = ""0501"""
"SFERIE";"S";"0476";"                  HJOU_SJQHJF1 = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0477";"               SINON"
"SFERIE";"S";"0478";"                  HJOU_SJQHSP200 = HJOU_IJQHJFTRAV"
"SFERIE";"S";"0479";"               FINSI"
"SFERIE";"S";"0480";"               LOCA_CALC = 1"
"SFERIE";"S";"0481";"            FINSI"
"SFERIE";"S";"0482";"         FINSI"
"SFERIE";"S";"0483";"      FINSI"
"SFERIE";"S";"0484";"*"
"SFERIE";"S";"0485";"   FINSI"
"SFERIE";"S";"0486";"FINSI"
"SFERIE";"S";"0487";"*"
"SFERIE";"S";"0488";"*"
"SFERIE";"S";"0489";"* Evenementiel : Alimentation de la rubrique à fin de cycle >>"
"SFERIE";"S";"0490";"*"
"SFERIE";"S";"0491";"SI HJOU_SJQSOCIETE = ""PE"""
"SFERIE";"S";"0492";"OU HJOU_SJQSOCIETE = ""EV"""
"SFERIE";"S";"0493";"* Calcul fin de cycle"
"SFERIE";"S";"0494";"   SI HJOU_JOUR = ""7"""
"SFERIE";"S";"0495";"      LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"SFERIE";"S";"0496";"      SI HJOU_RANG = LOCA_NBCYCLE"
"SFERIE";"S";"0497";"         SI HJOU_SJRHDIF100 > 0"
"SFERIE";"S";"0498";"            HJOU_SJQHDIF100 = HJOU_SJRHDIF100"
"SFERIE";"S";"0499";"         FINSI"
"SFERIE";"S";"0500";"      FINSI"
"SFERIE";"S";"0501";"   FINSI"
"SFERIE";"S";"0502";"* Calcul si sortie"
"SFERIE";"S";"0503";"   SI HJOU_SJQFINC = 1"
"SFERIE";"S";"0504";"      HJOU_SJQHDIF100 = HJOU_SJRHDIF100"
"SFERIE";"S";"0505";"   FINSI"
"SFERIE";"S";"0506";"FINSI"
"SFERIE";"S";"0507";"*"
"SFERIE";"S";"0508";"* Init consignes fériées >>"
"SFERIE";"S";"0509";"POUR ACTIVITES"
"SFERIE";"S";"0510";"   SI HABS_MOTIF = ""ZHD7408"""
"SFERIE";"S";"0511";"      HJOU_SJQHDIF100 = HABS_MOTIDUR"
"SFERIE";"S";"0512";"   FINSI"
"SFERIE";"S";"0513";"   SI HABS_MOTIF = ""ZJF0356"""
"SFERIE";"S";"0514";"      HJOU_SJQHJF = HABS_MOTIDUR"
"SFERIE";"S";"0515";"   FINSI"
"SFERIE";"S";"0516";"   SI HABS_MOTIF = ""ZJF0357"""
"SFERIE";"S";"0517";"      HJOU_SJQHJF1 = HABS_MOTIDUR"
"SFERIE";"S";"0518";"   FINSI"
"SFERIE";"S";"0519";"   SI HABS_MOTIF = ""ZP5335"""
"SFERIE";"S";"0520";"      HJOU_SJQJJF = HABS_MOTINBR"
"SFERIE";"S";"0521";"   FINSI"
"SFERIE";"S";"0522";"FINPOUR"
"SFERIE";"S";"0523";"*"
