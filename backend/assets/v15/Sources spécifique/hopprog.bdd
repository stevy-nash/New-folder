"SPERCO";"S";"0024";"* Date         : JJ/MM/AAAA"
"SPERCO";"S";"0025";"* Objet        :"
"SPERCO";"S";"0026";"*"
"SPERCO";"S";"0027";"***********************************************************************"
"SPERCO";"S";"0028";"*"
"SPERCO";"S";"0029";"* Implémentation des données industrielles"
"SPERCO";"S";"0030";"*"
"SPERCO";"S";"0031";"DEBDICO"
"SPERCO";"S";"0032";"   PARD_SDIDPERCO1;O;D10;X;;;123456789;;;C3;""Début période alimentation N°1 PERCO"";"
"SPERCO";"S";"0033";"   PARD_SDIFPERCO1;O;D10;X;;;123456789;;;C3;""Fin période alimentation N°1 PERCO"";"
"SPERCO";"S";"0034";"   PARD_SDIDPERCO2;O;D10;X;;;123456789;;;C3;""Début période alimentation N°2 PERCO"";"
"SPERCO";"S";"0035";"   PARD_SDIFPERCO2;O;D10;X;;;123456789;;;C3;""Fin période alimentation N°2 PERCO"";"
"SPERCO";"S";"0036";"   *"
"SPERCO";"S";"0037";"   HJOU_SJRNJPERCO;N;N6,1;L;;;    56789;;SJRNJPERCO;V3;""Nbres jours placés dans le PERCO annuel"";"
"SPERCO";"S";"0038";"FINDICO"
"SPERCO";"S";"0039";"*"
"SPERCO";"S";"0040";"* Déclaration des données locales"
"SPERCO";"S";"0041";"*"
"SPERCO";"S";"0042";"DEF LOCA_DROIT N2"
"SPERCO";"S";"0043";"LOCA_DROIT = 1"
"SPERCO";"S";"0044";"*"
"SPERCO";"S";"0045";"DEF LOCA_PERIODALIM N2"
"SPERCO";"S";"0046";"LOCA_PERIODALIM = 0"
"SPERCO";"S";"0047";"DEF LOCA_MOTIF A10"
"SPERCO";"S";"0048";"LOCA_MOTIF = "" """
"SPERCO";"S";"0049";"DEF LOCA_MOTINBR N6.2"
"SPERCO";"S";"0050";"LOCA_MOTINBR = 0"
"SPERCO";"S";"0051";"DEF LOCA_RESTE N6.2"
"SPERCO";"S";"0052";"LOCA_RESTE = 0"
"SPERCO";"S";"0053";"*"
"SPERCO";"S";"0054";"* RAZ début d'année"
"SPERCO";"S";"0055";"SI HJOU_DATE(5:4) = ""0101"""
"SPERCO";"S";"0056";"   HJOU_SJRNJPERCO = 0"
"SPERCO";"S";"0057";"FINSI"
"SPERCO";"S";"0058";"*"
"SPERCO";"S";"0059";"* Identifie Période 1 d'alimentation"
"SPERCO";"S";"0060";"SI HJOU_DATE >= PARD_SDIDPERCO1"
"SPERCO";"S";"0061";"   SI HJOU_DATE <= PARD_SDIFPERCO1"
"SPERCO";"S";"0062";"      LOCA_PERIODALIM = 1"
"SPERCO";"S";"0063";"   FINSI"
"SPERCO";"S";"0064";"FINSI"
"SPERCO";"S";"0065";"*"
"SPERCO";"S";"0066";"* Identifie Période 1 d'alimentation"
"SPERCO";"S";"0067";"SI HJOU_DATE >= PARD_SDIDPERCO2"
"SPERCO";"S";"0068";"   SI HJOU_DATE <= PARD_SDIFPERCO2"
"SPERCO";"S";"0069";"      LOCA_PERIODALIM = 2"
"SPERCO";"S";"0070";"   FINSI"
"SPERCO";"S";"0071";"FINSI"
"SPERCO";"S";"0072";"*"
"SPERCO";"S";"0073";"POUR ACTIVITES"
"SPERCO";"S";"0074";"   SI HABS_MOTYPE = ""C"""
"SPERCO";"S";"0075";"      SI HABS_MOTIF(1:4) = ""YPER"""
"SPERCO";"S";"0076";"         LOCA_MOTIF = HABS_MOTIF"
"SPERCO";"S";"0077";"         LOCA_MOTINBR = HABS_MOTINBR"
"SPERCO";"S";"0078";"         SI LOCA_DROIT = 1"
"SPERCO";"S";"0079";"* Vérif si saisie un entier >>"
"SPERCO";"S";"0080";"            FAIRE PALIER1"
"SPERCO";"S";"0081";"            SI HABS_MOTIF = ""YPERCP"""
"SPERCO";"S";"0082";"               HJOU_SJRNJPERCO = HJOU_SJRNJPERCO + LOCA_MOTINBR"
"SPERCO";"S";"0083";"* Vérif si période alimentation 1"
"SPERCO";"S";"0084";"               SI LOCA_PERIODALIM <> 1"
"SPERCO";"S";"0085";"* Hors période d'alimentation 1"
"SPERCO";"S";"0086";"                  ANOMALIE 271"
"SPERCO";"S";"0087";"                  SI TEMP_CNMOTIF = LOCA_MOTIF"
"SPERCO";"S";"0088";"                     TEMP_CNRETOUR = 2"
"SPERCO";"S";"0089";"                     TEMP_CNMESS = 271"
"SPERCO";"S";"0090";"                  FINSI"
"SPERCO";"S";"0091";"               FINSI"
"SPERCO";"S";"0092";"            SINON"
"SPERCO";"S";"0093";"               HJOU_SJRNJPERCO = HJOU_SJRNJPERCO + LOCA_MOTINBR"
"SPERCO";"S";"0094";"* Vérif si période alimentation 2"
"SPERCO";"S";"0095";"               SI LOCA_PERIODALIM <> 2"
"SPERCO";"S";"0096";"* Hors période d'alimentation 2"
"SPERCO";"S";"0097";"                  ANOMALIE 272"
"SPERCO";"S";"0098";"                  SI TEMP_CNMOTIF = LOCA_MOTIF"
"SPERCO";"S";"0099";"                     TEMP_CNRETOUR = 2"
"SPERCO";"S";"0100";"                     TEMP_CNMESS = 272"
"SPERCO";"S";"0101";"                  FINSI"
"SPERCO";"S";"0102";"               FINSI"
"SPERCO";"S";"0103";"            FINSI"
"SPERCO";"S";"0104";"         SINON"
"SPERCO";"S";"0105";"* Pas droit au PERCO >>"
"SPERCO";"S";"0106";"            ANOMALIE 270"
"SPERCO";"S";"0107";"            SI TEMP_CNMOTIF = LOCA_MOTIF"
"SPERCO";"S";"0108";"               TEMP_CNRETOUR = 2"
"SPERCO";"S";"0109";"               TEMP_CNMESS = 270"
"SPERCO";"S";"0110";"            FINSI"
"SPERCO";"S";"0111";"         FINSI"
"SPERCO";"S";"0112";"      FINSI"
"SPERCO";"S";"0113";"   FINSI"
"SPERCO";"S";"0114";"*"
"SPERCO";"S";"0115";"* Consignes >>"
"SPERCO";"S";"0116";"   SI HABS_MOTIF = ""ZPERCO"""
"SPERCO";"S";"0117";"      HJOU_SJRNJPERCO = HABS_MOTINBR"
"SPERCO";"S";"0118";"   FINSI"
"SPERCO";"S";"0119";"*"
"SPERCO";"S";"0120";"FINPOUR"
"SPERCO";"S";"0121";"*"
"SPERCO";"S";"0122";"* Contrôle seuil max par an"
"SPERCO";"S";"0123";"SI HJOU_SJRNJPERCO > PARD_SDIPERCOM"
"SPERCO";"S";"0124";"   ANOMALIE 274"
"SPERCO";"S";"0125";"   SI TEMP_CNMOTIF = LOCA_MOTIF"
"SPERCO";"S";"0126";"      TEMP_CNRETOUR = 2"
"SPERCO";"S";"0127";"      TEMP_CNMESS = 274"
"SPERCO";"S";"0128";"   FINSI"
"SPERCO";"S";"0129";"FINSI"
"SPERCO";"S";"0130";"*"
"SPERCO";"S";"0131";"*"
"SPERCO";"S";"0132";"*"
"SPERCO";"S";"0133";"*"
"SPERCO";"S";"0134";"FIN"
"SPERCO";"S";"0135";"*"
"SPERCO";"S";"0136";"* Contrôle si saisie un jour plein >>"
"SPERCO";"S";"0137";"PROC PALIER1"
"SPERCO";"S";"0138";"   LOCA_RESTE = LOCA_MOTINBR % 1"
"SPERCO";"S";"0139";"   SI LOCA_RESTE > 0"
"SPERCO";"S";"0140";"   OU LOCA_MOTINBR = 0"
"SPERCO";"S";"0141";"      ANOMALIE 291"
"SPERCO";"S";"0142";"      SI TEMP_CNMOTIF(1:4) = LOCA_MOTIF"
"SPERCO";"S";"0143";"         TEMP_CNRETOUR = 2"
"SPERCO";"S";"0144";"         TEMP_CNMESS = 291"
"SPERCO";"S";"0145";"      FINSI"
"SPERCO";"S";"0146";"   FINSI"
"SPERCO";"S";"0147";"FINPROC"
"SPERCO";"S";"0148";"* Contrôle si saisie un jour plein ou demi-jour >>"
"SPERCO";"S";"0149";"PROC PALIER05"
"SPERCO";"S";"0150";"   LOCA_RESTE = LOCA_MOTINBR % 0.5"
"SPERCO";"S";"0151";"   SI LOCA_RESTE > 0"
"SPERCO";"S";"0152";"   OU LOCA_MOTINBR = 0"
"SPERCO";"S";"0153";"      ANOMALIE 292"
"SPERCO";"S";"0154";"      SI TEMP_CNMOTIF(1:4) = LOCA_MOTIF"
"SPERCO";"S";"0155";"         TEMP_CNRETOUR = 2"
"SPERCO";"S";"0156";"         TEMP_CNMESS = 292"
"SPERCO";"S";"0157";"      FINSI"
"SPERCO";"S";"0158";"   FINSI"
"SPERCO";"S";"0159";"FINPROC"
"SPRESTHEO";"S";"0001";"***********************************************************************"
"SPRESTHEO";"S";"0002";"*"
"SPRESTHEO";"S";"0003";"* Règle : IPRESTHEO"
"SPRESTHEO";"S";"0004";"* Ordre : 3100"
"SPRESTHEO";"S";"0005";"* Titre : Présence théorique"
"SPRESTHEO";"S";"0006";"*"
"SPRESTHEO";"S";"0007";"*----------------------------------------------------------------------"
"SPRESTHEO";"S";"0008";"*"
"SPRESTHEO";"S";"0009";"* Créé par : Méthodes et outils"
"SPRESTHEO";"S";"0010";"* Date     : 10/08/2018"
"SPRESTHEO";"S";"0011";"* Version  : 1"
"SPRESTHEO";"S";"0012";"*"
"SPRESTHEO";"S";"0013";"*----------------------------------------------------------------------"
"SPRESTHEO";"S";"0014";"*"
"SPRESTHEO";"S";"0015";"*"
"SPRESTHEO";"S";"0016";"* Rôle : Calcul de la présence théorique"
"SPRESTHEO";"S";"0017";"*"
"SPRESTHEO";"S";"0018";"*"
"SPRESTHEO";"S";"0019";"***********************************************************************"
"SPRESTHEO";"S";"0020";"*"
"SPRESTHEO";"S";"0021";"* Implémentation des données industrielles"
"SPRESTHEO";"S";"0022";"*"
"SPRESTHEO";"S";"0023";"DEBDICO"
"SPRESTHEO";"S";"0024";"   HJOU_IJRNBMOTIH;N;N3;I;;;    56789;;IJRNBMOTIH;V3;""Nombre de motifs hebdomadaire"";"
"SPRESTHEO";"S";"0025";"FINDICO"
"SPRESTHEO";"S";"0026";"*"
"SPRESTHEO";"S";"0027";"* Déclaration des donnees locales"
"SPRESTHEO";"S";"0028";"*"
"SPRESTHEO";"S";"0029";"DEF LOCA_ABSENCEJ N2"
"SPRESTHEO";"S";"0030";"LOCA_ABSENCEJ = 0"
"SPRESTHEO";"S";"0031";"*"
"SPRESTHEO";"S";"0032";"ENLEVER ""REPOS"""
"SPRESTHEO";"S";"0033";"ENLEVER ""REPOS"""
"SPRESTHEO";"S";"0034";"*"
"SPRESTHEO";"S";"0035";"ENLEVER ""AAREPOS"""
"SPRESTHEO";"S";"0036";"ENLEVER ""AAREPOS"""
"SPRESTHEO";"S";"0037";"*"
"SPRESTHEO";"S";"0038";"* JJA - 18/09/2025 - FFT025006044 : Ajouter Repos TP"
"SPRESTHEO";"S";"0039";"ENLEVER ""AAREPOSTP"""
"SPRESTHEO";"S";"0040";"ENLEVER ""AAREPOSTP"""
"SPRESTHEO";"S";"0041";"*"
"SPRESTHEO";"S";"0042";"* alimentation de la théorie journalière par le profil sauf pour les plannings d'optimum"
"SPRESTHEO";"S";"0043";"SI CTRA_TYPEPLAN <> ""1"""
"SPRESTHEO";"S";"0044";"   SI CTRA_TYPEPLAN <> ""6"""
"SPRESTHEO";"S";"0045";"      HJOU_IJQPRETHEJ = PROF_PRETHEO"
"SPRESTHEO";"S";"0046";"*"
"SPRESTHEO";"S";"0047";"* GCF - Valorisation de paie particulière pour les journalistes >>"
"SPRESTHEO";"S";"0048";"*"
"SPRESTHEO";"S";"0049";"      SI PROF_PRETHEO > 0.02"
"SPRESTHEO";"S";"0050";"         SI HJOU_SJQCATEGOR = ""J"""
"SPRESTHEO";"S";"0051";"            SI HJOU_SJQFORFJR <> ""1"""
"SPRESTHEO";"S";"0052";"               SI HORC_SHIHOREF > 0.00"
"SPRESTHEO";"S";"0053";"* Profil de la rédaction"
"SPRESTHEO";"S";"0054";"                  SI HJOU_PROFIL(1:3) = ""RED"""
"SPRESTHEO";"S";"0055";"* Demi-jounrée ?"
"SPRESTHEO";"S";"0056";"                     SI PROF_ABSENM = 0"
"SPRESTHEO";"S";"0057";"                     OU PROF_ABSENS = 0"
"SPRESTHEO";"S";"0058";"                        HJOU_IJQPRETHEJ = HORC_SHIHOREF / 2"
"SPRESTHEO";"S";"0059";"                     SINON"
"SPRESTHEO";"S";"0060";"                        HJOU_IJQPRETHEJ = HORC_SHIHOREF"
"SPRESTHEO";"S";"0061";"                     FINSI"
"SPRESTHEO";"S";"0062";"                  FINSI"
"SPRESTHEO";"S";"0063";"               FINSI"
"SPRESTHEO";"S";"0064";"            FINSI"
"SPRESTHEO";"S";"0065";"         FINSI"
"SPRESTHEO";"S";"0066";"      FINSI"
"SPRESTHEO";"S";"0067";"*"
"SPRESTHEO";"S";"0068";"* GCF - <<"
"SPRESTHEO";"S";"0069";"*"
"SPRESTHEO";"S";"0070";"   FINSI"
"SPRESTHEO";"S";"0071";"FINSI"
"SPRESTHEO";"S";"0072";"* consignes init"
"SPRESTHEO";"S";"0073";"POUR ACTIVITES"
"SPRESTHEO";"S";"0074";"   SI HABS_MOTYPE = ""C"""
"SPRESTHEO";"S";"0075";"      SI HABS_MOTIF = ""ZPLMAT"""
"SPRESTHEO";"S";"0076";"         HJOU_IJQPLGMAT = HABS_MOTIDUR"
"SPRESTHEO";"S";"0077";"         HJOU_IJQPLGTOTJ = HJOU_IJQPLGMAT + HJOU_IJQPLGAPM"
"SPRESTHEO";"S";"0078";"         HJOU_IJQPRETHEJ = HJOU_IJQPLGTOTJ"
"SPRESTHEO";"S";"0079";"      FINSI"
"SPRESTHEO";"S";"0080";"      SI HABS_MOTIF = ""ZPLAPM"""
"SPRESTHEO";"S";"0081";"         HJOU_IJQPLGAPM = HABS_MOTIDUR"
"SPRESTHEO";"S";"0082";"         HJOU_IJQPLGTOTJ = HJOU_IJQPLGMAT + HJOU_IJQPLGAPM"
"SPRESTHEO";"S";"0083";"         HJOU_IJQPRETHEJ = HJOU_IJQPLGTOTJ"
"SPRESTHEO";"S";"0084";"      FINSI"
"SPRESTHEO";"S";"0085";"      SI HABS_MOTIF = ""ZTHJ"""
"SPRESTHEO";"S";"0086";"         HJOU_IJQPRETHEJ = HABS_MOTIDUR"
"SPRESTHEO";"S";"0087";"      FINSI"
"SPRESTHEO";"S";"0088";"   FINSI"
"SPRESTHEO";"S";"0089";"FINPOUR"
"SPRESTHEO";"S";"0090";"*"
"SPRESTHEO";"S";"0091";"* planning optimum non validé (absences/présences non planifiables)"
"SPRESTHEO";"S";"0092";"*"
"SPRESTHEO";"S";"0093";"SI CTRA_TYPEPLAN = ""1"""
"SPRESTHEO";"S";"0094";"OU CTRA_TYPEPLAN = ""6"""
"SPRESTHEO";"S";"0095";"   SI HJOU_HJVALPLN = 0"
"SPRESTHEO";"S";"0096";"   OU HJOU_HJVALPLN = 2"
"SPRESTHEO";"S";"0097";"      HJOU_IJQPRETHEJ = HJOU_IJQPLGTOTJ"
"SPRESTHEO";"S";"0098";"   FINSI"
"SPRESTHEO";"S";"0099";"FINSI"
"SPRESTHEO";"S";"0100";"*"
"SPRESTHEO";"S";"0101";"*"
"SPRESTHEO";"S";"0102";"* Gestion sur plages dynamiques"
"SPRESTHEO";"S";"0103";"*"
"SPRESTHEO";"S";"0104";"SI PROF_PLAGEDYN = 1"
"SPRESTHEO";"S";"0105";"* non optimum"
"SPRESTHEO";"S";"0106";"   SI CTRA_TYPEPLAN <> ""1"""
"SPRESTHEO";"S";"0107";"      SI CTRA_TYPEPLAN <> ""6"""
"SPRESTHEO";"S";"0108";"* non ressources"
"SPRESTHEO";"S";"0109";"         SI EMPL_IEIEMPRESS <> ""1"""
"SPRESTHEO";"S";"0110";"*            HJOU_IJQPRETHEJ = HJOU_IJQPLGTOTJ"
"SPRESTHEO";"S";"0111";"         FINSI"
"SPRESTHEO";"S";"0112";"      FINSI"
"SPRESTHEO";"S";"0113";"   FINSI"
"SPRESTHEO";"S";"0114";"FINSI"
"SPRESTHEO";"S";"0115";"*"
"SPRESTHEO";"S";"0116";"*"
"SPRESTHEO";"S";"0117";"* Cas de TEVA"
"SPRESTHEO";"S";"0118";"SI HJOU_SJQSOCIETE = ""PO"""
"SPRESTHEO";"S";"0119";"   POUR ACTIVITES"
"SPRESTHEO";"S";"0120";"      SI HABS_MOTIF = ""POREPO"""
"SPRESTHEO";"S";"0121";"         SI HABS_VALORIS = ""J"""
"SPRESTHEO";"S";"0122";"            HJOU_IJQPRETHEJ = 0"
"SPRESTHEO";"S";"0123";"         FINSI"
"SPRESTHEO";"S";"0124";"      FINSI"
"SPRESTHEO";"S";"0125";"   FINPOUR"
"SPRESTHEO";"S";"0126";"FINSI"
"SPRESTHEO";"S";"0127";"*"
"SPRESTHEO";"S";"0128";"* Spécif : ajout consigne REPOS pour affichage"
"SPRESTHEO";"S";"0129";"*"
"SPRESTHEO";"S";"0130";"* On regarde si absence en jour ?"
"SPRESTHEO";"S";"0131";"POUR ACTIVITES"
"SPRESTHEO";"S";"0132";"   SI HABS_MOTYPE <> ""C"""
"SPRESTHEO";"S";"0133";"      SI HABS_VALORIS = ""J"""
"SPRESTHEO";"S";"0134";"         LOCA_ABSENCEJ = 1"
"SPRESTHEO";"S";"0135";"      FINSI"
"SPRESTHEO";"S";"0136";"   FINSI"
"SPRESTHEO";"S";"0137";"FINPOUR"
"SPRESTHEO";"S";"0138";"*"
"SPRESTHEO";"S";"0139";"* Cas du repos jour"
"SPRESTHEO";"S";"0140";"SI HJOU_IJQPRETHEJ = 0"
"SPRESTHEO";"S";"0141";"   SI LOCA_ABSENCEJ <> 1"
"SPRESTHEO";"S";"0142";"* JJA - 18/09/2025 - FFT025006044 : Ajouter Repos TP"
"SPRESTHEO";"S";"0143";"      SI PROF_SPITYPREP = ""1"""
"SPRESTHEO";"S";"0144";"         ENLEVER ""AAREPOSTP"""
"SPRESTHEO";"S";"0145";"         AJOUTER ""AAREPOSTP"" ""J"" 0.00"
"SPRESTHEO";"S";"0146";"      SINON"
"SPRESTHEO";"S";"0147";"         ENLEVER ""AAREPOS"""
"SPRESTHEO";"S";"0148";"         AJOUTER ""AAREPOS"" ""J"" 0.00"
"SPRESTHEO";"S";"0149";"      FINSI"
"SPRESTHEO";"S";"0150";"   FINSI"
"SPRESTHEO";"S";"0151";"FINSI"
"SPRESTHEO";"S";"0152";"*"
"SPRESTHEO";"S";"0153";"* Cas du TP demi-journée"
"SPRESTHEO";"S";"0154";"SI PROF_SPITYPREP = ""2"""
"SPRESTHEO";"S";"0155";"   SI LOCA_ABSENCEJ <> 1"
"SPRESTHEO";"S";"0156";"* Repos Matin"
"SPRESTHEO";"S";"0157";"      SI PROF_ABSENM = 0"
"SPRESTHEO";"S";"0158";"         SI PROF_ABSENS > 0"
"SPRESTHEO";"S";"0159";"            ENLEVER ""AAREPOS"""
"SPRESTHEO";"S";"0160";"            AJOUTER ""AAREPOS"" ""M"" 0.00"
"SPRESTHEO";"S";"0161";"         FINSI"
"SPRESTHEO";"S";"0162";"      FINSI"
"SPRESTHEO";"S";"0163";"* Repos Après-midi"
"SPRESTHEO";"S";"0164";"      SI PROF_ABSENS = 0"
"SPRESTHEO";"S";"0165";"         SI PROF_ABSENM > 0"
"SPRESTHEO";"S";"0166";"            ENLEVER ""AAREPOS"""
"SPRESTHEO";"S";"0167";"            AJOUTER ""AAREPOS"" ""A"" 0.00"
"SPRESTHEO";"S";"0168";"         FINSI"
"SPRESTHEO";"S";"0169";"      FINSI"
"SPRESTHEO";"S";"0170";"   FINSI"
"SPRESTHEO";"S";"0171";"FINSI"
"SPRESTHEO";"S";"0172";"*"
"SPRESTHEO";"S";"0173";"*"
"SPRESTHEO";"S";"0174";"FIN"
