"SGCALJF";"S";"0122";"FINSI"
"SGCALJF";"S";"0123";"*"
"SGCALJF";"S";"0124";"* Si Industrie et horaire de nuit JF considéré la veille du férié >>"
"SGCALJF";"S";"0125";"*"
"SGCALJF";"S";"0126";"* Fin plage de travail ?"
"SGCALJF";"S";"0127";"SI HJOU_IJQMVTSOR1 > 0"
"SGCALJF";"S";"0128";"   LOCA_HFINPLG = HJOU_IJQMVTSOR1"
"SGCALJF";"S";"0129";"FINSI"
"SGCALJF";"S";"0130";"SI LOCA_HFINPLG < HJOU_IJQMVTSOR2"
"SGCALJF";"S";"0131";"   LOCA_HFINPLG = HJOU_IJQMVTSOR2"
"SGCALJF";"S";"0132";"FINSI"
"SGCALJF";"S";"0133";"SI LOCA_HFINPLG < HJOU_IJQMVTSOR3"
"SGCALJF";"S";"0134";"   LOCA_HFINPLG = HJOU_IJQMVTSOR3"
"SGCALJF";"S";"0135";"FINSI"
"SGCALJF";"S";"0136";"SI LOCA_HFINPLG < HJOU_IJQMVTSOR4"
"SGCALJF";"S";"0137";"   LOCA_HFINPLG = HJOU_IJQMVTSOR4"
"SGCALJF";"S";"0138";"FINSI"
"SGCALJF";"S";"0139";"SI LOCA_HFINPLG < HJOU_IJQMVTSOR5"
"SGCALJF";"S";"0140";"   LOCA_HFINPLG = HJOU_IJQMVTSOR5"
"SGCALJF";"S";"0141";"FINSI"
"SGCALJF";"S";"0142";"*"
"SGCALJF";"S";"0143";"SI HJOU_SECTORI(1:3) = ""DIN"""
"SGCALJF";"S";"0144";"   SI HJOU_SJQSOCIETE = ""MO"""
"SGCALJF";"S";"0145";"   OU HJOU_SJQSOCIETE = ""YR"""
"SGCALJF";"S";"0146";"      SI TEMP_STQJF = ""VJF"""
"SGCALJF";"S";"0147";"      OU LOCA_FERIE = 1"
"SGCALJF";"S";"0148";"         SI LOCA_HFINPLG > 26.00"
"SGCALJF";"S";"0149";"         OU PROF_REDUIT = ""N"""
"SGCALJF";"S";"0150";"            LOCA_JFNUIT = 1"
"SGCALJF";"S";"0151";"         FINSI"
"SGCALJF";"S";"0152";"      FINSI"
"SGCALJF";"S";"0153";"   FINSI"
