"SGASTR";"S";"0555";"PROC CTRCHEV"
"SGASTR";"S";"0556";"*"
"SGASTR";"S";"0557";"   SI LOCA_HDEBREF <> 545"
"SGASTR";"S";"0558";"      SI LOCA_DEBT <> LOCA_FINT"
"SGASTR";"S";"0559";"         SI LOCA_HDEBREF > LOCA_DEBT"
"SGASTR";"S";"0560";"            SI LOCA_HDEBREF < LOCA_FINT"
"SGASTR";"S";"0561";"               LOCA_CHEV = 1"
"SGASTR";"S";"0562";"            FINSI"
"SGASTR";"S";"0563";"         FINSI"
"SGASTR";"S";"0564";"      FINSI"
"SGASTR";"S";"0565";"   FINSI"
"SGASTR";"S";"0566";"*"
"SGASTR";"S";"0567";"   SI LOCA_HFINREF <> 545"
"SGASTR";"S";"0568";"      SI LOCA_DEBT <> LOCA_FINT"
"SGASTR";"S";"0569";"         SI LOCA_HFINREF > LOCA_DEBT"
"SGASTR";"S";"0570";"            SI LOCA_HFINREF < LOCA_FINT"
"SGASTR";"S";"0571";"               LOCA_CHEV = 1"
