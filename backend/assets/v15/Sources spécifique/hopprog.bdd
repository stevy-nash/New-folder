"IHREFF";"S";"0011";"* Version  : 1"
"IHREFF";"S";"0012";"*"
"IHREFF";"S";"0013";"*----------------------------------------------------------------------"
"IHREFF";"S";"0014";"*"
"IHREFF";"S";"0015";"*"
"IHREFF";"S";"0016";"* Rôle : Heures effectives"
"IHREFF";"S";"0017";"*"
"IHREFF";"S";"0018";"*"
"IHREFF";"S";"0019";"*"
"IHREFF";"S";"0020";"*"
"IHREFF";"S";"0021";"*"
"IHREFF";"S";"0022";"*----------------------------------------------------------------------"
"IHREFF";"S";"0023";"*"
"IHREFF";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IHREFF";"S";"0025";"* Date         : JJ/MM/AAAA"
