"SGASTR";"S";"0526";"      SUPANOM 257"
"SGASTR";"S";"0527";"   FINSI"
"SGASTR";"S";"0528";"   SI HABS_MOTIF = ""ZA5239"""
"SGASTR";"S";"0529";"      HJOU_SJQAST5239 = HABS_MOTINBR"
"SGASTR";"S";"0530";"      SUPANOM 257"
"SGASTR";"S";"0531";"   FINSI"
"SGASTR";"S";"0532";"   SI HABS_MOTIF = ""ZH5240"""
"SGASTR";"S";"0533";"      HJOU_SJQAST5240 = HABS_MOTIDUR"
"SGASTR";"S";"0534";"      SUPANOM 257"
"SGASTR";"S";"0535";"   FINSI"
"SGASTR";"S";"0536";"   SI HABS_MOTIF = ""ZP5228"""
