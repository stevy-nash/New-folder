"SACQCPAN";"S";"0137";"      HJOU_SJQMODANC = ""001"""
"SACQCPAN";"S";"0138";"* Vérif si changement et calcul de nouvelle date anciénnété >>"
"SACQCPAN";"S";"0139";"      FAIRE CHANGE"
"SACQCPAN";"S";"0140";"*"
"SACQCPAN";"S";"0141";"* Supérieur à 5 ans"
"SACQCPAN";"S";"0142";"      SI LOCA_ANCA >= 5"
"SACQCPAN";"S";"0143";"         SI LOCA_ANCA < 10"
"SACQCPAN";"S";"0144";"            LOCA_DRANCT = LOCA_DRANCT + 1"
"SACQCPAN";"S";"0145";"         FINSI"
"SACQCPAN";"S";"0146";"      FINSI"
"SACQCPAN";"S";"0147";"* Supérieur à 10 ans"
