"SCONTR";"S";"0410";"   SI HJOU_DATE = CTRA_DATFIN"
"SCONTR";"S";"0411";"* Stockage de la date de fin de contrat"
"SCONTR";"S";"0412";"      DATDIFF CTRA_DATDEB 12 CTRA_DATFIN 12"
"SCONTR";"S";"0413";"* Stockage du nombre de jours dans le contrat"
"SCONTR";"S";"0414";"      HJOU_IJRNBRJCTR = TEMP_NXJOUR"
"SCONTR";"S";"0415";"      HJOU_IJRNBRJCTR = TEMP_NXJOUR + 1"
"SCONTR";"S";"0416";"*"
"SCONTR";"S";"0417";"      SI HJOU_IJRNBRJCTR >= 14"
"SCONTR";"S";"0418";"         LOCA_CARENCE = HJOU_IJRNBRJCTR / 3"
