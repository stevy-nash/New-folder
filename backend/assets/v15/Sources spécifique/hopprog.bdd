"SGRJF";"S";"0046";"   EMPL_SEQDRJFN5;N;N6,1;I;;;    56789;;;V3;""Droit RJF N-5"";"
"SGRJF";"S";"0047";"   SECH_SSIGRJF;O;Z1;X;;;      789;L9;;C2;""Droit au RJF"";"
"SGRJF";"S";"0048";"   *"
"SGRJF";"S";"0049";"   PARD_SDIVMRJF;O;A10;X;;;123456789;II;;C2;""Motif RJF"";"
"SGRJF";"S";"0050";"   PARD_SDIDRJFJL;N;N4,1;I;000000000000;;    56789;;;C3;""Droit RJF annuel - Journaliste"";"
"SGRJF";"S";"0051";"   PARD_SDIDRJFMO;N;N4,1;I;000000000000;;    56789;;;C3;""MO : Droit RJF annuel"";"
"SGRJF";"S";"0052";"   PARD_SDIDRJFMOJ;N;N4,1;I;000000000000;;    56789;;;C3;""MO : Droit RJF annuel - Journaliste"";"
"SGRJF";"S";"0053";"   PARD_SDIDRJFPC;N;N4,1;I;000000000000;;    56789;;;C3;""PC : Droit RJF annuel"";"
"SGRJF";"S";"0054";"   PARD_SDIDRJFRC;N;N4,1;I;000000000000;;    56789;;;C3;""RC : Droit RJF annuel"";"
