"SGCSEGLISS";"S";"0067";"   PARD_SDIVMCSE;O;A10;X;;;123456789;II;;C2;""Motif délégation CSE"";"
"SGCSEGLISS";"S";"0068";"   HJOU_SJISECSYN;O;A10;X;;;        9;L9;;C3;""Section Syndicale"";"
"SGCSEGLISS";"S";"0069";"   HJOU_SJRSCSER;N;T8,2;L;;;   456789;;SJRSCSER;V3;""Solde CSE reliquat (H)"";"
"SGCSEGLISS";"S";"0070";"   *"
"SGCSEGLISS";"S";"0071";"   MOTI_SMISOCIETE;O;A2;X;;;        9;L;;C2;""Code société du matricule CSE"";"
"SGCSEGLISS";"S";"0072";"FINDICO"
"SGCSEGLISS";"S";"0073";"*"
"SGCSEGLISS";"S";"0074";"DEBANO"
"SGCSEGLISS";"S";"0075";"   215;7;""Solde mensuel délégation CSE négatif"";"
"SGCSEGLISS";"S";"0076";"   216;7;""Dépassement du droit maximum CSE mensuel"";"
"SGCSEGLISS";"S";"0077";"   217;7;""Solde annuel délégation CSE négatif"";"
"SGCSEGLISS";"S";"0078";"   218;7;""Dépassement du droit maximum CSE annuel"";"
"SGCSEGLISS";"S";"0079";"   219;7;""La valeur du CSE transféré doit être un multiple de 4"";"
"SGCSEGLISS";"S";"0080";"   220;7;""Le transfert doit se faire vers un matricule différent de celui du donateur"";"
"SGCSEGLISS";"S";"0081";"   221;7;""Valorisation en heures interdite aux forfaits jour"";"
"SGCSEGLISS";"S";"0082";"   401;7;""Dépassement des droits maxi mensuel"";"
"SGCSEGLISS";"S";"0083";"FINANO"
"SGCSEGLISS";"S";"0084";"* -------------------------------"
"SGCSEGLISS";"S";"0085";"* Déclaration des donnees locales"
"SGCSEGLISS";"S";"0086";"* -------------------------------"
"SGCSEGLISS";"S";"0087";"DEF LOCA_DTMAX T6.2"
"SGCSEGLISS";"S";"0088";"LOCA_DTMAX = 0"
"SGCSEGLISS";"S";"0089";"* --------------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0090";"* Locale permettant de déterminer s'il y a une consigne impactant le droit mensuel"
"SGCSEGLISS";"S";"0091";"* --------------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0092";"DEF LOCA_MENS N1"
"SGCSEGLISS";"S";"0093";"LOCA_MENS = 0"
"SGCSEGLISS";"S";"0094";"DEF LOCA_MENS2 N1"
"SGCSEGLISS";"S";"0095";"LOCA_MENS2 = 0"
"SGCSEGLISS";"S";"0096";"DEF LOCA_MAJO N1"
"SGCSEGLISS";"S";"0097";"LOCA_MAJO = 0"
"SGCSEGLISS";"S";"0098";"* -------------------------------------------------------------"
"SGCSEGLISS";"S";"0099";"* Locale permettant de calculer le droit pour les forfaits jour"
"SGCSEGLISS";"S";"0100";"* -------------------------------------------------------------"
"SGCSEGLISS";"S";"0101";"DEF LOCA_MAJD T6.2"
"SGCSEGLISS";"S";"0102";"LOCA_MAJD = 0"
"SGCSEGLISS";"S";"0103";"* --------------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0104";"* Locale permettant de calculer le nbre de jours transférés pour les forfaits jour"
"SGCSEGLISS";"S";"0105";"* --------------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0106";"DEF LOCA_MAJT T6.2"
"SGCSEGLISS";"S";"0107";"LOCA_MAJT = 0"
"SGCSEGLISS";"S";"0108";"DEF LOCA_DATE D"
"SGCSEGLISS";"S";"0109";"LOCA_DATE = "" """
"SGCSEGLISS";"S";"0110";"DEF LOCA_ACOURS N4"
"SGCSEGLISS";"S";"0111";"LOCA_ACOURS = 0"
"SGCSEGLISS";"S";"0112";"DEF LOCA_DATEFIN D"
"SGCSEGLISS";"S";"0113";"LOCA_DATEFIN = "" """
"SGCSEGLISS";"S";"0114";"DEF LOCA_DROIT N7.3"
"SGCSEGLISS";"S";"0115";"LOCA_DROIT = 0"
"SGCSEGLISS";"S";"0116";"DEF LOCA_MAT A10"
"SGCSEGLISS";"S";"0117";"LOCA_MAT = "" """
"SGCSEGLISS";"S";"0118";"DEF LOCA_VALO A1"
"SGCSEGLISS";"S";"0119";"LOCA_VALO = "" """
"SGCSEGLISS";"S";"0120";"* ----------------------------------------------------"
"SGCSEGLISS";"S";"0121";"* Coefficient appliqué pour le calcul de la majoration"
"SGCSEGLISS";"S";"0122";"* ----------------------------------------------------"
"SGCSEGLISS";"S";"0123";"DEF LOCA_TAUX N4.1"
"SGCSEGLISS";"S";"0124";"LOCA_TAUX = PARD_IDIMAJOCSE"
"SGCSEGLISS";"S";"0125";"DEF LOCA_DIV T6.2"
"SGCSEGLISS";"S";"0126";"LOCA_DIV = 1.00"
"SGCSEGLISS";"S";"0127";"DEF LOCA_RESTE N7.3"
"SGCSEGLISS";"S";"0128";"LOCA_RESTE = 0"
"SGCSEGLISS";"S";"0129";"DEF LOCA_RESTET T8.2"
"SGCSEGLISS";"S";"0130";"LOCA_RESTET = 0"
"SGCSEGLISS";"S";"0131";"DEF LOCA_MOINS1 N2"
"SGCSEGLISS";"S";"0132";"LOCA_MOINS1 = -1"
"SGCSEGLISS";"S";"0133";"DEF LOCA_CONSORELI N1"
"SGCSEGLISS";"S";"0134";"LOCA_CONSORELI = 0"
"SGCSEGLISS";"S";"0135";"DEF LOCA_CONSO N1"
"SGCSEGLISS";"S";"0136";"LOCA_CONSO = 0"
"SGCSEGLISS";"S";"0137";"****************************"
"SGCSEGLISS";"S";"0138";"* maximum mensuel (par défaut 1,5 fois le 12ième ANNUEL)"
"SGCSEGLISS";"S";"0139";"DEF LOCA_MAXM T8.2"
"SGCSEGLISS";"S";"0140";"LOCA_MAXM = HJOU_IJIDACSEM / 12"
"SGCSEGLISS";"S";"0141";"LOCA_MAXM = LOCA_MAXM * PARD_IDIMAJOCSE"
"SGCSEGLISS";"S";"0142";"* droit et transfert"
"SGCSEGLISS";"S";"0143";"DEF LOCA_DRTR T8.2"
"SGCSEGLISS";"S";"0144";"LOCA_DRTR = 0"
"SGCSEGLISS";"S";"0145";"* droit et pris"
"SGCSEGLISS";"S";"0146";"DEF LOCA_DRPR T8.2"
"SGCSEGLISS";"S";"0147";"LOCA_DRPR = 0"
"SGCSEGLISS";"S";"0148";"*CSE en jour"
"SGCSEGLISS";"S";"0149";"DEF LOCA_MENSJ N1"
"SGCSEGLISS";"S";"0150";"LOCA_MENSJ = 0"
"SGCSEGLISS";"S";"0151";"DEF LOCA_YCSE N2"
"SGCSEGLISS";"S";"0152";"LOCA_YCSE = 0"
"SGCSEGLISS";"S";"0153";"DEF LOCA_ANOTR N2"
"SGCSEGLISS";"S";"0154";"LOCA_ANOTR = 0"
"SGCSEGLISS";"S";"0155";"*"
"SGCSEGLISS";"S";"0156";"DEF LOCA_SUPPLEANT N2"
"SGCSEGLISS";"S";"0157";"LOCA_SUPPLEANT = 0"
"SGCSEGLISS";"S";"0158";"*"
"SGCSEGLISS";"S";"0159";"* --------------------------------"
"SGCSEGLISS";"S";"0160";"* Calcul de la date prévisionnelle"
"SGCSEGLISS";"S";"0161";"* --------------------------------"
"SGCSEGLISS";"S";"0162";"LOCA_DATE(5:4) = HJOU_IJIDFIN(5:4)"
"SGCSEGLISS";"S";"0163";"LOCA_ACOURS << TEMP_DATJOU(1:4)"
"SGCSEGLISS";"S";"0164";"SI TEMP_DATJOU(5:4) > HJOU_IJIDFIN(5:4)"
"SGCSEGLISS";"S";"0165";"   LOCA_ACOURS = LOCA_ACOURS + 1"
"SGCSEGLISS";"S";"0166";"FINSI"
"SGCSEGLISS";"S";"0167";"LOCA_DATE(1:4) << LOCA_ACOURS"
"SGCSEGLISS";"S";"0168";"*"
"SGCSEGLISS";"S";"0169";"SI HJOU_IJIDFIN <> "" """
"SGCSEGLISS";"S";"0170";"   SI HJOU_DATE <= HJOU_IJIDFIN"
"SGCSEGLISS";"S";"0171";"*"
"SGCSEGLISS";"S";"0172";"* Identification suppléant >>"
"SGCSEGLISS";"S";"0173";"      SI HJOU_IJIDACSEM = 0.00"
"SGCSEGLISS";"S";"0174";"         LOCA_SUPPLEANT = 1"
"SGCSEGLISS";"S";"0175";"      FINSI"
"SGCSEGLISS";"S";"0176";"*"
"SGCSEGLISS";"S";"0177";"* --------------"
"SGCSEGLISS";"S";"0178";"* Forfait heures"
"SGCSEGLISS";"S";"0179";"* --------------"
"SGCSEGLISS";"S";"0180";"*   SI HORC_IHINFORFJ <> ""1"""
"SGCSEGLISS";"S";"0181";"* la période retenue est la période d'annualisation"
"SGCSEGLISS";"S";"0182";"      SI HJOU_DATE = PARD_IDIDDEBANN"
"SGCSEGLISS";"S";"0183";"         HJOU_IJRADCSE = 0"
"SGCSEGLISS";"S";"0184";"         HJOU_IJRAPCSE = 0"
"SGCSEGLISS";"S";"0185";"         HJOU_IJRATCSE = 0"
"SGCSEGLISS";"S";"0186";"         HJOU_IJRASCSE = HJOU_IJRADCSE - HJOU_IJRAPCSE"
"SGCSEGLISS";"S";"0187";"         HJOU_IJRASCSE = HJOU_IJRASCSE + HJOU_IJRATCSE"
"SGCSEGLISS";"S";"0188";"      FINSI"
"SGCSEGLISS";"S";"0189";"* -------------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0190";"* Initialisation du droit et remise à 0 des compteurs pris et transférés mensuels"
"SGCSEGLISS";"S";"0191";"* -------------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0192";"      SI HJOU_DATE(7:2) = ""01"""
"SGCSEGLISS";"S";"0193";"*RAZ du cumul pris mensuel"
"SGCSEGLISS";"S";"0194";"         HJOU_IJRCUPMCSE = 0"
"SGCSEGLISS";"S";"0195";"* Perte du transfert annuel >>"
"SGCSEGLISS";"S";"0196";"*"
"SGCSEGLISS";"S";"0197";"         HJOU_IJRMDCSE11 = HJOU_IJRMDCSE10"
"SGCSEGLISS";"S";"0198";"         HJOU_IJRMDCSE10 = HJOU_IJRMDCSE9"
"SGCSEGLISS";"S";"0199";"         HJOU_IJRMDCSE9 = HJOU_IJRMDCSE8"
"SGCSEGLISS";"S";"0200";"         HJOU_IJRMDCSE8 = HJOU_IJRMDCSE7"
"SGCSEGLISS";"S";"0201";"         HJOU_IJRMDCSE7 = HJOU_IJRMDCSE6"
"SGCSEGLISS";"S";"0202";"         HJOU_IJRMDCSE6 = HJOU_IJRMDCSE5"
"SGCSEGLISS";"S";"0203";"         HJOU_IJRMDCSE5 = HJOU_IJRMDCSE4"
"SGCSEGLISS";"S";"0204";"         HJOU_IJRMDCSE4 = HJOU_IJRMDCSE3"
"SGCSEGLISS";"S";"0205";"         HJOU_IJRMDCSE3 = HJOU_IJRMDCSE2"
"SGCSEGLISS";"S";"0206";"         HJOU_IJRMDCSE2 = HJOU_IJRMDCSE1"
"SGCSEGLISS";"S";"0207";"*"
"SGCSEGLISS";"S";"0208";"* Si heures reçues d'un transfert CSE (positif) celui-ci est perdu >>"
"SGCSEGLISS";"S";"0209";"         SI HJOU_IJRMTCSE > 0"
"SGCSEGLISS";"S";"0210";"            HJOU_IJRMDCSE1 = HJOU_IJRMSCSE - HJOU_IJRMTCSE"
"SGCSEGLISS";"S";"0211";"            SI HJOU_IJRMDCSE1 < 0"
"SGCSEGLISS";"S";"0212";"               HJOU_IJRMDCSE1 = 0"
"SGCSEGLISS";"S";"0213";"            FINSI"
"SGCSEGLISS";"S";"0214";"            HJOU_IJRATCSE = HJOU_IJRATCSE - HJOU_IJRMTCSE"
"SGCSEGLISS";"S";"0215";"         SINON"
"SGCSEGLISS";"S";"0216";"            HJOU_IJRMDCSE1 = HJOU_IJRMSCSE"
"SGCSEGLISS";"S";"0217";"         FINSI"
"SGCSEGLISS";"S";"0218";"*"
"SGCSEGLISS";"S";"0219";"         HJOU_IJRMDCSE = HJOU_IJIDACSET / 12"
"SGCSEGLISS";"S";"0220";"* -------------------------------------------"
"SGCSEGLISS";"S";"0221";"* Consigne de majoration mensuelle des droits"
"SGCSEGLISS";"S";"0222";"* -------------------------------------------"
"SGCSEGLISS";"S";"0223";"         POUR ACTIVITES"
"SGCSEGLISS";"S";"0224";"            SI HABS_MOTIF = ""ZMACSE"""
"SGCSEGLISS";"S";"0225";"               LOCA_MAJO = 1"
"SGCSEGLISS";"S";"0226";"            FINSI"
"SGCSEGLISS";"S";"0227";"         FINPOUR"
"SGCSEGLISS";"S";"0228";"         SI LOCA_MAJO = 1"
"SGCSEGLISS";"S";"0229";"            HJOU_IJRMDCSE = HJOU_IJRMDCSE * LOCA_TAUX"
"SGCSEGLISS";"S";"0230";"         FINSI"
"SGCSEGLISS";"S";"0231";"         HJOU_IJRADCSE = HJOU_IJRADCSE + HJOU_IJRMDCSE"
"SGCSEGLISS";"S";"0232";"         HJOU_IJRMPCSE = 0"
"SGCSEGLISS";"S";"0233";"         HJOU_IJRMTCSE = 0"
"SGCSEGLISS";"S";"0234";"* ----------------------"
"SGCSEGLISS";"S";"0235";"* Mise à jour des soldes"
"SGCSEGLISS";"S";"0236";"* ----------------------"
"SGCSEGLISS";"S";"0237";"         HJOU_IJRMSCSE = HJOU_IJRMDCSE - HJOU_IJRMPCSE"
"SGCSEGLISS";"S";"0238";"         HJOU_IJRMSCSE = HJOU_IJRMSCSE + HJOU_IJRMTCSE"
"SGCSEGLISS";"S";"0239";"         HJOU_IJRASCSE = HJOU_IJRADCSE - HJOU_IJRAPCSE"
"SGCSEGLISS";"S";"0240";"         HJOU_IJRASCSE = HJOU_IJRASCSE + HJOU_IJRATCSE"
"SGCSEGLISS";"S";"0241";"      FINSI"
"SGCSEGLISS";"S";"0242";"*"
"SGCSEGLISS";"S";"0243";"* ------------------"
"SGCSEGLISS";"S";"0244";"* Analyse des consignes"
"SGCSEGLISS";"S";"0245";"* ------------------"
"SGCSEGLISS";"S";"0246";"      POUR ACTIVITES"
"SGCSEGLISS";"S";"0247";"* -----------------"
"SGCSEGLISS";"S";"0248";"* Droit CSE mensuel"
"SGCSEGLISS";"S";"0249";"* -----------------"
"SGCSEGLISS";"S";"0250";"         SI HABS_MOTIF = ""ZDCSE"""
"SGCSEGLISS";"S";"0251";"            LOCA_MENS = 1"
"SGCSEGLISS";"S";"0252";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMDCSE"
"SGCSEGLISS";"S";"0253";"            HJOU_IJRMDCSE = HABS_MOTIDUR"
"SGCSEGLISS";"S";"0254";"            HJOU_IJRADCSE = HJOU_IJRADCSE + LOCA_MAJD"
"SGCSEGLISS";"S";"0255";"         FINSI"
"SGCSEGLISS";"S";"0256";"         SI HABS_MOTIF = ""XDCSE"""
"SGCSEGLISS";"S";"0257";"            LOCA_MENS = 1"
"SGCSEGLISS";"S";"0258";"            HJOU_IJRMDCSE = HJOU_IJRMDCSE + HABS_MOTIDUR"
"SGCSEGLISS";"S";"0259";"            HJOU_IJRADCSE = HJOU_IJRADCSE + HABS_MOTIDUR"
"SGCSEGLISS";"S";"0260";"         FINSI"
"SGCSEGLISS";"S";"0261";"* ----------------"
"SGCSEGLISS";"S";"0262";"* Pris CSE mensuel"
"SGCSEGLISS";"S";"0263";"* ----------------"
"SGCSEGLISS";"S";"0264";"         SI HABS_MOTIF = ""ZPCSE"""
"SGCSEGLISS";"S";"0265";"            LOCA_MENS = 1"
"SGCSEGLISS";"S";"0266";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMPCSE"
"SGCSEGLISS";"S";"0267";"            HJOU_IJRMPCSE = HABS_MOTIDUR"
"SGCSEGLISS";"S";"0268";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + LOCA_MAJD"
"SGCSEGLISS";"S";"0269";"         FINSI"
"SGCSEGLISS";"S";"0270";"         SI HABS_MOTIF = ""XPCSE"""
"SGCSEGLISS";"S";"0271";"            LOCA_MENS = 1"
"SGCSEGLISS";"S";"0272";"            HJOU_IJRMPCSE = HJOU_IJRMPCSE + HABS_MOTIDUR"
"SGCSEGLISS";"S";"0273";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + HABS_MOTIDUR"
"SGCSEGLISS";"S";"0274";"         FINSI"
"SGCSEGLISS";"S";"0275";"* ----------------"
"SGCSEGLISS";"S";"0276";"* Transfert CSE mensuel"
"SGCSEGLISS";"S";"0277";"* ----------------"
"SGCSEGLISS";"S";"0278";"         SI HABS_MOTIF = ""ZTCSE"""
"SGCSEGLISS";"S";"0279";"            LOCA_MENS2 = 1"
"SGCSEGLISS";"S";"0280";"            LOCA_MAJD = HABS_MOTIDUR - HJOU_IJRMTCSE"
"SGCSEGLISS";"S";"0281";"            HJOU_IJRMTCSE = HABS_MOTIDUR"
"SGCSEGLISS";"S";"0282";"            HJOU_IJRATCSE = HJOU_IJRATCSE + LOCA_MAJD"
"SGCSEGLISS";"S";"0283";"         FINSI"
"SGCSEGLISS";"S";"0284";"         SI HABS_MOTIF = ""XTCSE"""
"SGCSEGLISS";"S";"0285";"            LOCA_MENS2 = 1"
"SGCSEGLISS";"S";"0286";"            HJOU_IJRMTCSE = HJOU_IJRMTCSE + HABS_MOTIDUR"
"SGCSEGLISS";"S";"0287";"            HJOU_IJRATCSE = HJOU_IJRATCSE + HABS_MOTIDUR"
"SGCSEGLISS";"S";"0288";"         FINSI"
"SGCSEGLISS";"S";"0289";"* -----------------------------"
"SGCSEGLISS";"S";"0290";"* Motif de demande de transfert"
"SGCSEGLISS";"S";"0291";"* -----------------------------"
"SGCSEGLISS";"S";"0292";"         SI HABS_MOTYPE = ""C"""
"SGCSEGLISS";"S";"0293";"            SI MOTI_IMIMATRICS <> "" """
"SGCSEGLISS";"S";"0294";"*"
"SGCSEGLISS";"S";"0295";"*               HJOU_IJRMTCSE = HJOU_IJRMTCSE - HABS_MOTIDUR"
"SGCSEGLISS";"S";"0296";"*               HJOU_IJRATCSE = HJOU_IJRATCSE - HABS_MOTIDUR"
"SGCSEGLISS";"S";"0297";"               SI MOTI_IMIMATRICS = HJOU_MATRI"
"SGCSEGLISS";"S";"0298";"                  ANOMALIE 220"
"SGCSEGLISS";"S";"0299";"                  SI TEMP_CNMOTIF = HABS_MOTIF"
"SGCSEGLISS";"S";"0300";"                     TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0301";"                     TEMP_CNMESS = 220"
"SGCSEGLISS";"S";"0302";"                  FINSI"
"SGCSEGLISS";"S";"0303";"               FINSI"
"SGCSEGLISS";"S";"0304";"*"
"SGCSEGLISS";"S";"0305";"* Vérification de la société >>"
"SGCSEGLISS";"S";"0306";"               SI MOTI_SMISOCIETE <> "" """
"SGCSEGLISS";"S";"0307";"                  SI MOTI_SMISOCIETE <> HJOU_SJQSOCIETE"
"SGCSEGLISS";"S";"0308";"                     LOCA_ANOTR = 1"
"SGCSEGLISS";"S";"0309";"* Droit de transférer les heures entres les sociétés MO, IR et VH"
"SGCSEGLISS";"S";"0310";"                     SI MOTI_SMISOCIETE = ""MO"""
"SGCSEGLISS";"S";"0311";"                        SI HJOU_SJQSOCIETE = ""IR"""
"SGCSEGLISS";"S";"0312";"                        OU HJOU_SJQSOCIETE = ""VH"""
"SGCSEGLISS";"S";"0313";"                           LOCA_ANOTR = 9"
"SGCSEGLISS";"S";"0314";"                        FINSI"
"SGCSEGLISS";"S";"0315";"                     FINSI"
"SGCSEGLISS";"S";"0316";"                     SI MOTI_SMISOCIETE = ""IR"""
"SGCSEGLISS";"S";"0317";"                        SI HJOU_SJQSOCIETE = ""MO"""
"SGCSEGLISS";"S";"0318";"                        OU HJOU_SJQSOCIETE = ""VH"""
"SGCSEGLISS";"S";"0319";"                           LOCA_ANOTR = 9"
"SGCSEGLISS";"S";"0320";"                        FINSI"
"SGCSEGLISS";"S";"0321";"                     FINSI"
"SGCSEGLISS";"S";"0322";"                     SI MOTI_SMISOCIETE = ""VH"""
"SGCSEGLISS";"S";"0323";"                        SI HJOU_SJQSOCIETE = ""IR"""
"SGCSEGLISS";"S";"0324";"                        OU HJOU_SJQSOCIETE = ""MO"""
"SGCSEGLISS";"S";"0325";"                           LOCA_ANOTR = 9"
"SGCSEGLISS";"S";"0326";"                        FINSI"
"SGCSEGLISS";"S";"0327";"                     FINSI"
"SGCSEGLISS";"S";"0328";"*"
"SGCSEGLISS";"S";"0329";"* Déclenchement de l'anomalie"
"SGCSEGLISS";"S";"0330";"                     SI LOCA_ANOTR = 1"
"SGCSEGLISS";"S";"0331";"                        ANOMALIE 305"
"SGCSEGLISS";"S";"0332";"                        SI TEMP_CNMOTIF = HABS_MOTIF"
"SGCSEGLISS";"S";"0333";"                           TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0334";"                           TEMP_CNMESS = 305"
"SGCSEGLISS";"S";"0335";"                        FINSI"
"SGCSEGLISS";"S";"0336";"                     FINSI"
"SGCSEGLISS";"S";"0337";"*"
"SGCSEGLISS";"S";"0338";"                  FINSI"
"SGCSEGLISS";"S";"0339";"               FINSI"
"SGCSEGLISS";"S";"0340";"* Fin vérification Société <<"
"SGCSEGLISS";"S";"0341";"*"
"SGCSEGLISS";"S";"0342";"            FINSI"
