"SHREFF";"S";"0050";"DEF LOCA_NULL T6.2"
"SHREFF";"S";"0051";"LOCA_NULL = 545.00"
"SHREFF";"S";"0052";"*"
"SHREFF";"S";"0053";"POUR ACTIVITES"
"SHREFF";"S";"0054";"   SI HABS_MOTIF = ""JF"""
"SHREFF";"S";"0055";"      LOCA_FERI = 1"
"SHREFF";"S";"0056";"   FINSI"
"SHREFF";"S";"0057";"FINPOUR"
"SHREFF";"S";"0058";"*"
"SHREFF";"S";"0059";"* si on est dans le futur"
"SHREFF";"S";"0060";"* on positionne la variable INBADG à 0"
"SHREFF";"S";"0061";"* ce qui permet de traiter les badgeants comme des non badgeants"
"SHREFF";"S";"0062";"* afin d'alimenter une présence badgéé fictive (HJPOINV)qui correspond"
"SHREFF";"S";"0063";"* à la théorie - les motifs d'absences non créditeur"
"SHREFF";"S";"0064";"*"
"SHREFF";"S";"0065";"* Vérif si forfait jour"
"SHREFF";"S";"0066";"SI HJOU_SJQFORFJR = ""1"""
"SHREFF";"S";"0067";"   LOCA_FORFJ = 1"
"SHREFF";"S";"0068";"FINSI"
"SHREFF";"S";"0069";"*"
"SHREFF";"S";"0070";"SI LOCA_FORFJ <> 1"
"SHREFF";"S";"0071";"*"
"SHREFF";"S";"0072";"****** Calcul TTE HORS forfait jour >>"
"SHREFF";"S";"0073";"*"
"SHREFF";"S";"0074";"   SI HJOU_DATE <= TEMP_DATJOU"
"SHREFF";"S";"0075";"      LOCA_INBADG = HJOU_IJIGBADGEA"
"SHREFF";"S";"0076";"   SINON"
"SHREFF";"S";"0077";"      LOCA_INBADG = ""0"""
"SHREFF";"S";"0078";"   FINSI"
"SHREFF";"S";"0079";"*"
"SHREFF";"S";"0080";"* HJOU_IJQTTEFFEJ = HJOU_IJQPRESBAV"
"SHREFF";"S";"0081";"   HJOU_IJQTTEFFEJ = HJOU_IJQPRESEFF"
"SHREFF";"S";"0082";"*"
"SHREFF";"S";"0083";"   POUR ACTIVITES"
"SHREFF";"S";"0084";"      SI MOTI_MOTYPE <> ""C"""
"SHREFF";"S";"0085";"*"
"SHREFF";"S";"0086";"* Si pas de plage"
"SHREFF";"S";"0087";"         SI HJOU_IJQMVTENT1 = HJOU_IJQMVTSOR1"
"SHREFF";"S";"0088";"            SI MOTI_IMIGTTEFFE = ""1"""
"SHREFF";"S";"0089";"               SI HABS_VALORIS = ""H"""
"SHREFF";"S";"0090";"                  SI HABS_HRAFIN = LOCA_NULL"
"SHREFF";"S";"0091";"                     HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ + HABS_MOTIDUR"
"SHREFF";"S";"0092";"                  FINSI"
"SHREFF";"S";"0093";"               FINSI"
"SHREFF";"S";"0094";"            SINON"
"SHREFF";"S";"0095";"               HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ - HABS_MOTIDUR"
"SHREFF";"S";"0096";"            FINSI"
"SHREFF";"S";"0097";"         SINON"
"SHREFF";"S";"0098";"            SI HABS_VALORIS = ""H"""
"SHREFF";"S";"0099";"               SI HABS_HRAFIN = LOCA_NULL"
"SHREFF";"S";"0100";"                  SI MOTI_IMIGTTEFFE = ""1"""
"SHREFF";"S";"0101";"                     HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ + HABS_MOTIDUR"
"SHREFF";"S";"0102";"                  SINON"
"SHREFF";"S";"0103";"                     HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ - HABS_MOTIDUR"
"SHREFF";"S";"0104";"                  FINSI"
"SHREFF";"S";"0105";"               FINSI"
"SHREFF";"S";"0106";"            FINSI"
"SHREFF";"S";"0107";"         FINSI"
"SHREFF";"S";"0108";"*"
"SHREFF";"S";"0109";"      FINSI"
"SHREFF";"S";"0110";"   FINPOUR"
"SHREFF";"S";"0111";"*"
"SHREFF";"S";"0112";"SINON"
"SHREFF";"S";"0113";"*"
"SHREFF";"S";"0114";"****** Calcul TTE POUR forfait jour >>"
"SHREFF";"S";"0115";"*"
"SHREFF";"S";"0116";"   SI HJOU_IJQPRETHEJ = 0"
"SHREFF";"S";"0117";"   OU LOCA_FERI = 1"
"SHREFF";"S";"0118";"* Cas sur journée de repos >>"
"SHREFF";"S";"0119";"*"
"SHREFF";"S";"0120";"      POUR ACTIVITES"
"SHREFF";"S";"0121";"         SI HABS_MOTYPE <> ""C"""
"SHREFF";"S";"0122";"            SI MOTI_IMIGTTEFFE = ""1"""
"SHREFF";"S";"0123";"               LOCA_TTE = LOCA_TTE + HABS_MOTIDUR"
"SHREFF";"S";"0124";"            FINSI"
"SHREFF";"S";"0125";"         FINSI"
"SHREFF";"S";"0126";"         SI HABS_MOTIF = PARD_SDIVPRES"
"SHREFF";"S";"0127";"            SI HABS_VALORIS = ""J"""
"SHREFF";"S";"0128";"               LOCA_TTE = LOCA_TTE + LOCA_THFJ"
"SHREFF";"S";"0129";"            SINON"
"SHREFF";"S";"0130";"               LOCA_TTE = LOCA_TTE + LOCA_THFJ2"
"SHREFF";"S";"0131";"            FINSI"
"SHREFF";"S";"0132";"         FINSI"
"SHREFF";"S";"0133";"* Inter. Astreinte ?"
"SHREFF";"S";"0134";"         SI HABS_MOTIF = PARD_SDIVMINTA"
"SHREFF";"S";"0135";"            LOCA_TTE = LOCA_TTE + HABS_MOTIDUR"
"SHREFF";"S";"0136";"         FINSI"
"SHREFF";"S";"0137";"      FINPOUR"
"SHREFF";"S";"0138";"*"
"SHREFF";"S";"0139";"      SI LOCA_TTE > LOCA_THFJ"
"SHREFF";"S";"0140";"         LOCA_TTE = LOCA_THFJ"
"SHREFF";"S";"0141";"      FINSI"
"SHREFF";"S";"0142";"*"
"SHREFF";"S";"0143";"   SINON"
"SHREFF";"S";"0144";"*  Cas sur journée travaillés >>"
"SHREFF";"S";"0145";"*"
"SHREFF";"S";"0146";"      LOCA_TTE = HJOU_IJQPRETHEJ"
"SHREFF";"S";"0147";"*"
"SHREFF";"S";"0148";"      POUR ACTIVITES"
"SHREFF";"S";"0149";"         SI HABS_MOTYPE <> ""C"""
"SHREFF";"S";"0150";"            SI MOTI_IMIGTTEFFE = ""1"""
"SHREFF";"S";"0151";"               SI HABS_VALORIS = ""H"""
"SHREFF";"S";"0152";"                  LOCA_TTE = LOCA_TTE + HABS_MOTIDUR"
"SHREFF";"S";"0153";"               FINSI"
"SHREFF";"S";"0154";"            SINON"
"SHREFF";"S";"0155";"               LOCA_TTE = LOCA_TTE - HABS_MOTIDUR"
"SHREFF";"S";"0156";"            FINSI"
"SHREFF";"S";"0157";"         FINSI"
"SHREFF";"S";"0158";"* Inter. Astreinte ?"
"SHREFF";"S";"0159";"         SI HABS_MOTIF = PARD_SDIVMINTA"
"SHREFF";"S";"0160";"            LOCA_TTE = LOCA_TTE + HABS_MOTIDUR"
"SHREFF";"S";"0161";"         FINSI"
"SHREFF";"S";"0162";"      FINPOUR"
"SHREFF";"S";"0163";"*"
"SHREFF";"S";"0164";"* Cas des profils demi-journée"
"SHREFF";"S";"0165";"      SI PROF_ABSENM = 0"
"SHREFF";"S";"0166";"      OU PROF_ABSENS = 0"
"SHREFF";"S";"0167";"* Bloque TTE en fonction de la théorie de CFG"
"SHREFF";"S";"0168";"         SI LOCA_TTE > LOCA_THFJ"
"SHREFF";"S";"0169";"            LOCA_TTE = LOCA_THFJ"
"SHREFF";"S";"0170";"         FINSI"
"SHREFF";"S";"0171";"      SINON"
"SHREFF";"S";"0172";"* Bloque TTE en fonction de la théorie de PRO"
"SHREFF";"S";"0173";"         SI LOCA_TTE > HJOU_IJQPRETHEJ"
"SHREFF";"S";"0174";"            LOCA_TTE = HJOU_IJQPRETHEJ"
"SHREFF";"S";"0175";"         FINSI"
"SHREFF";"S";"0176";"      FINSI"
"SHREFF";"S";"0177";"*"
"SHREFF";"S";"0178";"   FINSI"
"SHREFF";"S";"0179";"*"
"SHREFF";"S";"0180";"   SI HJOU_DATE <= TEMP_DATJOU"
"SHREFF";"S";"0181";"      HJOU_IJQTTEFFEJ = LOCA_TTE"
"SHREFF";"S";"0182";"   FINSI"
"SHREFF";"S";"0183";"*"
"SHREFF";"S";"0184";"FINSI"
"SHREFF";"S";"0185";"*"
"SHREFF";"S";"0186";"*** ecretage des heures effectives"
"SHREFF";"S";"0187";"SI HJOU_IJQTTEFFEJ > PROF_ECRJOU"
"SHREFF";"S";"0188";"   HJOU_IJQTTEFFEJ = PROF_ECRJOU"
"SHREFF";"S";"0189";"FINSI"
"SHREFF";"S";"0190";"*"
"SHREFF";"S";"0191";"* Ajout de la pause payée >>"
"SHREFF";"S";"0192";"SI HJOU_SECTORI(1:3) = ""DIN"""
"SHREFF";"S";"0193";"   SI HJOU_SJQFORFJR <> ""1"""
"SHREFF";"S";"0194";"      SI PROF_SPIPAUSPAI > 0"
"SHREFF";"S";"0195";"         SI HJOU_IJQTTEFFEJ > 0"
"SHREFF";"S";"0196";"            SI HJOU_IJQTTEFFEJ > PROF_SPIPAUSPAI"
"SHREFF";"S";"0197";"               HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ + PROF_SPIPAUSPAI"
"SHREFF";"S";"0198";"            FINSI"
"SHREFF";"S";"0199";"         FINSI"
"SHREFF";"S";"0200";"      FINSI"
"SHREFF";"S";"0201";"   FINSI"
"SHREFF";"S";"0202";"FINSI"
"SHREFF";"S";"0203";"*"
"SHREFF";"S";"0204";"*  alimentation par consignes"
"SHREFF";"S";"0205";"POUR ACTIVITES"
"SHREFF";"S";"0206";"   SI HABS_MOTIF = ""XEFF"""
"SHREFF";"S";"0207";"      HJOU_IJQTTEFFEJ = HJOU_IJQTTEFFEJ + HABS_MOTIDUR"
"SHREFF";"S";"0208";"   FINSI"
"SHREFF";"S";"0209";"   SI HABS_MOTIF = ""ZEFF"""
"SHREFF";"S";"0210";"      HJOU_IJQTTEFFEJ = HABS_MOTIDUR"
"SHREFF";"S";"0211";"   FINSI"
"SHREFF";"S";"0212";"FINPOUR"
"SHREFF";"S";"0213";"SI HJOU_IJQTTEFFEJ < 0"
"SHREFF";"S";"0214";"   HJOU_IJQTTEFFEJ = 0"
"SHREFF";"S";"0215";"FINSI"
"SHREFF";"S";"0216";"*"
"SHREFF";"S";"0217";"****** Calcul des heures payées jour >>"
"SHREFF";"S";"0218";"*"
"SHREFF";"S";"0219";"HJOU_IJQHPAYEES = HJOU_IJQTTEFFEJ"
"SHREFF";"S";"0220";"*"
"SHREFF";"S";"0221";"POUR ACTIVITES"
"SHREFF";"S";"0222";"   SI MOTI_MOTYPE <> ""C"""
"SHREFF";"S";"0223";"      SI MOTI_IMIGTTEFFE <> ""1"""
"SHREFF";"S";"0224";"*            SI MOTI_IMIGHRSSUP = ""1"""
"SHREFF";"S";"0225";"         SI MOTI_IMIGHRPAYE = ""1"""
"SHREFF";"S";"0226";"            HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"SHREFF";"S";"0227";"         FINSI"
"SHREFF";"S";"0228";"      FINSI"
"SHREFF";"S";"0229";"   FINSI"
"SHREFF";"S";"0230";"*"
"SHREFF";"S";"0231";"* Alimentation par consignes"
"SHREFF";"S";"0232";"   SI HABS_MOTIF = ""ZHPA"""
"SHREFF";"S";"0233";"      HJOU_IJQHPAYEES = HABS_MOTIDUR"
"SHREFF";"S";"0234";"   FINSI"
"SHREFF";"S";"0235";"   SI HABS_MOTIF = ""XHPA"""
"SHREFF";"S";"0236";"      HJOU_IJQHPAYEES = HJOU_IJQHPAYEES + HABS_MOTIDUR"
"SHREFF";"S";"0237";"   FINSI"
"SHREFF";"S";"0238";"FINPOUR"
"SHREFF";"S";"0239";"*"
"SHREFF";"S";"0240";"* Si forfait jour on peut pas dépasser 7h"
"SHREFF";"S";"0241";"SI LOCA_FERI = 1"
"SHREFF";"S";"0242";"   SI HJOU_SJQFORFJR = ""1"""
"SHREFF";"S";"0243";"      SI HJOU_IJQTTEFFEJ >= HJOU_IJQPRETHEJ"
"SHREFF";"S";"0244";"         SI HJOU_IJQHPAYEES > HJOU_IJQTTEFFEJ"
"SHREFF";"S";"0245";"            HJOU_IJQHPAYEES = HJOU_IJQTTEFFEJ"
"SHREFF";"S";"0246";"         FINSI"
"SHREFF";"S";"0247";"      SINON"
"SHREFF";"S";"0248";"         SI HJOU_IJQHPAYEES > HJOU_IJQPRETHEJ"
"SHREFF";"S";"0249";"            HJOU_IJQHPAYEES = HJOU_IJQPRETHEJ"
"SHREFF";"S";"0250";"         FINSI"
"SHREFF";"S";"0251";"      FINSI"
"SHREFF";"S";"0252";"   FINSI"
"SHREFF";"S";"0253";"FINSI"
"SHREFF";"S";"0254";"*"
"SHREFF";"S";"0255";"FIN"
