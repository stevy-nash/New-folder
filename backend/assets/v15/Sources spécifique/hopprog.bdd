"SHSUPPDIM2";"S";"1808";"      SINON"
"SHSUPPDIM2";"S";"1809";"         SI LOCA_MOTS > LOCA_MVS"
"SHSUPPDIM2";"S";"1810";"            LOCA_DURC = LOCA_MVS - LOCA_MVE"
"SHSUPPDIM2";"S";"1811";"         SINON"
"SHSUPPDIM2";"S";"1812";"            SI LOCA_MOTS > LOCA_MVE"
"SHSUPPDIM2";"S";"1813";"               LOCA_DURC = LOCA_MOTS - LOCA_MVE"
"SHSUPPDIM2";"S";"1814";"            FINSI"
"SHSUPPDIM2";"S";"1815";"         FINSI"
"SHSUPPDIM2";"S";"1816";"      FINSI"
"SHSUPPDIM2";"S";"1817";"   FINSI"
"SHSUPPDIM2";"S";"1818";"FINPROC"
"SHSUPPDIM2";"S";"1819";"*"
"SHSUPPDIM2";"S";"1820";"*"
"SINTREDAC";"S";"0001";"***********************************************************************"
"SINTREDAC";"S";"0002";"*"
"SINTREDAC";"S";"0003";"* Règle : SINTREDAC"
"SINTREDAC";"S";"0004";"* Ordre : 8700"
"SINTREDAC";"S";"0005";"* Titre : GCF : Interface pour agenda rédactionnel"
"SINTREDAC";"S";"0006";"*"
"SINTREDAC";"S";"0007";"*----------------------------------------------------------------------"
"SINTREDAC";"S";"0008";"*"
"SINTREDAC";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SINTREDAC";"S";"0010";"* Date     : 31/01/2025"
"SINTREDAC";"S";"0011";"* Version  : 1"
"SINTREDAC";"S";"0012";"*"
"SINTREDAC";"S";"0013";"*----------------------------------------------------------------------"
"SINTREDAC";"S";"0014";"*"
"SINTREDAC";"S";"0015";"*"
"SINTREDAC";"S";"0016";"* Rôle : Mise à jour de consigne de travail, repos et TT en auto à envoyer à l'agenda rédac."
"SINTREDAC";"S";"0017";"*"
"SINTREDAC";"S";"0018";"*"
"SINTREDAC";"S";"0019";"*----------------------------------------------------------------------"
"SINTREDAC";"S";"0020";"*"
"SINTREDAC";"S";"0021";"* Modifiée par :"
"SINTREDAC";"S";"0022";"* Date         :"
"SINTREDAC";"S";"0023";"* Objet        :"
"SINTREDAC";"S";"0024";"*"
"SINTREDAC";"S";"0025";"***********************************************************************"
"SINTREDAC";"S";"0026";"*"
"SINTREDAC";"S";"0027";"* Implémentation des données industrielles"
"SINTREDAC";"S";"0028";"*"
"SINTREDAC";"S";"0029";"DEBDICO"
"SINTREDAC";"S";"0030";"   HJOU_SJIINREDA;N;Z1;X;;;        9;L9;;C2;""A envoyer à l'agenda rédactionnel"";"
"SINTREDAC";"S";"0031";"FINDICO"
"SINTREDAC";"S";"0032";"*"
"SINTREDAC";"S";"0033";"* Déclaration des données locales"
"SINTREDAC";"S";"0034";"*"
"SINTREDAC";"S";"0035";"DEF LOCA_ABS A3"
"SINTREDAC";"S";"0036";"LOCA_ABS = "" """
"SINTREDAC";"S";"0037";"DEF LOCA_TT A3"
"SINTREDAC";"S";"0038";"LOCA_TT = "" """
"SINTREDAC";"S";"0039";"DEF LOCA_FOR A3"
"SINTREDAC";"S";"0040";"LOCA_FOR = "" """
"SINTREDAC";"S";"0041";"DEF LOCA_REPOS A3"
"SINTREDAC";"S";"0042";"LOCA_REPOS = "" """
"SINTREDAC";"S";"0043";"DEF LOCA_TRAV A3"
"SINTREDAC";"S";"0044";"LOCA_TRAV = "" """
"SINTREDAC";"S";"0045";"* Permet de savoir si journée couverte par consigne"
"SINTREDAC";"S";"0046";"DEF LOCA_AJT A3"
"SINTREDAC";"S";"0047";"LOCA_AJT = "" """
"SINTREDAC";"S";"0048";"DEF LOCA_DATE D"
"SINTREDAC";"S";"0049";"LOCA_DATE = "" """
"SINTREDAC";"S";"0050";"*"
"SINTREDAC";"S";"0051";"DEF LOCA_ABSENJ T6.2"
"SINTREDAC";"S";"0052";"LOCA_ABSENJ = PROF_ABSENJ"
"SINTREDAC";"S";"0053";"DEF LOCA_ABSENM T6.2"
"SINTREDAC";"S";"0054";"LOCA_ABSENM = PROF_ABSENM"
"SINTREDAC";"S";"0055";"DEF LOCA_ABSENS T6.2"
"SINTREDAC";"S";"0056";"LOCA_ABSENS = PROF_ABSENS"
"SINTREDAC";"S";"0057";"*"
"SINTREDAC";"S";"0058";"* RAZ des consignes"
"SINTREDAC";"S";"0059";"*"
"SINTREDAC";"S";"0060";"* T = Travailles"
"SINTREDAC";"S";"0061";"ENLEVER ""T"""
"SINTREDAC";"S";"0062";"ENLEVER ""T"""
"SINTREDAC";"S";"0063";"ENLEVER ""T"""
"SINTREDAC";"S";"0064";"* TT = Télétravail"
"SINTREDAC";"S";"0065";"ENLEVER ""TT"""
"SINTREDAC";"S";"0066";"ENLEVER ""TT"""
"SINTREDAC";"S";"0067";"ENLEVER ""TT"""
"SINTREDAC";"S";"0068";"* F = Formation"
"SINTREDAC";"S";"0069";"ENLEVER ""F"""
"SINTREDAC";"S";"0070";"ENLEVER ""F"""
"SINTREDAC";"S";"0071";"ENLEVER ""F"""
"SINTREDAC";"S";"0072";"* A = Absence"
"SINTREDAC";"S";"0073";"ENLEVER ""A"""
"SINTREDAC";"S";"0074";"ENLEVER ""A"""
"SINTREDAC";"S";"0075";"ENLEVER ""A"""
"SINTREDAC";"S";"0076";"* R = Repos"
"SINTREDAC";"S";"0077";"ENLEVER ""R"""
"SINTREDAC";"S";"0078";"ENLEVER ""R"""
"SINTREDAC";"S";"0079";"ENLEVER ""R"""
"SINTREDAC";"S";"0080";"*"
"SINTREDAC";"S";"0081";"* GCF - Valorisation de paie particulière pour les journalistes >>"
"SINTREDAC";"S";"0082";"*"
"SINTREDAC";"S";"0083";"SI PROF_PRETHEO > 0.02"
"SINTREDAC";"S";"0084";"   SI HJOU_SJQCATEGOR = ""J"""
"SINTREDAC";"S";"0085";"      SI HJOU_SJQFORFJR <> ""1"""
"SINTREDAC";"S";"0086";"         SI HORC_SHIHOREF > 0.00"
"SINTREDAC";"S";"0087";"* Profil de la rédaction"
"SINTREDAC";"S";"0088";"            SI HJOU_PROFIL(1:3) = ""RED"""
"SINTREDAC";"S";"0089";"               LOCA_ABSENM = HORC_SHIHOREF / 2"
"SINTREDAC";"S";"0090";"               LOCA_ABSENS = HORC_SHIHOREF / 2"
"SINTREDAC";"S";"0091";"               LOCA_ABSENJ = HORC_SHIHOREF"
"SINTREDAC";"S";"0092";"            FINSI"
"SINTREDAC";"S";"0093";"         FINSI"
"SINTREDAC";"S";"0094";"      FINSI"
"SINTREDAC";"S";"0095";"   FINSI"
"SINTREDAC";"S";"0096";"FINSI"
"SINTREDAC";"S";"0097";"*"
"SINTREDAC";"S";"0098";"* GCF - <<"
"SINTREDAC";"S";"0099";"*"
"SINTREDAC";"S";"0100";"*"
"SINTREDAC";"S";"0101";"* Collab à envoyer à l'agenda rédacctionnel ?"
"SINTREDAC";"S";"0102";"SI HJOU_SJIINREDA = ""1"""
"SINTREDAC";"S";"0103";"*"
"SINTREDAC";"S";"0104";"   POUR ACTIVITES"
"SINTREDAC";"S";"0105";"*"
"SINTREDAC";"S";"0106";"***** Analyse des absences >>"
"SINTREDAC";"S";"0107";"      SI HABS_MOTYPE <> ""C"""
"SINTREDAC";"S";"0108";"         SI MOTI_IMIGTTEFFE <> ""1"""
"SINTREDAC";"S";"0109";"* Absence jour >>"
"SINTREDAC";"S";"0110";"            SI HABS_VALORIS = ""J"""
"SINTREDAC";"S";"0111";"               LOCA_ABS = ""ABJ"""
"SINTREDAC";"S";"0112";"            FINSI"
"SINTREDAC";"S";"0113";"* Absence matin >>"
"SINTREDAC";"S";"0114";"            SI HABS_VALORIS = ""M"""
"SINTREDAC";"S";"0115";"               SI LOCA_ABS(3:1) <> ""A"""
"SINTREDAC";"S";"0116";"                  LOCA_ABS = ""ABM"""
"SINTREDAC";"S";"0117";"               SINON"
"SINTREDAC";"S";"0118";"                  LOCA_ABS = ""ABJ"""
"SINTREDAC";"S";"0119";"               FINSI"
"SINTREDAC";"S";"0120";"            FINSI"
"SINTREDAC";"S";"0121";"* Absence aprem >>"
"SINTREDAC";"S";"0122";"            SI HABS_VALORIS = ""A"""
"SINTREDAC";"S";"0123";"               SI LOCA_ABS(3:1) <> ""M"""
"SINTREDAC";"S";"0124";"                  LOCA_ABS = ""ABA"""
"SINTREDAC";"S";"0125";"               SINON"
"SINTREDAC";"S";"0126";"                  LOCA_ABS = ""ABJ"""
"SINTREDAC";"S";"0127";"               FINSI"
"SINTREDAC";"S";"0128";"            FINSI"
"SINTREDAC";"S";"0129";"         FINSI"
"SINTREDAC";"S";"0130";"      FINSI"
"SINTREDAC";"S";"0131";"*"
"SINTREDAC";"S";"0132";"***** Analyse des formations >>"
"SINTREDAC";"S";"0133";"      SI HABS_MOTIF = ""FOR"""
"SINTREDAC";"S";"0134";"* Absence jour >>"
"SINTREDAC";"S";"0135";"         SI HABS_VALORIS = ""J"""
"SINTREDAC";"S";"0136";"            LOCA_FOR = ""FOJ"""
"SINTREDAC";"S";"0137";"         FINSI"
"SINTREDAC";"S";"0138";"* Absence matin >>"
"SINTREDAC";"S";"0139";"         SI HABS_VALORIS = ""M"""
"SINTREDAC";"S";"0140";"            LOCA_FOR = ""FOM"""
"SINTREDAC";"S";"0141";"         FINSI"
"SINTREDAC";"S";"0142";"* Absence aprem >>"
"SINTREDAC";"S";"0143";"         SI HABS_VALORIS = ""A"""
"SINTREDAC";"S";"0144";"            LOCA_FOR = ""FOA"""
"SINTREDAC";"S";"0145";"         FINSI"
"SINTREDAC";"S";"0146";"      FINSI"
"SINTREDAC";"S";"0147";"*"
"SINTREDAC";"S";"0148";"***** Analyse du télétravail >>"
"SINTREDAC";"S";"0149";"      SI HABS_MOTIF = PARD_SDIVMTT"
"SINTREDAC";"S";"0150";"* Absence jour >>"
"SINTREDAC";"S";"0151";"         SI HABS_VALORIS = ""J"""
"SINTREDAC";"S";"0152";"            LOCA_TT = ""TTJ"""
"SINTREDAC";"S";"0153";"         FINSI"
"SINTREDAC";"S";"0154";"* Absence matin >>"
"SINTREDAC";"S";"0155";"         SI HABS_VALORIS = ""M"""
"SINTREDAC";"S";"0156";"            LOCA_TT = ""TTM"""
"SINTREDAC";"S";"0157";"         FINSI"
"SINTREDAC";"S";"0158";"* Absence aprem >>"
"SINTREDAC";"S";"0159";"         SI HABS_VALORIS = ""A"""
"SINTREDAC";"S";"0160";"            LOCA_TT = ""TTA"""
"SINTREDAC";"S";"0161";"         FINSI"
"SINTREDAC";"S";"0162";"      FINSI"
"SINTREDAC";"S";"0163";"*"
"SINTREDAC";"S";"0164";"   FINPOUR"
"SINTREDAC";"S";"0165";"*"
"SINTREDAC";"S";"0166";"***** Analyse du repos et jour travaillé >>"
"SINTREDAC";"S";"0167";"   SI HJOU_IJQPRETHEJ = 0"
"SINTREDAC";"S";"0168";"      LOCA_REPOS = ""REJ"""
"SINTREDAC";"S";"0169";"   SINON"
"SINTREDAC";"S";"0170";"      LOCA_TRAV = ""TRJ"""
"SINTREDAC";"S";"0171";"   FINSI"
"SINTREDAC";"S";"0172";"*"
"SINTREDAC";"S";"0173";"* Ajout des consignes par ordre de priorité >>"
"SINTREDAC";"S";"0174";"* Ordre à respecter : A > F > TT > T > R"
"SINTREDAC";"S";"0175";"*"
"SINTREDAC";"S";"0176";"* Ajouter que 6 mois dans le passé"
"SINTREDAC";"S";"0177";"   DATAJT TEMP_DATJOU 12 ""M"" -6"
"SINTREDAC";"S";"0178";"   LOCA_DATE = TEMP_DXFINPER"
"SINTREDAC";"S";"0179";"   SI HJOU_DATE < LOCA_DATE"
"SINTREDAC";"S";"0180";"* Indique la fin du traitement >>"
"SINTREDAC";"S";"0181";"      LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0182";"   FINSI"
"SINTREDAC";"S";"0183";"*"
"SINTREDAC";"S";"0184";"* Analyse si Absence"
"SINTREDAC";"S";"0185";"   SI LOCA_AJT <> ""FIN"""
"SINTREDAC";"S";"0186";"      SI LOCA_ABS <> "" """
"SINTREDAC";"S";"0187";"         SI LOCA_ABS = ""ABJ"""
"SINTREDAC";"S";"0188";"            ENLEVER ""A"""
"SINTREDAC";"S";"0189";"            AJOUTER ""A"" ""J"" LOCA_ABSENJ"
"SINTREDAC";"S";"0190";"            LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0191";"         FINSI"
"SINTREDAC";"S";"0192";"         SI LOCA_ABS = ""ABM"""
"SINTREDAC";"S";"0193";"            ENLEVER ""A"""
"SINTREDAC";"S";"0194";"            AJOUTER ""A"" ""M"" LOCA_ABSENM"
"SINTREDAC";"S";"0195";"            LOCA_AJT = LOCA_ABS"
"SINTREDAC";"S";"0196";"         FINSI"
"SINTREDAC";"S";"0197";"         SI LOCA_ABS = ""ABA"""
"SINTREDAC";"S";"0198";"            ENLEVER ""A"""
"SINTREDAC";"S";"0199";"            AJOUTER ""A"" ""A"" LOCA_ABSENS"
"SINTREDAC";"S";"0200";"            LOCA_AJT = LOCA_ABS"
"SINTREDAC";"S";"0201";"         FINSI"
"SINTREDAC";"S";"0202";"      FINSI"
"SINTREDAC";"S";"0203";"   FINSI"
"SINTREDAC";"S";"0204";"*"
"SINTREDAC";"S";"0205";"* Analyse si Formation"
"SINTREDAC";"S";"0206";"   SI LOCA_AJT <> ""FIN"""
"SINTREDAC";"S";"0207";"      SI LOCA_FOR <> "" """
"SINTREDAC";"S";"0208";"         SI LOCA_FOR = ""FOJ"""
"SINTREDAC";"S";"0209";"            ENLEVER ""F"""
"SINTREDAC";"S";"0210";"            AJOUTER ""F"" ""J"" LOCA_ABSENJ"
"SINTREDAC";"S";"0211";"            LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0212";"         FINSI"
"SINTREDAC";"S";"0213";"         SI LOCA_FOR = ""FOM"""
"SINTREDAC";"S";"0214";"            SI LOCA_ABS(3:1) <> ""M"""
"SINTREDAC";"S";"0215";"               ENLEVER ""F"""
"SINTREDAC";"S";"0216";"               AJOUTER ""F"" ""M"" LOCA_ABSENM"
"SINTREDAC";"S";"0217";"               SI LOCA_ABS(3:1) = ""A"""
"SINTREDAC";"S";"0218";"                  LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0219";"               FINSI"
"SINTREDAC";"S";"0220";"            FINSI"
"SINTREDAC";"S";"0221";"         FINSI"
"SINTREDAC";"S";"0222";"         SI LOCA_FOR = ""FOA"""
"SINTREDAC";"S";"0223";"            SI LOCA_ABS(3:1) <> ""A"""
"SINTREDAC";"S";"0224";"               ENLEVER ""F"""
"SINTREDAC";"S";"0225";"               AJOUTER ""F"" ""A"" LOCA_ABSENS"
"SINTREDAC";"S";"0226";"               SI LOCA_ABS(3:1) = ""M"""
"SINTREDAC";"S";"0227";"                  LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0228";"               FINSI"
"SINTREDAC";"S";"0229";"            FINSI"
"SINTREDAC";"S";"0230";"         FINSI"
"SINTREDAC";"S";"0231";"      FINSI"
"SINTREDAC";"S";"0232";"   FINSI"
"SINTREDAC";"S";"0233";"*"
"SINTREDAC";"S";"0234";"* Analyse si Télétravail"
"SINTREDAC";"S";"0235";"   SI LOCA_AJT <> ""FIN"""
"SINTREDAC";"S";"0236";"      SI LOCA_TT <> "" """
"SINTREDAC";"S";"0237";"         SI LOCA_TT = ""TTJ"""
"SINTREDAC";"S";"0238";"            ENLEVER ""TT"""
"SINTREDAC";"S";"0239";"            AJOUTER ""TT"" ""J"" LOCA_ABSENJ"
"SINTREDAC";"S";"0240";"            LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0241";"         FINSI"
"SINTREDAC";"S";"0242";"         SI LOCA_TT = ""TTM"""
"SINTREDAC";"S";"0243";"            SI LOCA_ABS(3:1) <> ""M"""
"SINTREDAC";"S";"0244";"            OU LOCA_FOR(3:1) <> ""M"""
"SINTREDAC";"S";"0245";"               ENLEVER ""TT"""
"SINTREDAC";"S";"0246";"               AJOUTER ""TT"" ""M"" LOCA_ABSENM"
"SINTREDAC";"S";"0247";"               SI LOCA_ABS(3:1) = ""A"""
"SINTREDAC";"S";"0248";"               OU LOCA_FOR(3:1) = ""A"""
"SINTREDAC";"S";"0249";"                  LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0250";"               FINSI"
"SINTREDAC";"S";"0251";"            FINSI"
"SINTREDAC";"S";"0252";"         FINSI"
"SINTREDAC";"S";"0253";"         SI LOCA_TT = ""TTA"""
"SINTREDAC";"S";"0254";"            SI LOCA_ABS(3:1) <> ""A"""
"SINTREDAC";"S";"0255";"            OU LOCA_FOR(3:1) <> ""A"""
"SINTREDAC";"S";"0256";"               ENLEVER ""TT"""
"SINTREDAC";"S";"0257";"               AJOUTER ""TT"" ""A"" LOCA_ABSENS"
"SINTREDAC";"S";"0258";"               SI LOCA_ABS(3:1) = ""M"""
"SINTREDAC";"S";"0259";"               OU LOCA_FOR(3:1) = ""M"""
"SINTREDAC";"S";"0260";"                  LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0261";"               FINSI"
"SINTREDAC";"S";"0262";"            FINSI"
"SINTREDAC";"S";"0263";"         FINSI"
"SINTREDAC";"S";"0264";"      FINSI"
"SINTREDAC";"S";"0265";"   FINSI"
"SINTREDAC";"S";"0266";"*"
"SINTREDAC";"S";"0267";"* Analyse si Travail"
"SINTREDAC";"S";"0268";"   SI LOCA_AJT <> ""FIN"""
"SINTREDAC";"S";"0269";"      SI LOCA_TRAV <> "" """
"SINTREDAC";"S";"0270";"         SI LOCA_TRAV = ""TRJ"""
"SINTREDAC";"S";"0271";"            SI LOCA_ABS(3:1) = ""M"""
"SINTREDAC";"S";"0272";"            OU LOCA_FOR(3:1) = ""M"""
"SINTREDAC";"S";"0273";"            OU LOCA_TT(3:1) = ""M"""
"SINTREDAC";"S";"0274";"               ENLEVER ""T"""
"SINTREDAC";"S";"0275";"               AJOUTER ""T"" ""A"" LOCA_ABSENS"
"SINTREDAC";"S";"0276";"               LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0277";"            FINSI"
"SINTREDAC";"S";"0278";"            SI LOCA_ABS(3:1) = ""A"""
"SINTREDAC";"S";"0279";"            OU LOCA_FOR(3:1) = ""A"""
"SINTREDAC";"S";"0280";"            OU LOCA_TT(3:1) = ""A"""
"SINTREDAC";"S";"0281";"               ENLEVER ""T"""
"SINTREDAC";"S";"0282";"               AJOUTER ""T"" ""M"" LOCA_ABSENM"
"SINTREDAC";"S";"0283";"               LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0284";"            FINSI"
"SINTREDAC";"S";"0285";"            SI LOCA_AJT <> ""FIN"""
"SINTREDAC";"S";"0286";"               ENLEVER ""T"""
"SINTREDAC";"S";"0287";"               AJOUTER ""T"" ""J"" LOCA_ABSENJ"
"SINTREDAC";"S";"0288";"               LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0289";"            FINSI"
"SINTREDAC";"S";"0290";"         FINSI"
"SINTREDAC";"S";"0291";"      FINSI"
"SINTREDAC";"S";"0292";"   FINSI"
"SINTREDAC";"S";"0293";"*"
"SINTREDAC";"S";"0294";"* Analyse si repos"
"SINTREDAC";"S";"0295";"   SI LOCA_AJT <> ""FIN"""
"SINTREDAC";"S";"0296";"      SI LOCA_REPOS = ""REJ"""
"SINTREDAC";"S";"0297";"         ENLEVER ""T"""
"SINTREDAC";"S";"0298";"         AJOUTER ""R"" ""J"" LOCA_ABSENJ"
"SINTREDAC";"S";"0299";"         LOCA_AJT = ""FIN"""
"SINTREDAC";"S";"0300";"      FINSI"
"SINTREDAC";"S";"0301";"   FINSI"
"SINTREDAC";"S";"0302";"*"
"SINTREDAC";"S";"0303";"FINSI"
"SINTREDAC";"S";"0304";"*"
"SINTREDAC";"S";"0305";"FIN"
