"SCONSCPCH";"S";"1381";"*"
"SCONSCPCH";"S";"1382";"* CP reporté"
"SCONSCPCH";"S";"1383";"   HJOU_SJRSPREP4 = HJOU_SJRDPREP4 - HJOU_SJRCPREP4"
"SCONSCPCH";"S";"1384";"   HJOU_SJRSPREP3 = HJOU_SJRDPREP3 - HJOU_SJRCPREP3"
"SCONSCPCH";"S";"1385";"   HJOU_SJRSPREP2 = HJOU_SJRDPREP2 - HJOU_SJRCPREP2"
"SCONSCPCH";"S";"1386";"   HJOU_SJRSPREP1 = HJOU_SJRDPREP1 - HJOU_SJRCPREP1"
"SCONSCPCH";"S";"1387";"* CP"
"SCONSCPCH";"S";"1388";"   HJOU_IJRSCOPRIN = HJOU_IJRDCOPRIN - HJOU_IJRCCOPRIN"
"SCONSCPCH";"S";"1389";"* CPAN"
"SCONSCPCH";"S";"1390";"   HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"SCONSCPCH";"S";"1391";"* CSUP"
"SCONSCPCH";"S";"1392";"   HJOU_SJRSCSUP = HJOU_SJRDCSUP - HJOU_SJRCCSUP"
"SCONSCPCH";"S";"1393";"* CFRAC"
"SCONSCPCH";"S";"1394";"   HJOU_IJRSCOFRAC = HJOU_IJRDCOFRAC - HJOU_IJRCCOFRAC"
"SCONSCPCH";"S";"1395";"* CMDF"
"SCONSCPCH";"S";"1396";"   HJOU_SJRSCMDF = HJOU_SJRDCMDF - HJOU_SJRCCMDF"
