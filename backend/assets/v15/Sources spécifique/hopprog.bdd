"SGRTTJ";"S";"0157";"*"
"SGRTTJ";"S";"0158";"SI CONF_IGIREFRTT <> "" """
"SGRTTJ";"S";"0159";"   LOCA_REF << CONF_IGIREFRTT(1:2)"
"SGRTTJ";"S";"0160";"   LOCA_DATE(7:2) << LOCA_REF"
"SGRTTJ";"S";"0161";"   LOCA_REF << CONF_IGIREFRTT(3:2)"
"SGRTTJ";"S";"0162";"   LOCA_DATE(5:2) << LOCA_REF"
"SGRTTJ";"S";"0163";"SINON"
"SGRTTJ";"S";"0164";"   LOCA_DATE = PARD_IDIDDEBANN"
