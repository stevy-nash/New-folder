"SPAIECPT";"S";"0050";"   *"
"SPAIECPT";"S";"0051";"   * Compteurs de CP1 >>"
"SPAIECPT";"S";"0052";"   HJOU_SJRI001;N;N6,2;I;;;    56789;;SJRI001;V3;""Droit CP1 pour paie - I001"";"
"SPAIECPT";"S";"0053";"   HJOU_SJRI045;N;N6,1;I;;;    56789;;SJRI045;V3;""Droit CP2 pour paie - I045 (10°)"";"
