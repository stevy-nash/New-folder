"SPAIECPT";"S";"0058";"   HJOU_SJRY603;N;N6,2;I;;;    56789;;SJRY603;V3;""Droit CP1 bascule - Y603"";"
"SPAIECPT";"S";"0059";"   HJOU_SJRY595;N;N6,2;I;;;    56789;;SJRY595;V3;""Pris CP1 bascule - Y595"";"
