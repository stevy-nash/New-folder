"SREPDEC";"S";"0028";"*"
"SREPDEC";"S";"0029";"DEBDICO"
"SREPDEC";"S";"0030";"   HJOU_SJRSRDECG;N;N6;I;;;     6789;;SJRSRDECG;V3;""Nombres de repos décalés (J) global"";"
"SREPDEC";"S";"0031";"   HJOU_SJRSRDEC;N;N6;I;;;     6789;;SJRSRDEC;V3;""Nombres de repos décalés (J)"";"
"SREPDEC";"S";"0032";"   HJOU_SJRSRDECR;N;N6;I;;;     6789;;SJRSRDECR;V3;""Nombres de repos décalés reportés (J)"";"
"SREPDEC";"S";"0033";"   PARD_SDIVMRDEC;O;A10;X;;;123456789;II;;C2;""Motif repos décalé"";"
"SREPDEC";"S";"0034";"   HJOU_SJRCRDECW;N;N6;I;;;     6789;;SJRCRDECW;V3;""Repos décalés pris en attente (J)"";"
"SREPDEC";"S";"0035";"   EMPL_SEQSPRDEC;N;N6,1;I;;;    56789;;;V3;""Nombres de repos décalés prév."";"
"SREPDEC";"S";"0036";"   *"
"SREPDEC";"S";"0037";"   HJOU_SJRRECDSIJ;N;N6,2;I;;;     6789;;SJRRECDSIJ;V3;""DSI : Dont récupération sur weekend"";"
"SREPDEC";"S";"0038";"   HJOU_IJRDJDISP2;N;N6,2;L;;;    56789;;IJRDJDISP2;V3;""DSI : Pris récup sur WE en attente"";"
"SREPDEC";"S";"0039";"   EMPL_IEQSPDISP4;N;N6,2;L;;;     6789;;;V3;""DSI :  Solde prév. récup sur WE"";"
"SREPDEC";"S";"0040";"FINDICO"
"SREPDEC";"S";"0041";"*"
"SREPDEC";"S";"0042";"DEBANO"
"SREPDEC";"S";"0043";"   241;9;""Pas droit au motif Repos décalé"";"
"SREPDEC";"S";"0044";"   242;8;""Nombre de Repos décalé insuffisant"";"
