"SHSUPPDIM";"S";"0500";"      FINSI"
"SHSUPPDIM";"S";"0501";"* Anomalie Pas droit aux HS"
"SHSUPPDIM";"S";"0502";"      SI LOCA_DROIT <> 1"
"SHSUPPDIM";"S";"0503";"* Excpetion autorise saisie HS payées sans calcul"
"SHSUPPDIM";"S";"0504";"         SI LOCA_DROIT <> 2"
"SHSUPPDIM";"S";"0505";"            ANOMALIE 203"
"SHSUPPDIM";"S";"0506";"            SI TEMP_CNMOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM";"S";"0507";"               TEMP_CNRETOUR = 2"
"SHSUPPDIM";"S";"0508";"               TEMP_CNMESS = 203"
