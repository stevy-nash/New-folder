"SPRIOR";"S";"0028";"*"
"SPRIOR";"S";"0029";"* Implémentation des données industrielles"
"SPRIOR";"S";"0030";"*"
"SPRIOR";"S";"0031";"DEBDICO"
"SPRIOR";"S";"0032";"FINDICO"
"SPRIOR";"S";"0033";"*"
"SPRIOR";"S";"0034";"* Déclaration des donnees locales"
"SPRIOR";"S";"0035";"*"
"SPRIOR";"S";"0036";"DEF LOCA_MOT1 A10"
"SPRIOR";"S";"0037";"LOCA_MOT1 = "" """
"SPRIOR";"S";"0038";"DEF LOCA_MOT2 A10"
"SPRIOR";"S";"0039";"LOCA_MOT2 = "" """
"SPRIOR";"S";"0040";"DEF LOCA_PRIO1 Z1"
"SPRIOR";"S";"0041";"LOCA_PRIO1 = ""0"""
"SPRIOR";"S";"0042";"DEF LOCA_PRIO2 Z1"
"SPRIOR";"S";"0043";"LOCA_PRIO2 = ""0"""
"SPRIOR";"S";"0044";"DEF LOCA_VAL1 A1"
"SPRIOR";"S";"0045";"LOCA_VAL1 = "" """
"SPRIOR";"S";"0046";"DEF LOCA_VAL2 A1"
"SPRIOR";"S";"0047";"LOCA_VAL2 = "" """
"SPRIOR";"S";"0048";"*"
"SPRIOR";"S";"0049";"DEF LOCA_MTH N2"
"SPRIOR";"S";"0050";"LOCA_MTH = 0"
"SPRIOR";"S";"0051";"DEF LOCA_PRIOMTH Z1"
"SPRIOR";"S";"0052";"LOCA_PRIOMTH = ""0"""
"SPRIOR";"S";"0053";"DEF LOCA_VALMTH A1"
"SPRIOR";"S";"0054";"LOCA_VALMTH = "" """
"SPRIOR";"S";"0055";"*"
"SPRIOR";"S";"0056";"DEF LOCA_MALJ N2"
"SPRIOR";"S";"0057";"LOCA_MALJ = 0"
"SPRIOR";"S";"0058";"DEF LOCA_CPJ N2"
"SPRIOR";"S";"0059";"LOCA_CPJ = 0"
"SPRIOR";"S";"0060";"DEF LOCA_SJQMCP A4"
"SPRIOR";"S";"0061";"LOCA_SJQMCP = "" """
"SPRIOR";"S";"0062";"*"
"SPRIOR";"S";"0063";"POUR ACTIVITES"
"SPRIOR";"S";"0064";"   SI HABS_VALORIS = ""J"""
"SPRIOR";"S";"0065";"      SI HABS_MOTIF = ""MAL"""
"SPRIOR";"S";"0066";"         LOCA_MALJ = 1"
"SPRIOR";"S";"0067";"      FINSI"
"SPRIOR";"S";"0068";"      SI HABS_MOTIF = PARD_SDIVMCOPRI"
"SPRIOR";"S";"0069";"         LOCA_CPJ = 1"
"SPRIOR";"S";"0070";"      FINSI"
"SPRIOR";"S";"0071";"   FINSI"
"SPRIOR";"S";"0072";"FINPOUR"
"SPRIOR";"S";"0073";"*"
"SPRIOR";"S";"0074";"LIREVALPRE LOCA_SJQMCP HJOU_SJQMCP"
"SPRIOR";"S";"0075";"*"
"SPRIOR";"S";"0076";"SI LOCA_MALJ = 1"
"SPRIOR";"S";"0077";"   SI LOCA_CPJ = 1"
"SPRIOR";"S";"0078";"      SI HJOU_SJRCPTP <> "" """
"SPRIOR";"S";"0079";"      OU LOCA_SJQMCP <> "" """
"SPRIOR";"S";"0080";"         HJOU_SJQMCP = PARD_SDIVMCOPRI"
"SPRIOR";"S";"0081";"      FINSI"
"SPRIOR";"S";"0082";"   FINSI"
"SPRIOR";"S";"0083";"SINON"
"SPRIOR";"S";"0084";"   SI HJOU_SJQMCP <> "" """
"SPRIOR";"S";"0085";"      HJOU_SJQMCP = "" """
"SPRIOR";"S";"0086";"   FINSI"
"SPRIOR";"S";"0087";"FINSI"
"SPRIOR";"S";"0088";"*"
"SPRIOR";"S";"0089";"POUR ACTIVITES"
"SPRIOR";"S";"0090";"   SI HABS_MOTYPE <> ""C"""
"SPRIOR";"S";"0091";"      SI HABS_MOTIF <> ""FINP"""
"SPRIOR";"S";"0092";"         SI HABS_VALORIS <> ""H"""
"SPRIOR";"S";"0093";"            SI LOCA_MOT1 = "" """
"SPRIOR";"S";"0094";"               SI MOTI_PRIORITE > ""0"""
"SPRIOR";"S";"0095";"                  LOCA_PRIO1 = MOTI_PRIORITE"
"SPRIOR";"S";"0096";"                  LOCA_MOT1 = HABS_MOTIF"
"SPRIOR";"S";"0097";"                  LOCA_VAL1 = HABS_VALORIS"
"SPRIOR";"S";"0098";"               FINSI"
"SPRIOR";"S";"0099";"            SINON"
"SPRIOR";"S";"0100";"               SI LOCA_MOT2 = "" """
"SPRIOR";"S";"0101";"                  SI MOTI_PRIORITE > ""0"""
"SPRIOR";"S";"0102";"                     LOCA_PRIO2 = MOTI_PRIORITE"
"SPRIOR";"S";"0103";"                     LOCA_MOT2 = HABS_MOTIF"
"SPRIOR";"S";"0104";"                     LOCA_VAL2 = HABS_VALORIS"
"SPRIOR";"S";"0105";"                  FINSI"
"SPRIOR";"S";"0106";"               FINSI"
"SPRIOR";"S";"0107";"            FINSI"
"SPRIOR";"S";"0108";"         FINSI"
"SPRIOR";"S";"0109";"      FINSI"
"SPRIOR";"S";"0110";"   FINSI"
"SPRIOR";"S";"0111";"FINPOUR"
"SPRIOR";"S";"0112";"SI LOCA_VAL1 = LOCA_VAL2"
"SPRIOR";"S";"0113";"   SI LOCA_PRIO2 > LOCA_PRIO1"
"SPRIOR";"S";"0114";"      LOCA_MOT2 = "" """
"SPRIOR";"S";"0115";"   FINSI"
"SPRIOR";"S";"0116";"   SI LOCA_PRIO2 < LOCA_PRIO1"
"SPRIOR";"S";"0117";"      LOCA_MOT1 = "" """
"SPRIOR";"S";"0118";"   FINSI"
"SPRIOR";"S";"0119";"   SI LOCA_PRIO2 = LOCA_PRIO1"
"SPRIOR";"S";"0120";"      SI LOCA_MOT1 = LOCA_MOT2"
"SPRIOR";"S";"0121";"         LOCA_MOT1 = "" """
"SPRIOR";"S";"0122";"      SINON"
"SPRIOR";"S";"0123";"         LOCA_MOT1 = "" """
"SPRIOR";"S";"0124";"         LOCA_MOT2 = "" """
"SPRIOR";"S";"0125";"      FINSI"
"SPRIOR";"S";"0126";"   FINSI"
"SPRIOR";"S";"0127";"   SI LOCA_MOT1 <> "" """
"SPRIOR";"S";"0128";"      ENLEVER LOCA_MOT1"
"SPRIOR";"S";"0129";"   FINSI"
"SPRIOR";"S";"0130";"   SI LOCA_MOT2 <> "" """
"SPRIOR";"S";"0131";"      ENLEVER LOCA_MOT2"
"SPRIOR";"S";"0132";"   FINSI"
"SPRIOR";"S";"0133";"FINSI"
"SPRIOR";"S";"0134";"*"
"SPRIOR";"S";"0135";"* Gestion de la suppression du motif MTH"
"SPRIOR";"S";"0136";"*"
"SPRIOR";"S";"0137";"POUR ACTIVITES"
"SPRIOR";"S";"0138";"* Motif MTH"
"SPRIOR";"S";"0139";"   SI HABS_MOTIF = PARD_SDIVMMTT"
"SPRIOR";"S";"0140";"      SI HABS_VALORIS <> ""H"""
"SPRIOR";"S";"0141";"         LOCA_PRIOMTH = MOTI_PRIORITE"
"SPRIOR";"S";"0142";"         LOCA_VALMTH = HABS_VALORIS"
"SPRIOR";"S";"0143";"         LOCA_MTH = 1"
"SPRIOR";"S";"0144";"      FINSI"
"SPRIOR";"S";"0145";"   FINSI"
"SPRIOR";"S";"0146";"FINPOUR"
"SPRIOR";"S";"0147";"*"
"SPRIOR";"S";"0148";"SI LOCA_MTH = 1"
"SPRIOR";"S";"0149";"   SI LOCA_PRIO1 > LOCA_PRIOMTH"
"SPRIOR";"S";"0150";"      SI LOCA_VAL1 = ""J"""
"SPRIOR";"S";"0151";"         ENLEVER PARD_SDIVMMTT"
"SPRIOR";"S";"0152";"      SINON"
"SPRIOR";"S";"0153";"         SI LOCA_VAL1 = LOCA_VALMTH"
"SPRIOR";"S";"0154";"            ENLEVER PARD_SDIVMMTT"
"SPRIOR";"S";"0155";"         FINSI"
"SPRIOR";"S";"0156";"      FINSI"
"SPRIOR";"S";"0157";"   FINSI"
"SPRIOR";"S";"0158";"   SI LOCA_PRIO2 > LOCA_PRIOMTH"
"SPRIOR";"S";"0159";"      SI LOCA_VAL2 = ""J"""
"SPRIOR";"S";"0160";"         ENLEVER PARD_SDIVMMTT"
"SPRIOR";"S";"0161";"      SINON"
"SPRIOR";"S";"0162";"         SI LOCA_VAL2 = LOCA_VALMTH"
"SPRIOR";"S";"0163";"            ENLEVER PARD_SDIVMMTT"
"SPRIOR";"S";"0164";"         FINSI"
"SPRIOR";"S";"0165";"      FINSI"
"SPRIOR";"S";"0166";"   FINSI"
"SPRIOR";"S";"0167";"FINSI"
"SPRIOR";"S";"0168";"*"
"SPRIOR";"S";"0169";"FIN"
