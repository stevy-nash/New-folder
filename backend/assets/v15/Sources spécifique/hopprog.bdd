"SROLE";"S";"0037";"*------------------------------------------------*"
"SROLE";"S";"0038";"* 1. Rôle MANAGERs"
"SROLE";"S";"0039";"*------------------------------------------------*"
"SROLE";"S";"0040";"* 1.1 SI Manager Industrie FJ - MO (MANADINMO)"
"SROLE";"S";"0041";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0042";"      SI EMPL_SEIROLMA = ""1"""
"SROLE";"S";"0043";"         SI CTRA_SCIFORFJ = ""1"""
"SROLE";"S";"0044";"            SI EMPL_HORSECT(1:3) = ""DIN"""
"SROLE";"S";"0045";"               SI CTRA_SCISOCIETE = ""MO"""
"SROLE";"S";"0046";"                  EMPL_SEQROLEC = ""MANADINMO"""
"SROLE";"S";"0047";"                  LOCA_ROLE = 1"
"SROLE";"S";"0048";"               FINSI"
"SROLE";"S";"0049";"            FINSI"
"SROLE";"S";"0050";"         FINSI"
"SROLE";"S";"0051";"      FINSI"
"SROLE";"S";"0052";"   FINSI"
"SROLE";"S";"0053";"*"
"SROLE";"S";"0054";"* 1.2 SI Manager Rédaction Général FJ (MANAREDACF)"
