"SGRCI";"S";"0014";"*"
"SGRCI";"S";"0015";"*"
"SGRCI";"S";"0016";"* Rôle : Cette récupération concerne certain service de l'industrie"
"SGRCI";"S";"0017";"*        RCI = Récupération Centre d’imprimerie"
"SGRCI";"S";"0018";"*        Acquisition de 4 jours le 1° jour de l'année si présent toutes la période"
"SGRCI";"S";"0019";"*"
"SGRCI";"S";"0020";"*"
"SGRCI";"S";"0021";"*----------------------------------------------------------------------"
"SGRCI";"S";"0022";"*"
"SGRCI";"S";"0023";"* Modifiée par :"
"SGRCI";"S";"0024";"* Date         :"
"SGRCI";"S";"0025";"* Objet        :"
"SGRCI";"S";"0026";"*"
"SGRCI";"S";"0027";"***********************************************************************"
"SGRCI";"S";"0028";"*"
"SGRCI";"S";"0029";"* Implémentation des données industrielles"
"SGRCI";"S";"0030";"*"
"SGRCI";"S";"0031";"DEBDICO"
"SGRCI";"S";"0032";"   HJOU_SJRDRCI;N;N6,2;I;;;     6789;;SJRDRCI;V3;""Droit RCI"";"
"SGRCI";"S";"0033";"   HJOU_SJRCRCI;N;N6,2;I;;;     6789;;SJRCRCI;V3;""Pris RCI"";"
"SGRCI";"S";"0034";"   HJOU_SJRSRCI;N;N6,2;I;;;     6789;;SJRSRCI;V3;""Solde RCI"";"
"SGRCI";"S";"0035";"   HJOU_SJRCRCIW;N;N6,2;I;;;     6789;;SJRCRCIW;V3;""Pris RCI en attente"";"
"SGRCI";"S";"0036";"   EMPL_SEQSPRCI;N;N6,1;I;;;    56789;;;V3;""Solde prév. RCI"";"
"SGRCI";"S";"0037";"   PARD_SDIVMRCI;O;A10;X;;;123456789;II;;C2;""Motif RCI"";"
"SGRCI";"S";"0038";"   PARD_SDIDRCIMY;N;N4,1;I;000000000000;;    56789;;;C3;""MO et YR : Droit RCI annuel"";"
"SGRCI";"S";"0039";"   SECH_SSIGRCI;O;Z1;X;;;123456789;L9;;C2;""Droit au RCI"";"
"SGRCI";"S";"0040";"   HJOU_SJIGRCI;O;Z1;X;;;      789;L;;C2;""Droit au RCI"";"
"SGRCI";"S";"0041";"   *"
"SGRCI";"S";"0042";"   EMPL_SEQCRCI;N;N6,1;I;;;    56789;;;V3;""Pris prév. RCI"";"
"SGRCI";"S";"0043";"FINDICO"
"SGRCI";"S";"0044";"*"
"SGRCI";"S";"0045";"DEBANO"
"SGRCI";"S";"0046";"   230;9;""Pas droit au motif RCI"";"
"SGRCI";"S";"0047";"   231;8;""Solde RCI insuffisant"";"
"SGRCI";"S";"0048";"FINANO"
"SGRCI";"S";"0049";"*"
"SGRCI";"S";"0050";"* Déclaration des donnees locales"
"SGRCI";"S";"0051";"*"
"SGRCI";"S";"0052";"DEF LOCA_DROIT N2"
"SGRCI";"S";"0053";"LOCA_DROIT = 0"
"SGRCI";"S";"0054";"DEF LOCA_MOT N2"
"SGRCI";"S";"0055";"LOCA_MOT = 0"
"SGRCI";"S";"0056";"DEF LOCA_PRIS N6.2"
"SGRCI";"S";"0057";"LOCA_PRIS = 0"
"SGRCI";"S";"0058";"DEF LOCA_PERCO N6.2"
"SGRCI";"S";"0059";"LOCA_PERCO = 0"
"SGRCI";"S";"0060";"DEF LOCA_PRISW N6.2"
"SGRCI";"S";"0061";"LOCA_PRISW = 0"
"SGRCI";"S";"0062";"DEF LOCA_PERCOW N6.2"
"SGRCI";"S";"0063";"LOCA_PERCOW = 0"
"SGRCI";"S";"0064";"DEF LOCA_FERI N2"
"SGRCI";"S";"0065";"LOCA_FERI = 0"
"SGRCI";"S";"0066";"DEF LOCA_DRCI N6.2"
"SGRCI";"S";"0067";"LOCA_DRCI = 0"
"SGRCI";"S";"0068";"DEF LOCA_COEFF N8.5"
"SGRCI";"S";"0069";"LOCA_COEFF = 0"
"SGRCI";"S";"0070";"DEF LOCA_SJRJPRECAL N4"
"SGRCI";"S";"0071";"LOCA_SJRJPRECAL = 0"
"SGRCI";"S";"0072";"DEF LOCA_SDIDRCIMY N4.1"
"SGRCI";"S";"0073";"LOCA_SDIDRCIMY = PARD_SDIDRCIMY"
"SGRCI";"S";"0074";"*"
"SGRCI";"S";"0075";"DEF LOCA_DATE D"
"SGRCI";"S";"0076";"LOCA_DATE(5:4) = ""0101"""
"SGRCI";"S";"0077";"DEF LOCA_DATEFU D"
"SGRCI";"S";"0078";"LOCA_DATEFU(5:4) = ""0101"""
"SGRCI";"S";"0079";"DEF LOCA_ANNEE N4"
"SGRCI";"S";"0080";"LOCA_ANNEE << TEMP_DATJOU(1:4)"
"SGRCI";"S";"0081";"LOCA_DATE(1:4) << LOCA_ANNEE"
"SGRCI";"S";"0082";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SGRCI";"S";"0083";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SGRCI";"S";"0084";"*"
"SGRCI";"S";"0085";"DEF LOCA_VALAROND N6.2"
"SGRCI";"S";"0086";"LOCA_VALAROND = 0"
"SGRCI";"S";"0087";"DEF LOCA_RESTE N6.2"
"SGRCI";"S";"0088";"LOCA_RESTE = 0"
"SGRCI";"S";"0089";"DEF LOCA_ENTIER N6.2"
"SGRCI";"S";"0090";"LOCA_ENTIER = 0"
"SGRCI";"S";"0091";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGRCI";"S";"0092";"DEF LOCA_TYPARROND N2"
"SGRCI";"S";"0093";"LOCA_TYPARROND = 2"
"SGRCI";"S";"0094";"*"
"SGRCI";"S";"0095";"POUR ACTIVITES"
"SGRCI";"S";"0096";"   SI HABS_MOTIF = ""JF"""
"SGRCI";"S";"0097";"      LOCA_FERI = 1"
"SGRCI";"S";"0098";"   FINSI"
"SGRCI";"S";"0099";"FINPOUR"
"SGRCI";"S";"0100";"*"
"SGRCI";"S";"0101";"* Si service donne droit"
"SGRCI";"S";"0102";"SI SECH_SSIGRCI = ""1"""
"SGRCI";"S";"0103";"OU SECH_SSIGRCI = ""2"""
"SGRCI";"S";"0104";"* Uniquement CDI"
"SGRCI";"S";"0105";"   SI CTRA_TYPCTRA = ""CDI"""
"SGRCI";"S";"0106";"* Exclu forfait jour"
"SGRCI";"S";"0107";"      SI HJOU_SJQFORFJR <> ""1"""
"SGRCI";"S";"0108";"         SI HJOU_SJQCATEGOR <> ""C"""
"SGRCI";"S";"0109";"* Uniquement industrie"
"SGRCI";"S";"0110";"            SI HJOU_SECTORI(1:3) = ""DIN"""
"SGRCI";"S";"0111";"* Société YR"
"SGRCI";"S";"0112";"               SI HJOU_SJQSOCIETE = ""YR"""
"SGRCI";"S";"0113";"* Uniquement ouvrier >>"
"SGRCI";"S";"0114";"                  SI HJOU_SJQCATEGOR = ""O"""
"SGRCI";"S";"0115";"                     LOCA_DROIT = 1"
"SGRCI";"S";"0116";"* Droit RCI de 4 par an"
"SGRCI";"S";"0117";"                     LOCA_DRCI = LOCA_SDIDRCIMY"
"SGRCI";"S";"0118";"                  FINSI"
"SGRCI";"S";"0119";"               FINSI"
"SGRCI";"S";"0120";"* Société MO"
"SGRCI";"S";"0121";"               SI HJOU_SJQSOCIETE = ""MO"""
"SGRCI";"S";"0122";"                  LOCA_DROIT = 1"
"SGRCI";"S";"0123";"* Droit RCI de 4 par an"
"SGRCI";"S";"0124";"                  LOCA_DRCI = LOCA_SDIDRCIMY"
"SGRCI";"S";"0125";"               FINSI"
"SGRCI";"S";"0126";"            FINSI"
"SGRCI";"S";"0127";"         FINSI"
"SGRCI";"S";"0128";"      FINSI"
"SGRCI";"S";"0129";"   FINSI"
"SGRCI";"S";"0130";"FINSI"
"SGRCI";"S";"0131";"*"
"SGRCI";"S";"0132";"* JJA - 28/07/2025 - FFT025005238 : Force droit RCI dans JOU >>"
"SGRCI";"S";"0133";"SI HJOU_SJIGRCI = ""1"""
"SGRCI";"S";"0134";"   LOCA_DROIT = 1"
"SGRCI";"S";"0135";"   LOCA_DRCI = LOCA_SDIDRCIMY"
"SGRCI";"S";"0136";"FINSI"
"SGRCI";"S";"0137";"*"
"SGRCI";"S";"0138";"SI HJOU_SJIGRCI = ""2"""
"SGRCI";"S";"0139";"   LOCA_DROIT = 0"
"SGRCI";"S";"0140";"   LOCA_DRCI = 0"
"SGRCI";"S";"0141";"FINSI"
"SGRCI";"S";"0142";"* JJA - 28/07/2025 - FFT025005238 <<"
"SGRCI";"S";"0143";"*"
"SGRCI";"S";"0144";"***** DEB : Gestion de l'acquisition >>"
"SGRCI";"S";"0145";"*"
"SGRCI";"S";"0146";"*"
"SGRCI";"S";"0147";"* Acquisition à période de référence >>"
"SGRCI";"S";"0148";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGRCI";"S";"0149";"*"
"SGRCI";"S";"0150";"* Proratise en fonction de la présence sur l'année précédente"
"SGRCI";"S";"0151";"   LIREVALPRE LOCA_SJRJPRECAL HJOU_SJRJPRECAL"
"SGRCI";"S";"0152";"   LOCA_COEFF = LOCA_SJRJPRECAL / 365"
"SGRCI";"S";"0153";"   SI LOCA_COEFF > 1"
"SGRCI";"S";"0154";"      LOCA_COEFF = 1"
"SGRCI";"S";"0155";"   FINSI"
"SGRCI";"S";"0156";"*"
"SGRCI";"S";"0157";"   HJOU_SJRDRCI = LOCA_DRCI * LOCA_COEFF"
"SGRCI";"S";"0158";"   LOCA_VALAROND = HJOU_SJRDRCI"
"SGRCI";"S";"0159";"   FAIRE ARRONDI"
"SGRCI";"S";"0160";"   HJOU_SJRDRCI = LOCA_VALAROND"
"SGRCI";"S";"0161";"*"
"SGRCI";"S";"0162";"* RAZ du pris"
"SGRCI";"S";"0163";"   HJOU_SJRCRCI = 0"
"SGRCI";"S";"0164";"   HJOU_SJRSRCI = HJOU_SJRDRCI - HJOU_SJRCRCI"
"SGRCI";"S";"0165";"*"
"SGRCI";"S";"0166";"FINSI"
"SGRCI";"S";"0167";"*"
"SGRCI";"S";"0168";"* Init et MAJ du droit par consignes >>"
"SGRCI";"S";"0169";"POUR ACTIVITES"
"SGRCI";"S";"0170";"* MAJ"
"SGRCI";"S";"0171";"   SI HABS_MOTIF = ""XDRCI"""
"SGRCI";"S";"0172";"      HJOU_SJRDRCI = HJOU_SJRDRCI + HABS_MOTINBR"
"SGRCI";"S";"0173";"   FINSI"
"SGRCI";"S";"0174";"* Init"
"SGRCI";"S";"0175";"   SI HABS_MOTIF = ""ZDRCI"""
"SGRCI";"S";"0176";"      HJOU_SJRDRCI = HABS_MOTINBR"
"SGRCI";"S";"0177";"   FINSI"
"SGRCI";"S";"0178";"FINPOUR"
"SGRCI";"S";"0179";"*"
"SGRCI";"S";"0180";"* Solde >>"
"SGRCI";"S";"0181";"HJOU_SJRSRCI = HJOU_SJRDRCI - HJOU_SJRCRCI"
"SGRCI";"S";"0182";"*"
"SGRCI";"S";"0183";"***** DEB : Gestion de la consommation >>"
"SGRCI";"S";"0184";"POUR ACTIVITES"
"SGRCI";"S";"0185";"*"
"SGRCI";"S";"0186";"* Gestion du PERCO >>"
"SGRCI";"S";"0187";"   SI HABS_MOTIF = ""YPERRCI"""
"SGRCI";"S";"0188";"      LOCA_PERCO = LOCA_PERCO + HABS_MOTINBR"
"SGRCI";"S";"0189";"   FINSI"
"SGRCI";"S";"0190";"*"
"SGRCI";"S";"0191";"* Gestion don de RCI"
"SGRCI";"S";"0192";"   SI HABS_MOTIF = ""YDONRCI"""
"SGRCI";"S";"0193";"      HJOU_SJRCRCI = HJOU_SJRCRCI + HABS_MOTINBR"
"SGRCI";"S";"0194";"      HJOU_SJRSRCI = HJOU_SJRDRCI - HJOU_SJRCRCI"
"SGRCI";"S";"0195";"   FINSI"
"SGRCI";"S";"0196";"*"
"SGRCI";"S";"0197";"   SI HJOU_IJQPRETHEJ > 0"
"SGRCI";"S";"0198";"      SI HABS_MOTIF = PARD_SDIVMRCI"
"SGRCI";"S";"0199";"         LOCA_MOT = 1"
"SGRCI";"S";"0200";"*"
"SGRCI";"S";"0201";"         SI HABS_VALORIS = ""J"""
"SGRCI";"S";"0202";"            SI PROF_ABSENM = 0"
"SGRCI";"S";"0203";"            OU PROF_ABSENS = 0"
"SGRCI";"S";"0204";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SGRCI";"S";"0205";"            SINON"
"SGRCI";"S";"0206";"               LOCA_PRIS = LOCA_PRIS + 1"
"SGRCI";"S";"0207";"            FINSI"
"SGRCI";"S";"0208";"         SINON"
"SGRCI";"S";"0209";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SGRCI";"S";"0210";"         FINSI"
"SGRCI";"S";"0211";"*"
"SGRCI";"S";"0212";"      FINSI"
"SGRCI";"S";"0213";"   FINSI"
"SGRCI";"S";"0214";"FINPOUR"
"SGRCI";"S";"0215";"*"
"SGRCI";"S";"0216";"SI LOCA_PRIS > 1"
"SGRCI";"S";"0217";"   LOCA_PRIS = 1"
"SGRCI";"S";"0218";"FINSI"
"SGRCI";"S";"0219";"*"
"SGRCI";"S";"0220";"SI LOCA_PRIS > 0"
"SGRCI";"S";"0221";"   HJOU_SJRCRCI = HJOU_SJRCRCI + LOCA_PRIS"
"SGRCI";"S";"0222";"FINSI"
"SGRCI";"S";"0223";"*"
"SGRCI";"S";"0224";"SI LOCA_PERCO > 0"
"SGRCI";"S";"0225";"   HJOU_SJRCRCI = HJOU_SJRCRCI + LOCA_PERCO"
"SGRCI";"S";"0226";"FINSI"
"SGRCI";"S";"0227";"*"
"SGRCI";"S";"0228";"* Init et MAJ du pris par consignes >>"
"SGRCI";"S";"0229";"POUR ACTIVITES"
"SGRCI";"S";"0230";"* MAJ"
"SGRCI";"S";"0231";"   SI HABS_MOTIF = ""XCRCI"""
"SGRCI";"S";"0232";"      HJOU_SJRCRCI = HJOU_SJRCRCI + HABS_MOTINBR"
"SGRCI";"S";"0233";"   FINSI"
"SGRCI";"S";"0234";"* Init"
"SGRCI";"S";"0235";"   SI HABS_MOTIF = ""ZCRCI"""
"SGRCI";"S";"0236";"      HJOU_SJRCRCI = HABS_MOTINBR"
"SGRCI";"S";"0237";"   FINSI"
"SGRCI";"S";"0238";"FINPOUR"
"SGRCI";"S";"0239";"*"
"SGRCI";"S";"0240";"* Solde >>"
"SGRCI";"S";"0241";"HJOU_SJRSRCI = HJOU_SJRDRCI - HJOU_SJRCRCI"
"SGRCI";"S";"0242";"*"
"SGRCI";"S";"0243";"***** DEB : Gestion du pris en attente >>"
"SGRCI";"S";"0244";"*"
"SGRCI";"S";"0245";"POUR WACTIVITES"
"SGRCI";"S";"0246";"   SI WABS_ANNUL = ""0"""
"SGRCI";"S";"0247";"      SI LOCA_FERI <> 1"
"SGRCI";"S";"0248";"         SI HJOU_IJQPRETHEJ > 0.00"
"SGRCI";"S";"0249";"*"
"SGRCI";"S";"0250";"* PERCO"
"SGRCI";"S";"0251";"            SI WABS_MOTIF = ""YPERRCI"""
"SGRCI";"S";"0252";"               LOCA_PERCOW = LOCA_PERCOW + WABS_MOTINBR"
"SGRCI";"S";"0253";"            FINSI"
"SGRCI";"S";"0254";"*"
"SGRCI";"S";"0255";"            SI WABS_MOTIF = PARD_SDIVMRCI"
"SGRCI";"S";"0256";"* Gestion de la valorisation >>"
"SGRCI";"S";"0257";"               SI WABS_VALORIS = ""J"""
"SGRCI";"S";"0258";"                  SI PROF_ABSENM = 0"
"SGRCI";"S";"0259";"                  OU PROF_ABSENS = 0"
"SGRCI";"S";"0260";"                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SGRCI";"S";"0261";"                  SINON"
"SGRCI";"S";"0262";"                     LOCA_PRISW = 1"
"SGRCI";"S";"0263";"                  FINSI"
"SGRCI";"S";"0264";"               SINON"
"SGRCI";"S";"0265";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SGRCI";"S";"0266";"               FINSI"
"SGRCI";"S";"0267";"            FINSI"
"SGRCI";"S";"0268";"         FINSI"
"SGRCI";"S";"0269";"      FINSI"
"SGRCI";"S";"0270";"   FINSI"
"SGRCI";"S";"0271";"FINPOUR"
"SGRCI";"S";"0272";"*"
"SGRCI";"S";"0273";"SI LOCA_PRISW > 1"
"SGRCI";"S";"0274";"   LOCA_PRISW = 1"
"SGRCI";"S";"0275";"FINSI"
"SGRCI";"S";"0276";"*"
"SGRCI";"S";"0277";"SI LOCA_PRISW > 0"
"SGRCI";"S";"0278";"   HJOU_SJRCRCIW = HJOU_SJRCRCIW + LOCA_PRISW"
"SGRCI";"S";"0279";"FINSI"
"SGRCI";"S";"0280";"SI LOCA_PERCOW > 0"
"SGRCI";"S";"0281";"   HJOU_SJRCRCIW = HJOU_SJRCRCIW + LOCA_PERCOW"
"SGRCI";"S";"0282";"FINSI"
"SGRCI";"S";"0283";"*"
"SGRCI";"S";"0284";"* Solde >>"
"SGRCI";"S";"0285";"HJOU_SJRSRCI = HJOU_SJRDRCI - HJOU_SJRCRCI"
"SGRCI";"S";"0286";"*"
"SGRCI";"S";"0287";"***** Gestion des anomalies >>"
"SGRCI";"S";"0288";"*"
"SGRCI";"S";"0289";"SI LOCA_MOT = 1"
"SGRCI";"S";"0290";"* Si droit ?"
"SGRCI";"S";"0291";"   SI LOCA_DROIT <> 1"
"SGRCI";"S";"0292";"      SI HJOU_SJRDRCI = 0"
"SGRCI";"S";"0293";"         ANOMALIE 230"
"SGRCI";"S";"0294";"         SI TEMP_CNMOTIF = PARD_SDIVMRCI"
"SGRCI";"S";"0295";"            TEMP_CNRETOUR = 2"
"SGRCI";"S";"0296";"            TEMP_CNMESS = 230"
"SGRCI";"S";"0297";"         FINSI"
"SGRCI";"S";"0298";"      FINSI"
"SGRCI";"S";"0299";"   FINSI"
"SGRCI";"S";"0300";"* Si solde négatif ?"
"SGRCI";"S";"0301";"   SI HJOU_SJRSRCI < 0"
"SGRCI";"S";"0302";"      ANOMALIE 231"
"SGRCI";"S";"0303";"      SI TEMP_CNMOTIF = PARD_SDIVMRCI"
"SGRCI";"S";"0304";"      OU TEMP_CNMOTIF = ""YPERRCI"""
"SGRCI";"S";"0305";"         TEMP_CNRETOUR = 2"
"SGRCI";"S";"0306";"         TEMP_CNMESS = 231"
"SGRCI";"S";"0307";"      FINSI"
"SGRCI";"S";"0308";"   FINSI"
"SGRCI";"S";"0309";"* Si pose un autre jour que le mardi mercredi jeudi"
"SGRCI";"S";"0310";"   SI SECH_SSIGRCI <> ""2"""
"SGRCI";"S";"0311";"      SI HJOU_SECTORI(1:3) = ""DIN"""
"SGRCI";"S";"0312";"         SI HJOU_JOUR = ""1"""
"SGRCI";"S";"0313";"         OU HJOU_JOUR = ""5"""
"SGRCI";"S";"0314";"         OU HJOU_JOUR = ""6"""
"SGRCI";"S";"0315";"         OU HJOU_JOUR = ""7"""
"SGRCI";"S";"0316";"            SI TEMP_STQJF <> ""JJF"""
"SGRCI";"S";"0317";"               SI HJOU_SJQSOCIETE = ""MO"""
"SGRCI";"S";"0318";"                  SI HJOU_SJITYPSERV = ""ROTATIVE"""
"SGRCI";"S";"0319";"                     ANOMALIE 294"
"SGRCI";"S";"0320";"                     SI TEMP_CNMOTIF = PARD_SDIVMRCI"
"SGRCI";"S";"0321";"                        TEMP_CNRETOUR = 2"
"SGRCI";"S";"0322";"                        TEMP_CNMESS = 294"
"SGRCI";"S";"0323";"                     FINSI"
"SGRCI";"S";"0324";"                  FINSI"
"SGRCI";"S";"0325";"               FINSI"
"SGRCI";"S";"0326";"               SI HJOU_SJQSOCIETE = ""YR"""
"SGRCI";"S";"0327";"                  SI HJOU_SJITYPSERV = ""MAINTENANCE"""
"SGRCI";"S";"0328";"                  OU HJOU_SJITYPSERV = ""MAGASIN"""
"SGRCI";"S";"0329";"                     ANOMALIE 294"
"SGRCI";"S";"0330";"                     SI TEMP_CNMOTIF = PARD_SDIVMRCI"
"SGRCI";"S";"0331";"                        TEMP_CNRETOUR = 2"
"SGRCI";"S";"0332";"                        TEMP_CNMESS = 294"
"SGRCI";"S";"0333";"                     FINSI"
"SGRCI";"S";"0334";"                  FINSI"
"SGRCI";"S";"0335";"               FINSI"
"SGRCI";"S";"0336";"            FINSI"
"SGRCI";"S";"0337";"         FINSI"
"SGRCI";"S";"0338";"      FINSI"
"SGRCI";"S";"0339";"   FINSI"
"SGRCI";"S";"0340";"*"
"SGRCI";"S";"0341";"FINSI"
"SGRCI";"S";"0342";"*"
"SGRCI";"S";"0343";"SI LOCA_PERCO > 0"
"SGRCI";"S";"0344";"* Si solde négatif ?"
"SGRCI";"S";"0345";"   SI HJOU_SJRSRCI < 0"
"SGRCI";"S";"0346";"      ANOMALIE 231"
"SGRCI";"S";"0347";"      SI TEMP_CNMOTIF = PARD_SDIVMRCI"
"SGRCI";"S";"0348";"      OU TEMP_CNMOTIF = ""YPERRCI"""
"SGRCI";"S";"0349";"         TEMP_CNRETOUR = 2"
"SGRCI";"S";"0350";"         TEMP_CNMESS = 231"
"SGRCI";"S";"0351";"      FINSI"
"SGRCI";"S";"0352";"   FINSI"
"SGRCI";"S";"0353";"FINSI"
"SGRCI";"S";"0354";"*"
"SGRCI";"S";"0355";"***** Solde prévisionnel >>"
"SGRCI";"S";"0356";"*"
"SGRCI";"S";"0357";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGRCI";"S";"0358";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SGRCI";"S";"0359";"      SI HJOU_SJQFINC = 1"
"SGRCI";"S";"0360";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGRCI";"S";"0361";"         LOCA_DATEFU = TEMP_DXFINPER"
"SGRCI";"S";"0362";"      FINSI"
"SGRCI";"S";"0363";"   FINSI"
"SGRCI";"S";"0364";"FINSI"
"SGRCI";"S";"0365";"*"
"SGRCI";"S";"0366";"SI TEMP_DATSUI = LOCA_DATEFU"
"SGRCI";"S";"0367";"* JJA - 13/06/2025 - Pris prèv."
"SGRCI";"S";"0368";"   EMPL_SEQCRCI = HJOU_SJRCRCI + HJOU_SJRCRCIW"
"SGRCI";"S";"0369";"*"
"SGRCI";"S";"0370";"   EMPL_SEQSPRCI = HJOU_SJRSRCI - HJOU_SJRCRCIW"
"SGRCI";"S";"0371";"FINSI"
"SGRCI";"S";"0372";"*"
"SGRCI";"S";"0373";"FIN"
"SGRCI";"S";"0374";"*"
"SGRCI";"S";"0375";"* Gestion arrondis"
"SGRCI";"S";"0376";"PROC ARRONDI"
"SGRCI";"S";"0377";"*"
"SGRCI";"S";"0378";"*DEF LOCA_VALAROND N6.2"
"SGRCI";"S";"0379";"*LOCA_VALAROND = 0"
"SGRCI";"S";"0380";"*DEF LOCA_RESTE N6.2"
"SGRCI";"S";"0381";"*LOCA_RESTE = 0"
"SGRCI";"S";"0382";"*DEF LOCA_ENTIER N6.2"
"SGRCI";"S";"0383";"*LOCA_ENTIER = 0"
"SGRCI";"S";"0384";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGRCI";"S";"0385";"*DEF LOCA_TYPARROND N2"
"SGRCI";"S";"0386";"*LOCA_TYPARROND = 0"
"SGRCI";"S";"0387";"*"
"SGRCI";"S";"0388";"* Arrondi à l'entier supérieur >>"
"SGRCI";"S";"0389";"   SI LOCA_TYPARROND = 1"
"SGRCI";"S";"0390";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGRCI";"S";"0391";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGRCI";"S";"0392";"      SI LOCA_RESTE > 0"
"SGRCI";"S";"0393";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGRCI";"S";"0394";"      FINSI"
"SGRCI";"S";"0395";"      LOCA_VALAROND = LOCA_ENTIER"
"SGRCI";"S";"0396";"   FINSI"
"SGRCI";"S";"0397";"*"
"SGRCI";"S";"0398";"* Arrondi à demi supérieur >>"
"SGRCI";"S";"0399";"   SI LOCA_TYPARROND = 2"
"SGRCI";"S";"0400";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGRCI";"S";"0401";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGRCI";"S";"0402";"      SI LOCA_RESTE > 0.5"
"SGRCI";"S";"0403";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGRCI";"S";"0404";"      SINON"
"SGRCI";"S";"0405";"         SI LOCA_RESTE > 0"
"SGRCI";"S";"0406";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGRCI";"S";"0407";"         FINSI"
"SGRCI";"S";"0408";"      FINSI"
"SGRCI";"S";"0409";"      LOCA_VALAROND = LOCA_ENTIER"
"SGRCI";"S";"0410";"   FINSI"
"SGRCI";"S";"0411";"*"
"SGRCI";"S";"0412";"* Arrondi à demi le plus proche >>"
"SGRCI";"S";"0413";"   SI LOCA_TYPARROND = 3"
"SGRCI";"S";"0414";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGRCI";"S";"0415";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGRCI";"S";"0416";"      SI LOCA_RESTE >= 0.75"
"SGRCI";"S";"0417";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGRCI";"S";"0418";"      SINON"
"SGRCI";"S";"0419";"         SI LOCA_RESTE >= 0.25"
"SGRCI";"S";"0420";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGRCI";"S";"0421";"         FINSI"
"SGRCI";"S";"0422";"      FINSI"
"SGRCI";"S";"0423";"      LOCA_VALAROND = LOCA_ENTIER"
"SGRCI";"S";"0424";"   FINSI"
"SGRCI";"S";"0425";"*"
"SGRCI";"S";"0426";"FINPROC"
"SGRCI";"S";"0427";"*"
"SGRD";"S";"0001";"***********************************************************************"
"SGRD";"S";"0002";"*"
"SGRD";"S";"0003";"* Règle : SGRD"
"SGRD";"S";"0004";"* Ordre : 6240"
"SGRD";"S";"0005";"* Titre : GCF : Récupération de dimanche"
"SGRD";"S";"0006";"*"
"SGRD";"S";"0007";"*----------------------------------------------------------------------"
"SGRD";"S";"0008";"*"
"SGRD";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SGRD";"S";"0010";"* Date     : 23/01/2025"
"SGRD";"S";"0011";"* Version  : 1"
"SGRD";"S";"0012";"*"
"SGRD";"S";"0013";"*----------------------------------------------------------------------"
"SGRD";"S";"0014";"*"
"SGRD";"S";"0015";"*"
"SGRD";"S";"0016";"* Rôle : Cette récupération concerne certain service de l'industrie (exclusion des FJ)"
"SGRD";"S";"0017";"*        RD = Récupération de dimanche"
"SGRD";"S";"0018";"*        Acquisition au fil de l'eau selon le nombre de dimmanche travaillé"
"SGRD";"S";"0019";"*"
"SGRD";"S";"0020";"*"
"SGRD";"S";"0021";"*----------------------------------------------------------------------"
"SGRD";"S";"0022";"*"
"SGRD";"S";"0023";"* Modifiée par :"
"SGRD";"S";"0024";"* Date         :"
"SGRD";"S";"0025";"* Objet        :"
"SGRD";"S";"0026";"*"
"SGRD";"S";"0027";"***********************************************************************"
"SGRD";"S";"0028";"*"
"SGRD";"S";"0029";"* Implémentation des données industrielles"
"SGRD";"S";"0030";"*"
"SGRD";"S";"0031";"DEBDICO"
"SGRD";"S";"0032";"   HJOU_SJRDRD;N;N6,2;I;;;     6789;;SJRDRD;V3;""Droit RD"";"
"SGRD";"S";"0033";"   HJOU_SJRDRDA;N;N6,2;I;;;     6789;;SJRDRDA;V3;""Droit RD en cours acquis."";"
"SGRD";"S";"0034";"   HJOU_SJRCRD;N;N6,2;I;;;     6789;;SJRCRD;V3;""Pris RD"";"
"SGRD";"S";"0035";"   HJOU_SJRSRD;N;N6,2;I;;;     6789;;SJRSRD;V3;""Solde RD"";"
"SGRD";"S";"0036";"   HJOU_SJRSRDH;N;N6,2;I;;;     6789;;SJRSRDH;V3;""Solde RD historique"";"
"SGRD";"S";"0037";"   HJOU_SJRCRDW;N;N6,2;I;;;     6789;;SJRCRDW;V3;""Pris RD en attente"";"
"SGRD";"S";"0038";"   EMPL_SEQSPRD;N;N6,1;I;;;    56789;;;V3;""Solde prév. RD"";"
"SGRD";"S";"0039";"   PARD_SDIVMRD;O;A10;X;;;123456789;II;;C2;""Motif RD"";"
"SGRD";"S";"0040";"   SECH_SSIGRD;O;Z1;X;;;123456789;L9;;C2;""Droit au RD"";"
"SGRD";"S";"0041";"   HJOU_SJITYPSERV;O;A15;X;;;        9;L9;;C2;""Type de service"";"
"SGRD";"S";"0042";"   HORC_SHITNUIT;O;Z1;X;;;      789;L9;;C2;""Horaires de nuit"";"
"SGRD";"S";"0043";"   HJOU_IJRNDIMTRA;N;N5,1;I;;;    56789;;IJRNDIMTRA;V3;""Nbre de dimanche travaillés annuel"";"
"SGRD";"S";"0044";"   HJOU_IJRNSAMTRA;N;N5,1;I;;;    56789;;IJRNSAMTRA;V3;""Nbre de samedi travaillés annuel"";"
"SGRD";"S";"0045";"   *"
"SGRD";"S";"0046";"   EMPL_SEQCRD;N;N6,1;I;;;    56789;;;V3;""Pris prév. RD"";"
"SGRD";"S";"0047";"FINDICO"
"SGRD";"S";"0048";"*"
"SGRD";"S";"0049";"DEBANO"
"SGRD";"S";"0050";"   238;9;""Pas droit au motif RD"";"
"SGRD";"S";"0051";"   239;8;""Solde RD insuffisant"";"
"SGRD";"S";"0052";"FINANO"
"SGRD";"S";"0053";"*"
"SGRD";"S";"0054";"* Déclaration des donnees locales"
"SGRD";"S";"0055";"*"
"SGRD";"S";"0056";"DEF LOCA_DROIT N2"
"SGRD";"S";"0057";"LOCA_DROIT = 0"
"SGRD";"S";"0058";"DEF LOCA_MOT N2"
"SGRD";"S";"0059";"LOCA_MOT = 0"
"SGRD";"S";"0060";"DEF LOCA_PRIS N6.2"
"SGRD";"S";"0061";"LOCA_PRIS = 0"
"SGRD";"S";"0062";"DEF LOCA_PERCO N6.2"
"SGRD";"S";"0063";"LOCA_PERCO = 0"
"SGRD";"S";"0064";"DEF LOCA_PRISW N6.2"
"SGRD";"S";"0065";"LOCA_PRISW = 0"
"SGRD";"S";"0066";"DEF LOCA_PERCOW N6.2"
"SGRD";"S";"0067";"LOCA_PERCOW = 0"
"SGRD";"S";"0068";"DEF LOCA_FERI N2"
"SGRD";"S";"0069";"LOCA_FERI = 0"
"SGRD";"S";"0070";"DEF LOCA_DRD N6.2"
"SGRD";"S";"0071";"LOCA_DRD = 0"
"SGRD";"S";"0072";"DEF LOCA_SAMDIM N4"
"SGRD";"S";"0073";"LOCA_SAMDIM = 0"
"SGRD";"S";"0074";"DEF LOCA_IJQTTEFFEJ T6.2"
"SGRD";"S";"0075";"LOCA_IJQTTEFFEJ = 0.00"
"SGRD";"S";"0076";"*"
"SGRD";"S";"0077";"DEF LOCA_DATE D"
"SGRD";"S";"0078";"LOCA_DATE(5:4) = ""0101"""
"SGRD";"S";"0079";"DEF LOCA_DATEFU D"
"SGRD";"S";"0080";"LOCA_DATEFU(5:4) = ""0101"""
"SGRD";"S";"0081";"DEF LOCA_ANNEE N4"
"SGRD";"S";"0082";"LOCA_ANNEE << TEMP_DATJOU(1:4)"
"SGRD";"S";"0083";"LOCA_DATE(1:4) << LOCA_ANNEE"
"SGRD";"S";"0084";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SGRD";"S";"0085";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SGRD";"S";"0086";"*"
"SGRD";"S";"0087";"POUR ACTIVITES"
"SGRD";"S";"0088";"   SI HABS_MOTIF = ""JF"""
"SGRD";"S";"0089";"      LOCA_FERI = 1"
"SGRD";"S";"0090";"   FINSI"
"SGRD";"S";"0091";"FINPOUR"
"SGRD";"S";"0092";"*"
"SGRD";"S";"0093";"SI TEMP_DATSUI <= HJOU_DATE"
"SGRD";"S";"0094";"   LOCA_IJQTTEFFEJ = HJOU_IJQTTEFFEJ"
"SGRD";"S";"0095";"SINON"
"SGRD";"S";"0096";"   LOCA_IJQTTEFFEJ = HJOU_IJQPRETHEJ"
"SGRD";"S";"0097";"FINSI"
"SGRD";"S";"0098";"*"
"SGRD";"S";"0099";"***** DEB : Gestion de l'acquisition >>"
"SGRD";"S";"0100";"*"
"SGRD";"S";"0101";"* Uniquement industrie"
"SGRD";"S";"0102";"SI HJOU_SECTORI(1:3) = ""DIN"""
"SGRD";"S";"0103";"* Société MO"
"SGRD";"S";"0104";"   SI HJOU_SJQSOCIETE = ""MO"""
"SGRD";"S";"0105";"* Si service donne droit"
"SGRD";"S";"0106";"      SI SECH_SSIGRD = ""1"""
"SGRD";"S";"0107";"* Exclu forfait jour"
"SGRD";"S";"0108";"         SI HJOU_SJQFORFJR <> ""1"""
"SGRD";"S";"0109";"*"
"SGRD";"S";"0110";"* Cas du service de la rotative >>"
"SGRD";"S";"0111";"            SI HJOU_SJITYPSERV = ""ROTATIVE"""
"SGRD";"S";"0112";"               LOCA_DROIT = 1"
"SGRD";"S";"0113";"* Si dimanche travaillé ?"
"SGRD";"S";"0114";"               SI HJOU_JOUR = ""7"""
"SGRD";"S";"0115";"                  SI LOCA_IJQTTEFFEJ > 0"
"SGRD";"S";"0116";"*"
"SGRD";"S";"0117";"* Acquisition 1 RD tout les 2 dimanches travaillés jusqu'à 6 RD"
"SGRD";"S";"0118";"                     SI HJOU_IJRNDIMTRA = 2"
"SGRD";"S";"0119";"                     OU HJOU_IJRNDIMTRA = 4"
"SGRD";"S";"0120";"                     OU HJOU_IJRNDIMTRA = 6"
"SGRD";"S";"0121";"                     OU HJOU_IJRNDIMTRA = 8"
"SGRD";"S";"0122";"                     OU HJOU_IJRNDIMTRA = 10"
"SGRD";"S";"0123";"                     OU HJOU_IJRNDIMTRA = 12"
"SGRD";"S";"0124";"                        LOCA_DRD = 1"
"SGRD";"S";"0125";"                     FINSI"
"SGRD";"S";"0126";"* A partir de 6 RD - Acquisition 2 RD tous les 3 dimanches travaillés"
"SGRD";"S";"0127";"                     SI HJOU_IJRNDIMTRA = 15"
"SGRD";"S";"0128";"                     OU HJOU_IJRNDIMTRA = 18"
"SGRD";"S";"0129";"                     OU HJOU_IJRNDIMTRA = 21"
"SGRD";"S";"0130";"                     OU HJOU_IJRNDIMTRA = 24"
"SGRD";"S";"0131";"                     OU HJOU_IJRNDIMTRA = 27"
"SGRD";"S";"0132";"                     OU HJOU_IJRNDIMTRA = 30"
"SGRD";"S";"0133";"                     OU HJOU_IJRNDIMTRA = 33"
"SGRD";"S";"0134";"                     OU HJOU_IJRNDIMTRA = 36"
"SGRD";"S";"0135";"                     OU HJOU_IJRNDIMTRA = 39"
"SGRD";"S";"0136";"                     OU HJOU_IJRNDIMTRA = 42"
"SGRD";"S";"0137";"                     OU HJOU_IJRNDIMTRA = 45"
"SGRD";"S";"0138";"                     OU HJOU_IJRNDIMTRA = 48"
"SGRD";"S";"0139";"                     OU HJOU_IJRNDIMTRA = 51"
"SGRD";"S";"0140";"                        LOCA_DRD = 2"
"SGRD";"S";"0141";"                     FINSI"
"SGRD";"S";"0142";"                  FINSI"
"SGRD";"S";"0143";"               FINSI"
"SGRD";"S";"0144";"            FINSI"
"SGRD";"S";"0145";"*"
"SGRD";"S";"0146";"* Cas du service de l'expédition et moyens généraux >>"
"SGRD";"S";"0147";"            SI HJOU_SJITYPSERV = ""EXPEDITION"""
"SGRD";"S";"0148";"            OU HJOU_SJITYPSERV = ""MOYGENERAUX"""
"SGRD";"S";"0149";"               LOCA_DROIT = 1"
"SGRD";"S";"0150";"* Si dimanche travaillé ?"
"SGRD";"S";"0151";"               SI HJOU_JOUR = ""7"""
"SGRD";"S";"0152";"                  SI LOCA_IJQTTEFFEJ > 0"
"SGRD";"S";"0153";"*"
"SGRD";"S";"0154";"* Acquisition 1 RD si 2 ou 17 dimanches travaillés"
"SGRD";"S";"0155";"                     SI HJOU_IJRNDIMTRA = 2"
"SGRD";"S";"0156";"                     OU HJOU_IJRNDIMTRA = 17"
"SGRD";"S";"0157";"                        LOCA_DRD = 1"
"SGRD";"S";"0158";"                     FINSI"
"SGRD";"S";"0159";"* Acquisition de 2 RD si travaillé 19 dimanche"
"SGRD";"S";"0160";"                     SI HJOU_IJRNDIMTRA = 19"
"SGRD";"S";"0161";"                        LOCA_DRD = 2"
"SGRD";"S";"0162";"                     FINSI"
"SGRD";"S";"0163";"                  FINSI"
"SGRD";"S";"0164";"               FINSI"
"SGRD";"S";"0165";"            FINSI"
"SGRD";"S";"0166";"*"
"SGRD";"S";"0167";"* Cas du service maintenance de nuit/jour >>"
"SGRD";"S";"0168";"            SI HJOU_SJITYPSERV = ""MAINTENANCE"""
"SGRD";"S";"0169";"               LOCA_DROIT = 1"
"SGRD";"S";"0170";"* Si travailleurs de nuit"
"SGRD";"S";"0171";"               SI HORC_SHITNUIT = ""1"""
"SGRD";"S";"0172";"* Si dimanche travaillé ?"
"SGRD";"S";"0173";"                  SI HJOU_JOUR = ""7"""
"SGRD";"S";"0174";"                     SI LOCA_IJQTTEFFEJ > 0"
"SGRD";"S";"0175";"*"
"SGRD";"S";"0176";"* Acquisition 1 RD si 2 ou 17 dimanches travaillés"
"SGRD";"S";"0177";"                        SI HJOU_IJRNDIMTRA = 2"
"SGRD";"S";"0178";"                        OU HJOU_IJRNDIMTRA = 17"
"SGRD";"S";"0179";"                           LOCA_DRD = 1"
"SGRD";"S";"0180";"                        FINSI"
"SGRD";"S";"0181";"* Acquisition de 2 RD si travaillé 19 dimanche"
"SGRD";"S";"0182";"                        SI HJOU_IJRNDIMTRA = 19"
"SGRD";"S";"0183";"                           LOCA_DRD = 2"
"SGRD";"S";"0184";"                        FINSI"
"SGRD";"S";"0185";"                     FINSI"
"SGRD";"S";"0186";"                  FINSI"
"SGRD";"S";"0187";"               SINON"
"SGRD";"S";"0188";"* Si dimanche ou samedi travaillé ?"
"SGRD";"S";"0189";"                  SI HJOU_JOUR = ""7"""
"SGRD";"S";"0190";"                  OU HJOU_JOUR = ""6"""
"SGRD";"S";"0191";"                     SI LOCA_IJQTTEFFEJ > 0"
"SGRD";"S";"0192";"*"
"SGRD";"S";"0193";"* Acquisition 1 RD tout les 4 samedi ou dimanche travaillé"
"SGRD";"S";"0194";"                        LOCA_SAMDIM = HJOU_IJRNDIMTRA + HJOU_IJRNSAMTRA"
"SGRD";"S";"0195";"*"
"SGRD";"S";"0196";"                        SI LOCA_SAMDIM = 4"
"SGRD";"S";"0197";"                        OU LOCA_SAMDIM = 8"
"SGRD";"S";"0198";"                        OU LOCA_SAMDIM = 12"
"SGRD";"S";"0199";"                        OU LOCA_SAMDIM = 16"
"SGRD";"S";"0200";"                        OU LOCA_SAMDIM = 20"
"SGRD";"S";"0201";"                        OU LOCA_SAMDIM = 24"
"SGRD";"S";"0202";"                        OU LOCA_SAMDIM = 28"
"SGRD";"S";"0203";"                        OU LOCA_SAMDIM = 32"
"SGRD";"S";"0204";"                        OU LOCA_SAMDIM = 36"
"SGRD";"S";"0205";"                        OU LOCA_SAMDIM = 40"
"SGRD";"S";"0206";"                        OU LOCA_SAMDIM = 44"
"SGRD";"S";"0207";"                        OU LOCA_SAMDIM = 48"
"SGRD";"S";"0208";"                        OU LOCA_SAMDIM = 52"
"SGRD";"S";"0209";"                           LOCA_DRD = 1"
"SGRD";"S";"0210";"                        FINSI"
"SGRD";"S";"0211";"*"
"SGRD";"S";"0212";"                     FINSI"
"SGRD";"S";"0213";"                  FINSI"
"SGRD";"S";"0214";"               FINSI"
"SGRD";"S";"0215";"*"
"SGRD";"S";"0216";"            FINSI"
"SGRD";"S";"0217";"*"
"SGRD";"S";"0218";"         FINSI"
"SGRD";"S";"0219";"      FINSI"
"SGRD";"S";"0220";"   FINSI"
"SGRD";"S";"0221";"FINSI"
"SGRD";"S";"0222";"*"
"SGRD";"S";"0223";"* RAZ à période de référence >>"
"SGRD";"S";"0224";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SGRD";"S";"0225";"*"
"SGRD";"S";"0226";"*   HJOU_SJRDRD = HJOU_SJRDRD + HJOU_SJRDRDA"
"SGRD";"S";"0227";"   HJOU_SJRDRD = HJOU_SJRDRDA"
"SGRD";"S";"0228";"   HJOU_SJRDRDA = 0"
"SGRD";"S";"0229";"*"
"SGRD";"S";"0230";"* RAZ du pris"
"SGRD";"S";"0231";"   HJOU_SJRCRD = 0"
"SGRD";"S";"0232";"   HJOU_SJRSRD = HJOU_SJRDRD - HJOU_SJRCRD"
"SGRD";"S";"0233";"*"
"SGRD";"S";"0234";"FINSI"
"SGRD";"S";"0235";"*"
"SGRD";"S";"0236";"* Alimentation du droit au fil de l'eau >>"
"SGRD";"S";"0237";"SI LOCA_DRD > 0"
"SGRD";"S";"0238";"   HJOU_SJRDRDA = HJOU_SJRDRDA + LOCA_DRD"
"SGRD";"S";"0239";"FINSI"
"SGRD";"S";"0240";"*"
"SGRD";"S";"0241";"* Init et MAJ du droit par consignes >>"
"SGRD";"S";"0242";"POUR ACTIVITES"
"SGRD";"S";"0243";"* MAJ"
"SGRD";"S";"0244";"   SI HABS_MOTIF = ""XDRD"""
"SGRD";"S";"0245";"      HJOU_SJRDRD = HJOU_SJRDRD + HABS_MOTINBR"
"SGRD";"S";"0246";"   FINSI"
"SGRD";"S";"0247";"* Init"
"SGRD";"S";"0248";"   SI HABS_MOTIF = ""ZDRD"""
"SGRD";"S";"0249";"      HJOU_SJRDRD = HABS_MOTINBR"
"SGRD";"S";"0250";"   FINSI"
"SGRD";"S";"0251";"*"
"SGRD";"S";"0252";"* Init Droit RD historique"
"SGRD";"S";"0253";"   SI HABS_MOTIF = ""ZDRDH"""
"SGRD";"S";"0254";"      HJOU_SJRSRDH = HABS_MOTINBR"
"SGRD";"S";"0255";"   FINSI"
"SGRD";"S";"0256";"* Init droit RD en cours acquis."
"SGRD";"S";"0257";"   SI HABS_MOTIF = ""ZDRDA"""
"SGRD";"S";"0258";"      HJOU_SJRDRDA = HABS_MOTINBR"
"SGRD";"S";"0259";"   FINSI"
"SGRD";"S";"0260";"FINPOUR"
"SGRD";"S";"0261";"*"
"SGRD";"S";"0262";"* Solde >>"
"SGRD";"S";"0263";"HJOU_SJRSRD = HJOU_SJRDRD - HJOU_SJRCRD"
"SGRD";"S";"0264";"*"
"SGRD";"S";"0265";"***** DEB : Gestion de la consommation >>"
"SGRD";"S";"0266";"POUR ACTIVITES"
"SGRD";"S";"0267";"*"
"SGRD";"S";"0268";"* Gestion du PERCO >>"
"SGRD";"S";"0269";"   SI HABS_MOTIF = ""YPERRD"""
"SGRD";"S";"0270";"      LOCA_PERCO = LOCA_PERCO + HABS_MOTINBR"
"SGRD";"S";"0271";"   FINSI"
"SGRD";"S";"0272";"*"
"SGRD";"S";"0273";"* Gestion don de RD"
"SGRD";"S";"0274";"   SI HABS_MOTIF = ""YDONRD"""
"SGRD";"S";"0275";"      HJOU_SJRCRD = HJOU_SJRCRD + HABS_MOTINBR"
"SGRD";"S";"0276";"      HJOU_SJRSRD = HJOU_SJRDRD - HJOU_SJRCRD"
"SGRD";"S";"0277";"   FINSI"
"SGRD";"S";"0278";"*"
"SGRD";"S";"0279";"   SI HJOU_IJQPRETHEJ > 0"
"SGRD";"S";"0280";"      SI HABS_MOTIF = PARD_SDIVMRD"
"SGRD";"S";"0281";"         LOCA_MOT = 1"
"SGRD";"S";"0282";"*"
"SGRD";"S";"0283";"         SI HABS_VALORIS = ""J"""
"SGRD";"S";"0284";"            SI PROF_ABSENM = 0"
"SGRD";"S";"0285";"            OU PROF_ABSENS = 0"
"SGRD";"S";"0286";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SGRD";"S";"0287";"            SINON"
"SGRD";"S";"0288";"               LOCA_PRIS = LOCA_PRIS + 1"
"SGRD";"S";"0289";"            FINSI"
"SGRD";"S";"0290";"         SINON"
"SGRD";"S";"0291";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SGRD";"S";"0292";"         FINSI"
"SGRD";"S";"0293";"*"
"SGRD";"S";"0294";"      FINSI"
"SGRD";"S";"0295";"   FINSI"
"SGRD";"S";"0296";"FINPOUR"
"SGRD";"S";"0297";"*"
"SGRD";"S";"0298";"SI LOCA_PRIS > 1"
"SGRD";"S";"0299";"   LOCA_PRIS = 1"
"SGRD";"S";"0300";"FINSI"
"SGRD";"S";"0301";"*"
"SGRD";"S";"0302";"* Pr1 : Pris RD"
"SGRD";"S";"0303";"SI LOCA_PRIS > 0"
"SGRD";"S";"0304";"   SI HJOU_SJRSRD > LOCA_PRIS"
"SGRD";"S";"0305";"      HJOU_SJRCRD = HJOU_SJRCRD + LOCA_PRIS"
"SGRD";"S";"0306";"      HJOU_SJRSRD = HJOU_SJRDRD - HJOU_SJRCRD"
"SGRD";"S";"0307";"      LOCA_PRIS = 0"
"SGRD";"S";"0308";"   SINON"
"SGRD";"S";"0309";"      SI HJOU_SJRSRD > 0"
"SGRD";"S";"0310";"         LOCA_PRIS = LOCA_PRIS - HJOU_SJRSRD"
"SGRD";"S";"0311";"         HJOU_SJRCRD = HJOU_SJRCRD + HJOU_SJRSRD"
"SGRD";"S";"0312";"         HJOU_SJRSRD = HJOU_SJRDRD - HJOU_SJRCRD"
"SGRD";"S";"0313";"      FINSI"
"SGRD";"S";"0314";"   FINSI"
"SGRD";"S";"0315";"FINSI"
"SGRD";"S";"0316";"*"
"SGRD";"S";"0317";"* Pr2 : Pris RD historique"
"SGRD";"S";"0318";"SI LOCA_PRIS > 0"
"SGRD";"S";"0319";"   SI HJOU_SJRSRDH > LOCA_PRIS"
"SGRD";"S";"0320";"      HJOU_SJRSRDH = HJOU_SJRSRDH - LOCA_PRIS"
"SGRD";"S";"0321";"      LOCA_PRIS = 0"
"SGRD";"S";"0322";"   SINON"
"SGRD";"S";"0323";"      SI HJOU_SJRSRDH > 0"
"SGRD";"S";"0324";"         LOCA_PRIS = LOCA_PRIS - HJOU_SJRSRDH"
"SGRD";"S";"0325";"         HJOU_SJRSRDH = 0"
"SGRD";"S";"0326";"      FINSI"
"SGRD";"S";"0327";"   FINSI"
"SGRD";"S";"0328";"FINSI"
"SGRD";"S";"0329";"*"
"SGRD";"S";"0330";"* Pr3 : Pris RD"
"SGRD";"S";"0331";"SI LOCA_PRIS > 0"
"SGRD";"S";"0332";"   HJOU_SJRCRD = HJOU_SJRCRD + LOCA_PRIS"
"SGRD";"S";"0333";"   HJOU_SJRSRD = HJOU_SJRDRD - HJOU_SJRCRD"
"SGRD";"S";"0334";"   LOCA_PRIS = 0"
"SGRD";"S";"0335";"FINSI"
"SGRD";"S";"0336";"*"
"SGRD";"S";"0337";"SI LOCA_PERCO > 0"
"SGRD";"S";"0338";"   HJOU_SJRCRD = HJOU_SJRCRD + LOCA_PERCO"
"SGRD";"S";"0339";"FINSI"
"SGRD";"S";"0340";"*"
"SGRD";"S";"0341";"* Init et MAJ du pris par consignes >>"
"SGRD";"S";"0342";"POUR ACTIVITES"
"SGRD";"S";"0343";"* MAJ"
"SGRD";"S";"0344";"   SI HABS_MOTIF = ""XCRD"""
"SGRD";"S";"0345";"      HJOU_SJRCRD = HJOU_SJRCRD + HABS_MOTINBR"
"SGRD";"S";"0346";"   FINSI"
"SGRD";"S";"0347";"* Init"
"SGRD";"S";"0348";"   SI HABS_MOTIF = ""ZCRD"""
"SGRD";"S";"0349";"      HJOU_SJRCRD = HABS_MOTINBR"
"SGRD";"S";"0350";"   FINSI"
"SGRD";"S";"0351";"FINPOUR"
"SGRD";"S";"0352";"*"
"SGRD";"S";"0353";"* Solde >>"
"SGRD";"S";"0354";"HJOU_SJRSRD = HJOU_SJRDRD - HJOU_SJRCRD"
"SGRD";"S";"0355";"*"
"SGRD";"S";"0356";"***** DEB : Gestion du pris en attente >>"
"SGRD";"S";"0357";"*"
"SGRD";"S";"0358";"POUR WACTIVITES"
"SGRD";"S";"0359";"   SI WABS_ANNUL = ""0"""
"SGRD";"S";"0360";"      SI LOCA_FERI <> 1"
"SGRD";"S";"0361";"         SI HJOU_IJQPRETHEJ > 0.00"
"SGRD";"S";"0362";"*"
"SGRD";"S";"0363";"* PERCO"
"SGRD";"S";"0364";"            SI WABS_MOTIF = ""YPERRD"""
"SGRD";"S";"0365";"               LOCA_PERCOW = LOCA_PERCOW + WABS_MOTINBR"
"SGRD";"S";"0366";"            FINSI"
"SGRD";"S";"0367";"*"
"SGRD";"S";"0368";"            SI WABS_MOTIF = PARD_SDIVMRD"
"SGRD";"S";"0369";"* Gestion de la valorisation >>"
"SGRD";"S";"0370";"               SI WABS_VALORIS = ""J"""
"SGRD";"S";"0371";"                  SI PROF_ABSENM = 0"
"SGRD";"S";"0372";"                  OU PROF_ABSENS = 0"
"SGRD";"S";"0373";"                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SGRD";"S";"0374";"                  SINON"
"SGRD";"S";"0375";"                     LOCA_PRISW = 1"
"SGRD";"S";"0376";"                  FINSI"
"SGRD";"S";"0377";"               SINON"
"SGRD";"S";"0378";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SGRD";"S";"0379";"               FINSI"
"SGRD";"S";"0380";"            FINSI"
"SGRD";"S";"0381";"         FINSI"
"SGRD";"S";"0382";"      FINSI"
"SGRD";"S";"0383";"   FINSI"
"SGRD";"S";"0384";"FINPOUR"
"SGRD";"S";"0385";"*"
"SGRD";"S";"0386";"SI LOCA_PRISW > 1"
"SGRD";"S";"0387";"   LOCA_PRISW = 1"
"SGRD";"S";"0388";"FINSI"
"SGRD";"S";"0389";"*"
"SGRD";"S";"0390";"SI LOCA_PRISW > 0"
"SGRD";"S";"0391";"   HJOU_SJRCRDW = HJOU_SJRCRDW + LOCA_PRISW"
"SGRD";"S";"0392";"FINSI"
"SGRD";"S";"0393";"SI LOCA_PERCOW > 0"
"SGRD";"S";"0394";"   HJOU_SJRCRDW = HJOU_SJRCRDW + LOCA_PERCOW"
"SGRD";"S";"0395";"FINSI"
"SGRD";"S";"0396";"*"
"SGRD";"S";"0397";"* Solde >>"
"SGRD";"S";"0398";"HJOU_SJRSRD = HJOU_SJRDRD - HJOU_SJRCRD"
"SGRD";"S";"0399";"*"
"SGRD";"S";"0400";"***** Gestion des anomalies >>"
"SGRD";"S";"0401";"*"
"SGRD";"S";"0402";"SI LOCA_MOT = 1"
"SGRD";"S";"0403";"* Si droit ?"
"SGRD";"S";"0404";"   SI LOCA_DROIT <> 1"
"SGRD";"S";"0405";"      ANOMALIE 238"
"SGRD";"S";"0406";"      SI TEMP_CNMOTIF = PARD_SDIVMRD"
"SGRD";"S";"0407";"         TEMP_CNRETOUR = 2"
"SGRD";"S";"0408";"         TEMP_CNMESS = 238"
"SGRD";"S";"0409";"      FINSI"
"SGRD";"S";"0410";"   FINSI"
"SGRD";"S";"0411";"* Si solde négatif ?"
"SGRD";"S";"0412";"   SI HJOU_SJRSRD < 0"
"SGRD";"S";"0413";"      ANOMALIE 239"
"SGRD";"S";"0414";"      SI TEMP_CNMOTIF = PARD_SDIVMRD"
"SGRD";"S";"0415";"      OU TEMP_CNMOTIF = ""YPERRD"""
"SGRD";"S";"0416";"         TEMP_CNRETOUR = 2"
"SGRD";"S";"0417";"         TEMP_CNMESS = 239"
"SGRD";"S";"0418";"      FINSI"
"SGRD";"S";"0419";"   FINSI"
"SGRD";"S";"0420";"*"
"SGRD";"S";"0421";"FINSI"
"SGRD";"S";"0422";"*"
"SGRD";"S";"0423";"SI LOCA_PERCO > 0"
"SGRD";"S";"0424";"* Si solde négatif ?"
"SGRD";"S";"0425";"   SI HJOU_SJRSRD < 0"
"SGRD";"S";"0426";"      ANOMALIE 239"
"SGRD";"S";"0427";"      SI TEMP_CNMOTIF = PARD_SDIVMRD"
"SGRD";"S";"0428";"      OU TEMP_CNMOTIF = ""YPERRD"""
"SGRD";"S";"0429";"         TEMP_CNRETOUR = 2"
"SGRD";"S";"0430";"         TEMP_CNMESS = 239"
"SGRD";"S";"0431";"      FINSI"
"SGRD";"S";"0432";"   FINSI"
"SGRD";"S";"0433";"FINSI"
"SGRD";"S";"0434";"*"
"SGRD";"S";"0435";"***** Solde prévisionnel >>"
"SGRD";"S";"0436";"*"
"SGRD";"S";"0437";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGRD";"S";"0438";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SGRD";"S";"0439";"      SI HJOU_SJQFINC = 1"
"SGRD";"S";"0440";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGRD";"S";"0441";"         LOCA_DATEFU = TEMP_DXFINPER"
"SGRD";"S";"0442";"      FINSI"
"SGRD";"S";"0443";"   FINSI"
"SGRD";"S";"0444";"FINSI"
"SGRD";"S";"0445";"*"
"SGRD";"S";"0446";"SI TEMP_DATSUI = LOCA_DATEFU"
"SGRD";"S";"0447";"* JJA - 13/06/2025 - Pris prèv."
"SGRD";"S";"0448";"   EMPL_SEQCRD = HJOU_SJRCRD + HJOU_SJRCRDW"
"SGRD";"S";"0449";"*"
"SGRD";"S";"0450";"   EMPL_SEQSPRD = HJOU_SJRSRD + HJOU_SJRSRDH"
"SGRD";"S";"0451";"   EMPL_SEQSPRD = EMPL_SEQSPRD - HJOU_SJRCRDW"
"SGRD";"S";"0452";"FINSI"
"SGRD";"S";"0453";"*"
"SGRD";"S";"0454";"FIN"
