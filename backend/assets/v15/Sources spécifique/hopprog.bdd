"SDACQ";"S";"0194";"***************"
"SDACQ";"S";"0195";"* RAZ date d'acquisition N-3 si fin d'historique < année N-3"
"SDACQ";"S";"0196";"SI EMPL_SEIDATFIN(1:4) < LOCA_DATEP3(1:4)"
"SDACQ";"S";"0197";"   EMPL_SEIDATACQ3 = "" """
"SDACQ";"S";"0198";"FINSI"
"SDACQ";"S";"0199";"SI HJOU_DATE(1:4) = LOCA_DATEP3(1:4)"
"SDACQ";"S";"0200";"   SI HJOU_DATE(5:4) = ""0101"""
"SDACQ";"S";"0201";"   OU HJOU_DATE = HJOU_SJRDDEBCTR"
"SDACQ";"S";"0202";"      EMPL_SEIDATACQ3 = HJOU_DATE"
"SDACQ";"S";"0203";"   FINSI"
