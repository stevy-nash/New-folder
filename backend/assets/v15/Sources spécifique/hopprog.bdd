"IGCSEGLISS";"S";"0276";"         OU HABS_MOTIF = ""DECSEB"""
"IGCSEGLISS";"S";"0277";"            LOCA_CONSO = 1"
"IGCSEGLISS";"S";"0278";"*Prise annuel"
"IGCSEGLISS";"S";"0279";"            HJOU_IJRAPCSE = HJOU_IJRAPCSE + HABS_MOTIDUR"
"IGCSEGLISS";"S";"0280";"*"
"IGCSEGLISS";"S";"0281";"            LOCA_RESTET = HABS_MOTIDUR"
"IGCSEGLISS";"S";"0282";"            HJOU_IJRCUPMCSE = HJOU_IJRCUPMCSE + LOCA_RESTET"
"IGCSEGLISS";"S";"0283";"*Si le solde mensuel > 0"
