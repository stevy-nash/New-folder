"IDISPHD";"S";"0013";"*---------------------------------------------------------------------"
"IDISPHD";"S";"0014";"*"
"IDISPHD";"S";"0015";"*"
"IDISPHD";"S";"0016";"* Rôle : Mettre à disposition une règle gérant des compteurs droit/pris/solde"
"IDISPHD";"S";"0017";"*         Mais également des compteurs afin de ne pas avoir à en"
