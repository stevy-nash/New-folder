"SANOM";"S";"0473";"            ENLEVER LOCA_TRAV"
"SANOM";"S";"0474";"            AJOUTER LOCA_TRAV ""M"" LOCA_ABSENM"
"SANOM";"S";"0475";"         FINSI"
"SANOM";"S";"0476";"      FINSI"
"SANOM";"S";"0477";"   FINSI"
"SANOM";"S";"0478";"*"
"SANOM";"S";"0479";"   SI LOCA_ABSJ = 0"
"SANOM";"S";"0480";"      SI LOCA_ABSM = 0"
"SANOM";"S";"0481";"         SI LOCA_ABSA = 0"
"SANOM";"S";"0482";"            ENLEVER LOCA_TRAV"
"SANOM";"S";"0483";"            ENLEVER LOCA_TRAV"
"SANOM";"S";"0484";"            ENLEVER LOCA_TRAV"
"SANOM";"S";"0485";"            ENLEVER LOCA_TRAV"
"SANOM";"S";"0486";"            AJOUTER LOCA_TRAV ""J"" HJOU_IJQPRETHEJ"
"SANOM";"S";"0487";"         FINSI"
"SANOM";"S";"0488";"      FINSI"
