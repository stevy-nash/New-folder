"SCPTBASE";"S";"0168";"                              HJOU_SJQHTENT2 = 0"
"SCPTBASE";"S";"0169";"                              HJOU_SJQHTSOR2 = 0"
"SCPTBASE";"S";"0170";"                           FINSI"
"SCPTBASE";"S";"0171";"                           SI HJOU_SJQHTSOR3 > LOCA_HRMIDI"
"SCPTBASE";"S";"0172";"                              HJOU_SJQHTENT3 = 0"
"SCPTBASE";"S";"0173";"                              HJOU_SJQHTSOR3 = 0"
"SCPTBASE";"S";"0174";"                           FINSI"
"SCPTBASE";"S";"0175";"                           SI HJOU_SJQHTSOR4 > LOCA_HRMIDI"
"SCPTBASE";"S";"0176";"                              HJOU_SJQHTENT4 = 0"
"SCPTBASE";"S";"0177";"                              HJOU_SJQHTSOR4 = 0"
"SCPTBASE";"S";"0178";"                           FINSI"
"SCPTBASE";"S";"0179";"                           SI HJOU_SJQHTSOR5 > LOCA_HRMIDI"
"SCPTBASE";"S";"0180";"                              HJOU_SJQHTENT5 = 0"
"SCPTBASE";"S";"0181";"                              HJOU_SJQHTSOR5 = 0"
"SCPTBASE";"S";"0182";"                           FINSI"
"SCPTBASE";"S";"0183";"                        SINON"
"SCPTBASE";"S";"0184";"                           HJOU_SJQHTENT2 = 0"
"SCPTBASE";"S";"0185";"                           HJOU_SJQHTSOR2 = 0"
"SCPTBASE";"S";"0186";"                        FINSI"
"SCPTBASE";"S";"0187";"                     FINSI"
