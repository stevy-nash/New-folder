"SROLE";"S";"0021";"   EMPL_SEIROLMA;O;A1;X;0;1;789;C;;C2;""Manager ?"";"
"SROLE";"S";"0022";"   EMPL_SEQROLEC;N;A10;X;;;789;;;V3;""Sélection du rôle calculé"";"
"SROLE";"S";"0023";"   EMPL_SEIROLEF;O;A10;X;;;789;L;;C2;""Sélection du rôle forcé"";"
"SROLE";"S";"0024";"   EMPL_SEQROLES;N;A10;X;;;789;;;V3;""Sélection du rôle"";"
