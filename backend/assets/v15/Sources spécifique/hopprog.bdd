"SANOM";"S";"0372";"   FINSI"
"SANOM";"S";"0373";"*"
"SANOM";"S";"0374";"FINSI"
"SANOM";"S";"0375";"*"
"SANOM";"S";"0376";"* Alerte collaborateur en délégation que dans le futur"
"SANOM";"S";"0377";"*"
"SANOM";"S";"0378";"SI HJOU_DATE >= TEMP_DATJOU"
"SANOM";"S";"0379";"   POUR ACTIVITES"
"SANOM";"S";"0380";"      SI HABS_MOTIF = PARD_SDIVMCSE"
"SANOM";"S";"0381";"      OU HABS_MOTIF = PARD_SDIVMDS"
"SANOM";"S";"0382";"      OU HABS_MOTIF = PARD_SDIVMRSCE"
"SANOM";"S";"0383";"      OU HABS_MOTIF = PARD_SDIVMCCIJP"
"SANOM";"S";"0384";"      OU HABS_MOTIF = ""REUCSE"""
"SANOM";"S";"0385";"         ANOMALIE 325"
