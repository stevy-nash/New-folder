"SHSUPPDIM2";"S";"0386";"   FINSI"
"SHSUPPDIM2";"S";"0387";"FINSI"
"SHSUPPDIM2";"S";"0388";"*"
"SHSUPPDIM2";"S";"0389";"* LOCA_MODALITE = 1 HS uniquement récupérées"
"SHSUPPDIM2";"S";"0390";"* LOCA_MODALITE = 2 HS uniquement payées"
"SHSUPPDIM2";"S";"0391";"* LOCA_MODALITE = 3 HS payées ou récupérées"
"SHSUPPDIM2";"S";"0392";"* LOCA_MODALITE = 4 HS uniquement récupérées sans majoration"
"SHSUPPDIM2";"S";"0393";"*"
"SHSUPPDIM2";"S";"0394";"* Déduit par le réglementaire >>"
"SHSUPPDIM2";"S";"0395";"SI LOCA_MODALITE = ""0"""
"SHSUPPDIM2";"S";"0396";"* Par défaut les 2"
"SHSUPPDIM2";"S";"0397";"   LOCA_MODALITE = ""3"""
"SHSUPPDIM2";"S";"0398";"*"
"SHSUPPDIM2";"S";"0399";"* Société EV ou PE - métier de l'évènementiel >>"
"SHSUPPDIM2";"S";"0400";"   SI HJOU_SJQSOCIETE = ""EV"""
"SHSUPPDIM2";"S";"0401";"   OU HJOU_SJQSOCIETE = ""PE"""
"SHSUPPDIM2";"S";"0402";"* HS uniquement récupéré"
"SHSUPPDIM2";"S";"0403";"      LOCA_MODALITE = ""1"""
"SHSUPPDIM2";"S";"0404";"      LOCA_SPEC = ""EVEN"""
"SHSUPPDIM2";"S";"0405";"   FINSI"
"SHSUPPDIM2";"S";"0406";"*"
"SHSUPPDIM2";"S";"0407";"* Société LI - métier de l'édition"
"SHSUPPDIM2";"S";"0408";"   SI HJOU_SJQSOCIETE = ""LI"""
"SHSUPPDIM2";"S";"0409";"* HS uniquement récupéré sans majo."
"SHSUPPDIM2";"S";"0410";"      LOCA_MODALITE = ""4"""
"SHSUPPDIM2";"S";"0411";"      LOCA_SPEC = ""EDIT"""
"SHSUPPDIM2";"S";"0412";"   FINSI"
"SHSUPPDIM2";"S";"0413";"*"
"SHSUPPDIM2";"S";"0414";"* Service de la diffusion exclure les HS du dimance"
"SHSUPPDIM2";"S";"0415";"   SI HJOU_SJITYPSERV = ""DIFFUSION"""
"SHSUPPDIM2";"S";"0416";"   OU HJOU_SECTORI(1:3) = ""DVM"""
"SHSUPPDIM2";"S";"0417";"* HS uniquement récupéré sans majo."
"SHSUPPDIM2";"S";"0418";"      LOCA_MODALITE = ""4"""
"SHSUPPDIM2";"S";"0419";"      LOCA_SPEC = ""DIFF"""
"SHSUPPDIM2";"S";"0420";"   FINSI"
"SHSUPPDIM2";"S";"0421";"*"
"SHSUPPDIM2";"S";"0422";"* Si service hors industrie et gestion jour par jour => recup sans majo"
"SHSUPPDIM2";"S";"0423";"   SI HJOU_SECTORI(1:3) <> ""DIN"""
"SHSUPPDIM2";"S";"0424";"      SI LOCA_GESTHS = ""4"""
"SHSUPPDIM2";"S";"0425";"         LOCA_MODALITE = ""4"""
"SHSUPPDIM2";"S";"0426";"      FINSI"
"SHSUPPDIM2";"S";"0427";"*"
"SHSUPPDIM2";"S";"0428";"* FFT025003825 >>"
"SHSUPPDIM2";"S";"0429";"      SI HJOU_SJITYPSERV = ""PFI"""
"SHSUPPDIM2";"S";"0430";"* HS uniquement récupéré"
"SHSUPPDIM2";"S";"0431";"         LOCA_MODALITE = ""1"""
"SHSUPPDIM2";"S";"0432";"         SI HJOU_IJRHRECANN >= LOCA_SEUILPFI"
"SHSUPPDIM2";"S";"0433";"* Paiement uniquement"
"SHSUPPDIM2";"S";"0434";"            LOCA_MODALITE = ""2"""
"SHSUPPDIM2";"S";"0435";"         FINSI"
"SHSUPPDIM2";"S";"0436";"      FINSI"
"SHSUPPDIM2";"S";"0437";"* FFT025003825 <<"
"SHSUPPDIM2";"S";"0438";"*"
"SHSUPPDIM2";"S";"0439";"   FINSI"
"SHSUPPDIM2";"S";"0440";"*"
"SHSUPPDIM2";"S";"0441";"FINSI"
"SHSUPPDIM2";"S";"0442";"*"
"SHSUPPDIM2";"S";"0443";"* Exclu forfait jour"
"SHSUPPDIM2";"S";"0444";"SI HJOU_SJQFORFJR <> ""1"""
"SHSUPPDIM2";"S";"0445";"* Exclu journaliste"
"SHSUPPDIM2";"S";"0446";"   SI HJOU_SJQCATEGOR <> ""J"""
"SHSUPPDIM2";"S";"0447";"* Exclu metier de publicité"
"SHSUPPDIM2";"S";"0448";"      SI HJOU_SJQSOCIETE <> ""PU"""
"SHSUPPDIM2";"S";"0449";"         SI LOCA_GESTHS = ""2"""
"SHSUPPDIM2";"S";"0450";"         OU LOCA_GESTHS = ""3"""
"SHSUPPDIM2";"S";"0451";"         OU LOCA_GESTHS = ""4"""
"SHSUPPDIM2";"S";"0452";"            LOCA_DROIT = 1"
"SHSUPPDIM2";"S";"0453";"         FINSI"
"SHSUPPDIM2";"S";"0454";"      FINSI"
"SHSUPPDIM2";"S";"0455";"   FINSI"
"SHSUPPDIM2";"S";"0456";"FINSI"
"SHSUPPDIM2";"S";"0457";"*"
"SHSUPPDIM2";"S";"0458";"* Cas particulier pour le service DPU347 de la pub : autorise saisie des HSPAIE sur JF"
"SHSUPPDIM2";"S";"0459";"SI LOCA_DROIT <> 1"
"SHSUPPDIM2";"S";"0460";"   SI HJOU_SJQSOCIETE = ""PU"""
"SHSUPPDIM2";"S";"0461";"      SI HJOU_SECTORI = ""DPU347"""
"SHSUPPDIM2";"S";"0462";"         SI TEMP_STQJF = ""JJF"""
"SHSUPPDIM2";"S";"0463";"* Autorise paiement sur Heures fériées"
"SHSUPPDIM2";"S";"0464";"            LOCA_DROIT = 2"
"SHSUPPDIM2";"S";"0465";"         FINSI"
"SHSUPPDIM2";"S";"0466";"      FINSI"
"SHSUPPDIM2";"S";"0467";"   FINSI"
"SHSUPPDIM2";"S";"0468";"FINSI"
"SHSUPPDIM2";"S";"0469";"*"
"SHSUPPDIM2";"S";"0470";"* Exclure porteur de TEVA"
"SHSUPPDIM2";"S";"0471";"SI HJOU_SJIINTEVA = ""1"""
"SHSUPPDIM2";"S";"0472";"   LOCA_DROIT = 0"
"SHSUPPDIM2";"S";"0473";"FINSI"
"SHSUPPDIM2";"S";"0474";"*"
"SHSUPPDIM2";"S";"0475";"* Si sortie"
"SHSUPPDIM2";"S";"0476";"SI HJOU_SJQFINC = 1"
"SHSUPPDIM2";"S";"0477";"   LOCA_SORTIE = 1"
"SHSUPPDIM2";"S";"0478";"FINSI"
"SHSUPPDIM2";"S";"0479";"*"
"SHSUPPDIM2";"S";"0480";"POUR ACTIVITES"
"SHSUPPDIM2";"S";"0481";"*"
"SHSUPPDIM2";"S";"0482";"* JJA - 03/10/2025 - FFT025006452 : Identification des HS faites de nuit >>"
"SHSUPPDIM2";"S";"0483";"   SI MOTI_MOTYPE = ""C"""
"SHSUPPDIM2";"S";"0484";"      SI HABS_VALORIS = ""H"""
"SHSUPPDIM2";"S";"0485";"         SI HABS_MOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM2";"S";"0486";"         OU HABS_MOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM2";"S";"0487";"            LOCA_MOTE = HABS_HRADEB"
"SHSUPPDIM2";"S";"0488";"            LOCA_MOTS = HABS_HRAFIN"
"SHSUPPDIM2";"S";"0489";"            FAIRE CALCHSN"
"SHSUPPDIM2";"S";"0490";"            LOCA_HSUPNUIT = LOCA_HSUPNUIT + LOCA_HSNUIT"
"SHSUPPDIM2";"S";"0491";"         FINSI"
"SHSUPPDIM2";"S";"0492";"      FINSI"
"SHSUPPDIM2";"S";"0493";"   FINSI"
"SHSUPPDIM2";"S";"0494";"* JJA - 03/10/2025 - FFT025006452 <<"
"SHSUPPDIM2";"S";"0495";"*"
"SHSUPPDIM2";"S";"0496";"   SI HABS_MOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM2";"S";"0497";"      HJOU_SJRHSPAIE = HJOU_SJRHSPAIE + HABS_MOTIDUR"
"SHSUPPDIM2";"S";"0498";"   FINSI"
"SHSUPPDIM2";"S";"0499";"   SI HABS_MOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM2";"S";"0500";"      HJOU_SJRHSRECUP = HJOU_SJRHSRECUP + HABS_MOTIDUR"
"SHSUPPDIM2";"S";"0501";"   FINSI"
"SHSUPPDIM2";"S";"0502";"   SI HABS_MOTIF = PARD_SDIVMINTA"
"SHSUPPDIM2";"S";"0503";"      LOCA_INTAST = LOCA_INTAST + HABS_MOTIDUR"
"SHSUPPDIM2";"S";"0504";"   FINSI"
"SHSUPPDIM2";"S";"0505";"   SI HABS_MOTIF = PARD_SDIVMRSCE"
"SHSUPPDIM2";"S";"0506";"   OU HABS_MOTIF = PARD_SDIVMCSE"
"SHSUPPDIM2";"S";"0507";"   OU HABS_MOTIF = PARD_SDIVMDS"
"SHSUPPDIM2";"S";"0508";"   OU HABS_MOTIF = PARD_SDIVMCCIJP"
"SHSUPPDIM2";"S";"0509";"      SI HABS_VALORIS = ""H"""
"SHSUPPDIM2";"S";"0510";"         LOCA_DELEG = LOCA_DELEG + HABS_MOTIDUR"
"SHSUPPDIM2";"S";"0511";"         FAIRE CHETTE"
"SHSUPPDIM2";"S";"0512";"         LOCA_MOTE = HABS_HRADEB"
"SHSUPPDIM2";"S";"0513";"         LOCA_MOTS = HABS_HRAFIN"
"SHSUPPDIM2";"S";"0514";"* Analyse Mouvement 1"
"SHSUPPDIM2";"S";"0515";"         LOCA_MVE = HJOU_IJQMVTENT1"
"SHSUPPDIM2";"S";"0516";"         LOCA_MVS = HJOU_IJQMVTSOR1"
"SHSUPPDIM2";"S";"0517";"         FAIRE CHETTE"
"SHSUPPDIM2";"S";"0518";"         LOCA_DELEG = LOCA_DELEG - LOCA_DURC"
"SHSUPPDIM2";"S";"0519";"* Analyse Mouvement 2"
"SHSUPPDIM2";"S";"0520";"         LOCA_MVE = HJOU_IJQMVTENT2"
"SHSUPPDIM2";"S";"0521";"         LOCA_MVS = HJOU_IJQMVTSOR2"
"SHSUPPDIM2";"S";"0522";"         FAIRE CHETTE"
"SHSUPPDIM2";"S";"0523";"         LOCA_DELEG = LOCA_DELEG - LOCA_DURC"
"SHSUPPDIM2";"S";"0524";"* Analyse Mouvement 3"
"SHSUPPDIM2";"S";"0525";"         LOCA_MVE = HJOU_IJQMVTENT3"
"SHSUPPDIM2";"S";"0526";"         LOCA_MVS = HJOU_IJQMVTSOR3"
"SHSUPPDIM2";"S";"0527";"         FAIRE CHETTE"
"SHSUPPDIM2";"S";"0528";"         LOCA_DELEG = LOCA_DELEG - LOCA_DURC"
"SHSUPPDIM2";"S";"0529";"* Analyse Mouvement 4"
"SHSUPPDIM2";"S";"0530";"         LOCA_MVE = HJOU_IJQMVTENT4"
"SHSUPPDIM2";"S";"0531";"         LOCA_MVS = HJOU_IJQMVTSOR4"
"SHSUPPDIM2";"S";"0532";"         FAIRE CHETTE"
"SHSUPPDIM2";"S";"0533";"         LOCA_DELEG = LOCA_DELEG - LOCA_DURC"
"SHSUPPDIM2";"S";"0534";"* Analyse Mouvement 5"
"SHSUPPDIM2";"S";"0535";"         LOCA_MVE = HJOU_IJQMVTENT5"
"SHSUPPDIM2";"S";"0536";"         LOCA_MVS = HJOU_IJQMVTSOR5"
"SHSUPPDIM2";"S";"0537";"         FAIRE CHETTE"
"SHSUPPDIM2";"S";"0538";"         LOCA_DELEG = LOCA_DELEG - LOCA_DURC"
"SHSUPPDIM2";"S";"0539";"      FINSI"
"SHSUPPDIM2";"S";"0540";"   FINSI"
"SHSUPPDIM2";"S";"0541";"FINPOUR"
"SHSUPPDIM2";"S";"0542";"*"
"SHSUPPDIM2";"S";"0543";"* Supprime chevauchement HS"
"SHSUPPDIM2";"S";"0544";"HJOU_SJRHSPAIE = HJOU_SJRHSPAIE - TEMP_STCHEHS"
"SHSUPPDIM2";"S";"0545";"HJOU_SJRHSRECUP = HJOU_SJRHSRECUP - TEMP_STCHEHS"
"SHSUPPDIM2";"S";"0546";"LOCA_INTAST = LOCA_INTAST - TEMP_STCHEVTTE"
"SHSUPPDIM2";"S";"0547";"*"
"SHSUPPDIM2";"S";"0548";"SI HJOU_SJRHSPAIE < 0"
"SHSUPPDIM2";"S";"0549";"   HJOU_SJRHSPAIE = 0"
"SHSUPPDIM2";"S";"0550";"FINSI"
"SHSUPPDIM2";"S";"0551";"SI HJOU_SJRHSRECUP < 0"
"SHSUPPDIM2";"S";"0552";"   HJOU_SJRHSRECUP = 0"
"SHSUPPDIM2";"S";"0553";"FINSI"
"SHSUPPDIM2";"S";"0554";"SI LOCA_INTAST < 0"
"SHSUPPDIM2";"S";"0555";"   LOCA_INTAST = 0"
"SHSUPPDIM2";"S";"0556";"FINSI"
"SHSUPPDIM2";"S";"0557";"SI LOCA_DELEG < 0"
"SHSUPPDIM2";"S";"0558";"   LOCA_DELEG = 0"
"SHSUPPDIM2";"S";"0559";"FINSI"
"SHSUPPDIM2";"S";"0560";"*"
"SHSUPPDIM2";"S";"0561";"***** Gestion des cas particuliers par métiers >> **************************************************"
"SHSUPPDIM2";"S";"0562";"*"
"SHSUPPDIM2";"S";"0563";"SI LOCA_DROIT = 1"
"SHSUPPDIM2";"S";"0564";"* Si TP ?"
"SHSUPPDIM2";"S";"0565";"   SI HJOU_IJITYPCTRA < 100"
"SHSUPPDIM2";"S";"0566";"      SI HJOU_IJITYPCTRA > 0"
"SHSUPPDIM2";"S";"0567";"* Support ?"
"SHSUPPDIM2";"S";"0568";"         SI HJOU_SJITYPSERV = ""SUPPORT"""
"SHSUPPDIM2";"S";"0569";"         OU HJOU_SJQSOCIETE = ""PO"""
"SHSUPPDIM2";"S";"0570";"* Calcul des HC = Oui"
"SHSUPPDIM2";"S";"0571";"            LOCA_CALCHC = 1"
"SHSUPPDIM2";"S";"0572";"         FINSI"
"SHSUPPDIM2";"S";"0573";"      FINSI"
"SHSUPPDIM2";"S";"0574";"   FINSI"
"SHSUPPDIM2";"S";"0575";"* Evenementiel ?"
"SHSUPPDIM2";"S";"0576";"*   SI HJOU_SJQSOCIETE = ""EV"""
"SHSUPPDIM2";"S";"0577";"*   OU HJOU_SJQSOCIETE = ""PE"""
"SHSUPPDIM2";"S";"0578";"* Portage ?"
"SHSUPPDIM2";"S";"0579";"   SI HJOU_SJQSOCIETE = ""PO"""
"SHSUPPDIM2";"S";"0580";"* Calcul des HN = Oui"
"SHSUPPDIM2";"S";"0581";"      LOCA_CALCHN = 1"
"SHSUPPDIM2";"S";"0582";"   FINSI"
"SHSUPPDIM2";"S";"0583";"*"
"SHSUPPDIM2";"S";"0584";"FINSI"
"SHSUPPDIM2";"S";"0585";"*"
"SHSUPPDIM2";"S";"0586";"POUR ACTIVITES"
"SHSUPPDIM2";"S";"0587";"* Saisie d'une HS de paiement >>"
"SHSUPPDIM2";"S";"0588";"   SI HABS_MOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM2";"S";"0589";"      LOCA_DURHS = LOCA_DURHS + HABS_MOTIDUR"
"SHSUPPDIM2";"S";"0590";"      SI HJOU_SJRHSPRC = "" """
"SHSUPPDIM2";"S";"0591";"* P = Paiement des HS"
"SHSUPPDIM2";"S";"0592";"         HJOU_SJRHSPRC = ""P"""
"SHSUPPDIM2";"S";"0593";"      FINSI"
"SHSUPPDIM2";"S";"0594";"* Anomalie demande de récup déjà faite"
"SHSUPPDIM2";"S";"0595";"      SI HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM2";"S";"0596";"         ANOMALIE 228"
"SHSUPPDIM2";"S";"0597";"         SI TEMP_CNMOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM2";"S";"0598";"            TEMP_CNRETOUR = 2"
"SHSUPPDIM2";"S";"0599";"            TEMP_CNMESS = 228"
"SHSUPPDIM2";"S";"0600";"         FINSI"
"SHSUPPDIM2";"S";"0601";"      FINSI"
"SHSUPPDIM2";"S";"0602";"* Anomalie si pas droit au paiement"
"SHSUPPDIM2";"S";"0603";"      SI LOCA_MODALITE = ""1"""
"SHSUPPDIM2";"S";"0604";"      OU LOCA_MODALITE = ""4"""
"SHSUPPDIM2";"S";"0605";"         ANOMALIE 201"
"SHSUPPDIM2";"S";"0606";"         SI TEMP_CNMOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM2";"S";"0607";"            TEMP_CNRETOUR = 2"
"SHSUPPDIM2";"S";"0608";"            TEMP_CNMESS = 201"
"SHSUPPDIM2";"S";"0609";"         FINSI"
"SHSUPPDIM2";"S";"0610";"      FINSI"
"SHSUPPDIM2";"S";"0611";"* Anomalie Pas droit aux HS"
"SHSUPPDIM2";"S";"0612";"      SI LOCA_DROIT <> 1"
"SHSUPPDIM2";"S";"0613";"* Excpetion autorise saisie HS payées sans calcul"
"SHSUPPDIM2";"S";"0614";"         SI LOCA_DROIT <> 2"
"SHSUPPDIM2";"S";"0615";"            ANOMALIE 203"
"SHSUPPDIM2";"S";"0616";"            SI TEMP_CNMOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM2";"S";"0617";"               TEMP_CNRETOUR = 2"
"SHSUPPDIM2";"S";"0618";"               TEMP_CNMESS = 203"
"SHSUPPDIM2";"S";"0619";"            FINSI"
"SHSUPPDIM2";"S";"0620";"         FINSI"
"SHSUPPDIM2";"S";"0621";"      FINSI"
"SHSUPPDIM2";"S";"0622";"   FINSI"
"SHSUPPDIM2";"S";"0623";"*"
"SHSUPPDIM2";"S";"0624";"* Saisie d'une HS de récupération >>"
"SHSUPPDIM2";"S";"0625";"   SI HABS_MOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM2";"S";"0626";"      LOCA_DURHS = LOCA_DURHS + HABS_MOTIDUR"
"SHSUPPDIM2";"S";"0627";"      SI HJOU_SJRHSPRC = "" """
"SHSUPPDIM2";"S";"0628";"* R = Récupération des HS"
"SHSUPPDIM2";"S";"0629";"         HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM2";"S";"0630";"      FINSI"
"SHSUPPDIM2";"S";"0631";"* Anomalie demande de paiement déjà faite"
"SHSUPPDIM2";"S";"0632";"      SI HJOU_SJRHSPRC = ""P"""
"SHSUPPDIM2";"S";"0633";"         ANOMALIE 227"
"SHSUPPDIM2";"S";"0634";"         SI TEMP_CNMOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM2";"S";"0635";"            TEMP_CNRETOUR = 2"
"SHSUPPDIM2";"S";"0636";"            TEMP_CNMESS = 227"
"SHSUPPDIM2";"S";"0637";"         FINSI"
"SHSUPPDIM2";"S";"0638";"      FINSI"
"SHSUPPDIM2";"S";"0639";"* Anomalie si pas droit à la récup"
"SHSUPPDIM2";"S";"0640";"      SI LOCA_MODALITE = ""2"""
"SHSUPPDIM2";"S";"0641";"         ANOMALIE 202"
"SHSUPPDIM2";"S";"0642";"         SI TEMP_CNMOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM2";"S";"0643";"            TEMP_CNRETOUR = 2"
"SHSUPPDIM2";"S";"0644";"            TEMP_CNMESS = 202"
"SHSUPPDIM2";"S";"0645";"         FINSI"
"SHSUPPDIM2";"S";"0646";"      FINSI"
"SHSUPPDIM2";"S";"0647";"* Anomalie Pas droit aux HS"
"SHSUPPDIM2";"S";"0648";"      SI LOCA_DROIT <> 1"
"SHSUPPDIM2";"S";"0649";"         ANOMALIE 203"
"SHSUPPDIM2";"S";"0650";"         SI TEMP_CNMOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM2";"S";"0651";"            TEMP_CNRETOUR = 2"
"SHSUPPDIM2";"S";"0652";"            TEMP_CNMESS = 203"
"SHSUPPDIM2";"S";"0653";"         FINSI"
"SHSUPPDIM2";"S";"0654";"      FINSI"
"SHSUPPDIM2";"S";"0655";"* Cas particulier - Anomamie si saisie en semaine pour la société LI - Edition"
"SHSUPPDIM2";"S";"0656";"      SI LOCA_SPEC = ""EDIT"""
"SHSUPPDIM2";"S";"0657";"         SI HJOU_JOUR < ""6"""
"SHSUPPDIM2";"S";"0658";"            LOCA_DROIT = 0"
"SHSUPPDIM2";"S";"0659";"            ANOMALIE 204"
"SHSUPPDIM2";"S";"0660";"            SI TEMP_CNMOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM2";"S";"0661";"               TEMP_CNRETOUR = 2"
"SHSUPPDIM2";"S";"0662";"               TEMP_CNMESS = 204"
"SHSUPPDIM2";"S";"0663";"            FINSI"
"SHSUPPDIM2";"S";"0664";"         FINSI"
"SHSUPPDIM2";"S";"0665";"      FINSI"
"SHSUPPDIM2";"S";"0666";"   FINSI"
"SHSUPPDIM2";"S";"0667";"FINPOUR"
"SHSUPPDIM2";"S";"0668";"*"
"SHSUPPDIM2";"S";"0669";"* Force la récup >>"
"SHSUPPDIM2";"S";"0670";"SI LOCA_MODALITE = ""1"""
"SHSUPPDIM2";"S";"0671";"OU LOCA_MODALITE = ""4"""
"SHSUPPDIM2";"S";"0672";"   HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM2";"S";"0673";"FINSI"
"SHSUPPDIM2";"S";"0674";"* Choix non fait à cause d'une délégation par exemple >>"
"SHSUPPDIM2";"S";"0675";"SI LOCA_MODALITE = ""3"""
"SHSUPPDIM2";"S";"0676";"*   SI HJOU_SJRHSPRC = "" """
"SHSUPPDIM2";"S";"0677";"*      HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM2";"S";"0678";"*   FINSI"
"SHSUPPDIM2";"S";"0679";"FINSI"
"SHSUPPDIM2";"S";"0680";"* Force le paiement >>"
"SHSUPPDIM2";"S";"0681";"SI LOCA_MODALITE = ""2"""
"SHSUPPDIM2";"S";"0682";"   HJOU_SJRHSPRC = ""P"""
"SHSUPPDIM2";"S";"0683";"FINSI"
"SHSUPPDIM2";"S";"0684";"*"
"SHSUPPDIM2";"S";"0685";"SI HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM2";"S";"0686";"   LOCA_RECUP = 1"
"SHSUPPDIM2";"S";"0687";"FINSI"
"SHSUPPDIM2";"S";"0688";"*"
"SHSUPPDIM2";"S";"0689";"POUR ACTIVITES"
"SHSUPPDIM2";"S";"0690";"   SI HABS_MOTIF = ""JF"""
"SHSUPPDIM2";"S";"0691";"      LOCA_FERI = 1"
"SHSUPPDIM2";"S";"0692";"   FINSI"
"SHSUPPDIM2";"S";"0693";"FINPOUR"
"SHSUPPDIM2";"S";"0694";"*"
"SHSUPPDIM2";"S";"0695";"SI LOCA_GESTHS = ""2"""
"SHSUPPDIM2";"S";"0696";"OU LOCA_GESTHS = ""3"""
"SHSUPPDIM2";"S";"0697";"   SI HJOU_SJRHSPRC = ""P"""
"SHSUPPDIM2";"S";"0698";"      HJOU_SJRHSPAIE = HJOU_SJRHSPAIE + LOCA_DELEG"
"SHSUPPDIM2";"S";"0699";"   FINSI"
"SHSUPPDIM2";"S";"0700";"   SI HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM2";"S";"0701";"   OU HJOU_SJRHSPRC = "" """
"SHSUPPDIM2";"S";"0702";"      HJOU_SJRHSRECUP = HJOU_SJRHSRECUP + LOCA_DELEG"
"SHSUPPDIM2";"S";"0703";"   FINSI"
"SHSUPPDIM2";"S";"0704";"FINSI"
"SHSUPPDIM2";"S";"0705";"*"
"SHSUPPDIM2";"S";"0706";"***** Raz de la base HS le lundi >> ****************************************************************"
"SHSUPPDIM2";"S";"0707";"*"
"SHSUPPDIM2";"S";"0708";"SI HJOU_JOUR = ""1"""
"SHSUPPDIM2";"S";"0709";"   SI LOCA_GESTHS = ""2"""
"SHSUPPDIM2";"S";"0710";"      HJOU_IJRBHSMPAH = 0"
"SHSUPPDIM2";"S";"0711";"      HJOU_IJRBHPAYEE = 0"
"SHSUPPDIM2";"S";"0712";"   FINSI"
"SHSUPPDIM2";"S";"0713";"* Raz le premier lundi du cycle si LOCA_GESTHS = 3"
"SHSUPPDIM2";"S";"0714";"   SI LOCA_GESTHS = ""3"""
"SHSUPPDIM2";"S";"0715";"      SI HJOU_RANG = 1"
"SHSUPPDIM2";"S";"0716";"         HJOU_IJRBHSMPAH = 0"
"SHSUPPDIM2";"S";"0717";"         HJOU_IJRTHEOCYC = 0"
"SHSUPPDIM2";"S";"0718";"         HJOU_IJRBHPAYEE = 0"
"SHSUPPDIM2";"S";"0719";"      FINSI"
"SHSUPPDIM2";"S";"0720";"   FINSI"
"SHSUPPDIM2";"S";"0721";"FINSI"
"SHSUPPDIM2";"S";"0722";"* SI HJOU_JOUR = ""7"""
"SHSUPPDIM2";"S";"0723";"SI LOCA_GESTHS = ""3"""
"SHSUPPDIM2";"S";"0724";"* Cumul de la duree theorique du cycle"
"SHSUPPDIM2";"S";"0725";"   HJOU_IJRTHEOCYC = HJOU_IJRTHEOCYC + HJOU_IJQPRETHEJ"
"SHSUPPDIM2";"S";"0726";"FINSI"
"SHSUPPDIM2";"S";"0727";"* FINSI"
"SHSUPPDIM2";"S";"0728";"*"
"SHSUPPDIM2";"S";"0729";"*SI HJOU_IJIGHSUPPM <> ""0"""
"SHSUPPDIM2";"S";"0730";"SI LOCA_DROIT = 1"
"SHSUPPDIM2";"S";"0731";"*"
"SHSUPPDIM2";"S";"0732";"* Calcul de la base des HS"
"SHSUPPDIM2";"S";"0733";"   LOCA_BASEHS = HJOU_IJQTTEFFEJ"
"SHSUPPDIM2";"S";"0734";"   LOCA_BASEPAIE = HJOU_IJQHPAYEES"
"SHSUPPDIM2";"S";"0735";"*"
"SHSUPPDIM2";"S";"0736";"* Pour EV et PE on neutralise le jour fériés"
"SHSUPPDIM2";"S";"0737";"   SI HJOU_SJQSOCIETE = ""EV"""
"SHSUPPDIM2";"S";"0738";"   OU HJOU_SJQSOCIETE = ""PE"""
"SHSUPPDIM2";"S";"0739";"      SI HJOU_DATE > TEMP_DATJOU"
"SHSUPPDIM2";"S";"0740";"         LOCA_BASEHS = HJOU_IJQPLGTOTJ"
"SHSUPPDIM2";"S";"0741";"         LOCA_BASEPAIE = HJOU_IJQPLGTOTJ"
"SHSUPPDIM2";"S";"0742";"      SINON"
"SHSUPPDIM2";"S";"0743";"         SI LOCA_FERI = 1"
"SHSUPPDIM2";"S";"0744";"            LOCA_BASEHS = HJOU_IJQPRETHEJ - HJOU_IJQTTEFFEJ"
"SHSUPPDIM2";"S";"0745";"            SI LOCA_BASEHS < 0"
"SHSUPPDIM2";"S";"0746";"               LOCA_BASEHS = LOCA_BASEHS * -1"
"SHSUPPDIM2";"S";"0747";"            FINSI"
"SHSUPPDIM2";"S";"0748";"         FINSI"
"SHSUPPDIM2";"S";"0749";"      FINSI"
"SHSUPPDIM2";"S";"0750";"   FINSI"
"SHSUPPDIM2";"S";"0751";"*"
"SHSUPPDIM2";"S";"0752";"* Alimentation des bases hebdo"
"SHSUPPDIM2";"S";"0753";"   HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + LOCA_BASEHS"
"SHSUPPDIM2";"S";"0754";"   HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE + LOCA_BASEPAIE"
"SHSUPPDIM2";"S";"0755";"*"
"SHSUPPDIM2";"S";"0756";"* On exclut les interventions sur astreintes >>"
"SHSUPPDIM2";"S";"0757";"   HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH - LOCA_INTAST"
"SHSUPPDIM2";"S";"0758";"   HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE - LOCA_INTAST"
"SHSUPPDIM2";"S";"0759";"   SI HJOU_IJRBHSMPAH < 0"
"SHSUPPDIM2";"S";"0760";"      HJOU_IJRBHSMPAH = 0"
"SHSUPPDIM2";"S";"0761";"   FINSI"
"SHSUPPDIM2";"S";"0762";"   SI HJOU_IJRBHPAYEE < 0"
"SHSUPPDIM2";"S";"0763";"      HJOU_IJRBHPAYEE = 0"
"SHSUPPDIM2";"S";"0764";"   FINSI"
"SHSUPPDIM2";"S";"0765";"*"
"SHSUPPDIM2";"S";"0766";"* Les HS sur le dimanche pour la diffusion sont payées"
"SHSUPPDIM2";"S";"0767";"   SI LOCA_SPEC = ""DIFF"""
"SHSUPPDIM2";"S";"0768";"      SI HJOU_JOUR = ""7"""
"SHSUPPDIM2";"S";"0769";"         HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH - LOCA_DURHS"
"SHSUPPDIM2";"S";"0770";"         HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE - LOCA_DURHS"
"SHSUPPDIM2";"S";"0771";"      FINSI"
"SHSUPPDIM2";"S";"0772";"   FINSI"
"SHSUPPDIM2";"S";"0773";"*"
"SHSUPPDIM2";"S";"0774";"FINSI"
"SHSUPPDIM2";"S";"0775";"*"
"SHSUPPDIM2";"S";"0776";"* Raz du cumul des HS en debut de periode d'annualisation"
"SHSUPPDIM2";"S";"0777";"SI HJOU_DATE(5:4) = ""0101"""
"SHSUPPDIM2";"S";"0778";"   HJOU_IJRHSHMAJA = 0"
"SHSUPPDIM2";"S";"0779";"   HJOU_IJRHSMPAYA = 0"
"SHSUPPDIM2";"S";"0780";"   HJOU_IJRHRECANN = 0"
"SHSUPPDIM2";"S";"0781";"FINSI"
"SHSUPPDIM2";"S";"0782";"*"
"SHSUPPDIM2";"S";"0783";"*** initialisation de la base HS par consigne"
"SHSUPPDIM2";"S";"0784";"POUR ACTIVITES"
"SHSUPPDIM2";"S";"0785";"   SI HABS_MOTIF = ""ZBHS"""
