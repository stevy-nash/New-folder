"ICONSCONG";"S";"0576";"           HJOU_IJRCCPNTRA = HJOU_IJRCCPNTRA + HABS_MOTINBR"
"ICONSCONG";"S";"0577";"           HJOU_IJRSCPNTRA = HJOU_IJRDCPNTRA - HJOU_IJRCCPNTRA"
"ICONSCONG";"S";"0578";"* Recalcul des compteurs congé payé"
"ICONSCONG";"S";"0579";"           HJOU_IJRCCOPRIN = HJOU_IJRCCPTRA + HJOU_IJRCCPNTRA"
