"ITPSACTPTB";"S";"0031";"*"
"ITPSACTPTB";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTPTB";"S";"0033";"*"
"ITPSACTPTB";"S";"0034";"DEBDICO"
"ITPSACTPTB";"S";"0035";"SECH_ISIACTI;O;A1;X;;;123456789;L;;C3;""Section géré en activité"";"
"ITPSACTPTB";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTPTB";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTPTB";"S";"0038";"FINDICO"
"ITPSACTPTB";"S";"0039";"*"
"ITPSACTPTB";"S";"0040";"*"
"ITPSACTPTB";"S";"0041";"* DEBANO"
"ITPSACTPTB";"S";"0042";"*"
"ITPSACTPTB";"S";"0043";"* FINANO"
"ITPSACTPTB";"S";"0044";"*"
"ITPSACTPTB";"S";"0045";"* Définition des variables locales"
"ITPSACTPTB";"S";"0046";"*"
"ITPSACTPTB";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTPTB";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTPTB";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTPTB";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTPTB";"S";"0051";"    FINSI"
"ITPSACTPTB";"S";"0052";"FINSI"
"ITPSACTPTB";"S";"0053";"* Employé géré en activité"
"ITPSACTPTB";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTPTB";"S";"0055";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTPTB";"S";"0056";"        * Calcul de la présence activité le dernier jour du mois"
"ITPSACTPTB";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTPTB";"S";"0058";"        SI TEMP_DATSUI(7:2) = ""01"""
"ITPSACTPTB";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTPTB";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTPTB";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTPTB";"S";"0062";"                * d'activité à justifier"
"ITPSACTPTB";"S";"0063";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTPTB";"S";"0064";"                SI HJOU_SECTAFF <> "" """
"ITPSACTPTB";"S";"0065";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTPTB";"S";"0066";"                SINON"
"ITPSACTPTB";"S";"0067";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTPTB";"S";"0068";"                FINSI"
"ITPSACTPTB";"S";"0069";"                *"
"ITPSACTPTB";"S";"0070";"                SI PRES_MODE_TRV = "" """
"ITPSACTPTB";"S";"0071";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPTB";"S";"0072";"                FINSI"
"ITPSACTPTB";"S";"0073";"                *"
