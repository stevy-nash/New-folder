"SGCSEGLISS";"S";"0615";"   SINON"
"SGCSEGLISS";"S";"0616";"* -------------------------------------------------------"
"SGCSEGLISS";"S";"0617";"* RAZ des droits au lendemain de la date de fin de mandat"
"SGCSEGLISS";"S";"0618";"* -------------------------------------------------------"
"SGCSEGLISS";"S";"0619";"      LIREVALPRE LOCA_DATEFIN HJOU_DATE"
"SGCSEGLISS";"S";"0620";"*************************************************"
"SGCSEGLISS";"S";"0621";"*************************************************"
"SGCSEGLISS";"S";"0622";"* En cas d'ancienne version où le LIREVALPRE ne"
"SGCSEGLISS";"S";"0623";"* fonctionne pas (Nouveautés 5.2.0)"
"SGCSEGLISS";"S";"0624";"* Utiliser le réglementaire suivant :"
"SGCSEGLISS";"S";"0625";"*"
"SGCSEGLISS";"S";"0626";"* DATAJT HJOU_DATE 12 ""J"" -1"
"SGCSEGLISS";"S";"0627";"* LOCA_DATEFIN = TEMP_DXFINPER"
"SGCSEGLISS";"S";"0628";"*************************************************"
"SGCSEGLISS";"S";"0629";"*************************************************"
"SGCSEGLISS";"S";"0630";"      SI LOCA_DATEFIN = HJOU_IJIDFIN"
"SGCSEGLISS";"S";"0631";"         FAIRE RAZCSE"
"SGCSEGLISS";"S";"0632";"      FINSI"
"SGCSEGLISS";"S";"0633";"*"
"SGCSEGLISS";"S";"0634";"* ------------------"
"SGCSEGLISS";"S";"0635";"* Analyse des motifs"
"SGCSEGLISS";"S";"0636";"* ------------------"
"SGCSEGLISS";"S";"0637";"      POUR ACTIVITES"
"SGCSEGLISS";"S";"0638";"         SI HABS_MOTIF = PARD_SDIVMCSE"
"SGCSEGLISS";"S";"0639";"         OU HABS_MOTIF(1:4) = ""YCSE"""
"SGCSEGLISS";"S";"0640";"            LOCA_CONSO = 1"
"SGCSEGLISS";"S";"0641";"            ANOMALIE 215"
"SGCSEGLISS";"S";"0642";"            SI TEMP_CNMOTIF = PARD_SDIVMCSE"
"SGCSEGLISS";"S";"0643";"            OU TEMP_CNMOTIF(1:4) = ""YCSE"""
"SGCSEGLISS";"S";"0644";"               TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0645";"               TEMP_CNMESS = 215"
"SGCSEGLISS";"S";"0646";"            FINSI"
"SGCSEGLISS";"S";"0647";"         FINSI"
"SGCSEGLISS";"S";"0648";"         SI HABS_MOTIF = ""REUCSE"""
"SGCSEGLISS";"S";"0649";"            ANOMALIE 289"
"SGCSEGLISS";"S";"0650";"            SI TEMP_CNMOTIF = ""REUCSE"""
"SGCSEGLISS";"S";"0651";"               TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0652";"               TEMP_CNMESS = 289"
"SGCSEGLISS";"S";"0653";"            FINSI"
"SGCSEGLISS";"S";"0654";"         FINSI"
"SGCSEGLISS";"S";"0655";"      FINPOUR"
"SGCSEGLISS";"S";"0656";"*"
"SGCSEGLISS";"S";"0657";"   FINSI"
"SGCSEGLISS";"S";"0658";"* Date vide >>"
"SGCSEGLISS";"S";"0659";"SINON"
"SGCSEGLISS";"S";"0660";"*"
"SGCSEGLISS";"S";"0661";"   FAIRE RAZCSE"
"SGCSEGLISS";"S";"0662";"*"
"SGCSEGLISS";"S";"0663";"* ------------------"
"SGCSEGLISS";"S";"0664";"* Analyse des motifs"
"SGCSEGLISS";"S";"0665";"* ------------------"
"SGCSEGLISS";"S";"0666";"   POUR ACTIVITES"
"SGCSEGLISS";"S";"0667";"      SI HABS_MOTIF = PARD_SDIVMCSE"
"SGCSEGLISS";"S";"0668";"      OU HABS_MOTIF(1:4) = ""YCSE"""
"SGCSEGLISS";"S";"0669";"         LOCA_CONSO = 1"
"SGCSEGLISS";"S";"0670";"         ANOMALIE 215"
"SGCSEGLISS";"S";"0671";"         SI TEMP_CNMOTIF = PARD_SDIVMCSE"
"SGCSEGLISS";"S";"0672";"         OU TEMP_CNMOTIF(1:4) = ""YCSE"""
"SGCSEGLISS";"S";"0673";"            TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0674";"            TEMP_CNMESS = 215"
"SGCSEGLISS";"S";"0675";"         FINSI"
"SGCSEGLISS";"S";"0676";"      FINSI"
"SGCSEGLISS";"S";"0677";"      SI HABS_MOTIF = ""REUCSE"""
"SGCSEGLISS";"S";"0678";"         ANOMALIE 289"
"SGCSEGLISS";"S";"0679";"         SI TEMP_CNMOTIF = ""REUCSE"""
"SGCSEGLISS";"S";"0680";"            TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0681";"            TEMP_CNMESS = 289"
"SGCSEGLISS";"S";"0682";"         FINSI"
"SGCSEGLISS";"S";"0683";"      FINSI"
"SGCSEGLISS";"S";"0684";"   FINPOUR"
"SGCSEGLISS";"S";"0685";"*"
"SGCSEGLISS";"S";"0686";"FINSI"
"SGCSEGLISS";"S";"0687";"*"
"SGCSEGLISS";"S";"0688";"SI HJOU_DATE < CONF_SDIDATDEM"
"SGCSEGLISS";"S";"0689";"   FAIRE RAZCSE"
"SGCSEGLISS";"S";"0690";"FINSI"
"SGCSEGLISS";"S";"0691";"*"
"SGCSEGLISS";"S";"0692";"* -------------------------------------------------------"
"SGCSEGLISS";"S";"0693";"* anomalie si le droit + transfert dépasse le maximum mensuel"
"SGCSEGLISS";"S";"0694";"* -------------------------------------------------------"
"SGCSEGLISS";"S";"0695";"* Déclenchement en cas d'un trop grand nombre d'heures reçues"
"SGCSEGLISS";"S";"0696";"* via une consigne de transfert"
"SGCSEGLISS";"S";"0697";"SI LOCA_MENS2 = 1"
"SGCSEGLISS";"S";"0698";"   LOCA_DRTR = HJOU_IJRMDCSE + HJOU_IJRMTCSE"
"SGCSEGLISS";"S";"0699";"   SI LOCA_DRTR > LOCA_MAXM"
"SGCSEGLISS";"S";"0700";"      SI LOCA_SUPPLEANT <> 1"
"SGCSEGLISS";"S";"0701";"         ANOMALIE 401"
"SGCSEGLISS";"S";"0702";"      FINSI"
"SGCSEGLISS";"S";"0703";"   FINSI"
"SGCSEGLISS";"S";"0704";"FINSI"
"SGCSEGLISS";"S";"0705";"* ----------------------"
"SGCSEGLISS";"S";"0706";"* Calcul du prévisionnel"
"SGCSEGLISS";"S";"0707";"* ----------------------"
"SGCSEGLISS";"S";"0708";"SI TEMP_DATSUI = LOCA_DATE"
"SGCSEGLISS";"S";"0709";"*"
"SGCSEGLISS";"S";"0710";"   EMPL_IEQSDELCSE = HJOU_IJRASCSE"
"SGCSEGLISS";"S";"0711";"*"
"SGCSEGLISS";"S";"0712";"FINSI"
"SGCSEGLISS";"S";"0713";"* ----------"
"SGCSEGLISS";"S";"0714";"* Simulation"
"SGCSEGLISS";"S";"0715";"* ----------"
"SGCSEGLISS";"S";"0716";"DEF CPTG_SOLDECSE T6.2"
"SGCSEGLISS";"S";"0717";"PERGLISS CPTG_SOLDECSE ""060J01"""
"SGCSEGLISS";"S";"0718";"POUR ACTIVITES"
"SGCSEGLISS";"S";"0719";"   SI MOTI_IMIMATRICS <> "" """
"SGCSEGLISS";"S";"0720";"      LOCA_MAT = MOTI_IMIMATRICS"
"SGCSEGLISS";"S";"0721";"      LOCA_MAJD = HABS_MOTIDUR"
"SGCSEGLISS";"S";"0722";"      LOCA_VALO = HABS_VALORIS"
"SGCSEGLISS";"S";"0723";"   FINSI"
"SGCSEGLISS";"S";"0724";"FINPOUR"
"SGCSEGLISS";"S";"0725";"* --------------------------------------------------"
"SGCSEGLISS";"S";"0726";"* Blocage si l'on se transmets des droits a soi-même"
"SGCSEGLISS";"S";"0727";"* --------------------------------------------------"
"SGCSEGLISS";"S";"0728";"SI LOCA_MAT = HJOU_MATRI"
"SGCSEGLISS";"S";"0729";"   TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0730";"   TEMP_CNMESS = 220"
"SGCSEGLISS";"S";"0731";"FINSI"
"SGCSEGLISS";"S";"0732";"* ---------------------------------------"
"SGCSEGLISS";"S";"0733";"* Contrôles spécifiques aux forfaits jour"
"SGCSEGLISS";"S";"0734";"* ---------------------------------------"
"SGCSEGLISS";"S";"0735";"SI HJOU_SJQFORFJR = ""1"""
"SGCSEGLISS";"S";"0736";"*"
"SGCSEGLISS";"S";"0737";"* Ils ne peuvent transférer que l'équivalent de jours / demi-journées (multiples de 4)"
"SGCSEGLISS";"S";"0738";"   SI LOCA_MAJD > 0"
"SGCSEGLISS";"S";"0739";"      LOCA_DROIT = LOCA_MAJD / LOCA_DIV"
"SGCSEGLISS";"S";"0740";"      LOCA_RESTE = LOCA_DROIT % 4"
"SGCSEGLISS";"S";"0741";"* JJA - 03/10/2025 - FFT025006539 : Mise en commentaire du blocage >"
"SGCSEGLISS";"S";"0742";"*      SI LOCA_RESTE > 0"
"SGCSEGLISS";"S";"0743";"*         TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0744";"*         TEMP_CNMESS = 219"
"SGCSEGLISS";"S";"0745";"*      FINSI"
"SGCSEGLISS";"S";"0746";"   FINSI"
"SGCSEGLISS";"S";"0747";"* ----------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0748";"* Les forfaits jours ne posent que des délégations en journées ou 1/2 journées"
"SGCSEGLISS";"S";"0749";"* ----------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0750";"   SI LOCA_VALO = ""H"""
"SGCSEGLISS";"S";"0751";"      SI LOCA_MAT = "" """
"SGCSEGLISS";"S";"0752";"         TEMP_CNRETOUR = 2"
"SGCSEGLISS";"S";"0753";"         TEMP_CNMESS = 221"
"SGCSEGLISS";"S";"0754";"      FINSI"
"SGCSEGLISS";"S";"0755";"   FINSI"
"SGCSEGLISS";"S";"0756";"FINSI"
"SGCSEGLISS";"S";"0757";"* ---------"
"SGCSEGLISS";"S";"0758";"FIN"
"SGCSEGLISS";"S";"0759";"PROC RAZCSE"
"SGCSEGLISS";"S";"0760";"   HJOU_IJRADCSE = 0"
"SGCSEGLISS";"S";"0761";"   HJOU_IJRAPCSE = 0"
"SGCSEGLISS";"S";"0762";"   HJOU_IJRATCSE = 0"
"SGCSEGLISS";"S";"0763";"   HJOU_IJRASCSE = 0"
"SGCSEGLISS";"S";"0764";"   HJOU_IJRMDCSE = 0"
"SGCSEGLISS";"S";"0765";"   HJOU_IJRMPCSE = 0"
"SGCSEGLISS";"S";"0766";"   HJOU_IJRMTCSE = 0"
"SGCSEGLISS";"S";"0767";"   HJOU_IJRMSCSE = 0"
"SGCSEGLISS";"S";"0768";"*   HJOU_IJRADCSEF = 0"
"SGCSEGLISS";"S";"0769";"*   HJOU_IJRAPCSEF = 0"
"SGCSEGLISS";"S";"0770";"*   HJOU_IJRATCSEF = 0"
"SGCSEGLISS";"S";"0771";"*   HJOU_IJRASCSEF = 0"
"SGCSEGLISS";"S";"0772";"*Compteurs glissants RAZ"
"SGCSEGLISS";"S";"0773";"   HJOU_IJRMDCSE11 = 0"
"SGCSEGLISS";"S";"0774";"   HJOU_IJRMDCSE10 = 0"
"SGCSEGLISS";"S";"0775";"   HJOU_IJRMDCSE9 = 0"
"SGCSEGLISS";"S";"0776";"   HJOU_IJRMDCSE8 = 0"
"SGCSEGLISS";"S";"0777";"   HJOU_IJRMDCSE7 = 0"
"SGCSEGLISS";"S";"0778";"   HJOU_IJRMDCSE6 = 0"
"SGCSEGLISS";"S";"0779";"   HJOU_IJRMDCSE5 = 0"
"SGCSEGLISS";"S";"0780";"   HJOU_IJRMDCSE4 = 0"
"SGCSEGLISS";"S";"0781";"   HJOU_IJRMDCSE3 = 0"
"SGCSEGLISS";"S";"0782";"   HJOU_IJRMDCSE2 = 0"
"SGCSEGLISS";"S";"0783";"   HJOU_IJRMDCSE1 = 0"
"SGCSEGLISS";"S";"0784";"*RAZ du cumul pris mensuel"
"SGCSEGLISS";"S";"0785";"   HJOU_IJRCUPMCSE = 0"
"SGCSEGLISS";"S";"0786";"FINPROC"
"SGCSEGLISS";"S";"0787";"* -------------------------------------------"
"SGCSEGLISS";"S";"0788";"* Procédure de calcul des droits forfait jour"
"SGCSEGLISS";"S";"0789";"* -------------------------------------------"
"SGCSEGLISS";"S";"0790";"PROC CALCFJ"
"SGCSEGLISS";"S";"0791";"* --------------------------------------"
"SGCSEGLISS";"S";"0792";"* Durée fixe pour les forfaits jour : 8h"
"SGCSEGLISS";"S";"0793";"* --------------------------------------"
"SGCSEGLISS";"S";"0794";"   LOCA_DROIT = LOCA_DROIT / 8"
"SGCSEGLISS";"S";"0795";"   LOCA_RESTE = LOCA_DROIT % 1"
"SGCSEGLISS";"S";"0796";"   LOCA_DROIT = LOCA_DROIT - LOCA_RESTE"
"SGCSEGLISS";"S";"0797";"   SI LOCA_RESTE > 0"
"SGCSEGLISS";"S";"0798";"      SI LOCA_RESTE < 0.5"
"SGCSEGLISS";"S";"0799";"* -------------------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0800";"* Gestion des arrondis :"
"SGCSEGLISS";"S";"0801";"* si l'on est dans le cas d'un transfert, on majore à la 1/2 journée supérieure"
"SGCSEGLISS";"S";"0802";"* si l'on est dans le cas d'une consigne de MAJ de droit, on minore à la 1/2 inférieure"
"SGCSEGLISS";"S";"0803";"* -------------------------------------------------------------------------------------"
"SGCSEGLISS";"S";"0804";"         SI LOCA_MAJD = 0"
"SGCSEGLISS";"S";"0805";"            LOCA_DROIT = LOCA_DROIT + 0.5"
"SGCSEGLISS";"S";"0806";"         FINSI"
"SGCSEGLISS";"S";"0807";"         ANOMALIE 219"
"SGCSEGLISS";"S";"0808";"      SINON"
"SGCSEGLISS";"S";"0809";"         SI LOCA_RESTE = 0.5"
"SGCSEGLISS";"S";"0810";"            LOCA_DROIT = LOCA_DROIT + 0.5"
"SGCSEGLISS";"S";"0811";"         SINON"
"SGCSEGLISS";"S";"0812";"            SI LOCA_MAJD = 0"
"SGCSEGLISS";"S";"0813";"               LOCA_DROIT = LOCA_DROIT + 1"
"SGCSEGLISS";"S";"0814";"            FINSI"
"SGCSEGLISS";"S";"0815";"            ANOMALIE 219"
"SGCSEGLISS";"S";"0816";"         FINSI"
"SGCSEGLISS";"S";"0817";"      FINSI"
"SGCSEGLISS";"S";"0818";"   FINSI"
"SGCSEGLISS";"S";"0819";"FINPROC"
