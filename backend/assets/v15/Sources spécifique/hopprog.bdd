"ICONSCPSCH";"S";"0447";"                     FINSI"
"ICONSCPSCH";"S";"0448";"                  SINON"
"ICONSCPSCH";"S";"0449";"                     LOCA_VAL = 1"
"ICONSCPSCH";"S";"0450";"                  FINSI"
"ICONSCPSCH";"S";"0451";"               SINON"
"ICONSCPSCH";"S";"0452";"*Optimum"
"ICONSCPSCH";"S";"0453";"                  SI CTRA_TYPEPLAN = ""1"""
"ICONSCPSCH";"S";"0454";"                  OU CTRA_TYPEPLAN = ""6"""
"ICONSCPSCH";"S";"0455";"                     SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPSCH";"S";"0456";"                        HJOU_IJRCPCOH = HJOU_IJRCPCOH + 0.5"
"ICONSCPSCH";"S";"0457";"*Limite hebdo de 1/5"
"ICONSCPSCH";"S";"0458";"                        SI HORC_IHIMOACQCP = ""1"""
"ICONSCPSCH";"S";"0459";"                           LOCA_DRCP = 30"
"ICONSCPSCH";"S";"0460";"                        FINSI"
"ICONSCPSCH";"S";"0461";"                        SI HORC_IHIMOACQCP = ""2"""
"ICONSCPSCH";"S";"0462";"                           LOCA_DRCP = 25"
"ICONSCPSCH";"S";"0463";"                        FINSI"
"ICONSCPSCH";"S";"0464";"*"
"ICONSCPSCH";"S";"0465";"                        SI LOCA_DRCP > 0"
"ICONSCPSCH";"S";"0466";"* LOCA_LIMITEHEB = HORC_IHIDRJTRAV / 5"
"ICONSCPSCH";"S";"0467";"                           LOCA_LIMITEHEB = LOCA_DRCP / 5"
"ICONSCPSCH";"S";"0468";"*Si congés pris hebdo <= limite hebdo 1/5 des droits CP travaillés"
"ICONSCPSCH";"S";"0469";"                           SI HJOU_IJRCPCOH <= LOCA_LIMITEHEB"
"ICONSCPSCH";"S";"0470";"                              LOCA_VAL = 0.5"
"ICONSCPSCH";"S";"0471";"                           SINON"
"ICONSCPSCH";"S";"0472";"                              LOCA_VAL = 0"
"ICONSCPSCH";"S";"0473";"                           FINSI"
"ICONSCPSCH";"S";"0474";"                        FINSI"
"ICONSCPSCH";"S";"0475";"                     SINON"
"ICONSCPSCH";"S";"0476";"                        LOCA_VAL = 0"
"ICONSCPSCH";"S";"0477";"                     FINSI"
"ICONSCPSCH";"S";"0478";"                  SINON"
"ICONSCPSCH";"S";"0479";"                     LOCA_VAL = 0.5"
"ICONSCPSCH";"S";"0480";"                  FINSI"
"ICONSCPSCH";"S";"0481";"               FINSI"
"ICONSCPSCH";"S";"0482";"* RELIQUAT"
"ICONSCPSCH";"S";"0483";"               SI HJOU_IJRSCORELI >= LOCA_VAL"
"ICONSCPSCH";"S";"0484";"                  LOCA_CPR = LOCA_VAL"
"ICONSCPSCH";"S";"0485";"                  LOCA_VALCPR = HABS_VALORIS"
"ICONSCPSCH";"S";"0486";"                  HJOU_IJRSCORELI = HJOU_IJRSCORELI - LOCA_VAL"
"ICONSCPSCH";"S";"0487";"                  LOCA_VAL = 0"
"ICONSCPSCH";"S";"0488";"                  LOCA_NOANNUL = 1"
"ICONSCPSCH";"S";"0489";"               SINON"
"ICONSCPSCH";"S";"0490";"                  SI HJOU_IJRSCORELI > 0"
"ICONSCPSCH";"S";"0491";"                     LOCA_VAL = 0.5"
"ICONSCPSCH";"S";"0492";"                     LOCA_CPR = 0.5"
"ICONSCPSCH";"S";"0493";"                     LOCA_VALCPR = ""M"""
"ICONSCPSCH";"S";"0494";"                     HJOU_IJRSCORELI = HJOU_IJRSCORELI - 0.5"
"ICONSCPSCH";"S";"0495";"                  FINSI"
"ICONSCPSCH";"S";"0496";"               FINSI"
"ICONSCPSCH";"S";"0497";"* test solde cp"
"ICONSCPSCH";"S";"0498";"               SI LOCA_VAL = 1"
"ICONSCPSCH";"S";"0499";"                    * Sans jour travaillé/non travaillé"
"ICONSCPSCH";"S";"0500";"                    SI HORC_IHIDRNTRAV = 0"
"ICONSCPSCH";"S";"0501";"                        SI HJOU_IJRSCOPRIN >= LOCA_VAL"
"ICONSCPSCH";"S";"0502";"                          HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + 1"
"ICONSCPSCH";"S";"0503";"                          HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - 1"
"ICONSCPSCH";"S";"0504";"                          *"
"ICONSCPSCH";"S";"0505";"                          LOCA_CP = 1"
"ICONSCPSCH";"S";"0506";"                          LOCA_VAL = 0"
"ICONSCPSCH";"S";"0507";"                          LOCA_VALCP = ""J"""
"ICONSCPSCH";"S";"0508";"                          LOCA_NOANNUL = 1"
"ICONSCPSCH";"S";"0509";"                        SINON"
"ICONSCPSCH";"S";"0510";"                          SI HJOU_IJRSCOPRIN > 0"
"ICONSCPSCH";"S";"0511";"                             HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + 0.5"
"ICONSCPSCH";"S";"0512";"                             HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - 0.5"
"ICONSCPSCH";"S";"0513";"                             *"
"ICONSCPSCH";"S";"0514";"                             LOCA_VAL = 0.5"
"ICONSCPSCH";"S";"0515";"                             LOCA_CP = 0.5"
"ICONSCPSCH";"S";"0516";"                             SI LOCA_CPR > 0"
"ICONSCPSCH";"S";"0517";"                             OU LOCA_CPAN > 0"
"ICONSCPSCH";"S";"0518";"                                LOCA_VALCP = ""A"""
"ICONSCPSCH";"S";"0519";"                             SINON"
"ICONSCPSCH";"S";"0520";"                                LOCA_VALCP = ""M"""
"ICONSCPSCH";"S";"0521";"                             FINSI"
"ICONSCPSCH";"S";"0522";"                          FINSI"
"ICONSCPSCH";"S";"0523";"                        FINSI"
"ICONSCPSCH";"S";"0524";"                    SINON"
"ICONSCPSCH";"S";"0525";"                        * Avec jour travaillé/non travaillé"
