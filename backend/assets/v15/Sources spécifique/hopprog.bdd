"ICREDB";"S";"0298";"* procedure de fin de periode 2"
"ICREDB";"S";"0299";"*"
"ICREDB";"S";"0300";"* Calcul du credit/debit permanent en fonction des reports periode et"
"ICREDB";"S";"0301";"* mini/maxi du credit permanent"
"ICREDB";"S";"0302";"*"
"ICREDB";"S";"0303";"PROC FINPER2"
"ICREDB";"S";"0304";"* Retrait du credit permanent si indicateur = 1"
"ICREDB";"S";"0305";"   SI PARD_IDIGDEBCRE = ""1"""
"ICREDB";"S";"0306";"      HJOU_IJRVICRD01 = HJOU_IJRVICRD01 - HJOU_IJRCDPERMA"
"ICREDB";"S";"0307";"   FINSI"
"ICREDB";"S";"0308";"* Ecretage du report maximum"
"ICREDB";"S";"0309";"   SI HJOU_IJRVICRD01 > HJOU_IJICDRPLAF"
"ICREDB";"S";"0310";"      HJOU_IJQHECRETP = HJOU_IJRVICRD01 - HJOU_IJICDRPLAF"
"ICREDB";"S";"0311";"      HJOU_IJRVICRD01 = HJOU_IJICDRPLAF"
"ICREDB";"S";"0312";"      ANOMALIE 109"
"ICREDB";"S";"0313";"   FINSI"
"ICREDB";"S";"0314";"* Ecretage du report minimum"
"ICREDB";"S";"0315";"   SI HJOU_IJRVICRD01 < HJOU_IJICDRPLAN"
"ICREDB";"S";"0316";"      HJOU_IJQHECRETP = HJOU_IJRVICRD01 - HJOU_IJICDRPLAN"
"ICREDB";"S";"0317";"      HJOU_IJRVICRD01 = HJOU_IJICDRPLAN"
"ICREDB";"S";"0318";"      ANOMALIE 108"
"ICREDB";"S";"0319";"   FINSI"
"ICREDB";"S";"0320";"* Alimentation du credit/debit permanent"
"ICREDB";"S";"0321";"   HJOU_IJRCDPERMA = HJOU_IJRCDPERMA + HJOU_IJRVICRD01"
"ICREDB";"S";"0322";"*"
"ICREDB";"S";"0323";"FINPROC"
"ICRPRO";"S";"0001";"***********************************************************************"
"ICRPRO";"S";"0002";"*"
"ICRPRO";"S";"0003";"* Règle : ICRPRO"
"ICRPRO";"S";"0004";"* Ordre : 2100"
"ICRPRO";"S";"0005";"* Titre : Crédits automatiques"
"ICRPRO";"S";"0006";"*"
"ICRPRO";"S";"0007";"*----------------------------------------------------------------------"
"ICRPRO";"S";"0008";"*"
"ICRPRO";"S";"0009";"* Créé par : Cellule Industrialisation"
"ICRPRO";"S";"0010";"* Date     : 03/09/2009"
"ICRPRO";"S";"0011";"* Version  : 1"
"ICRPRO";"S";"0012";"*"
"ICRPRO";"S";"0013";"*----------------------------------------------------------------------"
"ICRPRO";"S";"0014";"*"
"ICRPRO";"S";"0015";"*"
"ICRPRO";"S";"0016";"* Rôle : Crédits automatiques liés à l'horaire ou à l'employé"
"ICRPRO";"S";"0017";"*"
"ICRPRO";"S";"0018";"*"
"ICRPRO";"S";"0019";"*"
"ICRPRO";"S";"0020";"*"
"ICRPRO";"S";"0021";"*----------------------------------------------------------------------"
"ICRPRO";"S";"0022";"*"
"ICRPRO";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"ICRPRO";"S";"0024";"* Date         : JJ/MM/AAAA"
"ICRPRO";"S";"0025";"* Objet        :"
"ICRPRO";"S";"0026";"*"
"ICRPRO";"S";"0027";"***********************************************************************"
"ICRPRO";"S";"0028";"*"
"ICRPRO";"S";"0029";"* Implémentation des données industrielles"
"ICRPRO";"S";"0030";"*"
"ICRPRO";"S";"0031";"DEBDICO"
"ICRPRO";"S";"0032";"   HJOU_IJIVMOTFOR;N;A10;X;;;123456789;II;;C0;""Motif de forfait temps"";"
"ICRPRO";"S";"0033";"   HJOU_IJIM2PRENB;O;A10;X;;;123456789;II;;C0;""Motif présence non badgée"";"
"ICRPRO";"S";"0034";"FINDICO"
"ICRPRO";"S";"0035";"*"
"ICRPRO";"S";"0036";"* Déclaration des donnees locales"
"ICRPRO";"S";"0037";"*"
"ICRPRO";"S";"0038";"*---------------------------------------------------------------------"
"ICRPRO";"S";"0039";"*   CREDIT AUTOMATIQUE LIE A L'HORAIRE                               *"
"ICRPRO";"S";"0040";"*---------------------------------------------------------------------"
"ICRPRO";"S";"0041";"SI HJOU_DATE <= TEMP_DATJOU"
"ICRPRO";"S";"0042";"   SI HJOU_IJIVMOTFOR <> "" """
"ICRPRO";"S";"0043";"      ENLEVER HJOU_IJIVMOTFOR"
"ICRPRO";"S";"0044";"      HJOU_IJIVMOTFOR = "" """
"ICRPRO";"S";"0045";"   FINSI"
"ICRPRO";"S";"0046";"   SI PROF_IPIVMOPANB <> "" """
"ICRPRO";"S";"0047";"      SI PROF_IPIVPREANB <> 0"
"ICRPRO";"S";"0048";"         SI HJOU_IJQPRESBAJ >= PROF_IPIVMIPANB"
"ICRPRO";"S";"0049";"            AJOUTER PROF_IPIVMOPANB ""H"" PROF_IPIVPREANB"
"ICRPRO";"S";"0050";"            HJOU_IJIVMOTFOR = PROF_IPIVMOPANB"
"ICRPRO";"S";"0051";"         FINSI"
"ICRPRO";"S";"0052";"      FINSI"
"ICRPRO";"S";"0053";"   FINSI"
"ICRPRO";"S";"0054";"FINSI"
"ICRPRO";"S";"0055";"*"
"ICRPRO";"S";"0056";"*---------------------------------------------------------------------"
"ICRPRO";"S";"0057";"*   CREDIT AUTOMATIQUE LIE A L'EMPLOYE                               *"
"ICRPRO";"S";"0058";"*---------------------------------------------------------------------"
"ICRPRO";"S";"0059";"SI HJOU_DATE <= TEMP_DATJOU"
"ICRPRO";"S";"0060";"   SI HJOU_IJIM2PRENB <> "" """
"ICRPRO";"S";"0061";"      ENLEVER HJOU_IJIM2PRENB"
"ICRPRO";"S";"0062";"      HJOU_IJIM2PRENB = "" """
"ICRPRO";"S";"0063";"   FINSI"
"ICRPRO";"S";"0064";"   SI HJOU_IJIM1PRENB <> "" """
"ICRPRO";"S";"0065";"      SI HJOU_IJIVAPRENB <> 0"
"ICRPRO";"S";"0066";"         SI HJOU_IJQPRESBAJ >= HJOU_IJIMIAPRNB"
"ICRPRO";"S";"0067";"            AJOUTER HJOU_IJIM1PRENB ""H"" HJOU_IJIVAPRENB"
"ICRPRO";"S";"0068";"            HJOU_IJIM2PRENB = HJOU_IJIM1PRENB"
"ICRPRO";"S";"0069";"         FINSI"
"ICRPRO";"S";"0070";"      FINSI"
"ICRPRO";"S";"0071";"   FINSI"
"ICRPRO";"S";"0072";"FINSI"
"ICRPRO";"S";"0073";"FIN"
"ICSEBADG";"S";"0001";"***********************************************************************"
"ICSEBADG";"S";"0002";"*"
"ICSEBADG";"S";"0003";"* Règle : ICSEBADG"
"ICSEBADG";"S";"0004";"* Ordre : 2200"
"ICSEBADG";"S";"0005";"* Titre : Gestion des heures de délégation CSE badgées au lecteur"
"ICSEBADG";"S";"0006";"*"
"ICSEBADG";"S";"0007";"*----------------------------------------------------------------------"
"ICSEBADG";"S";"0008";"*"
"ICSEBADG";"S";"0009";"* Créé par : Méthodes et outils"
"ICSEBADG";"S";"0010";"* Date     : 23/12/2019"
"ICSEBADG";"S";"0011";"* Version  : 1"
"ICSEBADG";"S";"0012";"*"
"ICSEBADG";"S";"0013";"*----------------------------------------------------------------------"
"ICSEBADG";"S";"0014";"*"
"ICSEBADG";"S";"0015";"*"
"ICSEBADG";"S";"0016";"* Rôle : Gestion des heures de délégation CSE badgées au lecteur"
"ICSEBADG";"S";"0017";"*"
"ICSEBADG";"S";"0018";"*"
"ICSEBADG";"S";"0019";"*"
"ICSEBADG";"S";"0020";"*----------------------------------------------------------------------"
"ICSEBADG";"S";"0021";"*"
"ICSEBADG";"S";"0022";"* Modifiée par :"
"ICSEBADG";"S";"0023";"* Date         : JJ/MM/AAAA"
"ICSEBADG";"S";"0024";"* Objet        :"
"ICSEBADG";"S";"0025";"*"
"ICSEBADG";"S";"0026";"***********************************************************************"
"ICSEBADG";"S";"0027";"*"
"ICSEBADG";"S";"0028";"* Implémentation des données industrielles"
"ICSEBADG";"S";"0029";"*"
"ICSEBADG";"S";"0030";"DEBDICO"
"ICSEBADG";"S";"0031";"FINDICO"
"ICSEBADG";"S";"0032";"*"
"ICSEBADG";"S";"0033";"DEBANO"
"ICSEBADG";"S";"0034";"FINANO"
"ICSEBADG";"S";"0035";"*"
"ICSEBADG";"S";"0036";"* -------------------------------"
"ICSEBADG";"S";"0037";"* Déclaration des donnees locales"
"ICSEBADG";"S";"0038";"* -------------------------------"
"ICSEBADG";"S";"0039";"*"
"ICSEBADG";"S";"0040";"DEF LOCA_DECSEB A10"
"ICSEBADG";"S";"0041";"LOCA_DECSEB = "" """
"ICSEBADG";"S";"0042";"DEF LOCA_ENTREE T6.2"
"ICSEBADG";"S";"0043";"LOCA_ENTREE = 0"
"ICSEBADG";"S";"0044";"DEF LOCA_DIFF T6.2"
"ICSEBADG";"S";"0045";"LOCA_DIFF = 0"
"ICSEBADG";"S";"0046";"DEF LOCA_DUREE T6.2"
"ICSEBADG";"S";"0047";"LOCA_DUREE = 0"
"ICSEBADG";"S";"0048";"DEF LOCA_SORTIE T6.2"
"ICSEBADG";"S";"0049";"LOCA_SORTIE = 0"
"ICSEBADG";"S";"0050";"DEF LOCA_MOTIF A10"
"ICSEBADG";"S";"0051";"LOCA_MOTIF = ""DECSEB"""
"ICSEBADG";"S";"0052";"*"
"ICSEBADG";"S";"0053";"*"
"ICSEBADG";"S";"0054";"SI HJOU_DATE <= HJOU_IJIDFIN"
"ICSEBADG";"S";"0055";"    POUR POINTAGES"
"ICSEBADG";"S";"0056";"        SI POIN_SENS = ""1"""
"ICSEBADG";"S";"0057";"            SI POIN_IMPUT = LOCA_MOTIF"
"ICSEBADG";"S";"0058";"                LOCA_DECSEB = POIN_IMPUT"
"ICSEBADG";"S";"0059";"                LOCA_SORTIE = POIN_HRETRAI"
"ICSEBADG";"S";"0060";"            FINSI"
"ICSEBADG";"S";"0061";"        FINSI"
"ICSEBADG";"S";"0062";"        SI POIN_SENS = ""0"""
"ICSEBADG";"S";"0063";"            SI LOCA_DECSEB = LOCA_MOTIF"
"ICSEBADG";"S";"0064";"                LOCA_DECSEB = "" """
"ICSEBADG";"S";"0065";"                LOCA_ENTREE = POIN_HRETRAI"
"ICSEBADG";"S";"0066";"                LOCA_DIFF = LOCA_ENTREE - LOCA_SORTIE"
"ICSEBADG";"S";"0067";"                LOCA_DUREE = LOCA_DUREE + LOCA_DIFF"
"ICSEBADG";"S";"0068";"            FINSI"
"ICSEBADG";"S";"0069";"        FINSI"
"ICSEBADG";"S";"0070";"    FINPOUR"
"ICSEBADG";"S";"0071";"    *"
"ICSEBADG";"S";"0072";"    ENLEVER LOCA_MOTIF"
"ICSEBADG";"S";"0073";"    SI LOCA_DUREE > 0"
"ICSEBADG";"S";"0074";"        AJOUTER LOCA_MOTIF ""H"" LOCA_DUREE"
"ICSEBADG";"S";"0075";"    FINSI"
"ICSEBADG";"S";"0076";"FINSI"
"ICSEBADG";"S";"0077";"*"
"ICSEBADG";"S";"0078";"FIN"
"ICTRBA";"S";"0001";"***********************************************************************"
"ICTRBA";"S";"0002";"*"
"ICTRBA";"S";"0003";"* Règle : ICTRBA"
"ICTRBA";"S";"0004";"* Ordre : 3250"
"ICTRBA";"S";"0005";"* Titre : Controle du badgeage"
"ICTRBA";"S";"0006";"*"
"ICTRBA";"S";"0007";"*----------------------------------------------------------------------"
"ICTRBA";"S";"0008";"*"
"ICTRBA";"S";"0009";"* Créé par : Cellule Industrialisation"
"ICTRBA";"S";"0010";"* Date     : 03/09/2009"
"ICTRBA";"S";"0011";"* Version  : 1"
"ICTRBA";"S";"0012";"*"
"ICTRBA";"S";"0013";"*----------------------------------------------------------------------"
"ICTRBA";"S";"0014";"*"
"ICTRBA";"S";"0015";"*"
"ICTRBA";"S";"0016";"* Rôle : Controle du badgeage"
"ICTRBA";"S";"0017";"*"
"ICTRBA";"S";"0018";"*"
"ICTRBA";"S";"0019";"*"
"ICTRBA";"S";"0020";"*"
"ICTRBA";"S";"0021";"*"
"ICTRBA";"S";"0022";"*----------------------------------------------------------------------"
"ICTRBA";"S";"0023";"*"
"ICTRBA";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"ICTRBA";"S";"0025";"* Date         : JJ/MM/AAAA"
"ICTRBA";"S";"0026";"* Objet        :"
"ICTRBA";"S";"0027";"*"
"ICTRBA";"S";"0028";"***********************************************************************"
"ICTRBA";"S";"0029";"*"
"ICTRBA";"S";"0030";"* Implémentation des données industrielles"
"ICTRBA";"S";"0031";"*"
"ICTRBA";"S";"0032";"DEBDICO"
"ICTRBA";"S";"0033";"   HJOU_IJQPRETHEJ;O;T6,2;I;;;    56789;;;C0;""Présence théorique jour"";"
"ICTRBA";"S";"0034";"FINDICO"
"ICTRBA";"S";"0035";"*"
"ICTRBA";"S";"0036";"DEBANO"
"ICTRBA";"S";"0037";"   101;9;""Il manque un badgeage en sortie"";"
"ICTRBA";"S";"0038";"   103;9;""Employé absent sans justificatif"";"
"ICTRBA";"S";"0039";"   106;5;""Nombre de badgeages insuffisant"";"
"ICTRBA";"S";"0040";"   125;8;""Employé absent matin sans justificatif"";"
"ICTRBA";"S";"0041";"   126;8;""Employé absent après-midi sans justificatif"";"
"ICTRBA";"S";"0042";"   127;8;""Badgeages pour employé présumé non badgeant"";"
"ICTRBA";"S";"0043";"   179;8;""Employé absent demi-journée sans justificatif"";"
"ICTRBA";"S";"0044";"FINANO"
"ICTRBA";"S";"0045";"* Déclaration des donnees locales"
"ICTRBA";"S";"0046";"*"
"ICTRBA";"S";"0047";"DEF LOCA_PARITE N2"
"ICTRBA";"S";"0048";"LOCA_PARITE = 0"
"ICTRBA";"S";"0049";"DEF LOCA_NPOIN N2"
"ICTRBA";"S";"0050";"LOCA_NPOIN = HJOU_IJQNBADGEA"
"ICTRBA";"S";"0051";"DEF LOCA_ANOM N2"
"ICTRBA";"S";"0052";"LOCA_ANOM = 0"
"ICTRBA";"S";"0053";"* Test pour ne pas derouler cette r?gle dans le futur"
"ICTRBA";"S";"0054";"SI HJOU_DATE <= TEMP_DATJOU"
"ICTRBA";"S";"0055";"* Anomalie si pas de badgeage et pas d'absence jour"
"ICTRBA";"S";"0056";"   SI HJOU_IJIGBADGEA = ""1"""
"ICTRBA";"S";"0057";"      SI HJOU_IJQNBADGEA = 0"
"ICTRBA";"S";"0058";"         SI HJOU_IJQNABSENT = 0"
"ICTRBA";"S";"0059";"            SI HJOU_IJQPRETHEJ > 0"
"ICTRBA";"S";"0060";"               LOCA_ANOM = 1"
"ICTRBA";"S";"0061";"* pas d'anomalie sur jour en cours"
"ICTRBA";"S";"0062";"               SI HJOU_DATE < TEMP_DATJOU"
"ICTRBA";"S";"0063";"                  ANOMALIE 103"
"ICTRBA";"S";"0064";"               FINSI"
"ICTRBA";"S";"0065";"            FINSI"
"ICTRBA";"S";"0066";"         FINSI"
"ICTRBA";"S";"0067";"      FINSI"
"ICTRBA";"S";"0068";"* Anomalie si aucun badgeage matin et aucune absence matin"
"ICTRBA";"S";"0069";"      SI LOCA_ANOM <> 1"
"ICTRBA";"S";"0070";"         SI HJOU_IJQNACTIVJ = 0"
"ICTRBA";"S";"0071";"            SI PROF_ABSENM > 0"
"ICTRBA";"S";"0072";"               SI HJOU_IJQPRESBA1 = 0"
"ICTRBA";"S";"0073";"                  SI HJOU_IJQNABSEN1 = 0"
"ICTRBA";"S";"0074";"                     SI PROF_PTTHEO1 > 0"
"ICTRBA";"S";"0075";"                        SI PROF_PTTHEO1 <= 36.00"
"ICTRBA";"S";"0076";"* pas d'anomalie pour les declarants"
"ICTRBA";"S";"0077";"* qui badgent 1 fois"
"ICTRBA";"S";"0078";"                           SI PROF_IPIVMINBAD > 1"
"ICTRBA";"S";"0079";"                              ANOMALIE 125"
"ICTRBA";"S";"0080";"                           FINSI"
"ICTRBA";"S";"0081";"                        FINSI"
"ICTRBA";"S";"0082";"                     FINSI"
"ICTRBA";"S";"0083";"                  FINSI"
"ICTRBA";"S";"0084";"               FINSI"
"ICTRBA";"S";"0085";"            FINSI"
"ICTRBA";"S";"0086";"* Anomalie si aucun badgeage et absence apres-midi"
"ICTRBA";"S";"0087";"            SI PROF_ABSENS > 0"
"ICTRBA";"S";"0088";"               SI HJOU_IJQPRESBA2 = 0"
"ICTRBA";"S";"0089";"**SI HJOU_IJQNABSEN2 = 0"
"ICTRBA";"S";"0090";"                  SI PROF_PTTHEO3 > 0"
"ICTRBA";"S";"0091";"                     SI PROF_PTTHEO3 <= 36.00"
"ICTRBA";"S";"0092";"* pas d'anomalie pour les declarants"
"ICTRBA";"S";"0093";"* qui badgent 1 fois"
"ICTRBA";"S";"0094";"                        SI PROF_IPIVMINBAD > 1"
"ICTRBA";"S";"0095";"                           SI HJOU_IJQNABSEN2 = 0"
"ICTRBA";"S";"0096";"                              ANOMALIE 126"
"ICTRBA";"S";"0097";"                           FINSI"
"ICTRBA";"S";"0098";"                           SI HJOU_IJQNABSEN2 = 50"
"ICTRBA";"S";"0099";"                              ANOMALIE 179"
"ICTRBA";"S";"0100";"                           FINSI"
"ICTRBA";"S";"0101";"                        FINSI"
"ICTRBA";"S";"0102";"                     FINSI"
"ICTRBA";"S";"0103";"                  FINSI"
"ICTRBA";"S";"0104";"***FINSI"
"ICTRBA";"S";"0105";"               FINSI"
"ICTRBA";"S";"0106";"            FINSI"
"ICTRBA";"S";"0107";"* Controle de la parite des pointages"
"ICTRBA";"S";"0108";"            LOCA_PARITE = HJOU_IJQNBADGEA % 2"
"ICTRBA";"S";"0109";"            SI LOCA_PARITE <> 0"
"ICTRBA";"S";"0110";"* pas d'anomalie sur jour en cours"
"ICTRBA";"S";"0111";"               SI HJOU_DATE < TEMP_DATJOU"
"ICTRBA";"S";"0112";"* pas d'anomalie pour les declarants"
"ICTRBA";"S";"0113";"* qui badgent 1 fois"
"ICTRBA";"S";"0114";"                  SI PROF_IPIVMINBAD > 1"
"ICTRBA";"S";"0115";"                     ANOMALIE 101"
"ICTRBA";"S";"0116";"                  FINSI"
"ICTRBA";"S";"0117";"               FINSI"
"ICTRBA";"S";"0118";"            FINSI"
"ICTRBA";"S";"0119";"         FINSI"
"ICTRBA";"S";"0120";"      FINSI"
"ICTRBA";"S";"0121";"* Controle du nombre de badgeages impos?s"
"ICTRBA";"S";"0122";"      SI LOCA_ANOM = 0"
"ICTRBA";"S";"0123";"         SI HJOU_IJQPRETHEJ > 0"
"ICTRBA";"S";"0124";"            SI HJOU_IJQNABSEN1 > 0"
"ICTRBA";"S";"0125";"               LOCA_NPOIN = LOCA_NPOIN + 2"
"ICTRBA";"S";"0126";"            FINSI"
"ICTRBA";"S";"0127";"            SI HJOU_IJQNABSEN2 > 0"
"ICTRBA";"S";"0128";"               LOCA_NPOIN = LOCA_NPOIN + 2"
"ICTRBA";"S";"0129";"            FINSI"
"ICTRBA";"S";"0130";"            SI HJOU_IJQNACTIVJ > 0"
"ICTRBA";"S";"0131";"            OU HJOU_IJQABSENTJ >= HJOU_IJQPRETHEJ"
"ICTRBA";"S";"0132";"               LOCA_NPOIN = PROF_IPIVMINBAD"
"ICTRBA";"S";"0133";"            FINSI"
"ICTRBA";"S";"0134";"            SI LOCA_NPOIN < PROF_IPIVMINBAD"
"ICTRBA";"S";"0135";"               ANOMALIE 106"
"ICTRBA";"S";"0136";"            FINSI"
"ICTRBA";"S";"0137";"         FINSI"
"ICTRBA";"S";"0138";"      FINSI"
"ICTRBA";"S";"0139";"   FINSI"
"ICTRBA";"S";"0140";"* anomalie si badgeages pour un non badgeant"
"ICTRBA";"S";"0141";"   SI HJOU_IJIGBADGEA <> ""1"""
"ICTRBA";"S";"0142";"      SI HJOU_IJQNBADGEA > 0"
"ICTRBA";"S";"0143";"         ANOMALIE 127"
"ICTRBA";"S";"0144";"      FINSI"
"ICTRBA";"S";"0145";"   FINSI"
"ICTRBA";"S";"0146";"FINSI"
"ICTRBA";"S";"0147";"FIN"
