"SGECET";"S";"0011";"* Version  : 1"
"SGECET";"S";"0012";"*"
"SGECET";"S";"0013";"*----------------------------------------------------------------------"
"SGECET";"S";"0014";"*"
"SGECET";"S";"0015";"*"
"SGECET";"S";"0016";"* Rôle : Gestion du CET / alimentation auto en fin de période"
"SGECET";"S";"0017";"*"
"SGECET";"S";"0018";"*"
"SGECET";"S";"0019";"*----------------------------------------------------------------------"
"SGECET";"S";"0020";"*"
"SGECET";"S";"0021";"* Modifiée par :"
"SGECET";"S";"0022";"* Date         :"
"SGECET";"S";"0023";"* Objet        :"
"SGECET";"S";"0024";"*"
"SGECET";"S";"0025";"***********************************************************************"
"SGECET";"S";"0026";"*"
"SGECET";"S";"0027";"* Implémentation des données industrielles"
"SGECET";"S";"0028";"*"
"SGECET";"S";"0029";"DEBDICO"
"SGECET";"S";"0030";"   PARD_SDICPCETMO;N;N4,1;I;000000000000;;    56789;;;C3;""MO : CP maximum alimentant le CET/an"";"
"SGECET";"S";"0031";"   PARD_SDICPCETES;N;N4,1;I;000000000000;;    56789;;;C3;""ES : CP maximum alimentant le CET/an"";"
"SGECET";"S";"0032";"   PARD_SDIRTCETES;N;N4,1;I;000000000000;;    56789;;;C3;""ES : RTT maximum alimentant le CET/an"";"
"SGECET";"S";"0033";"   PARD_SDIPLCETES;N;N4,1;I;000000000000;;    56789;;;C3;""ES : Plafond CET"";"
"SGECET";"S";"0034";"   PARD_SDIVMCET;O;A10;X;;;123456789;II;;C2;""Motif CET"";"
"SGECET";"S";"0035";"   *"
"SGECET";"S";"0036";"   HJOU_SJRDRCET;N;N6,1;L;;;    56789;;SJRDRCET;V3;""Droit CET"";"
"SGECET";"S";"0037";"   HJOU_SJRCOCET;N;N6,1;L;;;    56789;;SJRCOCET;V3;""Pris CET"";"
"SGECET";"S";"0038";"   HJOU_IJRSOLDCET;N;N6,1;L;;;    56789;;IJRSOLDCET;V3;""Solde CET"";"
"SGECET";"S";"0039";"   HJOU_SJRCOCETW;N;N6,1;L;;;    56789;;SJRCOCETW;V3;""Pris CET en attente"";"
"SGECET";"S";"0040";"   HJOU_SJRNCPCETA;N;N6,1;L;;;    56789;;SJRNCPCETA;V3;""CP mis dans le CET annuel"";"
"SGECET";"S";"0041";"   HJOU_SJRNRTCETA;N;N6,1;L;;;    56789;;SJRNRTCETA;V3;""RTT mis dans le CET annuel"";"
"SGECET";"S";"0042";"   *   HJOU_IJRSCPCET;N;N6,1;L;;;    56789;;IJRSCPCET;V3;""Solde CET au titre des congés payés"";"
"SGECET";"S";"0043";"   EMPL_IEQSPRJCET;N;N6,1;I;;;     6789;;;V3;""Solde prévisionnel CET en jour"";"
"SGECET";"S";"0044";"FINDICO"
"SGECET";"S";"0045";"*"
"SGECET";"S";"0046";"DEBANO"
"SGECET";"S";"0047";"   157;8;""Solde CET insuffisant"";"
"SGECET";"S";"0048";"FINANO"
"SGECET";"S";"0049";"* Déclaration des donnees locales"
"SGECET";"S";"0050";"*"
"SGECET";"S";"0051";"DEF LOCA_FERI N2"
"SGECET";"S";"0052";"LOCA_FERI = 0"
"SGECET";"S";"0053";"DEF LOCA_MOT N2"
"SGECET";"S";"0054";"LOCA_MOT = 0"
"SGECET";"S";"0055";"DEF LOCA_PRIS N6.2"
"SGECET";"S";"0056";"LOCA_PRIS = 0"
"SGECET";"S";"0057";"DEF LOCA_PRISW N6.2"
"SGECET";"S";"0058";"LOCA_PRISW = 0"
"SGECET";"S";"0059";"DEF LOCA_MOTIF A10"
"SGECET";"S";"0060";"LOCA_MOTIF = "" """
"SGECET";"S";"0061";"DEF LOCA_MOTINBR N6.2"
"SGECET";"S";"0062";"LOCA_MOTINBR = 0"
"SGECET";"S";"0063";"DEF LOCA_RESTE N6.2"
"SGECET";"S";"0064";"LOCA_RESTE = 0"
"SGECET";"S";"0065";"*"
"SGECET";"S";"0066";"* RAZ >>"
"SGECET";"S";"0067";"SI HJOU_DATE(5:4) = ""0101"""
"SGECET";"S";"0068";"   HJOU_SJRNCPCETA = 0"
"SGECET";"S";"0069";"   HJOU_SJRNRTCETA = 0"
"SGECET";"S";"0070";"FINSI"
"SGECET";"S";"0071";"*"
"SGECET";"S";"0072";"* Alimentation par consignes"
"SGECET";"S";"0073";"*"
"SGECET";"S";"0074";"POUR ACTIVITES"
"SGECET";"S";"0075";"* Identifie motif Férié >>"
"SGECET";"S";"0076";"   SI HABS_MOTIF = ""JF"""
"SGECET";"S";"0077";"      LOCA_FERI = 1"
"SGECET";"S";"0078";"   FINSI"
"SGECET";"S";"0079";"* Consignes Standard"
"SGECET";"S";"0080";"   SI HABS_MOTIF = ""XDCET"""
"SGECET";"S";"0081";"      HJOU_SJRDRCET = HJOU_SJRDRCET + HABS_MOTINBR"
"SGECET";"S";"0082";"   FINSI"
"SGECET";"S";"0083";"   SI HABS_MOTIF = ""ZDCET"""
"SGECET";"S";"0084";"      HJOU_SJRDRCET = HABS_MOTINBR"
"SGECET";"S";"0085";"   FINSI"
"SGECET";"S";"0086";"*"
"SGECET";"S";"0087";"* Transfert de CP en CET"
"SGECET";"S";"0088";"   SI HABS_MOTIF = ""YCETCPA"""
"SGECET";"S";"0089";"      HJOU_SJRDRCET = HJOU_SJRDRCET + HABS_MOTINBR"
"SGECET";"S";"0090";"      HJOU_SJRNCPCETA = HJOU_SJRNCPCETA + HABS_MOTINBR"
"SGECET";"S";"0091";"   FINSI"
"SGECET";"S";"0092";"* Transfert de RTT en jour en CET"
"SGECET";"S";"0093";"   SI HABS_MOTIF = ""YCETRTA"""
"SGECET";"S";"0094";"      HJOU_SJRDRCET = HJOU_SJRDRCET + HABS_MOTINBR"
"SGECET";"S";"0095";"      HJOU_SJRNRTCETA = HJOU_SJRNRTCETA + HABS_MOTINBR"
"SGECET";"S";"0096";"   FINSI"
"SGECET";"S";"0097";"*"
"SGECET";"S";"0098";"FINPOUR"
"SGECET";"S";"0099";"*"
"SGECET";"S";"0100";"* Solde"
"SGECET";"S";"0101";"HJOU_IJRSOLDCET = HJOU_SJRDRCET - HJOU_SJRCOCET"
"SGECET";"S";"0102";"*"
"SGECET";"S";"0103";"***** DEB : Gestion de la consommation >>"
"SGECET";"S";"0104";"POUR ACTIVITES"
"SGECET";"S";"0105";"*"
"SGECET";"S";"0106";"   SI HJOU_IJQPRETHEJ > 0"
"SGECET";"S";"0107";"      SI HABS_MOTIF = PARD_SDIVMCET"
"SGECET";"S";"0108";"         LOCA_MOT = 1"
"SGECET";"S";"0109";"*"
"SGECET";"S";"0110";"         SI HABS_VALORIS = ""J"""
"SGECET";"S";"0111";"            SI PROF_ABSENM = 0"
"SGECET";"S";"0112";"            OU PROF_ABSENS = 0"
"SGECET";"S";"0113";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SGECET";"S";"0114";"            SINON"
"SGECET";"S";"0115";"               LOCA_PRIS = LOCA_PRIS + 1"
"SGECET";"S";"0116";"            FINSI"
"SGECET";"S";"0117";"         SINON"
"SGECET";"S";"0118";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SGECET";"S";"0119";"         FINSI"
"SGECET";"S";"0120";"*"
"SGECET";"S";"0121";"      FINSI"
"SGECET";"S";"0122";"   FINSI"
"SGECET";"S";"0123";"FINPOUR"
"SGECET";"S";"0124";"*"
"SGECET";"S";"0125";"SI LOCA_PRIS > 1"
"SGECET";"S";"0126";"   LOCA_PRIS = 1"
"SGECET";"S";"0127";"FINSI"
"SGECET";"S";"0128";"*"
"SGECET";"S";"0129";"SI LOCA_PRIS > 0"
"SGECET";"S";"0130";"   HJOU_SJRCOCET = HJOU_SJRCOCET + LOCA_PRIS"
"SGECET";"S";"0131";"FINSI"
"SGECET";"S";"0132";"*"
"SGECET";"S";"0133";"* Init et MAJ du pris par consignes >>"
"SGECET";"S";"0134";"POUR ACTIVITES"
"SGECET";"S";"0135";"* MAJ"
"SGECET";"S";"0136";"   SI HABS_MOTIF = ""XCCET"""
"SGECET";"S";"0137";"      HJOU_SJRCOCET = HJOU_SJRCOCET + HABS_MOTINBR"
"SGECET";"S";"0138";"   FINSI"
"SGECET";"S";"0139";"* Init"
"SGECET";"S";"0140";"   SI HABS_MOTIF = ""ZCCET"""
"SGECET";"S";"0141";"      HJOU_SJRCOCET = HABS_MOTINBR"
"SGECET";"S";"0142";"   FINSI"
"SGECET";"S";"0143";"FINPOUR"
"SGECET";"S";"0144";"*"
"SGECET";"S";"0145";"* Solde >>"
"SGECET";"S";"0146";"HJOU_IJRSOLDCET = HJOU_SJRDRCET - HJOU_SJRCOCET"
"SGECET";"S";"0147";"*"
"SGECET";"S";"0148";"***** DEB : Gestion du pris en attente >>"
"SGECET";"S";"0149";"*"
"SGECET";"S";"0150";"POUR WACTIVITES"
"SGECET";"S";"0151";"   SI WABS_ANNUL = ""0"""
"SGECET";"S";"0152";"      SI LOCA_FERI <> 1"
"SGECET";"S";"0153";"         SI HJOU_IJQPRETHEJ > 0.00"
"SGECET";"S";"0154";"*"
"SGECET";"S";"0155";"            SI WABS_MOTIF = PARD_SDIVMCET"
"SGECET";"S";"0156";"* Gestion de la valorisation >>"
"SGECET";"S";"0157";"               SI WABS_VALORIS = ""J"""
"SGECET";"S";"0158";"                  SI PROF_ABSENM = 0"
"SGECET";"S";"0159";"                  OU PROF_ABSENS = 0"
"SGECET";"S";"0160";"                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SGECET";"S";"0161";"                  SINON"
"SGECET";"S";"0162";"                     LOCA_PRISW = 1"
"SGECET";"S";"0163";"                  FINSI"
"SGECET";"S";"0164";"               SINON"
"SGECET";"S";"0165";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SGECET";"S";"0166";"               FINSI"
"SGECET";"S";"0167";"            FINSI"
"SGECET";"S";"0168";"         FINSI"
"SGECET";"S";"0169";"      FINSI"
"SGECET";"S";"0170";"   FINSI"
"SGECET";"S";"0171";"FINPOUR"
"SGECET";"S";"0172";"*"
"SGECET";"S";"0173";"SI LOCA_PRISW > 1"
"SGECET";"S";"0174";"   LOCA_PRISW = 1"
"SGECET";"S";"0175";"FINSI"
"SGECET";"S";"0176";"*"
"SGECET";"S";"0177";"SI LOCA_PRISW > 0"
"SGECET";"S";"0178";"   HJOU_SJRCOCETW = HJOU_SJRCOCETW + LOCA_PRISW"
"SGECET";"S";"0179";"FINSI"
"SGECET";"S";"0180";"*"
"SGECET";"S";"0181";"* Solde >>"
"SGECET";"S";"0182";"HJOU_IJRSOLDCET = HJOU_SJRDRCET - HJOU_SJRCOCET"
"SGECET";"S";"0183";"*"
"SGECET";"S";"0184";"*"
"SGECET";"S";"0185";"SI LOCA_MOT = 1"
"SGECET";"S";"0186";"* Si solde négatif ?"
"SGECET";"S";"0187";"   SI HJOU_IJRSOLDCET < 0"
"SGECET";"S";"0188";"      ANOMALIE 157"
"SGECET";"S";"0189";"      SI TEMP_CNMOTIF = PARD_SDIVMCET"
"SGECET";"S";"0190";"         TEMP_CNRETOUR = 2"
"SGECET";"S";"0191";"         TEMP_CNMESS = 157"
"SGECET";"S";"0192";"      FINSI"
"SGECET";"S";"0193";"   FINSI"
"SGECET";"S";"0194";"*"
"SGECET";"S";"0195";"FINSI"
"SGECET";"S";"0196";"*"
"SGECET";"S";"0197";"*"
"SGECET";"S";"0198";"* Alimentation du solde prévisionnel"
"SGECET";"S";"0199";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGECET";"S";"0200";"   SI HJOU_SJQFINC = 1"
"SGECET";"S";"0201";"      EMPL_IEQSPRJCET = HJOU_IJRSOLDCET - HJOU_SJRCOCETW"
"SGECET";"S";"0202";"   FINSI"
"SGECET";"S";"0203";"FINSI"
"SGECET";"S";"0204";"SI TEMP_DATSUI = EMPL_DATTRAI"
"SGECET";"S";"0205";"   EMPL_IEQSPRJCET = HJOU_IJRSOLDCET - HJOU_SJRCOCETW"
"SGECET";"S";"0206";"FINSI"
"SGECET";"S";"0207";"FIN"
"SGECET";"S";"0208";"*"
"SGECET";"S";"0209";"*"
"SGECET";"S";"0210";"* Contrôle si saisie un jour plein >>"
"SGECET";"S";"0211";"PROC PALIER1"
"SGECET";"S";"0212";"   LOCA_RESTE = LOCA_MOTINBR % 1"
"SGECET";"S";"0213";"   SI LOCA_RESTE > 0"
"SGECET";"S";"0214";"   OU LOCA_MOTINBR = 0"
"SGECET";"S";"0215";"      ANOMALIE 291"
"SGECET";"S";"0216";"      SI TEMP_CNMOTIF(1:4) = LOCA_MOTIF"
"SGECET";"S";"0217";"         TEMP_CNRETOUR = 2"
"SGECET";"S";"0218";"         TEMP_CNMESS = 291"
"SGECET";"S";"0219";"      FINSI"
"SGECET";"S";"0220";"   FINSI"
"SGECET";"S";"0221";"FINPROC"
"SGECET";"S";"0222";"* Contrôle si saisie un jour plein ou demi-jour >>"
"SGECET";"S";"0223";"PROC PALIER05"
"SGECET";"S";"0224";"   LOCA_RESTE = LOCA_MOTINBR % 0.5"
"SGECET";"S";"0225";"   SI LOCA_RESTE > 0"
"SGECET";"S";"0226";"   OU LOCA_MOTINBR = 0"
"SGECET";"S";"0227";"      ANOMALIE 292"
"SGECET";"S";"0228";"      SI TEMP_CNMOTIF(1:4) = LOCA_MOTIF"
"SGECET";"S";"0229";"         TEMP_CNRETOUR = 2"
"SGECET";"S";"0230";"         TEMP_CNMESS = 292"
"SGECET";"S";"0231";"      FINSI"
"SGECET";"S";"0232";"   FINSI"
"SGECET";"S";"0233";"FINPROC"
