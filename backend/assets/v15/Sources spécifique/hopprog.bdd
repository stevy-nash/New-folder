"SCONTR";"S";"0420";"         LOCA_CARENCE = HJOU_IJRNBRJCTR / 2"
"SCONTR";"S";"0421";"      FINSI"
"SCONTR";"S";"0422";"**"
"SCONTR";"S";"0423";"**arrondi"
"SCONTR";"S";"0424";"**"
"SCONTR";"S";"0425";"      LOCA_REST = LOCA_CARENCE % 1"
"SCONTR";"S";"0426";"      LOCA_CARENCE = LOCA_CARENCE - LOCA_REST"
"SCONTR";"S";"0427";"      SI LOCA_REST > 0"
"SCONTR";"S";"0428";"         LOCA_CARENCE = LOCA_CARENCE + 1"
"SCONTR";"S";"0429";"      FINSI"
"SCONTR";"S";"0430";"** Dans le cas ou les jours d'ouverture sont du lundi au vendredi"
"SCONTR";"S";"0431";"      SI PARD_IDIJOUROUV = ""0"""
"SCONTR";"S";"0432";"* - DURÉE DU CONTRAT À DIVISER PAR 2 OU 3"
"SCONTR";"S";"0433";"*- DIVISER LE CHIFFRE OBTENU PAR 5"
"SCONTR";"S";"0434";"*- PRENDRE LA PARTIE ENTIÈRE, LA MULTIPLIER PAR 2 (4 *2 = 8) ET L'AJOUTER"
"SCONTR";"S";"0435";"*"
"SCONTR";"S";"0436";"         LOCA_DELAI = LOCA_CARENCE / 5"
"SCONTR";"S";"0437";"         LOCA_REST = LOCA_DELAI % 1"
"SCONTR";"S";"0438";"         LOCA_DELAI = LOCA_DELAI - LOCA_REST"
"SCONTR";"S";"0439";"         LOCA_DELAI = LOCA_DELAI * 2"
"SCONTR";"S";"0440";"         LOCA_CARENCE = LOCA_DELAI + LOCA_CARENCE"
"SCONTR";"S";"0441";"      FINSI"
"SCONTR";"S";"0442";"*"
"SCONTR";"S";"0443";"      LOCA_INTCAR = LOCA_CARENCE"
"SCONTR";"S";"0444";"      DATAJT CTRA_DATFIN 12 ""J"" LOCA_INTCAR"
"SCONTR";"S";"0445";"      CADM_DATCARENCE = TEMP_DXFINPER"
"SCONTR";"S";"0446";"   FINSI"
"SCONTR";"S";"0447";"SINON"
"SCONTR";"S";"0448";"   CADM_DATCARENCE = "" """
"SCONTR";"S";"0449";"FINSI"
"SCONTR";"S";"0450";"*"
"SCONTR";"S";"0451";"* Alerte si apprentis travaille plus de 35h sur une semaine"
"SCONTR";"S";"0452";"*"
"SCONTR";"S";"0453";"SI HJOU_JOUR = ""7"""
"SCONTR";"S";"0454";"   SI CTRA_TYPCTRA = ""CAP"""
"SCONTR";"S";"0455";"   OU CTRA_TYPCTRA = ""STG"""
"SCONTR";"S";"0456";"      SI HJOU_IJRTTEFFEH > PARD_IDIVHORCOH"
"SCONTR";"S";"0457";"         ANOMALIE 249"
"SCONTR";"S";"0458";"      FINSI"
"SCONTR";"S";"0459";"   FINSI"
"SCONTR";"S";"0460";"FINSI"
"SCONTR";"S";"0461";"*"
"SCONTR";"S";"0462";"FIN"
"SCONTR";"S";"0463";"*"
"SCONTR";"S";"0464";"PROC CONTROLE"
"SCONTR";"S";"0465";"*"
"SCONTR";"S";"0466";"   SI HJOU_JOUR = ""7"""
"SCONTR";"S";"0467";"      SI HORC_MOYCYCLE < PARD_IDIMINLEGA"
"SCONTR";"S";"0468";"         ANOMALIE 180"
"SCONTR";"S";"0469";"      FINSI"
"SCONTR";"S";"0470";"   FINSI"
"SCONTR";"S";"0471";"*"
"SCONTR";"S";"0472";"FINPROC"
"SCOPIE";"S";"0001";"**********************************************************************"
"SCOPIE";"S";"0002";"*"
"SCOPIE";"S";"0003";"* Règle : SCOPIE"
"SCOPIE";"S";"0004";"* Ordre : 2015"
"SCOPIE";"S";"0005";"* Titre : GCF : Copie des valeurs internes dans HJOU"
"SCOPIE";"S";"0006";"*"
"SCOPIE";"S";"0007";"*----------------------------------------------------------------------"
"SCOPIE";"S";"0008";"*"
"SCOPIE";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SCOPIE";"S";"0010";"* Date     : 03/10/2024"
"SCOPIE";"S";"0011";"*----------------------------------------------------------------------"
"SCOPIE";"S";"0012";"*"
"SCOPIE";"S";"0013";"*"
"SCOPIE";"S";"0014";"* Rôle :"
"SCOPIE";"S";"0015";"*"
"SCOPIE";"S";"0016";"* Copie des valeurs internes dans HJOU + Alimentation indicateur PIXID"
"SCOPIE";"S";"0017";"*"
"SCOPIE";"S";"0018";"*----------------------------------------------------------------------"
"SCOPIE";"S";"0019";"*"
"SCOPIE";"S";"0020";"* Modifiée par : Méthodes et outils"
"SCOPIE";"S";"0021";"* Date         : 30/06/2020"
"SCOPIE";"S";"0022";"* Objet        : Le taux du temps travail étant dans CTR et dans JOU, celui"
"SCOPIE";"S";"0023";"*                 de CTR est désormais copié dans celui de JOU"
"SCOPIE";"S";"0024";"*"
"SCOPIE";"S";"0025";"***********************************************************************"
"SCOPIE";"S";"0026";"*"
"SCOPIE";"S";"0027";"* Modifiée par : Méthodes et outils"
"SCOPIE";"S";"0028";"* Date         : 27/11/2020"
"SCOPIE";"S";"0029";"* Objet        : Alimentation du filtre Jour PIXID pour export RA (en commentaire)"
"SCOPIE";"S";"0030";"*"
"SCOPIE";"S";"0031";"***********************************************************************"
"SCOPIE";"S";"0032";"* Implémentation des données industrielles"
"SCOPIE";"S";"0033";"*"
"SCOPIE";"S";"0034";"DEBDICO"
"SCOPIE";"S";"0035";"   HJOU_IJQNBADGEA;O;N2;I;0;10;    56789;;;V2;""Nombre de badgeages"";"
"SCOPIE";"S";"0036";"   HJOU_IJQPRESBAJ;N;T6,2;I;;;    56789;;;V2;""Présence badgée"";"
"SCOPIE";"S";"0037";"   HJOU_IJQHNUITBA;N;T6,2;I;;;    56789;;;V2;""Heures de nuit"";"
"SCOPIE";"S";"0038";"   *"
"SCOPIE";"S";"0039";"   * Spécifique"
"SCOPIE";"S";"0040";"   CTRA_SCISOCIETE;O;A2;X;;;123456789;L;;C2;""Code société"";"
"SCOPIE";"S";"0041";"   *"
"SCOPIE";"S";"0042";"   * Données pour export RA PIXID"
"SCOPIE";"S";"0043";"   * EMPL_IEIMATRI;O;A10;X;;;789;;;C2;MATRICULE PIXID;"
"SCOPIE";"S";"0044";"   * HJOU_IJIPIXID;O;Z1;X;;;789;L;;C0;FILTRE JOUR EXPORT PIXID;"
"SCOPIE";"S";"0045";"   *"
"SCOPIE";"S";"0046";"FINDICO"
"SCOPIE";"S";"0047";"*"
"SCOPIE";"S";"0048";"* Déclaration des donnees locales"
"SCOPIE";"S";"0049";"*"
"SCOPIE";"S";"0050";"* recopie des valeurs internes dans le domaine HJOU"
"SCOPIE";"S";"0051";"* sont récupérés :"
"SCOPIE";"S";"0052";"*   _ le nombre de mouvements d'une personne : HJNPOIN"
"SCOPIE";"S";"0053";"*   _ le temps badg? (y compris les heures de nuit) : HJPOIN"
"SCOPIE";"S";"0054";"*   _ le temps effectu? de nuit : HJNUIT"
"SCOPIE";"S";"0055";"*"
"SCOPIE";"S";"0056";"SI HJOU_DATE <= TEMP_DATJOU"
"SCOPIE";"S";"0057";"   HJOU_IJQNBADGEA = TEMP_NXPOIN"
"SCOPIE";"S";"0058";"   HJOU_IJQPRESBAJ = TEMP_HXPOIN"
"SCOPIE";"S";"0059";"   HJOU_IJQHNUITBA = TEMP_HXNUIT"
"SCOPIE";"S";"0060";"*"
"SCOPIE";"S";"0061";"FINSI"
"SCOPIE";"S";"0062";"*"
"SCOPIE";"S";"0063";"HJOU_IJITYPCTRA = CTRA_ICITAUX"
"SCOPIE";"S";"0064";"*"
"SCOPIE";"S";"0065";"FIN"
"SCOPIE3";"S";"0001";"**********************************************************************"
"SCOPIE3";"S";"0002";"*"
"SCOPIE3";"S";"0003";"* Règle : SCOPIE"
