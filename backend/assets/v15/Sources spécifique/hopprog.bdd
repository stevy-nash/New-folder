"ITELETRAV";"S";"0037";"*"
"ITELETRAV";"S";"0038";"*Le Motif/ consigne de la famille TT affiche le salarié en télétravail"
"ITELETRAV";"S";"0039";"* sur la journée"
"ITELETRAV";"S";"0040";"POUR ACTIVITES"
"ITELETRAV";"S";"0041";"   SI MOTI_FAMILLE = ""TT"""
"ITELETRAV";"S";"0042";"      SI HABS_VALORIS = ""J"""
"ITELETRAV";"S";"0043";"         HJOU_IJQTT = 1"
"ITELETRAV";"S";"0044";"      SINON"
"ITELETRAV";"S";"0045";"         HJOU_IJQTT = HJOU_IJQTT + 0,5"
"ITELETRAV";"S";"0046";"      FINSI"
"ITELETRAV";"S";"0047";"   FINSI"
"ITELETRAV";"S";"0048";"FINPOUR"
"ITELETRAV";"S";"0049";"FIN"
