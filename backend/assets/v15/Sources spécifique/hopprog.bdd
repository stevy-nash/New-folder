"ICONSCONG";"S";"0538";"           LOCA_PRIS = HABS_MOTINBR + HJOU_IJRCCOPRIN"
"ICONSCONG";"S";"0539";"           LOCA_TRANS = LOCA_PRIS - HJOU_IJRCCOPRIN"
