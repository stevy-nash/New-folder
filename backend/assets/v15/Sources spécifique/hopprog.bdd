"SANALJ";"S";"0014";"*"
"SANALJ";"S";"0015";"*"
"SANALJ";"S";"0016";"* Rôle :  Analyse des journees"
"SANALJ";"S";"0017";"*"
"SANALJ";"S";"0018";"*"
"SANALJ";"S";"0019";"*----------------------------------------------------------------------"
"SANALJ";"S";"0020";"*"
"SANALJ";"S";"0021";"* Modifiée par :"
"SANALJ";"S";"0022";"* Date         :"
"SANALJ";"S";"0023";"* Objet        :"
"SANALJ";"S";"0024";"*"
"SANALJ";"S";"0025";"***********************************************************************"
"SANALJ";"S";"0026";"*"
"SANALJ";"S";"0027";"* Implémentation des données industrielles"
"SANALJ";"S";"0028";"*"
"SANALJ";"S";"0029";"DEBDICO"
"SANALJ";"S";"0030";"   HJOU_SJQPREJENC;O;T6,2;I;;;        9;;;V3;""Présence jour en cours (V3)"";"
"SANALJ";"S";"0031";"   HJOU_SJQPRELEND;O;T6,2;I;;;        9;;;V3;""Présence du lendemain (V3)"";"
"SANALJ";"S";"0032";"   HJOU_SJRPREVEIL;O;T6,2;I;;;        9;;SJQPRELEND;V3;""Présence de la veille"";"
"SANALJ";"S";"0033";"FINDICO"
"SANALJ";"S";"0034";"*"
"SANALJ";"S";"0035";"* Déclaration des donnees locales"
"SANALJ";"S";"0036";"*"
"SANALJ";"S";"0037";"*"
"SANALJ";"S";"0038";"DEF LOCA_MVE T6.2"
"SANALJ";"S";"0039";"LOCA_MVE = 0"
"SANALJ";"S";"0040";"DEF LOCA_MVS T6.2"
"SANALJ";"S";"0041";"LOCA_MVS = 0"
"SANALJ";"S";"0042";"DEF LOCA_DURJOUR T6.2"
"SANALJ";"S";"0043";"LOCA_DURJOUR = 0"
"SANALJ";"S";"0044";"DEF LOCA_DURVEIL T6.2"
"SANALJ";"S";"0045";"LOCA_DURVEIL = 0"
"SANALJ";"S";"0046";"DEF LOCA_DEBJOUR T6.2"
"SANALJ";"S";"0047";"LOCA_DEBJOUR = 0"
"SANALJ";"S";"0048";"DEF LOCA_FINJOUR T6.2"
"SANALJ";"S";"0049";"LOCA_FINJOUR = 24.00"
"SANALJ";"S";"0050";"DEF LOCA_DEBVEIL T6.2"
"SANALJ";"S";"0051";"LOCA_DEBVEIL = 24.00"
"SANALJ";"S";"0052";"DEF LOCA_FINVEIL T6.2"
"SANALJ";"S";"0053";"LOCA_FINVEIL = 36.00"
"SANALJ";"S";"0054";"*"
"SANALJ";"S";"0055";"SI HJOU_DATE <= TEMP_DATJOU"
"SANALJ";"S";"0056";"*"
"SANALJ";"S";"0057";"* Badgeant"
"SANALJ";"S";"0058";"   SI HJOU_IJIGBADGEA = ""1"""
"SANALJ";"S";"0059";"      HJOU_SJQPREJENC = HJOU_IJQPREJENC"
"SANALJ";"S";"0060";"      HJOU_SJQPRELEND = HJOU_IJQPRELEND"
"SANALJ";"S";"0061";"   SINON"
"SANALJ";"S";"0062";"* Non badgeant"
"SANALJ";"S";"0063";"*"
"SANALJ";"S";"0064";"* Mouvement 1"
"SANALJ";"S";"0065";"      LOCA_MVE = HJOU_SJQHTENT1"
"SANALJ";"S";"0066";"      LOCA_MVS = HJOU_SJQHTSOR1"
"SANALJ";"S";"0067";"      FAIRE CALC1"
"SANALJ";"S";"0068";"      LOCA_MVE = HJOU_SJQHTENT1"
"SANALJ";"S";"0069";"      LOCA_MVS = HJOU_SJQHTSOR1"
"SANALJ";"S";"0070";"      FAIRE CALC2"
"SANALJ";"S";"0071";"* Mouvement 2"
"SANALJ";"S";"0072";"      LOCA_MVE = HJOU_SJQHTENT2"
"SANALJ";"S";"0073";"      LOCA_MVS = HJOU_SJQHTSOR2"
"SANALJ";"S";"0074";"      FAIRE CALC1"
"SANALJ";"S";"0075";"      LOCA_MVE = HJOU_SJQHTENT2"
"SANALJ";"S";"0076";"      LOCA_MVS = HJOU_SJQHTSOR2"
"SANALJ";"S";"0077";"      FAIRE CALC2"
"SANALJ";"S";"0078";"* Mouvement 3"
"SANALJ";"S";"0079";"      LOCA_MVE = HJOU_SJQHTENT3"
"SANALJ";"S";"0080";"      LOCA_MVS = HJOU_SJQHTSOR3"
"SANALJ";"S";"0081";"      FAIRE CALC1"
"SANALJ";"S";"0082";"      LOCA_MVE = HJOU_SJQHTENT3"
"SANALJ";"S";"0083";"      LOCA_MVS = HJOU_SJQHTSOR3"
"SANALJ";"S";"0084";"      FAIRE CALC2"
"SANALJ";"S";"0085";"* Mouvement 4"
"SANALJ";"S";"0086";"      LOCA_MVE = HJOU_SJQHTENT4"
"SANALJ";"S";"0087";"      LOCA_MVS = HJOU_SJQHTSOR4"
"SANALJ";"S";"0088";"      FAIRE CALC1"
"SANALJ";"S";"0089";"      LOCA_MVE = HJOU_SJQHTENT4"
"SANALJ";"S";"0090";"      LOCA_MVS = HJOU_SJQHTSOR4"
"SANALJ";"S";"0091";"      FAIRE CALC2"
"SANALJ";"S";"0092";"* Mouvement 5"
"SANALJ";"S";"0093";"      LOCA_MVE = HJOU_SJQHTENT5"
"SANALJ";"S";"0094";"      LOCA_MVS = HJOU_SJQHTSOR5"
"SANALJ";"S";"0095";"      FAIRE CALC1"
"SANALJ";"S";"0096";"      LOCA_MVE = HJOU_SJQHTENT5"
"SANALJ";"S";"0097";"      LOCA_MVS = HJOU_SJQHTSOR5"
"SANALJ";"S";"0098";"      FAIRE CALC2"
"SANALJ";"S";"0099";"   FINSI"
"SANALJ";"S";"0100";"*"
"SANALJ";"S";"0101";"FINSI"
"SANALJ";"S";"0102";"*"
"SANALJ";"S";"0103";"FIN"
"SANALJ";"S";"0104";"*"
"SANALJ";"S";"0105";"****************************************************************************************************"
"SANALJ";"S";"0106";"***********                          PROCEDURE                                        **************"
"SANALJ";"S";"0107";"****************************************************************************************************"
"SANALJ";"S";"0108";"*"
"SANALJ";"S";"0109";"* Gestion des plages de dimanche pour plage dynamique"
"SANALJ";"S";"0110";"PROC CALC1"
"SANALJ";"S";"0111";"*"
"SANALJ";"S";"0112";"   LOCA_DURJOUR = 0"
"SANALJ";"S";"0113";"*"
"SANALJ";"S";"0114";"* Calcul des heures de la journée en cours"
"SANALJ";"S";"0115";"   SI LOCA_MVE < LOCA_DEBJOUR"
"SANALJ";"S";"0116";"      SI LOCA_MVS > LOCA_DEBJOUR"
"SANALJ";"S";"0117";"         LOCA_MVE = LOCA_DEBJOUR"
"SANALJ";"S";"0118";"      FINSI"
"SANALJ";"S";"0119";"   FINSI"
"SANALJ";"S";"0120";"*"
"SANALJ";"S";"0121";"   SI LOCA_MVS > LOCA_FINJOUR"
"SANALJ";"S";"0122";"      SI LOCA_MVE < LOCA_FINJOUR"
"SANALJ";"S";"0123";"         LOCA_MVS = LOCA_FINJOUR"
"SANALJ";"S";"0124";"      FINSI"
"SANALJ";"S";"0125";"   FINSI"
"SANALJ";"S";"0126";"*"
"SANALJ";"S";"0127";"   SI LOCA_MVE >= LOCA_DEBJOUR"
"SANALJ";"S";"0128";"      SI LOCA_MVS <= LOCA_FINJOUR"
"SANALJ";"S";"0129";"         LOCA_DURJOUR = LOCA_MVS - LOCA_MVE"
"SANALJ";"S";"0130";"      FINSI"
"SANALJ";"S";"0131";"   FINSI"
"SANALJ";"S";"0132";"*"
"SANALJ";"S";"0133";"   HJOU_SJQPREJENC = HJOU_SJQPREJENC + LOCA_DURJOUR"
"SANALJ";"S";"0134";"*"
"SANALJ";"S";"0135";"FINPROC"
"SANALJ";"S";"0136";"*"
"SANALJ";"S";"0137";"PROC CALC2"
"SANALJ";"S";"0138";"*"
"SANALJ";"S";"0139";"   LOCA_DURVEIL = 0"
"SANALJ";"S";"0140";"*"
"SANALJ";"S";"0141";"* Calcul des heures de la veille"
"SANALJ";"S";"0142";"   SI LOCA_MVE < LOCA_DEBVEIL"
"SANALJ";"S";"0143";"      SI LOCA_MVS > LOCA_DEBVEIL"
"SANALJ";"S";"0144";"         LOCA_MVE = LOCA_DEBVEIL"
"SANALJ";"S";"0145";"      FINSI"
"SANALJ";"S";"0146";"   FINSI"
"SANALJ";"S";"0147";"*"
"SANALJ";"S";"0148";"   SI LOCA_MVS > LOCA_FINVEIL"
"SANALJ";"S";"0149";"      SI LOCA_MVE < LOCA_FINVEIL"
"SANALJ";"S";"0150";"         LOCA_MVS = LOCA_FINVEIL"
"SANALJ";"S";"0151";"      FINSI"
"SANALJ";"S";"0152";"   FINSI"
"SANALJ";"S";"0153";"*"
"SANALJ";"S";"0154";"   SI LOCA_MVE >= LOCA_DEBVEIL"
"SANALJ";"S";"0155";"      SI LOCA_MVS <= LOCA_FINVEIL"
"SANALJ";"S";"0156";"         LOCA_DURVEIL = LOCA_MVS - LOCA_MVE"
"SANALJ";"S";"0157";"      FINSI"
"SANALJ";"S";"0158";"   FINSI"
"SANALJ";"S";"0159";"*"
"SANALJ";"S";"0160";"   HJOU_SJQPRELEND = HJOU_SJQPRELEND + LOCA_DURVEIL"
"SANALJ";"S";"0161";"*"
"SANALJ";"S";"0162";"FINPROC"
"SANOM";"S";"0001";"**********************************************************************"
