"SACQCPAN";"S";"0165";"* Supérieur à 25 ans"
"SACQCPAN";"S";"0166";"      SI LOCA_ANCA >= 25"
"SACQCPAN";"S";"0167";"         SI LOCA_ANCA < 30"
"SACQCPAN";"S";"0168";"            LOCA_DRANCT = LOCA_DRANCT + 5"
"SACQCPAN";"S";"0169";"         FINSI"
"SACQCPAN";"S";"0170";"      FINSI"
"SACQCPAN";"S";"0171";"* Supérieur à 30 ans"
"SACQCPAN";"S";"0172";"      SI LOCA_ANCA >= 30"
"SACQCPAN";"S";"0173";"         LOCA_DRANCT = LOCA_DRANCT + 6"
"SACQCPAN";"S";"0174";"      FINSI"
"SACQCPAN";"S";"0175";"*"
"SACQCPAN";"S";"0176";"* Maxi 6 jours >>"
