"SRCNUIT";"S";"0001";"**********************************************************************"
"SRCNUIT";"S";"0002";"*"
"SRCNUIT";"S";"0003";"* Règle : SRCNUIT"
"SRCNUIT";"S";"0004";"* Ordre : 8005"
"SRCNUIT";"S";"0005";"* Titre : GCF : Repos compensateur de nuit"
"SRCNUIT";"S";"0006";"*"
"SRCNUIT";"S";"0007";"*---------------------------------------------------------------------"
"SRCNUIT";"S";"0008";"*"
"SRCNUIT";"S";"0009";"* Créé par : Jérémy JACQUOT"
"SRCNUIT";"S";"0010";"* Date     : 09/09/2025"
"SRCNUIT";"S";"0011";"* Version  : 1"
"SRCNUIT";"S";"0012";"*"
"SRCNUIT";"S";"0013";"*---------------------------------------------------------------------"
"SRCNUIT";"S";"0014";"*"
"SRCNUIT";"S";"0015";"*"
"SRCNUIT";"S";"0016";"* Rôle :"
"SRCNUIT";"S";"0017";"*"
"SRCNUIT";"S";"0018";"* Gestion du RC de nuit pour Portage"
"SRCNUIT";"S";"0019";"*"
"SRCNUIT";"S";"0020";"*"
"SRCNUIT";"S";"0021";"*----------------------------------------------------------------------"
"SRCNUIT";"S";"0022";"*"
"SRCNUIT";"S";"0023";"* Modifiée par :"
"SRCNUIT";"S";"0024";"* Date         :"
"SRCNUIT";"S";"0025";"* Objet        :"
"SRCNUIT";"S";"0026";"*"
"SRCNUIT";"S";"0027";"***********************************************************************"
"SRCNUIT";"S";"0028";"*"
"SRCNUIT";"S";"0029";"*"
"SRCNUIT";"S";"0030";"* Implémentation des données industrielles"
"SRCNUIT";"S";"0031";"*"
"SRCNUIT";"S";"0032";"DEBDICO"
"SRCNUIT";"S";"0033";"   PARD_IDIREFRCN;O;A4;X;;;123456789;;;C3;""Date de référence RC de nuit (JJMM)"";"
"SRCNUIT";"S";"0034";"   HJOU_SJRSRCN;N;N6,2;I;;;    56789;;SJRSRCN;V3;""Solde du RC de nuit"";"
"SRCNUIT";"S";"0035";"   *"
"SRCNUIT";"S";"0036";"   EMPL_IEQSPDISP3;N;N6,2;L;;;     6789;;;V3;""Solde prév. RCN"";"
"SRCNUIT";"S";"0037";"FINDICO"
"SRCNUIT";"S";"0038";"*"
"SRCNUIT";"S";"0039";"*"
"SRCNUIT";"S";"0040";"DEBANO"
"SRCNUIT";"S";"0041";"   182;9;""Solde RC nuit insuffisant"";"
"SRCNUIT";"S";"0042";"FINANO"
"SRCNUIT";"S";"0043";"*"
"SRCNUIT";"S";"0044";"* Définition des variables locales"
"SRCNUIT";"S";"0045";"*"
"SRCNUIT";"S";"0046";"DEF LOCA_DROIT N2"
"SRCNUIT";"S";"0047";"LOCA_DROIT = 0"
"SRCNUIT";"S";"0048";"DEF LOCA_MOT N2"
"SRCNUIT";"S";"0049";"LOCA_MOT = 0"
"SRCNUIT";"S";"0050";"DEF LOCA_PRIS N6.2"
"SRCNUIT";"S";"0051";"LOCA_PRIS = 0"
"SRCNUIT";"S";"0052";"DEF LOCA_PRISW N6.2"
"SRCNUIT";"S";"0053";"LOCA_PRISW = 0"
"SRCNUIT";"S";"0054";"DEF LOCA_FERI N2"
"SRCNUIT";"S";"0055";"LOCA_FERI = 0"
"SRCNUIT";"S";"0056";"*"
"SRCNUIT";"S";"0057";"DEF LOCA_DATE D"
"SRCNUIT";"S";"0058";"LOCA_DATE(5:4) = ""0101"""
"SRCNUIT";"S";"0059";"DEF LOCA_DATEFU D"
"SRCNUIT";"S";"0060";"LOCA_DATEFU(5:4) = ""0101"""
"SRCNUIT";"S";"0061";"DEF LOCA_ANNEE N4"
"SRCNUIT";"S";"0062";"LOCA_ANNEE << TEMP_DATJOU(1:4)"
"SRCNUIT";"S";"0063";"LOCA_DATE(1:4) << LOCA_ANNEE"
"SRCNUIT";"S";"0064";"LOCA_ANNEE = LOCA_ANNEE + 1"
"SRCNUIT";"S";"0065";"LOCA_DATEFU(1:4) << LOCA_ANNEE"
"SRCNUIT";"S";"0066";"*"
"SRCNUIT";"S";"0067";"*"
"SRCNUIT";"S";"0068";"POUR ACTIVITES"
"SRCNUIT";"S";"0069";"   SI HABS_MOTIF = ""JF"""
"SRCNUIT";"S";"0070";"      LOCA_FERI = 1"
"SRCNUIT";"S";"0071";"   FINSI"
"SRCNUIT";"S";"0072";"FINPOUR"
"SRCNUIT";"S";"0073";"*"
"SRCNUIT";"S";"0074";"* RAZ compteurs début de période"
"SRCNUIT";"S";"0075";"SI HJOU_DATE(5:4) = LOCA_DATE(5:4)"
"SRCNUIT";"S";"0076";"   HJOU_SJRSRCN = 0"
"SRCNUIT";"S";"0077";"FINSI"
"SRCNUIT";"S";"0078";"*"
"SRCNUIT";"S";"0079";"* Définition qui à droit"
"SRCNUIT";"S";"0080";"* Société PO uniquement"
"SRCNUIT";"S";"0081";"SI HJOU_SJQSOCIETE = ""PO"""
"SRCNUIT";"S";"0082";"   LOCA_DROIT = 1"
"SRCNUIT";"S";"0083";"FINSI"
"SRCNUIT";"S";"0084";"*"
"SRCNUIT";"S";"0085";"***** Init du droit par consignes *****"
"SRCNUIT";"S";"0086";"*"
"SRCNUIT";"S";"0087";"POUR ACTIVITES"
"SRCNUIT";"S";"0088";"   SI HABS_MOTIF = ""ZRCNUIT"""
"SRCNUIT";"S";"0089";"      HJOU_SJRSRCN = HABS_MOTINBR"
"SRCNUIT";"S";"0090";"   FINSI"
"SRCNUIT";"S";"0091";"   SI HABS_MOTIF = ""XRCNUIT"""
"SRCNUIT";"S";"0092";"      HJOU_SJRSRCN = HJOU_SJRSRCN + HABS_MOTINBR"
"SRCNUIT";"S";"0093";"   FINSI"
"SRCNUIT";"S";"0094";"FINPOUR"
"SRCNUIT";"S";"0095";"*"
"SRCNUIT";"S";"0096";"****** Gestion de la consommation avec motif de récupération *****"
"SRCNUIT";"S";"0097";"*"
"SRCNUIT";"S";"0098";"POUR ACTIVITES"
"SRCNUIT";"S";"0099";"   SI HABS_MOTIF = ""RCN"""
"SRCNUIT";"S";"0100";"      LOCA_MOT = 1"
"SRCNUIT";"S";"0101";"      SI HJOU_IJQPRETHEJ > 0"
"SRCNUIT";"S";"0102";"*"
"SRCNUIT";"S";"0103";"         SI HABS_VALORIS = ""J"""
"SRCNUIT";"S";"0104";"            SI PROF_ABSENM = 0"
"SRCNUIT";"S";"0105";"            OU PROF_ABSENS = 0"
"SRCNUIT";"S";"0106";"               LOCA_PRIS = LOCA_PRIS + 0.5"
"SRCNUIT";"S";"0107";"            SINON"
"SRCNUIT";"S";"0108";"               LOCA_PRIS = LOCA_PRIS + 1"
"SRCNUIT";"S";"0109";"            FINSI"
"SRCNUIT";"S";"0110";"         SINON"
"SRCNUIT";"S";"0111";"            LOCA_PRIS = LOCA_PRIS + 0.5"
"SRCNUIT";"S";"0112";"         FINSI"
"SRCNUIT";"S";"0113";"*"
"SRCNUIT";"S";"0114";"      FINSI"
"SRCNUIT";"S";"0115";"   FINSI"
"SRCNUIT";"S";"0116";"FINPOUR"
"SRCNUIT";"S";"0117";"*"
"SRCNUIT";"S";"0118";"SI LOCA_PRIS > 1"
"SRCNUIT";"S";"0119";"   LOCA_PRIS = 1"
"SRCNUIT";"S";"0120";"FINSI"
"SRCNUIT";"S";"0121";"*"
"SRCNUIT";"S";"0122";"SI LOCA_PRIS > 0"
"SRCNUIT";"S";"0123";"   HJOU_SJRSRCN = HJOU_SJRSRCN - LOCA_PRIS"
"SRCNUIT";"S";"0124";"FINSI"
"SRCNUIT";"S";"0125";"*"
"SRCNUIT";"S";"0126";"***** DEB : Gestion du pris en attente >>"
"SRCNUIT";"S";"0127";"*"
"SRCNUIT";"S";"0128";"POUR WACTIVITES"
"SRCNUIT";"S";"0129";"   SI WABS_ANNUL = ""0"""
"SRCNUIT";"S";"0130";"      SI LOCA_FERI <> 1"
"SRCNUIT";"S";"0131";"         SI HJOU_IJQPRETHEJ > 0.00"
"SRCNUIT";"S";"0132";"*"
"SRCNUIT";"S";"0133";"            SI WABS_MOTIF = ""RCN"""
"SRCNUIT";"S";"0134";"* Gestion de la valorisation >>"
"SRCNUIT";"S";"0135";"               SI WABS_VALORIS = ""J"""
"SRCNUIT";"S";"0136";"                  SI PROF_ABSENM = 0"
"SRCNUIT";"S";"0137";"                  OU PROF_ABSENS = 0"
"SRCNUIT";"S";"0138";"                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SRCNUIT";"S";"0139";"                  SINON"
"SRCNUIT";"S";"0140";"                     LOCA_PRISW = 1"
"SRCNUIT";"S";"0141";"                  FINSI"
"SRCNUIT";"S";"0142";"               SINON"
"SRCNUIT";"S";"0143";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SRCNUIT";"S";"0144";"               FINSI"
"SRCNUIT";"S";"0145";"            FINSI"
"SRCNUIT";"S";"0146";"         FINSI"
"SRCNUIT";"S";"0147";"      FINSI"
"SRCNUIT";"S";"0148";"   FINSI"
"SRCNUIT";"S";"0149";"FINPOUR"
"SRCNUIT";"S";"0150";"*"
"SRCNUIT";"S";"0151";"SI LOCA_PRISW > 1"
"SRCNUIT";"S";"0152";"   LOCA_PRISW = 1"
"SRCNUIT";"S";"0153";"FINSI"
"SRCNUIT";"S";"0154";"*"
"SRCNUIT";"S";"0155";"***** Gestion des anomalies >>"
"SRCNUIT";"S";"0156";"*"
"SRCNUIT";"S";"0157";"SI LOCA_MOT = 1"
"SRCNUIT";"S";"0158";"* Si droit ?"
"SRCNUIT";"S";"0159";"   SI LOCA_DROIT <> 1"
"SRCNUIT";"S";"0160";"      ANOMALIE 319"
"SRCNUIT";"S";"0161";"      SI TEMP_CNMOTIF = ""RCN"""
"SRCNUIT";"S";"0162";"         TEMP_CNRETOUR = 2"
"SRCNUIT";"S";"0163";"         TEMP_CNMESS = 319"
"SRCNUIT";"S";"0164";"      FINSI"
"SRCNUIT";"S";"0165";"   FINSI"
"SRCNUIT";"S";"0166";"* Si solde négatif ?"
"SRCNUIT";"S";"0167";"   SI HJOU_SJRSRCN < 0"
"SRCNUIT";"S";"0168";"      ANOMALIE 182"
"SRCNUIT";"S";"0169";"      SI TEMP_CNMOTIF = ""RCN"""
"SRCNUIT";"S";"0170";"         TEMP_CNRETOUR = 2"
"SRCNUIT";"S";"0171";"         TEMP_CNMESS = 182"
"SRCNUIT";"S";"0172";"      FINSI"
"SRCNUIT";"S";"0173";"   FINSI"
"SRCNUIT";"S";"0174";"*"
"SRCNUIT";"S";"0175";"FINSI"
"SRCNUIT";"S";"0176";"*"
"SRCNUIT";"S";"0177";"***** Solde prévisionnel >>"
"SRCNUIT";"S";"0178";"*"
"SRCNUIT";"S";"0179";"SI CTRA_DATFIN > TEMP_DATJOU"
"SRCNUIT";"S";"0180";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SRCNUIT";"S";"0181";"      SI HJOU_SJQFINC = 1"
"SRCNUIT";"S";"0182";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SRCNUIT";"S";"0183";"         LOCA_DATEFU = TEMP_DXFINPER"
"SRCNUIT";"S";"0184";"      FINSI"
"SRCNUIT";"S";"0185";"   FINSI"
"SRCNUIT";"S";"0186";"FINSI"
"SRCNUIT";"S";"0187";"*"
"SRCNUIT";"S";"0188";"SI TEMP_DATSUI = LOCA_DATEFU"
"SRCNUIT";"S";"0189";"* JJA - 13/06/2025 - Pris prèv."
"SRCNUIT";"S";"0190";"   EMPL_IEQSPDISP3 = HJOU_SJRSRCN"
"SRCNUIT";"S";"0191";"FINSI"
"SRCNUIT";"S";"0192";"*"
"SRCNUIT";"S";"0193";"FIN"
