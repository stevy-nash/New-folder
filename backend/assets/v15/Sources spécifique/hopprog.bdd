"ICONSCONG";"S";"0617";"** Calcul maintien CP samedi"
"ICONSCONG";"S";"0618";"**"
"ICONSCONG";"S";"0619";"**"
"ICONSCONG";"S";"0620";"   SI PARD_IDINBRSAMD > 0"
"ICONSCONG";"S";"0621";"     SI HJOU_JOUR = ""6"""
"ICONSCONG";"S";"0622";"        POUR ACTIVITES"
"ICONSCONG";"S";"0623";"           SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0624";"           OU HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCONG";"S";"0625";"           OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCONG";"S";"0626";"              SI HABS_VALORIS = ""J"""
"ICONSCONG";"S";"0627";"                 LOCA_NBCPSAM = LOCA_NBCPSAM + 1"
"ICONSCONG";"S";"0628";"              FINSI"
"ICONSCONG";"S";"0629";"              *"
"ICONSCONG";"S";"0630";"              SI HABS_VALORIS = ""M"""
"ICONSCONG";"S";"0631";"                 LOCA_NBCPSAM = LOCA_NBCPSAM + 0.5"
"ICONSCONG";"S";"0632";"              FINSI"
"ICONSCONG";"S";"0633";"              *"
"ICONSCONG";"S";"0634";"              SI HABS_VALORIS = ""A"""
"ICONSCONG";"S";"0635";"                 LOCA_NBCPSAM = LOCA_NBCPSAM + 0.5"
"ICONSCONG";"S";"0636";"              FINSI"
"ICONSCONG";"S";"0637";"           FINSI"
"ICONSCONG";"S";"0638";"        FINPOUR"
"ICONSCONG";"S";"0639";"        *"
"ICONSCONG";"S";"0640";"        SI LOCA_NBCPSAM > 0"
"ICONSCONG";"S";"0641";"            SI LOCA_NBCPSAM > 1"
"ICONSCONG";"S";"0642";"                LOCA_NBCPSAM = 1"
"ICONSCONG";"S";"0643";"            FINSI"
"ICONSCONG";"S";"0644";"            *"
"ICONSCONG";"S";"0645";"            HJOU_IJRNBCPSAM = HJOU_IJRNBCPSAM + LOCA_NBCPSAM"
"ICONSCONG";"S";"0646";"        FINSI"
"ICONSCONG";"S";"0647";"     FINSI"
"ICONSCONG";"S";"0648";"   FINSI"
"ICONSCONG";"S";"0649";"** Initialisation du compteur de samedi CP par consigne"
"ICONSCONG";"S";"0650";"      POUR ACTIVITES"
"ICONSCONG";"S";"0651";"         SI HABS_MOTIF = ""ZCPSAM"""
"ICONSCONG";"S";"0652";"            HJOU_IJRNBCPSAM = HABS_MOTINBR"
"ICONSCONG";"S";"0653";"         FINSI"
"ICONSCONG";"S";"0654";"         SI HABS_MOTIF = ""XCPSAM"""
"ICONSCONG";"S";"0655";"            HJOU_IJRNBCPSAM = HJOU_IJRNBCPSAM + HABS_MOTINBR"
"ICONSCONG";"S";"0656";"         FINSI"
