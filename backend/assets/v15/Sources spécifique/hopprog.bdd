"SANOM";"S";"0387";"   FINPOUR"
"SANOM";"S";"0388";"FINSI"
"SANOM";"S";"0389";"*"
"SANOM";"S";"0390";"* Gestion affichage jour travaillé"
"SANOM";"S";"0391";"*"
"SANOM";"S";"0392";"DEF LOCA_ABSJ N2"
"SANOM";"S";"0393";"LOCA_ABSJ = 0"
"SANOM";"S";"0394";"DEF LOCA_ABSM N2"
