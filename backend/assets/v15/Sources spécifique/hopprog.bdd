"SHSUPPDIM";"S";"0408";"*"
"SHSUPPDIM";"S";"0409";"POUR ACTIVITES"
"SHSUPPDIM";"S";"0410";"*"
"SHSUPPDIM";"S";"0411";"* JJA - 03/10/2025 - FFT025006452 : Identification des HS faites de nuit >>"
"SHSUPPDIM";"S";"0412";"   SI MOTI_MOTYPE = ""C"""
"SHSUPPDIM";"S";"0413";"      SI HABS_VALORIS = ""H"""
"SHSUPPDIM";"S";"0414";"         SI HABS_MOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM";"S";"0415";"         OU HABS_MOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM";"S";"0416";"            LOCA_MOTE = HABS_HRADEB"
"SHSUPPDIM";"S";"0417";"            LOCA_MOTS = HABS_HRAFIN"
"SHSUPPDIM";"S";"0418";"            FAIRE CALCHSN"
"SHSUPPDIM";"S";"0419";"            LOCA_HSUPNUIT = LOCA_HSUPNUIT + LOCA_HSNUIT"
"SHSUPPDIM";"S";"0420";"         FINSI"
"SHSUPPDIM";"S";"0421";"      FINSI"
"SHSUPPDIM";"S";"0422";"   FINSI"
"SHSUPPDIM";"S";"0423";"* JJA - 03/10/2025 - FFT025006452 <<"
"SHSUPPDIM";"S";"0424";"*"
"SHSUPPDIM";"S";"0425";"   SI HABS_MOTIF = PARD_SDIVMHSUP"
"SHSUPPDIM";"S";"0426";"      HJOU_SJRHSPAIE = HJOU_SJRHSPAIE + HABS_MOTIDUR"
"SHSUPPDIM";"S";"0427";"   FINSI"
"SHSUPPDIM";"S";"0428";"   SI HABS_MOTIF = PARD_SDIVMHSUPR"
"SHSUPPDIM";"S";"0429";"      HJOU_SJRHSRECUP = HJOU_SJRHSRECUP + HABS_MOTIDUR"
"SHSUPPDIM";"S";"0430";"   FINSI"
"SHSUPPDIM";"S";"0431";"   SI HABS_MOTIF = PARD_SDIVMINTA"
"SHSUPPDIM";"S";"0432";"      LOCA_INTAST = LOCA_INTAST + HABS_MOTIDUR"
"SHSUPPDIM";"S";"0433";"   FINSI"
"SHSUPPDIM";"S";"0434";"FINPOUR"
"SHSUPPDIM";"S";"0435";"*"
"SHSUPPDIM";"S";"0436";"* Supprime chevauchement HS"
"SHSUPPDIM";"S";"0437";"HJOU_SJRHSPAIE = HJOU_SJRHSPAIE - TEMP_STCHEHS"
"SHSUPPDIM";"S";"0438";"HJOU_SJRHSRECUP = HJOU_SJRHSRECUP - TEMP_STCHEHS"
"SHSUPPDIM";"S";"0439";"LOCA_INTAST = LOCA_INTAST - TEMP_STCHEVTTE"
"SHSUPPDIM";"S";"0440";"*"
"SHSUPPDIM";"S";"0441";"SI HJOU_SJRHSPAIE < 0"
"SHSUPPDIM";"S";"0442";"   HJOU_SJRHSPAIE = 0"
"SHSUPPDIM";"S";"0443";"FINSI"
"SHSUPPDIM";"S";"0444";"SI HJOU_SJRHSRECUP < 0"
"SHSUPPDIM";"S";"0445";"   HJOU_SJRHSRECUP = 0"
"SHSUPPDIM";"S";"0446";"FINSI"
"SHSUPPDIM";"S";"0447";"SI LOCA_INTAST < 0"
"SHSUPPDIM";"S";"0448";"   LOCA_INTAST = 0"
"SHSUPPDIM";"S";"0449";"FINSI"
"SHSUPPDIM";"S";"0450";"*"
"SHSUPPDIM";"S";"0451";"***** Gestion des cas particuliers par métiers >> **************************************************"
"SHSUPPDIM";"S";"0452";"*"
"SHSUPPDIM";"S";"0453";"SI LOCA_DROIT = 1"
"SHSUPPDIM";"S";"0454";"* Si TP ?"
"SHSUPPDIM";"S";"0455";"   SI HJOU_IJITYPCTRA < 100"
"SHSUPPDIM";"S";"0456";"      SI HJOU_IJITYPCTRA > 0"
"SHSUPPDIM";"S";"0457";"* Support ?"
"SHSUPPDIM";"S";"0458";"         SI HJOU_SJITYPSERV = ""SUPPORT"""
"SHSUPPDIM";"S";"0459";"         OU HJOU_SJQSOCIETE = ""PO"""
"SHSUPPDIM";"S";"0460";"* Calcul des HC = Oui"
"SHSUPPDIM";"S";"0461";"            LOCA_CALCHC = 1"
"SHSUPPDIM";"S";"0462";"         FINSI"
"SHSUPPDIM";"S";"0463";"      FINSI"
"SHSUPPDIM";"S";"0464";"   FINSI"
