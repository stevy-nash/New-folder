"IDISPJC";"S";"0063";"DEF LOCA_ACOURS N4"
"IDISPJC";"S";"0064";"LOCA_ACOURS = 0"
"IDISPJC";"S";"0065";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0066";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISP3,"
"IDISPJC";"S";"0067";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJC";"S";"0068";"* par la date souhaitée"
"IDISPJC";"S";"0069";"*"
"IDISPJC";"S";"0070";"** alimentation du droit à la date de référence"
"IDISPJC";"S";"0071";"** raz du consommé à la date de référence"
"IDISPJC";"S";"0072";"SI HJOU_DATE = PARD_IDIDRDISP3"
"IDISPJC";"S";"0073";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0074";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPJC";"S";"0075";"   * par le nombre paramétré dans PARD_IDIVDDISP3,"
"IDISPJC";"S";"0076";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJC";"S";"0077";"   * par le nombre souhaité"
"IDISPJC";"S";"0078";"   HJOU_IJRDJDISP3 = PARD_IDIVDDISP3"
"IDISPJC";"S";"0079";"   HJOU_IJRCJDISP3 = 0"
"IDISPJC";"S";"0080";"FINSI"
"IDISPJC";"S";"0081";"** alimentation du pris"
"IDISPJC";"S";"0082";"POUR ACTIVITES"
"IDISPJC";"S";"0083";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0084";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISP3,"
"IDISPJC";"S";"0085";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPJC";"S";"0086";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPJC";"S";"0087";"   * pas il devra être créé)"
"IDISPJC";"S";"0088";"   SI HABS_MOTIF = PARD_IDIVMDISP3"
"IDISPJC";"S";"0089";"      SI HABS_MOTIDUR > 0"
"IDISPJC";"S";"0090";"         SI HABS_VALORIS = ""J"""
"IDISPJC";"S";"0091";"            LOCA_VAL = 1"
"IDISPJC";"S";"0092";"         SINON"
"IDISPJC";"S";"0093";"            LOCA_VAL = 0.5"
"IDISPJC";"S";"0094";"         FINSI"
"IDISPJC";"S";"0095";"      FINSI"
"IDISPJC";"S";"0096";"      HJOU_IJRCJDISP3 = HJOU_IJRCJDISP3 + LOCA_VAL"
"IDISPJC";"S";"0097";"      LOCA_VAL = 0"
"IDISPJC";"S";"0098";"   FINSI"
"IDISPJC";"S";"0099";"FINPOUR"
"IDISPJC";"S";"0100";"** alimentation du droit/pris par consignes"
"IDISPJC";"S";"0101";"POUR ACTIVITES"
"IDISPJC";"S";"0102";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJC";"S";"0103";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPJC";"S";"0104";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPJC";"S";"0105";"   * en conséquence)"
"IDISPJC";"S";"0106";"   SI HABS_MOTIF = ""ZDDIS3"""
"IDISPJC";"S";"0107";"      HJOU_IJRDJDISP3 = HABS_MOTINBR"
"IDISPJC";"S";"0108";"   FINSI"
"IDISPJC";"S";"0109";"   SI HABS_MOTIF = ""XDDIS3"""
"IDISPJC";"S";"0110";"      HJOU_IJRDJDISP3 = HJOU_IJRDJDISP3 + HABS_MOTINBR"
"IDISPJC";"S";"0111";"   FINSI"
"IDISPJC";"S";"0112";"   SI HABS_MOTIF = ""ZCDIS3"""
"IDISPJC";"S";"0113";"      HJOU_IJRCJDISP3 = HABS_MOTINBR"
"IDISPJC";"S";"0114";"   FINSI"
"IDISPJC";"S";"0115";"   SI HABS_MOTIF = ""XCDIS3"""
"IDISPJC";"S";"0116";"      HJOU_IJRCJDISP3 = HJOU_IJRCJDISP3 + HABS_MOTINBR"
"IDISPJC";"S";"0117";"   FINSI"
"IDISPJC";"S";"0118";"FINPOUR"
"IDISPJC";"S";"0119";"** calcul du solde"
"IDISPJC";"S";"0120";"HJOU_IJRSJDISP3 = HJOU_IJRDJDISP3 - HJOU_IJRCJDISP3"
"IDISPJC";"S";"0121";"LOCA_ACOURS << PARD_IDIDRDISP3(1:4)"
"IDISPJC";"S";"0122";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPJC";"S";"0123";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPJC";"S";"0124";"LOCA_DATE(5:4) = PARD_IDIDRDISP3(5:4)"
"IDISPJC";"S";"0125";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPJC";"S";"0126";"   EMPL_IEQSPDISP3 = HJOU_IJRSJDISP3"
"IDISPJC";"S";"0127";"FINSI"
"IDISPJC";"S";"0128";"FIN"
"IDISPJD";"S";"0001";"***********************************************************************"
"IDISPJD";"S";"0002";"*"
"IDISPJD";"S";"0003";"* Règle : IDISPJD"
"IDISPJD";"S";"0004";"* Ordre : 7030"
"IDISPJD";"S";"0005";"* Titre : Compteurs disponible 4 en jour"
"IDISPJD";"S";"0006";"*"
"IDISPJD";"S";"0007";"*----------------------------------------------------------------------"
"IDISPJD";"S";"0008";"*"
"IDISPJD";"S";"0009";"* Créé par : Cellule Industrialisation"
"IDISPJD";"S";"0010";"* Date     : 03/09/2009"
"IDISPJD";"S";"0011";"* Version  : 1"
"IDISPJD";"S";"0012";"*"
"IDISPJD";"S";"0013";"*---------------------------------------------------------------------"
"IDISPJD";"S";"0014";"*"
"IDISPJD";"S";"0015";"*"
"IDISPJD";"S";"0016";"* Rôle : Mettre à disposition une règle gérant des compteurs droit/pris/solde"
"IDISPJD";"S";"0017";"*         Mais également des compteurs afin de ne pas avoir à en"
"IDISPJD";"S";"0018";"*         créer de nouveaux et lancer une perso (ex: client en prod,...)"
"IDISPJD";"S";"0019";"*"
"IDISPJD";"S";"0020";"*         Par défaut les différents compteurs ne sont pas affichés"
"IDISPJD";"S";"0021";"*         s'il y a besoin cela devra être fait via la fonction PER"
"IDISPJD";"S";"0022";"*         Les consignes ainsi que le motif de consommation sont à"
"IDISPJD";"S";"0023";"*         créer via la fonction ACT"
"IDISPJD";"S";"0024";"*"
"IDISPJD";"S";"0025";"*"
"IDISPJD";"S";"0026";"* Gestion du Droit/Pris/solde d'un compteur en jour"
"IDISPJD";"S";"0027";"* Le droit est alimenté en début de période de référence définie"
"IDISPJD";"S";"0028";"* dans les données globales datées par une valeur définie dans les"
"IDISPJD";"S";"0029";"* données globales datées"
"IDISPJD";"S";"0030";"* le pris est alimenté par un motif alimenté dans les données globales"
"IDISPJD";"S";"0031";"* datées"
"IDISPJD";"S";"0032";"* Pas de gestion d'anomalie en cas de solde négatif (à créer si besoin)"
"IDISPJD";"S";"0033";"*"
"IDISPJD";"S";"0034";"*----------------------------------------------------------------------"
"IDISPJD";"S";"0035";"*"
"IDISPJD";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPJD";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPJD";"S";"0038";"* Objet        :"
"IDISPJD";"S";"0039";"*"
"IDISPJD";"S";"0040";"***********************************************************************"
"IDISPJD";"S";"0041";"*"
"IDISPJD";"S";"0042";"* Implémentation des données industrielles"
"IDISPJD";"S";"0043";"*"
"IDISPJD";"S";"0044";"DEBDICO"
"IDISPJD";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJD";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPJD";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPJD";"S";"0048";"   * en passant par la fonction PER"
"IDISPJD";"S";"0049";"   HJOU_IJRDJDISP4;N;N6,2;L;;;    56789;;IJRDJDISP4;V3;""Droit en jour disponible 4"";"
"IDISPJD";"S";"0050";"   HJOU_IJRCJDISP4;N;N6,2;L;;;    56789;;IJRCJDISP4;V3;""Pris en jour disponible 4"";"
"IDISPJD";"S";"0051";"   HJOU_IJRSJDISP4;N;N6,2;L;;;    56789;;IJRSJDISP4;V3;""Solde en jour disponible 4"";"
"IDISPJD";"S";"0052";"   EMPL_IEQSPDISP4;N;N6,2;L;;;     6789;;;V3;""Solde prévisionnel en jour disponible 4"";"
"IDISPJD";"S";"0053";"PARD_IDIDRDISP4;O;D10;X;;;123456789;;;C3;""Date RAZ compteur jour disponible 4"";"
"IDISPJD";"S";"0054";"PARD_IDIVDDISP4;O;N6,2;I;;;123456789;;;C3;""Valeur droit jour compteur disponible  4"";"
"IDISPJD";"S";"0055";"PARD_IDIVMDISP4;O;A10;X;;;123456789;II;;C2;""Motif compteur en jour disponible 4"";"
"IDISPJD";"S";"0056";"FINDICO"
"IDISPJD";"S";"0057";"*"
"IDISPJD";"S";"0058";"* Déclaration des donnees locales"
"IDISPJD";"S";"0059";"*"
"IDISPJD";"S";"0060";"DEF LOCA_VAL N2.1"
"IDISPJD";"S";"0061";"DEF LOCA_DATE D"
"IDISPJD";"S";"0062";"LOCA_DATE = "" """
"IDISPJD";"S";"0063";"DEF LOCA_ACOURS N4"
"IDISPJD";"S";"0064";"LOCA_ACOURS = 0"
"IDISPJD";"S";"0065";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPJD";"S";"0066";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISP4,"
"IDISPJD";"S";"0067";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJD";"S";"0068";"* par la date souhaitée"
"IDISPJD";"S";"0069";"*"
"IDISPJD";"S";"0070";"** alimentation du droit à la date de référence"
"IDISPJD";"S";"0071";"** raz du consommé à la date de référence"
"IDISPJD";"S";"0072";"SI HJOU_DATE = PARD_IDIDRDISP4"
"IDISPJD";"S";"0073";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJD";"S";"0074";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPJD";"S";"0075";"   * par le nombre paramétré dans PARD_IDIVDDISP4,"
"IDISPJD";"S";"0076";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPJD";"S";"0077";"   * par le nombre souhaité"
"IDISPJD";"S";"0078";"   HJOU_IJRDJDISP4 = PARD_IDIVDDISP4"
"IDISPJD";"S";"0079";"   HJOU_IJRCJDISP4 = 0"
"IDISPJD";"S";"0080";"FINSI"
"IDISPJD";"S";"0081";"** alimentation du pris"
"IDISPJD";"S";"0082";"POUR ACTIVITES"
"IDISPJD";"S";"0083";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJD";"S";"0084";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISP4,"
"IDISPJD";"S";"0085";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPJD";"S";"0086";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPJD";"S";"0087";"   * pas il devra être créé)"
"IDISPJD";"S";"0088";"   SI HABS_MOTIF = PARD_IDIVMDISP4"
"IDISPJD";"S";"0089";"      SI HABS_MOTIDUR > 0"
"IDISPJD";"S";"0090";"         SI HABS_VALORIS = ""J"""
"IDISPJD";"S";"0091";"            LOCA_VAL = 1"
"IDISPJD";"S";"0092";"         SINON"
"IDISPJD";"S";"0093";"            LOCA_VAL = 0.5"
"IDISPJD";"S";"0094";"         FINSI"
"IDISPJD";"S";"0095";"      FINSI"
"IDISPJD";"S";"0096";"      HJOU_IJRCJDISP4 = HJOU_IJRCJDISP4 + LOCA_VAL"
"IDISPJD";"S";"0097";"      LOCA_VAL = 0"
"IDISPJD";"S";"0098";"   FINSI"
"IDISPJD";"S";"0099";"FINPOUR"
"IDISPJD";"S";"0100";"** alimentation du droit/pris par consignes"
"IDISPJD";"S";"0101";"POUR ACTIVITES"
"IDISPJD";"S";"0102";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPJD";"S";"0103";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPJD";"S";"0104";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPJD";"S";"0105";"   * en conséquence)"
"IDISPJD";"S";"0106";"   SI HABS_MOTIF = ""ZDDIS4"""
"IDISPJD";"S";"0107";"      HJOU_IJRDJDISP4 = HABS_MOTINBR"
"IDISPJD";"S";"0108";"   FINSI"
"IDISPJD";"S";"0109";"   SI HABS_MOTIF = ""XDDIS4"""
"IDISPJD";"S";"0110";"      HJOU_IJRDJDISP4 = HJOU_IJRDJDISP4 + HABS_MOTINBR"
"IDISPJD";"S";"0111";"   FINSI"
"IDISPJD";"S";"0112";"   SI HABS_MOTIF = ""ZCDIS4"""
"IDISPJD";"S";"0113";"      HJOU_IJRCJDISP4 = HABS_MOTINBR"
"IDISPJD";"S";"0114";"   FINSI"
"IDISPJD";"S";"0115";"   SI HABS_MOTIF = ""XCDIS4"""
"IDISPJD";"S";"0116";"      HJOU_IJRCJDISP4 = HJOU_IJRCJDISP4 + HABS_MOTINBR"
"IDISPJD";"S";"0117";"   FINSI"
"IDISPJD";"S";"0118";"FINPOUR"
"IDISPJD";"S";"0119";"** calcul du solde"
"IDISPJD";"S";"0120";"HJOU_IJRSJDISP4 = HJOU_IJRDJDISP4 - HJOU_IJRCJDISP4"
"IDISPJD";"S";"0121";"LOCA_ACOURS << PARD_IDIDRDISP4(1:4)"
"IDISPJD";"S";"0122";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPJD";"S";"0123";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPJD";"S";"0124";"LOCA_DATE(5:4) = PARD_IDIDRDISP4(5:4)"
"IDISPJD";"S";"0125";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPJD";"S";"0126";"   EMPL_IEQSPDISP4 = HJOU_IJRSJDISP4"
"IDISPJD";"S";"0127";"FINSI"
"IDISPJD";"S";"0128";"FIN"
"IDISPJE";"S";"0001";"***********************************************************************"
