"ICPTPLANIF";"S";"0120";"   *HJOU_IJQBCTVAR;O;T6,2;I;;;123456789;;;C0;""Cible hebdo des semaines type variation"";"
"ICPTPLANIF";"S";"0121";"   *CTRA_ICITYPTRAN;O;A1;X;;;123456789;L;;C2;""Type de transfert"";"
