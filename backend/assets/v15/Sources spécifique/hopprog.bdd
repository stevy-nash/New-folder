"IECRET";"S";"0016";"* Rôle : Ecretement journalier"
"IECRET";"S";"0017";"*"
"IECRET";"S";"0018";"*"
"IECRET";"S";"0019";"*"
"IECRET";"S";"0020";"*"
"IECRET";"S";"0021";"*----------------------------------------------------------------------"
"IECRET";"S";"0022";"*"
"IECRET";"S";"0023";"* Modifiée par : Cellule Industrialisation"
"IECRET";"S";"0024";"* Date         : JJ/MM/AAAA"
"IECRET";"S";"0025";"* Objet        :"
"IECRET";"S";"0026";"*"
"IECRET";"S";"0027";"***********************************************************************"
"IECRET";"S";"0028";"*"
"IECRET";"S";"0029";"* Implémentation des données industrielles"
"IECRET";"S";"0030";"*"
"IECRET";"S";"0031";"DEBDICO"
"IECRET";"S";"0032";"   HJOU_IJQBHORVAJ;N;T6,2;I;;;    56789;;;V3;""Heures totales"";"
"IECRET";"S";"0033";"   HJOU_IJQPRESBAV;N;T6,2;I;;;    56789;;;V3;""Présence badgée validée"";"
"IECRET";"S";"0034";"   *   HJOU_IJQHECRETJ;N;T6,2;I;;;    56789;;;V3;""Heures écrêtées"";"
"IECRET";"S";"0035";"FINDICO"
"IECRET";"S";"0036";"*"
"IECRET";"S";"0037";"DEBANO"
"IECRET";"S";"0038";"   105;4;""Ecrétage de la présence du jour"";"
"IECRET";"S";"0039";"   117;6;""Présence inférieure au minimum"";"
"IECRET";"S";"0040";"FINANO"
"IECRET";"S";"0041";"* Déclaration des donnees locales"
"IECRET";"S";"0042";"*"
"IECRET";"S";"0043";"DEF LOCA_ANO N1"
"IECRET";"S";"0044";"LOCA_ANO = 0"
"IECRET";"S";"0045";"*  Presence > au maximum"
"IECRET";"S";"0046";"*  Ecretage uniquement sur la pr?sence journali?re"
"IECRET";"S";"0047";"SI PROF_PREMAXI > 0"
"IECRET";"S";"0048";"   SI HJOU_IJQBHORVAJ > PROF_PREMAXI"
"IECRET";"S";"0049";"      ANOMALIE 116"
"IECRET";"S";"0050";"   FINSI"
"IECRET";"S";"0051";"FINSI"
"IECRET";"S";"0052";"*  Presence < au minimum"
"IECRET";"S";"0053";"SI PROF_PREMINI > 0"
"IECRET";"S";"0054";"   SI HJOU_IJQBHORVAJ < PROF_PREMINI"
"IECRET";"S";"0055";"      POUR ACTIVITES"
"IECRET";"S";"0056";"         SI HABS_MOTYPE <> ""C"""
"IECRET";"S";"0057";"            SI HABS_VALORIS = ""J"""
"IECRET";"S";"0058";"               LOCA_ANO = 1"
"IECRET";"S";"0059";"            FINSI"
"IECRET";"S";"0060";"         FINSI"
"IECRET";"S";"0061";"      FINPOUR"
"IECRET";"S";"0062";"      SI LOCA_ANO = 0"
"IECRET";"S";"0063";"         ANOMALIE 117"
"IECRET";"S";"0064";"      FINSI"
"IECRET";"S";"0065";"   FINSI"
"IECRET";"S";"0066";"FINSI"
"IECRET";"S";"0067";"*  ecretement de la presence point?e valid?e"
"IECRET";"S";"0068";"SI HJOU_IJQPRESBAV > PROF_ECRJOU"
"IECRET";"S";"0069";"   HJOU_IJQPRESBAV = PROF_ECRJOU"
"IECRET";"S";"0070";"FINSI"
"IECRET";"S";"0071";"*  Ecretement des heures totales"
"IECRET";"S";"0072";"SI HJOU_IJQBHORVAJ > PROF_ECRJOU"
"IECRET";"S";"0073";"*   HJOU_IJQHECRETJ = HJOU_IJQBHORVAJ - PROF_ECRJOU"
"IECRET";"S";"0074";"   HJOU_IJQBHORVAJ = PROF_ECRJOU"
"IECRET";"S";"0075";"   ANOMALIE 105"
"IECRET";"S";"0076";"FINSI"
"IECRET";"S";"0077";"FIN"
"IENFMALADE";"S";"0001";"**********************************************************************"
"IENFMALADE";"S";"0002";"*"
"IENFMALADE";"S";"0003";"* Règle : IENFMALADE"
"IENFMALADE";"S";"0004";"* Ordre : 8020"
"IENFMALADE";"S";"0005";"* Titre : Congés enfant malade"
"IENFMALADE";"S";"0006";"*"
"IENFMALADE";"S";"0007";"*----------------------------------------------------------------------"
"IENFMALADE";"S";"0008";"*"
"IENFMALADE";"S";"0009";"* Créé par : Cellule Industrialisation"
"IENFMALADE";"S";"0010";"* Date     : 23/072015"
"IENFMALADE";"S";"0011";"*----------------------------------------------------------------------"
"IENFMALADE";"S";"0012";"*"
"IENFMALADE";"S";"0013";"*"
"IENFMALADE";"S";"0014";"* Rôle :"
"IENFMALADE";"S";"0015";"*"
"IENFMALADE";"S";"0016";"* Attribution de congés pour enfant malade"
"IENFMALADE";"S";"0017";"*"
"IENFMALADE";"S";"0018";"DEBDICO"
"IENFMALADE";"S";"0019";"   HJOU_IJRSCENFMA;N;N6,1;I;;;    56789;;IJRSCENFMA;V3;""Solde congé enfant malade"";"
"IENFMALADE";"S";"0020";"   PARD_IDISENFMA1;O;N2;I;;;123456789;;;C2;""Seuil 1 âge enfant malade"";"
"IENFMALADE";"S";"0021";"   PARD_IDISENFMA3;O;N2;I;;;123456789;;;C2;""Seuil 2 âge enfant malade"";"
"IENFMALADE";"S";"0022";"   PARD_IDIENFMAL1;O;N3,1;I;;;123456789;;;C2;""Droit enfant malade"";"
"IENFMALADE";"S";"0023";"   PARD_IDIENFMAL2;O;N3,1;I;;;123456789;;;C2;""Droit enfant malade maximum"";"
"IENFMALADE";"S";"0024";"FINDICO"
"IENFMALADE";"S";"0025";"*"
"IENFMALADE";"S";"0026";"DEBANO"
"IENFMALADE";"S";"0027";"   184;9;""Solde congés enfant malade insuffisant"";"
"IENFMALADE";"S";"0028";"   193;9;""Droit enfant malade supérieur au maximum"";"
"IENFMALADE";"S";"0029";"FINANO"
"IENFMALADE";"S";"0030";"*"
"IENFMALADE";"S";"0031";"* Déclaration des donnees locales"
"IENFMALADE";"S";"0032";"*"
"IENFMALADE";"S";"0033";"*"
"IENFMALADE";"S";"0034";"*"
"IENFMALADE";"S";"0035";"DEF LOCA_ENF N2"
"IENFMALADE";"S";"0036";"LOCA_ENF = 0"
"IENFMALADE";"S";"0037";"DEF LOCA_ENF16 N2"
"IENFMALADE";"S";"0038";"LOCA_ENF16 = 0"
"IENFMALADE";"S";"0039";"DEF LOCA_ENFT N2"
"IENFMALADE";"S";"0040";"LOCA_ENFT = 0"
"IENFMALADE";"S";"0041";"DEF LOCA_DROIT N2"
"IENFMALADE";"S";"0042";"LOCA_DROIT = 0"
"IENFMALADE";"S";"0043";"DEF LOCA_VAL N2.1"
"IENFMALADE";"S";"0044";"LOCA_VAL = 0"
"IENFMALADE";"S";"0045";"*"
"IENFMALADE";"S";"0046";"* Attribution du droit au 01/01"
"IENFMALADE";"S";"0047";"*"
"IENFMALADE";"S";"0048";"SI HJOU_DATE(5:4) = ""0101"""
"IENFMALADE";"S";"0049";"*"
"IENFMALADE";"S";"0050";"* Nombre d'enfants"
"IENFMALADE";"S";"0051";"   POUR ENFANTS"
"IENFMALADE";"S";"0052";"      SI ENFT_ENFACHARGE = ""1"""
"IENFMALADE";"S";"0053";"         DATDIFF ENFT_ENFDATENAI 12 HJOU_DATE 12"
"IENFMALADE";"S";"0054";"* l'enfant à moins de 1 an"
"IENFMALADE";"S";"0055";"         SI TEMP_NXANNEE < PARD_IDISENFMA1"
"IENFMALADE";"S";"0056";"            LOCA_ENF = LOCA_ENF + 1"
"IENFMALADE";"S";"0057";"         SINON"
"IENFMALADE";"S";"0058";"            SI TEMP_NXANNEE < PARD_IDISENFMA3"
"IENFMALADE";"S";"0059";"               LOCA_ENF16 = LOCA_ENF16 + 1"
"IENFMALADE";"S";"0060";"            FINSI"
"IENFMALADE";"S";"0061";"         FINSI"
"IENFMALADE";"S";"0062";"      FINSI"
"IENFMALADE";"S";"0063";"   FINPOUR"
"IENFMALADE";"S";"0064";"   LOCA_ENFT = LOCA_ENF + LOCA_ENF16"
"IENFMALADE";"S";"0065";"*"
"IENFMALADE";"S";"0066";"   SI LOCA_ENFT >= 3"
"IENFMALADE";"S";"0067";"   OU LOCA_ENF > 0"
"IENFMALADE";"S";"0068";"      LOCA_DROIT = PARD_IDIENFMAL2"
"IENFMALADE";"S";"0069";"   SINON"
"IENFMALADE";"S";"0070";"      SI LOCA_ENF16 > 0"
"IENFMALADE";"S";"0071";"         LOCA_DROIT = PARD_IDIENFMAL1"
"IENFMALADE";"S";"0072";"      FINSI"
"IENFMALADE";"S";"0073";"   FINSI"
"IENFMALADE";"S";"0074";"*"
"IENFMALADE";"S";"0075";"* Alimentation du compteur"
"IENFMALADE";"S";"0076";"   HJOU_IJRSCENFMA = LOCA_DROIT"
"IENFMALADE";"S";"0077";"FINSI"
"IENFMALADE";"S";"0078";"*"
"IENFMALADE";"S";"0079";"* alimentation par consignes"
"IENFMALADE";"S";"0080";"POUR ACTIVITES"
"IENFMALADE";"S";"0081";"   SI HABS_MOTIF = ""ZCENF"""
"IENFMALADE";"S";"0082";"      HJOU_IJRSCENFMA = HABS_MOTINBR"
"IENFMALADE";"S";"0083";"   FINSI"
"IENFMALADE";"S";"0084";"   SI HABS_MOTIF = ""XCENF"""
"IENFMALADE";"S";"0085";"      HJOU_IJRSCENFMA = HJOU_IJRSCENFMA + HABS_MOTINBR"
"IENFMALADE";"S";"0086";"   FINSI"
"IENFMALADE";"S";"0087";"FINPOUR"
"IENFMALADE";"S";"0088";"*"
"IENFMALADE";"S";"0089";"* Contrôle du droit maximum"
"IENFMALADE";"S";"0090";"*"
"IENFMALADE";"S";"0091";"SI HJOU_IJRSCENFMA > PARD_IDIENFMAL2"
"IENFMALADE";"S";"0092";"   ANOMALIE 193"
"IENFMALADE";"S";"0093";"FINSI"
"IENFMALADE";"S";"0094";"*"
"IENFMALADE";"S";"0095";"* Gestion du pris"
"IENFMALADE";"S";"0096";"POUR ACTIVITES"
"IENFMALADE";"S";"0097";"   SI HABS_MOTIF = ""CENF"""
"IENFMALADE";"S";"0098";"      SI HABS_VALORIS = ""J"""
"IENFMALADE";"S";"0099";"         LOCA_VAL = 1"
"IENFMALADE";"S";"0100";"      SINON"
"IENFMALADE";"S";"0101";"         LOCA_VAL = 0.5"
"IENFMALADE";"S";"0102";"      FINSI"
"IENFMALADE";"S";"0103";"   FINSI"
"IENFMALADE";"S";"0104";"FINPOUR"
"IENFMALADE";"S";"0105";"*"
"IENFMALADE";"S";"0106";"SI HJOU_IJRSCENFMA >= LOCA_VAL"
"IENFMALADE";"S";"0107";"   HJOU_IJRSCENFMA = HJOU_IJRSCENFMA - LOCA_VAL"
"IENFMALADE";"S";"0108";"SINON"
"IENFMALADE";"S";"0109";"   ANOMALIE 184"
"IENFMALADE";"S";"0110";"FINSI"
"IENFMALADE";"S";"0111";"FIN"
"IEXCED";"S";"0001";"***********************************************************************"
"IEXCED";"S";"0002";"*"
"IEXCED";"S";"0003";"* Règle : IEXCED"
"IEXCED";"S";"0004";"* Ordre : 2080"
"IEXCED";"S";"0005";"* Titre : Heures jour excedentaires"
"IEXCED";"S";"0006";"*"
