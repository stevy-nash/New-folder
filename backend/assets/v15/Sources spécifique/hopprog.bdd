"SUPANO";"S";"0031";"*"
"SUPANO";"S";"0032";"* Identification du LOT2 et suppression anomalie avant le 01/10/2025 >>"
"SUPANO";"S";"0033";"DEF LOCA_LOT2 N2"
"SUPANO";"S";"0034";"LOCA_LOT2 = 0"
"SUPANO";"S";"0035";"*"
"SUPANO";"S";"0036";"SI HJOU_DATE(1:8) < ""20251001"""
"SUPANO";"S";"0037";"   SI HJOU_SECTORI(1:3) <> ""DIN"""
"SUPANO";"S";"0038";"      SI HJOU_SECTORI(1:3) <> ""DRE"""
"SUPANO";"S";"0039";"         SI HJOU_SECTORI(1:3) <> ""RED"""
"SUPANO";"S";"0040";"            SI HJOU_SECTORI(1:3) <> ""TVR"""
"SUPANO";"S";"0041";"               LOCA_LOT2 = 1"
"SUPANO";"S";"0042";"            FINSI"
"SUPANO";"S";"0043";"         FINSI"
"SUPANO";"S";"0044";"      FINSI"
"SUPANO";"S";"0045";"   FINSI"
"SUPANO";"S";"0046";"FINSI"
