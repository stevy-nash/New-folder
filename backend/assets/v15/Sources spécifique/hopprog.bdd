"ICONSCONG";"S";"0448";"                                        *"
"ICONSCONG";"S";"0449";"                                        SI HJOU_IJRSACQCP < 0"
"ICONSCONG";"S";"0450";"                                            ANOMALIE 197"
"ICONSCONG";"S";"0451";"                                        FINSI"
