"SANOM";"S";"0493";"* JJA - 21/10/2025 - Ajout des HSUP, HNUIT et HDIM sur planning équipe >>"
"SANOM";"S";"0494";"*"
"SANOM";"S";"0495";"ENLEVER ""ZTOTDIM"""
"SANOM";"S";"0496";"ENLEVER ""ZTOTHS"""
"SANOM";"S";"0497";"ENLEVER ""ZTOTNUIT"""
"SANOM";"S";"0498";"ENLEVER ""ZTOTDIM"""
"SANOM";"S";"0499";"ENLEVER ""ZTOTHS"""
"SANOM";"S";"0500";"ENLEVER ""ZTOTNUIT"""
"SANOM";"S";"0501";"ENLEVER ""ZTOTDIM"""
"SANOM";"S";"0502";"ENLEVER ""ZTOTHS"""
"SANOM";"S";"0503";"ENLEVER ""ZTOTNUIT"""
"SANOM";"S";"0504";"*"
"SANOM";"S";"0505";"DEF LOCA_NBCYCLE N2"
"SANOM";"S";"0506";"LOCA_NBCYCLE = 0"
"SANOM";"S";"0507";"*"
"SANOM";"S";"0508";"* Calcul fin de cycle"
"SANOM";"S";"0509";"SI HJOU_DATE(1:8) >= ""20251027"""
"SANOM";"S";"0510";"   SI HJOU_JOUR = ""7"""
"SANOM";"S";"0511";"      LOCA_NBCYCLE = HJOU_LGCYCLE / 7"
"SANOM";"S";"0512";"      SI HJOU_RANG = LOCA_NBCYCLE"
"SANOM";"S";"0513";"         SI HJOU_SJQSOCIETE = ""EV"""
"SANOM";"S";"0514";"         OU HJOU_SJQSOCIETE = ""PE"""
"SANOM";"S";"0515";"            SI HJOU_SJQHDIF100 > 0"
"SANOM";"S";"0516";"               AJOUTER ""ZTOTDIM"" ""H"" HJOU_SJQHDIF100"
"SANOM";"S";"0517";"            FINSI"
"SANOM";"S";"0518";"            SI HJOU_SJQTHSHC > 0"
"SANOM";"S";"0519";"               AJOUTER ""ZTOTHS"" ""H"" HJOU_SJQTHSHC"
"SANOM";"S";"0520";"            FINSI"
"SANOM";"S";"0521";"            SI HJOU_SJQHNUIP50 > 0"
"SANOM";"S";"0522";"               AJOUTER ""ZTOTNUIT"" ""H"" HJOU_SJQHNUIP50"
"SANOM";"S";"0523";"            FINSI"
"SANOM";"S";"0524";"            SI HJOU_SJQHNUIP25 > 0"
"SANOM";"S";"0525";"               AJOUTER ""ZTOTNUIT"" ""H"" HJOU_SJQHNUIP25"
"SANOM";"S";"0526";"            FINSI"
"SANOM";"S";"0527";"         FINSI"
"SANOM";"S";"0528";"      FINSI"
