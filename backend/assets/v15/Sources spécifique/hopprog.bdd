"IACQCPAN1";"S";"0063";"   PARD_IDISANNC6;O;N3;I;;;123456789;;;C3;""Seuil ancienneté 6 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0064";"   PARD_IDIDCANNC1;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 1 ""RÉGIME 2"""";"
"IACQCPAN1";"S";"0065";"   PARD_IDIDCANNC2;O;N4,1;I;;;123456789;;;C3;""Droit congé ancienneté 2 ""RÉGIME 2"""";"
