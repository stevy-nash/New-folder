"ITPSACTPT3";"S";"0039";"*"
"ITPSACTPT3";"S";"0040";"*"
"ITPSACTPT3";"S";"0041";"* DEBANO"
"ITPSACTPT3";"S";"0042";"*"
"ITPSACTPT3";"S";"0043";"* FINANO"
"ITPSACTPT3";"S";"0044";"*"
"ITPSACTPT3";"S";"0045";"* Définition des variables locales"
"ITPSACTPT3";"S";"0046";"DEF LOCA_DURABS T6.2"
"ITPSACTPT3";"S";"0047";"LOCA_DURABS = 0"
"ITPSACTPT3";"S";"0048";"*"
"ITPSACTPT3";"S";"0049";"* Gestion de l'indicateur activité"
"ITPSACTPT3";"S";"0050";"SI HJOU_IJIACTI = "" """
