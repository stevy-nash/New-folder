"ICONSCONG";"S";"0139";"LOCA_DURSOIR = 0"
"ICONSCONG";"S";"0140";"DEF LOCA_TRANS N6.1"
"ICONSCONG";"S";"0141";"LOCA_TRANS = 0"
"ICONSCONG";"S";"0142";"DEF LOCA_PRIS N6.1"
"ICONSCONG";"S";"0143";"LOCA_PRIS = 0"
"ICONSCONG";"S";"0144";"DEF LOCA_ACP N1"
"ICONSCONG";"S";"0145";"LOCA_ACP = 0"
"ICONSCONG";"S";"0146";"DEF LOCA_CPMOT N1"
"ICONSCONG";"S";"0147";"LOCA_CPMOT = 0"
"ICONSCONG";"S";"0148";"DEF LOCA_ANCI N1"
"ICONSCONG";"S";"0149";"LOCA_ANCI = 0"
"ICONSCONG";"S";"0150";"*"
"ICONSCONG";"S";"0151";"*"
"ICONSCONG";"S";"0152";"* test si gestion des cp"
"ICONSCONG";"S";"0153";"SI HJOU_IJIACOPRIN = ""1"""
"ICONSCONG";"S";"0154";"* Dans le cas ou on a 2 motifs"
"ICONSCONG";"S";"0155";"* de type congé 1/2 journée, ils sont transformés en"
"ICONSCONG";"S";"0156";"* un motif de même type congé journée entiere"
"ICONSCONG";"S";"0157";"   POUR ACTIVITES"
"ICONSCONG";"S";"0158";"      * Reliquat"
"ICONSCONG";"S";"0159";"      SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCONG";"S";"0160";"         SI HABS_VALORIS <> ""J"""
"ICONSCONG";"S";"0161";"            LOCA_NBDEMIR = LOCA_NBDEMIR + 1"
"ICONSCONG";"S";"0162";"         FINSI"
"ICONSCONG";"S";"0163";"      FINSI"
"ICONSCONG";"S";"0164";"      * Congé"
"ICONSCONG";"S";"0165";"      SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0166";"         SI HABS_VALORIS <> ""J"""
"ICONSCONG";"S";"0167";"            LOCA_NBDEMIC = LOCA_NBDEMIC + 1"
"ICONSCONG";"S";"0168";"         FINSI"
"ICONSCONG";"S";"0169";"      FINSI"
"ICONSCONG";"S";"0170";"      * Anticipé"
"ICONSCONG";"S";"0171";"      SI HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCONG";"S";"0172";"         SI HABS_VALORIS <> ""J"""
"ICONSCONG";"S";"0173";"            LOCA_NBDEMIA = LOCA_NBDEMIA + 1"
"ICONSCONG";"S";"0174";"         FINSI"
"ICONSCONG";"S";"0175";"      FINSI"
"ICONSCONG";"S";"0176";"      * Ancienneté"
"ICONSCONG";"S";"0177";"      SI HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCONG";"S";"0178";"         SI HABS_VALORIS <> ""J"""
"ICONSCONG";"S";"0179";"            LOCA_NBDEMIAN = LOCA_NBDEMIAN + 1"
"ICONSCONG";"S";"0180";"         FINSI"
"ICONSCONG";"S";"0181";"      FINSI"
"ICONSCONG";"S";"0182";"   FINPOUR"
"ICONSCONG";"S";"0183";"   *"
"ICONSCONG";"S";"0184";"   SI LOCA_NBDEMIR = 2"
"ICONSCONG";"S";"0185";"   OU LOCA_NBDEMIC = 2"
"ICONSCONG";"S";"0186";"   OU LOCA_NBDEMIA = 2"
"ICONSCONG";"S";"0187";"   OU LOCA_NBDEMIAN = 2"
"ICONSCONG";"S";"0188";"       POUR ACTIVITES"
"ICONSCONG";"S";"0189";"          SI HABS_VALORIS <> ""J"""
"ICONSCONG";"S";"0190";"            *si valorisation du motif modifiée"
"ICONSCONG";"S";"0191";"            SI HABS_VALORIS = ""M"""
"ICONSCONG";"S";"0192";"               LOCA_DURMAT = HABS_MOTIDUR"
"ICONSCONG";"S";"0193";"            FINSI"
"ICONSCONG";"S";"0194";"            SI HABS_VALORIS = ""A"""
"ICONSCONG";"S";"0195";"               LOCA_DURSOIR = HABS_MOTIDUR"
"ICONSCONG";"S";"0196";"            FINSI"
"ICONSCONG";"S";"0197";"            LOCA_DUREEJ = LOCA_DURMAT + LOCA_DURSOIR"
"ICONSCONG";"S";"0198";"         SINON"
"ICONSCONG";"S";"0199";"            LOCA_DUREEJ = HABS_MOTIDUR"
"ICONSCONG";"S";"0200";"            SI MOTI_IMIGDURABS = ""FIX"""
"ICONSCONG";"S";"0201";"               LOCA_DURMAT = MOTI_VALDFT / 2"
"ICONSCONG";"S";"0202";"               LOCA_DURSOIR = LOCA_DURMAT"
"ICONSCONG";"S";"0203";"            FINSI"
"ICONSCONG";"S";"0204";"            SI MOTI_IMIGDURABS = ""C5"""
"ICONSCONG";"S";"0205";"            OU MOTI_IMIGDURABS = ""C6"""
"ICONSCONG";"S";"0206";"            OU MOTI_IMIGDURABS = ""C7"""
"ICONSCONG";"S";"0207";"               LOCA_DURMAT = LOCA_DUREEJ / 2"
"ICONSCONG";"S";"0208";"               LOCA_DURSOIR = LOCA_DURMAT"
"ICONSCONG";"S";"0209";"            FINSI"
"ICONSCONG";"S";"0210";"            SI MOTI_IMIGDURABS = ""PLG"""
"ICONSCONG";"S";"0211";"               LOCA_DURMAT = HJOU_IJQPLGMAT"
"ICONSCONG";"S";"0212";"               LOCA_DURSOIR = HJOU_IJQPLGAPM"
"ICONSCONG";"S";"0213";"            FINSI"
"ICONSCONG";"S";"0214";"            SI MOTI_IMIGDURABS = "" """
"ICONSCONG";"S";"0215";"               LOCA_DURMAT = PROF_ABSENM"
"ICONSCONG";"S";"0216";"               LOCA_DURSOIR = PROF_ABSENS"
"ICONSCONG";"S";"0217";"            FINSI"
"ICONSCONG";"S";"0218";"         FINSI"
"ICONSCONG";"S";"0219";"       FINPOUR"
"ICONSCONG";"S";"0220";"       *"
"ICONSCONG";"S";"0221";"       * Reliquat"
"ICONSCONG";"S";"0222";"       SI LOCA_NBDEMIR = 2"
"ICONSCONG";"S";"0223";"          ENLEVER PARD_IDIVMCOREL"
"ICONSCONG";"S";"0224";"          ENLEVER PARD_IDIVMCOREL"
"ICONSCONG";"S";"0225";"          AJOUTER PARD_IDIVMCOREL ""J"" LOCA_DUREEJ"
"ICONSCONG";"S";"0226";"          * LOCA_MOTCP = 1"
"ICONSCONG";"S";"0227";"       FINSI"
"ICONSCONG";"S";"0228";"       * Congé"
"ICONSCONG";"S";"0229";"       SI LOCA_NBDEMIC = 2"
"ICONSCONG";"S";"0230";"          ENLEVER PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0231";"          ENLEVER PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0232";"          AJOUTER PARD_IDIVMCOPRI ""J"" LOCA_DUREEJ"
"ICONSCONG";"S";"0233";"          * LOCA_MOTCP = 1"
"ICONSCONG";"S";"0234";"       FINSI"
"ICONSCONG";"S";"0235";"       * Anticipé"
"ICONSCONG";"S";"0236";"       SI LOCA_NBDEMIA = 2"
"ICONSCONG";"S";"0237";"          ENLEVER PARD_IDIVMCOANT"
"ICONSCONG";"S";"0238";"          ENLEVER PARD_IDIVMCOANT"
"ICONSCONG";"S";"0239";"          AJOUTER PARD_IDIVMCOANT ""J"" LOCA_DUREEJ"
"ICONSCONG";"S";"0240";"          * LOCA_MOTCP = 1"
"ICONSCONG";"S";"0241";"       FINSI"
"ICONSCONG";"S";"0242";"       * Ancienneté"
"ICONSCONG";"S";"0243";"       SI LOCA_NBDEMIAN = 2"
"ICONSCONG";"S";"0244";"          ENLEVER PARD_IDIVMCOANC"
"ICONSCONG";"S";"0245";"          ENLEVER PARD_IDIVMCOANC"
"ICONSCONG";"S";"0246";"          AJOUTER PARD_IDIVMCOANC ""J"" LOCA_DUREEJ"
"ICONSCONG";"S";"0247";"          * LOCA_MOTCP = 1"
"ICONSCONG";"S";"0248";"       FINSI"
"ICONSCONG";"S";"0249";"       *****"
"ICONSCONG";"S";"0250";"   FINSI"
"ICONSCONG";"S";"0251";"* Jour de repos"
"ICONSCONG";"S";"0252";"* Ajout des CP sur les jours non travaillés"
"ICONSCONG";"S";"0253";"* (jours ouvrables : ajouter CP sur jour de repos du lundi au samedi)"
"ICONSCONG";"S";"0254";"* (jours ouvrés : ajouter CP sur jour de repos du lundi au vendredi)"
"ICONSCONG";"S";"0255";"   SI HJOU_IJQPRETHEJ = 0"
"ICONSCONG";"S";"0256";"*Pour la gestion si pas reprise direct après fin du premier contrat"
"ICONSCONG";"S";"0257";"*Date - 1"
"ICONSCONG";"S";"0258";"      DATAJT HJOU_DATE 12 ""J"" -1"
"ICONSCONG";"S";"0259";"      LOCA_DATEVEIL2 = TEMP_DXFINPER"
"ICONSCONG";"S";"0260";"*"
"ICONSCONG";"S";"0261";"      LIREVALPRE LOCA_DATEVEIL HJOU_DATE"
"ICONSCONG";"S";"0262";"      SI LOCA_DATEVEIL = LOCA_DATEVEIL2"
"ICONSCONG";"S";"0263";"         LIREVALPRE LOCA_VALPRE HJOU_IJRJRCONG"
"ICONSCONG";"S";"0264";"         SI LOCA_VALPRE = 1"
"ICONSCONG";"S";"0265";"* Si férié sur jour de repos + CP la veille"
"ICONSCONG";"S";"0266";"            POUR ACTIVITES"
"ICONSCONG";"S";"0267";"               SI HABS_MOTIF = ""FERI"""
"ICONSCONG";"S";"0268";"                  LOCA_ANNULCP = 1"
"ICONSCONG";"S";"0269";"               FINSI"
"ICONSCONG";"S";"0270";"            FINPOUR"
"ICONSCONG";"S";"0271";"*"
"ICONSCONG";"S";"0272";"            SI LOCA_ANNULCP <> 1"
"ICONSCONG";"S";"0273";"               ENLEVER PARD_IDIVMCOREL"
"ICONSCONG";"S";"0274";"               ENLEVER PARD_IDIVMCOANC"
"ICONSCONG";"S";"0275";"               ENLEVER PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0276";"               ENLEVER PARD_IDIVMCOANT"
"ICONSCONG";"S";"0277";"               AJOUTER PARD_IDIVMCOPRI ""J"" 0"
"ICONSCONG";"S";"0278";"            FINSI"
"ICONSCONG";"S";"0279";"         SINON"
"ICONSCONG";"S";"0280";"            POUR ACTIVITES"
"ICONSCONG";"S";"0281";"                * S'il y a une consigne XPRES"
"ICONSCONG";"S";"0282";"                * et un motif de type congé sur"
"ICONSCONG";"S";"0283";"                * la même journée"
"ICONSCONG";"S";"0284";"                SI HABS_MOTIF = ""XPRES"""
"ICONSCONG";"S";"0285";"                    LOCA_XPRES = 1"
"ICONSCONG";"S";"0286";"                FINSI"
"ICONSCONG";"S";"0287";"                SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCONG";"S";"0288";"                OU HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCONG";"S";"0289";"                OU HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0290";"                OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCONG";"S";"0291";"                    * Si motif de type CP ajouté par"
"ICONSCONG";"S";"0292";"                    * régle on enlève le motif CP"
"ICONSCONG";"S";"0293";"                    SI HABS_UTILMOD <> ""*REG"""
"ICONSCONG";"S";"0294";"                        LOCA_UTILMOD = 1"
"ICONSCONG";"S";"0295";"                    FINSI"
"ICONSCONG";"S";"0296";"                FINSI"
"ICONSCONG";"S";"0297";"            FINPOUR"
"ICONSCONG";"S";"0298";"            *"
"ICONSCONG";"S";"0299";"            SI LOCA_UTILMOD = 0"
"ICONSCONG";"S";"0300";"                SI LOCA_XPRES = 0"
"ICONSCONG";"S";"0301";"                    * SI LOCA_MOTCP = 0"
"ICONSCONG";"S";"0302";"                        ENLEVER PARD_IDIVMCOREL"
"ICONSCONG";"S";"0303";"                        ENLEVER PARD_IDIVMCOANC"
"ICONSCONG";"S";"0304";"                        ENLEVER PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0305";"                        ENLEVER PARD_IDIVMCOANT"
"ICONSCONG";"S";"0306";"                    * FINSI"
"ICONSCONG";"S";"0307";"                FINSI"
"ICONSCONG";"S";"0308";"            FINSI"
"ICONSCONG";"S";"0309";"         FINSI"
"ICONSCONG";"S";"0310";"      FINSI"
"ICONSCONG";"S";"0311";"   FINSI"
"ICONSCONG";"S";"0312";"   *"
"ICONSCONG";"S";"0313";"* gestion du motif CP"
"ICONSCONG";"S";"0314";"   POUR ACTIVITES"
"ICONSCONG";"S";"0315";"      SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCONG";"S";"0316";"      OU HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCONG";"S";"0317";"      OU HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0318";"      OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCONG";"S";"0319";"* La regle VALACT qui permet de supprimer un motif"
"ICONSCONG";"S";"0320";"* par rapport au type de jour O/S/D/F n'étant pas"
"ICONSCONG";"S";"0321";"* déroulée dans le futur on va tester la validité du motif"
"ICONSCONG";"S";"0322";"* avant d'effectuer le chainage et le calcul des soldes"
"ICONSCONG";"S";"0323";"* pour que le solde prévisionnel soit juste"
"ICONSCONG";"S";"0324";"         LOCA_ENLEVER = 0"
"ICONSCONG";"S";"0325";"         LOCA_VALID = MOTI_VALID"
"ICONSCONG";"S";"0326";"         SI LOCA_VALID(1:1) = ""O"""
"ICONSCONG";"S";"0327";"            SI PARD_IDIJOUROUV = ""1"""
"ICONSCONG";"S";"0328";"               SI HJOU_IJQPRETHEJ = 0"
"ICONSCONG";"S";"0329";"                  LOCA_ENLEVER = 1"
"ICONSCONG";"S";"0330";"               FINSI"
"ICONSCONG";"S";"0331";"            SINON"
"ICONSCONG";"S";"0332";"               SI HJOU_JOUR = ""6"""
"ICONSCONG";"S";"0333";"                  SI HJOU_IJQPRETHEJ = 0"
"ICONSCONG";"S";"0334";"                     LOCA_ENLEVER = 1"
"ICONSCONG";"S";"0335";"                  FINSI"
"ICONSCONG";"S";"0336";"               FINSI"
"ICONSCONG";"S";"0337";"            FINSI"
"ICONSCONG";"S";"0338";"         FINSI"
"ICONSCONG";"S";"0339";"         SI LOCA_VALID(2:1) = ""S"""
"ICONSCONG";"S";"0340";"            LOCA_ENLEVER = 0"
"ICONSCONG";"S";"0341";"         FINSI"
"ICONSCONG";"S";"0342";"         SI LOCA_VALID(3:1) = "" """
"ICONSCONG";"S";"0343";"            SI HJOU_JOUR = ""7"""
"ICONSCONG";"S";"0344";"               SI HJOU_IJQPRETHEJ = 0"
"ICONSCONG";"S";"0345";"                  LOCA_ENLEVER = 1"
"ICONSCONG";"S";"0346";"               FINSI"
"ICONSCONG";"S";"0347";"            FINSI"
"ICONSCONG";"S";"0348";"         FINSI"
"ICONSCONG";"S";"0349";"*"
"ICONSCONG";"S";"0350";"         SI LOCA_ENLEVER = 0"
"ICONSCONG";"S";"0351";"            LOCA_VAL = 0"
"ICONSCONG";"S";"0352";"            LOCA_VALORIS = HABS_VALORIS"
"ICONSCONG";"S";"0353";"            SI HABS_VALORIS = ""J"""
"ICONSCONG";"S";"0354";"*Optimum"
"ICONSCONG";"S";"0355";"              SI CTRA_TYPEPLAN = ""1"""
"ICONSCONG";"S";"0356";"              OU CTRA_TYPEPLAN = ""6"""
"ICONSCONG";"S";"0357";"                 SI HJOU_IJQPRETHEJ <> 0"
"ICONSCONG";"S";"0358";"                    HJOU_IJRCPCOH = HJOU_IJRCPCOH + 1"
"ICONSCONG";"S";"0359";"*Limite hebdo de 1/5"
"ICONSCONG";"S";"0360";"                    SI HORC_IHIMOACQCP = ""1"""
"ICONSCONG";"S";"0361";"                       LOCA_DRCP = 30"
"ICONSCONG";"S";"0362";"                    FINSI"
"ICONSCONG";"S";"0363";"                    SI HORC_IHIMOACQCP = ""2"""
"ICONSCONG";"S";"0364";"                       LOCA_DRCP = 25"
"ICONSCONG";"S";"0365";"                    FINSI"
"ICONSCONG";"S";"0366";"*"
"ICONSCONG";"S";"0367";"                    SI LOCA_DRCP > 0"
"ICONSCONG";"S";"0368";"                       LOCA_LIMITEHEB = LOCA_DRCP / 5"
"ICONSCONG";"S";"0369";"*Si congés pris hebdo <= limite hebdo 1/5 des droits CP travaillés"
"ICONSCONG";"S";"0370";"                       SI HJOU_IJRCPCOH <= LOCA_LIMITEHEB"
"ICONSCONG";"S";"0371";"                          LOCA_VAL = 1"
"ICONSCONG";"S";"0372";"                       SINON"
"ICONSCONG";"S";"0373";"                          LOCA_VAL = 0"
"ICONSCONG";"S";"0374";"                       FINSI"
"ICONSCONG";"S";"0375";"                    FINSI"
"ICONSCONG";"S";"0376";"                 FINSI"
"ICONSCONG";"S";"0377";"              SINON"
"ICONSCONG";"S";"0378";"                 LOCA_VAL = 1"
"ICONSCONG";"S";"0379";"              FINSI"
"ICONSCONG";"S";"0380";"            SINON"
"ICONSCONG";"S";"0381";"*Optimum"
"ICONSCONG";"S";"0382";"              SI CTRA_TYPEPLAN = ""1"""
"ICONSCONG";"S";"0383";"              OU CTRA_TYPEPLAN = ""6"""
"ICONSCONG";"S";"0384";"                 SI HJOU_IJQPRETHEJ <> 0"
"ICONSCONG";"S";"0385";"                    HJOU_IJRCPCOH = HJOU_IJRCPCOH + 0.5"
"ICONSCONG";"S";"0386";"*Limite hebdo de 1/5"
"ICONSCONG";"S";"0387";"                    SI HORC_IHIMOACQCP = ""1"""
"ICONSCONG";"S";"0388";"                       LOCA_DRCP = 30"
"ICONSCONG";"S";"0389";"                    FINSI"
"ICONSCONG";"S";"0390";"                    SI HORC_IHIMOACQCP = ""2"""
"ICONSCONG";"S";"0391";"                       LOCA_DRCP = 25"
"ICONSCONG";"S";"0392";"                    FINSI"
"ICONSCONG";"S";"0393";"*"
"ICONSCONG";"S";"0394";"                    SI LOCA_DRCP > 0"
"ICONSCONG";"S";"0395";"                       LOCA_LIMITEHEB = LOCA_DRCP / 5"
"ICONSCONG";"S";"0396";"*Si congés pris hebdo <= limite hebdo 1/5 des droits CP travaillés"
"ICONSCONG";"S";"0397";"                       SI HJOU_IJRCPCOH <= LOCA_LIMITEHEB"
"ICONSCONG";"S";"0398";"                          LOCA_VAL = 0.5"
"ICONSCONG";"S";"0399";"                       SINON"
"ICONSCONG";"S";"0400";"                          LOCA_VAL = 0"
"ICONSCONG";"S";"0401";"                       FINSI"
"ICONSCONG";"S";"0402";"                    FINSI"
"ICONSCONG";"S";"0403";"                 SINON"
"ICONSCONG";"S";"0404";"                    LOCA_VAL = 0"
"ICONSCONG";"S";"0405";"                 FINSI"
"ICONSCONG";"S";"0406";"              SINON"
"ICONSCONG";"S";"0407";"                 LOCA_VAL = 0.5"
"ICONSCONG";"S";"0408";"              FINSI"
"ICONSCONG";"S";"0409";"            FINSI"
"ICONSCONG";"S";"0410";"            *"
"ICONSCONG";"S";"0411";"            SI LOCA_VAL > 0"
"ICONSCONG";"S";"0412";"                * Reliquat"
"ICONSCONG";"S";"0413";"                SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCONG";"S";"0414";"                    HJOU_IJRSCORELI = HJOU_IJRSCORELI - LOCA_VAL"
"ICONSCONG";"S";"0415";"                    SI HJOU_IJRSCORELI < 0"
"ICONSCONG";"S";"0416";"                        ANOMALIE 196"
"ICONSCONG";"S";"0417";"                    FINSI"
"ICONSCONG";"S";"0418";"                SINON"
"ICONSCONG";"S";"0419";"                    * Congé ancienneté"
"ICONSCONG";"S";"0420";"                    SI HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCONG";"S";"0421";"                        HJOU_IJRCCOANCI = HJOU_IJRCCOANCI + LOCA_VAL"
"ICONSCONG";"S";"0422";"                        HJOU_IJRSCOANCI = HJOU_IJRSCOANCI - LOCA_VAL"
"ICONSCONG";"S";"0423";"                        SI HJOU_IJRSCOANCI < 0"
"ICONSCONG";"S";"0424";"                            ANOMALIE 168"
"ICONSCONG";"S";"0425";"                        FINSI"
"ICONSCONG";"S";"0426";"                    SINON"
"ICONSCONG";"S";"0427";"                        * Congé/Acquisition"
"ICONSCONG";"S";"0428";"                        SI HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCONG";"S";"0429";"                            SI HJOU_IJRSCOPRIN >= LOCA_VAL"
"ICONSCONG";"S";"0430";"                                SI HORC_IHIDRNTRAV = 0"
"ICONSCONG";"S";"0431";"                                    HJOU_IJRCCOPRIN = HJOU_IJRCCOPRIN + LOCA_VAL"
"ICONSCONG";"S";"0432";"                                    HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_VAL"
"ICONSCONG";"S";"0433";"                                SINON"
"ICONSCONG";"S";"0434";"                                    * Gestion CP sur jour travaillés/non travaillés"
"ICONSCONG";"S";"0435";"                                    FAIRE TPSPART"
"ICONSCONG";"S";"0436";"                                FINSI"
"ICONSCONG";"S";"0437";"                            SINON"
"ICONSCONG";"S";"0438";"                                SI HJOU_IJRSCOPRIN > 0"
"ICONSCONG";"S";"0439";"                                    LOCA_CAL = LOCA_VAL - HJOU_IJRSCOPRIN"
"ICONSCONG";"S";"0440";"                                    SI HORC_IHIDRNTRAV = 0"
