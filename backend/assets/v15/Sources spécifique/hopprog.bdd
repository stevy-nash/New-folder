"ICONSCONG";"S";"0556";"           LOCA_TRANS = LOCA_PRIS - HJOU_IJRCCPTRA"
"ICONSCONG";"S";"0557";"           *"
"ICONSCONG";"S";"0558";"           HJOU_IJRCCPTRA = HJOU_IJRCCPTRA + HABS_MOTINBR"
"ICONSCONG";"S";"0559";"           HJOU_IJRSCPTRA = HJOU_IJRSCPTRA - LOCA_TRANS"
"ICONSCONG";"S";"0560";"* Recalcul des compteurs congé payé"
"ICONSCONG";"S";"0561";"           HJOU_IJRCCOPRIN = HJOU_IJRCCPTRA + HJOU_IJRCCPNTRA"
"ICONSCONG";"S";"0562";"           HJOU_IJRSCOPRIN = HJOU_IJRSCOPRIN - LOCA_TRANS"
