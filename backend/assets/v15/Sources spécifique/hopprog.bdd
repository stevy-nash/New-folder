"SGDH";"S";"0034";"   HJOU_SJRSDH;N;N6,2;I;;;     6789;;SJRSDH;V3;""Solde DH"";"
"SGDH";"S";"0035";"   HJOU_SJRCDHW;N;N6,2;I;;;     6789;;SJRCDHW;V3;""Pris DH en attente"";"
"SGDH";"S";"0036";"   EMPL_SEQSPDH;N;N6,1;I;;;    56789;;;V3;""Solde prév. DH"";"
"SGDH";"S";"0037";"   PARD_SDIVMDH;O;A10;X;;;123456789;II;;C2;""Motif DH"";"
"SGDH";"S";"0038";"   *"
"SGDH";"S";"0039";"   HJOU_SJRACQDHM;N;N8,5;L;;;6789;;SJRACQDHM;V3;""Acquisitoin DH mois (cumul)"";"
