"IGRTTJ";"S";"0176";"                  SI HJOU_JOUR = ""6"""
"IGRTTJ";"S";"0177";"                     SI HJOU_IJQPRETHEJ = 0"
"IGRTTJ";"S";"0178";"                        LOCA_ENLEVER = 1"
"IGRTTJ";"S";"0179";"                     FINSI"
"IGRTTJ";"S";"0180";"                  FINSI"
"IGRTTJ";"S";"0181";"               FINSI"
"IGRTTJ";"S";"0182";"            FINSI"
"IGRTTJ";"S";"0183";"            SI LOCA_VALID(2:1) = ""S"""
"IGRTTJ";"S";"0184";"               LOCA_ENLEVER = 0"
"IGRTTJ";"S";"0185";"            FINSI"
"IGRTTJ";"S";"0186";"            SI LOCA_VALID(3:1) = "" """
"IGRTTJ";"S";"0187";"               SI HJOU_JOUR = ""7"""
"IGRTTJ";"S";"0188";"                  SI HJOU_IJQPRETHEJ = 0"
"IGRTTJ";"S";"0189";"                     LOCA_ENLEVER = 1"
"IGRTTJ";"S";"0190";"                  FINSI"
"IGRTTJ";"S";"0191";"               FINSI"
"IGRTTJ";"S";"0192";"            FINSI"
"IGRTTJ";"S";"0193";"******************************************************"
"IGRTTJ";"S";"0194";"            SI LOCA_ENLEVER = 0"
"IGRTTJ";"S";"0195";"               SI HABS_VALORIS = ""J"""
"IGRTTJ";"S";"0196";"                  HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + 1"
"IGRTTJ";"S";"0197";"                  HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - 1"
"IGRTTJ";"S";"0198";"               SINON"
"IGRTTJ";"S";"0199";"                  HJOU_IJRCRTTJOU = HJOU_IJRCRTTJOU + 0.5"
"IGRTTJ";"S";"0200";"                  HJOU_IJRSNBJRTT = HJOU_IJRSNBJRTT - 0.5"
"IGRTTJ";"S";"0201";"               FINSI"
"IGRTTJ";"S";"0202";"            FINSI"
"IGRTTJ";"S";"0203";"         FINSI"
"IGRTTJ";"S";"0204";"      FINSI"
"IGRTTJ";"S";"0205";"*   Contrôle du nombre de RTT employeurs pris"
"IGRTTJ";"S";"0206";"*   et mise en place anomalie si cela dépasse"
"IGRTTJ";"S";"0207";"*   la valeur indiquée dans les données globales datées"
"IGRTTJ";"S";"0208";"      SI HABS_MOTIF = PARD_IDIVMRTTEM"
"IGRTTJ";"S";"0209";"         SI HABS_VALORIS = ""J"""
"IGRTTJ";"S";"0210";"            HJOU_IJRNRTTJEM = HJOU_IJRNRTTJEM + 1"
"IGRTTJ";"S";"0211";"         SINON"
