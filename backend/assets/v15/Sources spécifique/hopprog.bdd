"ITPSACTHT9";"S";"0040";"*"
"ITPSACTHT9";"S";"0041";"* DEBANO"
"ITPSACTHT9";"S";"0042";"*"
"ITPSACTHT9";"S";"0043";"* FINANO"
"ITPSACTHT9";"S";"0044";"*"
"ITPSACTHT9";"S";"0045";"* Définition des variables locales"
"ITPSACTHT9";"S";"0046";"*"
"ITPSACTHT9";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTHT9";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTHT9";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHT9";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTHT9";"S";"0051";"    FINSI"
"ITPSACTHT9";"S";"0052";"FINSI"
"ITPSACTHT9";"S";"0053";"*"
"ITPSACTHT9";"S";"0054";"* Employé géré en activité"
"ITPSACTHT9";"S";"0055";"SI HJOU_IJIACTI <> "" """
"ITPSACTHT9";"S";"0056";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHT9";"S";"0057";"        * Calcul de la présence activité le dimanche"
"ITPSACTHT9";"S";"0058";"        * Ou dernier jour du contrat"
"ITPSACTHT9";"S";"0059";"        SI HJOU_JOUR = ""7"""
"ITPSACTHT9";"S";"0060";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTHT9";"S";"0061";"            SI PRES_VALID <> ""O"""
"ITPSACTHT9";"S";"0062";"                PRES_VALID = ""N"""
"ITPSACTHT9";"S";"0063";"                *"
"ITPSACTHT9";"S";"0064";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTHT9";"S";"0065";"                SI HJOU_SECTAFF <> "" """
"ITPSACTHT9";"S";"0066";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTHT9";"S";"0067";"                SINON"
"ITPSACTHT9";"S";"0068";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTHT9";"S";"0069";"                FINSI"
"ITPSACTHT9";"S";"0070";"                *"
"ITPSACTHT9";"S";"0071";"                SI PRES_MODE_TRV = "" """
"ITPSACTHT9";"S";"0072";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHT9";"S";"0073";"                FINSI"
"ITPSACTHT9";"S";"0074";"                *"
