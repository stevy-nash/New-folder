"SRETEN";"S";"0035";"*"
"SRETEN";"S";"0036";"* Déclaration des donnees locales"
"SRETEN";"S";"0037";"*"
"SRETEN";"S";"0038";"SI HJOU_DATE <= TEMP_DATJOU"
"SRETEN";"S";"0039";"   HJOU_IJQABSPLFJ = HJOU_IJQABSPLFT"
