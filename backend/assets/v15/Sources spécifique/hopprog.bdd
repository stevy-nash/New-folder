"ITPSACTHTA";"S";"0046";"*"
"ITPSACTHTA";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTHTA";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTHTA";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHTA";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTHTA";"S";"0051";"    FINSI"
"ITPSACTHTA";"S";"0052";"FINSI"
"ITPSACTHTA";"S";"0053";"* Employé géré en activité"
"ITPSACTHTA";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTHTA";"S";"0055";"   SI HJOU_IJIACTI <> ""0"""
"ITPSACTHTA";"S";"0056";"        * Calcul de la présence activité le dimanche"
"ITPSACTHTA";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTHTA";"S";"0058";"        SI HJOU_JOUR = ""7"""
"ITPSACTHTA";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTHTA";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTHTA";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTHTA";"S";"0062";"                * d'activité à justifier"
"ITPSACTHTA";"S";"0063";"                PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTHTA";"S";"0064";"                PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTHTA";"S";"0065";"                *"
"ITPSACTHTA";"S";"0066";"                SI PRES_MODE_TRV = "" """
"ITPSACTHTA";"S";"0067";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHTA";"S";"0068";"                FINSI"
"ITPSACTHTA";"S";"0069";"                *"
"ITPSACTHTA";"S";"0070";"                * ----------------------------------------------------------------------------------"
"ITPSACTHTA";"S";"0071";"                *"
"ITPSACTHTA";"S";"0072";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTHTA";"S";"0073";"                *                              (A décommenter si besoin)"
"ITPSACTHTA";"S";"0074";"                *"
"ITPSACTHTA";"S";"0075";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTHTA";"S";"0076";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test des"
"ITPSACTHTA";"S";"0077";"                * heures totales différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTHTA";"S";"0078";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTHTA";"S";"0079";"                *"
"ITPSACTHTA";"S";"0080";"                * SI HJOU_IJRBHORVAH <> 0"
"ITPSACTHTA";"S";"0081";"                    PRES_TPS_PRES = HJOU_IJRBHORVAH"
"ITPSACTHTA";"S";"0082";"                * SINON"
"ITPSACTHTA";"S";"0083";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTHTA";"S";"0084";"                * FINSI"
"ITPSACTHTA";"S";"0085";"                * ----------------------------------------------------------------------------------"
"ITPSACTHTA";"S";"0086";"                *"
"ITPSACTHTA";"S";"0087";"                PRES_TPS_IMPUTE = 0"
"ITPSACTHTA";"S";"0088";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTHTA";"S";"0089";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTHTA";"S";"0090";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTHTA";"S";"0091";"                    POUR EVENEMENTS"
"ITPSACTHTA";"S";"0092";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTHTA";"S";"0093";"                    FINPOUR"
"ITPSACTHTA";"S";"0094";"                FINSI"
"ITPSACTHTA";"S";"0095";"                * Calcul de l'écart"
"ITPSACTHTA";"S";"0096";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTHTA";"S";"0097";"            FINSI"
"ITPSACTHTA";"S";"0098";"        FINSI"
"ITPSACTHTA";"S";"0099";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTHTA";"S";"0100";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTHTA";"S";"0101";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTHTA";"S";"0102";"        FINSI"
"ITPSACTHTA";"S";"0103";"   FINSI"
"ITPSACTHTA";"S";"0104";"FINSI"
"ITPSACTHTA";"S";"0105";"*"
"ITPSACTHTA";"S";"0106";"FIN"
