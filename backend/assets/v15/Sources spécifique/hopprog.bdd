"SANOM";"S";"0012";"*"
"SANOM";"S";"0013";"*----------------------------------------------------------------------"
"SANOM";"S";"0014";"*"
"SANOM";"S";"0015";"*"
"SANOM";"S";"0016";"* Rôle : Gestion des anoamlies spécifiques"
"SANOM";"S";"0017";"*"
"SANOM";"S";"0018";"*"
"SANOM";"S";"0019";"***********************************************************************"
"SANOM";"S";"0020";"*"
"SANOM";"S";"0021";"* Création compteur"
"SANOM";"S";"0022";"DEBDICO"
"SANOM";"S";"0023";"   PARD_SDIVMHSUP;O;A10;X;;;123456789;II;;C2;""Déclaration HS à payer"";"
"SANOM";"S";"0024";"   PARD_SDIVMHSUPR;O;A10;X;;;123456789;II;;C2;""Déclaration HS à récupérer"";"
"SANOM";"S";"0025";"FINDICO"
"SANOM";"S";"0026";"* Création anomalie"
"SANOM";"S";"0027";"DEBANO"
"SANOM";"S";"0028";"   253;9;""Vous ne pouvez pas saisir des HS récup et HS paie sur une même journée"";"
"SANOM";"S";"0029";"   254;9;""Pas droit aux HS à payer uniquement HS à récupérer"";"
"SANOM";"S";"0030";"   260;5;""Absence à qualifier saisie sur la journée"";"
"SANOM";"S";"0031";"   265;5;""Motif devant être saisie dans CrossTalent"";"
"SANOM";"S";"0032";"   250;7;""Dépassement du contingeant d'heures supplémentaires"";"
"SANOM";"S";"0033";"   320;8;""Horaire forfait jour pour un collaborateur non forfait jour"";"
"SANOM";"S";"0034";"FINANO"
"SANOM";"S";"0035";"*"
"SANOM";"S";"0036";"* Déclaration des donnees locales"
"SANOM";"S";"0037";"*"
"SANOM";"S";"0038";"DEF LOCA_HSRECUP N2"
"SANOM";"S";"0039";"LOCA_HSRECUP = 0"
"SANOM";"S";"0040";"DEF LOCA_HSPAIE N2"
"SANOM";"S";"0041";"LOCA_HSPAIE = 0"
"SANOM";"S";"0042";"DEF LOCA_JS N2"
"SANOM";"S";"0043";"LOCA_JS = 0"
"SANOM";"S";"0044";"DEF LOCA_MOTIF A10"
"SANOM";"S";"0045";"LOCA_MOTIF = "" """
"SANOM";"S";"0046";"DEF LOCA_FAMILLE A2"
"SANOM";"S";"0047";"LOCA_FAMILLE = "" """
"SANOM";"S";"0048";"DEF LOCA_ABSENCEJ N2"
"SANOM";"S";"0049";"LOCA_ABSENCEJ = 0"
"SANOM";"S";"0050";"*"
"SANOM";"S";"0051";"DEF LOCA_HORCODE A10"
"SANOM";"S";"0052";"LOCA_HORCODE = "" """
"SANOM";"S";"0053";"DEF LOCA_CHGHOR N2"
"SANOM";"S";"0054";"LOCA_CHGHOR = 0"
"SANOM";"S";"0055";"DEF LOCA_OK N2"
"SANOM";"S";"0056";"LOCA_OK = 0"
"SANOM";"S";"0057";"*"
"SANOM";"S";"0058";"DEF LOCA_ABSENJ T6.2"
"SANOM";"S";"0059";"LOCA_ABSENJ = PROF_ABSENJ"
"SANOM";"S";"0060";"DEF LOCA_ABSENM T6.2"
"SANOM";"S";"0061";"LOCA_ABSENM = PROF_ABSENM"
"SANOM";"S";"0062";"DEF LOCA_ABSENS T6.2"
"SANOM";"S";"0063";"LOCA_ABSENS = PROF_ABSENS"
"SANOM";"S";"0064";"*"
"SANOM";"S";"0065";"POUR ACTIVITES"
"SANOM";"S";"0066";"   SI HABS_MOTIF = ""JSOL"""
"SANOM";"S";"0067";"      LOCA_JS = 1"
"SANOM";"S";"0068";"   FINSI"
"SANOM";"S";"0069";"FINPOUR"
"SANOM";"S";"0070";"*"
"SANOM";"S";"0071";"* GCF - Valorisation de paie particulière pour les journalistes >>"
"SANOM";"S";"0072";"*"
"SANOM";"S";"0073";"SI PROF_PRETHEO > 0.02"
"SANOM";"S";"0074";"   SI HJOU_SJQCATEGOR = ""J"""
"SANOM";"S";"0075";"      SI HJOU_SJQFORFJR <> ""1"""
"SANOM";"S";"0076";"         SI HORC_SHIHOREF > 0.00"
"SANOM";"S";"0077";"* Profil de la rédaction"
"SANOM";"S";"0078";"            SI HJOU_PROFIL(1:3) = ""RED"""
"SANOM";"S";"0079";"               LOCA_ABSENM = HORC_SHIHOREF / 2"
"SANOM";"S";"0080";"               LOCA_ABSENS = HORC_SHIHOREF / 2"
"SANOM";"S";"0081";"               LOCA_ABSENJ = HORC_SHIHOREF"
"SANOM";"S";"0082";"            FINSI"
"SANOM";"S";"0083";"         FINSI"
"SANOM";"S";"0084";"      FINSI"
"SANOM";"S";"0085";"   FINSI"
"SANOM";"S";"0086";"FINSI"
"SANOM";"S";"0087";"*"
"SANOM";"S";"0088";"* * GCF <<"
"SANOM";"S";"0089";"*"
"SANOM";"S";"0090";"POUR ACTIVITES"
"SANOM";"S";"0091";"   SI HABS_MOTIF = PARD_SDIVMHSUP"
"SANOM";"S";"0092";"      LOCA_HSPAIE = 1"
"SANOM";"S";"0093";"   FINSI"
"SANOM";"S";"0094";"   SI HABS_MOTIF = PARD_SDIVMHSUPR"
"SANOM";"S";"0095";"      LOCA_HSRECUP = 1"
"SANOM";"S";"0096";"   FINSI"
"SANOM";"S";"0097";"   SI HABS_MOTYPE = ""A"""
"SANOM";"S";"0098";"      SI HABS_VALORIS = ""J"""
"SANOM";"S";"0099";"         SI MOTI_IMIGTTEFFE <> ""1"""
"SANOM";"S";"0100";"            SI HABS_MOTIF <> ""JF"""
"SANOM";"S";"0101";"               LOCA_ABSENCEJ = 1"
"SANOM";"S";"0102";"            FINSI"
"SANOM";"S";"0103";"         FINSI"
"SANOM";"S";"0104";"      FINSI"
"SANOM";"S";"0105";"   FINSI"
"SANOM";"S";"0106";"FINPOUR"
"SANOM";"S";"0107";"*"
"SANOM";"S";"0108";"SI LOCA_HSPAIE = 1"
"SANOM";"S";"0109";"   SI LOCA_HSRECUP = 1"
"SANOM";"S";"0110";"      ANOMALIE 253"
"SANOM";"S";"0111";"      SI TEMP_CNMOTIF = PARD_SDIVMHSUP"
"SANOM";"S";"0112";"      OU TEMP_CNMOTIF = PARD_SDIVMHSUPR"
"SANOM";"S";"0113";"         TEMP_CNRETOUR = 2"
"SANOM";"S";"0114";"         TEMP_CNMESS = 253"
"SANOM";"S";"0115";"      FINSI"
"SANOM";"S";"0116";"   FINSI"
"SANOM";"S";"0117";"FINSI"
"SANOM";"S";"0118";"*"
"SANOM";"S";"0119";"SI HJOU_IJIGHSUPPR = ""1"""
"SANOM";"S";"0120";"   SI LOCA_HSPAIE = 1"
"SANOM";"S";"0121";"      ANOMALIE 254"
"SANOM";"S";"0122";"      SI TEMP_CNMOTIF = PARD_SDIVMHSUP"
"SANOM";"S";"0123";"         TEMP_CNRETOUR = 2"
"SANOM";"S";"0124";"         TEMP_CNMESS = 254"
"SANOM";"S";"0125";"      FINSI"
"SANOM";"S";"0126";"   FINSI"
"SANOM";"S";"0127";"FINSI"
"SANOM";"S";"0128";"*"
"SANOM";"S";"0129";"* Anoamlie si absence et saisie de HS"
"SANOM";"S";"0130";"SI LOCA_ABSENCEJ = 1"
"SANOM";"S";"0131";"   SI LOCA_HSPAIE = 1"
"SANOM";"S";"0132";"   OU LOCA_HSRECUP = 1"
"SANOM";"S";"0133";"      ANOMALIE 298"
"SANOM";"S";"0134";"   FINSI"
"SANOM";"S";"0135";"FINSI"
"SANOM";"S";"0136";"*"
"SANOM";"S";"0137";"POUR ACTIVITES"
"SANOM";"S";"0138";"* Présence d'un motif AAQ >>"
"SANOM";"S";"0139";"   SI HABS_MOTIF = ""AAQ"""
"SANOM";"S";"0140";"      ANOMALIE 260"
"SANOM";"S";"0141";"   FINSI"
"SANOM";"S";"0142";"* Saisie d'un motif devant être envoyé par CrossTalent"
"SANOM";"S";"0143";"   SI MOTI_SMICROSST = ""1"""
"SANOM";"S";"0144";"      SI HABS_UTILMOD(1:2) = ""00"""
"SANOM";"S";"0145";"*         ANOMALIE 265"
"SANOM";"S";"0146";"      FINSI"
"SANOM";"S";"0147";"   FINSI"
"SANOM";"S";"0148";"*"
"SANOM";"S";"0149";"* Alerte si formation sur repos"
"SANOM";"S";"0150";"   SI HABS_MOTIF = ""FOR"""
"SANOM";"S";"0151";"      SI HJOU_IJQPRETHEJ <= 0.02"
"SANOM";"S";"0152";"         ANOMALIE 269"
"SANOM";"S";"0153";"      FINSI"
"SANOM";"S";"0154";"   FINSI"
"SANOM";"S";"0155";"FINPOUR"
"SANOM";"S";"0156";"*"
"SANOM";"S";"0157";"***** Si droit RJF et journaliste, obligartoire de poser un RJF sur JF travaillé >> ****************"
"SANOM";"S";"0158";"*"
"SANOM";"S";"0159";"SI LOCA_JS <> 1"
"SANOM";"S";"0160";"   SI TEMP_STQJF = ""JJF"""
"SANOM";"S";"0161";"      SI HJOU_SJQCATEGOR = ""J"""
"SANOM";"S";"0162";"         SI HJOU_IJQPRETHEJ > 0"
"SANOM";"S";"0163";"*"
"SANOM";"S";"0164";"* Vérif priorité RJF"
"SANOM";"S";"0165";"            SI HJOU_SJRDRJF > 0"
"SANOM";"S";"0166";"               SI HJOU_SJRSRJF > 0"
"SANOM";"S";"0167";"*"
"SANOM";"S";"0168";"                  POUR ACTIVITES"
"SANOM";"S";"0169";"                     SI HABS_MOTYPE = ""A"""
"SANOM";"S";"0170";"                        SI MOTI_PRIORITE < ""5"""
"SANOM";"S";"0171";"                           SI HABS_MOTIF = PARD_SDIVMCOPRI"
"SANOM";"S";"0172";"                           OU HABS_MOTIF = PARD_IDIVMCOREL"
"SANOM";"S";"0173";"                           OU HABS_MOTIF = PARD_IDIVMCOANT"
"SANOM";"S";"0174";"                           OU HABS_MOTIF = PARD_IDIVMDONCP"
"SANOM";"S";"0175";"*                     OU HABS_MOTIF = PARD_IDIVMRTTSA"
"SANOM";"S";"0176";"                           OU HABS_MOTIF = ""CET"""
"SANOM";"S";"0177";"                           OU HABS_MOTIF = ""CSJ"""
"SANOM";"S";"0178";"                           OU MOTI_FAMILLE = ""RE"""
"SANOM";"S";"0179";"                              SI HABS_MOTIF <> PARD_SDIVMRJF"
"SANOM";"S";"0180";"                                 SI HABS_MOTIF <> ""JF"""
"SANOM";"S";"0181";"                                    ANOMALIE 290"
"SANOM";"S";"0182";"*                                    SI TEMP_CNMOTIF = HABS_MOTIF"
"SANOM";"S";"0183";"*                                       TEMP_CNRETOUR = 2"
"SANOM";"S";"0184";"*                                       TEMP_CNMESS = 290"
"SANOM";"S";"0185";"*                                    FINSI"
"SANOM";"S";"0186";"                                 FINSI"
"SANOM";"S";"0187";"                              FINSI"
"SANOM";"S";"0188";"                           FINSI"
"SANOM";"S";"0189";"                        FINSI"
"SANOM";"S";"0190";"                     FINSI"
"SANOM";"S";"0191";"                  FINPOUR"
"SANOM";"S";"0192";"*"
"SANOM";"S";"0193";"               FINSI"
"SANOM";"S";"0194";"            FINSI"
"SANOM";"S";"0195";"*"
"SANOM";"S";"0196";"         FINSI"
"SANOM";"S";"0197";"      FINSI"
"SANOM";"S";"0198";"   FINSI"
"SANOM";"S";"0199";"FINSI"
"SANOM";"S";"0200";"*"
"SANOM";"S";"0201";"***** Anomalie si horaires à planifier >> **********************************************************"
"SANOM";"S";"0202";"*"
"SANOM";"S";"0203";"LIREVALPRE LOCA_HORCODE HJOU_HORCODE"
"SANOM";"S";"0204";"SI LOCA_HORCODE <> HJOU_HORCODE"
"SANOM";"S";"0205";"   LOCA_CHGHOR = 1"
"SANOM";"S";"0206";"FINSI"
"SANOM";"S";"0207";"*"
"SANOM";"S";"0208";"* Exclu intérimaire"
"SANOM";"S";"0209";"SI HJOU_MATRI(1:7) <> ""INTERIM"""
"SANOM";"S";"0210";"   SI HJOU_DATE = TEMP_DATJOU"
"SANOM";"S";"0211";"   OU LOCA_CHGHOR = 1"
"SANOM";"S";"0212";"      SI HORC_HORCODE = ""-----APLAN"""
"SANOM";"S";"0213";"         ANOMALIE 300"
"SANOM";"S";"0214";"      FINSI"
"SANOM";"S";"0215";"* Anomalie si le début du code horaire est différant du code société du collaborateur >>"
"SANOM";"S";"0216";"      SI HORC_HORCODE(1:2) <> ""--"""
"SANOM";"S";"0217";"         SI HORC_HORCODE(1:2) <> HJOU_SJQSOCIETE(1:2)"
"SANOM";"S";"0218";"            ANOMALIE 301"
"SANOM";"S";"0219";"         FINSI"
"SANOM";"S";"0220";"      FINSI"
"SANOM";"S";"0221";"* Anomalie si code horaire est différant du code direction du collaborateur >>"
"SANOM";"S";"0222";"      SI HORC_HORCODE(3:3) <> ""---"""
"SANOM";"S";"0223";"         SI HORC_HORCODE(3:3) <> HJOU_SECTORI(1:3)"
"SANOM";"S";"0224";"            ANOMALIE 311"
"SANOM";"S";"0225";"* Exception"
"SANOM";"S";"0226";"            SI HORC_HORCODE(3:3) = ""RED"""
"SANOM";"S";"0227";"               SI HJOU_SECTORI(1:3) = ""DRE"""
"SANOM";"S";"0228";"                  SUPANOM 311"
"SANOM";"S";"0229";"               FINSI"
"SANOM";"S";"0230";"            FINSI"
"SANOM";"S";"0231";"         FINSI"
"SANOM";"S";"0232";"      FINSI"
"SANOM";"S";"0233";"   FINSI"
"SANOM";"S";"0234";"FINSI"
"SANOM";"S";"0235";"*"
"SANOM";"S";"0236";"****** Gestion des anomalies en cas de JS >> *******************************************************"
"SANOM";"S";"0237";"*"
"SANOM";"S";"0238";"* Identification JS"
"SANOM";"S";"0239";"POUR ACTIVITES"
"SANOM";"S";"0240";"*"
"SANOM";"S";"0241";"* Contrôle absence saisie >>"
"SANOM";"S";"0242";"   SI HABS_MOTYPE = ""A"""
"SANOM";"S";"0243";"      SI HABS_VALORIS <> ""H"""
"SANOM";"S";"0244";"         LOCA_MOTIF = HABS_MOTIF"
"SANOM";"S";"0245";"         LOCA_FAMILLE = MOTI_FAMILLE"
"SANOM";"S";"0246";"      FINSI"
"SANOM";"S";"0247";"   FINSI"
"SANOM";"S";"0248";"*"
"SANOM";"S";"0249";"FINPOUR"
"SANOM";"S";"0250";"*"
"SANOM";"S";"0251";"SI LOCA_JS = 1"
"SANOM";"S";"0252";"* Si CP ou CPR"
"SANOM";"S";"0253";"   SI LOCA_MOTIF = PARD_SDIVMCOPRI"
"SANOM";"S";"0254";"   OU LOCA_MOTIF = PARD_IDIVMCOREL"
"SANOM";"S";"0255";"   OU LOCA_MOTIF = PARD_SDIVMRJF"
"SANOM";"S";"0256";"* Pr1 : Contrôle si reste RTT"
"SANOM";"S";"0257";"      SI HJOU_IJRSNBJRTT >= 1"
"SANOM";"S";"0258";"         ANOMALIE 295"
"SANOM";"S";"0259";"         SI TEMP_CNMOTIF = LOCA_MOTIF"
"SANOM";"S";"0260";"**modif Holtine CDS le 23/03/2026"
"SANOM";"S";"0261";"*TEMP_CNRETOUR = 2"
"SANOM";"S";"0262";"            TEMP_CNRETOUR = 1"
"SANOM";"S";"0263";"**fin modif"
"SANOM";"S";"0264";"            TEMP_CNMESS = 295"
"SANOM";"S";"0265";"         FINSI"
"SANOM";"S";"0266";"      SINON"
"SANOM";"S";"0267";"* Pr 2 : Contrôle si reste récup"
"SANOM";"S";"0268";"         SI HJOU_IJRSHSMREH >= 7.00"
"SANOM";"S";"0269";"         OU HJOU_SJRSJFF >= 1"
"SANOM";"S";"0270";"         OU HJOU_SJRSJTR >= 1"
"SANOM";"S";"0271";"         OU HJOU_SJRSPFI >= 1"
"SANOM";"S";"0272";"         OU HJOU_SJRSRCI >= 1"
"SANOM";"S";"0273";"         OU HJOU_SJRSRD >= 1"
"SANOM";"S";"0274";"         OU HJOU_SJRSRDH >= 1"
"SANOM";"S";"0275";"         OU HJOU_SJRSREP >= 1"
"SANOM";"S";"0276";"         OU HJOU_SJRSRJF >= 1"
"SANOM";"S";"0277";"            ANOMALIE 296"
"SANOM";"S";"0278";"            SI TEMP_CNMOTIF = LOCA_MOTIF"
"SANOM";"S";"0279";"***modif Hotline CDS le 08/04/2026"
"SANOM";"S";"0280";"*TEMP_CNRETOUR = 2"
"SANOM";"S";"0281";"               TEMP_CNRETOUR = 1"
"SANOM";"S";"0282";"**fin modif"
"SANOM";"S";"0283";"               TEMP_CNMESS = 296"
"SANOM";"S";"0284";"            FINSI"
"SANOM";"S";"0285";"         FINSI"
"SANOM";"S";"0286";"      FINSI"
"SANOM";"S";"0287";"   FINSI"
"SANOM";"S";"0288";"* Si récup"
"SANOM";"S";"0289";"   SI LOCA_FAMILLE = ""RE"""
"SANOM";"S";"0290";"* Différant de RJF"
"SANOM";"S";"0291";"      SI LOCA_MOTIF <> PARD_SDIVMRJF"
"SANOM";"S";"0292";"* Contrôle si reste RTT"
"SANOM";"S";"0293";"         SI HJOU_IJRSNBJRTT >= 1"
"SANOM";"S";"0294";"            ANOMALIE 295"
"SANOM";"S";"0295";"            SI TEMP_CNMOTIF = LOCA_MOTIF"
"SANOM";"S";"0296";"               TEMP_CNRETOUR = 2"
"SANOM";"S";"0297";"               TEMP_CNMESS = 295"
"SANOM";"S";"0298";"            FINSI"
"SANOM";"S";"0299";"         FINSI"
"SANOM";"S";"0300";"      FINSI"
"SANOM";"S";"0301";"   FINSI"
"SANOM";"S";"0302";"*"
"SANOM";"S";"0303";"* Motif interdit sur JS"
"SANOM";"S";"0304";"   SI LOCA_MOTIF = ""CET"""
"SANOM";"S";"0305";"   OU LOCA_MOTIF = ""CSJ"""
"SANOM";"S";"0306";"   OU LOCA_MOTIF = PARD_IDIVMCOANT"
"SANOM";"S";"0307";"   OU LOCA_MOTIF = PARD_IDIVMDONCP"
"SANOM";"S";"0308";"      ANOMALIE 297"
"SANOM";"S";"0309";"      SI TEMP_CNMOTIF = LOCA_MOTIF"
"SANOM";"S";"0310";"         TEMP_CNRETOUR = 2"
"SANOM";"S";"0311";"         TEMP_CNMESS = 297"
"SANOM";"S";"0312";"      FINSI"
"SANOM";"S";"0313";"   FINSI"
"SANOM";"S";"0314";"*"
"SANOM";"S";"0315";"FINSI"
"SANOM";"S";"0316";"*"
"SANOM";"S";"0317";"* Dépassement du contingeant d'heures payées >>"
"SANOM";"S";"0318";"SI HJOU_DATE = TEMP_DATJOU"
"SANOM";"S";"0319";"OU HJOU_DATE(5:4) = ""1231"""
"SANOM";"S";"0320";"   SI HJOU_IJRHSHMAJA > PARD_IDISCONTHS"
"SANOM";"S";"0321";"      ANOMALIE 250"
"SANOM";"S";"0322";"   FINSI"
"SANOM";"S";"0323";"FINSI"
"SANOM";"S";"0324";"*"
"SANOM";"S";"0325";"* Anomalie repos TP sur temps plein"
"SANOM";"S";"0326";"SI HJOU_IJITYPCTRA = 100"
"SANOM";"S";"0327";"OU HJOU_IJITYPCTRA = 0"
"SANOM";"S";"0328";"   SI PROF_SPITYPREP = ""1"""
"SANOM";"S";"0329";"   OU PROF_SPITYPREP = ""2"""
"SANOM";"S";"0330";"      ANOMALIE 312"
"SANOM";"S";"0331";"   FINSI"
"SANOM";"S";"0332";"FINSI"
"SANOM";"S";"0333";"*"
"SANOM";"S";"0334";"* Anomalie si profil forfait jour sur non forfait jour"
"SANOM";"S";"0335";"SI HJOU_PROFIL(1:4) = ""FORF"""
"SANOM";"S";"0336";"   SI HJOU_SJQCATEGOR = ""C"""
"SANOM";"S";"0337";"   OU HJOU_SJQCATEGOR = ""J"""
"SANOM";"S";"0338";"      LOCA_OK = 1"
"SANOM";"S";"0339";"   FINSI"
"SANOM";"S";"0340";"   SI HJOU_SJQFORFJR = ""1"""
"SANOM";"S";"0341";"      LOCA_OK = 1"
"SANOM";"S";"0342";"   FINSI"
"SANOM";"S";"0343";"*"
"SANOM";"S";"0344";"   SI LOCA_OK <> 1"
"SANOM";"S";"0345";"      ANOMALIE 320"
"SANOM";"S";"0346";"   FINSI"
"SANOM";"S";"0347";"*"
"SANOM";"S";"0348";"FINSI"
"SANOM";"S";"0349";"*"
"SANOM";"S";"0350";"* Flag si demande en attente de HPLUS plus 5 jours dans le passé"
"SANOM";"S";"0351";"*"
"SANOM";"S";"0352";"DEF LOCA_DATJOU D"
"SANOM";"S";"0353";"LOCA_DATJOU = "" """
"SANOM";"S";"0354";"DEF LOCA_SEUILANO N3"
"SANOM";"S";"0355";"LOCA_SEUILANO = -1"
"SANOM";"S";"0356";"*"
"SANOM";"S";"0357";"SI HJOU_DATE < TEMP_DATJOU"
"SANOM";"S";"0358";"*"
"SANOM";"S";"0359";"*      DATAJT TEMP_DATJOU 12 ""J"" LOCA_SEUILANO"
"SANOM";"S";"0360";"*      LOCA_DATJOU = TEMP_DXFINPER"
"SANOM";"S";"0361";"*"
"SANOM";"S";"0362";"* On utilise pas de seuil ici"
"SANOM";"S";"0363";"   LOCA_DATJOU = TEMP_DATJOU"
"SANOM";"S";"0364";"*"
"SANOM";"S";"0365";"   SI HJOU_DATE < LOCA_DATJOU"
"SANOM";"S";"0366";"      POUR WACTIVITES"
"SANOM";"S";"0367";"         SI WABS_MOTIF = PARD_SDIVMHSUP"
"SANOM";"S";"0368";"         OU WABS_MOTIF = PARD_SDIVMHSUPR"
"SANOM";"S";"0369";"            HJOU_IJRSJDISP4 = 1"
