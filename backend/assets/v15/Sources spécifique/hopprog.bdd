"SHSUPPDIM";"S";"0554";"         FINSI"
"SHSUPPDIM";"S";"0555";"      FINSI"
"SHSUPPDIM";"S";"0556";"   FINSI"
"SHSUPPDIM";"S";"0557";"FINPOUR"
"SHSUPPDIM";"S";"0558";"*"
"SHSUPPDIM";"S";"0559";"* Force la récup >>"
"SHSUPPDIM";"S";"0560";"SI LOCA_MODALITE = ""1"""
"SHSUPPDIM";"S";"0561";"OU LOCA_MODALITE = ""4"""
"SHSUPPDIM";"S";"0562";"   HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM";"S";"0563";"FINSI"
"SHSUPPDIM";"S";"0564";"* Choix non fait à cause d'une délégation par exemple >>"
"SHSUPPDIM";"S";"0565";"SI LOCA_MODALITE = ""3"""
"SHSUPPDIM";"S";"0566";"*   SI HJOU_SJRHSPRC = "" """
"SHSUPPDIM";"S";"0567";"*      HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM";"S";"0568";"*   FINSI"
"SHSUPPDIM";"S";"0569";"FINSI"
"SHSUPPDIM";"S";"0570";"* Force le paiement >>"
"SHSUPPDIM";"S";"0571";"SI LOCA_MODALITE = ""2"""
"SHSUPPDIM";"S";"0572";"   HJOU_SJRHSPRC = ""P"""
"SHSUPPDIM";"S";"0573";"FINSI"
"SHSUPPDIM";"S";"0574";"*"
"SHSUPPDIM";"S";"0575";"SI HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM";"S";"0576";"   LOCA_RECUP = 1"
"SHSUPPDIM";"S";"0577";"FINSI"
"SHSUPPDIM";"S";"0578";"*"
"SHSUPPDIM";"S";"0579";"POUR ACTIVITES"
"SHSUPPDIM";"S";"0580";"   SI HABS_MOTIF = ""JF"""
"SHSUPPDIM";"S";"0581";"      LOCA_FERI = 1"
"SHSUPPDIM";"S";"0582";"   FINSI"
"SHSUPPDIM";"S";"0583";"FINPOUR"
"SHSUPPDIM";"S";"0584";"*"
"SHSUPPDIM";"S";"0585";"***** Raz de la base HS le lundi >> ****************************************************************"
"SHSUPPDIM";"S";"0586";"*"
"SHSUPPDIM";"S";"0587";"SI HJOU_JOUR = ""1"""
"SHSUPPDIM";"S";"0588";"   SI LOCA_GESTHS = ""2"""
"SHSUPPDIM";"S";"0589";"      HJOU_IJRBHSMPAH = 0"
"SHSUPPDIM";"S";"0590";"      HJOU_IJRBHPAYEE = 0"
"SHSUPPDIM";"S";"0591";"   FINSI"
"SHSUPPDIM";"S";"0592";"* Raz le premier lundi du cycle si LOCA_GESTHS = 3"
"SHSUPPDIM";"S";"0593";"   SI LOCA_GESTHS = ""3"""
"SHSUPPDIM";"S";"0594";"      SI HJOU_RANG = 1"
"SHSUPPDIM";"S";"0595";"         HJOU_IJRBHSMPAH = 0"
"SHSUPPDIM";"S";"0596";"         HJOU_IJRTHEOCYC = 0"
"SHSUPPDIM";"S";"0597";"         HJOU_IJRBHPAYEE = 0"
"SHSUPPDIM";"S";"0598";"      FINSI"
"SHSUPPDIM";"S";"0599";"   FINSI"
"SHSUPPDIM";"S";"0600";"FINSI"
"SHSUPPDIM";"S";"0601";"* SI HJOU_JOUR = ""7"""
"SHSUPPDIM";"S";"0602";"SI LOCA_GESTHS = ""3"""
"SHSUPPDIM";"S";"0603";"* Cumul de la duree theorique du cycle"
"SHSUPPDIM";"S";"0604";"   HJOU_IJRTHEOCYC = HJOU_IJRTHEOCYC + HJOU_IJQPRETHEJ"
"SHSUPPDIM";"S";"0605";"FINSI"
"SHSUPPDIM";"S";"0606";"* FINSI"
"SHSUPPDIM";"S";"0607";"*"
"SHSUPPDIM";"S";"0608";"*SI HJOU_IJIGHSUPPM <> ""0"""
"SHSUPPDIM";"S";"0609";"SI LOCA_DROIT = 1"
"SHSUPPDIM";"S";"0610";"*"
"SHSUPPDIM";"S";"0611";"* Calcul de la base des HS"
"SHSUPPDIM";"S";"0612";"   LOCA_BASEHS = HJOU_IJQTTEFFEJ"
"SHSUPPDIM";"S";"0613";"*"
"SHSUPPDIM";"S";"0614";"* Pour EV et PE on neutralise le jour fériés"
"SHSUPPDIM";"S";"0615";"   SI HJOU_SJQSOCIETE = ""EV"""
"SHSUPPDIM";"S";"0616";"   OU HJOU_SJQSOCIETE = ""PE"""
"SHSUPPDIM";"S";"0617";"      SI LOCA_FERI = 1"
"SHSUPPDIM";"S";"0618";"         LOCA_BASEHS = HJOU_IJQPRETHEJ - HJOU_IJQTTEFFEJ"
"SHSUPPDIM";"S";"0619";"         SI LOCA_BASEHS < 0"
"SHSUPPDIM";"S";"0620";"            LOCA_BASEHS = LOCA_BASEHS * -1"
"SHSUPPDIM";"S";"0621";"         FINSI"
"SHSUPPDIM";"S";"0622";"      FINSI"
"SHSUPPDIM";"S";"0623";"   FINSI"
"SHSUPPDIM";"S";"0624";"*"
"SHSUPPDIM";"S";"0625";"* Alimentation des bases hebdo"
"SHSUPPDIM";"S";"0626";"   HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH + LOCA_BASEHS"
"SHSUPPDIM";"S";"0627";"   HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE + HJOU_IJQHPAYEES"
"SHSUPPDIM";"S";"0628";"*"
"SHSUPPDIM";"S";"0629";"* On exclut les interventions sur astreintes >>"
"SHSUPPDIM";"S";"0630";"   HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH - LOCA_INTAST"
"SHSUPPDIM";"S";"0631";"   HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE - LOCA_INTAST"
"SHSUPPDIM";"S";"0632";"   SI HJOU_IJRBHSMPAH < 0"
"SHSUPPDIM";"S";"0633";"      HJOU_IJRBHSMPAH = 0"
"SHSUPPDIM";"S";"0634";"   FINSI"
"SHSUPPDIM";"S";"0635";"   SI HJOU_IJRBHPAYEE < 0"
"SHSUPPDIM";"S";"0636";"      HJOU_IJRBHPAYEE = 0"
"SHSUPPDIM";"S";"0637";"   FINSI"
"SHSUPPDIM";"S";"0638";"*"
"SHSUPPDIM";"S";"0639";"* Les HS sur le dimanche pour la diffusion sont payées"
"SHSUPPDIM";"S";"0640";"   SI LOCA_SPEC = ""DIFF"""
"SHSUPPDIM";"S";"0641";"      SI HJOU_JOUR = ""7"""
"SHSUPPDIM";"S";"0642";"         HJOU_IJRBHSMPAH = HJOU_IJRBHSMPAH - LOCA_DURHS"
"SHSUPPDIM";"S";"0643";"         HJOU_IJRBHPAYEE = HJOU_IJRBHPAYEE - LOCA_DURHS"
"SHSUPPDIM";"S";"0644";"      FINSI"
"SHSUPPDIM";"S";"0645";"   FINSI"
"SHSUPPDIM";"S";"0646";"*"
"SHSUPPDIM";"S";"0647";"FINSI"
"SHSUPPDIM";"S";"0648";"*"
"SHSUPPDIM";"S";"0649";"* Raz du cumul des HS en debut de periode d'annualisation"
"SHSUPPDIM";"S";"0650";"SI HJOU_DATE(5:4) = ""0101"""
"SHSUPPDIM";"S";"0651";"   HJOU_IJRHSHMAJA = 0"
"SHSUPPDIM";"S";"0652";"   HJOU_IJRHSMPAYA = 0"
"SHSUPPDIM";"S";"0653";"   HJOU_IJRHRECANN = 0"
"SHSUPPDIM";"S";"0654";"FINSI"
"SHSUPPDIM";"S";"0655";"*"
"SHSUPPDIM";"S";"0656";"*** initialisation de la base HS par consigne"
"SHSUPPDIM";"S";"0657";"POUR ACTIVITES"
"SHSUPPDIM";"S";"0658";"   SI HABS_MOTIF = ""ZBHS"""
"SHSUPPDIM";"S";"0659";"      HJOU_IJRBHSMPAH = HABS_MOTIDUR"
"SHSUPPDIM";"S";"0660";"   FINSI"
"SHSUPPDIM";"S";"0661";"   SI HABS_MOTIF = ""ZBPA"""
"SHSUPPDIM";"S";"0662";"      HJOU_IJRBHPAYEE = HABS_MOTIDUR"
"SHSUPPDIM";"S";"0663";"   FINSI"
"SHSUPPDIM";"S";"0664";"FINPOUR"
"SHSUPPDIM";"S";"0665";"*"
"SHSUPPDIM";"S";"0666";"***** DEB - Calcul des HS Jour par jour, le dimanche ou fin de cycle >> ****************************"
"SHSUPPDIM";"S";"0667";"*"
"SHSUPPDIM";"S";"0668";"SI LOCA_DROIT = 1"
"SHSUPPDIM";"S";"0669";"*"
"SHSUPPDIM";"S";"0670";"****** Appréciation au jour le jour >> *************************************************************"
"SHSUPPDIM";"S";"0671";"*"
"SHSUPPDIM";"S";"0672";"   SI LOCA_GESTHS = ""4"""
"SHSUPPDIM";"S";"0673";"*"
"SHSUPPDIM";"S";"0674";"      SI LOCA_SDIGESTHS <> ""1"""
"SHSUPPDIM";"S";"0675";"         SI HJOU_IJQTTEFFEJ > HJOU_IJQPRETHEJ"
"SHSUPPDIM";"S";"0676";"            LOCA_HSUP = HJOU_IJQTTEFFEJ - HJOU_IJQPRETHEJ"
"SHSUPPDIM";"S";"0677";"* On enlève les inter astreintes"
"SHSUPPDIM";"S";"0678";"            LOCA_HSUP = LOCA_HSUP - LOCA_INTAST"
"SHSUPPDIM";"S";"0679";"            SI LOCA_HSUP < 0"
"SHSUPPDIM";"S";"0680";"               LOCA_HSUP = 0"
"SHSUPPDIM";"S";"0681";"            FINSI"
"SHSUPPDIM";"S";"0682";"            HJOU_SJQTHSHC = LOCA_HSUP"
"SHSUPPDIM";"S";"0683";"         FINSI"
"SHSUPPDIM";"S";"0684";"      SINON"
"SHSUPPDIM";"S";"0685";"* Appréciation en fonction des HSUP saisies uniquement"
"SHSUPPDIM";"S";"0686";"         LOCA_HSUP = HJOU_SJRHSPAIE + HJOU_SJRHSRECUP"
"SHSUPPDIM";"S";"0687";"         HJOU_SJQTHSHC = LOCA_HSUP"
"SHSUPPDIM";"S";"0688";"*"
"SHSUPPDIM";"S";"0689";"      FINSI"
"SHSUPPDIM";"S";"0690";"*"
"SHSUPPDIM";"S";"0691";"* Cas de l'industrie >>"
"SHSUPPDIM";"S";"0692";"      SI HJOU_SECTORI(1:3) = ""DIN"""
"SHSUPPDIM";"S";"0693";"*"
"SHSUPPDIM";"S";"0694";"         LOCA_SEUIL1 = PARD_SDISHSMTX2"
"SHSUPPDIM";"S";"0695";"         LOCA_SEUIL2 = PARD_SDISHSMTX3 - PARD_SDISHSMTX2"
"SHSUPPDIM";"S";"0696";"*"
"SHSUPPDIM";"S";"0697";"* Cas particuliers du service expédition pour la société MO"
"SHSUPPDIM";"S";"0698";"         SI HJOU_SJQSOCIETE = ""MO"""
"SHSUPPDIM";"S";"0699";"            SI HJOU_SJITYPSERV = ""EXPEDITION"""
"SHSUPPDIM";"S";"0700";"               LOCA_SEUIL1 = 0.00"
"SHSUPPDIM";"S";"0701";"               LOCA_SEUIL2 = 4.00"
"SHSUPPDIM";"S";"0702";"*"
"SHSUPPDIM";"S";"0703";"* FFT025003707 : Cas particulier des CDD de l'expédition >>"
"SHSUPPDIM";"S";"0704";"               SI CTRA_TYPCTRA = ""CDD"""
"SHSUPPDIM";"S";"0705";"                  LOCA_HSUP = 0"
"SHSUPPDIM";"S";"0706";"                  SI HJOU_JOUR = ""7"""
"SHSUPPDIM";"S";"0707";"                     SI HJOU_IJRTTEFFEH > LOCA_35H"
"SHSUPPDIM";"S";"0708";"                        HJOU_SJQHS5087 = HJOU_IJRTTEFFEH - LOCA_35H"
"SHSUPPDIM";"S";"0709";"                        SI HJOU_SJQHS5087 > LOCA_4H"
"SHSUPPDIM";"S";"0710";"                           HJOU_SJQHS150I = HJOU_SJQHS5087 - LOCA_4H"
"SHSUPPDIM";"S";"0711";"                           HJOU_SJQHS5087 = LOCA_4H"
"SHSUPPDIM";"S";"0712";"                        FINSI"
"SHSUPPDIM";"S";"0713";"                     FINSI"
"SHSUPPDIM";"S";"0714";"                  FINSI"
"SHSUPPDIM";"S";"0715";"               FINSI"
"SHSUPPDIM";"S";"0716";"* FFT025003707 <<"
"SHSUPPDIM";"S";"0717";"*"
"SHSUPPDIM";"S";"0718";"            FINSI"
"SHSUPPDIM";"S";"0719";"         FINSI"
"SHSUPPDIM";"S";"0720";"* HS 133%"
"SHSUPPDIM";"S";"0721";"         SI LOCA_HSUP > 0"
"SHSUPPDIM";"S";"0722";"            SI LOCA_HSUP <= LOCA_SEUIL1"
"SHSUPPDIM";"S";"0723";"               HJOU_SJQHS133 = HJOU_SJQHS133 + LOCA_HSUP"
"SHSUPPDIM";"S";"0724";"               LOCA_HSUP = 0"
"SHSUPPDIM";"S";"0725";"            SINON"
"SHSUPPDIM";"S";"0726";"               HJOU_SJQHS133 = HJOU_SJQHS133 + LOCA_SEUIL1"
"SHSUPPDIM";"S";"0727";"               LOCA_HSUP = LOCA_HSUP - LOCA_SEUIL1"
"SHSUPPDIM";"S";"0728";"            FINSI"
"SHSUPPDIM";"S";"0729";"         FINSI"
"SHSUPPDIM";"S";"0730";"* HS 150%"
"SHSUPPDIM";"S";"0731";"         SI LOCA_HSUP > 0"
"SHSUPPDIM";"S";"0732";"            SI LOCA_HSUP <= LOCA_SEUIL2"
"SHSUPPDIM";"S";"0733";"               HJOU_SJQHS150I = HJOU_SJQHS150I + LOCA_HSUP"
"SHSUPPDIM";"S";"0734";"               LOCA_HSUP = 0"
"SHSUPPDIM";"S";"0735";"            SINON"
"SHSUPPDIM";"S";"0736";"               HJOU_SJQHS150I = HJOU_SJQHS150I + LOCA_SEUIL2"
"SHSUPPDIM";"S";"0737";"               LOCA_HSUP = LOCA_HSUP - LOCA_SEUIL2"
"SHSUPPDIM";"S";"0738";"            FINSI"
"SHSUPPDIM";"S";"0739";"         FINSI"
"SHSUPPDIM";"S";"0740";"* HS 200%"
"SHSUPPDIM";"S";"0741";"         SI LOCA_HSUP > 0"
"SHSUPPDIM";"S";"0742";"            HJOU_SJQHSP200 = HJOU_SJQHSP200 + LOCA_HSUP"
"SHSUPPDIM";"S";"0743";"            LOCA_HSUP = 0"
"SHSUPPDIM";"S";"0744";"         FINSI"
"SHSUPPDIM";"S";"0745";"*"
"SHSUPPDIM";"S";"0746";"* Si heures de nuit calculé et travailleur exceptionnelle de nuit"
"SHSUPPDIM";"S";"0747";"         SI HJOU_SJQTHSHC > 0"
"SHSUPPDIM";"S";"0748";"            SI HJOU_IJQHNUITTO > 0"
"SHSUPPDIM";"S";"0749";"               SI HJOU_IJQHNUITTO >= HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0750";"* Cas société MO >>"
"SHSUPPDIM";"S";"0751";"                  SI HJOU_SJQSOCIETE = ""MO"""
"SHSUPPDIM";"S";"0752";"                     SI HORC_SHITNUIT <> ""1"""
"SHSUPPDIM";"S";"0753";"                        SI TEMP_ITQNUITMOT >= HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0754";"                           HJOU_SJQHS133N = HJOU_SJQHS133"
"SHSUPPDIM";"S";"0755";"                           HJOU_SJQHS133 = 0"
"SHSUPPDIM";"S";"0756";"                           HJOU_SJQHS150N = HJOU_SJQHS150I"
"SHSUPPDIM";"S";"0757";"                           HJOU_SJQHS150I = 0"
"SHSUPPDIM";"S";"0758";"                           HJOU_SJQHS200NM = HJOU_SJQHSP200"
"SHSUPPDIM";"S";"0759";"                           HJOU_SJQHSP200 = 0"
"SHSUPPDIM";"S";"0760";"                        FINSI"
"SHSUPPDIM";"S";"0761";"                     FINSI"
"SHSUPPDIM";"S";"0762";"* FFT025003687 - Exception rotative"
"SHSUPPDIM";"S";"0763";"                     SI HJOU_SJITYPSERV = ""ROTATIVE"""
"SHSUPPDIM";"S";"0764";"                        HJOU_SJQHS133N = HJOU_SJQHS133"
"SHSUPPDIM";"S";"0765";"                        HJOU_SJQHS133 = 0"
"SHSUPPDIM";"S";"0766";"                        HJOU_SJQHS150N = HJOU_SJQHS150I"
"SHSUPPDIM";"S";"0767";"                        HJOU_SJQHS150I = 0"
"SHSUPPDIM";"S";"0768";"                        HJOU_SJQHS200NM = HJOU_SJQHSP200"
"SHSUPPDIM";"S";"0769";"                        HJOU_SJQHSP200 = 0"
"SHSUPPDIM";"S";"0770";"                     FINSI"
"SHSUPPDIM";"S";"0771";"                  FINSI"
"SHSUPPDIM";"S";"0772";"* Cas société YR >>"
"SHSUPPDIM";"S";"0773";"                  SI HJOU_SJQSOCIETE = ""YR"""
"SHSUPPDIM";"S";"0774";"                     SI EMPL_SEIANCYR <> ""1"""
"SHSUPPDIM";"S";"0775";"                        HJOU_SJQHS133N = HJOU_SJQHS133"
"SHSUPPDIM";"S";"0776";"                        HJOU_SJQHS133 = 0"
"SHSUPPDIM";"S";"0777";"                        HJOU_SJQHS150N = HJOU_SJQHS150I"
"SHSUPPDIM";"S";"0778";"                        HJOU_SJQHS150I = 0"
"SHSUPPDIM";"S";"0779";"                        HJOU_SJQHS200NY = HJOU_SJQHSP200"
"SHSUPPDIM";"S";"0780";"                        HJOU_SJQHSP200 = 0"
"SHSUPPDIM";"S";"0781";"                     FINSI"
"SHSUPPDIM";"S";"0782";"                  FINSI"
"SHSUPPDIM";"S";"0783";"*"
"SHSUPPDIM";"S";"0784";"               FINSI"
"SHSUPPDIM";"S";"0785";"            FINSI"
"SHSUPPDIM";"S";"0786";"         FINSI"
"SHSUPPDIM";"S";"0787";"*"
"SHSUPPDIM";"S";"0788";"* Si récupération ?"
"SHSUPPDIM";"S";"0789";"         SI LOCA_RECUP = 1"
"SHSUPPDIM";"S";"0790";"*"
"SHSUPPDIM";"S";"0791";"* Cummul annuel récup."
"SHSUPPDIM";"S";"0792";"            HJOU_IJRHRECANN = HJOU_IJRHRECANN + HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0793";"*"
"SHSUPPDIM";"S";"0794";"            HJOU_SJQHS133 = HJOU_SJQHS133 * LOCA_TAUX1I"
"SHSUPPDIM";"S";"0795";"            HJOU_SJQHS133N = HJOU_SJQHS133N * LOCA_TAUX1I"
"SHSUPPDIM";"S";"0796";"*"
"SHSUPPDIM";"S";"0797";"            HJOU_SJQHS150I = HJOU_SJQHS150I * LOCA_TAUX2I"
"SHSUPPDIM";"S";"0798";"            HJOU_SJQHS150N = HJOU_SJQHS150N * LOCA_TAUX2I"
"SHSUPPDIM";"S";"0799";"*"
"SHSUPPDIM";"S";"0800";"            HJOU_SJQHSP200 = HJOU_SJQHSP200 * LOCA_TAUX3I"
"SHSUPPDIM";"S";"0801";"            HJOU_SJQHS200NM = HJOU_SJQHS200NM * LOCA_TAUX3I"
"SHSUPPDIM";"S";"0802";"            HJOU_SJQHS200NY = HJOU_SJQHS200NY * LOCA_TAUX3I"
"SHSUPPDIM";"S";"0803";"*"
"SHSUPPDIM";"S";"0804";"* Alimente récupération >>"
"SHSUPPDIM";"S";"0805";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQHS133"
"SHSUPPDIM";"S";"0806";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQHS133N"
"SHSUPPDIM";"S";"0807";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQHS150I"
"SHSUPPDIM";"S";"0808";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQHS150N"
"SHSUPPDIM";"S";"0809";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQHSP200"
"SHSUPPDIM";"S";"0810";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQHS200NM"
"SHSUPPDIM";"S";"0811";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQHS200NY"
"SHSUPPDIM";"S";"0812";"*"
"SHSUPPDIM";"S";"0813";"* RAZ paiement"
"SHSUPPDIM";"S";"0814";"            HJOU_SJQHS133 = 0"
"SHSUPPDIM";"S";"0815";"            HJOU_SJQHS133N = 0"
"SHSUPPDIM";"S";"0816";"            HJOU_SJQHS150I = 0"
"SHSUPPDIM";"S";"0817";"            HJOU_SJQHS150N = 0"
"SHSUPPDIM";"S";"0818";"            HJOU_SJQHSP200 = 0"
"SHSUPPDIM";"S";"0819";"            HJOU_SJQHS200NM = 0"
"SHSUPPDIM";"S";"0820";"            HJOU_SJQHS200NY = 0"
"SHSUPPDIM";"S";"0821";"*"
"SHSUPPDIM";"S";"0822";"         FINSI"
"SHSUPPDIM";"S";"0823";"*"
"SHSUPPDIM";"S";"0824";"* Fin industrie >>"
"SHSUPPDIM";"S";"0825";"      FINSI"
"SHSUPPDIM";"S";"0826";"*"
"SHSUPPDIM";"S";"0827";"* Autres services que industrie en gestion HS jour par jour"
"SHSUPPDIM";"S";"0828";"*"
"SHSUPPDIM";"S";"0829";"      SI HJOU_SECTORI(1:3) <> ""DIN"""
"SHSUPPDIM";"S";"0830";"         SI LOCA_HSUP > 0"
"SHSUPPDIM";"S";"0831";"*"
"SHSUPPDIM";"S";"0832";"* Cas particulier de la PFI"
"SHSUPPDIM";"S";"0833";"            SI HJOU_SJITYPSERV = ""PFI"""
"SHSUPPDIM";"S";"0834";"*"
"SHSUPPDIM";"S";"0835";"* Majo à 133% pour les ouvriers sinon 125%"
"SHSUPPDIM";"S";"0836";"               SI HJOU_SJQCATEGOR = ""O"""
"SHSUPPDIM";"S";"0837";"                  HJOU_SJQHS133 = HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0838";"               SINON"
"SHSUPPDIM";"S";"0839";"                  HJOU_IJQHS1MAPA = HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0840";"               FINSI"
"SHSUPPDIM";"S";"0841";"*"
"SHSUPPDIM";"S";"0842";"               LOCA_TOTHSREC = HJOU_IJRHRECANN + HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0843";"*"
"SHSUPPDIM";"S";"0844";"* Si inférieur à 36h alors récup sinon paiement"
"SHSUPPDIM";"S";"0845";"               SI LOCA_TOTHSREC <= LOCA_SEUILPFI"
"SHSUPPDIM";"S";"0846";"* Cummul annuel récup."
"SHSUPPDIM";"S";"0847";"                  HJOU_IJRHRECANN = HJOU_IJRHRECANN + HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0848";"*"
"SHSUPPDIM";"S";"0849";"                  HJOU_SJQHS133 = HJOU_SJQHS133 * LOCA_TAUX1I"
"SHSUPPDIM";"S";"0850";"                  HJOU_IJQHS1MAPA = HJOU_IJQHS1MAPA * LOCA_TAUX1"
"SHSUPPDIM";"S";"0851";"* Compteur de récup avec majoration"
"SHSUPPDIM";"S";"0852";"                  HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQHS133"
"SHSUPPDIM";"S";"0853";"                  HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_IJQHS1MAPA"
"SHSUPPDIM";"S";"0854";"*"
"SHSUPPDIM";"S";"0855";"                  HJOU_SJQHS133 = 0"
"SHSUPPDIM";"S";"0856";"                  HJOU_IJQHS1MAPA = 0"
"SHSUPPDIM";"S";"0857";"               SINON"
"SHSUPPDIM";"S";"0858";"                  LOCA_DIFF = HJOU_IJRHSMPAYA"
"SHSUPPDIM";"S";"0859";"                  SI LOCA_DIFF < LOCA_SEUILPFI"
"SHSUPPDIM";"S";"0860";"* Dans ce cas une partie va en récup l'autre en paiement"
"SHSUPPDIM";"S";"0861";"                     LOCA_DIFF = LOCA_SEUILPFI - LOCA_DIFF"
"SHSUPPDIM";"S";"0862";"                     HJOU_IJRHRECANN = HJOU_IJRHRECANN + LOCA_DIFF"
"SHSUPPDIM";"S";"0863";"*"
"SHSUPPDIM";"S";"0864";"                     SI HJOU_SJQHS133 > LOCA_DIFF"
"SHSUPPDIM";"S";"0865";"                        HJOU_SJQHS133 = HJOU_SJQHS133 - LOCA_DIFF"
"SHSUPPDIM";"S";"0866";"                        LOCA_DIFF = LOCA_DIFF * LOCA_TAUX1I"
"SHSUPPDIM";"S";"0867";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + LOCA_DIFF"
"SHSUPPDIM";"S";"0868";"                        LOCA_DIFF = 0"
"SHSUPPDIM";"S";"0869";"                     FINSI"
"SHSUPPDIM";"S";"0870";"                     SI HJOU_IJQHS1MAPA > LOCA_DIFF"
"SHSUPPDIM";"S";"0871";"                        HJOU_IJQHS1MAPA = HJOU_IJQHS1MAPA - LOCA_DIFF"
"SHSUPPDIM";"S";"0872";"                        LOCA_DIFF = LOCA_DIFF * LOCA_TAUX1"
"SHSUPPDIM";"S";"0873";"                        HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + LOCA_DIFF"
"SHSUPPDIM";"S";"0874";"                        LOCA_DIFF = 0"
"SHSUPPDIM";"S";"0875";"                     FINSI"
"SHSUPPDIM";"S";"0876";"*"
"SHSUPPDIM";"S";"0877";"                  FINSI"
"SHSUPPDIM";"S";"0878";"               FINSI"
"SHSUPPDIM";"S";"0879";"*"
"SHSUPPDIM";"S";"0880";"            SINON"
"SHSUPPDIM";"S";"0881";"* Autre service => Pas de majoration"
"SHSUPPDIM";"S";"0882";"* Cummul annuel récup."
"SHSUPPDIM";"S";"0883";"               HJOU_IJRHRECANN = HJOU_IJRHRECANN + HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0884";"* Compteur de récup sans majoration"
"SHSUPPDIM";"S";"0885";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJQTHSHC"
"SHSUPPDIM";"S";"0886";"            FINSI"
"SHSUPPDIM";"S";"0887";"*"
"SHSUPPDIM";"S";"0888";"         FINSI"
"SHSUPPDIM";"S";"0889";"      FINSI"
"SHSUPPDIM";"S";"0890";"*"
"SHSUPPDIM";"S";"0891";"   FINSI"
"SHSUPPDIM";"S";"0892";"*"
"SHSUPPDIM";"S";"0893";"***** Appréciation des HS au dimanche ou fin de cycle >> *******************************************"
"SHSUPPDIM";"S";"0894";"*"
"SHSUPPDIM";"S";"0895";"   SI LOCA_GESTHS = ""2"""
"SHSUPPDIM";"S";"0896";"   OU LOCA_GESTHS = ""3"""
"SHSUPPDIM";"S";"0897";"*"
"SHSUPPDIM";"S";"0898";"      SI HJOU_JOUR = ""7"""
"SHSUPPDIM";"S";"0899";"      OU LOCA_SORTIE = 1"
"SHSUPPDIM";"S";"0900";"*"
"SHSUPPDIM";"S";"0901";"* Cas particulier pour la société LI (Edition)"
"SHSUPPDIM";"S";"0902";"         SI LOCA_SPEC = ""EDIT"""
"SHSUPPDIM";"S";"0903";"* Si pas d'absences donne 1h de récup"
"SHSUPPDIM";"S";"0904";"            SI HJOU_SJRABPBOH = 0"
"SHSUPPDIM";"S";"0905";"               HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + LOCA_1H"
"SHSUPPDIM";"S";"0906";"            FINSI"
"SHSUPPDIM";"S";"0907";"         FINSI"
"SHSUPPDIM";"S";"0908";"*"
"SHSUPPDIM";"S";"0909";"* Calcul HS le dimanche >>"
"SHSUPPDIM";"S";"0910";"         SI LOCA_GESTHS = ""2"""
"SHSUPPDIM";"S";"0911";"*"
"SHSUPPDIM";"S";"0912";"* Garde fou - récup par défaut >>"
"SHSUPPDIM";"S";"0913";"            SI HJOU_SJRHSPRC = "" """
"SHSUPPDIM";"S";"0914";"               HJOU_SJRHSPRC = ""R"""
"SHSUPPDIM";"S";"0915";"               LOCA_RECUP = 1"
"SHSUPPDIM";"S";"0916";"            FINSI"
"SHSUPPDIM";"S";"0917";"*"
"SHSUPPDIM";"S";"0918";"            SI LOCA_SORTIE = 1"
"SHSUPPDIM";"S";"0919";"               LOCA_HORHEB = HJOU_IJRPRETHEH"
"SHSUPPDIM";"S";"0920";"               LOCA_HORCOH = HJOU_IJRPRETHEH"
"SHSUPPDIM";"S";"0921";"            SINON"
"SHSUPPDIM";"S";"0922";"               LOCA_HORHEB = HJOU_HORHEB"
"SHSUPPDIM";"S";"0923";"               LOCA_HORCOH = PARD_IDIVHORCOH"
"SHSUPPDIM";"S";"0924";"            FINSI"
"SHSUPPDIM";"S";"0925";"*"
"SHSUPPDIM";"S";"0926";"*            SI LOCA_SEUIL1 > LOCA_HORHEB"
