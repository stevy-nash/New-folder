"SACQCPAN";"S";"0046";"* Déclaration des donnees locales"
"SACQCPAN";"S";"0047";"* Variables utilisées pour calculer la date de reference"
"SACQCPAN";"S";"0048";"DEF LOCA_DATE D"
"SACQCPAN";"S";"0049";"DEF LOCA_REF N2"
"SACQCPAN";"S";"0050";"* Variables utilisées pour le calcul de l'ancienneté"
"SACQCPAN";"S";"0051";"DEF LOCA_ANCIEN N6.1"
"SACQCPAN";"S";"0052";"LOCA_ANCIEN = 0"
"SACQCPAN";"S";"0053";"DEF LOCA_DRANCT N6.1"
"SACQCPAN";"S";"0054";"LOCA_DRANCT = 0"
"SACQCPAN";"S";"0055";"DEF LOCA_DRANC N6.1"
"SACQCPAN";"S";"0056";"LOCA_DRANC = 0"
"SACQCPAN";"S";"0057";"DEF LOCA_CA N1"
"SACQCPAN";"S";"0058";"LOCA_CA = 0"
"SACQCPAN";"S";"0059";"*"
"SACQCPAN";"S";"0060";"DEF LOCA_ANCJ N4"
"SACQCPAN";"S";"0061";"LOCA_ANCJ = 0"
"SACQCPAN";"S";"0062";"DEF LOCA_ANCA N4"
"SACQCPAN";"S";"0063";"LOCA_ANCA = 0"
"SACQCPAN";"S";"0064";"DEF LOCA_AGE N4"
"SACQCPAN";"S";"0065";"LOCA_AGE = 0"
"SACQCPAN";"S";"0066";"*"
"SACQCPAN";"S";"0067";"SI CONF_ITIVMREFCP <> "" """
"SACQCPAN";"S";"0068";"* Calcul de la date de référence CP"
"SACQCPAN";"S";"0069";"* stockage de l'année du jour de l'historique"
"SACQCPAN";"S";"0070";"   LOCA_DATE(1:4) = HJOU_DATE(1:4)"
"SACQCPAN";"S";"0071";"* stockage du mois de reference"
"SACQCPAN";"S";"0072";"   LOCA_REF << CONF_ITIVMREFCP(3:2)"
"SACQCPAN";"S";"0073";"* stokage du mois de reference"
"SACQCPAN";"S";"0074";"   LOCA_DATE(5:2) << LOCA_REF"
"SACQCPAN";"S";"0075";"* stockage du jour de reference"
"SACQCPAN";"S";"0076";"   LOCA_REF << CONF_ITIVMREFCP(1:2)"
"SACQCPAN";"S";"0077";"* loca_date contient maintenant l'année du jour de l'historique"
"SACQCPAN";"S";"0078";"* et le mois et le jour de reference"
"SACQCPAN";"S";"0079";"   LOCA_DATE(7:2) << LOCA_REF"
"SACQCPAN";"S";"0080";"SINON"
"SACQCPAN";"S";"0081";"   LOCA_DATE = "" """
"SACQCPAN";"S";"0082";"FINSI"
"SACQCPAN";"S";"0083";"*"
"SACQCPAN";"S";"0084";"*"
"SACQCPAN";"S";"0085";"* Définition LOT1/LOT2"
