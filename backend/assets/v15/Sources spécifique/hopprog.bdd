"ITHEOJ";"S";"0081";"* alimentation de la théorie journalière par le profil"
"ITHEOJ";"S";"0082";"**HJOU_IJQPRETHEJ = PROF_PRETHEO"
"ITHEOJ";"S";"0083";"*"
"ITHEOJ";"S";"0084";"SI PROF_PLAGEDYN = 1"
"ITHEOJ";"S";"0085";"*"
"ITHEOJ";"S";"0086";"* employés gérés sur HQ Ressources"
"ITHEOJ";"S";"0087";"   SI EMPL_IEIEMPRESS = ""1"""
"ITHEOJ";"S";"0088";"*"
"ITHEOJ";"S";"0089";"* détection des absences pour ne pas perdre les plages"
"ITHEOJ";"S";"0090";"      POUR ACTIVITES"
"ITHEOJ";"S";"0091";"* motif en jour/matin/après-midi"
"ITHEOJ";"S";"0092";"         SI HABS_MOTYPE <> ""C"""
"ITHEOJ";"S";"0093";"            SI HABS_VALORIS = ""J"""
"ITHEOJ";"S";"0094";"            OU HABS_VALORIS = ""M"""
"ITHEOJ";"S";"0095";"            OU HABS_VALORIS = ""A"""
"ITHEOJ";"S";"0096";"               LOCA_ABS = 1"
"ITHEOJ";"S";"0097";"            FINSI"
"ITHEOJ";"S";"0098";"         FINSI"
"ITHEOJ";"S";"0099";"         SI HABS_MOTYPE = ""A"""
"ITHEOJ";"S";"0100";"* absence en heures avec bornes"
"ITHEOJ";"S";"0101";"            SI HABS_VALORIS = ""H"""
"ITHEOJ";"S";"0102";"               SI HABS_HRADEB < 100"
"ITHEOJ";"S";"0103";"                  SI HABS_HRADEB >= HJOU_IJQENTREE1"
"ITHEOJ";"S";"0104";"                     SI HABS_HRADEB <= HJOU_IJQSORTIE1"
"ITHEOJ";"S";"0105";"                        SI HABS_HRAFIN <= HJOU_IJQSORTIE1"
