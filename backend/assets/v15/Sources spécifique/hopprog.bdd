"ICONSCPSCH";"S";"0557";"                            FINSI"
"ICONSCPSCH";"S";"0558";"                        SINON"
"ICONSCPSCH";"S";"0559";"                            * Travail en demi-journée"
"ICONSCPSCH";"S";"0560";"                            SI PROF_ABSENJ = PROF_ABSENM"
"ICONSCPSCH";"S";"0561";"                            OU PROF_ABSENJ = PROF_ABSENS"
"ICONSCPSCH";"S";"0562";"                                SI PROF_ABSENJ <> 0"
"ICONSCPSCH";"S";"0563";"                                    * Jour travaillé"
"ICONSCPSCH";"S";"0564";"                                    SI HJOU_IJRSCPTRA >= 0.5"
"ICONSCPSCH";"S";"0565";"                                        * Jour non travaillé"
