"IGCSEGLISS";"S";"0285";"               SI HJOU_IJRMSCSE >= LOCA_RESTET"
"IGCSEGLISS";"S";"0286";"*Pris mensuel = durée du motif"
"IGCSEGLISS";"S";"0287";"                  HJOU_IJRMPCSE = HJOU_IJRMPCSE + LOCA_RESTET"
"IGCSEGLISS";"S";"0288";"                  LOCA_RESTET = 0"
"IGCSEGLISS";"S";"0289";"               SINON"
"IGCSEGLISS";"S";"0290";"                  SI HJOU_IJRMSCSE > 0"
"IGCSEGLISS";"S";"0291";"                     LOCA_RESTET = LOCA_RESTET - HJOU_IJRMSCSE"
"IGCSEGLISS";"S";"0292";"*Pris mensuel = solde mensuel"
"IGCSEGLISS";"S";"0293";"                     HJOU_IJRMPCSE = HJOU_IJRMPCSE + HJOU_IJRMSCSE"
"IGCSEGLISS";"S";"0294";"*Solde mensuel"
"IGCSEGLISS";"S";"0295";"                     HJOU_IJRMSCSE = 0"
"IGCSEGLISS";"S";"0296";"                  FINSI"
"IGCSEGLISS";"S";"0297";"*Si il n'y a pas assez du solde on va consommer dans les"
"IGCSEGLISS";"S";"0298";"*compteurs de stockage si il y a"
"IGCSEGLISS";"S";"0299";"                  LOCA_CONSORELI = 1"
"IGCSEGLISS";"S";"0300";"               FINSI"
"IGCSEGLISS";"S";"0301";"            SINON"
