"SDACQ";"S";"0014";"*"
"SDACQ";"S";"0015";"*"
"SDACQ";"S";"0016";"* Rôle :"
"SDACQ";"S";"0017";"*"
"SDACQ";"S";"0018";"* Stocker les dates d'acquistion pour le calcul d'acquisition des droit CP, RTT etc..."
"SDACQ";"S";"0019";"* Le but étant pour stocker l'acqusition sur un historique de 5 ans"
"SDACQ";"S";"0020";"*"
"SDACQ";"S";"0021";"*"
"SDACQ";"S";"0022";"*----------------------------------------------------------------------"
"SDACQ";"S";"0023";"*"
"SDACQ";"S";"0024";"* Dates d'effet :"
"SDACQ";"S";"0025";"*"
"SDACQ";"S";"0026";"* Date début : ../../...., Date fin   : ../../...."
"SDACQ";"S";"0027";"*----------------------------------------------------------------------"
"SDACQ";"S";"0028";"*"
"SDACQ";"S";"0029";"*"
"SDACQ";"S";"0030";"*"
"SDACQ";"S";"0031";"*"
"SDACQ";"S";"0032";"DEBDICO"
"SDACQ";"S";"0033";"   EMPL_SEIDATACQ9;O;D10,0;X;;;56789;;;V3;""Date ACQ N+1"";"
"SDACQ";"S";"0034";"   EMPL_SEIDATACQN;O;D10,0;X;;;56789;;;V3;""Date ACQ N"";"
"SDACQ";"S";"0035";"   EMPL_SEIDATACQ1;O;D10,0;X;;;56789;;;V3;""Date ACQ N-1"";"
"SDACQ";"S";"0036";"   EMPL_SEIDATACQ2;O;D10,0;X;;;56789;;;V3;""Date ACQ N-2"";"
"SDACQ";"S";"0037";"   EMPL_SEIDATACQ3;O;D10,0;X;;;56789;;;V3;""Date ACQ N-3"";"
"SDACQ";"S";"0038";"   EMPL_SEIDATACQ4;O;D10,0;X;;;56789;;;V3;""Date ACQ N-4"";"
"SDACQ";"S";"0039";"   EMPL_SEIDATACQ5;O;D10,0;X;;;56789;;;V3;""Date ACQ N-5"";"
"SDACQ";"S";"0040";"   EMPL_SEIDATFIN;O;D10,0;X;;;56789;;;V3;""Date fin historique agent"";"
"SDACQ";"S";"0041";"   *"
"SDACQ";"S";"0042";"   EMPL_SEIDFCNT;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N Temporaire"";"
"SDACQ";"S";"0043";"   EMPL_SEIDFCN9T;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N+1 Temporaire"";"
"SDACQ";"S";"0044";"   *"
"SDACQ";"S";"0045";"   EMPL_SEIDATFCN;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N"";"
"SDACQ";"S";"0046";"   EMPL_SEIDATFCN9;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N+1"";"
"SDACQ";"S";"0047";"   EMPL_SEIDATFCN1;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N-1"";"
"SDACQ";"S";"0048";"   EMPL_SEIDATFCN2;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N-2"";"
"SDACQ";"S";"0049";"   EMPL_SEIDATFCN3;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N-3"";"
"SDACQ";"S";"0050";"   EMPL_SEIDATFCN4;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N-4"";"
"SDACQ";"S";"0051";"   EMPL_SEIDATFCN5;O;D10,0;X;;;56789;;;V3;""Date fin ACQ N-5"";"
