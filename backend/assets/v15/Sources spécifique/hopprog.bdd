"SPAIECPT";"S";"0067";"   *   HJOU_SJRT303;O;N6,2;I;;;    56789;;SJRT303;V3;""Pris RTT/JRS - T303"";"
"SPAIECPT";"S";"0068";"   *   HJOU_SJRT305;O;N6,2;I;;;    56789;;SJRT305;V3;""Solde RTT/JRS - T305"";"
"SPAIECPT";"S";"0069";"   HJOU_SJRYA15;O;N6,1;I;;;    56789;;SJRYA15;V3;""Pris RTT/JRS sur période - 7058"";"
"SPAIECPT";"S";"0070";"   *   HJOU_SJRYA17;O;N6,1;I;;;    56789;;SJRYA17;V3;""Pris RTT/JRS pour bascule - YA17"";"
"SPAIECPT";"S";"0071";"   *   HJOU_SJRY830;?"
"SPAIECPT";"S";"0072";"   *   HJOU_SJRYA26;?"
