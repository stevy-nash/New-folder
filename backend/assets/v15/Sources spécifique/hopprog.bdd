"ITPSACTHTB";"S";"0046";"*"
"ITPSACTHTB";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTHTB";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTHTB";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTHTB";"S";"0050";"        HJOU_IJIACTI = SECH_ISIACTI"
"ITPSACTHTB";"S";"0051";"    FINSI"
"ITPSACTHTB";"S";"0052";"FINSI"
"ITPSACTHTB";"S";"0053";"* Employé géré en activité"
"ITPSACTHTB";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTHTB";"S";"0055";"    SI HJOU_IJIACTI <> ""0"""
"ITPSACTHTB";"S";"0056";"        * Calcul de la présence activité le dernier jour du mois"
"ITPSACTHTB";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTHTB";"S";"0058";"        SI TEMP_DATSUI(7:2) = ""01"""
"ITPSACTHTB";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTHTB";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTHTB";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTHTB";"S";"0062";"                * d'activité à justifier"
"ITPSACTHTB";"S";"0063";"                PRES_CLE_POP = HJOU_SECTORI"
"ITPSACTHTB";"S";"0064";"                SI HJOU_SECTAFF <> "" """
"ITPSACTHTB";"S";"0065";"                    PRES_CLE_POPAFF = HJOU_SECTAFF"
"ITPSACTHTB";"S";"0066";"                SINON"
"ITPSACTHTB";"S";"0067";"                    PRES_CLE_POPAFF = HJOU_SECTORI"
"ITPSACTHTB";"S";"0068";"                FINSI"
"ITPSACTHTB";"S";"0069";"                *"
"ITPSACTHTB";"S";"0070";"                SI PRES_MODE_TRV = "" """
"ITPSACTHTB";"S";"0071";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTHTB";"S";"0072";"                FINSI"
