"SRAZCO";"S";"0175";"****************************************************************************************************"
"SRAZCO";"S";"0176";"*"
"SRAZCO";"S";"0177";"* la réinitialisation des compteurs est effectuée"
"SRAZCO";"S";"0178";"* par rapport à l'indicateur dans les données globales datées"
"SRAZCO";"S";"0179";"SI PARD_IDIGRAZCPT = ""1"""
"SRAZCO";"S";"0180";"*   LOCA_RAZCPT = 1"
"SRAZCO";"S";"0181";"* On RAZ si rupture dans le contrat si continuité pas de RAZ >>"
"SRAZCO";"S";"0182";"   SI HJOU_DATE = CTRA_DATDEB"
"SRAZCO";"S";"0183";"      SI HJOU_SJQDEBC = 1"
"SRAZCO";"S";"0184";"*         LIREVALPRE LOCA_STC HJOU_SJQSTC"
"SRAZCO";"S";"0185";"*         SI LOCA_STC = 1"
"SRAZCO";"S";"0186";"         LOCA_RAZCPT = 1"
"SRAZCO";"S";"0187";"*         FINSI"
"SRAZCO";"S";"0188";"      FINSI"
"SRAZCO";"S";"0189";"   FINSI"
"SRAZCO";"S";"0190";"FINSI"
"SRAZCO";"S";"0191";"*"
"SRAZCO";"S";"0192";"* par rapport à la consigne ZRAZCT"
