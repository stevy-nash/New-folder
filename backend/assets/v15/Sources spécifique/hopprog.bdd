"ICONSCPCH";"S";"0101";"LOCA_VALCPR = "" """
"ICONSCPCH";"S";"0102";"DEF LOCA_VALCPAN A1"
"ICONSCPCH";"S";"0103";"LOCA_VALCPAN = "" """
"ICONSCPCH";"S";"0104";"DEF LOCA_VALCP A1"
"ICONSCPCH";"S";"0105";"LOCA_VALCP = "" """
"ICONSCPCH";"S";"0106";"DEF LOCA_VALCPA A1"
"ICONSCPCH";"S";"0107";"LOCA_VALCPA = "" """
