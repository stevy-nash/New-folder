"IMISSL";"S";"0030";"*"
"IMISSL";"S";"0031";"DEBDICO"
"IMISSL";"S";"0032";"   HJOU_IJRF2PBHSL;N;Z1;X;0;9;    56789;;IJRF2PBHSL;V2;""Flag prés. b.h.s. du lendemain (N2)"";"
"IMISSL";"S";"0033";"   HJOU_IJQMISBADV;N;T6,2;I;;;    56789;;;V2;""Présence hors site badgée la veille"";"
"IMISSL";"S";"0034";"   HJOU_IJQFMILPDJ;N;N2;I;;;    56789;;;V2;""Flag pause mérid. prés. h.s.bad. lend."";"
"IMISSL";"S";"0035";"FINDICO"
"IMISSL";"S";"0036";"*"
"IMISSL";"S";"0037";"DEBANO"
"IMISSL";"S";"0038";"   143;5;""Mission du lendemain annulée"";"
"IMISSL";"S";"0039";"FINANO"
"IMISSL";"S";"0040";"* Déclaration des donnees locales"
"IMISSL";"S";"0041";"*"
"IMISSL";"S";"0042";"DEF LOCA_DEJDEB T6.2"
"IMISSL";"S";"0043";"LOCA_DEJDEB = 0"
"IMISSL";"S";"0044";"DEF LOCA_DEJFIN T6.2"
"IMISSL";"S";"0045";"LOCA_DEJFIN = 0"
"IMISSL";"S";"0046";"DEF LOCA_DEJLIM T6.2"
"IMISSL";"S";"0047";"LOCA_DEJLIM = 0"
"IMISSL";"S";"0048";"DEF LOCA_SUP T6.2"
"IMISSL";"S";"0049";"LOCA_SUP = 0"
"IMISSL";"S";"0050";"DEF LOCA_INF T6.2"
"IMISSL";"S";"0051";"LOCA_INF = 0"
"IMISSL";"S";"0052";"DEF LOCA_DIF T6.2"
"IMISSL";"S";"0053";"LOCA_DIF = 0"
"IMISSL";"S";"0054";"DEF LOCA_IMPUT A6"
"IMISSL";"S";"0055";"LOCA_IMPUT = "" """
"IMISSL";"S";"0056";"DEF LOCA_MISSL T6.2"
"IMISSL";"S";"0057";"LOCA_MISSL = 0"
"IMISSL";"S";"0058";"DEF LOCA_DUREE T6.2"
"IMISSL";"S";"0059";"LOCA_DUREE = 0"
"IMISSL";"S";"0060";"DEF LOCA_PTMISS N1"
"IMISSL";"S";"0061";"LOCA_PTMISS = 0"
"IMISSL";"S";"0062";"DEF LOCA_DURDEJ T6.2"
"IMISSL";"S";"0063";"LOCA_DURDEJ = 0"
"IMISSL";"S";"0064";"DEF LOCA_SORTIE T6.2"
"IMISSL";"S";"0065";"LOCA_SORTIE = 0"
"IMISSL";"S";"0066";"DEF LOCA_RETMIS T6.2"
"IMISSL";"S";"0067";"LOCA_RETMIS = 0"
"IMISSL";"S";"0068";"SI HJOU_DATE <= TEMP_DATJOU"
"IMISSL";"S";"0069";"   SI HJOU_INMISS = ""3"""
"IMISSL";"S";"0070";"      PLAGE ""DJ"""
"IMISSL";"S";"0071";"      SI TEMP_TYPPLA <> "" """
"IMISSL";"S";"0072";"         LOCA_DEJDEB = TEMP_VALTRT1"
"IMISSL";"S";"0073";"         LOCA_DEJFIN = TEMP_VALTRT2"
"IMISSL";"S";"0074";"      FINSI"
"IMISSL";"S";"0075";"      POUR POINTAGES"
"IMISSL";"S";"0076";"* Récuperation de l'heure de badgeage"
"IMISSL";"S";"0077";"* si c'est un mouvement de sortie mission"
"IMISSL";"S";"0078";"         SI POIN_SENS = ""1"""
"IMISSL";"S";"0079";"            SI POIN_IMPUT = ""MISSL"""
"IMISSL";"S";"0080";"               LOCA_PTMISS = 1"
"IMISSL";"S";"0081";"               LOCA_IMPUT = POIN_IMPUT"
"IMISSL";"S";"0082";"               LOCA_SORTIE = POIN_HRETRAI"
"IMISSL";"S";"0083";"               HJOU_IJRF2PBHSL = ""1"""
"IMISSL";"S";"0084";"            FINSI"
"IMISSL";"S";"0085";"         FINSI"
"IMISSL";"S";"0086";"         SI POIN_SENS = ""0"""
"IMISSL";"S";"0087";"            LOCA_PTMISS = 0"
"IMISSL";"S";"0088";"* si retour mission sans depart dans la m?me journe"
"IMISSL";"S";"0089";"            SI LOCA_IMPUT = "" """
"IMISSL";"S";"0090";"               SI LOCA_RETMIS = 0"
"IMISSL";"S";"0091";"* on ne calcul du temps mission sur le retour"
"IMISSL";"S";"0092";"* uniquement dans le cas ou PROF_IPIVMISSDV > 0"
"IMISSL";"S";"0093";"                  SI PROF_IPIVMISSDV > 0"
"IMISSL";"S";"0094";"                     LOCA_RETMIS = POIN_HRETRAI"
"IMISSL";"S";"0095";"                     HJOU_IJRF2PBHSL = ""0"""
"IMISSL";"S";"0096";"                     LOCA_SORTIE = PROF_IPIVMISSDV"
"IMISSL";"S";"0097";"                     FAIRE CALMISS"
"IMISSL";"S";"0098";"                  SINON"
"IMISSL";"S";"0099";"                     HJOU_IJRF2PBHSL = ""0"""
"IMISSL";"S";"0100";"                  FINSI"
"IMISSL";"S";"0101";"               FINSI"
"IMISSL";"S";"0102";"            SINON"
"IMISSL";"S";"0103";"* il y a un retour dans la journee"
"IMISSL";"S";"0104";"               ANOMALIE 143"
"IMISSL";"S";"0105";"               HJOU_IJRF2PBHSL = ""0"""
"IMISSL";"S";"0106";"            FINSI"
"IMISSL";"S";"0107";"         FINSI"
"IMISSL";"S";"0108";"      FINPOUR"
"IMISSL";"S";"0109";"      LOCA_MISSL = LOCA_MISSL - LOCA_DURDEJ"
"IMISSL";"S";"0110";"      SI LOCA_MISSL > 0"
"IMISSL";"S";"0111";"         HJOU_IJQMISBADV = LOCA_MISSL"
"IMISSL";"S";"0112";"      FINSI"
"IMISSL";"S";"0113";"   FINSI"
"IMISSL";"S";"0114";"FINSI"
"IMISSL";"S";"0115";"FIN"
"IMISSL";"S";"0116";"***********************************************************"
"IMISSL";"S";"0117";"*** Procedure CALMISS"
"IMISSL";"S";"0118";"***********************************************************"
"IMISSL";"S";"0119";"PROC CALMISS"
"IMISSL";"S";"0120";"* retour mission apres l'heure autorisee"
"IMISSL";"S";"0121";"   SI LOCA_RETMIS > PROF_IPIHFPRBHS"
"IMISSL";"S";"0122";"      LOCA_RETMIS = PROF_IPIHFPRBHS"
"IMISSL";"S";"0123";"   FINSI"
"IMISSL";"S";"0124";"   LOCA_DUREE = LOCA_RETMIS - LOCA_SORTIE"
"IMISSL";"S";"0125";"* le repas est decompte de la mission dans le cas"
"IMISSL";"S";"0126";"* ou le depart est fait avant la borne debut dejeuner"
"IMISSL";"S";"0127";"* et le retour apres la borne fin dejeuner"
"IMISSL";"S";"0128";"   SI LOCA_RETMIS >= LOCA_DEJFIN"
"IMISSL";"S";"0129";"      SI LOCA_SORTIE <= LOCA_DEJDEB"
"IMISSL";"S";"0130";"         LOCA_DURDEJ = PROF_IPIGPAMMIS"
"IMISSL";"S";"0131";"         HJOU_IJQFMILPDJ = 1"
"IMISSL";"S";"0132";"* ce compteur est utilis? dans la regle REPAS"
"IMISSL";"S";"0133";"* pour ne pas decompter de pause d?jeuner sur"
"IMISSL";"S";"0134";"* La presence badgee puisqu'elle est decomptee de la mission"
"IMISSL";"S";"0135";"      FINSI"
"IMISSL";"S";"0136";"   FINSI"
"IMISSL";"S";"0137";"   LOCA_MISSL = LOCA_MISSL + LOCA_DUREE"
"IMISSL";"S";"0138";"FINPROC"
"IPAMOINS18";"S";"0001";"***********************************************************************"
"IPAMOINS18";"S";"0002";"*"
"IPAMOINS18";"S";"0003";"* Règle : ITRPAMINE"
"IPAMOINS18";"S";"0004";"* Ordre : 2190"
"IPAMOINS18";"S";"0005";"* Titre : Vérif temps de pause travail des mineurs"
"IPAMOINS18";"S";"0006";"*"
"IPAMOINS18";"S";"0007";"*----------------------------------------------------------------------"
"IPAMOINS18";"S";"0008";"*"
"IPAMOINS18";"S";"0009";"* Créé par : Méthodes et outils"
"IPAMOINS18";"S";"0010";"* Date     : 04/11/2019"
"IPAMOINS18";"S";"0011";"* Version  : 1"
"IPAMOINS18";"S";"0012";"*"
"IPAMOINS18";"S";"0013";"*----------------------------------------------------------------------"
"IPAMOINS18";"S";"0014";"*"
"IPAMOINS18";"S";"0015";"* Rôle :"
"IPAMOINS18";"S";"0016";"*"
"IPAMOINS18";"S";"0017";"* S'assurer de la présence d'une pause d'au moins 30 mn consécutives"
"IPAMOINS18";"S";"0018";"* au-delà de 4h30 travaillées pour les moins de 18 ans"
"IPAMOINS18";"S";"0019";"*"
"IPAMOINS18";"S";"0020";"*----------------------------------------------------------------------"
"IPAMOINS18";"S";"0021";"*"
"IPAMOINS18";"S";"0022";"* Modifiée par :"
"IPAMOINS18";"S";"0023";"* Date         :"
"IPAMOINS18";"S";"0024";"* Objet        :"
"IPAMOINS18";"S";"0025";"*"
"IPAMOINS18";"S";"0026";"*----------------------------------------------------------------------"
"IPAMOINS18";"S";"0027";"*"
"IPAMOINS18";"S";"0028";"* Implémentation des données industrielles"
"IPAMOINS18";"S";"0029";"*"
"IPAMOINS18";"S";"0030";"DEBDICO"
"IPAMOINS18";"S";"0031";"FINDICO"
"IPAMOINS18";"S";"0032";"*"
"IPAMOINS18";"S";"0033";"DEBANO"
"IPAMOINS18";"S";"0034";"   163;8;""Moins de 18 ans : une pause de 30 min est obligatoire au-delà de 4h30 de travail"";"
"IPAMOINS18";"S";"0035";"FINANO"
"IPAMOINS18";"S";"0036";"*"
"IPAMOINS18";"S";"0037";"***********************************************************************"
"IPAMOINS18";"S";"0038";"*"
"IPAMOINS18";"S";"0039";"* Déclaration des donnees locales"
"IPAMOINS18";"S";"0040";"*"
"IPAMOINS18";"S";"0041";"***************************"
"IPAMOINS18";"S";"0042";"DEF LOCA_PASS N1"
"IPAMOINS18";"S";"0043";"LOCA_PASS = 0"
"IPAMOINS18";"S";"0044";"DEF LOCA_SORTIE T6.2"
"IPAMOINS18";"S";"0045";"LOCA_SORTIE = 0"
"IPAMOINS18";"S";"0046";"DEF LOCA_ENTREE T6.2"
"IPAMOINS18";"S";"0047";"LOCA_ENTREE = 0"
"IPAMOINS18";"S";"0048";"DEF LOCA_DUR T6.2"
"IPAMOINS18";"S";"0049";"LOCA_DUR = 0"
"IPAMOINS18";"S";"0050";"DEF LOCA_ANO N1"
"IPAMOINS18";"S";"0051";"LOCA_ANO = 0"
"IPAMOINS18";"S";"0052";"DEF LOCA_AGE N2"
"IPAMOINS18";"S";"0053";"LOCA_AGE = 0"
"IPAMOINS18";"S";"0054";"*"
"IPAMOINS18";"S";"0055";"*"
"IPAMOINS18";"S";"0056";"SI EMPS_E2DATENAI <> "" """
"IPAMOINS18";"S";"0057";"    DATDIFF EMPS_E2DATENAI 12 HJOU_DATE 12"
"IPAMOINS18";"S";"0058";"    LOCA_AGE = TEMP_NXANNEE"
"IPAMOINS18";"S";"0059";"    * Pour les personnes de moins de 18 ans"
"IPAMOINS18";"S";"0060";"    SI LOCA_AGE < 18"
"IPAMOINS18";"S";"0061";"        * Test si la durée de travail sans pause > 4.30 heures"
"IPAMOINS18";"S";"0062";"        POUR POINTAGES"
"IPAMOINS18";"S";"0063";"           SI POIN_SENS = ""0"""
"IPAMOINS18";"S";"0064";"              SI LOCA_PASS = 0"
"IPAMOINS18";"S";"0065";"                 LOCA_ENTREE = POIN_HRETRAI"
"IPAMOINS18";"S";"0066";"                 LOCA_PASS = 1"
"IPAMOINS18";"S";"0067";"              FINSI"
"IPAMOINS18";"S";"0068";"           FINSI"
"IPAMOINS18";"S";"0069";"           SI POIN_SENS = ""1"""
"IPAMOINS18";"S";"0070";"              SI LOCA_PASS = 1"
"IPAMOINS18";"S";"0071";"                 LOCA_SORTIE = POIN_HRETRAI"
"IPAMOINS18";"S";"0072";"                 LOCA_PASS = 0"
"IPAMOINS18";"S";"0073";"                 LOCA_DUR = LOCA_SORTIE - LOCA_ENTREE"
"IPAMOINS18";"S";"0074";"                 SI LOCA_DUR > 4.30"
"IPAMOINS18";"S";"0075";"                    LOCA_ANO = 1"
"IPAMOINS18";"S";"0076";"                 FINSI"
"IPAMOINS18";"S";"0077";"              FINSI"
"IPAMOINS18";"S";"0078";"           FINSI"
"IPAMOINS18";"S";"0079";"        FINPOUR"
"IPAMOINS18";"S";"0080";"        *"
"IPAMOINS18";"S";"0081";"        SI LOCA_ANO = 1"
"IPAMOINS18";"S";"0082";"           ANOMALIE 163"
"IPAMOINS18";"S";"0083";"        FINSI"
"IPAMOINS18";"S";"0084";"    FINSI"
"IPAMOINS18";"S";"0085";"FINSI"
"IPAMOINS18";"S";"0086";"*"
"IPAMOINS18";"S";"0087";"FIN"
"IPAUS5BADG";"S";"0001";"***********************************************************************"
"IPAUS5BADG";"S";"0002";"*"
"IPAUS5BADG";"S";"0003";"* Règle : IPAUS5BADG"
"IPAUS5BADG";"S";"0004";"* Ordre : 2170"
"IPAUS5BADG";"S";"0005";"* Titre : Pause 5% badgée"
"IPAUS5BADG";"S";"0006";"*"
"IPAUS5BADG";"S";"0007";"*----------------------------------------------------------------------"
"IPAUS5BADG";"S";"0008";"*"
"IPAUS5BADG";"S";"0009";"* Créé par : Méthodes et outils"
"IPAUS5BADG";"S";"0010";"* Date     : 16/08/2018"
"IPAUS5BADG";"S";"0011";"* Version  : 1"
"IPAUS5BADG";"S";"0012";"*"
"IPAUS5BADG";"S";"0013";"*----------------------------------------------------------------------"
"IPAUS5BADG";"S";"0014";"*"
"IPAUS5BADG";"S";"0015";"*"
"IPAUS5BADG";"S";"0016";"* Rôle :"
"IPAUS5BADG";"S";"0017";"*"
"IPAUS5BADG";"S";"0018";"* Calcul de la pause badgée (5% du temps travaillé)"
"IPAUS5BADG";"S";"0019";"*"
"IPAUS5BADG";"S";"0020";"*"
"IPAUS5BADG";"S";"0021";"***********************************************************************"
"IPAUS5BADG";"S";"0022";"*"
"IPAUS5BADG";"S";"0023";"* Implémentation des données industrielles"
"IPAUS5BADG";"S";"0024";"*"
"IPAUS5BADG";"S";"0025";"DEBDICO"
"IPAUS5BADG";"S";"0026";"   HJOU_IJQPAUSE5J;N;T6,2;I;;;    56789;;;C0;""Pause 5%"";"
"IPAUS5BADG";"S";"0027";"FINDICO"
"IPAUS5BADG";"S";"0028";"*"
"IPAUS5BADG";"S";"0029";"*"
"IPAUS5BADG";"S";"0030";"DEBANO"
"IPAUS5BADG";"S";"0031";"   223;5;""Pas de retour sur une sortie pause"";"
"IPAUS5BADG";"S";"0032";"FINANO"
"IPAUS5BADG";"S";"0033";"* Déclaration des donnees locales"
"IPAUS5BADG";"S";"0034";"*"
"IPAUS5BADG";"S";"0035";"DEF LOCA_IMPUT A6"
"IPAUS5BADG";"S";"0036";"LOCA_IMPUT = "" """
"IPAUS5BADG";"S";"0037";"DEF LOCA_DUREE T6.2"
"IPAUS5BADG";"S";"0038";"LOCA_DUREE = 0"
"IPAUS5BADG";"S";"0039";"DEF LOCA_PTPA N1"
"IPAUS5BADG";"S";"0040";"LOCA_PTPA = 0"
"IPAUS5BADG";"S";"0041";"DEF LOCA_SORTIE T6.2"
"IPAUS5BADG";"S";"0042";"LOCA_SORTIE = 0"
"IPAUS5BADG";"S";"0043";"DEF LOCA_RETPA T6.2"
"IPAUS5BADG";"S";"0044";"LOCA_RETPA = 0"
"IPAUS5BADG";"S";"0045";"DEF LOCA_DUREET T6.2"
"IPAUS5BADG";"S";"0046";"LOCA_DUREET = 0"
"IPAUS5BADG";"S";"0047";"*"
"IPAUS5BADG";"S";"0048";"SI HJOU_DATE <= TEMP_DATJOU"
"IPAUS5BADG";"S";"0049";"* profil badgeant"
"IPAUS5BADG";"S";"0050";"   SI PROF_IPIVMINBAD > 0"
"IPAUS5BADG";"S";"0051";"* gestion pause 5%"
"IPAUS5BADG";"S";"0052";"      SI PROF_IPIGPAUSME = ""4"""
"IPAUS5BADG";"S";"0053";"* pause badgée"
"IPAUS5BADG";"S";"0054";"         SI PROF_IPIFPAUSBA = ""1"""
"IPAUS5BADG";"S";"0055";"* calcul du temps de pause avec touche PA"
"IPAUS5BADG";"S";"0056";"            POUR POINTAGES"
"IPAUS5BADG";"S";"0057";"* Recuperation de l'heure de badgeage"
"IPAUS5BADG";"S";"0058";"* si c'est un mouvement de sortie avec motif ""PA"""
"IPAUS5BADG";"S";"0059";"               SI POIN_SENS = ""1"""
"IPAUS5BADG";"S";"0060";"                  SI POIN_IMPUT = ""PA"""
"IPAUS5BADG";"S";"0061";"                     LOCA_PTPA = 1"
"IPAUS5BADG";"S";"0062";"                     LOCA_IMPUT = POIN_IMPUT"
"IPAUS5BADG";"S";"0063";"                     LOCA_SORTIE = POIN_HRETRAI"
"IPAUS5BADG";"S";"0064";"                  FINSI"
"IPAUS5BADG";"S";"0065";"               FINSI"
"IPAUS5BADG";"S";"0066";"               SI POIN_SENS = ""0"""
"IPAUS5BADG";"S";"0067";"                  LOCA_PTPA = 0"
"IPAUS5BADG";"S";"0068";"* si le badgeage en entree est un retour motif"
"IPAUS5BADG";"S";"0069";"                  SI LOCA_IMPUT = ""PA"""
"IPAUS5BADG";"S";"0070";"                     LOCA_RETPA = POIN_HRETRAI"
"IPAUS5BADG";"S";"0071";"                     LOCA_IMPUT = "" """
"IPAUS5BADG";"S";"0072";"** Calcul de la durée"
"IPAUS5BADG";"S";"0073";"                     LOCA_DUREE = LOCA_RETPA - LOCA_SORTIE"
"IPAUS5BADG";"S";"0074";"                     LOCA_DUREET = LOCA_DUREET + LOCA_DUREE"
"IPAUS5BADG";"S";"0075";"                  FINSI"
"IPAUS5BADG";"S";"0076";"               FINSI"
"IPAUS5BADG";"S";"0077";"            FINPOUR"
"IPAUS5BADG";"S";"0078";"* depart sans retour dans la meme journne"
"IPAUS5BADG";"S";"0079";"            SI LOCA_IMPUT = ""PA"""
"IPAUS5BADG";"S";"0080";"               SI LOCA_PTPA = 1"
"IPAUS5BADG";"S";"0081";"                  ANOMALIE 223"
"IPAUS5BADG";"S";"0082";"               FINSI"
"IPAUS5BADG";"S";"0083";"            FINSI"
"IPAUS5BADG";"S";"0084";"            HJOU_IJQPAUSE5J = 0"
"IPAUS5BADG";"S";"0085";"            SI LOCA_DUREET > 0"
"IPAUS5BADG";"S";"0086";"               HJOU_IJQPAUSE5J = HJOU_IJQPAUSE5J + LOCA_DUREET"
"IPAUS5BADG";"S";"0087";"            FINSI"
"IPAUS5BADG";"S";"0088";"         FINSI"
"IPAUS5BADG";"S";"0089";"      FINSI"
"IPAUS5BADG";"S";"0090";"   FINSI"
"IPAUS5BADG";"S";"0091";"FINSI"
"IPAUS5BADG";"S";"0092";"FIN"
"IPAUSB";"S";"0001";"***********************************************************************"
"IPAUSB";"S";"0002";"*"
"IPAUSB";"S";"0003";"* Règle : IPAUSB"
"IPAUSB";"S";"0004";"* Ordre : 2130"
"IPAUSB";"S";"0005";"* Titre : Gestion des pauses badgées au lecteur"
"IPAUSB";"S";"0006";"*"
"IPAUSB";"S";"0007";"*----------------------------------------------------------------------"
"IPAUSB";"S";"0008";"*"
"IPAUSB";"S";"0009";"* Créé par : Cellule Industrialisation"
"IPAUSB";"S";"0010";"* Date     : 03/09/2009"
"IPAUSB";"S";"0011";"* Version  : 1"
"IPAUSB";"S";"0012";"*"
"IPAUSB";"S";"0013";"*---------------------------------------------------------------------"
"IPAUSB";"S";"0014";"*"
"IPAUSB";"S";"0015";"*"
"IPAUSB";"S";"0016";"* Rôle :"
"IPAUSB";"S";"0017";"*"
"IPAUSB";"S";"0018";"*  Calcul du temps de pause entre la premiere sortie et la première"
"IPAUSB";"S";"0019";"*  entrée et la troisième sortie et la troisième entrée"
"IPAUSB";"S";"0020";"*  les sorties ont le code imputation PAUSE"
"IPAUSB";"S";"0021";"*"
"IPAUSB";"S";"0022";"*----------------------------------------------------------------------"
"IPAUSB";"S";"0023";"*"
"IPAUSB";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IPAUSB";"S";"0025";"* Date         : JJ/MM/AAAA"
"IPAUSB";"S";"0026";"* Objet        :"
"IPAUSB";"S";"0027";"*"
"IPAUSB";"S";"0028";"***********************************************************************"
"IPAUSB";"S";"0029";"*"
"IPAUSB";"S";"0030";"* Implémentation des données industrielles"
"IPAUSB";"S";"0031";"*"
"IPAUSB";"S";"0032";"*"
"IPAUSB";"S";"0033";"DEBDICO"
"IPAUSB";"S";"0034";"   HJOU_IJQPAUSMAT;N;T6,2;I;;;     6789;;;V2;""Pause première plage"";"
"IPAUSB";"S";"0035";"   HJOU_IJQPAUSSOI;N;T6,2;I;;;     6789;;;V2;""Pause seconde plage"";"
"IPAUSB";"S";"0036";"FINDICO"
"IPAUSB";"S";"0037";"*"
"IPAUSB";"S";"0038";"* Déclaration des donnees locales"
"IPAUSB";"S";"0039";"*"
"IPAUSB";"S";"0040";"DEF LOCA_NOB N2"
"IPAUSB";"S";"0041";"LOCA_NOB = 0"
"IPAUSB";"S";"0042";"DEF LOCA_SORTIE1 T6.2"
"IPAUSB";"S";"0043";"LOCA_SORTIE1 = 0"
"IPAUSB";"S";"0044";"DEF LOCA_ENTREE1 T6.2"
"IPAUSB";"S";"0045";"LOCA_ENTREE1 = 0"
"IPAUSB";"S";"0046";"DEF LOCA_SORTIE2 T6.2"
"IPAUSB";"S";"0047";"LOCA_SORTIE2 = 0"
"IPAUSB";"S";"0048";"DEF LOCA_ENTREE2 T6.2"
"IPAUSB";"S";"0049";"LOCA_ENTREE2 = 0"
"IPAUSB";"S";"0050";"DEF LOCA_PAUSEMA N1"
"IPAUSB";"S";"0051";"LOCA_PAUSEMA = 0"
"IPAUSB";"S";"0052";"*"
"IPAUSB";"S";"0053";"*"
"IPAUSB";"S";"0054";"SI HJOU_DATE <= TEMP_DATJOU"
"IPAUSB";"S";"0055";"** Contrôle si plus de 2 badgeages dans la première plage pour"
"IPAUSB";"S";"0056";"** dans le cas ou la pause est badgée et qu'il n'y a pas"
"IPAUSB";"S";"0057";"** de mouvement de pause la sortie du matin et l'entree de"
"IPAUSB";"S";"0058";"** l'apres-midi ne soit pas considérée comme une pause"
"IPAUSB";"S";"0059";"   SI PROF_PTTHEO1 > 0"
"IPAUSB";"S";"0060";"      SI PROF_PTTHEO1 < 100"
"IPAUSB";"S";"0061";"         ANALYSE 0.00 PROF_PTTHEO2"
"IPAUSB";"S";"0062";"         SI TEMP_HIPOIN > 2"
"IPAUSB";"S";"0063";"* on considere qu'il y a une pause badgée"
"IPAUSB";"S";"0064";"            LOCA_PAUSEMA = 1"
"IPAUSB";"S";"0065";"         SINON"
"IPAUSB";"S";"0066";"* il n'y a pas de pause badgée et dans ce cas"
"IPAUSB";"S";"0067";"* le deuxieme et troisieme mvts ne sont pas une pause"
"IPAUSB";"S";"0068";"* exemple 8.00 12.00 14.00 18.00 il ne faut pas"
"IPAUSB";"S";"0069";"* comptabiliser un temps de pause entre 12h00 et 14h00"
"IPAUSB";"S";"0070";"            LOCA_PAUSEMA = 2"
"IPAUSB";"S";"0071";"         FINSI"
"IPAUSB";"S";"0072";"      FINSI"
"IPAUSB";"S";"0073";"   FINSI"
"IPAUSB";"S";"0074";"   SI PROF_IPIFPAUSBA = ""1"""
"IPAUSB";"S";"0075";"** pause baddgée"
"IPAUSB";"S";"0076";"      POUR POINTAGES"
"IPAUSB";"S";"0077";"         LOCA_NOB = LOCA_NOB + 1"
"IPAUSB";"S";"0078";"* gestion de la prmier pause"
"IPAUSB";"S";"0079";"         SI LOCA_PAUSEMA = 1"
"IPAUSB";"S";"0080";"            SI LOCA_NOB = 2"
"IPAUSB";"S";"0081";"               SI POIN_IMPUT = "" """
"IPAUSB";"S";"0082";"               OU POIN_IMPUT = ""PAUSE"""
"IPAUSB";"S";"0083";"                  LOCA_SORTIE1 = POIN_HRETRAI"
"IPAUSB";"S";"0084";"               FINSI"
"IPAUSB";"S";"0085";"            FINSI"
"IPAUSB";"S";"0086";"            SI LOCA_NOB = 3"
"IPAUSB";"S";"0087";"               SI LOCA_SORTIE1 > 0"
"IPAUSB";"S";"0088";"                  LOCA_ENTREE1 = POIN_HRETRAI"
"IPAUSB";"S";"0089";"               FINSI"
"IPAUSB";"S";"0090";"            FINSI"
"IPAUSB";"S";"0091";"         FINSI"
"IPAUSB";"S";"0092";"** gestion de la seconde pause"
"IPAUSB";"S";"0093";"** dans le cas ou la premiere pause n'a pas été badgée"
"IPAUSB";"S";"0094";"** le test doit être fait sur le 4ème et 5ème mouvement"
"IPAUSB";"S";"0095";"         SI LOCA_PAUSEMA = 1"
"IPAUSB";"S";"0096";"            SI LOCA_NOB = 6"
"IPAUSB";"S";"0097";"               SI POIN_IMPUT = "" """
"IPAUSB";"S";"0098";"               OU POIN_IMPUT = ""PAUSE"""
"IPAUSB";"S";"0099";"                  LOCA_SORTIE2 = POIN_HRETRAI"
"IPAUSB";"S";"0100";"               FINSI"
"IPAUSB";"S";"0101";"            FINSI"
"IPAUSB";"S";"0102";"            SI LOCA_NOB = 7"
"IPAUSB";"S";"0103";"               SI LOCA_SORTIE2 > 0"
"IPAUSB";"S";"0104";"                  LOCA_ENTREE2 = POIN_HRETRAI"
"IPAUSB";"S";"0105";"               FINSI"
"IPAUSB";"S";"0106";"            FINSI"
"IPAUSB";"S";"0107";"         FINSI"
"IPAUSB";"S";"0108";"         SI LOCA_PAUSEMA = 2"
"IPAUSB";"S";"0109";"            SI LOCA_NOB = 4"
"IPAUSB";"S";"0110";"               SI POIN_IMPUT = "" """
"IPAUSB";"S";"0111";"               OU POIN_IMPUT = ""PAUSE"""
"IPAUSB";"S";"0112";"                  LOCA_SORTIE2 = POIN_HRETRAI"
"IPAUSB";"S";"0113";"               FINSI"
"IPAUSB";"S";"0114";"            FINSI"
"IPAUSB";"S";"0115";"            SI LOCA_NOB = 5"
"IPAUSB";"S";"0116";"               SI LOCA_SORTIE2 > 0"
"IPAUSB";"S";"0117";"                  LOCA_ENTREE2 = POIN_HRETRAI"
"IPAUSB";"S";"0118";"               FINSI"
"IPAUSB";"S";"0119";"            FINSI"
"IPAUSB";"S";"0120";"         FINSI"
"IPAUSB";"S";"0121";"      FINPOUR"
"IPAUSB";"S";"0122";"** Premiere pause"
"IPAUSB";"S";"0123";"      SI LOCA_ENTREE1 > LOCA_SORTIE1"
"IPAUSB";"S";"0124";"         HJOU_IJQPAUSMAT = LOCA_ENTREE1 - LOCA_SORTIE1"
"IPAUSB";"S";"0125";"      FINSI"
"IPAUSB";"S";"0126";"*** seconde pause"
"IPAUSB";"S";"0127";"      SI LOCA_ENTREE2 > LOCA_SORTIE2"
"IPAUSB";"S";"0128";"         HJOU_IJQPAUSSOI = LOCA_ENTREE2 - LOCA_SORTIE2"
"IPAUSB";"S";"0129";"      FINSI"
"IPAUSB";"S";"0130";"   SINON"
"IPAUSB";"S";"0131";"**"
"IPAUSB";"S";"0132";"** pause fofaitaire non badgée"
"IPAUSB";"S";"0133";"*"
"IPAUSB";"S";"0134";"* pause forfaitaire non badgee si presence matin"
"IPAUSB";"S";"0135";"      SI HJOU_IJQPRESBA1 > 0"
"IPAUSB";"S";"0136";"         HJOU_IJQPAUSMAT = PROF_IPIVFPAUMA"
"IPAUSB";"S";"0137";"      FINSI"
"IPAUSB";"S";"0138";"* pause forfaitaire non badgee si presence matin"
"IPAUSB";"S";"0139";"      SI HJOU_IJQPRESBA2 > 0"
"IPAUSB";"S";"0140";"         HJOU_IJQPAUSSOI = PROF_IPIVFPAUSO"
"IPAUSB";"S";"0141";"      FINSI"
"IPAUSB";"S";"0142";"   FINSI"
"IPAUSB";"S";"0143";"FINSI"
"IPAUSB";"S";"0144";"FIN"
"IPAUSE";"S";"0001";"***********************************************************************"
"IPAUSE";"S";"0002";"*"
"IPAUSE";"S";"0003";"* Règle : IPAUSE"
"IPAUSE";"S";"0004";"* Ordre : 2120"
"IPAUSE";"S";"0005";"* Titre : Gestion des pauses"
"IPAUSE";"S";"0006";"*"
"IPAUSE";"S";"0007";"*----------------------------------------------------------------------"
"IPAUSE";"S";"0008";"*"
"IPAUSE";"S";"0009";"* Créé par : Cellule Industrialisation"
"IPAUSE";"S";"0010";"* Date     : 03/09/2009"
"IPAUSE";"S";"0011";"* Version  : 1"
"IPAUSE";"S";"0012";"*"
"IPAUSE";"S";"0013";"*---------------------------------------------------------------------"
"IPAUSE";"S";"0014";"*"
"IPAUSE";"S";"0015";"*"
"IPAUSE";"S";"0016";"* Rôle :"
"IPAUSE";"S";"0017";"*"
"IPAUSE";"S";"0018";"*  Calcul du temps de pause entre la première sortie et la première"
"IPAUSE";"S";"0019";"*  entrée et la troisième sortie et la troisième entrée"
"IPAUSE";"S";"0020";"*"
"IPAUSE";"S";"0021";"*"
"IPAUSE";"S";"0022";"*----------------------------------------------------------------------"
"IPAUSE";"S";"0023";"*"
"IPAUSE";"S";"0024";"* Modifiée par : Cellule Industrialisation"
"IPAUSE";"S";"0025";"* Date         : JJ/MM/AAAA"
"IPAUSE";"S";"0026";"* Objet        :"
"IPAUSE";"S";"0027";"*"
"IPAUSE";"S";"0028";"***********************************************************************"
"IPAUSE";"S";"0029";"*"
"IPAUSE";"S";"0030";"* Implémentation des données industrielles"
"IPAUSE";"S";"0031";"*"
"IPAUSE";"S";"0032";"DEBDICO"
"IPAUSE";"S";"0033";"   PROF_IPIFPAUSBA;O;Z1;X;0;1;123456789;C;;C2;""Pause badgée"";"
"IPAUSE";"S";"0034";"   HJOU_IJQPAUSMAT;N;T6,2;I;;;     6789;;;V2;""Pause première plage"";"
"IPAUSE";"S";"0035";"   HJOU_IJQPAUSSOI;N;T6,2;I;;;     6789;;;V2;""Pause seconde plage"";"
"IPAUSE";"S";"0036";"FINDICO"
"IPAUSE";"S";"0037";"*"
"IPAUSE";"S";"0038";"* Déclaration des donnees locales"
"IPAUSE";"S";"0039";"*"
"IPAUSE";"S";"0040";"DEF LOCA_NOB N2"
"IPAUSE";"S";"0041";"LOCA_NOB = 0"
"IPAUSE";"S";"0042";"DEF LOCA_SORTIE1 T6.2"
"IPAUSE";"S";"0043";"LOCA_SORTIE1 = 0"
"IPAUSE";"S";"0044";"DEF LOCA_ENTREE1 T6.2"
"IPAUSE";"S";"0045";"LOCA_ENTREE1 = 0"
"IPAUSE";"S";"0046";"DEF LOCA_SORTIE2 T6.2"
"IPAUSE";"S";"0047";"LOCA_SORTIE2 = 0"
"IPAUSE";"S";"0048";"DEF LOCA_ENTREE2 T6.2"
"IPAUSE";"S";"0049";"LOCA_ENTREE2 = 0"
"IPAUSE";"S";"0050";"DEF LOCA_PAUSEMA N1"
"IPAUSE";"S";"0051";"LOCA_PAUSEMA = 0"
"IPAUSE";"S";"0052";"*"
"IPAUSE";"S";"0053";"*"
"IPAUSE";"S";"0054";"SI HJOU_DATE <= TEMP_DATJOU"
"IPAUSE";"S";"0055";"** Contrôle si plus de 2 badgeages dans la première plage pour"
"IPAUSE";"S";"0056";"** dans le cas ou la pause est badgée et qu'il n'y a pas"
"IPAUSE";"S";"0057";"** de mouvement de pause la sortie du matin et l'entree de"
"IPAUSE";"S";"0058";"** l'apres-midi ne soit pas considérée comme une pause"
"IPAUSE";"S";"0059";"   SI PROF_PTTHEO1 > 0"
"IPAUSE";"S";"0060";"      SI PROF_PTTHEO1 < 100"
"IPAUSE";"S";"0061";"         ANALYSE 0.00 PROF_PTTHEO2"
"IPAUSE";"S";"0062";"         SI TEMP_HIPOIN > 2"
"IPAUSE";"S";"0063";"* on considere qu'il y a une pause badgée"
"IPAUSE";"S";"0064";"            LOCA_PAUSEMA = 1"
"IPAUSE";"S";"0065";"         SINON"
"IPAUSE";"S";"0066";"* il n'y a pas de pause badgée et dans ce cas"
"IPAUSE";"S";"0067";"* le deuxieme et troisieme mvts ne sont pas une pause"
"IPAUSE";"S";"0068";"* exemple 8.00 12.00 14.00 18.00 il ne faut pas"
"IPAUSE";"S";"0069";"* comptabiliser un temps de pause entre 12h00 et 14h00"
"IPAUSE";"S";"0070";"            LOCA_PAUSEMA = 2"
"IPAUSE";"S";"0071";"         FINSI"
"IPAUSE";"S";"0072";"      FINSI"
"IPAUSE";"S";"0073";"   FINSI"
"IPAUSE";"S";"0074";"   SI PROF_IPIFPAUSBA = ""1"""
"IPAUSE";"S";"0075";"** pause baddgée"
"IPAUSE";"S";"0076";"      POUR POINTAGES"
"IPAUSE";"S";"0077";"         LOCA_NOB = LOCA_NOB + 1"
"IPAUSE";"S";"0078";"* gestion de la prmier pause"
"IPAUSE";"S";"0079";"         SI LOCA_PAUSEMA = 1"
"IPAUSE";"S";"0080";"            SI LOCA_NOB = 2"
"IPAUSE";"S";"0081";"               SI POIN_IMPUT = "" """
"IPAUSE";"S";"0082";"                  LOCA_SORTIE1 = POIN_HRETRAI"
"IPAUSE";"S";"0083";"               FINSI"
"IPAUSE";"S";"0084";"            FINSI"
"IPAUSE";"S";"0085";"            SI LOCA_NOB = 3"
"IPAUSE";"S";"0086";"               SI LOCA_SORTIE1 > 0"
"IPAUSE";"S";"0087";"                  LOCA_ENTREE1 = POIN_HRETRAI"
"IPAUSE";"S";"0088";"               FINSI"
"IPAUSE";"S";"0089";"            FINSI"
"IPAUSE";"S";"0090";"         FINSI"
"IPAUSE";"S";"0091";"** gestion de la seconde pause"
"IPAUSE";"S";"0092";"** dans le cas ou la premiere pause n'a pas été badgée"
"IPAUSE";"S";"0093";"** le test doit être fait sur le 4ème et 5ème mouvement"
"IPAUSE";"S";"0094";"         SI LOCA_PAUSEMA = 1"
"IPAUSE";"S";"0095";"            SI LOCA_NOB = 6"
"IPAUSE";"S";"0096";"               SI POIN_IMPUT = "" """
"IPAUSE";"S";"0097";"                  LOCA_SORTIE2 = POIN_HRETRAI"
"IPAUSE";"S";"0098";"               FINSI"
"IPAUSE";"S";"0099";"            FINSI"
"IPAUSE";"S";"0100";"            SI LOCA_NOB = 7"
"IPAUSE";"S";"0101";"               SI LOCA_SORTIE2 > 0"
"IPAUSE";"S";"0102";"                  LOCA_ENTREE2 = POIN_HRETRAI"
"IPAUSE";"S";"0103";"               FINSI"
"IPAUSE";"S";"0104";"            FINSI"
"IPAUSE";"S";"0105";"         FINSI"
"IPAUSE";"S";"0106";"         SI LOCA_PAUSEMA = 2"
"IPAUSE";"S";"0107";"            SI LOCA_NOB = 4"
"IPAUSE";"S";"0108";"               SI POIN_IMPUT = "" """
"IPAUSE";"S";"0109";"                  LOCA_SORTIE2 = POIN_HRETRAI"
"IPAUSE";"S";"0110";"               FINSI"
"IPAUSE";"S";"0111";"            FINSI"
"IPAUSE";"S";"0112";"            SI LOCA_NOB = 5"
"IPAUSE";"S";"0113";"               SI LOCA_SORTIE2 > 0"
"IPAUSE";"S";"0114";"                  LOCA_ENTREE2 = POIN_HRETRAI"
"IPAUSE";"S";"0115";"               FINSI"
"IPAUSE";"S";"0116";"            FINSI"
"IPAUSE";"S";"0117";"         FINSI"
"IPAUSE";"S";"0118";"      FINPOUR"
"IPAUSE";"S";"0119";"** Premiere pause"
"IPAUSE";"S";"0120";"      SI LOCA_ENTREE1 > LOCA_SORTIE1"
"IPAUSE";"S";"0121";"         HJOU_IJQPAUSMAT = LOCA_ENTREE1 - LOCA_SORTIE1"
"IPAUSE";"S";"0122";"      FINSI"
"IPAUSE";"S";"0123";"*** seconde pause"
"IPAUSE";"S";"0124";"      SI LOCA_ENTREE2 > LOCA_SORTIE2"
"IPAUSE";"S";"0125";"         HJOU_IJQPAUSSOI = LOCA_ENTREE2 - LOCA_SORTIE2"
"IPAUSE";"S";"0126";"      FINSI"
"IPAUSE";"S";"0127";"   SINON"
"IPAUSE";"S";"0128";"**"
"IPAUSE";"S";"0129";"** pause fofaitaire non badgée"
"IPAUSE";"S";"0130";"*"
"IPAUSE";"S";"0131";"* pause forfaitaire non badgee si presence matin"
"IPAUSE";"S";"0132";"      SI HJOU_IJQPRESBA1 > 0"
"IPAUSE";"S";"0133";"         HJOU_IJQPAUSMAT = PROF_IPIVFPAUMA"
"IPAUSE";"S";"0134";"      FINSI"
"IPAUSE";"S";"0135";"* pause forfaitaire non badgee si presence matin"
"IPAUSE";"S";"0136";"      SI HJOU_IJQPRESBA2 > 0"
"IPAUSE";"S";"0137";"         HJOU_IJQPAUSSOI = PROF_IPIVFPAUSO"
"IPAUSE";"S";"0138";"      FINSI"
"IPAUSE";"S";"0139";"   FINSI"
"IPAUSE";"S";"0140";"FINSI"
"IPAUSE";"S";"0141";"FIN"
"IPAUSE5PC";"S";"0001";"***********************************************************************"
"IPAUSE5PC";"S";"0002";"*"
"IPAUSE5PC";"S";"0003";"* Règle : IPAUSE5PC"
"IPAUSE5PC";"S";"0004";"* Ordre : 3210"
"IPAUSE5PC";"S";"0005";"* Titre : Pause 5%"
"IPAUSE5PC";"S";"0006";"*"
"IPAUSE5PC";"S";"0007";"*----------------------------------------------------------------------"
"IPAUSE5PC";"S";"0008";"*"
"IPAUSE5PC";"S";"0009";"* Créé par : Méthodes et outils"
"IPAUSE5PC";"S";"0010";"* Date     : 16/08/2018"
"IPAUSE5PC";"S";"0011";"* Version  : 1"
"IPAUSE5PC";"S";"0012";"*"
"IPAUSE5PC";"S";"0013";"*----------------------------------------------------------------------"
"IPAUSE5PC";"S";"0014";"*"
"IPAUSE5PC";"S";"0015";"*"
"IPAUSE5PC";"S";"0016";"* Rôle : Calcul du temps de pause 5% et déduction du temps badgé"
"IPAUSE5PC";"S";"0017";"*"
"IPAUSE5PC";"S";"0018";"*"
"IPAUSE5PC";"S";"0019";"***********************************************************************"
"IPAUSE5PC";"S";"0020";"*"
"IPAUSE5PC";"S";"0021";"* Implémentation des données industrielles"
"IPAUSE5PC";"S";"0022";"*"
"IPAUSE5PC";"S";"0023";"DEBDICO"
"IPAUSE5PC";"S";"0024";"   HJOU_IJQPAUS5TH;N;T6,2;I;;;    56789;;;V3;""Pause 5% théorique"";"
"IPAUSE5PC";"S";"0025";"   MOTI_IMIGTPAUS5;O;Z1;X;0;1;123456789;C;;C2;""Participe au temps de pause 5%"";"
"IPAUSE5PC";"S";"0026";"FINDICO"
"IPAUSE5PC";"S";"0027";"*"
"IPAUSE5PC";"S";"0028";"* Déclaration des donnees locales"
"IPAUSE5PC";"S";"0029";"*"
"IPAUSE5PC";"S";"0030";"DEF LOCA_ABSPA T6.2"
"IPAUSE5PC";"S";"0031";"LOCA_ABSPA = 0"
"IPAUSE5PC";"S";"0032";"DEF LOCA_ECART T6.2"
"IPAUSE5PC";"S";"0033";"LOCA_ECART = 0"
"IPAUSE5PC";"S";"0034";"*"
"IPAUSE5PC";"S";"0035";"SI HJOU_DATE <= TEMP_DATJOU"
"IPAUSE5PC";"S";"0036";"* gestion pause 5%"
"IPAUSE5PC";"S";"0037";"   SI PROF_IPIGPAUSME = ""4"""
"IPAUSE5PC";"S";"0038";"* motifs participants à la pause"
"IPAUSE5PC";"S";"0039";"      POUR ACTIVITES"
"IPAUSE5PC";"S";"0040";"         SI MOTI_IMIGTPAUS5 = ""1"""
"IPAUSE5PC";"S";"0041";"            LOCA_ABSPA = LOCA_ABSPA + HABS_MOTIDUR"
"IPAUSE5PC";"S";"0042";"         FINSI"
"IPAUSE5PC";"S";"0043";"      FINPOUR"
"IPAUSE5PC";"S";"0044";"* temps de pause attendu"
"IPAUSE5PC";"S";"0045";"      HJOU_IJQPAUS5TH = HJOU_IJQPLGTOTJ + LOCA_ABSPA"
"IPAUSE5PC";"S";"0046";"      HJOU_IJQPAUS5TH = HJOU_IJQPAUS5TH * 0.05"
"IPAUSE5PC";"S";"0047";"      POUR ACTIVITES"
"IPAUSE5PC";"S";"0048";"         SI HABS_MOTYPE = ""C"""
"IPAUSE5PC";"S";"0049";"            SI HABS_MOTIF = ""ZPA5TH"""
"IPAUSE5PC";"S";"0050";"               HJOU_IJQPAUS5TH = HABS_MOTIDUR"
"IPAUSE5PC";"S";"0051";"            FINSI"
"IPAUSE5PC";"S";"0052";"         FINSI"
"IPAUSE5PC";"S";"0053";"      FINPOUR"
"IPAUSE5PC";"S";"0054";"* pause badgée"
"IPAUSE5PC";"S";"0055";"      SI PROF_IPIFPAUSBA = ""1"""
"IPAUSE5PC";"S";"0056";"         SI HJOU_IJQPAUSE5J < HJOU_IJQPAUS5TH"
"IPAUSE5PC";"S";"0057";"            LOCA_ECART = HJOU_IJQPAUS5TH - HJOU_IJQPAUSE5J"
"IPAUSE5PC";"S";"0058";"            HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - LOCA_ECART"
"IPAUSE5PC";"S";"0059";"            HJOU_IJQPRESEFF = HJOU_IJQPRESEFF - LOCA_ECART"
"IPAUSE5PC";"S";"0060";"         FINSI"
"IPAUSE5PC";"S";"0061";"      SINON"
"IPAUSE5PC";"S";"0062";"         HJOU_IJQPAUSE5J = HJOU_IJQPAUS5TH"
"IPAUSE5PC";"S";"0063";"         HJOU_IJQPRESBAV = HJOU_IJQPRESBAV - HJOU_IJQPAUSE5J"
"IPAUSE5PC";"S";"0064";"         HJOU_IJQPRESEFF = HJOU_IJQPRESEFF - HJOU_IJQPAUSE5J"
"IPAUSE5PC";"S";"0065";"      FINSI"
"IPAUSE5PC";"S";"0066";"   FINSI"
"IPAUSE5PC";"S";"0067";"FINSI"
"IPAUSE5PC";"S";"0068";"FIN"
"IPENIB";"S";"0001";"**********************************************************************"
"IPENIB";"S";"0002";"*"
"IPENIB";"S";"0003";"* Règle : IPENIB"
"IPENIB";"S";"0004";"* Ordre : 8010"
"IPENIB";"S";"0005";"* Titre : Calcul de l'exposition à la pénibilité"
"IPENIB";"S";"0006";"*"
"IPENIB";"S";"0007";"*---------------------------------------------------------------------"
"IPENIB";"S";"0008";"*"
"IPENIB";"S";"0009";"* Créé par : Cellule Industrialisation"
"IPENIB";"S";"0010";"* Date     : 11/06/2015"
"IPENIB";"S";"0011";"* Version  : 1"
"IPENIB";"S";"0012";"*"
"IPENIB";"S";"0013";"*---------------------------------------------------------------------"
"IPENIB";"S";"0014";"*"
"IPENIB";"S";"0015";"* Rôle : Calcul de l'exposition aux risques, alimentation de l'historique de"
"IPENIB";"S";"0016";"* la pénibilité"
"IPENIB";"S";"0017";"* Cette règle prévoie tous les types de situation. Elle doit être adaptée"
"IPENIB";"S";"0018";"* aux types de situation gérés (ETAPE 1)."
"IPENIB";"S";"0019";"*"
"IPENIB";"S";"0020";"*---------------------------------------------------------------------"
"IPENIB";"S";"0021";"*"
"IPENIB";"S";"0022";"* Dates d'effet :"
"IPENIB";"S";"0023";"*"
"IPENIB";"S";"0024";"* Date début : ../../...., Date fin   : ../../...."
"IPENIB";"S";"0025";"*"
"IPENIB";"S";"0026";"*---------------------------------------------------------------------"
"IPENIB";"S";"0027";"*"
"IPENIB";"S";"0028";"* Portée du calcul : Passé / présent :?, Futur proche : ?, Futur : ?"
"IPENIB";"S";"0029";"*"
"IPENIB";"S";"0030";"*---------------------------------------------------------------------"
"IPENIB";"S";"0031";"*"
"IPENIB";"S";"0032";"* Portée du report : ..."
"IPENIB";"S";"0033";"*"
"IPENIB";"S";"0034";"*---------------------------------------------------------------------"
"IPENIB";"S";"0035";"*"
"IPENIB";"S";"0036";"* Données en entrée :"
"IPENIB";"S";"0037";"*"
"IPENIB";"S";"0038";"*"
"IPENIB";"S";"0039";"* -- Lecture matrice : verbe  SELECTMPEN"
"IPENIB";"S";"0040";"* 3 paramétres : le type de situation et 1 ou 2 codes selon le type de situation"
"IPENIB";"S";"0041";"*__________________________________________________________________________"
"IPENIB";"S";"0042";"*|TYPE DE SITUATION | SITUATION |  CODE 1            | CODE 2              |"
"IPENIB";"S";"0043";"*|-------------------------------------------------------------------------|"
"IPENIB";"S";"0044";"*|UNITÉ DE TRAVAIL  | 1         | CODE UNITÉ         |                     |"
"IPENIB";"S";"0045";"*|EMPLOI            | 2         | CODE EMPLOI        |                     |"
"IPENIB";"S";"0046";"*|POSTE (PL)        | 3         | CODE LIEU          |CODE QUALIFICATION   |"
"IPENIB";"S";"0047";"*|LIEU (PL)         | 4         | CODE LIEU          |                     |"
"IPENIB";"S";"0048";"*|QUALIFICATION (PL)| 5         | CODE QUALIFICATION |                     |"
"IPENIB";"S";"0049";"*|ACTIVITY          | 6         | DONNÉE             |VALEUR               |"
"IPENIB";"S";"0050";"*|INFO JOURNALIÈRE  | 7         | DONNÉE             |VALEUR               |"
"IPENIB";"S";"0051";"*|CONSIGNE          | 8         | CODE MOTIF         |                     |"
"IPENIB";"S";"0052";"*|LIEU BADGÉ        | 9         | CODE LIEU          |                     |"
"IPENIB";"S";"0053";"*|ACTIVITÉ (MR)     | A         | ENTITE ACTIVITE    |OCCURRENCE ACTIVITE  |"
"IPENIB";"S";"0054";"*|POSTE (MR)        | B         | OCCURRENCE BESOIN  |POSTE                |"
"IPENIB";"S";"0055";"*|BESOIN (MR)       | C         | ENTITE BESOIN      |OCCURRENCE BESOIN    |"
"IPENIB";"S";"0056";"*|__________________|___________|____________________|_____________________|"
"IPENIB";"S";"0057";"*"
"IPENIB";"S";"0058";"* --- Données du domaine MPEN ---"
"IPENIB";"S";"0059";"* MPEN_FACTEUR = code facteur"
"IPENIB";"S";"0060";"* MPEN_UNITPENIB = unité du facteur"
"IPENIB";"S";"0061";"*    1 = Heures"
"IPENIB";"S";"0062";"*    2 = nombre"
"IPENIB";"S";"0063";"* MPEN_TYPEXPO = Type exposition"
"IPENIB";"S";"0064";"*    1 = absolu"
"IPENIB";"S";"0065";"*    2 = relatif --> (uniquement pour unité en heures)"
"IPENIB";"S";"0066";"* MPEN_DUREEPENIB = durée"
"IPENIB";"S";"0067";"* MPEN_COEFFPENIB = coeficient ou nombre"
"IPENIB";"S";"0068";"* si UNITPENIB = 1 (heures) et TYPEXPO=1 (absolu) alors lire MPEN_DUREEPENIB"
"IPENIB";"S";"0069";"* si UNITPENIB = 1 (heures) et TYPEXPO=2 (relatif) alors lire MPEN_COEFFPENIB"
"IPENIB";"S";"0070";"* si UNITPENIB = 2 (nombre) et TYPEXPO=1 (absolu) alors lire MPEN_COEFFPENIB"
"IPENIB";"S";"0071";"*"
"IPENIB";"S";"0072";"* Données en sortie :"
"IPENIB";"S";"0073";"*"
"IPENIB";"S";"0074";"* --- Données du domaine HPEN ---"
"IPENIB";"S";"0075";"* HPEN_NBRPENIB = nb d'interventions pénibles"
"IPENIB";"S";"0076";"* HPEN_HREPENIB = nb heures de pénibilité"
"IPENIB";"S";"0077";"*"
"IPENIB";"S";"0078";"* ADDPEN : commande pour enregistrer l'historique de pénibilité"
"IPENIB";"S";"0079";"* Remarque : le n° de facteur est alimenté automatiquement suite à l'appel matrice SELECTMPEN"
"IPENIB";"S";"0080";"* Pour créer de l'historique sans s'appuyer sur une matrice, il faut lire le facteur via :"
"IPENIB";"S";"0081";"* SELECTMPEN  ""0"" [CODEFACTEUR]"
"IPENIB";"S";"0082";"*"
"IPENIB";"S";"0083";"* --- Messages ---"
"IPENIB";"S";"0084";"*"
"IPENIB";"S";"0085";"* N° / msg / Gravité"
"IPENIB";"S";"0086";"*"
"IPENIB";"S";"0087";"*---------------------------------------------------------------------"
"IPENIB";"S";"0088";"*"
"IPENIB";"S";"0089";"* Implémentation des données industrielles"
"IPENIB";"S";"0090";"*"
"IPENIB";"S";"0091";"DEBDICO"
"IPENIB";"S";"0092";"   HJOU_IJIEMPLOI;O;A10;X;;;123456789;L1;;C3;""Emploi occupé (pénibilité)"";"
"IPENIB";"S";"0093";"   HORC_IHIEQALT;O;A1;X;0;1;123456789;C;;C2;""Equipes successives alternantes"";"
"IPENIB";"S";"0094";"FINDICO"
"IPENIB";"S";"0095";"*"
"IPENIB";"S";"0096";"*---------------------------------------------------------------------"
"IPENIB";"S";"0097";"*"
"IPENIB";"S";"0098";"* Modifiée par : Cellule Industrialisation"
"IPENIB";"S";"0099";"* Date         : 04/11/2016"
"IPENIB";"S";"0100";"* Objet        : Contrôle de la durée minimum du contrat (1 mois)"
"IPENIB";"S";"0101";"*"
"IPENIB";"S";"0102";"**********************************************************************"
"IPENIB";"S";"0103";"*"
"IPENIB";"S";"0104";"* Déclaration des données locales"
"IPENIB";"S";"0105";"*"
"IPENIB";"S";"0106";"* Identification situation à interroger"
"IPENIB";"S";"0107";"DEF LOCA_SITU A1"
"IPENIB";"S";"0108";"LOCA_SITU = "" """
"IPENIB";"S";"0109";"* Controle nombre passage facteur en nombre"
"IPENIB";"S";"0110";"DEF LOCA_NBPASS N1"
"IPENIB";"S";"0111";"LOCA_NBPASS = 0"
"IPENIB";"S";"0112";"* Durée d'exposition"
"IPENIB";"S";"0113";"DEF LOCA_HREPENIB T6.2"
"IPENIB";"S";"0114";"LOCA_HREPENIB = 0"
"IPENIB";"S";"0115";"* Facteur de pénibilité"
"IPENIB";"S";"0116";"DEF LOCA_FACTEUR A10"
"IPENIB";"S";"0117";"LOCA_FACTEUR = "" """
"IPENIB";"S";"0118";"* Contrôle de la durée du contrat"
"IPENIB";"S";"0119";"DEF LOCA_CTRA N1"
"IPENIB";"S";"0120";"LOCA_CTRA = 0"
"IPENIB";"S";"0121";"*"
"IPENIB";"S";"0122";"*"
"IPENIB";"S";"0123";"*********************************************************"
"IPENIB";"S";"0124";"** PREAMBULE - Contrôle de la durée du contrat **********"
"IPENIB";"S";"0125";"*********************************************************"
"IPENIB";"S";"0126";"** Les contrats dont la durée est inférieure à 1 mois"
"IPENIB";"S";"0127";"** ne sont pas pris en compte"
"IPENIB";"S";"0128";"** - Si le contrat débute le premier jour du mois civil :"
"IPENIB";"S";"0129";"**   la durée est égale à 1 mois si le contrat"
"IPENIB";"S";"0130";"**   prend fin au plus tôt le dernier jour du mois"
"IPENIB";"S";"0131";"**   (28, 29, 30 ou 31)."
"IPENIB";"S";"0132";"** - Si le contrat débute un autre jour du mois civil :"
"IPENIB";"S";"0133";"**   la durée est égale à 1 mois si le contrat"
"IPENIB";"S";"0134";"**   prend fin au plus tôt le mois suivant, la veille"
"IPENIB";"S";"0135";"**   du jour anniversaire de la date de début."
"IPENIB";"S";"0136";"*********************************************************"
"IPENIB";"S";"0137";"*"
"IPENIB";"S";"0138";"SI CTRA_DATDEB(7:2) <> ""01"""
"IPENIB";"S";"0139";"   SI CTRA_DATFIN(1:8) < ""20991231"""
"IPENIB";"S";"0140";"      DATAJT CTRA_DATFIN 12 ""J"" 1"
"IPENIB";"S";"0141";"      DATAJT TEMP_DXFINPER 12 ""M"" -1"
"IPENIB";"S";"0142";"      SI TEMP_DXFINPER(1:8) >= CTRA_DATDEB(1:8)"
"IPENIB";"S";"0143";"         LOCA_CTRA = 1"
"IPENIB";"S";"0144";"      FINSI"
"IPENIB";"S";"0145";"   FINSI"
"IPENIB";"S";"0146";"SINON"
"IPENIB";"S";"0147";"   SI CTRA_DATDEB(1:4) = CTRA_DATFIN(1:4)"
"IPENIB";"S";"0148";"      SI CTRA_DATDEB(5:2) = CTRA_DATFIN(5:2)"
"IPENIB";"S";"0149";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"IPENIB";"S";"0150";"         SI TEMP_DXFINPER(7:2) = ""01"""
"IPENIB";"S";"0151";"            LOCA_CTRA = 1"
"IPENIB";"S";"0152";"         FINSI"
"IPENIB";"S";"0153";"      SINON"
"IPENIB";"S";"0154";"         LOCA_CTRA = 1"
"IPENIB";"S";"0155";"      FINSI"
"IPENIB";"S";"0156";"   SINON"
"IPENIB";"S";"0157";"      LOCA_CTRA = 1"
"IPENIB";"S";"0158";"   FINSI"
"IPENIB";"S";"0159";"FINSI"
"IPENIB";"S";"0160";"*"
"IPENIB";"S";"0161";"*"
"IPENIB";"S";"0162";"*********************************************************"
"IPENIB";"S";"0163";"** ETAPE 1 - Identification de la situation *************"
"IPENIB";"S";"0164";"*********************************************************"
"IPENIB";"S";"0165";"** Celle-ci pourra être unique pour toute la société"
"IPENIB";"S";"0166";"** Ou identifiée sur la section horaire"
"IPENIB";"S";"0167";"** Ou via un indicateur journalier...etc..."
"IPENIB";"S";"0168";"** Par défaut, les types de situation 1, 2 et 8 sont"
"IPENIB";"S";"0169";"** actifs. A adapter en fonction des autres situations."
"IPENIB";"S";"0170";"*********************************************************"
"IPENIB";"S";"0171";"*"
"IPENIB";"S";"0172";"SI LOCA_CTRA = 1"
"IPENIB";"S";"0173";"   LOCA_SITU = ""1"""
"IPENIB";"S";"0174";"FINSI"
"IPENIB";"S";"0175";"*"
"IPENIB";"S";"0176";"*********************************************************"
"IPENIB";"S";"0177";"** ETAPE 2 - Gestion pénibilité selon situation *********"
"IPENIB";"S";"0178";"*********************************************************"
"IPENIB";"S";"0179";"*"
"IPENIB";"S";"0180";"*********************************************************"
"IPENIB";"S";"0181";"********** Type de situation = unité de travail**********"
"IPENIB";"S";"0182";"*"
"IPENIB";"S";"0183";"*SI LOCA_SITU = ""1"""
"IPENIB";"S";"0184";"SI HJOU_UNITTRV <> "" """
"IPENIB";"S";"0185";"   SELECTMPEN LOCA_SITU HJOU_UNITTRV"
"IPENIB";"S";"0186";"   FAIRE PENIB"
"IPENIB";"S";"0187";"FINSI"
"IPENIB";"S";"0188";"*FINSI"
"IPENIB";"S";"0189";"*"
"IPENIB";"S";"0190";"**********************************************************"
"IPENIB";"S";"0191";"********* Type de situation =  emploi occupé *************"
"IPENIB";"S";"0192";"*"
"IPENIB";"S";"0193";"*SI LOCA_SITU = ""2"""
"IPENIB";"S";"0194";"SI HJOU_IJIEMPLOI <> "" """
"IPENIB";"S";"0195";"   SELECTMPEN LOCA_SITU HJOU_IJIEMPLOI"
"IPENIB";"S";"0196";"   FAIRE PENIB"
"IPENIB";"S";"0197";"FINSI"
"IPENIB";"S";"0198";"*FINSI"
"IPENIB";"S";"0199";"*"
"IPENIB";"S";"0200";"**********************************************************"
"IPENIB";"S";"0201";"********* Type de situation = Poste PL *******************"
"IPENIB";"S";"0202";"*"
"IPENIB";"S";"0203";"SI LOCA_SITU = ""3"""
"IPENIB";"S";"0204";"   POUR POSTES"
"IPENIB";"S";"0205";"* Eventuelle condition de lecture pénibilité selon indicateur poste"
"IPENIB";"S";"0206";"* pour ne pas alourdir la règle"
"IPENIB";"S";"0207";"* Remplacer [INDICATEUR_POSTE] par le nom de la donnée utilisée"
"IPENIB";"S";"0208";"* SI POST_[INDICATEUR_POSTE] = 0"
"IPENIB";"S";"0209";"      LOCA_HREPENIB = ACTI_DURAFF"
"IPENIB";"S";"0210";"      SELECTMPEN LOCA_SITU ACTI_CODELIEU ACTI_CODEQUAL"
"IPENIB";"S";"0211";"      FAIRE PENIB"
"IPENIB";"S";"0212";"* FINSI"
"IPENIB";"S";"0213";"   FINPOUR"
"IPENIB";"S";"0214";"*"
"IPENIB";"S";"0215";"FINSI"
"IPENIB";"S";"0216";"*"
"IPENIB";"S";"0217";"**********************************************************"
"IPENIB";"S";"0218";"********* Type de situation = Lieu PL ********************"
"IPENIB";"S";"0219";"*"
"IPENIB";"S";"0220";"SI LOCA_SITU = ""4"""
"IPENIB";"S";"0221";"   POUR POSTES"
"IPENIB";"S";"0222";"      LOCA_HREPENIB = ACTI_DURAFF"
"IPENIB";"S";"0223";"      SELECTMPEN LOCA_SITU ACTI_CODELIEU"
"IPENIB";"S";"0224";"      FAIRE PENIB"
"IPENIB";"S";"0225";"   FINPOUR"
"IPENIB";"S";"0226";"FINSI"
"IPENIB";"S";"0227";"*"
"IPENIB";"S";"0228";"**********************************************************"
"IPENIB";"S";"0229";"********* Type de situation = qualification PL ***********"
"IPENIB";"S";"0230";"*"
"IPENIB";"S";"0231";"SI LOCA_SITU = ""5"""
"IPENIB";"S";"0232";"   POUR POSTES"
"IPENIB";"S";"0233";"      LOCA_HREPENIB = ACTI_DURAFF"
"IPENIB";"S";"0234";"      SELECTMPEN LOCA_SITU ACTI_CODEQUAL"
"IPENIB";"S";"0235";"      FAIRE PENIB"
"IPENIB";"S";"0236";"   FINPOUR"
"IPENIB";"S";"0237";"FINSI"
"IPENIB";"S";"0238";"*"
"IPENIB";"S";"0239";"**********************************************************"
"IPENIB";"S";"0240";"********* Type de situation = activité *******************"
"IPENIB";"S";"0241";"*"
"IPENIB";"S";"0242";"* Dans cet exemple c'est le machine (V3 de l'évé PROD) qui est porteur de pénibilité"
"IPENIB";"S";"0243";"* Remplacer le nom de l'événement et la donnée de valeur"
"IPENIB";"S";"0244";"SI LOCA_SITU = ""6"""
"IPENIB";"S";"0245";"   POUR EVENEMENTS"
"IPENIB";"S";"0246";"      SI EVEN_EVENEMENT = ""PROD"""
"IPENIB";"S";"0247";"         LOCA_HREPENIB = EVEN_DUREE_EVE"
"IPENIB";"S";"0248";"         SELECTMPEN LOCA_SITU ""MACHINE"" EVEN_VALEUR01"
"IPENIB";"S";"0249";"         FAIRE PENIB"
"IPENIB";"S";"0250";"      FINSI"
"IPENIB";"S";"0251";"   FINPOUR"
"IPENIB";"S";"0252";"FINSI"
"IPENIB";"S";"0253";"*"
"IPENIB";"S";"0254";"**********************************************************"
"IPENIB";"S";"0255";"********* Type de situation =  info journalière **********"
"IPENIB";"S";"0256";"*"
"IPENIB";"S";"0257";"SI LOCA_SITU = ""7"""
"IPENIB";"S";"0258";"* Utilisation d'une donnée avec liste de contrôle ([DONNEE] dans l'exemple)"
"IPENIB";"S";"0259";"* Remplacer [DONNEE] par le nom de la donnée utilisée"
"IPENIB";"S";"0260";"*  SELECTMPEN LOCA_SITU ""[DONNEE]"" HJOU_[DONNEE]"
"IPENIB";"S";"0261";"   FAIRE PENIB"
"IPENIB";"S";"0262";"FINSI"
"IPENIB";"S";"0263";"*"
"IPENIB";"S";"0264";"**********************************************************"
"IPENIB";"S";"0265";"********* Type de situation = consigne *******************"
"IPENIB";"S";"0266";"*"
"IPENIB";"S";"0267";"*SI LOCA_SITU = ""8"""
"IPENIB";"S";"0268";"POUR ACTIVITES"
"IPENIB";"S";"0269";"* Eventuelle condition de lecture pénibilité selon motif ou indicateur ACT"
"IPENIB";"S";"0270";"* Pour ne pas alourdir la règle"
"IPENIB";"S";"0271";"   SI HABS_MOTIF = ""XPRES"""
"IPENIB";"S";"0272";"      SELECTMPEN LOCA_SITU HABS_MOTIF"
"IPENIB";"S";"0273";"      FAIRE PENIB"
"IPENIB";"S";"0274";"   FINSI"
"IPENIB";"S";"0275";"FINPOUR"
"IPENIB";"S";"0276";"*FINSI"
"IPENIB";"S";"0277";"*"
"IPENIB";"S";"0278";"**********************************************************"
"IPENIB";"S";"0279";"********* Type de situation = lieu badgé *****************"
"IPENIB";"S";"0280";"*"
"IPENIB";"S";"0281";"SI LOCA_SITU = ""9"""
"IPENIB";"S";"0282";"* La donnée utilisée dans cet exemple ([DONNEE]) doit être alimentée"
"IPENIB";"S";"0283";"* dans une règle de niveau 2 (calcul du lieu dans une boucle POUR POINTAGES)"
"IPENIB";"S";"0284";"* Remplacer [DONNEE] par le nom de la donnée utilisée"
"IPENIB";"S";"0285";"*  SELECTMPEN LOCA_SITU HJOU_[DONNEE]"
"IPENIB";"S";"0286";"   FAIRE PENIB"
"IPENIB";"S";"0287";"FINSI"
"IPENIB";"S";"0288";"*"
"IPENIB";"S";"0289";"**********************************************************"
"IPENIB";"S";"0290";"********* Type de situation = Activité MR ****************"
"IPENIB";"S";"0291";"*"
"IPENIB";"S";"0292";"SI LOCA_SITU = ""A"""
"IPENIB";"S";"0293";"* Dans cet exemple, ACTIVITE est une entité de typologie Activité"
"IPENIB";"S";"0294";"* A remplacer par l'entité utilisée"
"IPENIB";"S";"0295";"   POUR CRENEAUX"
"IPENIB";"S";"0296";"      LOCA_HREPENIB = CRPL_DURAFF"
"IPENIB";"S";"0297";"      SELECTMPEN LOCA_SITU ""ACTIVITE"" PSTE_ACTIVITE"
"IPENIB";"S";"0298";"      FAIRE PENIB"
"IPENIB";"S";"0299";"   FINPOUR"
"IPENIB";"S";"0300";"FINSI"
"IPENIB";"S";"0301";"*"
"IPENIB";"S";"0302";"**********************************************************"
"IPENIB";"S";"0303";"********* Type de situation = Poste MR *******************"
"IPENIB";"S";"0304";"*"
"IPENIB";"S";"0305";"SI LOCA_SITU = ""B"""
"IPENIB";"S";"0306";"   POUR CRENEAUX"
"IPENIB";"S";"0307";"      LOCA_HREPENIB = CRPL_DURAFF"
"IPENIB";"S";"0308";"      SELECTMPEN LOCA_SITU PSTE_BESOIN PSTE_POSTE"
"IPENIB";"S";"0309";"      FAIRE PENIB"
"IPENIB";"S";"0310";"   FINPOUR"
"IPENIB";"S";"0311";"FINSI"
"IPENIB";"S";"0312";"*"
"IPENIB";"S";"0313";"**********************************************************"
"IPENIB";"S";"0314";"********* Type de situation = Besoin MR ******************"
"IPENIB";"S";"0315";"*"
"IPENIB";"S";"0316";"SI LOCA_SITU = ""C"""
"IPENIB";"S";"0317";"* Dans cet exemple, TOURNEE est une entité de typologie Besoin"
"IPENIB";"S";"0318";"* A remplacer par l'entité utilisée"
"IPENIB";"S";"0319";"   POUR CRENEAUX"
"IPENIB";"S";"0320";"      LOCA_HREPENIB = CRPL_DURAFF"
"IPENIB";"S";"0321";"      SELECTMPEN LOCA_SITU ""TOURNEE"" PSTE_BESOIN"
"IPENIB";"S";"0322";"      FAIRE PENIB"
"IPENIB";"S";"0323";"   FINPOUR"
"IPENIB";"S";"0324";"FINSI"
"IPENIB";"S";"0325";"*"
"IPENIB";"S";"0326";"**********************************************************"
"IPENIB";"S";"0327";"********* Type de situation = pas de matrice *************"
"IPENIB";"S";"0328";"*"
"IPENIB";"S";"0329";"* Exemple pour le travail de nuit"
"IPENIB";"S";"0330";"*"
"IPENIB";"S";"0331";"SI LOCA_SITU = "" """
"IPENIB";"S";"0332";"   SI HJOU_IJQNUIPEN >= 1"
"IPENIB";"S";"0333";"      SI HORC_IHIEQALT <> ""1"""
"IPENIB";"S";"0334";"* Lecture du facteur de pénibilite nuit par appel matrice avec le code 0"
"IPENIB";"S";"0335";"         SELECTMPEN ""0"" ""NUIT"""
"IPENIB";"S";"0336";"         POUR PENIBILITE"
"IPENIB";"S";"0337";"            HPEN_NBRPENIB = 1"
"IPENIB";"S";"0338";"            ADDHPEN"
"IPENIB";"S";"0339";"         FINPOUR"
"IPENIB";"S";"0340";"      SINON"
"IPENIB";"S";"0341";"* Lecture du facteur de pénibilite équipe par appel matrice avec le code 0"
"IPENIB";"S";"0342";"         SELECTMPEN ""0"" ""EQUIPE"""
"IPENIB";"S";"0343";"         POUR PENIBILITE"
"IPENIB";"S";"0344";"            HPEN_NBRPENIB = 1"
"IPENIB";"S";"0345";"            ADDHPEN"
"IPENIB";"S";"0346";"         FINPOUR"
"IPENIB";"S";"0347";"      FINSI"
"IPENIB";"S";"0348";"   FINSI"
"IPENIB";"S";"0349";"FINSI"
"IPENIB";"S";"0350";"*"
"IPENIB";"S";"0351";"**********************************************************"
"IPENIB";"S";"0352";"FIN"
"IPENIB";"S";"0353";"*"
"IPENIB";"S";"0354";"**********************************************************"
"IPENIB";"S";"0355";"** ETAPE 3 - Procédure d'enregistrement de la pénibilité *"
"IPENIB";"S";"0356";"**********************************************************"
"IPENIB";"S";"0357";"*"
"IPENIB";"S";"0358";"PROC PENIB"
"IPENIB";"S";"0359";"* Initialisation de la durée d'exposition ****************"
"IPENIB";"S";"0360";"   SI LOCA_HREPENIB = 0"
"IPENIB";"S";"0361";"      LOCA_HREPENIB = HJOU_IJQTTEFFEJ"
"IPENIB";"S";"0362";"   FINSI"
"IPENIB";"S";"0363";"**********************************************************"
"IPENIB";"S";"0364";"   POUR PENIBILITE"
"IPENIB";"S";"0365";"* Unité pénibilité en heures *****************************"
"IPENIB";"S";"0366";"      SI MPEN_UNITPENIB = ""1"""
"IPENIB";"S";"0367";"* Type exposition absolu *********************************"
"IPENIB";"S";"0368";"         SI MPEN_TYPEXPO = ""1"""
"IPENIB";"S";"0369";"            SI LOCA_HREPENIB > 0"
"IPENIB";"S";"0370";"               HPEN_HREPENIB = MPEN_DUREEPENIB"
"IPENIB";"S";"0371";"            FINSI"
"IPENIB";"S";"0372";"         FINSI"
"IPENIB";"S";"0373";"* Type exposition relative *******************************"
"IPENIB";"S";"0374";"         SI MPEN_TYPEXPO = ""2"""
"IPENIB";"S";"0375";"            HPEN_HREPENIB = MPEN_COEFFPENIB * LOCA_HREPENIB"
"IPENIB";"S";"0376";"         FINSI"
"IPENIB";"S";"0377";"      FINSI"
"IPENIB";"S";"0378";"* Unité pénibilité en nombre *****************************"
"IPENIB";"S";"0379";"      SI MPEN_UNITPENIB = ""2"""
"IPENIB";"S";"0380";"         SI MPEN_TYPEXPO = ""1"""
"IPENIB";"S";"0381";"            SI LOCA_HREPENIB > 0"
"IPENIB";"S";"0382";"* Un seul calcul d'exposition au même facteur par jour ***"
"IPENIB";"S";"0383";"               SI LOCA_NBPASS = 0"
"IPENIB";"S";"0384";"                  SI LOCA_FACTEUR = "" """
"IPENIB";"S";"0385";"* Type exposition absolu *********************************"
"IPENIB";"S";"0386";"                     HPEN_NBRPENIB = 1"
"IPENIB";"S";"0387";"                     LOCA_FACTEUR = MPEN_FACTEUR"
"IPENIB";"S";"0388";"                  SINON"
"IPENIB";"S";"0389";"                     SI LOCA_FACTEUR <> MPEN_FACTEUR"
"IPENIB";"S";"0390";"                        HPEN_NBRPENIB = 1"
"IPENIB";"S";"0391";"                     SINON"
"IPENIB";"S";"0392";"* Second passage sur le même facteur : arrêt du calcul***"
"IPENIB";"S";"0393";"                        HPEN_NBRPENIB = 0"
"IPENIB";"S";"0394";"                        LOCA_NBPASS = 1"
"IPENIB";"S";"0395";"                     FINSI"
"IPENIB";"S";"0396";"                  FINSI"
"IPENIB";"S";"0397";"               SINON"
"IPENIB";"S";"0398";"                  HPEN_NBRPENIB = 0"
"IPENIB";"S";"0399";"               FINSI"
"IPENIB";"S";"0400";"            FINSI"
"IPENIB";"S";"0401";"         FINSI"
"IPENIB";"S";"0402";"      FINSI"
"IPENIB";"S";"0403";"* Mise à jour de l'historique d'exposition****************"
"IPENIB";"S";"0404";"      SI HPEN_HREPENIB <> 0"
"IPENIB";"S";"0405";"      OU HPEN_NBRPENIB <> 0"
"IPENIB";"S";"0406";"         ADDHPEN"
"IPENIB";"S";"0407";"      FINSI"
"IPENIB";"S";"0408";"   FINPOUR"
"IPENIB";"S";"0409";"FINPROC"
"IPIXID";"S";"0001";"***********************************************************************"
"IPIXID";"S";"0002";"*"
"IPIXID";"S";"0003";"* Règle : IPIXID"
