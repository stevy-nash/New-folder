"SCPTBASE";"S";"0114";"*"
"SCPTBASE";"S";"0115";"POUR ACTIVITES"
"SCPTBASE";"S";"0116";"   SI MOTI_MOTYPE = ""A"""
"SCPTBASE";"S";"0117";"      SI HABS_VALORIS = ""J"""
"SCPTBASE";"S";"0118";"         SI MOTI_IMIGTTEFFE <> ""1"""
"SCPTBASE";"S";"0119";"            HJOU_SJQHTENT1 = 0"
"SCPTBASE";"S";"0120";"            HJOU_SJQHTENT2 = 0"
"SCPTBASE";"S";"0121";"            HJOU_SJQHTENT3 = 0"
"SCPTBASE";"S";"0122";"            HJOU_SJQHTENT4 = 0"
"SCPTBASE";"S";"0123";"            HJOU_SJQHTENT5 = 0"
"SCPTBASE";"S";"0124";"            HJOU_SJQHTSOR1 = 0"
"SCPTBASE";"S";"0125";"            HJOU_SJQHTSOR2 = 0"
"SCPTBASE";"S";"0126";"            HJOU_SJQHTSOR3 = 0"
"SCPTBASE";"S";"0127";"            HJOU_SJQHTSOR4 = 0"
"SCPTBASE";"S";"0128";"            HJOU_SJQHTSOR5 = 0"
"SCPTBASE";"S";"0129";"         FINSI"
"SCPTBASE";"S";"0130";"      SINON"
"SCPTBASE";"S";"0131";"         SI HABS_VALORIS <> ""H"""
"SCPTBASE";"S";"0132";"            SI MOTI_IMIGTTEFFE <> ""1"""
"SCPTBASE";"S";"0133";"               SI LOCA_HRMIDI > 0"
"SCPTBASE";"S";"0134";"                  SI HJOU_SJQHTSOR2 <> 0"
"SCPTBASE";"S";"0135";"                     SI HABS_VALORIS = ""M"""
"SCPTBASE";"S";"0136";"                        SI HJOU_SJQHTSOR3 <> 0"
"SCPTBASE";"S";"0137";"                           SI HJOU_SJQHTENT1 < LOCA_HRMIDI"
"SCPTBASE";"S";"0138";"                              HJOU_SJQHTENT1 = 0"
"SCPTBASE";"S";"0139";"                              HJOU_SJQHTSOR1 = 0"
"SCPTBASE";"S";"0140";"                           FINSI"
