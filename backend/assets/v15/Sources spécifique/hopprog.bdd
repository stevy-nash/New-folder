"SROLE";"S";"0105";"   SI LOCA_ROLE = 0"
"SROLE";"S";"0106";"      SI EMPL_SEIROLMA = ""1"""
"SROLE";"S";"0107";"         SI EMPL_HORSECT(1:3) = ""RED"""
