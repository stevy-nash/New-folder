"SGCALJF";"S";"0199";"      OU HABS_MOTIF = ""JFT2"""
"SGCALJF";"S";"0200";"         SI HJOU_SECTORI(1:3) = ""DIN"""
"SGCALJF";"S";"0201";"            SI HJOU_SJQSOCIETE = ""YR"""
"SGCALJF";"S";"0202";"* JJA - 05/09/2025 - FFT025005846 : Ajout société MO"
