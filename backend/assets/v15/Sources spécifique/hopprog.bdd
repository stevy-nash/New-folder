"SHSUPPDIM2";"S";"0798";"      SI HJOU_RANG = 1"
"SHSUPPDIM2";"S";"0799";"*21/04/2026-salim pour déterminer si l'on est sur le cycle actuel."
"SHSUPPDIM2";"S";"0800";"         SI HJOU_DATE <= TEMP_DATJOU"
"SHSUPPDIM2";"S";"0801";"            HJOU_IJRSJDISP2 = 1"
"SHSUPPDIM2";"S";"0802";"         SINON"
"SHSUPPDIM2";"S";"0803";"            HJOU_IJRSJDISP2 = HJOU_IJRSJDISP2 + 1"
"SHSUPPDIM2";"S";"0804";"         FINSI"
"SHSUPPDIM2";"S";"0805";"* on déduit  les heures non prises du solde"
"SHSUPPDIM2";"S";"0806";"         HJOU_IJRSHSMREH = HJOU_IJRSHSMREH - HJOU_SJRSHSRE1"
"SHSUPPDIM2";"S";"0807";"*"
"SHSUPPDIM2";"S";"0808";"         HJOU_SJRSHSRE1 = 0"
"SHSUPPDIM2";"S";"0809";"*"
"SHSUPPDIM2";"S";"0810";"         SI HJOU_SJRSHSRE0 > 0"
"SHSUPPDIM2";"S";"0811";"* on ajoute les heures au solde"
"SHSUPPDIM2";"S";"0812";"            HJOU_IJRSHSMREH = HJOU_IJRSHSMREH + HJOU_SJRSHSRE0"
"SHSUPPDIM2";"S";"0813";"*"
"SHSUPPDIM2";"S";"0814";"            SI HJOU_SJRSHSREA < 35"
"SHSUPPDIM2";"S";"0815";"               LOCA_VENTIL = 35"
"SHSUPPDIM2";"S";"0816";"               LOCA_VENTIL = LOCA_VENTIL - HJOU_SJRSHSREA"
"SHSUPPDIM2";"S";"0817";"               SI HJOU_SJRSHSRE0 > LOCA_VENTIL"
"SHSUPPDIM2";"S";"0818";"                  HJOU_SJRSHSREA = HJOU_SJRSHSREA + LOCA_VENTIL"
"SHSUPPDIM2";"S";"0819";"                  HJOU_SJRSHSRE0 = HJOU_SJRSHSRE0 - LOCA_VENTIL"
"SHSUPPDIM2";"S";"0820";"               SINON"
"SHSUPPDIM2";"S";"0821";"                  HJOU_SJRSHSREA = HJOU_SJRSHSREA + HJOU_SJRSHSRE0"
"SHSUPPDIM2";"S";"0822";"                  HJOU_SJRSHSRE0 = 0"
"SHSUPPDIM2";"S";"0823";"               FINSI"
"SHSUPPDIM2";"S";"0824";"            FINSI"
"SHSUPPDIM2";"S";"0825";"            HJOU_SJRSHSRE1 = HJOU_SJRSHSRE0"
"SHSUPPDIM2";"S";"0826";"            HJOU_SJRSHSRE0 = 0"
"SHSUPPDIM2";"S";"0827";"         FINSI"
"SHSUPPDIM2";"S";"0828";"      FINSI"
"SHSUPPDIM2";"S";"0829";"   FINSI"
