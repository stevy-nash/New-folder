"SGRJF";"S";"0577";"   FINSI"
"SGRJF";"S";"0578";"* Init"
"SGRJF";"S";"0579";"   SI HABS_MOTIF = ""ZCRJF"""
"SGRJF";"S";"0580";"      HJOU_SJRCRJF = HABS_MOTINBR"
"SGRJF";"S";"0581";"   FINSI"
"SGRJF";"S";"0582";"FINPOUR"
"SGRJF";"S";"0583";"*"
"SGRJF";"S";"0584";"* Solde >>"
"SGRJF";"S";"0585";"HJOU_SJRSRJF = HJOU_SJRDRJF - HJOU_SJRCRJF"
"SGRJF";"S";"0586";"*"
"SGRJF";"S";"0587";"***** DEB : Gestion du pris en attente >>"
"SGRJF";"S";"0588";"*"
"SGRJF";"S";"0589";"POUR WACTIVITES"
"SGRJF";"S";"0590";"   SI WABS_ANNUL = ""0"""
"SGRJF";"S";"0591";"      SI LOCA_FERI <> 1"
"SGRJF";"S";"0592";"         SI HJOU_IJQPRETHEJ > 0.00"
"SGRJF";"S";"0593";"*"
"SGRJF";"S";"0594";"* PERCO"
"SGRJF";"S";"0595";"            SI WABS_MOTIF = ""YPERRJF"""
"SGRJF";"S";"0596";"               LOCA_PERCOW = LOCA_PERCOW + WABS_MOTINBR"
"SGRJF";"S";"0597";"            FINSI"
"SGRJF";"S";"0598";"*"
"SGRJF";"S";"0599";"            SI WABS_MOTIF = PARD_SDIVMRJF"
"SGRJF";"S";"0600";"* Gestion de la valorisation >>"
"SGRJF";"S";"0601";"               SI WABS_VALORIS = ""J"""
"SGRJF";"S";"0602";"*                  SI PROF_ABSENM = 0"
"SGRJF";"S";"0603";"*                  OU PROF_ABSENS = 0"
"SGRJF";"S";"0604";"*                     LOCA_PRISW = LOCA_PRISW + 0.5"
"SGRJF";"S";"0605";"*                  SINON"
"SGRJF";"S";"0606";"                  LOCA_PRISW = 1"
"SGRJF";"S";"0607";"*                  FINSI"
"SGRJF";"S";"0608";"               SINON"
"SGRJF";"S";"0609";"                  LOCA_PRISW = LOCA_PRISW + 0.5"
"SGRJF";"S";"0610";"               FINSI"
"SGRJF";"S";"0611";"            FINSI"
"SGRJF";"S";"0612";"         FINSI"
"SGRJF";"S";"0613";"      FINSI"
"SGRJF";"S";"0614";"   FINSI"
"SGRJF";"S";"0615";"FINPOUR"
"SGRJF";"S";"0616";"*"
"SGRJF";"S";"0617";"SI LOCA_PRISW > 1"
"SGRJF";"S";"0618";"   LOCA_PRISW = 1"
"SGRJF";"S";"0619";"FINSI"
"SGRJF";"S";"0620";"*"
"SGRJF";"S";"0621";"SI LOCA_PRISW > 0"
"SGRJF";"S";"0622";"   HJOU_SJRCRJFW = HJOU_SJRCRJFW + LOCA_PRISW"
"SGRJF";"S";"0623";"FINSI"
"SGRJF";"S";"0624";"SI LOCA_PERCOW > 0"
"SGRJF";"S";"0625";"   HJOU_SJRCRJFW = HJOU_SJRCRJFW + LOCA_PERCOW"
"SGRJF";"S";"0626";"FINSI"
"SGRJF";"S";"0627";"*"
"SGRJF";"S";"0628";"* Solde >>"
"SGRJF";"S";"0629";"HJOU_SJRSRJF = HJOU_SJRDRJF - HJOU_SJRCRJF"
"SGRJF";"S";"0630";"*"
"SGRJF";"S";"0631";"***** Gestion des anomalies >>"
"SGRJF";"S";"0632";"*"
"SGRJF";"S";"0633";"* Si acquis au fils de l'eau"
"SGRJF";"S";"0634";"SI LOCA_TYPACQ = 1"
"SGRJF";"S";"0635";"   LOCA_SEUIL = -1"
"SGRJF";"S";"0636";"FINSI"
"SGRJF";"S";"0637";"*"
"SGRJF";"S";"0638";"SI LOCA_MOT = 1"
"SGRJF";"S";"0639";"* Si droit ?"
"SGRJF";"S";"0640";"   SI LOCA_DROIT <> 1"
"SGRJF";"S";"0641";"      ANOMALIE 307"
"SGRJF";"S";"0642";"      SI TEMP_CNMOTIF = PARD_SDIVMRJF"
"SGRJF";"S";"0643";"         TEMP_CNRETOUR = 2"
"SGRJF";"S";"0644";"         TEMP_CNMESS = 307"
"SGRJF";"S";"0645";"      FINSI"
"SGRJF";"S";"0646";"   FINSI"
"SGRJF";"S";"0647";"* Si solde négatif ?"
"SGRJF";"S";"0648";"   SI HJOU_SJRSRJF < LOCA_SEUIL"
"SGRJF";"S";"0649";"      ANOMALIE 308"
"SGRJF";"S";"0650";"      SI TEMP_CNMOTIF = PARD_SDIVMRJF"
"SGRJF";"S";"0651";"      OU TEMP_CNMOTIF = ""YPERRJF"""
"SGRJF";"S";"0652";"         TEMP_CNRETOUR = 2"
"SGRJF";"S";"0653";"         TEMP_CNMESS = 308"
"SGRJF";"S";"0654";"      FINSI"
"SGRJF";"S";"0655";"   FINSI"
"SGRJF";"S";"0656";"*"
"SGRJF";"S";"0657";"FINSI"
"SGRJF";"S";"0658";"*"
"SGRJF";"S";"0659";"SI LOCA_PERCO > 0"
"SGRJF";"S";"0660";"* Si solde négatif ?"
"SGRJF";"S";"0661";"   SI HJOU_SJRSRJF < 0"
"SGRJF";"S";"0662";"      ANOMALIE 239"
"SGRJF";"S";"0663";"      SI TEMP_CNMOTIF = PARD_SDIVMRJF"
"SGRJF";"S";"0664";"      OU TEMP_CNMOTIF = ""YPERRJF"""
"SGRJF";"S";"0665";"         TEMP_CNRETOUR = 2"
"SGRJF";"S";"0666";"         TEMP_CNMESS = 308"
"SGRJF";"S";"0667";"      FINSI"
"SGRJF";"S";"0668";"   FINSI"
"SGRJF";"S";"0669";"FINSI"
"SGRJF";"S";"0670";"*"
"SGRJF";"S";"0671";"***** Solde prévisionnel >>"
"SGRJF";"S";"0672";"*"
"SGRJF";"S";"0673";"SI CTRA_DATFIN > TEMP_DATJOU"
"SGRJF";"S";"0674";"   SI CTRA_DATFIN < LOCA_DATEFU"
"SGRJF";"S";"0675";"      SI HJOU_SJQFINC = 1"
"SGRJF";"S";"0676";"         DATAJT CTRA_DATFIN 12 ""J"" 1"
"SGRJF";"S";"0677";"         LOCA_DATEFU = TEMP_DXFINPER"
"SGRJF";"S";"0678";"      FINSI"
"SGRJF";"S";"0679";"   FINSI"
"SGRJF";"S";"0680";"FINSI"
"SGRJF";"S";"0681";"*"
"SGRJF";"S";"0682";"SI TEMP_DATSUI = LOCA_DATEFU"
"SGRJF";"S";"0683";"* JJA - 13/06/2025 - Pris prèv."
"SGRJF";"S";"0684";"   EMPL_SEQCRJF = HJOU_SJRCRJF + HJOU_SJRCRJFW"
"SGRJF";"S";"0685";"*"
"SGRJF";"S";"0686";"   EMPL_SEQSPRJF = HJOU_SJRSRJF - HJOU_SJRCRJFW"
"SGRJF";"S";"0687";"   EMPL_IEQSPDISP2 = HJOU_SJRDRJF"
"SGRJF";"S";"0688";"*"
"SGRJF";"S";"0689";"* JJA - 13/11/2025 - Blocage self >>"
"SGRJF";"S";"0690";"   SI HJOU_SJRSRJF < 0"
"SGRJF";"S";"0691";"      SI TEMP_CNMOTIF = PARD_SDIVMRJF"
"SGRJF";"S";"0692";"      OU TEMP_CNMOTIF = ""YPERRJF"""
"SGRJF";"S";"0693";"         ANOMALIE 308"
"SGRJF";"S";"0694";"         TEMP_CNRETOUR = 2"
"SGRJF";"S";"0695";"         TEMP_CNMESS = 308"
"SGRJF";"S";"0696";"      FINSI"
"SGRJF";"S";"0697";"   FINSI"
"SGRJF";"S";"0698";"* JJA - 13/11/2025 - Blocage self <<"
"SGRJF";"S";"0699";"*"
"SGRJF";"S";"0700";"FINSI"
"SGRJF";"S";"0701";"*"
"SGRJF";"S";"0702";"FIN"
"SGRJF";"S";"0703";"*"
"SGRJF";"S";"0704";"* Gestion arrondis"
"SGRJF";"S";"0705";"PROC ARRONDI"
"SGRJF";"S";"0706";"*"
"SGRJF";"S";"0707";"*DEF LOCA_VALAROND N6.2"
"SGRJF";"S";"0708";"*LOCA_VALAROND = 0"
"SGRJF";"S";"0709";"*DEF LOCA_RESTE N6.2"
"SGRJF";"S";"0710";"*LOCA_RESTE = 0"
"SGRJF";"S";"0711";"*DEF LOCA_ENTIER N6.2"
"SGRJF";"S";"0712";"*LOCA_ENTIER = 0"
"SGRJF";"S";"0713";"* Type arrondi /1:entier sup/2:demi supérieur/3:demi plus proche"
"SGRJF";"S";"0714";"*DEF LOCA_TYPARROND N2"
"SGRJF";"S";"0715";"*LOCA_TYPARROND = 0"
"SGRJF";"S";"0716";"*"
"SGRJF";"S";"0717";"* Arrondi à l'entier supérieur >>"
"SGRJF";"S";"0718";"   SI LOCA_TYPARROND = 1"
"SGRJF";"S";"0719";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGRJF";"S";"0720";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGRJF";"S";"0721";"      SI LOCA_RESTE > 0"
"SGRJF";"S";"0722";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGRJF";"S";"0723";"      FINSI"
"SGRJF";"S";"0724";"      LOCA_VALAROND = LOCA_ENTIER"
"SGRJF";"S";"0725";"   FINSI"
"SGRJF";"S";"0726";"*"
"SGRJF";"S";"0727";"* Arrondi à demi supérieur >>"
"SGRJF";"S";"0728";"   SI LOCA_TYPARROND = 2"
"SGRJF";"S";"0729";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGRJF";"S";"0730";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGRJF";"S";"0731";"      SI LOCA_RESTE > 0.5"
"SGRJF";"S";"0732";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGRJF";"S";"0733";"      SINON"
"SGRJF";"S";"0734";"         SI LOCA_RESTE > 0"
"SGRJF";"S";"0735";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGRJF";"S";"0736";"         FINSI"
"SGRJF";"S";"0737";"      FINSI"
"SGRJF";"S";"0738";"      LOCA_VALAROND = LOCA_ENTIER"
"SGRJF";"S";"0739";"   FINSI"
"SGRJF";"S";"0740";"*"
"SGRJF";"S";"0741";"* Arrondi à demi le plus proche >>"
"SGRJF";"S";"0742";"   SI LOCA_TYPARROND = 3"
"SGRJF";"S";"0743";"      LOCA_RESTE = LOCA_VALAROND % 1"
"SGRJF";"S";"0744";"      LOCA_ENTIER = LOCA_VALAROND - LOCA_RESTE"
"SGRJF";"S";"0745";"      SI LOCA_RESTE >= 0.75"
"SGRJF";"S";"0746";"         LOCA_ENTIER = LOCA_ENTIER + 1"
"SGRJF";"S";"0747";"      SINON"
"SGRJF";"S";"0748";"         SI LOCA_RESTE >= 0.25"
"SGRJF";"S";"0749";"            LOCA_ENTIER = LOCA_ENTIER + 0.5"
"SGRJF";"S";"0750";"         FINSI"
"SGRJF";"S";"0751";"      FINSI"
"SGRJF";"S";"0752";"      LOCA_VALAROND = LOCA_ENTIER"
"SGRJF";"S";"0753";"   FINSI"
"SGRJF";"S";"0754";"*"
"SGRJF";"S";"0755";"FINPROC"
"SGRJF";"S";"0756";"*"
"SGRJF";"S";"0757";"* Calcul nombre de jour de présence en calendaire sur l'année"
"SGRJF";"S";"0758";"* Pour déduire le nombre de RJF au forfait"
"SGRJF";"S";"0759";"*"
"SGRJF";"S";"0760";"* Acquisition RJF Mode 1 >>"
"SGRJF";"S";"0761";"PROC DRJFM1"
"SGRJF";"S";"0762";"*"
"SGRJF";"S";"0763";"   DEF LOCA_DEBX D"
"SGRJF";"S";"0764";"   LOCA_DEBX = "" """
"SGRJF";"S";"0765";"   DEF LOCA_FINX D"
"SGRJF";"S";"0766";"   LOCA_FINX = "" """
"SGRJF";"S";"0767";"*"
"SGRJF";"S";"0768";"   LOCA_NBJI = 0"
"SGRJF";"S";"0769";"   LOCA_DRJFI = 0"
"SGRJF";"S";"0770";"   LOCA_COEFFI = 0"
"SGRJF";"S";"0771";"*"
"SGRJF";"S";"0772";"* Init droit RJF pour forfait jour selon société :"
"SGRJF";"S";"0773";"*"
"SGRJF";"S";"0774";"* Société MO"
"SGRJF";"S";"0775";"   SI CTRA_SCISOCIETE = ""MO"""
"SGRJF";"S";"0776";"      LOCA_DRJF = PARD_SDIDRJFMO"
"SGRJF";"S";"0777";"   FINSI"
"SGRJF";"S";"0778";"* Société RC"
"SGRJF";"S";"0779";"   SI CTRA_SCISOCIETE = ""RC"""
"SGRJF";"S";"0780";"      LOCA_DRJF = PARD_SDIDRJFRC"
"SGRJF";"S";"0781";"   FINSI"
"SGRJF";"S";"0782";"* Société PC"
"SGRJF";"S";"0783";"   SI CTRA_SCISOCIETE = ""RC"""
"SGRJF";"S";"0784";"      LOCA_DRJF = PARD_SDIDRJFRC"
"SGRJF";"S";"0785";"   FINSI"
"SGRJF";"S";"0786";"* Société YR"
"SGRJF";"S";"0787";"   SI CTRA_SCISOCIETE = ""RC"""
"SGRJF";"S";"0788";"      LOCA_DRJF = PARD_SDIDRJFRC"
"SGRJF";"S";"0789";"   FINSI"
"SGRJF";"S";"0790";"*"
"SGRJF";"S";"0791";"* Défini les dates d'analyses"
"SGRJF";"S";"0792";"   SI CTRA_DATDEB < LOCA_DEB"
"SGRJF";"S";"0793";"      LOCA_DEBX = LOCA_DEB"
"SGRJF";"S";"0794";"   SINON"
"SGRJF";"S";"0795";"      LOCA_DEBX = CTRA_DATDEB"
"SGRJF";"S";"0796";"   FINSI"
"SGRJF";"S";"0797";"   SI CTRA_DATFIN > LOCA_FIN"
"SGRJF";"S";"0798";"      LOCA_FINX = LOCA_FIN"
"SGRJF";"S";"0799";"   SINON"
"SGRJF";"S";"0800";"      LOCA_FINX = CTRA_DATFIN"
"SGRJF";"S";"0801";"   FINSI"
"SGRJF";"S";"0802";"*"
"SGRJF";"S";"0803";"   DATDIFF LOCA_DEBX 12 LOCA_FINX 12"
"SGRJF";"S";"0804";"   LOCA_NBJI = TEMP_NXJOUR"
"SGRJF";"S";"0805";"*"
"SGRJF";"S";"0806";"   LOCA_COEFFI = LOCA_NBJI / 365"
"SGRJF";"S";"0807";"   SI LOCA_COEFFI > 1"
"SGRJF";"S";"0808";"      LOCA_COEFFI = 1"
"SGRJF";"S";"0809";"   FINSI"
"SGRJF";"S";"0810";"   LOCA_DRJFI = LOCA_DRJFI * LOCA_COEFFI"
"SGRJF";"S";"0811";"*"
"SGRJF";"S";"0812";"FINPROC"
"SGRJF";"S";"0813";"*"
"SGRJF";"S";"0814";"* Acquisition RJF Mode 2 >>"
"SGRJF";"S";"0815";"PROC DRJFM2"
"SGRJF";"S";"0816";"*"
"SGRJF";"S";"0817";"* Année N-5"
"SGRJF";"S";"0818";"   SI EMPL_SEIDATACQ5 <> "" """
"SGRJF";"S";"0819";"      SI HJOU_DATE >= EMPL_SEIDATACQ5"
"SGRJF";"S";"0820";"         SI HJOU_DATE <= EMPL_SEIDATFCN5"
"SGRJF";"S";"0821";"            HJOU_SJRDRJF = EMPL_SEQDRJFN5"
"SGRJF";"S";"0822";"         FINSI"
"SGRJF";"S";"0823";"      FINSI"
"SGRJF";"S";"0824";"   FINSI"
"SGRJF";"S";"0825";"* Année N-4"
"SGRJF";"S";"0826";"   SI EMPL_SEIDATACQ4 <> "" """
"SGRJF";"S";"0827";"      SI HJOU_DATE >= EMPL_SEIDATACQ4"
"SGRJF";"S";"0828";"         SI HJOU_DATE <= EMPL_SEIDATFCN4"
"SGRJF";"S";"0829";"            HJOU_SJRDRJF = EMPL_SEQDRJFN4"
"SGRJF";"S";"0830";"         FINSI"
"SGRJF";"S";"0831";"      FINSI"
"SGRJF";"S";"0832";"   FINSI"
"SGRJF";"S";"0833";"* Année N-3"
"SGRJF";"S";"0834";"   SI EMPL_SEIDATACQ3 <> "" """
"SGRJF";"S";"0835";"      SI HJOU_DATE >= EMPL_SEIDATACQ3"
"SGRJF";"S";"0836";"         SI HJOU_DATE <= EMPL_SEIDATFCN3"
"SGRJF";"S";"0837";"            HJOU_SJRDRJF = EMPL_SEQDRJFN3"
"SGRJF";"S";"0838";"         FINSI"
"SGRJF";"S";"0839";"      FINSI"
"SGRJF";"S";"0840";"   FINSI"
"SGRJF";"S";"0841";"* Année N-2"
"SGRJF";"S";"0842";"   SI EMPL_SEIDATACQ2 <> "" """
"SGRJF";"S";"0843";"      SI HJOU_DATE >= EMPL_SEIDATACQ2"
"SGRJF";"S";"0844";"         SI HJOU_DATE <= EMPL_SEIDATFCN2"
"SGRJF";"S";"0845";"            HJOU_SJRDRJF = EMPL_SEQDRJFN2"
"SGRJF";"S";"0846";"         FINSI"
"SGRJF";"S";"0847";"      FINSI"
"SGRJF";"S";"0848";"   FINSI"
"SGRJF";"S";"0849";"* Année N-1"
"SGRJF";"S";"0850";"   SI EMPL_SEIDATACQ1 <> "" """
"SGRJF";"S";"0851";"      SI HJOU_DATE >= EMPL_SEIDATACQ1"
"SGRJF";"S";"0852";"         SI HJOU_DATE <= EMPL_SEIDATFCN1"
"SGRJF";"S";"0853";"            HJOU_SJRDRJF = EMPL_SEQDRJFN1"
"SGRJF";"S";"0854";"         FINSI"
"SGRJF";"S";"0855";"      FINSI"
"SGRJF";"S";"0856";"   FINSI"
"SGRJF";"S";"0857";"* Année N"
"SGRJF";"S";"0858";"   SI EMPL_SEIDATACQN <> "" """
"SGRJF";"S";"0859";"      SI HJOU_DATE >= EMPL_SEIDATACQN"
"SGRJF";"S";"0860";"         SI HJOU_DATE <= EMPL_SEIDATFCN"
"SGRJF";"S";"0861";"            HJOU_SJRDRJF = EMPL_SEQDRJFN"
"SGRJF";"S";"0862";"         FINSI"
"SGRJF";"S";"0863";"      FINSI"
"SGRJF";"S";"0864";"   FINSI"
"SGRJF";"S";"0865";"* Année N+1"
"SGRJF";"S";"0866";"   SI EMPL_SEIDATACQ9 <> "" """
"SGRJF";"S";"0867";"      SI HJOU_DATE >= EMPL_SEIDATACQ9"
"SGRJF";"S";"0868";"         SI HJOU_DATE <= EMPL_SEIDATFCN9"
"SGRJF";"S";"0869";"            HJOU_SJRDRJF = EMPL_SEQDRJFN9"
"SGRJF";"S";"0870";"         FINSI"
"SGRJF";"S";"0871";"      FINSI"
"SGRJF";"S";"0872";"   FINSI"
"SGRJF";"S";"0873";"*"
"SGRJF";"S";"0874";"FINPROC"
"SGRJF";"S";"0875";"*"
"SGRTTJ";"S";"0001";"***********************************************************************"
