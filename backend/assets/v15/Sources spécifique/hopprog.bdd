"SRAZCO";"S";"0194";"   SI HABS_MOTIF = ""ZRAZCT"""
"SRAZCO";"S";"0195";"      SI HJOU_DATE = CTRA_DATDEB"
"SRAZCO";"S";"0196";"* Si valeur = 1 on force le RAZ"
"SRAZCO";"S";"0197";"         SI HABS_MOTINBR = 1"
"SRAZCO";"S";"0198";"            LOCA_RAZCPT = 1"
"SRAZCO";"S";"0199";"         FINSI"
"SRAZCO";"S";"0200";"* Si valeur = 2 on annule le RAZ"
