"ICONSCPSCH";"S";"0114";"LOCA_CPMAINT = 0"
"ICONSCPSCH";"S";"0115";"***"
"ICONSCPSCH";"S";"0116";"*** variables utilisées pour le calcul dans le futur"
"ICONSCPSCH";"S";"0117";"***"
"ICONSCPSCH";"S";"0118";"DEF LOCA_PACPRELI A10"
"ICONSCPSCH";"S";"0119";"LOCA_PACPRELI = "" """
"ICONSCPSCH";"S";"0120";"DEF LOCA_PACPANNU A10"
"ICONSCPSCH";"S";"0121";"LOCA_PACPANNU = "" """
"ICONSCPSCH";"S";"0122";"DEF LOCA_PACPANCI A10"
"ICONSCPSCH";"S";"0123";"LOCA_PACPANCI = "" """
"ICONSCPSCH";"S";"0124";"DEF LOCA_PACPANTI A10"
"ICONSCPSCH";"S";"0125";"LOCA_PACPANTI = "" """
"ICONSCPSCH";"S";"0126";"* DEF LOCA_FUTUR N1"
"ICONSCPSCH";"S";"0127";"* LOCA_FUTUR = 0"
"ICONSCPSCH";"S";"0128";"DEF LOCA_NBDEMI N2"
"ICONSCPSCH";"S";"0129";"LOCA_NBDEMI = 0"
"ICONSCPSCH";"S";"0130";"DEF LOCA_NOANNUL N1"
"ICONSCPSCH";"S";"0131";"LOCA_NOANNUL = 0"
"ICONSCPSCH";"S";"0132";"DEF LOCA_ANNULCP N1"
"ICONSCPSCH";"S";"0133";"LOCA_ANNULCP = 0"
"ICONSCPSCH";"S";"0134";"DEF LOCA_TPSP N1"
"ICONSCPSCH";"S";"0135";"LOCA_TPSP = 0"
"ICONSCPSCH";"S";"0136";"DEF LOCA_DATEVEIL D"
"ICONSCPSCH";"S";"0137";"LOCA_DATEVEIL = "" """
"ICONSCPSCH";"S";"0138";"DEF LOCA_DATEVEIL2 D"
"ICONSCPSCH";"S";"0139";"LOCA_DATEVEIL2 = "" """
"ICONSCPSCH";"S";"0140";"DEF LOCA_VALPRE N2"
"ICONSCPSCH";"S";"0141";"LOCA_VALPRE = 0"
"ICONSCPSCH";"S";"0142";"DEF LOCA_LIMITEHEB N5.1"
"ICONSCPSCH";"S";"0143";"LOCA_LIMITEHEB = 0"
"ICONSCPSCH";"S";"0144";"DEF LOCA_VALJT N2.1"
"ICONSCPSCH";"S";"0145";"LOCA_VALJT = 0"
"ICONSCPSCH";"S";"0146";"DEF LOCA_VALJNT N2.1"
"ICONSCPSCH";"S";"0147";"LOCA_VALJNT = 0"
"ICONSCPSCH";"S";"0148";"DEF LOCA_DRCP N2"
"ICONSCPSCH";"S";"0149";"LOCA_DRCP = 0"
"ICONSCPSCH";"S";"0150";"DEF LOCA_JOUR A1"
"ICONSCPSCH";"S";"0151";"LOCA_JOUR = "" """
"ICONSCPSCH";"S";"0152";"DEF LOCA_ACQUIS N4.2"
"ICONSCPSCH";"S";"0153";"LOCA_ACQUIS = 0"
"ICONSCPSCH";"S";"0154";"*"
"ICONSCPSCH";"S";"0155";"DEF LOCA_DUREEJ T6.2"
"ICONSCPSCH";"S";"0156";"LOCA_DUREEJ = 0"
"ICONSCPSCH";"S";"0157";"DEF LOCA_DURMAT T6.2"
"ICONSCPSCH";"S";"0158";"LOCA_DURMAT = 0"
"ICONSCPSCH";"S";"0159";"DEF LOCA_DURSOIR T6.2"
"ICONSCPSCH";"S";"0160";"LOCA_DURSOIR = 0"
"ICONSCPSCH";"S";"0161";"DEF LOCA_CAL N1"
"ICONSCPSCH";"S";"0162";"LOCA_CAL = 0"
"ICONSCPSCH";"S";"0163";"*"
"ICONSCPSCH";"S";"0164";"DEF LOCA_VALORIS A1"
"ICONSCPSCH";"S";"0165";"LOCA_VALORIS = "" """
"ICONSCPSCH";"S";"0166";"DEF LOCA_CPNT N1"
"ICONSCPSCH";"S";"0167";"LOCA_CPNT = 0"
"ICONSCPSCH";"S";"0168";"DEF LOCA_NBCPSAM N2.1"
"ICONSCPSCH";"S";"0169";"LOCA_NBCPSAM = 0"
"ICONSCPSCH";"S";"0170";"DEF LOCA_UTILMOD N1"
"ICONSCPSCH";"S";"0171";"LOCA_UTILMOD = 0"
"ICONSCPSCH";"S";"0172";"DEF LOCA_XPRES N1"
"ICONSCPSCH";"S";"0173";"LOCA_XPRES = 0"
"ICONSCPSCH";"S";"0174";"DEF LOCA_TRANS N6.1"
"ICONSCPSCH";"S";"0175";"LOCA_TRANS = 0"
"ICONSCPSCH";"S";"0176";"DEF LOCA_PRIS N6.1"
"ICONSCPSCH";"S";"0177";"LOCA_PRIS = 0"
"ICONSCPSCH";"S";"0178";"DEF LOCA_ACP N1"
"ICONSCPSCH";"S";"0179";"LOCA_ACP = 0"
"ICONSCPSCH";"S";"0180";"DEF LOCA_CPMOT N1"
"ICONSCPSCH";"S";"0181";"LOCA_CPMOT = 0"
"ICONSCPSCH";"S";"0182";"DEF LOCA_ANCI N1"
"ICONSCPSCH";"S";"0183";"LOCA_ANCI = 0"
"ICONSCPSCH";"S";"0184";"*"
"ICONSCPSCH";"S";"0185";"* SI HJOU_DATE > TEMP_DATJOU"
"ICONSCPSCH";"S";"0186";"* LOCA_FUTUR = 1"
"ICONSCPSCH";"S";"0187";"* FINSI"
"ICONSCPSCH";"S";"0188";"*"
"ICONSCPSCH";"S";"0189";"* test si gestion des cp"
"ICONSCPSCH";"S";"0190";"SI HJOU_IJIACOPRIN = ""1"""
"ICONSCPSCH";"S";"0191";"* Dans le cas ou on a 2 motifs"
"ICONSCPSCH";"S";"0192";"* de type conges 1/2 journée, ils sont transformés en"
"ICONSCPSCH";"S";"0193";"* un motif de type  PARD_IDIVMCOPRI journée entiere"
"ICONSCPSCH";"S";"0194";"   POUR ACTIVITES"
"ICONSCPSCH";"S";"0195";"      SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"0196";"      OU HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"0197";"      OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCPSCH";"S";"0198";"         SI HABS_VALORIS <> ""J"""
"ICONSCPSCH";"S";"0199";"            LOCA_NBDEMI = LOCA_NBDEMI + 1"
"ICONSCPSCH";"S";"0200";"*si valorisation des motifs modifiée"
"ICONSCPSCH";"S";"0201";"            SI HABS_VALORIS = ""M"""
"ICONSCPSCH";"S";"0202";"               LOCA_DURMAT = HABS_MOTIDUR"
"ICONSCPSCH";"S";"0203";"            FINSI"
"ICONSCPSCH";"S";"0204";"            SI HABS_VALORIS = ""A"""
"ICONSCPSCH";"S";"0205";"               LOCA_DURSOIR = HABS_MOTIDUR"
"ICONSCPSCH";"S";"0206";"            FINSI"
"ICONSCPSCH";"S";"0207";"            LOCA_DUREEJ = LOCA_DURMAT + LOCA_DURSOIR"
"ICONSCPSCH";"S";"0208";"         SINON"
"ICONSCPSCH";"S";"0209";"            LOCA_DUREEJ = HABS_MOTIDUR"
"ICONSCPSCH";"S";"0210";"            SI MOTI_IMIGDURABS = ""FIX"""
"ICONSCPSCH";"S";"0211";"               LOCA_DURMAT = MOTI_VALDFT / 2"
"ICONSCPSCH";"S";"0212";"               LOCA_DURSOIR = LOCA_DURMAT"
"ICONSCPSCH";"S";"0213";"            FINSI"
"ICONSCPSCH";"S";"0214";"            SI MOTI_IMIGDURABS = ""C5"""
"ICONSCPSCH";"S";"0215";"            OU MOTI_IMIGDURABS = ""C6"""
"ICONSCPSCH";"S";"0216";"            OU MOTI_IMIGDURABS = ""C7"""
"ICONSCPSCH";"S";"0217";"               LOCA_DURMAT = LOCA_DUREEJ / 2"
"ICONSCPSCH";"S";"0218";"               LOCA_DURSOIR = LOCA_DURMAT"
"ICONSCPSCH";"S";"0219";"            FINSI"
"ICONSCPSCH";"S";"0220";"            SI MOTI_IMIGDURABS = ""PLG"""
"ICONSCPSCH";"S";"0221";"               LOCA_DURMAT = HJOU_IJQPLGMAT"
"ICONSCPSCH";"S";"0222";"               LOCA_DURSOIR = HJOU_IJQPLGAPM"
"ICONSCPSCH";"S";"0223";"            FINSI"
"ICONSCPSCH";"S";"0224";"            SI MOTI_IMIGDURABS = "" """
"ICONSCPSCH";"S";"0225";"               LOCA_DURMAT = PROF_ABSENM"
"ICONSCPSCH";"S";"0226";"               LOCA_DURSOIR = PROF_ABSENS"
"ICONSCPSCH";"S";"0227";"            FINSI"
"ICONSCPSCH";"S";"0228";"*"
"ICONSCPSCH";"S";"0229";"         FINSI"
"ICONSCPSCH";"S";"0230";"      FINSI"
"ICONSCPSCH";"S";"0231";"   FINPOUR"
"ICONSCPSCH";"S";"0232";"   SI LOCA_NBDEMI = 2"
"ICONSCPSCH";"S";"0233";"* cela veut dire qu'on se trouve avec 2 motifs"
"ICONSCPSCH";"S";"0234";"* de type congés 1/2 journée"
"ICONSCPSCH";"S";"0235";"* c'est normal que l'on fasse 2 fois un enlever"
"ICONSCPSCH";"S";"0236";"* sur PARD_IDIVMCOPRI , c'est dans le cas ou on se retrouve avec un"
"ICONSCPSCH";"S";"0237";"* CP de type M et un CP de type A sur la même journée"
"ICONSCPSCH";"S";"0238";"      ENLEVER PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"0239";"      ENLEVER PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"0240";"      ENLEVER PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"0241";"      ENLEVER PARD_IDIVMCOANT"
"ICONSCPSCH";"S";"0242";"      * AJOUTER PARD_IDIVMCOPRI ""J"" PROF_ABSENJ"
"ICONSCPSCH";"S";"0243";"      AJOUTER PARD_IDIVMCOPRI ""J"" LOCA_DUREEJ"
"ICONSCPSCH";"S";"0244";"      LOCA_NBDEMI = 0"
"ICONSCPSCH";"S";"0245";"   FINSI"
"ICONSCPSCH";"S";"0246";"* Jour de repos"
"ICONSCPSCH";"S";"0247";"* Ajout des CP sur les jours non travaillés"
"ICONSCPSCH";"S";"0248";"* (jours ouvrables : ajouter CP sur jour de repos du lundi au samedi)"
"ICONSCPSCH";"S";"0249";"* (jours ouvrés : ajouter CP sur jour de repos du lundi au vendredi)"
"ICONSCPSCH";"S";"0250";"   SI HJOU_IJQPRETHEJ = 0"
"ICONSCPSCH";"S";"0251";"*Pour la gestion si pas reprise direct après fin du premier contrat"
"ICONSCPSCH";"S";"0252";"*Date - 1"
"ICONSCPSCH";"S";"0253";"      DATAJT HJOU_DATE 12 ""J"" -1"
"ICONSCPSCH";"S";"0254";"      LOCA_DATEVEIL2 = TEMP_DXFINPER"
"ICONSCPSCH";"S";"0255";"*"
"ICONSCPSCH";"S";"0256";"      LIREVALPRE LOCA_DATEVEIL HJOU_DATE"
"ICONSCPSCH";"S";"0257";"      SI LOCA_DATEVEIL = LOCA_DATEVEIL2"
"ICONSCPSCH";"S";"0258";"         LIREVALPRE LOCA_VALPRE HJOU_IJRJRCONG"
"ICONSCPSCH";"S";"0259";"         SI LOCA_VALPRE = 1"
"ICONSCPSCH";"S";"0260";"* Si férié sur jour de repos + CP la veille"
"ICONSCPSCH";"S";"0261";"            POUR ACTIVITES"
"ICONSCPSCH";"S";"0262";"               SI HABS_MOTIF = ""FERI"""
"ICONSCPSCH";"S";"0263";"                  LOCA_ANNULCP = 1"
"ICONSCPSCH";"S";"0264";"               FINSI"
"ICONSCPSCH";"S";"0265";"            FINPOUR"
"ICONSCPSCH";"S";"0266";"* Si gestion du maintien des CP le samedi"
"ICONSCPSCH";"S";"0267";"* ne pas ajouter le motif car sinon"
"ICONSCPSCH";"S";"0268";"* CP ajouter 2 fois"
"ICONSCPSCH";"S";"0269";"            * SI PARD_IDINBRSAMD > 0"
"ICONSCPSCH";"S";"0270";"               * SI HJOU_JOUR = ""6"""
"ICONSCPSCH";"S";"0271";"                  * LOCA_ANNULCP = 1"
"ICONSCPSCH";"S";"0272";"                  * LOCA_CPNT = 1"
"ICONSCPSCH";"S";"0273";"               * FINSI"
"ICONSCPSCH";"S";"0274";"            * FINSI"
"ICONSCPSCH";"S";"0275";"*"
"ICONSCPSCH";"S";"0276";"            SI LOCA_ANNULCP <> 1"
"ICONSCPSCH";"S";"0277";"               ENLEVER PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"0278";"               ENLEVER PARD_IDIVMCOANC"
"ICONSCPSCH";"S";"0279";"               ENLEVER PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"0280";"               ENLEVER PARD_IDIVMCOANT"
"ICONSCPSCH";"S";"0281";"               AJOUTER PARD_IDIVMCOPRI ""J"" 0"
"ICONSCPSCH";"S";"0282";"            FINSI"
"ICONSCPSCH";"S";"0283";"         SINON"
"ICONSCPSCH";"S";"0284";"            POUR ACTIVITES"
"ICONSCPSCH";"S";"0285";"                * S'il y a une consigne XPRES"
"ICONSCPSCH";"S";"0286";"                * et un motif de type congé sur"
"ICONSCPSCH";"S";"0287";"                * la même journée"
"ICONSCPSCH";"S";"0288";"                SI HABS_MOTIF = ""XPRES"""
"ICONSCPSCH";"S";"0289";"                    LOCA_XPRES = 1"
"ICONSCPSCH";"S";"0290";"                FINSI"
"ICONSCPSCH";"S";"0291";"                SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"0292";"                OU HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCPSCH";"S";"0293";"                OU HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"0294";"                OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCPSCH";"S";"0295";"                    * Si motif de type CP ajouté par"
"ICONSCPSCH";"S";"0296";"                    * régle on enlève le motif CP"
"ICONSCPSCH";"S";"0297";"                    SI HABS_UTILMOD <> ""*REG"""
"ICONSCPSCH";"S";"0298";"                        LOCA_UTILMOD = 1"
"ICONSCPSCH";"S";"0299";"                    FINSI"
"ICONSCPSCH";"S";"0300";"                FINSI"
"ICONSCPSCH";"S";"0301";"            FINPOUR"
"ICONSCPSCH";"S";"0302";"            *"
"ICONSCPSCH";"S";"0303";"            SI LOCA_UTILMOD = 0"
"ICONSCPSCH";"S";"0304";"                SI LOCA_XPRES = 0"
"ICONSCPSCH";"S";"0305";"                    ENLEVER PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"0306";"                    ENLEVER PARD_IDIVMCOANC"
"ICONSCPSCH";"S";"0307";"                    ENLEVER PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"0308";"                    ENLEVER PARD_IDIVMCOANT"
"ICONSCPSCH";"S";"0309";"                FINSI"
"ICONSCPSCH";"S";"0310";"            FINSI"
"ICONSCPSCH";"S";"0311";"         FINSI"
"ICONSCPSCH";"S";"0312";"      FINSI"
"ICONSCPSCH";"S";"0313";"   FINSI"
"ICONSCPSCH";"S";"0314";"* gestion du motif CP"
"ICONSCPSCH";"S";"0315";"   POUR ACTIVITES"
"ICONSCPSCH";"S";"0316";"      SI HABS_MOTIF = PARD_IDIVMCOREL"
"ICONSCPSCH";"S";"0317";"      OU HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCPSCH";"S";"0318";"      OU HABS_MOTIF = PARD_IDIVMCOPRI"
"ICONSCPSCH";"S";"0319";"      OU HABS_MOTIF = PARD_IDIVMCOANT"
"ICONSCPSCH";"S";"0320";"* La regle VALACT qui permet de supprimer un motif"
"ICONSCPSCH";"S";"0321";"* par rapport au type de jour O/S/D/F n'étant pas"
"ICONSCPSCH";"S";"0322";"* déroulée dans le futur on va tester la validité du motif"
"ICONSCPSCH";"S";"0323";"* avant d'effectuer le chainage et le calcul des soldes"
"ICONSCPSCH";"S";"0324";"* pour que le solde prévisionnel soit juste"
"ICONSCPSCH";"S";"0325";"         LOCA_ENLEVER = 0"
"ICONSCPSCH";"S";"0326";"         LOCA_VALID = MOTI_VALID"
"ICONSCPSCH";"S";"0327";"         SI LOCA_VALID(1:1) = ""O"""
"ICONSCPSCH";"S";"0328";"            SI PARD_IDIJOUROUV = ""1"""
"ICONSCPSCH";"S";"0329";"               SI HJOU_IJQPRETHEJ = 0"
"ICONSCPSCH";"S";"0330";"                  LOCA_ENLEVER = 1"
"ICONSCPSCH";"S";"0331";"               FINSI"
"ICONSCPSCH";"S";"0332";"            SINON"
"ICONSCPSCH";"S";"0333";"               SI HJOU_JOUR = ""6"""
"ICONSCPSCH";"S";"0334";"                  SI HJOU_IJQPRETHEJ = 0"
"ICONSCPSCH";"S";"0335";"                     LOCA_ENLEVER = 1"
"ICONSCPSCH";"S";"0336";"                  FINSI"
"ICONSCPSCH";"S";"0337";"               FINSI"
"ICONSCPSCH";"S";"0338";"            FINSI"
"ICONSCPSCH";"S";"0339";"         FINSI"
"ICONSCPSCH";"S";"0340";"         SI LOCA_VALID(2:1) = ""S"""
"ICONSCPSCH";"S";"0341";"            LOCA_ENLEVER = 0"
"ICONSCPSCH";"S";"0342";"         FINSI"
"ICONSCPSCH";"S";"0343";"         SI LOCA_VALID(3:1) = "" """
"ICONSCPSCH";"S";"0344";"            SI HJOU_JOUR = ""7"""
"ICONSCPSCH";"S";"0345";"               SI HJOU_IJQPRETHEJ = 0"
"ICONSCPSCH";"S";"0346";"                  LOCA_ENLEVER = 1"
"ICONSCPSCH";"S";"0347";"               FINSI"
"ICONSCPSCH";"S";"0348";"            FINSI"
"ICONSCPSCH";"S";"0349";"         FINSI"
"ICONSCPSCH";"S";"0350";"*"
"ICONSCPSCH";"S";"0351";"         SI LOCA_ENLEVER = 0"
"ICONSCPSCH";"S";"0352";"            LOCA_VAL = 0"
"ICONSCPSCH";"S";"0353";"            LOCA_VALORIS = HABS_VALORIS"
"ICONSCPSCH";"S";"0354";"** pour le motif CP ancienneté le solde est calculé"
"ICONSCPSCH";"S";"0355";"* directement, pas de chainage"
"ICONSCPSCH";"S";"0356";"            SI HABS_MOTIF = PARD_IDIVMCOANC"
"ICONSCPSCH";"S";"0357";"               SI HABS_VALORIS = ""J"""
"ICONSCPSCH";"S";"0358";"*Optimum"
"ICONSCPSCH";"S";"0359";"                  SI CTRA_TYPEPLAN = ""1"""
"ICONSCPSCH";"S";"0360";"                  OU CTRA_TYPEPLAN = ""6"""
"ICONSCPSCH";"S";"0361";"                     SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPSCH";"S";"0362";"                        HJOU_IJRCPCOH = HJOU_IJRCPCOH + 1"
"ICONSCPSCH";"S";"0363";"*Limite hebdo de 1/5"
"ICONSCPSCH";"S";"0364";"                        SI HORC_IHIMOACQCP = ""1"""
"ICONSCPSCH";"S";"0365";"                           LOCA_DRCP = 30"
"ICONSCPSCH";"S";"0366";"                        FINSI"
"ICONSCPSCH";"S";"0367";"                        SI HORC_IHIMOACQCP = ""2"""
"ICONSCPSCH";"S";"0368";"                           LOCA_DRCP = 25"
"ICONSCPSCH";"S";"0369";"                        FINSI"
"ICONSCPSCH";"S";"0370";"*"
"ICONSCPSCH";"S";"0371";"                        SI LOCA_DRCP > 0"
"ICONSCPSCH";"S";"0372";"* LOCA_LIMITEHEB = HORC_IHIDRJTRAV / 5"
"ICONSCPSCH";"S";"0373";"                           LOCA_LIMITEHEB = LOCA_DRCP / 5"
"ICONSCPSCH";"S";"0374";"*Si congés pris hebdo <= limite hebdo 1/5 des droits CP travaillés"
"ICONSCPSCH";"S";"0375";"                           SI HJOU_IJRCPCOH <= LOCA_LIMITEHEB"
"ICONSCPSCH";"S";"0376";"                              LOCA_VAL = 1"
"ICONSCPSCH";"S";"0377";"                           SINON"
"ICONSCPSCH";"S";"0378";"                              LOCA_VAL = 0"
"ICONSCPSCH";"S";"0379";"                           FINSI"
"ICONSCPSCH";"S";"0380";"                        FINSI"
"ICONSCPSCH";"S";"0381";"                     FINSI"
"ICONSCPSCH";"S";"0382";"                  SINON"
"ICONSCPSCH";"S";"0383";"                     LOCA_VAL = 1"
"ICONSCPSCH";"S";"0384";"                  FINSI"
"ICONSCPSCH";"S";"0385";"               SINON"
"ICONSCPSCH";"S";"0386";"*Optimum"
"ICONSCPSCH";"S";"0387";"                  SI CTRA_TYPEPLAN = ""1"""
"ICONSCPSCH";"S";"0388";"                  OU CTRA_TYPEPLAN = ""6"""
"ICONSCPSCH";"S";"0389";"                     SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPSCH";"S";"0390";"                        HJOU_IJRCPCOH = HJOU_IJRCPCOH + 0.5"
"ICONSCPSCH";"S";"0391";"*Limite hebdo de 1/5"
"ICONSCPSCH";"S";"0392";"                        SI HORC_IHIMOACQCP = ""1"""
"ICONSCPSCH";"S";"0393";"                           LOCA_DRCP = 30"
"ICONSCPSCH";"S";"0394";"                        FINSI"
"ICONSCPSCH";"S";"0395";"                        SI HORC_IHIMOACQCP = ""2"""
"ICONSCPSCH";"S";"0396";"                           LOCA_DRCP = 25"
"ICONSCPSCH";"S";"0397";"                        FINSI"
"ICONSCPSCH";"S";"0398";"*"
"ICONSCPSCH";"S";"0399";"                        SI LOCA_DRCP > 0"
"ICONSCPSCH";"S";"0400";"* LOCA_LIMITEHEB = HORC_IHIDRJTRAV / 5"
"ICONSCPSCH";"S";"0401";"                           LOCA_LIMITEHEB = LOCA_DRCP / 5"
"ICONSCPSCH";"S";"0402";"*Si congés pris hebdo <= limite hebdo 1/5 des droits CP travaillés"
"ICONSCPSCH";"S";"0403";"                           SI HJOU_IJRCPCOH <= LOCA_LIMITEHEB"
"ICONSCPSCH";"S";"0404";"                              LOCA_VAL = 0.5"
"ICONSCPSCH";"S";"0405";"                           SINON"
"ICONSCPSCH";"S";"0406";"                              LOCA_VAL = 0"
"ICONSCPSCH";"S";"0407";"                           FINSI"
"ICONSCPSCH";"S";"0408";"                        FINSI"
"ICONSCPSCH";"S";"0409";"                     SINON"
"ICONSCPSCH";"S";"0410";"                        LOCA_VAL = 0"
"ICONSCPSCH";"S";"0411";"                     FINSI"
"ICONSCPSCH";"S";"0412";"                  SINON"
"ICONSCPSCH";"S";"0413";"                     LOCA_VAL = 0.5"
"ICONSCPSCH";"S";"0414";"                  FINSI"
"ICONSCPSCH";"S";"0415";"               FINSI"
"ICONSCPSCH";"S";"0416";"               HJOU_IJRCCOANCI = HJOU_IJRCCOANCI + LOCA_VAL"
"ICONSCPSCH";"S";"0417";"               HJOU_IJRSCOANCI = HJOU_IJRDCOANCI - HJOU_IJRCCOANCI"
"ICONSCPSCH";"S";"0418";"               SI HJOU_IJRSCOANCI < 0"
"ICONSCPSCH";"S";"0419";"                  ANOMALIE 168"
"ICONSCPSCH";"S";"0420";"               FINSI"
"ICONSCPSCH";"S";"0421";"            SINON"
"ICONSCPSCH";"S";"0422";"* on effectue le chainage pour les autres motifs"
"ICONSCPSCH";"S";"0423";"               SI HABS_VALORIS = ""J"""
"ICONSCPSCH";"S";"0424";"*Optimum"
"ICONSCPSCH";"S";"0425";"                  SI CTRA_TYPEPLAN = ""1"""
"ICONSCPSCH";"S";"0426";"                  OU CTRA_TYPEPLAN = ""6"""
"ICONSCPSCH";"S";"0427";"                     SI HJOU_IJQPRETHEJ <> 0"
"ICONSCPSCH";"S";"0428";"                        HJOU_IJRCPCOH = HJOU_IJRCPCOH + 1"
"ICONSCPSCH";"S";"0429";"*Limite hebdo de 1/5"
"ICONSCPSCH";"S";"0430";"                        SI HORC_IHIMOACQCP = ""1"""
"ICONSCPSCH";"S";"0431";"                           LOCA_DRCP = 30"
"ICONSCPSCH";"S";"0432";"                        FINSI"
"ICONSCPSCH";"S";"0433";"                        SI HORC_IHIMOACQCP = ""2"""
"ICONSCPSCH";"S";"0434";"                           LOCA_DRCP = 25"
"ICONSCPSCH";"S";"0435";"                        FINSI"
"ICONSCPSCH";"S";"0436";"*"
"ICONSCPSCH";"S";"0437";"                        SI LOCA_DRCP > 0"
"ICONSCPSCH";"S";"0438";"* LOCA_LIMITEHEB = HORC_IHIDRJTRAV / 5"
"ICONSCPSCH";"S";"0439";"                           LOCA_LIMITEHEB = LOCA_DRCP / 5"
"ICONSCPSCH";"S";"0440";"*Si congés pris hebdo <= limite hebdo 1/5 des droits CP travaillés"
"ICONSCPSCH";"S";"0441";"                           SI HJOU_IJRCPCOH <= LOCA_LIMITEHEB"
"ICONSCPSCH";"S";"0442";"                              LOCA_VAL = 1"
"ICONSCPSCH";"S";"0443";"                           SINON"
"ICONSCPSCH";"S";"0444";"                              LOCA_VAL = 0"
