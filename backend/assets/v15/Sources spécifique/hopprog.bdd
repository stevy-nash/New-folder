"IDISPHD";"S";"0019";"*"
"IDISPHD";"S";"0020";"*         Par défaut les différents compteurs ne sont pas affichés"
"IDISPHD";"S";"0021";"*         s'il y a besoin cela devra être fait via la fonction PER"
"IDISPHD";"S";"0022";"*         Les consignes ainsi que le motif de consommation sont à"
"IDISPHD";"S";"0023";"*         créer via la fonction ACT"
"IDISPHD";"S";"0024";"*"
"IDISPHD";"S";"0025";"*"
"IDISPHD";"S";"0026";"* Gestion du Droit/Pris/solde d'un compteur en heure"
"IDISPHD";"S";"0027";"* Le droit est alimenté en début de période de référence définie"
"IDISPHD";"S";"0028";"* dans les données globales datées par une valeur définie dans les"
"IDISPHD";"S";"0029";"* données globales datées"
"IDISPHD";"S";"0030";"* le pris est alimenté par un motif alimenté dans les données globales"
"IDISPHD";"S";"0031";"* datées"
"IDISPHD";"S";"0032";"* Pas de gestion d'anomalie en cas de solde négatif (à créer si besoin)"
"IDISPHD";"S";"0033";"*"
"IDISPHD";"S";"0034";"*----------------------------------------------------------------------"
"IDISPHD";"S";"0035";"*"
"IDISPHD";"S";"0036";"* Modifiée par : Cellule Industrialisation"
"IDISPHD";"S";"0037";"* Date         : JJ/MM/AAAA"
"IDISPHD";"S";"0038";"* Objet        :"
"IDISPHD";"S";"0039";"*"
"IDISPHD";"S";"0040";"***********************************************************************"
"IDISPHD";"S";"0041";"*"
"IDISPHD";"S";"0042";"* Implémentation des données industrielles"
"IDISPHD";"S";"0043";"*"
"IDISPHD";"S";"0044";"DEBDICO"
"IDISPHD";"S";"0045";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHD";"S";"0046";"   * Les compteurs ci-dessous sont déjà créés mais ne sont pas affichés,"
"IDISPHD";"S";"0047";"   * en cas de besoin il faudra les ajoutés dans les écrans de votre choix"
"IDISPHD";"S";"0048";"   * en passant par la fonction PER"
"IDISPHD";"S";"0049";"   HJOU_IJRDHDISP4;N;T8,2;L;;;    56789;;IJRDHDISP4;V3;""Droit en heure disponible 4"";"
"IDISPHD";"S";"0050";"   HJOU_IJRCHDISP4;N;T8,2;L;;;    56789;;IJRCHDISP4;V3;""Pris en heure disponible 4"";"
"IDISPHD";"S";"0051";"   HJOU_IJRSHDISP4;N;T8,2;L;;;    56789;;IJRSHDISP4;V3;""Solde en heure disponible 4"";"
"IDISPHD";"S";"0052";"   EMPL_IEQSPDISH4;N;T8,2;L;;;     6789;;;V3;""Solde prévisionnel en heure disponible 4"";"
"IDISPHD";"S";"0053";"PARD_IDIDRDISH4;O;D10;X;;;123456789;;;C3;""Date RAZ compteur en heure disponible 4"";"
"IDISPHD";"S";"0054";"PARD_IDIVDDISH4;O;T8,2;L;;;123456789;;;C3;""Valeur droit heure compteur disponible 4"";"
"IDISPHD";"S";"0055";"PARD_IDIVMDISH4;O;A10;X;;;123456789;II;;C2;""Motif compteur en heure disponible 4"";"
"IDISPHD";"S";"0056";"FINDICO"
"IDISPHD";"S";"0057";"*"
"IDISPHD";"S";"0058";"* Déclaration des donnees locales"
"IDISPHD";"S";"0059";"*"
"IDISPHD";"S";"0060";"DEF LOCA_DATE D"
"IDISPHD";"S";"0061";"LOCA_DATE = "" """
"IDISPHD";"S";"0062";"DEF LOCA_ACOURS N4"
"IDISPHD";"S";"0063";"LOCA_ACOURS = 0"
"IDISPHD";"S";"0064";"*********************** !!! IMPORTANT !!! ***********************"
"IDISPHD";"S";"0065";"* Pour pouvoir utiliser le test de la date paramétré dans PARD_IDIDRDISH4,"
"IDISPHD";"S";"0066";"* celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPHD";"S";"0067";"* par la date souhaitée"
"IDISPHD";"S";"0068";"*"
"IDISPHD";"S";"0069";"** alimentation du droit à la date de référence"
"IDISPHD";"S";"0070";"** raz du consommé à la date de référence"
"IDISPHD";"S";"0071";"SI HJOU_DATE = PARD_IDIDRDISH4"
"IDISPHD";"S";"0072";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHD";"S";"0073";"   * Pour pouvoir initialiser à la date de référence le compteur de droit"
"IDISPHD";"S";"0074";"   * par la durée paramétrée dans PARD_IDIVDDISH4,"
"IDISPHD";"S";"0075";"   * celui-ci devra être affiché dans la fonction CFG via PER puis complété"
"IDISPHD";"S";"0076";"   * par la durée souhaitée"
"IDISPHD";"S";"0077";"   HJOU_IJRDHDISP4 = PARD_IDIVDDISH4"
"IDISPHD";"S";"0078";"   HJOU_IJRCHDISP4 = 0"
"IDISPHD";"S";"0079";"FINSI"
"IDISPHD";"S";"0080";"** alimentation du pris"
"IDISPHD";"S";"0081";"POUR ACTIVITES"
"IDISPHD";"S";"0082";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHD";"S";"0083";"   * Pour pouvoir utiliser le test du motif paramétré dans PARD_IDIVMDISH4,"
"IDISPHD";"S";"0084";"   * il devra être affiché dans la fonction CFG via PER"
"IDISPHD";"S";"0085";"   * et aura comme valeur le motif de votre choix (si celui-ci n'existe"
"IDISPHD";"S";"0086";"   * pas il devra être créé)"
"IDISPHD";"S";"0087";"   SI HABS_MOTIF = PARD_IDIVMDISH4"
"IDISPHD";"S";"0088";"      HJOU_IJRCHDISP4 = HJOU_IJRCHDISP4 + HABS_MOTIDUR"
"IDISPHD";"S";"0089";"   FINSI"
"IDISPHD";"S";"0090";"FINPOUR"
"IDISPHD";"S";"0091";"** alimentation du droit/pris par consignes"
"IDISPHD";"S";"0092";"POUR ACTIVITES"
"IDISPHD";"S";"0093";"   *********************** !!! IMPORTANT !!! ***********************"
"IDISPHD";"S";"0094";"   * Les consignes ci-dessous n'existe pas et sont à créer"
"IDISPHD";"S";"0095";"   * (si le nom de celles-ci ne correspond pas modifier la règle"
"IDISPHD";"S";"0096";"   * en conséquence)"
"IDISPHD";"S";"0097";"   SI HABS_MOTIF = ""ZDDIH4"""
"IDISPHD";"S";"0098";"      HJOU_IJRDHDISP4 = HABS_MOTIDUR"
"IDISPHD";"S";"0099";"   FINSI"
"IDISPHD";"S";"0100";"   SI HABS_MOTIF = ""XDDIH4"""
"IDISPHD";"S";"0101";"      HJOU_IJRDHDISP4 = HJOU_IJRDHDISP4 + HABS_MOTIDUR"
"IDISPHD";"S";"0102";"   FINSI"
"IDISPHD";"S";"0103";"   SI HABS_MOTIF = ""ZCDIH4"""
"IDISPHD";"S";"0104";"      HJOU_IJRCHDISP4 = HABS_MOTIDUR"
"IDISPHD";"S";"0105";"   FINSI"
"IDISPHD";"S";"0106";"   SI HABS_MOTIF = ""XCDIH4"""
"IDISPHD";"S";"0107";"      HJOU_IJRCHDISP4 = HJOU_IJRCHDISP4 + HABS_MOTIDUR"
"IDISPHD";"S";"0108";"   FINSI"
"IDISPHD";"S";"0109";"FINPOUR"
"IDISPHD";"S";"0110";"** calcul du solde"
"IDISPHD";"S";"0111";"HJOU_IJRSHDISP4 = HJOU_IJRDHDISP4 - HJOU_IJRCHDISP4"
"IDISPHD";"S";"0112";"LOCA_ACOURS << PARD_IDIDRDISH4(1:4)"
"IDISPHD";"S";"0113";"LOCA_ACOURS = LOCA_ACOURS + 1"
"IDISPHD";"S";"0114";"LOCA_DATE(1:4) << LOCA_ACOURS"
"IDISPHD";"S";"0115";"LOCA_DATE(5:4) = PARD_IDIDRDISH4(5:4)"
"IDISPHD";"S";"0116";"SI TEMP_DATSUI = LOCA_DATE"
"IDISPHD";"S";"0117";"   EMPL_IEQSPDISH4 = HJOU_IJRSHDISP4"
"IDISPHD";"S";"0118";"FINSI"
"IDISPHD";"S";"0119";"FIN"
