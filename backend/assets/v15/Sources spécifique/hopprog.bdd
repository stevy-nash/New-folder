"ITPSACTPT6";"S";"0016";"*"
"ITPSACTPT6";"S";"0017";"* Rôle :"
"ITPSACTPT6";"S";"0018";"*"
"ITPSACTPT6";"S";"0019";"* Calcul du temps de présence activité avec la présence théorique"
"ITPSACTPT6";"S";"0020";"* pour population <> section et mode semaine"
"ITPSACTPT6";"S";"0021";"* (gestion activité avec indicateur dans EMP)"
"ITPSACTPT6";"S";"0022";"*"
"ITPSACTPT6";"S";"0023";"*"
"ITPSACTPT6";"S";"0024";"*----------------------------------------------------------------------"
"ITPSACTPT6";"S";"0025";"*"
"ITPSACTPT6";"S";"0026";"* Modifiée par :"
"ITPSACTPT6";"S";"0027";"* Date         : JJ/MM/AAAA"
"ITPSACTPT6";"S";"0028";"* Objet        :"
"ITPSACTPT6";"S";"0029";"*"
"ITPSACTPT6";"S";"0030";"***********************************************************************"
"ITPSACTPT6";"S";"0031";"*"
"ITPSACTPT6";"S";"0032";"* Implémentation des données industrielles"
"ITPSACTPT6";"S";"0033";"*"
"ITPSACTPT6";"S";"0034";"DEBDICO"
"ITPSACTPT6";"S";"0035";"EMPL_IEIACTI;O;A1;X;;;123456789;L;;C3;""Employé géré en activité"";"
"ITPSACTPT6";"S";"0036";"HJOU_IJIACTI;O;A1;X;;;123456789;L;;C0;""Employé géré en activité"";"
"ITPSACTPT6";"S";"0037";"HJOU_IJQMODL;O;A10;X;;;     6789;;;V3;""Modèle activité à appliquer"";"
"ITPSACTPT6";"S";"0038";"FINDICO"
"ITPSACTPT6";"S";"0039";"*"
"ITPSACTPT6";"S";"0040";"*"
"ITPSACTPT6";"S";"0041";"* DEBANO"
"ITPSACTPT6";"S";"0042";"*"
"ITPSACTPT6";"S";"0043";"* FINANO"
"ITPSACTPT6";"S";"0044";"*"
"ITPSACTPT6";"S";"0045";"* Définition des variables locales"
"ITPSACTPT6";"S";"0046";"*"
"ITPSACTPT6";"S";"0047";"* Gestion de l'indicateur activité"
"ITPSACTPT6";"S";"0048";"SI HJOU_IJIACTI = "" """
"ITPSACTPT6";"S";"0049";"    SI HJOU_DATE >= TEMP_DATJOU"
"ITPSACTPT6";"S";"0050";"        HJOU_IJIACTI = EMPL_IEIACTI"
"ITPSACTPT6";"S";"0051";"    FINSI"
"ITPSACTPT6";"S";"0052";"FINSI"
"ITPSACTPT6";"S";"0053";"* Employé géré en activité"
"ITPSACTPT6";"S";"0054";"SI HJOU_IJIACTI <> "" """
"ITPSACTPT6";"S";"0055";"   SI HJOU_IJIACTI <> ""0"""
"ITPSACTPT6";"S";"0056";"        * Calcul de la présence activité le dimanche"
"ITPSACTPT6";"S";"0057";"        * Ou dernier jour du contrat"
"ITPSACTPT6";"S";"0058";"        SI HJOU_JOUR = ""7"""
"ITPSACTPT6";"S";"0059";"        OU TEMP_DATCTRSUI <> TEMP_DATSUI"
"ITPSACTPT6";"S";"0060";"            SI PRES_VALID <> ""O"""
"ITPSACTPT6";"S";"0061";"                PRES_VALID = ""N"""
"ITPSACTPT6";"S";"0062";"                * d'activité à justifier"
"ITPSACTPT6";"S";"0063";"                PRES_CLE_POP = EMPL_CLE_POP"
"ITPSACTPT6";"S";"0064";"                PRES_CLE_POPAFF = EMPL_CLE_POP"
"ITPSACTPT6";"S";"0065";"                *"
"ITPSACTPT6";"S";"0066";"                SI PRES_MODE_TRV = "" """
"ITPSACTPT6";"S";"0067";"                   PRES_MODE_TRV = EMPL_MODE_TRV"
"ITPSACTPT6";"S";"0068";"                FINSI"
"ITPSACTPT6";"S";"0069";"                * ----------------------------------------------------------------------------------"
"ITPSACTPT6";"S";"0070";"                *"
"ITPSACTPT6";"S";"0071";"                * !!! Pour gestion de l'imputation sur les journées théoriquement non travaillé !!!"
"ITPSACTPT6";"S";"0072";"                *                              (A décommenter si besoin)"
"ITPSACTPT6";"S";"0073";"                *"
"ITPSACTPT6";"S";"0074";"                * Pour rendre possible l'imputation sur journée théoriquement non travaillé, il faut"
"ITPSACTPT6";"S";"0075";"                * un PRES_TPS_PRES > 0 sur celle-ci, il faut donc décommenter le test de la"
"ITPSACTPT6";"S";"0076";"                * présence théorique différent de 0 et son SINON afin de mettre PRES_TPS_PRES = 0.01"
"ITPSACTPT6";"S";"0077";"                * sur les journées en question et ne pas bloquer l'imputation"
"ITPSACTPT6";"S";"0078";"                *"
"ITPSACTPT6";"S";"0079";"                * SI HJOU_IJRPRETHEH <> 0"
"ITPSACTPT6";"S";"0080";"                    PRES_TPS_PRES = HJOU_IJRPRETHEH"
"ITPSACTPT6";"S";"0081";"                * SINON"
"ITPSACTPT6";"S";"0082";"                    * PRES_TPS_PRES = 0.01"
"ITPSACTPT6";"S";"0083";"                * FINSI"
"ITPSACTPT6";"S";"0084";"                * ----------------------------------------------------------------------------------"
"ITPSACTPT6";"S";"0085";"                *"
"ITPSACTPT6";"S";"0086";"                PRES_TPS_IMPUTE = 0"
"ITPSACTPT6";"S";"0087";"                SI HJOU_IJIACTI = ""1"""
"ITPSACTPT6";"S";"0088";"                OU HJOU_IJIACTI = ""2"""
"ITPSACTPT6";"S";"0089";"                OU HJOU_IJIACTI = ""3"""
"ITPSACTPT6";"S";"0090";"                    POUR EVENEMENTS"
"ITPSACTPT6";"S";"0091";"                        PRES_TPS_IMPUTE = PRES_TPS_IMPUTE + EVEN_DUREE_EVE"
"ITPSACTPT6";"S";"0092";"                    FINPOUR"
"ITPSACTPT6";"S";"0093";"                FINSI"
"ITPSACTPT6";"S";"0094";"                * Calcul de l'écart"
"ITPSACTPT6";"S";"0095";"                PRES_ECART = PRES_TPS_PRES - PRES_TPS_IMPUTE"
"ITPSACTPT6";"S";"0096";"            FINSI"
"ITPSACTPT6";"S";"0097";"        FINSI"
"ITPSACTPT6";"S";"0098";"        * On renseigne le modèle pour la partie chantier"
"ITPSACTPT6";"S";"0099";"        SI HJOU_IJIACTI = ""4"""
"ITPSACTPT6";"S";"0100";"           HJOU_IJQMODL = ""FMOD01"""
"ITPSACTPT6";"S";"0101";"        FINSI"
"ITPSACTPT6";"S";"0102";"   FINSI"
"ITPSACTPT6";"S";"0103";"FINSI"
"ITPSACTPT6";"S";"0104";"*"
"ITPSACTPT6";"S";"0105";"FIN"
