"SCONTR";"S";"0193";"*"
"SCONTR";"S";"0194";"* Identifie dernière heures de la journée théorique >>"
"SCONTR";"S";"0195";"*"
"SCONTR";"S";"0196";"* Mvt 5"
"SCONTR";"S";"0197";"         SI HJOU_IJQDEBADGT = 0"
"SCONTR";"S";"0198";"            SI HJOU_SJQHTENT5 <> HJOU_SJQHTSOR5"
"SCONTR";"S";"0199";"               HJOU_IJQDEBADGT = HJOU_SJQHTSOR5"
"SCONTR";"S";"0200";"            FINSI"
"SCONTR";"S";"0201";"         FINSI"
"SCONTR";"S";"0202";"* Mvt 4"
