"SCALMAINT";"S";"0162";"* Hors Journaliste >>"
"SCALMAINT";"S";"0163";"   SI HJOU_SJQCATEGOR <> ""J"""
"SCALMAINT";"S";"0164";"      SI HJOU_SJQSOCIETE = ""BE"""
"SCALMAINT";"S";"0165";"      OU HJOU_SJQSOCIETE = ""EC"""
"SCALMAINT";"S";"0166";"      OU HJOU_SJQSOCIETE = ""JC"""
"SCALMAINT";"S";"0167";"      OU HJOU_SJQSOCIETE = ""PC"""
"SCALMAINT";"S";"0168";"      OU HJOU_SJQSOCIETE = ""RC"""
"SCALMAINT";"S";"0169";"      OU HJOU_SJQSOCIETE = ""VH"""
"SCALMAINT";"S";"0170";"      OU HJOU_SJQSOCIETE = ""YR"""
"SCALMAINT";"S";"0171";"         SI LOCA_ANCJ > 180"
"SCALMAINT";"S";"0172";"            LOCA_NBJMAINT = 180"
"SCALMAINT";"S";"0173";"         FINSI"
"SCALMAINT";"S";"0174";"      FINSI"
"SCALMAINT";"S";"0175";"*"
"SCALMAINT";"S";"0176";"      SI HJOU_SJQSOCIETE = ""MO"""
"SCALMAINT";"S";"0177";"         SI LOCA_ANCJ > 180"
"SCALMAINT";"S";"0178";"            SI HJOU_SJQCATEGOR = ""C"""
"SCALMAINT";"S";"0179";"               LOCA_NBJMAINT = 540"
