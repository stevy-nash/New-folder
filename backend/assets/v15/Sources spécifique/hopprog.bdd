"SPAIECPT";"S";"0055";"   HJOU_SJRI005;N;N6,2;I;;;    56789;;SJRI005;V3;""Pris CP1 pour paie - I005"";"
"SPAIECPT";"S";"0056";"   HJOU_SJRI012;N;N6,2;I;;;    56789;;SJRI012;V3;""Pris CP1 pour paie - I012"";"
